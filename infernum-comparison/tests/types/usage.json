{
  "name": "Usage Type Tests",
  "description": "Tests for token usage statistics",
  "cases": [
    {
      "name": "default_usage",
      "action": "Usage::default()",
      "expected": {
        "prompt_tokens": 0,
        "completion_tokens": 0,
        "total_tokens": 0
      }
    },
    {
      "name": "new_usage",
      "action": "Usage::new(100, 50)",
      "expected": {
        "prompt_tokens": 100,
        "completion_tokens": 50,
        "total_tokens": 150
      }
    },
    {
      "name": "zero_completion",
      "action": "Usage::new(100, 0)",
      "expected": {
        "prompt_tokens": 100,
        "completion_tokens": 0,
        "total_tokens": 100
      }
    },
    {
      "name": "large_values",
      "action": "Usage::new(100000, 50000)",
      "expected": {
        "prompt_tokens": 100000,
        "completion_tokens": 50000,
        "total_tokens": 150000
      }
    }
  ]
}
