{
  "name": "SamplingParams Builder Tests",
  "description": "Tests for the SamplingParams builder pattern",
  "cases": [
    {
      "name": "builder_chain_all",
      "action": "SamplingParams::default().with_temperature(0.8).with_top_p(0.95).with_top_k(40).with_max_tokens(512).with_seed(42)",
      "expected": {
        "temperature": 0.8,
        "top_p": 0.95,
        "top_k": 40,
        "max_tokens": 512,
        "seed": 42
      }
    },
    {
      "name": "builder_from_greedy",
      "action": "SamplingParams::greedy().with_max_tokens(100)",
      "expected": {
        "temperature": 0.0,
        "max_tokens": 100
      }
    },
    {
      "name": "builder_with_stop_sequences",
      "action": "SamplingParams::default().with_stop(\"<|endoftext|>\").with_stop(\"<|end|>\")",
      "expected": {
        "stop_sequences_count": 2
      }
    },
    {
      "name": "builder_with_min_p",
      "action": "SamplingParams::default().with_min_p(0.05)",
      "expected": {
        "min_p": 0.05
      }
    }
  ]
}
