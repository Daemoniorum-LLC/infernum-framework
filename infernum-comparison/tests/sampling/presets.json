{
  "name": "SamplingParams Preset Tests",
  "description": "Tests for sampling parameter presets",
  "cases": [
    {
      "name": "default_params",
      "action": "SamplingParams::default()",
      "expected": {
        "temperature": 1.0,
        "top_p": 1.0,
        "top_k": 0,
        "min_p": 0.0,
        "repetition_penalty": 1.0,
        "presence_penalty": 0.0,
        "frequency_penalty": 0.0,
        "max_tokens": 256,
        "stop_sequences": [],
        "seed": null
      }
    },
    {
      "name": "greedy_preset",
      "action": "SamplingParams::greedy()",
      "expected": {
        "temperature": 0.0,
        "top_p": 1.0,
        "max_tokens": 256
      }
    },
    {
      "name": "balanced_preset",
      "action": "SamplingParams::balanced()",
      "expected": {
        "temperature": 0.7,
        "top_p": 0.9,
        "max_tokens": 256
      }
    },
    {
      "name": "creative_preset",
      "action": "SamplingParams::creative()",
      "expected": {
        "temperature": 1.0,
        "top_p": 0.95,
        "top_k": 50,
        "max_tokens": 256
      }
    }
  ]
}
