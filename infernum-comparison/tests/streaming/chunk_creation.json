{
  "name": "StreamChunk Creation Tests",
  "description": "Tests for creating and manipulating StreamChunks",
  "cases": [
    {
      "name": "create_empty_delta",
      "action": "StreamDelta::empty()",
      "expected": {
        "content": null,
        "token": null
      }
    },
    {
      "name": "create_text_delta",
      "action": "StreamDelta::text(\"Hello\")",
      "expected": {
        "content": "Hello",
        "token": null
      }
    },
    {
      "name": "create_token_delta",
      "action": "StreamDelta::token(TokenInfo { id: 123, text: \"world\", logprob: -0.5, special: false })",
      "expected": {
        "content": "world",
        "token": {
          "id": 123,
          "text": "world",
          "logprob": -0.5,
          "special": false
        }
      }
    },
    {
      "name": "build_chunk_with_text",
      "action": "StreamChunkBuilder::new(request_id, model_id).text(0, \"Hello \").text(0, \"world\").build()",
      "expected": {
        "choices_count": 2,
        "choices": [
          { "index": 0, "delta_content": "Hello " },
          { "index": 0, "delta_content": "world" }
        ]
      }
    },
    {
      "name": "build_chunk_with_finish",
      "action": "StreamChunkBuilder::new(request_id, model_id).finish(0, FinishReason::Stop).build()",
      "expected": {
        "choices_count": 1,
        "choices": [
          { "index": 0, "delta_content": null, "finish_reason": "stop" }
        ]
      }
    },
    {
      "name": "build_chunk_with_usage",
      "action": "StreamChunkBuilder::new(request_id, model_id).text(0, \"Hi\").usage(Usage::new(10, 5)).build()",
      "expected": {
        "usage": {
          "prompt_tokens": 10,
          "completion_tokens": 5,
          "total_tokens": 15
        }
      }
    }
  ]
}
