//! # Rune - Pattern Matching Framework
//!
//! *"Patterns that speak truth"*
//!
//! Advanced pattern matching with:
//! - Structural patterns (destructuring)
//! - Guard expressions
//! - Exhaustiveness checking
//! - Active patterns (computed matches)
//! - Evidentiality-aware matching

pub mod pattern
pub mod matcher
pub mod guard
pub mod active

use std::collections::HashMap

// Re-export core types
pub use pattern::{Pattern, PatternKind}
pub use matcher::{Matcher, MatchResult}
pub use guard::{Guard, GuardExpr}
pub use active::{ActivePattern, Extractor}

/// A match arm in a pattern match expression.
#[derive(Debug, Clone)]
struct MatchArm<T> {
    pattern: Pattern,
    guard?: GuardExpr,
    body: T,
}

/// Pattern match expression builder.
struct Match<T, R> {
    value: T,
    arms: [MatchArm<fn(T) -> R>],
    exhaustive: bool,
}

impl<T, R> Match<T, R> {
    /// Creates a new match expression.
    fn new(value: T) -> Match<T, R> {
        Match {
            value,
            arms: [],
            exhaustive: false,
        }
    }

    /// Adds a match arm.
    fn arm(mut self, pattern: Pattern, body: fn(T) -> R) -> Match<T, R> {
        self.arms.push(MatchArm {
            pattern,
            guard: None,
            body,
        });
        self
    }

    /// Adds a guarded match arm.
    fn arm_when(mut self, pattern: Pattern, guard: GuardExpr, body: fn(T) -> R) -> Match<T, R> {
        self.arms.push(MatchArm {
            pattern,
            guard: Some(guard),
            body,
        });
        self
    }

    /// Adds a wildcard arm (catches all remaining).
    fn otherwise(mut self, body: fn(T) -> R) -> Match<T, R> {
        self.arms.push(MatchArm {
            pattern: Pattern::wildcard(),
            guard: None,
            body,
        });
        self.exhaustive = true;
        self
    }

    /// Executes the match.
    fn execute(self) -> ?R {
        for arm in &self.arms {
            if arm.pattern.matches(&self.value) {
                if let Some(guard) = &arm.guard {
                    if !guard.evaluate(&self.value) {
                        continue
                    }
                }
                return Some((arm.body)(self.value))
            }
        }
        None
    }
}

/// Rune operator for pattern matching.
/// Usage: value|ᚱ{patterns...}
fn rune_match<T, R>(value: T, matcher: fn(Match<T, R>) -> Match<T, R>) -> ?R {
    let m = Match::new(value);
    let m = matcher(m);
    m.execute()
}

/// Binding capture from pattern match.
#[derive(Debug, Clone)]
struct Binding {
    name: str,
    value: dyn std::any::Any,
}

/// Captured bindings from a match.
#[derive(Debug, Clone)]
struct Captures {
    bindings: HashMap<str, Binding>,
}

impl Captures {
    fn new() -> Captures {
        Captures {
            bindings: HashMap::new(),
        }
    }

    fn get<T>(self, name: &str) -> ?T {
        self.bindings.get(name).and_then(|b| b.value.downcast_ref::<T>().cloned())
    }

    fn insert<T>(mut self, name: str, value: T) {
        self.bindings.insert(name, Binding { name, value: Box::new(value) });
    }
}

/// Pattern with evidentiality awareness.
#[derive(Debug, Clone)]
enum EvidentialPattern {
    /// Match only known/computed values (!)
    Known(Pattern),
    /// Match uncertain values (?)
    Uncertain(Pattern),
    /// Match reported values (~)
    Reported(Pattern),
    /// Match any evidentiality
    Any(Pattern),
}

impl EvidentialPattern {
    fn matches<T>(self, value: &T, evidentiality: Evidentiality) -> bool {
        match self {
            EvidentialPattern::Known(p) => {
                matches!(evidentiality, Evidentiality::Known) && p.matches(value)
            },
            EvidentialPattern::Uncertain(p) => {
                matches!(evidentiality, Evidentiality::Uncertain) && p.matches(value)
            },
            EvidentialPattern::Reported(p) => {
                matches!(evidentiality, Evidentiality::Reported) && p.matches(value)
            },
            EvidentialPattern::Any(p) => p.matches(value),
        }
    }
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum Evidentiality {
    Known,      // !
    Uncertain,  // ?
    Reported,   // ~
    Paradox,    // ‽
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_captures() {
        let mut captures = Captures::new();
        captures.insert("x", 42);
        assert_eq!(captures.get::<i32>("x"), Some(42));
    }

    #[test]
    fn test_evidentiality() {
        let e = Evidentiality::Known;
        assert!(matches!(e, Evidentiality::Known));
    }
}
