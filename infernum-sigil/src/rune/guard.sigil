//! Guard expressions for conditional pattern matching.

use std::collections::HashMap

/// A guard expression for conditional matching.
#[derive(Debug, Clone)]
struct Guard {
    expr: GuardExpr,
}

impl Guard {
    fn new(expr: GuardExpr) -> Guard {
        Guard { expr }
    }

    fn evaluate<T>(self, value: &T, bindings: &HashMap<str, dyn std::any::Any>) -> bool {
        self.expr.evaluate(value)
    }
}

/// Types of guard expressions.
#[derive(Debug, Clone)]
enum GuardExpr {
    /// Literal boolean.
    Literal(bool),
    /// Reference to a binding.
    Binding(str),
    /// Comparison.
    Compare {
        left: Box<GuardExpr>,
        op: CompareOp,
        right: Box<GuardExpr>,
    },
    /// Logical and.
    And(Box<GuardExpr>, Box<GuardExpr>),
    /// Logical or.
    Or(Box<GuardExpr>, Box<GuardExpr>),
    /// Logical not.
    Not(Box<GuardExpr>),
    /// Method call on binding.
    MethodCall {
        receiver: str,
        method: str,
        args: [GuardExpr],
    },
    /// Field access.
    Field {
        receiver: str,
        field: str,
    },
    /// Integer literal.
    Int(i64),
    /// Float literal.
    Float(f64),
    /// String literal.
    String(str),
    /// Range check.
    InRange {
        value: Box<GuardExpr>,
        start: Box<GuardExpr>,
        end: Box<GuardExpr>,
        inclusive: bool,
    },
}

/// Comparison operators.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum CompareOp {
    Eq,  // ==
    Ne,  // !=
    Lt,  // <
    Le,  // <=
    Gt,  // >
    Ge,  // >=
}

impl GuardExpr {
    /// Creates a literal boolean guard.
    fn literal(b: bool) -> GuardExpr {
        GuardExpr::Literal(b)
    }

    /// Creates a binding reference.
    fn binding(name: str) -> GuardExpr {
        GuardExpr::Binding(name)
    }

    /// Creates a comparison.
    fn compare(left: GuardExpr, op: CompareOp, right: GuardExpr) -> GuardExpr {
        GuardExpr::Compare {
            left: Box::new(left),
            op,
            right: Box::new(right),
        }
    }

    /// Creates logical and.
    fn and(self, other: GuardExpr) -> GuardExpr {
        GuardExpr::And(Box::new(self), Box::new(other))
    }

    /// Creates logical or.
    fn or(self, other: GuardExpr) -> GuardExpr {
        GuardExpr::Or(Box::new(self), Box::new(other))
    }

    /// Creates logical not.
    fn not(self) -> GuardExpr {
        GuardExpr::Not(Box::new(self))
    }

    /// Creates a method call.
    fn method(receiver: str, method: str, args: [GuardExpr]) -> GuardExpr {
        GuardExpr::MethodCall { receiver, method, args }
    }

    /// Creates a field access.
    fn field(receiver: str, field: str) -> GuardExpr {
        GuardExpr::Field { receiver, field }
    }

    /// Creates a range check.
    fn in_range(value: GuardExpr, start: GuardExpr, end: GuardExpr, inclusive: bool) -> GuardExpr {
        GuardExpr::InRange {
            value: Box::new(value),
            start: Box::new(start),
            end: Box::new(end),
            inclusive,
        }
    }

    /// Evaluates the guard expression.
    fn evaluate<T>(self, value: &T) -> bool {
        match self {
            GuardExpr::Literal(b) => b,
            GuardExpr::And(left, right) => {
                left.evaluate(value) && right.evaluate(value)
            },
            GuardExpr::Or(left, right) => {
                left.evaluate(value) || right.evaluate(value)
            },
            GuardExpr::Not(inner) => {
                !inner.evaluate(value)
            },
            // Other cases need runtime binding resolution
            _ => true,
        }
    }

    /// Checks if guard is always true.
    fn is_trivially_true(self) -> bool {
        matches!(self, GuardExpr::Literal(true))
    }

    /// Checks if guard is always false.
    fn is_trivially_false(self) -> bool {
        matches!(self, GuardExpr::Literal(false))
    }

    /// Gets all bindings referenced by this guard.
    fn referenced_bindings(self) -> [str] {
        let mut bindings = [];
        self.collect_bindings(&mut bindings);
        bindings
    }

    fn collect_bindings(self, bindings: &mut [str]) {
        match self {
            GuardExpr::Binding(name) => bindings.push(name),
            GuardExpr::Compare { left, right, .. } => {
                left.collect_bindings(bindings);
                right.collect_bindings(bindings);
            },
            GuardExpr::And(left, right) | GuardExpr::Or(left, right) => {
                left.collect_bindings(bindings);
                right.collect_bindings(bindings);
            },
            GuardExpr::Not(inner) => inner.collect_bindings(bindings),
            GuardExpr::MethodCall { receiver, args, .. } => {
                bindings.push(receiver);
                for arg in args {
                    arg.collect_bindings(bindings);
                }
            },
            GuardExpr::Field { receiver, .. } => bindings.push(receiver),
            GuardExpr::InRange { value, start, end, .. } => {
                value.collect_bindings(bindings);
                start.collect_bindings(bindings);
                end.collect_bindings(bindings);
            },
            _ => {},
        }
    }
}

// ============================================================================
// Guard Builder DSL
// ============================================================================

/// Builder for guard expressions.
struct GuardBuilder {
    expr: GuardExpr,
}

impl GuardBuilder {
    /// Starts with a binding reference.
    fn bind(name: str) -> GuardBuilder {
        GuardBuilder {
            expr: GuardExpr::Binding(name),
        }
    }

    /// Comparison: equals.
    fn eq(self, other: GuardExpr) -> GuardBuilder {
        GuardBuilder {
            expr: GuardExpr::compare(self.expr, CompareOp::Eq, other),
        }
    }

    /// Comparison: not equals.
    fn ne(self, other: GuardExpr) -> GuardBuilder {
        GuardBuilder {
            expr: GuardExpr::compare(self.expr, CompareOp::Ne, other),
        }
    }

    /// Comparison: less than.
    fn lt(self, other: GuardExpr) -> GuardBuilder {
        GuardBuilder {
            expr: GuardExpr::compare(self.expr, CompareOp::Lt, other),
        }
    }

    /// Comparison: less than or equal.
    fn le(self, other: GuardExpr) -> GuardBuilder {
        GuardBuilder {
            expr: GuardExpr::compare(self.expr, CompareOp::Le, other),
        }
    }

    /// Comparison: greater than.
    fn gt(self, other: GuardExpr) -> GuardBuilder {
        GuardBuilder {
            expr: GuardExpr::compare(self.expr, CompareOp::Gt, other),
        }
    }

    /// Comparison: greater than or equal.
    fn ge(self, other: GuardExpr) -> GuardBuilder {
        GuardBuilder {
            expr: GuardExpr::compare(self.expr, CompareOp::Ge, other),
        }
    }

    /// Logical and.
    fn and(self, other: GuardBuilder) -> GuardBuilder {
        GuardBuilder {
            expr: self.expr.and(other.expr),
        }
    }

    /// Logical or.
    fn or(self, other: GuardBuilder) -> GuardBuilder {
        GuardBuilder {
            expr: self.expr.or(other.expr),
        }
    }

    /// Builds the guard.
    fn build(self) -> Guard {
        Guard::new(self.expr)
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_literal_guard() {
        let g = GuardExpr::literal(true);
        assert!(g.evaluate(&42));
    }

    #[test]
    fn test_and_guard() {
        let g = GuardExpr::literal(true).and(GuardExpr::literal(true));
        assert!(g.evaluate(&42));

        let g2 = GuardExpr::literal(true).and(GuardExpr::literal(false));
        assert!(!g2.evaluate(&42));
    }

    #[test]
    fn test_or_guard() {
        let g = GuardExpr::literal(false).or(GuardExpr::literal(true));
        assert!(g.evaluate(&42));
    }

    #[test]
    fn test_not_guard() {
        let g = GuardExpr::literal(false).not();
        assert!(g.evaluate(&42));
    }

    #[test]
    fn test_trivially_true() {
        assert!(GuardExpr::literal(true).is_trivially_true());
        assert!(!GuardExpr::literal(false).is_trivially_true());
    }
}
