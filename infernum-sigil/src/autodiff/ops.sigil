//! High-level autodiff operations.

/// Computes gradient of a scalar function.
/// Usage: let grads = grad(f, &inputs)
fn grad<F>(f: F, inputs: &[f64]) -> [f64]
where
    F: Fn(&[f64]) -> f64,
{
    let n = inputs.len();
    let mut grads = [0.0; n];
    let h = 1e-8; // Small perturbation

    for i in 0..n {
        let mut inputs_plus = inputs.to_vec();
        let mut inputs_minus = inputs.to_vec();
        inputs_plus[i] += h;
        inputs_minus[i] -= h;

        grads[i] = (f(&inputs_plus) - f(&inputs_minus)) / (2.0 * h);
    }

    grads
}

/// Computes Jacobian matrix of a vector function.
/// Returns matrix where J[i][j] = ∂f_i/∂x_j
fn jacobian<F>(f: F, inputs: &[f64], output_dim: usize) -> [[f64]]
where
    F: Fn(&[f64]) -> [f64],
{
    let n = inputs.len();
    let h = 1e-8;

    let mut jac = [[0.0; n]; output_dim];

    for j in 0..n {
        let mut inputs_plus = inputs.to_vec();
        let mut inputs_minus = inputs.to_vec();
        inputs_plus[j] += h;
        inputs_minus[j] -= h;

        let f_plus = f(&inputs_plus);
        let f_minus = f(&inputs_minus);

        for i in 0..output_dim {
            jac[i][j] = (f_plus[i] - f_minus[i]) / (2.0 * h);
        }
    }

    jac
}

/// Computes Hessian matrix of a scalar function.
/// Returns symmetric matrix H[i][j] = ∂²f/∂x_i∂x_j
fn hessian<F>(f: F, inputs: &[f64]) -> [[f64]]
where
    F: Fn(&[f64]) -> f64,
{
    let n = inputs.len();
    let h = 1e-5; // Slightly larger for second derivative

    let mut hess = [[0.0; n]; n];
    let f_x = f(inputs);

    for i in 0..n {
        for j in 0..=i {
            let mut x_pp = inputs.to_vec();
            let mut x_pm = inputs.to_vec();
            let mut x_mp = inputs.to_vec();
            let mut x_mm = inputs.to_vec();

            x_pp[i] += h; x_pp[j] += h;
            x_pm[i] += h; x_pm[j] -= h;
            x_mp[i] -= h; x_mp[j] += h;
            x_mm[i] -= h; x_mm[j] -= h;

            let d2f = (f(&x_pp) - f(&x_pm) - f(&x_mp) + f(&x_mm)) / (4.0 * h * h);

            hess[i][j] = d2f;
            hess[j][i] = d2f; // Symmetric
        }
    }

    hess
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_grad_linear() {
        // f(x, y) = 2x + 3y
        let f = |x: &[f64]| 2.0 * x[0] + 3.0 * x[1];
        let grads = grad(f, &[1.0, 2.0]);

        assert!((grads[0] - 2.0).abs() < 1e-6);
        assert!((grads[1] - 3.0).abs() < 1e-6);
    }

    #[test]
    fn test_grad_quadratic() {
        // f(x) = x^2
        let f = |x: &[f64]| x[0] * x[0];
        let grads = grad(f, &[3.0]);

        assert!((grads[0] - 6.0).abs() < 1e-6); // d/dx(x^2) = 2x = 6
    }

    #[test]
    fn test_hessian_quadratic() {
        // f(x, y) = x^2 + y^2
        let f = |x: &[f64]| x[0] * x[0] + x[1] * x[1];
        let hess = hessian(f, &[1.0, 1.0]);

        assert!((hess[0][0] - 2.0).abs() < 1e-4); // ∂²f/∂x² = 2
        assert!((hess[1][1] - 2.0).abs() < 1e-4); // ∂²f/∂y² = 2
        assert!(hess[0][1].abs() < 1e-4);         // ∂²f/∂x∂y = 0
    }
}
