// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_unet3d_config_svd() {
        let config = UNet3DConfig::svd()
        assert_eq!(config.in_channels, 8)
        assert!(config.use_fps_conditioning)
    }

    #[test]
    fn test_unet3d_config_animatediff() {
        let config = UNet3DConfig::animatediff()
        assert!(config.use_motion_modules)
        assert!(!config.use_fps_conditioning)
    }
}
