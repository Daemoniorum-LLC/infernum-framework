#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_temporal_attention_config() {
        let config = TemporalAttentionConfig::svd(1024)
        assert!(config.causal)
        assert_eq!(config.max_seq_len, 25)
    }

    #[test]
    fn test_motion_module_config() {
        let config = MotionModuleConfig::default(320)
        assert_eq!(config.num_layers, 2)
        assert!(config.zero_init)
    }
}
