// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_vae3d_config() {
        let config = VAE3DConfig::cogvideox()
        assert_eq!(config.temporal_downsample, 4)
        assert_eq!(config.latent_channels, 16)
    }

    #[test]
    fn test_vae3d_config_mochi() {
        let config = VAE3DConfig::mochi()
        assert_eq!(config.temporal_downsample, 6)
        assert_eq!(config.latent_channels, 12)
    }
}
