#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_video_transformer_config() {
        let config = VideoTransformerConfig::cogvideox()
        assert_eq!(config.num_layers, 30)
        assert_eq!(config.hidden_size, 3072)
    }

    #[test]
    fn test_mochi_config() {
        let config = VideoTransformerConfig::mochi()
        assert_eq!(config.num_layers, 48)
    }
}
