/// Video Transformer Architectures
///
/// Implements DiT-based video generation models like CogVideoX and Mochi.
/// Features factorized attention and joint spatiotemporal modeling.

use crate::core::error::{InfernumError, Result}
use crate::abaddon::backend::{Tensor, TensorOps, ComputeBackend}
use crate::video::types::{VideoTensor, LatentVideo}
use crate::video::temporal::{PositionalEncoding3D, TemporalPositionEmbedding}
use crate::diffusion::dit::{AdaLayerNorm, DiTBlock}

// ============================================================================
// Video Transformer Configuration
// ============================================================================

/// Configuration for video transformer
pub struct VideoTransformerConfig {
    /// Hidden dimension
    pub hidden_size: u32,
    /// Number of transformer layers
    pub num_layers: u32,
    /// Number of attention heads
    pub num_heads: u32,
    /// Patch size (spatial)
    pub patch_size: u32,
    /// Temporal patch size
    pub temporal_patch_size: u32,
    /// Input channels
    pub in_channels: u32,
    /// Output channels
    pub out_channels: u32,
    /// Cross attention dimension
    pub cross_attention_dim: u32,
    /// Attention type
    pub attention_type: VideoAttentionType,
    /// Use causal attention
    pub causal: bool,
    /// Max frames
    pub max_frames: u32,
    /// Max spatial tokens
    pub max_spatial_tokens: u32,
}

impl VideoTransformerConfig {
    /// CogVideoX configuration
    pub fn cogvideox() -> Self {
        Self {
            hidden_size: 3072,
            num_layers: 30,
            num_heads: 24,
            patch_size: 2,
            temporal_patch_size: 1,
            in_channels: 16,
            out_channels: 16,
            cross_attention_dim: 4096,  // T5-XXL
            attention_type: VideoAttentionType::Factorized,
            causal: true,
            max_frames: 49,
            max_spatial_tokens: 2700,  // 60x45
        }
    }

    /// Mochi configuration
    pub fn mochi() -> Self {
        Self {
            hidden_size: 3072,
            num_layers: 48,
            num_heads: 24,
            patch_size: 2,
            temporal_patch_size: 1,
            in_channels: 12,
            out_channels: 12,
            cross_attention_dim: 4096,
            attention_type: VideoAttentionType::JointSpatioTemporal,
            causal: true,
            max_frames: 84,
            max_spatial_tokens: 3200,
        }
    }

    /// LTX-Video configuration
    pub fn ltx_video() -> Self {
        Self {
            hidden_size: 2048,
            num_layers: 28,
            num_heads: 16,
            patch_size: 1,
            temporal_patch_size: 1,
            in_channels: 128,
            out_channels: 128,
            cross_attention_dim: 4096,
            attention_type: VideoAttentionType::Causal,
            causal: true,
            max_frames: 121,
            max_spatial_tokens: 6144,
        }
    }
}

/// Type of attention mechanism
pub enum VideoAttentionType {
    /// Factorized: separate spatial and temporal attention
    Factorized,
    /// Joint: full spatiotemporal attention
    JointSpatioTemporal,
    /// Causal: autoregressive attention
    Causal,
    /// Asymmetric: different spatial/temporal heads
    Asymmetric { spatial_heads: u32, temporal_heads: u32 },
}

// ============================================================================
// Video Transformer
// ============================================================================

/// Video Transformer (DiT for video)
pub struct VideoTransformer<B: ComputeBackend> {
    /// Configuration
    config: VideoTransformerConfig,
    /// Patch embedding
    patch_embed: VideoPatchEmbed<B>,
    /// Position embedding
    pos_embed: PositionalEncoding3D<B>,
    /// Transformer blocks
    blocks: Vec<VideoTransformerBlock<B>>,
    /// Final layer norm
    final_norm: LayerNorm<B>,
    /// Output projection
    unpatch: VideoUnpatchify<B>,
    /// Backend
    backend: B,
}

impl<B: ComputeBackend> VideoTransformer<B> {
    /// Create new video transformer
    pub fn new(config: VideoTransformerConfig, backend: B) -> Result<Self> {
        let patch_embed = VideoPatchEmbed::new(
            config.in_channels,
            config.hidden_size,
            config.patch_size,
            config.temporal_patch_size,
            backend.clone(),
        )?

        let pos_embed = PositionalEncoding3D::new(
            config.hidden_size,
            config.max_frames,
            config.max_spatial_tokens,
            config.max_spatial_tokens,
            backend.clone(),
        )?

        let blocks: Vec<VideoTransformerBlock<B>> = (0..config.num_layers)
            τ{ |_| VideoTransformerBlock::new(&config, backend.clone()) }
            .collect::<Result<_>>()?

        let final_norm = LayerNorm::new(config.hidden_size, backend.clone())?

        let unpatch = VideoUnpatchify::new(
            config.hidden_size,
            config.out_channels,
            config.patch_size,
            config.temporal_patch_size,
            backend.clone(),
        )?

        Ok(Self {
            config,
            patch_embed,
            pos_embed,
            blocks,
            final_norm,
            unpatch,
            backend,
        })
    }

    /// Forward pass
    pub fn forward(
        &self,
        x~: &LatentVideo<B>,           // [batch, channels, frames, height, width]
        timestep: &Tensor<B>,           // [batch]
        encoder_hidden_states~: &Tensor<B>,  // [batch, seq, dim]
        encoder_attention_mask~: Option<&Tensor<B>>,
    ) -> Result<LatentVideo<B>!> {
        let (batch, c, t, h, w) = x~.shape5()

        // Patch embedding
        let x! = self.patch_embed.forward(x~)?  // [batch, num_patches, hidden_size]

        // Add positional embedding
        let num_t_patches = t / self.config.temporal_patch_size
        let num_h_patches = h / self.config.patch_size
        let num_w_patches = w / self.config.patch_size

        let pos_emb! = self.pos_embed.forward(num_t_patches, num_h_patches, num_w_patches, &self.backend)?
        let pos_emb = pos_emb.reshape([1, -1, self.config.hidden_size])?
        let x! = x + pos_emb

        // Process through transformer blocks
        let mut hidden_states! = x

        for block in self.blocks.iter() {
            hidden_states = block.forward(
                &hidden_states,
                timestep,
                encoder_hidden_states~,
                encoder_attention_mask~,
                num_t_patches,
                num_h_patches * num_w_patches,
            )?
        }

        // Final norm
        let hidden_states! = self.final_norm.forward(&hidden_states)?

        // Unpatchify
        self.unpatch.forward(&hidden_states, t, h, w)
    }

    /// Load from checkpoint
    pub fn load(path: str~, config: VideoTransformerConfig, backend: B) -> Result<Self> {
        let state_dict = safetensors::load(path~)?
        let mut model = Self::new(config, backend)?
        model.load_state_dict(state_dict)?
        Ok(model)
    }

    fn load_state_dict(&mut self, state_dict: Map<str, Tensor<B>>) -> Result<()> {
        self.patch_embed.load_state_dict(&state_dict, "patch_embed")?
        for (i, block) in self.blocks.iter_mut().enumerate() {
            block.load_state_dict(&state_dict, &format!("transformer_blocks.{}", i))?
        }
        self.final_norm.load_state_dict(&state_dict, "norm_out")?
        self.unpatch.load_state_dict(&state_dict, "proj_out")?
        Ok(())
    }
}

// ============================================================================
// Video Transformer Block
// ============================================================================

/// Video transformer block
pub struct VideoTransformerBlock<B: ComputeBackend> {
    /// Attention type
    attention_type: VideoAttentionType,
    /// Pre-norm for self-attention
    norm1: AdaLayerNorm<B>,
    /// Self-attention (varies by type)
    self_attn: VideoSelfAttention<B>,
    /// Pre-norm for cross-attention
    norm2: LayerNorm<B>,
    /// Cross-attention
    cross_attn: CrossAttention<B>,
    /// Pre-norm for FFN
    norm3: LayerNorm<B>,
    /// Feed-forward network
    ff: FeedForward<B>,
}

impl<B: ComputeBackend> VideoTransformerBlock<B> {
    pub fn new(config: &VideoTransformerConfig, backend: B) -> Result<Self> {
        let self_attn = match &config.attention_type {
            VideoAttentionType::Factorized => VideoSelfAttention::factorized(
                config.hidden_size,
                config.num_heads,
                config.causal,
                backend.clone(),
            )?,
            VideoAttentionType::JointSpatioTemporal => VideoSelfAttention::joint(
                config.hidden_size,
                config.num_heads,
                config.causal,
                backend.clone(),
            )?,
            VideoAttentionType::Causal => VideoSelfAttention::causal(
                config.hidden_size,
                config.num_heads,
                backend.clone(),
            )?,
            VideoAttentionType::Asymmetric { spatial_heads, temporal_heads } => {
                VideoSelfAttention::asymmetric(
                    config.hidden_size,
                    *spatial_heads,
                    *temporal_heads,
                    backend.clone(),
                )?
            },
        }

        Ok(Self {
            attention_type: config.attention_type.clone(),
            norm1: AdaLayerNorm::new(config.hidden_size, backend.clone())?,
            self_attn,
            norm2: LayerNorm::new(config.hidden_size, backend.clone())?,
            cross_attn: CrossAttention::new(
                config.hidden_size,
                config.cross_attention_dim,
                config.num_heads,
                backend.clone(),
            )?,
            norm3: LayerNorm::new(config.hidden_size, backend.clone())?,
            ff: FeedForward::new(config.hidden_size, config.hidden_size * 4, backend)?,
        })
    }

    pub fn forward(
        &self,
        x: &Tensor<B>,
        timestep: &Tensor<B>,
        encoder_hidden_states: &Tensor<B>,
        encoder_attention_mask: Option<&Tensor<B>>,
        num_temporal: u32,
        num_spatial: u32,
    ) -> Result<Tensor<B>!> {
        // Self-attention with adaptive norm
        let (shift, scale, gate) = self.norm1.forward(timestep)?
        let norm_x! = layer_norm(&x)? * (1.0 + scale) + shift
        let attn_out! = self.self_attn.forward(&norm_x, num_temporal, num_spatial)?
        let x! = x.clone() + gate * attn_out

        // Cross-attention
        let norm_x! = self.norm2.forward(&x)?
        let cross_out! = self.cross_attn.forward(&norm_x, encoder_hidden_states, encoder_attention_mask)?
        let x! = x + cross_out

        // Feed-forward
        let norm_x! = self.norm3.forward(&x)?
        let ff_out! = self.ff.forward(&norm_x)?
        Ok(x + ff_out)
    }

    pub fn load_state_dict(&mut self, state_dict: &Map<str, Tensor<B>>, prefix: &str) -> Result<()> {
        self.norm1.load_state_dict(state_dict, &format!("{}.norm1", prefix))?
        self.self_attn.load_state_dict(state_dict, &format!("{}.attn1", prefix))?
        self.norm2.load_state_dict(state_dict, &format!("{}.norm2", prefix))?
        self.cross_attn.load_state_dict(state_dict, &format!("{}.attn2", prefix))?
        self.norm3.load_state_dict(state_dict, &format!("{}.norm3", prefix))?
        self.ff.load_state_dict(state_dict, &format!("{}.ff", prefix))?
        Ok(())
    }
}

// ============================================================================
// Video Self-Attention Variants
// ============================================================================

/// Video self-attention (multiple implementations)
pub enum VideoSelfAttention<B: ComputeBackend> {
    /// Factorized spatial + temporal
    Factorized(FactorizedAttention<B>),
    /// Joint spatiotemporal
    Joint(JointSpatioTemporalAttention<B>),
    /// Causal autoregressive
    Causal(CausalAttention<B>),
    /// Asymmetric heads
    Asymmetric(AsymmetricAttention<B>),
}

impl<B: ComputeBackend> VideoSelfAttention<B> {
    pub fn factorized(dim: u32, heads: u32, causal: bool, backend: B) -> Result<Self> {
        Ok(Self::Factorized(FactorizedAttention::new(dim, heads, causal, backend)?))
    }

    pub fn joint(dim: u32, heads: u32, causal: bool, backend: B) -> Result<Self> {
        Ok(Self::Joint(JointSpatioTemporalAttention::new(dim, heads, causal, backend)?))
    }

    pub fn causal(dim: u32, heads: u32, backend: B) -> Result<Self> {
        Ok(Self::Causal(CausalAttention::new(dim, heads, backend)?))
    }

    pub fn asymmetric(dim: u32, spatial_heads: u32, temporal_heads: u32, backend: B) -> Result<Self> {
        Ok(Self::Asymmetric(AsymmetricAttention::new(dim, spatial_heads, temporal_heads, backend)?))
    }

    pub fn forward(
        &self,
        x: &Tensor<B>,
        num_temporal: u32,
        num_spatial: u32,
    ) -> Result<Tensor<B>!> {
        match self {
            Self::Factorized(attn) => attn.forward(x, num_temporal, num_spatial),
            Self::Joint(attn) => attn.forward(x),
            Self::Causal(attn) => attn.forward(x, num_temporal, num_spatial),
            Self::Asymmetric(attn) => attn.forward(x, num_temporal, num_spatial),
        }
    }

    pub fn load_state_dict(&mut self, state_dict: &Map<str, Tensor<B>>, prefix: &str) -> Result<()> {
        match self {
            Self::Factorized(attn) => attn.load_state_dict(state_dict, prefix),
            Self::Joint(attn) => attn.load_state_dict(state_dict, prefix),
            Self::Causal(attn) => attn.load_state_dict(state_dict, prefix),
            Self::Asymmetric(attn) => attn.load_state_dict(state_dict, prefix),
        }
    }
}

/// Factorized attention: separate spatial and temporal
pub struct FactorizedAttention<B: ComputeBackend> {
    /// Spatial attention
    spatial_attn: MultiHeadAttention<B>,
    /// Temporal attention
    temporal_attn: MultiHeadAttention<B>,
    /// Use causal temporal
    causal: bool,
}

impl<B: ComputeBackend> FactorizedAttention<B> {
    pub fn new(dim: u32, heads: u32, causal: bool, backend: B) -> Result<Self> {
        Ok(Self {
            spatial_attn: MultiHeadAttention::new(dim, heads, backend.clone())?,
            temporal_attn: MultiHeadAttention::new(dim, heads, backend)?,
            causal,
        })
    }

    pub fn forward(
        &self,
        x: &Tensor<B>,
        num_temporal: u32,
        num_spatial: u32,
    ) -> Result<Tensor<B>!> {
        let (batch, seq, dim) = x.shape3()

        // Reshape to [batch * num_temporal, num_spatial, dim]
        let x = x.reshape([batch, num_temporal, num_spatial, dim])?
        let x = x.permute([0, 1, 2, 3])?.reshape([batch * num_temporal, num_spatial, dim])?

        // Spatial attention
        let x! = self.spatial_attn.forward(&x, None)?

        // Reshape to [batch * num_spatial, num_temporal, dim]
        let x = x.reshape([batch, num_temporal, num_spatial, dim])?
        let x = x.permute([0, 2, 1, 3])?.reshape([batch * num_spatial, num_temporal, dim])?

        // Temporal attention (with optional causal mask)
        let mask = if self.causal {
            Some(create_causal_mask(num_temporal)?)
        } else {
            None
        }
        let x! = self.temporal_attn.forward(&x, mask.as_ref())?

        // Reshape back to [batch, seq, dim]
        x.reshape([batch, num_spatial, num_temporal, dim])?
            .permute([0, 2, 1, 3])?
            .reshape([batch, seq, dim])
    }

    pub fn load_state_dict(&mut self, state_dict: &Map<str, Tensor<B>>, prefix: &str) -> Result<()> {
        self.spatial_attn.load_state_dict(state_dict, &format!("{}.spatial", prefix))?
        self.temporal_attn.load_state_dict(state_dict, &format!("{}.temporal", prefix))
    }
}

/// Joint spatiotemporal attention
pub struct JointSpatioTemporalAttention<B: ComputeBackend> {
    /// Full attention
    attn: MultiHeadAttention<B>,
    /// Use causal
    causal: bool,
}

impl<B: ComputeBackend> JointSpatioTemporalAttention<B> {
    pub fn new(dim: u32, heads: u32, causal: bool, backend: B) -> Result<Self> {
        Ok(Self {
            attn: MultiHeadAttention::new(dim, heads, backend)?,
            causal,
        })
    }

    pub fn forward(&self, x: &Tensor<B>) -> Result<Tensor<B>!> {
        // Full attention over all tokens
        let mask = if self.causal {
            let seq = x.shape()[1]
            Some(create_causal_mask(seq)?)
        } else {
            None
        }

        self.attn.forward(x, mask.as_ref())
    }

    pub fn load_state_dict(&mut self, state_dict: &Map<str, Tensor<B>>, prefix: &str) -> Result<()> {
        self.attn.load_state_dict(state_dict, prefix)
    }
}

/// Causal attention for autoregressive generation
pub struct CausalAttention<B: ComputeBackend> {
    attn: MultiHeadAttention<B>,
}

impl<B: ComputeBackend> CausalAttention<B> {
    pub fn new(dim: u32, heads: u32, backend: B) -> Result<Self> {
        Ok(Self {
            attn: MultiHeadAttention::new(dim, heads, backend)?,
        })
    }

    pub fn forward(
        &self,
        x: &Tensor<B>,
        num_temporal: u32,
        num_spatial: u32,
    ) -> Result<Tensor<B>!> {
        let (batch, seq, dim) = x.shape3()

        // Create spatiotemporal causal mask
        // Each frame can attend to previous frames and all spatial positions
        let mask = create_video_causal_mask(num_temporal, num_spatial)?

        self.attn.forward(x, Some(&mask))
    }

    pub fn load_state_dict(&mut self, state_dict: &Map<str, Tensor<B>>, prefix: &str) -> Result<()> {
        self.attn.load_state_dict(state_dict, prefix)
    }
}

/// Asymmetric attention with different spatial/temporal heads
pub struct AsymmetricAttention<B: ComputeBackend> {
    /// Spatial attention (more heads)
    spatial_attn: MultiHeadAttention<B>,
    /// Temporal attention (fewer heads)
    temporal_attn: MultiHeadAttention<B>,
    /// Linear to combine
    combine: Linear<B>,
}

impl<B: ComputeBackend> AsymmetricAttention<B> {
    pub fn new(dim: u32, spatial_heads: u32, temporal_heads: u32, backend: B) -> Result<Self> {
        Ok(Self {
            spatial_attn: MultiHeadAttention::new(dim, spatial_heads, backend.clone())?,
            temporal_attn: MultiHeadAttention::new(dim, temporal_heads, backend.clone())?,
            combine: Linear::new(dim * 2, dim, backend)?,
        })
    }

    pub fn forward(
        &self,
        x: &Tensor<B>,
        num_temporal: u32,
        num_spatial: u32,
    ) -> Result<Tensor<B>!> {
        let (batch, seq, dim) = x.shape3()

        // Reshape for spatial
        let x_spatial = x.reshape([batch, num_temporal, num_spatial, dim])?
            .permute([0, 1, 2, 3])?
            .reshape([batch * num_temporal, num_spatial, dim])?
        let spatial_out! = self.spatial_attn.forward(&x_spatial, None)?

        // Reshape for temporal
        let x_temporal = x.reshape([batch, num_temporal, num_spatial, dim])?
            .permute([0, 2, 1, 3])?
            .reshape([batch * num_spatial, num_temporal, dim])?
        let temporal_out! = self.temporal_attn.forward(&x_temporal, None)?

        // Reshape both back
        let spatial_out = spatial_out.reshape([batch, num_temporal, num_spatial, dim])?
            .permute([0, 1, 2, 3])?
            .reshape([batch, seq, dim])?
        let temporal_out = temporal_out.reshape([batch, num_spatial, num_temporal, dim])?
            .permute([0, 2, 1, 3])?
            .reshape([batch, seq, dim])?

        // Combine
        let combined = concat(&[&spatial_out, &temporal_out], -1)?
        self.combine.forward(&combined)
    }

    pub fn load_state_dict(&mut self, state_dict: &Map<str, Tensor<B>>, prefix: &str) -> Result<()> {
        self.spatial_attn.load_state_dict(state_dict, &format!("{}.spatial", prefix))?
        self.temporal_attn.load_state_dict(state_dict, &format!("{}.temporal", prefix))?
        self.combine.load_state_dict(state_dict, &format!("{}.combine", prefix))
    }
}

// ============================================================================
// Patch Embedding
// ============================================================================

/// Video patch embedding
pub struct VideoPatchEmbed<B: ComputeBackend> {
    /// Projection layer
    proj: Conv3d<B>,
    /// Spatial patch size
    patch_size: u32,
    /// Temporal patch size
    temporal_patch_size: u32,
}

impl<B: ComputeBackend> VideoPatchEmbed<B> {
    pub fn new(
        in_channels: u32,
        embed_dim: u32,
        patch_size: u32,
        temporal_patch_size: u32,
        backend: B,
    ) -> Result<Self> {
        let proj = Conv3d::new(
            in_channels,
            embed_dim,
            (temporal_patch_size, patch_size, patch_size),
            (temporal_patch_size, patch_size, patch_size),
            (0, 0, 0),
            backend,
        )?

        Ok(Self { proj, patch_size, temporal_patch_size })
    }

    pub fn forward(&self, x: &Tensor<B>) -> Result<Tensor<B>!> {
        // x: [batch, channels, frames, height, width]
        let x! = self.proj.forward(x)?
        // Flatten spatial and temporal: [batch, embed_dim, t', h', w'] -> [batch, t'*h'*w', embed_dim]
        let (batch, embed_dim, t, h, w) = x.shape5()
        x.permute([0, 2, 3, 4, 1])?.reshape([batch, t * h * w, embed_dim])
    }

    pub fn load_state_dict(&mut self, state_dict: &Map<str, Tensor<B>>, prefix: &str) -> Result<()> {
        self.proj.load_state_dict(state_dict, &format!("{}.proj", prefix))
    }
}

/// Video unpatchify
pub struct VideoUnpatchify<B: ComputeBackend> {
    /// Output projection
    proj: Linear<B>,
    /// Spatial patch size
    patch_size: u32,
    /// Temporal patch size
    temporal_patch_size: u32,
    /// Output channels
    out_channels: u32,
}

impl<B: ComputeBackend> VideoUnpatchify<B> {
    pub fn new(
        hidden_size: u32,
        out_channels: u32,
        patch_size: u32,
        temporal_patch_size: u32,
        backend: B,
    ) -> Result<Self> {
        let out_dim = out_channels * patch_size * patch_size * temporal_patch_size
        let proj = Linear::new(hidden_size, out_dim, backend)?

        Ok(Self { proj, patch_size, temporal_patch_size, out_channels })
    }

    pub fn forward(&self, x: &Tensor<B>, t: u32, h: u32, w: u32) -> Result<LatentVideo<B>!> {
        let (batch, seq, dim) = x.shape3()

        let p = self.patch_size
        let pt = self.temporal_patch_size
        let c = self.out_channels

        let num_t = t / pt
        let num_h = h / p
        let num_w = w / p

        // Project to patch pixels
        let x! = self.proj.forward(x)?  // [batch, seq, c * pt * p * p]

        // Reshape to [batch, num_t, num_h, num_w, pt, p, p, c]
        let x = x.reshape([batch, num_t, num_h, num_w, pt, p, p, c])?

        // Permute to [batch, c, num_t, pt, num_h, p, num_w, p]
        let x = x.permute([0, 7, 1, 4, 2, 5, 3, 6])?

        // Reshape to [batch, c, t, h, w]
        x.reshape([batch, c, t, h, w])
    }

    pub fn load_state_dict(&mut self, state_dict: &Map<str, Tensor<B>>, prefix: &str) -> Result<()> {
        self.proj.load_state_dict(state_dict, prefix)
    }
}

// ============================================================================
// Helper Types
// ============================================================================

struct MultiHeadAttention<B: ComputeBackend> {
    to_qkv: Linear<B>,
    to_out: Linear<B>,
    num_heads: u32,
    head_dim: u32,
}

impl<B: ComputeBackend> MultiHeadAttention<B> {
    fn new(dim: u32, heads: u32, backend: B) -> Result<Self> {
        let head_dim = dim / heads
        Ok(Self {
            to_qkv: Linear::new(dim, dim * 3, backend.clone())?,
            to_out: Linear::new(dim, dim, backend)?,
            num_heads: heads,
            head_dim,
        })
    }

    fn forward(&self, x: &Tensor<B>, mask: Option<&Tensor<B>>) -> Result<Tensor<B>!> {
        let (batch, seq, dim) = x.shape3()

        let qkv! = self.to_qkv.forward(x)?
        let (q, k, v) = qkv.chunk(3, -1)?

        let q = q.reshape([batch, seq, self.num_heads, self.head_dim])?.permute([0, 2, 1, 3])?
        let k = k.reshape([batch, seq, self.num_heads, self.head_dim])?.permute([0, 2, 1, 3])?
        let v = v.reshape([batch, seq, self.num_heads, self.head_dim])?.permute([0, 2, 1, 3])?

        let scale = (self.head_dim as f32).sqrt()
        let attn! = (q @ k.transpose(-2, -1)?) / scale

        let attn! = if let Some(m) = mask {
            attn + m
        } else {
            attn
        }

        let attn! = attn.softmax(-1)?
        let out! = attn @ v

        let out = out.permute([0, 2, 1, 3])?.reshape([batch, seq, dim])?
        self.to_out.forward(&out)
    }

    fn load_state_dict(&mut self, state_dict: &Map<str, Tensor<B>>, prefix: &str) -> Result<()> {
        self.to_qkv.load_state_dict(state_dict, &format!("{}.to_qkv", prefix))?
        self.to_out.load_state_dict(state_dict, &format!("{}.to_out", prefix))
    }
}

struct CrossAttention<B: ComputeBackend> {
    to_q: Linear<B>,
    to_kv: Linear<B>,
    to_out: Linear<B>,
    num_heads: u32,
    head_dim: u32,
}

impl<B: ComputeBackend> CrossAttention<B> {
    fn new(dim: u32, context_dim: u32, heads: u32, backend: B) -> Result<Self> {
        let head_dim = dim / heads
        Ok(Self {
            to_q: Linear::new(dim, dim, backend.clone())?,
            to_kv: Linear::new(context_dim, dim * 2, backend.clone())?,
            to_out: Linear::new(dim, dim, backend)?,
            num_heads: heads,
            head_dim,
        })
    }

    fn forward(
        &self,
        x: &Tensor<B>,
        context: &Tensor<B>,
        mask: Option<&Tensor<B>>,
    ) -> Result<Tensor<B>!> {
        let (batch, seq, dim) = x.shape3()
        let context_len = context.shape()[1]

        let q! = self.to_q.forward(x)?
        let kv! = self.to_kv.forward(context)?
        let (k, v) = kv.chunk(2, -1)?

        let q = q.reshape([batch, seq, self.num_heads, self.head_dim])?.permute([0, 2, 1, 3])?
        let k = k.reshape([batch, context_len, self.num_heads, self.head_dim])?.permute([0, 2, 1, 3])?
        let v = v.reshape([batch, context_len, self.num_heads, self.head_dim])?.permute([0, 2, 1, 3])?

        let scale = (self.head_dim as f32).sqrt()
        let attn! = (q @ k.transpose(-2, -1)?) / scale

        let attn! = if let Some(m) = mask {
            attn + m
        } else {
            attn
        }

        let attn! = attn.softmax(-1)?
        let out! = attn @ v

        let out = out.permute([0, 2, 1, 3])?.reshape([batch, seq, dim])?
        self.to_out.forward(&out)
    }

    fn load_state_dict(&mut self, state_dict: &Map<str, Tensor<B>>, prefix: &str) -> Result<()> {
        self.to_q.load_state_dict(state_dict, &format!("{}.to_q", prefix))?
        self.to_kv.load_state_dict(state_dict, &format!("{}.to_kv", prefix))?
        self.to_out.load_state_dict(state_dict, &format!("{}.to_out", prefix))
    }
}

