/// Video Generation Types
///
/// Core types for video diffusion with evidentiality markers.

use crate::core::error::{InfernumError, Result}
use crate::abaddon::backend::{Tensor, TensorOps, ComputeBackend}

// ============================================================================
// Core Video Types
// ============================================================================

/// Video tensor with temporal dimension
/// Shape: [batch, channels, frames, height, width]
pub type VideoTensor<B: ComputeBackend> = Tensor<B>

/// Frame sequence type alias
pub type FrameSequence<B: ComputeBackend> = Vec<Tensor<B>>

/// Latent video tensor (compressed)
/// Shape: [batch, latent_channels, temporal_frames, latent_h, latent_w]
pub type LatentVideo<B: ComputeBackend> = Tensor<B>

/// Motion field tensor (optical flow)
/// Shape: [batch, 2, frames-1, height, width]
pub type MotionField<B: ComputeBackend> = Tensor<B>

// ============================================================================
// Video Configuration
// ============================================================================

/// Video generation configuration
pub struct VideoConfig {
    /// Number of frames to generate
    pub num_frames: u32,
    /// Frames per second
    pub fps: u32,
    /// Output width
    pub width: u32,
    /// Output height
    pub height: u32,
    /// Temporal downsample factor in VAE
    pub temporal_downsample: u32,
    /// Spatial downsample factor in VAE
    pub spatial_downsample: u32,
    /// Number of latent channels
    pub latent_channels: u32,
    /// Use causal temporal modeling
    pub causal: bool,
}

impl VideoConfig {
    /// Default config for SVD (14 frames, 576x1024)
    pub fn svd() -> Self {
        Self {
            num_frames: 14,
            fps: 7,
            width: 1024,
            height: 576,
            temporal_downsample: 1,
            spatial_downsample: 8,
            latent_channels: 4,
            causal: true,
        }
    }

    /// Default config for SVD-XT (25 frames)
    pub fn svd_xt() -> Self {
        Self {
            num_frames: 25,
            fps: 7,
            width: 1024,
            height: 576,
            temporal_downsample: 1,
            spatial_downsample: 8,
            latent_channels: 4,
            causal: true,
        }
    }

    /// Config for AnimateDiff (16 frames, 512x512)
    pub fn animatediff() -> Self {
        Self {
            num_frames: 16,
            fps: 8,
            width: 512,
            height: 512,
            temporal_downsample: 1,
            spatial_downsample: 8,
            latent_channels: 4,
            causal: false,
        }
    }

    /// Config for CogVideoX (49 frames)
    pub fn cogvideox() -> Self {
        Self {
            num_frames: 49,
            fps: 8,
            width: 720,
            height: 480,
            temporal_downsample: 4,
            spatial_downsample: 8,
            latent_channels: 16,
            causal: true,
        }
    }

    /// Config for Mochi (84 frames at 30fps)
    pub fn mochi() -> Self {
        Self {
            num_frames: 84,
            fps: 30,
            width: 848,
            height: 480,
            temporal_downsample: 6,
            spatial_downsample: 8,
            latent_channels: 12,
            causal: true,
        }
    }

    /// Config for LTX-Video
    pub fn ltx_video() -> Self {
        Self {
            num_frames: 121,
            fps: 24,
            width: 768,
            height: 512,
            temporal_downsample: 8,
            spatial_downsample: 8,
            latent_channels: 128,
            causal: true,
        }
    }

    /// Calculate latent dimensions
    pub fn latent_dims(&self) -> (u32, u32, u32) {
        let t = self.num_frames / self.temporal_downsample
        let h = self.height / self.spatial_downsample
        let w = self.width / self.spatial_downsample
        (t, h, w)
    }

    /// Calculate total latent size
    pub fn latent_size(&self) -> u64 {
        let (t, h, w) = self.latent_dims()
        self.latent_channels as u64 * t as u64 * h as u64 * w as u64
    }
}

/// Video format specification
pub enum VideoFormat {
    /// MP4 with H.264 codec
    MP4H264,
    /// MP4 with H.265/HEVC codec
    MP4H265,
    /// WebM with VP9 codec
    WebMVP9,
    /// GIF (animated)
    GIF,
    /// Raw frame sequence (PNG)
    Frames,
    /// Raw tensor output
    Tensor,
}

/// Frame rate specification
pub enum FrameRate {
    /// Fixed frame rate
    Fixed(u32),
    /// Variable frame rate with keyframes
    Variable { base: u32, keyframe_interval: u32 },
    /// Match source frame rate
    MatchSource,
}

// ============================================================================
// Temporal Configuration
// ============================================================================

/// Temporal modeling configuration
pub struct TemporalConfig {
    /// Number of temporal attention layers
    pub num_temporal_layers: u32,
    /// Temporal attention heads
    pub temporal_heads: u32,
    /// Temporal attention dimension
    pub temporal_dim: u32,
    /// Use causal (autoregressive) attention
    pub causal_attention: bool,
    /// Temporal positional encoding type
    pub position_encoding: TemporalPositionType,
    /// Frame conditioning mode
    pub frame_conditioning: FrameConditioningMode,
}

impl TemporalConfig {
    pub fn default() -> Self {
        Self {
            num_temporal_layers: 1,
            temporal_heads: 8,
            temporal_dim: 320,
            causal_attention: false,
            position_encoding: TemporalPositionType::Sinusoidal,
            frame_conditioning: FrameConditioningMode::None,
        }
    }

    /// SVD-style causal config
    pub fn svd() -> Self {
        Self {
            num_temporal_layers: 1,
            temporal_heads: 8,
            temporal_dim: 1024,
            causal_attention: true,
            position_encoding: TemporalPositionType::Learned,
            frame_conditioning: FrameConditioningMode::FirstFrame,
        }
    }

    /// AnimateDiff-style bidirectional config
    pub fn animatediff() -> Self {
        Self {
            num_temporal_layers: 2,
            temporal_heads: 8,
            temporal_dim: 320,
            causal_attention: false,
            position_encoding: TemporalPositionType::Sinusoidal,
            frame_conditioning: FrameConditioningMode::None,
        }
    }
}

/// Temporal positional encoding type
pub enum TemporalPositionType {
    /// Sinusoidal positional encoding
    Sinusoidal,
    /// Learned positional embeddings
    Learned,
    /// Rotary position embeddings (RoPE)
    RoPE,
    /// Alibi-style relative positions
    Alibi,
    /// No positional encoding
    None,
}

/// Frame conditioning mode
pub enum FrameConditioningMode {
    /// No frame conditioning
    None,
    /// Condition on first frame only
    FirstFrame,
    /// Condition on first and last frames
    FirstLast,
    /// Condition on keyframes at intervals
    Keyframes { interval: u32 },
    /// Condition on previous N frames (autoregressive)
    Previous { count: u32 },
}

// ============================================================================
// Motion Configuration
// ============================================================================

/// Motion control configuration
pub struct MotionConfig {
    /// Motion bucket ID (SVD-style)
    pub motion_bucket_id: u32,
    /// Noise augmentation level
    pub noise_aug_strength: f32,
    /// Use motion field conditioning
    pub use_motion_field: bool,
    /// Motion vector scale
    pub motion_scale: f32,
    /// Trajectory control points
    pub trajectory: Option<Vec<TrajectoryPoint>>,
}

impl MotionConfig {
    pub fn default() -> Self {
        Self {
            motion_bucket_id: 127,
            noise_aug_strength: 0.02,
            use_motion_field: false,
            motion_scale: 1.0,
            trajectory: None,
        }
    }

    /// Low motion (static scenes)
    pub fn low_motion() -> Self {
        Self {
            motion_bucket_id: 50,
            noise_aug_strength: 0.01,
            use_motion_field: false,
            motion_scale: 0.5,
            trajectory: None,
        }
    }

    /// High motion (dynamic scenes)
    pub fn high_motion() -> Self {
        Self {
            motion_bucket_id: 200,
            noise_aug_strength: 0.03,
            use_motion_field: false,
            motion_scale: 1.5,
            trajectory: None,
        }
    }
}

/// Trajectory control point
pub struct TrajectoryPoint {
    /// Frame index
    pub frame: u32,
    /// X position (normalized 0-1)
    pub x: f32,
    /// Y position (normalized 0-1)
    pub y: f32,
    /// Optional scale
    pub scale: Option<f32>,
    /// Optional rotation (radians)
    pub rotation: Option<f32>,
}

// ============================================================================
// Video Output
// ============================================================================

/// Video generation output
pub struct VideoOutput<B: ComputeBackend> {
    /// Generated frames as tensor [batch, frames, channels, height, width]
    pub frames!: VideoTensor<B>,
    /// Latent representation
    pub latents!: LatentVideo<B>,
    /// Generation seed
    pub seed: u64,
    /// Frame timestamps
    pub timestamps: Vec<f32>,
    /// Motion metrics
    pub motion_metrics: Option<MotionMetrics>,
}

impl<B: ComputeBackend> VideoOutput<B> {
    /// Get number of frames
    pub fn num_frames(&self) -> u32 {
        self.frames.shape()[1] as u32
    }

    /// Get frame at index
    pub fn get_frame(&self, index: u32) -> Result<Tensor<B>> {
        if index >= self.num_frames() {
            return Err(InfernumError::InvalidIndex(format!(
                "Frame index {} out of bounds ({})", index, self.num_frames()
            )))
        }
        Ok(self.frames.slice([.., index..index+1, .., .., ..])?.squeeze(1)?)
    }

    /// Get frame range
    pub fn get_frames(&self, start: u32, end: u32) -> Result<VideoTensor<B>> {
        Ok(self.frames.slice([.., start..end, .., .., ..])?)
    }

    /// Convert to frame sequence
    pub fn to_frame_sequence(&self) -> Result<FrameSequence<B>> {
        let mut frames = Vec::new()
        for i in 0..self.num_frames() {
            frames.push(self.get_frame(i)?)
        }
        Ok(frames)
    }

    /// Interpolate to higher frame rate
    pub fn interpolate(&self, target_fps: u32, backend: &B) -> Result<VideoOutput<B>> {
        let current_fps = (self.num_frames() as f32 / self.timestamps.last().unwrap_or(&1.0)) as u32
        let scale = target_fps as f32 / current_fps as f32

        if scale <= 1.0 {
            return Ok(self.clone())
        }

        let new_num_frames = (self.num_frames() as f32 * scale) as u32
        let interpolated = frame_interpolation(&self.frames, new_num_frames, backend)?

        Ok(VideoOutput {
            frames: interpolated,
            latents: self.latents.clone(),  // Keep original latents
            seed: self.seed,
            timestamps: (0..new_num_frames)
                .map(|i| i as f32 / target_fps as f32)
                .collect(),
            motion_metrics: self.motion_metrics.clone(),
        })
    }
}

/// Motion analysis metrics
#[derive(Clone)]
pub struct MotionMetrics {
    /// Average optical flow magnitude
    pub avg_motion: f32,
    /// Motion variance
    pub motion_variance: f32,
    /// Temporal consistency score
    pub temporal_consistency: f32,
    /// Per-frame motion values
    pub per_frame_motion: Vec<f32>,
}

// ============================================================================
// Video Model Architectures
// ============================================================================

/// Video model architecture type
pub enum VideoArchitecture {
    /// Stable Video Diffusion (U-Net with temporal layers)
    SVD,
    /// SVD-XT (extended temporal)
    SVDXT,
    /// AnimateDiff (motion modules)
    AnimateDiff,
    /// CogVideoX (3D DiT)
    CogVideoX,
    /// Mochi (asymmetric DiT)
    Mochi,
    /// LTX-Video (compressed latent)
    LTXVideo,
    /// Custom architecture
    Custom { name: str },
}

impl VideoArchitecture {
    /// Get default config for architecture
    pub fn default_config(&self) -> VideoConfig {
        match self {
            Self::SVD => VideoConfig::svd(),
            Self::SVDXT => VideoConfig::svd_xt(),
            Self::AnimateDiff => VideoConfig::animatediff(),
            Self::CogVideoX => VideoConfig::cogvideox(),
            Self::Mochi => VideoConfig::mochi(),
            Self::LTXVideo => VideoConfig::ltx_video(),
            Self::Custom { .. } => VideoConfig::svd(),
        }
    }

    /// Check if architecture supports text-to-video
    pub fn supports_t2v(&self) -> bool {
        matches!(self, Self::CogVideoX | Self::Mochi | Self::LTXVideo)
    }

    /// Check if architecture supports image-to-video
    pub fn supports_i2v(&self) -> bool {
        matches!(self, Self::SVD | Self::SVDXT | Self::AnimateDiff | Self::CogVideoX)
    }

    /// Get model size estimate in GB
    pub fn model_size_gb(&self) -> f32 {
        match self {
            Self::SVD => 4.0,
            Self::SVDXT => 4.0,
            Self::AnimateDiff => 1.5,  // Just motion modules
            Self::CogVideoX => 9.4,
            Self::Mochi => 10.0,
            Self::LTXVideo => 3.0,
            Self::Custom { .. } => 5.0,
        }
    }
}

// ============================================================================
// Conditioning Types
// ============================================================================

/// Image conditioning for I2V
pub struct ImageCondition<B: ComputeBackend> {
    /// Conditioning image tensor
    pub image~: Tensor<B>,
    /// Noise augmentation strength
    pub noise_aug: f32,
    /// Use image as first frame (vs. guidance)
    pub as_first_frame: bool,
}

/// Text conditioning for T2V
pub struct TextCondition {
    /// Positive prompt
    pub prompt~: str,
    /// Negative prompt
    pub negative_prompt~: Option<str>,
    /// Guidance scale
    pub guidance_scale: f32,
}

/// Combined conditioning
pub struct VideoCondition<B: ComputeBackend> {
    /// Image condition (for I2V)
    pub image: Option<ImageCondition<B>>,
    /// Text condition
    pub text: TextCondition,
    /// Motion config
    pub motion: MotionConfig,
    /// FPS conditioning
    pub fps_condition: Option<u32>,
    /// Micro-conditioning (SDXL-style)
    pub micro_cond: Option<MicroCondition>,
}

/// Micro-conditioning for fine control
pub struct MicroCondition {
    /// Original resolution
    pub original_size: (u32, u32),
    /// Crop coordinates
    pub crop_coords: (u32, u32),
    /// Target resolution
    pub target_size: (u32, u32),
}

// ============================================================================
// Helper Functions
// ============================================================================

/// Frame interpolation using optical flow
fn frame_interpolation<B: ComputeBackend>(
    video: &VideoTensor<B>,
    target_frames: u32,
    backend: &B,
) -> Result<VideoTensor<B>!> {
    let (batch, frames, channels, height, width) = video.shape5()

    if target_frames <= frames {
        return Ok(video.clone())
    }

    // Calculate interpolation factor
    let scale = target_frames as f32 / frames as f32

    // Use RIFE-style interpolation
    let mut result_frames: Vec<Tensor<B>> = Vec::new()

    for i in 0..(frames - 1) {
        let frame0 = video.slice([.., i..i+1, .., .., ..])?.squeeze(1)?
        let frame1 = video.slice([.., i+1..i+2, .., .., ..])?.squeeze(1)?

        result_frames.push(frame0.clone())

        // Calculate number of intermediate frames
        let num_interp = (scale as u32).max(1) - 1
        for j in 1..=num_interp {
            let t = j as f32 / (num_interp + 1) as f32
            let interp = interpolate_frames(&frame0, &frame1, t, backend)?
            result_frames.push(interp)
        }
    }

    // Add last frame
    result_frames.push(video.slice([.., frames-1..frames, .., .., ..])?.squeeze(1)?)

    // Stack frames
    stack_frames(&result_frames, backend)
}

fn interpolate_frames<B: ComputeBackend>(
    frame0: &Tensor<B>,
    frame1: &Tensor<B>,
    t: f32,
    _backend: &B,
) -> Result<Tensor<B>!> {
    // Simple linear interpolation (can be replaced with optical flow warping)
    Ok(frame0.clone() * (1.0 - t) + frame1.clone() * t)
}

fn stack_frames<B: ComputeBackend>(
    frames: &[Tensor<B>],
    backend: &B,
) -> Result<VideoTensor<B>!> {
    // Stack along temporal dimension
    backend.stack(frames, 1)
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_video_config_svd() {
        let config = VideoConfig::svd()
        assert_eq!(config.num_frames, 14)
        assert_eq!(config.fps, 7)
    }

    #[test]
    fn test_latent_dims() {
        let config = VideoConfig::cogvideox()
        let (t, h, w) = config.latent_dims()
        assert_eq!(t, 49 / 4)  // temporal_downsample = 4
        assert_eq!(h, 480 / 8)
        assert_eq!(w, 720 / 8)
    }

    #[test]
    fn test_motion_config() {
        let low = MotionConfig::low_motion()
        let high = MotionConfig::high_motion()
        assert!(low.motion_bucket_id < high.motion_bucket_id)
    }

    #[test]
    fn test_architecture_support() {
        assert!(VideoArchitecture::SVD.supports_i2v())
        assert!(!VideoArchitecture::SVD.supports_t2v())
        assert!(VideoArchitecture::Mochi.supports_t2v())
    }
}
