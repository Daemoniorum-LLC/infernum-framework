// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_video_generation_request() {
        let request = VideoGenerationRequest::new("a cat walking")
        assert!(request.negative_prompt.is_none())
    }

    #[test]
    fn test_video_progress_info() {
        let info = VideoProgressInfo {
            step: 5,
            total_steps: 25,
            frame: Some(0),
            total_frames: Some(14),
        }
        assert_eq!(info.step, 5)
    }
}
