// ============================================================================
// Kernel Launcher
// ============================================================================

/// Unified kernel launcher
pub struct KernelLauncher<'a> {
    pub gemm: GemmKernel<'a>,
    pub softmax: SoftmaxKernel<'a>,
    pub layer_norm: LayerNormKernel<'a>,
    pub rope: RopeKernel<'a>,
    pub activation: ActivationKernels<'a>,
    pub elementwise: ElementwiseKernels<'a>,
    pub quant: QuantKernels<'a>,
}

impl<'a> KernelLauncher<'a> {
    pub fn new(backend: &'a CudaBackend) -> Self {
        Self {
            gemm: GemmKernel::new(backend),
            softmax: SoftmaxKernel::new(backend),
            layer_norm: LayerNormKernel::new(backend, 1e-5),
            rope: RopeKernel::new(backend),
            activation: ActivationKernels::new(backend),
            elementwise: ElementwiseKernels::new(backend),
            quant: QuantKernels::new(backend),
        }
    }
}
