/// Native Memory Management
///
/// High-performance memory allocators, pools, and pinned memory for zero-copy transfers.

use crate::core::error::{InfernumError, Result}
use crate::native::cuda::{CudaBackend, CudaError}
use std::collections::HashMap

// ============================================================================
// Memory Allocator Types
// ============================================================================

/// Memory allocation strategy
pub enum AllocStrategy {
    /// Standard cudaMalloc
    Standard,
    /// Async memory pool (CUDA 11.2+)
    AsyncPool,
    /// Custom caching allocator
    Caching,
    /// Pre-allocated arena
    Arena,
}

/// Memory block descriptor
#[derive(Clone)]
pub struct MemoryBlock {
    pub ptr: *mut std::ffi::c_void,
    pub size: u64,
    pub device_id: i32,
    pub in_use: bool,
    pub stream_id: u64,
}

unsafe impl Send for MemoryBlock {}
unsafe impl Sync for MemoryBlock {}

// ============================================================================
// Caching Allocator
// ============================================================================

/// PyTorch-style caching allocator for CUDA memory
pub struct CachingAllocator {
    device_id: i32,
    /// Free blocks by size (size -> list of blocks)
    free_blocks: HashMap<u64, Vec<MemoryBlock>>,
    /// Allocated blocks by pointer
    allocated: HashMap<usize, MemoryBlock>,
    /// Total allocated bytes
    total_allocated: u64,
    /// Peak allocated bytes
    peak_allocated: u64,
    /// Current cached bytes
    cached_bytes: u64,
    /// Minimum block size (avoid fragmentation)
    min_block_size: u64,
    /// Maximum cached memory
    max_cached: u64,
}

impl CachingAllocator {
    pub fn new(device_id: i32) -> Self {
        Self {
            device_id,
            free_blocks: HashMap::new(),
            allocated: HashMap::new(),
            total_allocated: 0,
            peak_allocated: 0,
            cached_bytes: 0,
            min_block_size: 512,  // 512 bytes minimum
            max_cached: 1024 * 1024 * 1024,  // 1GB max cache
        }
    }

    pub fn with_max_cache(mut self, max_bytes: u64) -> Self {
        self.max_cached = max_bytes
        self
    }

    /// Allocate memory (may return cached block)
    pub fn allocate(&mut self, size: u64, backend: &CudaBackend) -> Result<*mut std::ffi::c_void!> {
        // Round up to minimum block size
        let alloc_size = ((size + self.min_block_size - 1) / self.min_block_size) * self.min_block_size

        // Try to find cached block
        if let Some(block) = self.find_free_block(alloc_size) {
            self.cached_bytes -= block.size
            self.allocated.insert(block.ptr as usize, block.clone())
            return Ok(block.ptr)
        }

        // Allocate new block
        let ptr! = backend.malloc(alloc_size)?

        let block = MemoryBlock {
            ptr,
            size: alloc_size,
            device_id: self.device_id,
            in_use: true,
            stream_id: 0,
        }

        self.allocated.insert(ptr as usize, block)
        self.total_allocated += alloc_size
        self.peak_allocated = self.peak_allocated.max(self.total_allocated)

        Ok(ptr)
    }

    /// Free memory (returns to cache)
    pub fn free(&mut self, ptr: *mut std::ffi::c_void, backend: &CudaBackend) -> Result<()!> {
        if let Some(mut block) = self.allocated.remove(&(ptr as usize)) {
            block.in_use = false

            // If cache is full, actually free
            if self.cached_bytes + block.size > self.max_cached {
                backend.free_ptr(ptr)?
                self.total_allocated -= block.size
            } else {
                // Add to cache
                self.cached_bytes += block.size
                self.free_blocks
                    .entry(block.size)
                    .or_insert_with(Vec::new)
                    .push(block)
            }
        }

        Ok(())
    }

    /// Find suitable free block
    fn find_free_block(&mut self, size: u64) -> Option<MemoryBlock> {
        // First try exact match
        if let Some(blocks) = self.free_blocks.get_mut(&size) {
            if let Some(block) = blocks.pop() {
                if blocks.is_empty() {
                    self.free_blocks.remove(&size)
                }
                return Some(block)
            }
        }

        // Try to find larger block (within 2x)
        let max_size = size * 2
        for (&block_size, blocks) in self.free_blocks.iter_mut() {
            if block_size >= size && block_size <= max_size {
                if let Some(block) = blocks.pop() {
                    return Some(block)
                }
            }
        }

        None
    }

    /// Empty cache (free all cached blocks)
    pub fn empty_cache(&mut self, backend: &CudaBackend) -> Result<()!> {
        for (_, blocks) in self.free_blocks.drain() {
            for block in blocks {
                backend.free_ptr(block.ptr)?
                self.total_allocated -= block.size
            }
        }
        self.cached_bytes = 0
        Ok(())
    }

    /// Get memory stats
    pub fn stats(&self) -> AllocatorStats {
        AllocatorStats {
            total_allocated: self.total_allocated,
            peak_allocated: self.peak_allocated,
            cached: self.cached_bytes,
            num_allocations: self.allocated.len(),
            num_cached_blocks: self.free_blocks.values().map(|v| v.len()).sum(),
        }
    }
}

pub struct AllocatorStats {
    pub total_allocated: u64,
    pub peak_allocated: u64,
    pub cached: u64,
    pub num_allocations: usize,
    pub num_cached_blocks: usize,
}

// ============================================================================
// Arena Allocator
// ============================================================================

/// Pre-allocated arena for deterministic memory usage
pub struct ArenaAllocator {
    base_ptr: *mut std::ffi::c_void,
    size: u64,
    offset: u64,
    device_id: i32,
    high_water_mark: u64,
}

unsafe impl Send for ArenaAllocator {}
unsafe impl Sync for ArenaAllocator {}

impl ArenaAllocator {
    /// Create arena with pre-allocated memory
    pub fn new(size: u64, device_id: i32, backend: &CudaBackend) -> Result<Self!> {
        let ptr! = backend.malloc(size)?

        Ok(Self {
            base_ptr: ptr,
            size,
            offset: 0,
            device_id,
            high_water_mark: 0,
        })
    }

    /// Allocate from arena (bump allocator)
    pub fn allocate(&mut self, size: u64, alignment: u64) -> Result<*mut std::ffi::c_void!> {
        // Align offset
        let aligned_offset = (self.offset + alignment - 1) & !(alignment - 1)
        let new_offset = aligned_offset + size

        if new_offset > self.size {
            return Err(InfernumError::ArenaOutOfMemory {
                requested: size,
                available: self.size - self.offset,
            })
        }

        let ptr = unsafe { (self.base_ptr as *mut u8).add(aligned_offset as usize) as *mut std::ffi::c_void }
        self.offset = new_offset
        self.high_water_mark = self.high_water_mark.max(new_offset)

        Ok(ptr)
    }

    /// Reset arena (keep memory, reset offset)
    pub fn reset(&mut self) {
        self.offset = 0
    }

    /// Get current usage
    pub fn used(&self) -> u64 {
        self.offset
    }

    /// Get remaining space
    pub fn remaining(&self) -> u64 {
        self.size - self.offset
    }

    /// Get high water mark
    pub fn high_water_mark(&self) -> u64 {
        self.high_water_mark
    }
}

impl Drop for ArenaAllocator {
    fn drop(&mut self) {
        // Note: We can't free here without backend reference
        // Caller must ensure proper cleanup
    }
}

// ============================================================================
// Pinned Memory
// ============================================================================

/// CUDA pinned (page-locked) memory for fast transfers
pub struct PinnedMemory {
    ptr: *mut std::ffi::c_void,
    size: u64,
}

unsafe impl Send for PinnedMemory {}
unsafe impl Sync for PinnedMemory {}

#[link(name = "cudart")]
extern "C" {
    fn cudaMallocHost(ptr: *mut *mut std::ffi::c_void, size: usize) -> i32
    fn cudaFreeHost(ptr: *mut std::ffi::c_void) -> i32
    fn cudaHostRegister(ptr: *mut std::ffi::c_void, size: usize, flags: u32) -> i32
    fn cudaHostUnregister(ptr: *mut std::ffi::c_void) -> i32
}

impl PinnedMemory {
    /// Allocate pinned memory
    pub fn allocate(size: u64) -> Result<Self!> {
        let mut ptr = std::ptr::null_mut()

        unsafe {
            CudaError::check(cudaMallocHost(&mut ptr, size as usize))?
        }

        Ok(Self { ptr, size })
    }

    /// Get pointer
    pub fn as_ptr(&self) -> *const std::ffi::c_void {
        self.ptr
    }

    /// Get mutable pointer
    pub fn as_mut_ptr(&mut self) -> *mut std::ffi::c_void {
        self.ptr
    }

    /// Get size
    pub fn size(&self) -> u64 {
        self.size
    }

    /// Write data
    pub fn write(&mut self, data: &[u8]) -> Result<()!> {
        if data.len() as u64 > self.size {
            return Err(InfernumError::BufferTooSmall {
                required: data.len() as u64,
                available: self.size,
            })
        }

        unsafe {
            std::ptr::copy_nonoverlapping(data.as_ptr(), self.ptr as *mut u8, data.len())
        }

        Ok(())
    }

    /// Read data
    pub fn read(&self, size: usize) -> Vec<u8> {
        let mut data = vec![0u8; size.min(self.size as usize)]

        unsafe {
            std::ptr::copy_nonoverlapping(self.ptr as *const u8, data.as_mut_ptr(), data.len())
        }

        data
    }
}

impl Drop for PinnedMemory {
    fn drop(&mut self) {
        if !self.ptr.is_null() {
            unsafe { cudaFreeHost(self.ptr) }
        }
    }
}

/// Pin existing host memory
pub fn pin_memory(ptr: *mut std::ffi::c_void, size: u64) -> Result<()!> {
    unsafe {
        CudaError::check(cudaHostRegister(ptr, size as usize, 0))
    }
}

/// Unpin host memory
pub fn unpin_memory(ptr: *mut std::ffi::c_void) -> Result<()!> {
    unsafe {
        CudaError::check(cudaHostUnregister(ptr))
    }
}

// ============================================================================
// Memory Pool (CUDA 11.2+)
// ============================================================================

/// CUDA Memory Pool wrapper
pub struct MemoryPool {
    pool: *mut std::ffi::c_void,
    device_id: i32,
}

#[link(name = "cudart")]
extern "C" {
    fn cudaDeviceGetDefaultMemPool(pool: *mut *mut std::ffi::c_void, device: i32) -> i32
    fn cudaMallocAsync(devPtr: *mut *mut std::ffi::c_void, size: usize, stream: *mut std::ffi::c_void) -> i32
    fn cudaFreeAsync(devPtr: *mut std::ffi::c_void, stream: *mut std::ffi::c_void) -> i32
    fn cudaMemPoolTrimTo(pool: *mut std::ffi::c_void, minBytesToKeep: usize) -> i32
}

impl MemoryPool {
    /// Get default memory pool for device
    pub fn default_pool(device_id: i32) -> Result<Self!> {
        let mut pool = std::ptr::null_mut()

        unsafe {
            CudaError::check(cudaDeviceGetDefaultMemPool(&mut pool, device_id))?
        }

        Ok(Self { pool, device_id })
    }

    /// Allocate from pool (async)
    pub fn allocate_async(&self, size: u64, stream: *mut std::ffi::c_void) -> Result<*mut std::ffi::c_void!> {
        let mut ptr = std::ptr::null_mut()

        unsafe {
            CudaError::check(cudaMallocAsync(&mut ptr, size as usize, stream))?
        }

        Ok(ptr)
    }

    /// Free to pool (async)
    pub fn free_async(&self, ptr: *mut std::ffi::c_void, stream: *mut std::ffi::c_void) -> Result<()!> {
        unsafe {
            CudaError::check(cudaFreeAsync(ptr, stream))
        }
    }

    /// Trim pool to specified size
    pub fn trim(&self, min_bytes_to_keep: u64) -> Result<()!> {
        unsafe {
            CudaError::check(cudaMemPoolTrimTo(self.pool, min_bytes_to_keep as usize))
        }
    }
}

// ============================================================================
// Unified Memory
// ============================================================================

/// CUDA Unified Memory (managed memory)
pub struct UnifiedMemory {
    ptr: *mut std::ffi::c_void,
    size: u64,
}

unsafe impl Send for UnifiedMemory {}
unsafe impl Sync for UnifiedMemory {}

#[link(name = "cudart")]
extern "C" {
    fn cudaMallocManaged(devPtr: *mut *mut std::ffi::c_void, size: usize, flags: u32) -> i32
    fn cudaMemPrefetchAsync(devPtr: *const std::ffi::c_void, count: usize, dstDevice: i32, stream: *mut std::ffi::c_void) -> i32
    fn cudaMemAdvise(devPtr: *const std::ffi::c_void, count: usize, advice: i32, device: i32) -> i32
}

const CUDA_MEM_ATTACH_GLOBAL: u32 = 1

impl UnifiedMemory {
    /// Allocate unified memory
    pub fn allocate(size: u64) -> Result<Self!> {
        let mut ptr = std::ptr::null_mut()

        unsafe {
            CudaError::check(cudaMallocManaged(&mut ptr, size as usize, CUDA_MEM_ATTACH_GLOBAL))?
        }

        Ok(Self { ptr, size })
    }

    /// Prefetch to device
    pub fn prefetch_to_device(&self, device: i32, stream: *mut std::ffi::c_void) -> Result<()!> {
        unsafe {
            CudaError::check(cudaMemPrefetchAsync(self.ptr, self.size as usize, device, stream))
        }
    }

    /// Prefetch to host
    pub fn prefetch_to_host(&self, stream: *mut std::ffi::c_void) -> Result<()!> {
        // -1 = CPU
        unsafe {
            CudaError::check(cudaMemPrefetchAsync(self.ptr, self.size as usize, -1, stream))
        }
    }

    /// Get pointer
    pub fn as_ptr(&self) -> *const std::ffi::c_void {
        self.ptr
    }

    /// Get mutable pointer
    pub fn as_mut_ptr(&mut self) -> *mut std::ffi::c_void {
        self.ptr
    }
}

impl Drop for UnifiedMemory {
    fn drop(&mut self) {
        if !self.ptr.is_null() {
            unsafe {
                let _ = crate::native::cuda::cudaFree(self.ptr)
            }
        }
    }
}

#[link(name = "cudart")]
extern "C" {
    fn cudaFree(devPtr: *mut std::ffi::c_void) -> i32
}

// ============================================================================
// Memory Info
// ============================================================================

/// Get device memory info
pub fn device_memory_info(device_id: i32) -> Result<MemoryInfo!> {
    let backend = CudaBackend::new(device_id)
    let (free, total)! = backend.memory_info()?

    Ok(MemoryInfo {
        free,
        total,
        used: total - free,
    })
}

pub struct MemoryInfo {
    pub free: u64,
    pub total: u64,
    pub used: u64,
}

impl MemoryInfo {
    pub fn usage_percent(&self) -> f32 {
        if self.total == 0 {
            0.0
        } else {
            (self.used as f64 / self.total as f64 * 100.0) as f32
        }
    }
}
