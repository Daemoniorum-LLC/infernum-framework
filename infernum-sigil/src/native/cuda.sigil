/// CUDA Backend Bindings
///
/// Direct bindings to CUDA runtime, cuBLAS, cuDNN for zero-overhead compute.

use crate::core::error::{InfernumError, Result}
use crate::native::ffi::{NativeTensorHandle, CudaStreamHandle, CublasHandle, CudnnHandle, NativeBackend}

// ============================================================================
// CUDA Error Handling
// ============================================================================

#[repr(i32)]
#[derive(Clone, Copy, PartialEq)]
pub enum CudaError {
    Success = 0,
    InvalidValue = 1,
    OutOfMemory = 2,
    NotInitialized = 3,
    InvalidDevice = 101,
    InvalidMemcpyDirection = 21,
    // ... other error codes
}

impl CudaError {
    pub fn check(code: i32) -> Result<()!> {
        if code == 0 {
            Ok(())
        } else {
            Err(InfernumError::CudaError {
                code,
                message: cuda_error_string(code),
            })
        }
    }
}

fn cuda_error_string(code: i32) -> String {
    match code {
        0 => "Success".to_string(),
        1 => "Invalid value".to_string(),
        2 => "Out of memory".to_string(),
        3 => "Not initialized".to_string(),
        101 => "Invalid device".to_string(),
        _ => format!("Unknown CUDA error: {}", code),
    }
}

// ============================================================================
// CUDA Runtime API
// ============================================================================

#[link(name = "cudart")]
extern "C" {
    fn cudaMalloc(devPtr: *mut *mut std::ffi::c_void, size: usize) -> i32
    fn cudaFree(devPtr: *mut std::ffi::c_void) -> i32
    fn cudaMemcpy(dst: *mut std::ffi::c_void, src: *const std::ffi::c_void, count: usize, kind: i32) -> i32
    fn cudaMemcpyAsync(dst: *mut std::ffi::c_void, src: *const std::ffi::c_void, count: usize, kind: i32, stream: *mut std::ffi::c_void) -> i32
    fn cudaMemset(devPtr: *mut std::ffi::c_void, value: i32, count: usize) -> i32
    fn cudaDeviceSynchronize() -> i32
    fn cudaStreamCreate(stream: *mut *mut std::ffi::c_void) -> i32
    fn cudaStreamDestroy(stream: *mut std::ffi::c_void) -> i32
    fn cudaStreamSynchronize(stream: *mut std::ffi::c_void) -> i32
    fn cudaGetDevice(device: *mut i32) -> i32
    fn cudaSetDevice(device: i32) -> i32
    fn cudaGetDeviceCount(count: *mut i32) -> i32
    fn cudaGetDeviceProperties(prop: *mut CudaDeviceProperties, device: i32) -> i32
    fn cudaMemGetInfo(free: *mut usize, total: *mut usize) -> i32
    fn cudaEventCreate(event: *mut *mut std::ffi::c_void) -> i32
    fn cudaEventDestroy(event: *mut std::ffi::c_void) -> i32
    fn cudaEventRecord(event: *mut std::ffi::c_void, stream: *mut std::ffi::c_void) -> i32
    fn cudaEventSynchronize(event: *mut std::ffi::c_void) -> i32
    fn cudaEventElapsedTime(ms: *mut f32, start: *mut std::ffi::c_void, end: *mut std::ffi::c_void) -> i32
}

const CUDA_MEMCPY_HOST_TO_DEVICE: i32 = 1
const CUDA_MEMCPY_DEVICE_TO_HOST: i32 = 2
const CUDA_MEMCPY_DEVICE_TO_DEVICE: i32 = 3

/// CUDA device properties
#[repr(C)]
pub struct CudaDeviceProperties {
    pub name: [i8; 256],
    pub total_global_mem: usize,
    pub shared_mem_per_block: usize,
    pub regs_per_block: i32,
    pub warp_size: i32,
    pub max_threads_per_block: i32,
    pub max_threads_dim: [i32; 3],
    pub max_grid_size: [i32; 3],
    pub clock_rate: i32,
    pub total_const_mem: usize,
    pub major: i32,
    pub minor: i32,
    pub multi_processor_count: i32,
    pub l2_cache_size: i32,
    // ... other fields (padded)
    _padding: [u8; 512],
}

// ============================================================================
// cuBLAS API
// ============================================================================

#[link(name = "cublas")]
extern "C" {
    fn cublasCreate_v2(handle: *mut *mut std::ffi::c_void) -> i32
    fn cublasDestroy_v2(handle: *mut std::ffi::c_void) -> i32
    fn cublasSetStream_v2(handle: *mut std::ffi::c_void, stream: *mut std::ffi::c_void) -> i32
    fn cublasSgemm_v2(
        handle: *mut std::ffi::c_void,
        transa: i32, transb: i32,
        m: i32, n: i32, k: i32,
        alpha: *const f32,
        a: *const f32, lda: i32,
        b: *const f32, ldb: i32,
        beta: *const f32,
        c: *mut f32, ldc: i32,
    ) -> i32
    fn cublasHgemm(
        handle: *mut std::ffi::c_void,
        transa: i32, transb: i32,
        m: i32, n: i32, k: i32,
        alpha: *const u16,
        a: *const u16, lda: i32,
        b: *const u16, ldb: i32,
        beta: *const u16,
        c: *mut u16, ldc: i32,
    ) -> i32
    fn cublasGemmEx(
        handle: *mut std::ffi::c_void,
        transa: i32, transb: i32,
        m: i32, n: i32, k: i32,
        alpha: *const std::ffi::c_void,
        a: *const std::ffi::c_void, aType: i32, lda: i32,
        b: *const std::ffi::c_void, bType: i32, ldb: i32,
        beta: *const std::ffi::c_void,
        c: *mut std::ffi::c_void, cType: i32, ldc: i32,
        computeType: i32,
        algo: i32,
    ) -> i32
}

const CUBLAS_OP_N: i32 = 0
const CUBLAS_OP_T: i32 = 1

// ============================================================================
// CUDA Backend Implementation
// ============================================================================

/// CUDA compute backend
pub struct CudaBackend {
    device_id: i32,
    stream: *mut std::ffi::c_void,
    cublas: *mut std::ffi::c_void,
    initialized: bool,
}

unsafe impl Send for CudaBackend {}
unsafe impl Sync for CudaBackend {}

impl CudaBackend {
    pub fn new(device_id: i32) -> Self {
        Self {
            device_id,
            stream: std::ptr::null_mut(),
            cublas: std::ptr::null_mut(),
            initialized: false,
        }
    }

    /// Get device count
    pub fn device_count() -> Result<i32!> {
        let mut count = 0i32
        unsafe {
            CudaError::check(cudaGetDeviceCount(&mut count))?
        }
        Ok(count)
    }

    /// Get device properties
    pub fn device_properties(device: i32) -> Result<CudaDeviceProperties!> {
        let mut props = std::mem::MaybeUninit::<CudaDeviceProperties>::uninit()
        unsafe {
            CudaError::check(cudaGetDeviceProperties(props.as_mut_ptr(), device))?
            Ok(props.assume_init())
        }
    }

    /// Get free and total memory
    pub fn memory_info(&self) -> Result<(u64, u64)!> {
        let mut free = 0usize
        let mut total = 0usize
        unsafe {
            CudaError::check(cudaMemGetInfo(&mut free, &mut total))?
        }
        Ok((free as u64, total as u64))
    }

    /// Allocate device memory
    pub fn malloc(&self, size: u64) -> Result<*mut std::ffi::c_void!> {
        let mut ptr = std::ptr::null_mut()
        unsafe {
            CudaError::check(cudaMalloc(&mut ptr, size as usize))?
        }
        Ok(ptr)
    }

    /// Free device memory
    pub fn free_ptr(&self, ptr: *mut std::ffi::c_void) -> Result<()!> {
        unsafe {
            CudaError::check(cudaFree(ptr))
        }
    }

    /// Copy host to device
    pub fn memcpy_h2d(&self, dst: *mut std::ffi::c_void, src: *const std::ffi::c_void, size: u64) -> Result<()!> {
        unsafe {
            CudaError::check(cudaMemcpy(dst, src, size as usize, CUDA_MEMCPY_HOST_TO_DEVICE))
        }
    }

    /// Copy device to host
    pub fn memcpy_d2h(&self, dst: *mut std::ffi::c_void, src: *const std::ffi::c_void, size: u64) -> Result<()!> {
        unsafe {
            CudaError::check(cudaMemcpy(dst, src, size as usize, CUDA_MEMCPY_DEVICE_TO_HOST))
        }
    }

    /// Copy device to device
    pub fn memcpy_d2d(&self, dst: *mut std::ffi::c_void, src: *const std::ffi::c_void, size: u64) -> Result<()!> {
        unsafe {
            CudaError::check(cudaMemcpy(dst, src, size as usize, CUDA_MEMCPY_DEVICE_TO_DEVICE))
        }
    }

    /// Async copy host to device
    pub fn memcpy_h2d_async(&self, dst: *mut std::ffi::c_void, src: *const std::ffi::c_void, size: u64) -> Result<()!> {
        unsafe {
            CudaError::check(cudaMemcpyAsync(dst, src, size as usize, CUDA_MEMCPY_HOST_TO_DEVICE, self.stream))
        }
    }

    /// Set memory to value
    pub fn memset(&self, ptr: *mut std::ffi::c_void, value: i32, size: u64) -> Result<()!> {
        unsafe {
            CudaError::check(cudaMemset(ptr, value, size as usize))
        }
    }

    /// Synchronize stream
    pub fn stream_sync(&self) -> Result<()!> {
        unsafe {
            CudaError::check(cudaStreamSynchronize(self.stream))
        }
    }

    /// Get cuBLAS handle
    pub fn cublas_handle(&self) -> *mut std::ffi::c_void {
        self.cublas
    }

    /// Get CUDA stream
    pub fn cuda_stream(&self) -> *mut std::ffi::c_void {
        self.stream
    }

    /// SGEMM (single-precision matrix multiply)
    pub fn sgemm(
        &self,
        transa: bool,
        transb: bool,
        m: i32, n: i32, k: i32,
        alpha: f32,
        a: *const f32, lda: i32,
        b: *const f32, ldb: i32,
        beta: f32,
        c: *mut f32, ldc: i32,
    ) -> Result<()!> {
        let op_a = if transa { CUBLAS_OP_T } else { CUBLAS_OP_N }
        let op_b = if transb { CUBLAS_OP_T } else { CUBLAS_OP_N }

        unsafe {
            CudaError::check(cublasSgemm_v2(
                self.cublas,
                op_a, op_b,
                m, n, k,
                &alpha,
                a, lda,
                b, ldb,
                &beta,
                c, ldc,
            ))
        }
    }
}

impl NativeBackend for CudaBackend {
    fn name(&self) -> &'static str {
        "CUDA"
    }

    fn initialize(&mut self) -> Result<()!> {
        if self.initialized {
            return Ok(())
        }

        unsafe {
            // Set device
            CudaError::check(cudaSetDevice(self.device_id))?

            // Create stream
            CudaError::check(cudaStreamCreate(&mut self.stream))?

            // Create cuBLAS handle
            CudaError::check(cublasCreate_v2(&mut self.cublas))?
            CudaError::check(cublasSetStream_v2(self.cublas, self.stream))?
        }

        self.initialized = true
        Ok(())
    }

    fn shutdown(&mut self) -> Result<()!> {
        if !self.initialized {
            return Ok(())
        }

        unsafe {
            if !self.cublas.is_null() {
                cublasDestroy_v2(self.cublas)
                self.cublas = std::ptr::null_mut()
            }

            if !self.stream.is_null() {
                cudaStreamDestroy(self.stream)
                self.stream = std::ptr::null_mut()
            }
        }

        self.initialized = false
        Ok(())
    }

    fn allocate(&self, size_bytes: u64, device: i32) -> Result<NativeTensorHandle!> {
        let ptr! = self.malloc(size_bytes)?
        Ok(NativeTensorHandle {
            ptr,
            size_bytes,
            device_id: device,
        })
    }

    fn free(&self, handle: NativeTensorHandle) -> Result<()!> {
        if handle.ptr.is_null() {
            return Ok(())
        }
        self.free_ptr(handle.ptr)
    }

    fn copy_to_device(&self, host: *const u8, device: &NativeTensorHandle, size: u64) -> Result<()!> {
        self.memcpy_h2d(device.ptr, host as *const std::ffi::c_void, size)
    }

    fn copy_to_host(&self, device: &NativeTensorHandle, host: *mut u8, size: u64) -> Result<()!> {
        self.memcpy_d2h(host as *mut std::ffi::c_void, device.ptr, size)
    }

    fn synchronize(&self, _device: i32) -> Result<()!> {
        unsafe {
            CudaError::check(cudaDeviceSynchronize())
        }
    }
}

impl Drop for CudaBackend {
    fn drop(&mut self) {
        let _ = self.shutdown()
    }
}

// ============================================================================
// CUDA Event Timer
// ============================================================================

/// High-precision GPU timer using CUDA events
pub struct CudaTimer {
    start: *mut std::ffi::c_void,
    stop: *mut std::ffi::c_void,
}

impl CudaTimer {
    pub fn new() -> Result<Self!> {
        let mut start = std::ptr::null_mut()
        let mut stop = std::ptr::null_mut()

        unsafe {
            CudaError::check(cudaEventCreate(&mut start))?
            CudaError::check(cudaEventCreate(&mut stop))?
        }

        Ok(Self { start, stop })
    }

    pub fn start(&self, stream: *mut std::ffi::c_void) -> Result<()!> {
        unsafe {
            CudaError::check(cudaEventRecord(self.start, stream))
        }
    }

    pub fn stop(&self, stream: *mut std::ffi::c_void) -> Result<()!> {
        unsafe {
            CudaError::check(cudaEventRecord(self.stop, stream))
        }
    }

    pub fn elapsed_ms(&self) -> Result<f32!> {
        let mut ms = 0.0f32
        unsafe {
            CudaError::check(cudaEventSynchronize(self.stop))?
            CudaError::check(cudaEventElapsedTime(&mut ms, self.start, self.stop))?
        }
        Ok(ms)
    }
}

impl Drop for CudaTimer {
    fn drop(&mut self) {
        unsafe {
            if !self.start.is_null() {
                cudaEventDestroy(self.start)
            }
            if !self.stop.is_null() {
                cudaEventDestroy(self.stop)
            }
        }
    }
}

// ============================================================================
// Device Query
// ============================================================================

/// Query CUDA devices
pub fn query_cuda_devices() -> Result<Vec<DeviceInfo>!> {
    let count! = CudaBackend::device_count()?
    let mut devices = Vec::with_capacity(count as usize)

    for i in 0..count {
        let props! = CudaBackend::device_properties(i)?
        let name = unsafe {
            std::ffi::CStr::from_ptr(props.name.as_ptr())
                .to_string_lossy()
                .to_string()
        }

        devices.push(DeviceInfo {
            id: i,
            name,
            compute_capability: (props.major, props.minor),
            total_memory: props.total_global_mem as u64,
            multiprocessors: props.multi_processor_count,
            max_threads_per_block: props.max_threads_per_block,
            warp_size: props.warp_size,
        })
    }

    Ok(devices)
}

pub struct DeviceInfo {
    pub id: i32,
    pub name: String,
    pub compute_capability: (i32, i32),
    pub total_memory: u64,
    pub multiprocessors: i32,
    pub max_threads_per_block: i32,
    pub warp_size: i32,
}

impl DeviceInfo {
    pub fn supports_fp16(&self) -> bool {
        self.compute_capability.0 >= 6  // Pascal+
    }

    pub fn supports_bf16(&self) -> bool {
        self.compute_capability.0 >= 8  // Ampere+
    }

    pub fn supports_fp8(&self) -> bool {
        self.compute_capability.0 >= 9  // Hopper+
    }

    pub fn supports_tensor_cores(&self) -> bool {
        self.compute_capability.0 >= 7  // Volta+
    }
}
