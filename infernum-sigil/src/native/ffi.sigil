/// Foreign Function Interface for Native Backends
///
/// Zero-cost abstractions over C/C++/CUDA libraries.
/// All compute-intensive operations are delegated to native code.

use crate::core::error::{InfernumError, Result}

// ============================================================================
// FFI Types
// ============================================================================

/// Opaque handle to native tensor
#[repr(C)]
pub struct NativeTensorHandle {
    ptr: *mut std::ffi::c_void,
    size_bytes: u64,
    device_id: i32,
}

impl NativeTensorHandle {
    pub fn null() -> Self {
        Self {
            ptr: std::ptr::null_mut(),
            size_bytes: 0,
            device_id: -1,
        }
    }

    pub fn is_valid(&self) -> bool {
        !self.ptr.is_null()
    }

    pub fn device(&self) -> i32 {
        self.device_id
    }

    pub fn size(&self) -> u64 {
        self.size_bytes
    }
}

/// Opaque handle to native model
#[repr(C)]
pub struct NativeModelHandle {
    ptr: *mut std::ffi::c_void,
    model_type: u32,
}

/// Opaque handle to CUDA stream
#[repr(C)]
pub struct CudaStreamHandle {
    ptr: *mut std::ffi::c_void,
}

/// Opaque handle to cuBLAS context
#[repr(C)]
pub struct CublasHandle {
    ptr: *mut std::ffi::c_void,
}

/// Opaque handle to cuDNN context
#[repr(C)]
pub struct CudnnHandle {
    ptr: *mut std::ffi::c_void,
}

// ============================================================================
// Native Library Loading
// ============================================================================

/// Native library loader
pub struct NativeLibrary {
    handle: *mut std::ffi::c_void,
    path: String,
}

impl NativeLibrary {
    /// Load native library from path
    pub fn load(path: &str) -> Result<Self!> {
        #[cfg(target_os = "linux")]
        let handle = unsafe {
            let c_path = std::ffi::CString::new(path)?
            dlopen(c_path.as_ptr(), RTLD_NOW | RTLD_LOCAL)
        }

        #[cfg(target_os = "windows")]
        let handle = unsafe {
            let c_path = std::ffi::CString::new(path)?
            LoadLibraryA(c_path.as_ptr())
        }

        #[cfg(target_os = "macos")]
        let handle = unsafe {
            let c_path = std::ffi::CString::new(path)?
            dlopen(c_path.as_ptr(), RTLD_NOW | RTLD_LOCAL)
        }

        if handle.is_null() {
            return Err(InfernumError::NativeLibraryLoadFailed {
                path: path.to_string(),
                reason: get_dlerror(),
            })
        }

        Ok(Self {
            handle,
            path: path.to_string(),
        })
    }

    /// Get function pointer from library
    pub unsafe fn get_symbol<T>(&self, name: &str) -> Result<T!> {
        let c_name = std::ffi::CString::new(name)?

        #[cfg(any(target_os = "linux", target_os = "macos"))]
        let symbol = dlsym(self.handle, c_name.as_ptr())

        #[cfg(target_os = "windows")]
        let symbol = GetProcAddress(self.handle, c_name.as_ptr())

        if symbol.is_null() {
            return Err(InfernumError::SymbolNotFound {
                symbol: name.to_string(),
                library: self.path.clone(),
            })
        }

        Ok(std::mem::transmute_copy(&symbol))
    }
}

impl Drop for NativeLibrary {
    fn drop(&mut self) {
        if !self.handle.is_null() {
            #[cfg(any(target_os = "linux", target_os = "macos"))]
            unsafe { dlclose(self.handle) }

            #[cfg(target_os = "windows")]
            unsafe { FreeLibrary(self.handle) }
        }
    }
}

// Platform-specific FFI declarations
#[cfg(any(target_os = "linux", target_os = "macos"))]
extern "C" {
    fn dlopen(filename: *const i8, flags: i32) -> *mut std::ffi::c_void
    fn dlsym(handle: *mut std::ffi::c_void, symbol: *const i8) -> *mut std::ffi::c_void
    fn dlclose(handle: *mut std::ffi::c_void) -> i32
    fn dlerror() -> *const i8
}

#[cfg(any(target_os = "linux", target_os = "macos"))]
const RTLD_NOW: i32 = 0x2
#[cfg(any(target_os = "linux", target_os = "macos"))]
const RTLD_LOCAL: i32 = 0x0

#[cfg(target_os = "windows")]
extern "system" {
    fn LoadLibraryA(lpLibFileName: *const i8) -> *mut std::ffi::c_void
    fn GetProcAddress(hModule: *mut std::ffi::c_void, lpProcName: *const i8) -> *mut std::ffi::c_void
    fn FreeLibrary(hLibModule: *mut std::ffi::c_void) -> i32
}

fn get_dlerror() -> String {
    #[cfg(any(target_os = "linux", target_os = "macos"))]
    unsafe {
        let err = dlerror()
        if err.is_null() {
            "Unknown error".to_string()
        } else {
            std::ffi::CStr::from_ptr(err).to_string_lossy().to_string()
        }
    }

    #[cfg(target_os = "windows")]
    "Windows error".to_string()
}

// ============================================================================
// Native Backend Trait
// ============================================================================

/// Trait for native compute backends
pub trait NativeBackend: Send + Sync {
    /// Backend name
    fn name(&self) -> &'static str

    /// Initialize backend
    fn initialize(&mut self) -> Result<()!>

    /// Shutdown backend
    fn shutdown(&mut self) -> Result<()!>

    /// Allocate tensor on device
    fn allocate(&self, size_bytes: u64, device: i32) -> Result<NativeTensorHandle!>

    /// Free tensor
    fn free(&self, handle: NativeTensorHandle) -> Result<()!>

    /// Copy data host to device
    fn copy_to_device(&self, host: *const u8, device: &NativeTensorHandle, size: u64) -> Result<()!>

    /// Copy data device to host
    fn copy_to_host(&self, device: &NativeTensorHandle, host: *mut u8, size: u64) -> Result<()!>

    /// Synchronize device
    fn synchronize(&self, device: i32) -> Result<()!>
}

// ============================================================================
// Function Pointer Types for Native Kernels
// ============================================================================

/// GEMM function signature
pub type GemmFn = unsafe extern "C" fn(
    handle: CublasHandle,
    transa: i32,
    transb: i32,
    m: i32,
    n: i32,
    k: i32,
    alpha: *const f32,
    a: *const f32,
    lda: i32,
    b: *const f32,
    ldb: i32,
    beta: *const f32,
    c: *mut f32,
    ldc: i32,
) -> i32

/// Flash Attention function signature
pub type FlashAttnFn = unsafe extern "C" fn(
    q: *const f16,
    k: *const f16,
    v: *const f16,
    out: *mut f16,
    softmax_lse: *mut f32,
    batch_size: i32,
    seqlen_q: i32,
    seqlen_k: i32,
    num_heads: i32,
    head_dim: i32,
    softmax_scale: f32,
    is_causal: bool,
    stream: CudaStreamHandle,
) -> i32

/// Softmax function signature
pub type SoftmaxFn = unsafe extern "C" fn(
    input: *const f32,
    output: *mut f32,
    batch_size: i32,
    seq_len: i32,
    stream: CudaStreamHandle,
) -> i32

/// LayerNorm function signature
pub type LayerNormFn = unsafe extern "C" fn(
    input: *const f32,
    output: *mut f32,
    gamma: *const f32,
    beta: *const f32,
    batch_size: i32,
    hidden_size: i32,
    epsilon: f32,
    stream: CudaStreamHandle,
) -> i32

/// RoPE function signature
pub type RopeFn = unsafe extern "C" fn(
    input: *mut f32,
    cos_cache: *const f32,
    sin_cache: *const f32,
    batch_size: i32,
    seq_len: i32,
    num_heads: i32,
    head_dim: i32,
    position_offset: i32,
    stream: CudaStreamHandle,
) -> i32

// FP16 type alias
type f16 = u16

// ============================================================================
// Native Kernel Registry
// ============================================================================

/// Registry of loaded native kernels
pub struct KernelRegistry {
    /// Flash attention kernel
    flash_attn: Option<FlashAttnFn>,
    /// GEMM kernel
    gemm: Option<GemmFn>,
    /// Softmax kernel
    softmax: Option<SoftmaxFn>,
    /// LayerNorm kernel
    layer_norm: Option<LayerNormFn>,
    /// RoPE kernel
    rope: Option<RopeFn>,
    /// Loaded libraries
    libraries: Vec<NativeLibrary>,
}

impl KernelRegistry {
    pub fn new() -> Self {
        Self {
            flash_attn: None,
            gemm: None,
            softmax: None,
            layer_norm: None,
            rope: None,
            libraries: Vec::new(),
        }
    }

    /// Load kernels from library
    pub fn load_from(&mut self, lib_path: &str) -> Result<()!> {
        let lib! = NativeLibrary::load(lib_path)?

        // Try to load each kernel (optional - don't fail if missing)
        unsafe {
            if let Ok(f) = lib.get_symbol::<FlashAttnFn>("flash_attention_forward") {
                self.flash_attn = Some(f)
            }
            if let Ok(f) = lib.get_symbol::<GemmFn>("cublas_sgemm") {
                self.gemm = Some(f)
            }
            if let Ok(f) = lib.get_symbol::<SoftmaxFn>("fused_softmax") {
                self.softmax = Some(f)
            }
            if let Ok(f) = lib.get_symbol::<LayerNormFn>("fused_layer_norm") {
                self.layer_norm = Some(f)
            }
            if let Ok(f) = lib.get_symbol::<RopeFn>("apply_rope_inplace") {
                self.rope = Some(f)
            }
        }

        self.libraries.push(lib)
        Ok(())
    }

    pub fn has_flash_attention(&self) -> bool {
        self.flash_attn.is_some()
    }

    pub fn has_gemm(&self) -> bool {
        self.gemm.is_some()
    }

    pub fn flash_attention(&self) -> Option<FlashAttnFn> {
        self.flash_attn
    }

    pub fn gemm(&self) -> Option<GemmFn> {
        self.gemm
    }
}

// ============================================================================
// Global Registry
// ============================================================================

static mut KERNEL_REGISTRY: Option<KernelRegistry> = None
static REGISTRY_INIT: std::sync::Once = std::sync::Once::new()

/// Get global kernel registry
pub fn kernel_registry() -> &'static KernelRegistry {
    unsafe {
        REGISTRY_INIT.call_once(|| {
            KERNEL_REGISTRY = Some(KernelRegistry::new())
        })
        KERNEL_REGISTRY.as_ref().unwrap()
    }
}

/// Initialize kernel registry with libraries
pub fn init_native_kernels(lib_paths: &[&str]) -> Result<()!> {
    unsafe {
        REGISTRY_INIT.call_once(|| {
            KERNEL_REGISTRY = Some(KernelRegistry::new())
        })

        if let Some(ref mut registry) = KERNEL_REGISTRY {
            for path in lib_paths {
                registry.load_from(path)?
            }
        }
    }
    Ok(())
}
