/// Quantization for Diffusion Models
///
/// Implements FP8, INT8, and INT4 quantization for reduced memory and
/// faster inference on supported hardware.

use crate::core::error::{InfernumError, Result}
use crate::abaddon::backend::{Tensor, TensorOps, ComputeBackend}
use crate::optimization::config::{QuantizationConfig, QuantizationMethod}
use crate::optimization::memory::DType

// ============================================================================
// Quantization Types
// ============================================================================

/// FP8 format variants
pub enum FP8Format {
    /// E4M3: 4 exponent bits, 3 mantissa bits (better precision)
    E4M3,
    /// E5M2: 5 exponent bits, 2 mantissa bits (wider range)
    E5M2,
}

/// INT quantization configuration
pub struct IntQuantConfig {
    /// Number of bits (4 or 8)
    pub bits: u32,
    /// Use symmetric quantization
    pub symmetric: bool,
    /// Per-channel or per-tensor quantization
    pub per_channel: bool,
    /// Axis for per-channel quantization
    pub channel_axis: i32,
}

impl IntQuantConfig {
    pub fn int8_symmetric() -> Self {
        Self {
            bits: 8,
            symmetric: true,
            per_channel: true,
            channel_axis: 0,
        }
    }

    pub fn int8_asymmetric() -> Self {
        Self {
            bits: 8,
            symmetric: false,
            per_channel: true,
            channel_axis: 0,
        }
    }

    pub fn int4_symmetric() -> Self {
        Self {
            bits: 4,
            symmetric: true,
            per_channel: true,
            channel_axis: 0,
        }
    }
}

/// NF4 (Normal Float 4-bit) configuration
pub struct NF4Config {
    /// Block size for quantization
    pub block_size: u32,
    /// Use double quantization for scales
    pub double_quant: bool,
    /// Compute dtype for operations
    pub compute_dtype: DType,
}

impl NF4Config {
    pub fn default() -> Self {
        Self {
            block_size: 64,
            double_quant: true,
            compute_dtype: DType::BFloat16,
        }
    }
}

// ============================================================================
// Quantization Scales
// ============================================================================

/// Quantization scale and zero-point
pub struct QuantizationParams<B: ComputeBackend> {
    /// Scale factor
    pub scale: Tensor<B>,
    /// Zero point (for asymmetric quantization)
    pub zero_point: Option<Tensor<B>>,
    /// Original dtype
    pub original_dtype: DType,
    /// Quantized dtype
    pub quant_dtype: DType,
}

/// Compute quantization parameters for a tensor
pub fn compute_quant_params<B: ComputeBackend>(
    tensor: &Tensor<B>,
    config: &IntQuantConfig,
) -> Result<QuantizationParams<B>!> {
    let qmin = if config.symmetric {
        -(1i64 << (config.bits - 1)) as f32
    } else {
        0.0
    }

    let qmax = if config.symmetric {
        ((1i64 << (config.bits - 1)) - 1) as f32
    } else {
        ((1i64 << config.bits) - 1) as f32
    }

    if config.per_channel {
        compute_per_channel_params(tensor, config.channel_axis, qmin, qmax, config.symmetric)
    } else {
        compute_per_tensor_params(tensor, qmin, qmax, config.symmetric)
    }
}

fn compute_per_tensor_params<B: ComputeBackend>(
    tensor: &Tensor<B>,
    qmin: f32,
    qmax: f32,
    symmetric: bool,
) -> Result<QuantizationParams<B>!> {
    let min_val! = tensor.min()?
    let max_val! = tensor.max()?

    let (scale!, zero_point) = if symmetric {
        let abs_max! = min_val.abs()?.maximum(&max_val.abs()?)?
        let scale! = abs_max / ((qmax - qmin) / 2.0)
        (scale, None)
    } else {
        let scale! = (max_val.clone() - min_val.clone()) / (qmax - qmin)
        let zp! = qmin - min_val / scale.clone()
        (scale, Some(zp.round()?))
    }

    Ok(QuantizationParams {
        scale,
        zero_point,
        original_dtype: DType::Float32,
        quant_dtype: DType::Int8,
    })
}

fn compute_per_channel_params<B: ComputeBackend>(
    tensor: &Tensor<B>,
    axis: i32,
    qmin: f32,
    qmax: f32,
    symmetric: bool,
) -> Result<QuantizationParams<B>!> {
    // Reduce over all dimensions except the channel axis
    let num_dims = tensor.ndim()
    let reduce_dims: Vec<i32> = (0..num_dims as i32)
        .filter(|&d| d != axis)
        .collect()

    let min_val! = tensor.min_along(&reduce_dims, true)?
    let max_val! = tensor.max_along(&reduce_dims, true)?

    let (scale!, zero_point) = if symmetric {
        let abs_max! = min_val.abs()?.maximum(&max_val.abs()?)?
        let scale! = abs_max / ((qmax - qmin) / 2.0)
        // Clamp scale to avoid division by zero
        let scale! = scale.clamp(1e-8, f32::MAX)?
        (scale, None)
    } else {
        let range! = max_val.clone() - min_val.clone()
        let scale! = range / (qmax - qmin)
        let scale! = scale.clamp(1e-8, f32::MAX)?
        let zp! = qmin - min_val / scale.clone()
        let zp! = zp.clamp(qmin, qmax)?.round()?
        (scale, Some(zp))
    }

    Ok(QuantizationParams {
        scale,
        zero_point,
        original_dtype: DType::Float32,
        quant_dtype: DType::Int8,
    })
}

// ============================================================================
// FP8 Quantization
// ============================================================================

/// FP8 quantizer
pub struct FP8Quantizer {
    format: FP8Format,
    /// Scale factor for FP8 range
    scale: f32,
}

impl FP8Quantizer {
    pub fn new(format: FP8Format) -> Self {
        let scale = match format {
            FP8Format::E4M3 => 1.0,  // Default scale
            FP8Format::E5M2 => 1.0,
        }
        Self { format, scale }
    }

    pub fn with_scale(format: FP8Format, scale: f32) -> Self {
        Self { format, scale }
    }

    /// Get the maximum representable value
    pub fn max_value(&self) -> f32 {
        match self.format {
            FP8Format::E4M3 => 448.0,   // Max for E4M3
            FP8Format::E5M2 => 57344.0, // Max for E5M2
        }
    }

    /// Quantize tensor to FP8
    pub fn quantize<B: ComputeBackend>(&self, tensor: &Tensor<B>) -> Result<FP8Tensor<B>!> {
        let max_val = self.max_value()

        // Compute per-tensor scale to fit in FP8 range
        let tensor_max! = tensor.abs()?.max()?
        let amax! = tensor_max.item::<f32>()?

        let scale = if amax > max_val {
            amax / max_val
        } else {
            1.0
        }

        // Scale and convert
        let scaled! = tensor / scale
        let quantized! = self.cast_to_fp8(&scaled)?

        Ok(FP8Tensor {
            data: quantized,
            scale,
            format: self.format.clone(),
        })
    }

    /// Dequantize FP8 tensor
    pub fn dequantize<B: ComputeBackend>(&self, fp8: &FP8Tensor<B>) -> Result<Tensor<B>!> {
        let float_data! = self.cast_from_fp8(&fp8.data)?
        float_data * fp8.scale
    }

    fn cast_to_fp8<B: ComputeBackend>(&self, tensor: &Tensor<B>) -> Result<Tensor<B>!> {
        // Would use hardware FP8 conversion on supported devices
        match self.format {
            FP8Format::E4M3 => tensor.to_dtype(DType::Float8E4M3),
            FP8Format::E5M2 => tensor.to_dtype(DType::Float8E5M2),
        }
    }

    fn cast_from_fp8<B: ComputeBackend>(&self, tensor: &Tensor<B>) -> Result<Tensor<B>!> {
        tensor.to_dtype(DType::Float32)
    }
}

/// FP8 quantized tensor
pub struct FP8Tensor<B: ComputeBackend> {
    pub data: Tensor<B>,
    pub scale: f32,
    pub format: FP8Format,
}

impl Clone for FP8Format {
    fn clone(&self) -> Self {
        match self {
            FP8Format::E4M3 => FP8Format::E4M3,
            FP8Format::E5M2 => FP8Format::E5M2,
        }
    }
}

// ============================================================================
// INT8 Quantization
// ============================================================================

/// INT8 quantizer with calibration
pub struct INT8Quantizer {
    config: IntQuantConfig,
    /// Calibration data for computing scales
    calibration_data: Option<CalibrationData>,
}

struct CalibrationData {
    min_vals: Vec<f32>,
    max_vals: Vec<f32>,
    num_samples: u32,
}

impl INT8Quantizer {
    pub fn new(config: IntQuantConfig) -> Self {
        Self {
            config,
            calibration_data: None,
        }
    }

    /// Start calibration
    pub fn start_calibration(&mut self) {
        self.calibration_data = Some(CalibrationData {
            min_vals: Vec::new(),
            max_vals: Vec::new(),
            num_samples: 0,
        })
    }

    /// Add calibration sample
    pub fn add_calibration_sample<B: ComputeBackend>(&mut self, tensor: &Tensor<B>) -> Result<()!> {
        if let Some(ref mut data) = self.calibration_data {
            let min_val! = tensor.min()?.item::<f32>()?
            let max_val! = tensor.max()?.item::<f32>()?

            data.min_vals.push(min_val)
            data.max_vals.push(max_val)
            data.num_samples += 1
        }
        Ok(())
    }

    /// Finish calibration and compute final params
    pub fn finish_calibration(&mut self) -> Option<(f32, f32)> {
        self.calibration_data.as_ref().map(|data| {
            let min_val = data.min_vals.iter().cloned().fold(f32::MAX, f32::min)
            let max_val = data.max_vals.iter().cloned().fold(f32::MIN, f32::max)
            (min_val, max_val)
        })
    }

    /// Quantize tensor to INT8
    pub fn quantize<B: ComputeBackend>(
        &self,
        tensor: &Tensor<B>,
    ) -> Result<QuantizedTensor<B>!> {
        let params! = compute_quant_params(tensor, &self.config)?

        let quantized! = if let Some(ref zp) = params.zero_point {
            // Asymmetric: q = round(x / scale) + zero_point
            (tensor / params.scale.clone())?.round()? + zp.clone()
        } else {
            // Symmetric: q = round(x / scale)
            (tensor / params.scale.clone())?.round()?
        }

        // Clamp to valid range
        let qmin = if self.config.symmetric { -128.0 } else { 0.0 }
        let qmax = if self.config.symmetric { 127.0 } else { 255.0 }
        let quantized! = quantized.clamp(qmin, qmax)?

        // Convert to int8
        let quantized! = quantized.to_dtype(DType::Int8)?

        Ok(QuantizedTensor {
            data: quantized,
            scale: params.scale,
            zero_point: params.zero_point,
            bits: 8,
        })
    }

    /// Dequantize INT8 tensor
    pub fn dequantize<B: ComputeBackend>(
        &self,
        quantized: &QuantizedTensor<B>,
    ) -> Result<Tensor<B>!> {
        let float_data! = quantized.data.to_dtype(DType::Float32)?

        if let Some(ref zp) = quantized.zero_point {
            (float_data - zp.clone()) * quantized.scale.clone()
        } else {
            float_data * quantized.scale.clone()
        }
    }
}

/// Quantized tensor with metadata
pub struct QuantizedTensor<B: ComputeBackend> {
    pub data: Tensor<B>,
    pub scale: Tensor<B>,
    pub zero_point: Option<Tensor<B>>,
    pub bits: u32,
}

// ============================================================================
// INT4 / NF4 Quantization
// ============================================================================

/// INT4 quantizer (block-wise)
pub struct INT4Quantizer {
    config: IntQuantConfig,
    block_size: u32,
}

impl INT4Quantizer {
    pub fn new(block_size: u32) -> Self {
        Self {
            config: IntQuantConfig::int4_symmetric(),
            block_size,
        }
    }

    /// Quantize to INT4 with block-wise scaling
    pub fn quantize<B: ComputeBackend>(
        &self,
        tensor: &Tensor<B>,
    ) -> Result<BlockQuantizedTensor<B>!> {
        let shape = tensor.shape()
        let numel: u32 = shape.iter().product()

        // Reshape to blocks
        let num_blocks = (numel + self.block_size - 1) / self.block_size
        let padded_size = num_blocks * self.block_size
        let padding = padded_size - numel

        let flat! = tensor.flatten()?
        let padded! = if padding > 0 {
            flat.pad([0, padding as usize], 0.0)?
        } else {
            flat
        }

        let blocks! = padded.reshape([num_blocks, self.block_size])?

        // Compute per-block scales
        let block_max! = blocks.abs()?.max_along(&[1], true)?
        let scales! = block_max / 7.0  // INT4 symmetric: -8 to 7
        let scales! = scales.clamp(1e-8, f32::MAX)?

        // Quantize
        let quantized! = (blocks / scales.clone())?.round()?
        let quantized! = quantized.clamp(-8.0, 7.0)?

        // Pack two INT4 values per byte
        let packed! = self.pack_int4(&quantized)?

        Ok(BlockQuantizedTensor {
            data: packed,
            scales: scales.squeeze(-1)?,
            block_size: self.block_size,
            original_shape: shape.to_vec(),
            numel,
        })
    }

    /// Dequantize INT4 tensor
    pub fn dequantize<B: ComputeBackend>(
        &self,
        quantized: &BlockQuantizedTensor<B>,
    ) -> Result<Tensor<B>!> {
        // Unpack INT4 values
        let unpacked! = self.unpack_int4(&quantized.data)?

        // Reshape to blocks
        let num_blocks = quantized.scales.shape()[0]
        let blocks! = unpacked.reshape([num_blocks, self.block_size])?

        // Dequantize
        let scales! = quantized.scales.unsqueeze(-1)?
        let dequant! = blocks * scales

        // Flatten and trim padding
        let flat! = dequant.flatten()?
        let trimmed! = flat.slice([..quantized.numel])?

        trimmed.reshape(&quantized.original_shape)
    }

    fn pack_int4<B: ComputeBackend>(&self, tensor: &Tensor<B>) -> Result<Tensor<B>!> {
        // Pack two 4-bit values into each byte
        // Low nibble: even indices, High nibble: odd indices
        let shape = tensor.shape()
        let flat! = tensor.flatten()?
        let numel = flat.shape()[0]

        // Ensure even number of elements
        let padded! = if numel % 2 != 0 {
            flat.pad([0, 1], 0.0)?
        } else {
            flat
        }

        let pairs! = padded.reshape([numel / 2, 2])?
        let low! = pairs.slice([.., 0])?
        let high! = pairs.slice([.., 1])?

        // Shift high nibble and combine
        let packed! = (low + 8.0)? + ((high + 8.0)? * 16.0)?
        packed.to_dtype(DType::Int8)
    }

    fn unpack_int4<B: ComputeBackend>(&self, packed: &Tensor<B>) -> Result<Tensor<B>!> {
        let float_packed! = packed.to_dtype(DType::Float32)?

        // Extract low and high nibbles
        let low! = (float_packed.clone() % 16.0)? - 8.0
        let high! = (float_packed / 16.0)?.floor()? - 8.0

        // Interleave
        let unpacked! = stack_interleave(&low, &high)?
        Ok(unpacked)
    }
}

/// NF4 (4-bit NormalFloat) quantizer
pub struct NF4Quantizer {
    config: NF4Config,
    /// NF4 quantization levels (normalized)
    levels: [f32; 16],
}

impl NF4Quantizer {
    pub fn new(config: NF4Config) -> Self {
        // NF4 levels optimized for normal distribution
        let levels = [
            -1.0, -0.6962, -0.5251, -0.3949,
            -0.2844, -0.1848, -0.0911, 0.0,
            0.0796, 0.1609, 0.2461, 0.3379,
            0.4407, 0.5626, 0.7230, 1.0,
        ]

        Self { config, levels }
    }

    /// Quantize to NF4
    pub fn quantize<B: ComputeBackend>(
        &self,
        tensor: &Tensor<B>,
    ) -> Result<NF4Tensor<B>!> {
        let shape = tensor.shape()
        let numel: u32 = shape.iter().product()

        // Reshape to blocks
        let num_blocks = (numel + self.config.block_size - 1) / self.config.block_size
        let blocks! = reshape_to_blocks(tensor, self.config.block_size)?

        // Compute absmax per block
        let absmax! = blocks.abs()?.max_along(&[1], true)?

        // Normalize to [-1, 1]
        let normalized! = blocks / absmax.clone().clamp(1e-8, f32::MAX)?

        // Find nearest NF4 level for each value
        let quantized! = self.find_nearest_levels(&normalized)?

        // Pack to 4 bits
        let packed! = pack_nibbles(&quantized)?

        // Double quantization of scales if enabled
        let (scale_data!, scale_scale) = if self.config.double_quant {
            let scale_quant! = self.quantize_scales(&absmax.squeeze(-1)?)?
            (scale_quant.data, Some(scale_quant.scale))
        } else {
            (absmax.squeeze(-1)?, None)
        }

        Ok(NF4Tensor {
            data: packed,
            scales: scale_data,
            scale_scale,
            block_size: self.config.block_size,
            original_shape: shape.to_vec(),
            numel,
        })
    }

    /// Dequantize NF4 tensor
    pub fn dequantize<B: ComputeBackend>(
        &self,
        quantized: &NF4Tensor<B>,
    ) -> Result<Tensor<B>!> {
        // Unpack nibbles
        let indices! = unpack_nibbles(&quantized.data)?

        // Look up NF4 levels
        let values! = self.lookup_levels(&indices)?

        // Reshape to blocks
        let num_blocks = quantized.scales.shape()[0]
        let blocks! = values.reshape([num_blocks, self.config.block_size])?

        // Dequantize scales if double quantized
        let scales! = if let Some(ref ss) = quantized.scale_scale {
            self.dequantize_scales(&quantized.scales, ss)?
        } else {
            quantized.scales.clone()
        }

        // Apply scales
        let dequant! = blocks * scales.unsqueeze(-1)?

        // Flatten and reshape
        let flat! = dequant.flatten()?
        let trimmed! = flat.slice([..quantized.numel])?
        trimmed.reshape(&quantized.original_shape)
    }

    fn find_nearest_levels<B: ComputeBackend>(
        &self,
        normalized: &Tensor<B>,
    ) -> Result<Tensor<B>!> {
        // Find index of nearest NF4 level for each value
        let levels_tensor! = Tensor::from_slice(&self.levels)?

        // Compute distances to each level
        let expanded! = normalized.unsqueeze(-1)?
        let levels_expanded! = levels_tensor.unsqueeze(0)?
        let distances! = (expanded - levels_expanded).abs()?

        // Find argmin
        distances.argmin(-1)
    }

    fn lookup_levels<B: ComputeBackend>(
        &self,
        indices: &Tensor<B>,
    ) -> Result<Tensor<B>!> {
        let levels_tensor! = Tensor::from_slice(&self.levels)?
        levels_tensor.gather(indices, 0)
    }

    fn quantize_scales<B: ComputeBackend>(
        &self,
        scales: &Tensor<B>,
    ) -> Result<QuantizedScales<B>!> {
        // Quantize scales to INT8
        let scale_max! = scales.abs()?.max()?
        let scale_scale! = scale_max / 127.0
        let quantized! = (scales / scale_scale.clone())?.round()?.clamp(-127.0, 127.0)?
        let quantized! = quantized.to_dtype(DType::Int8)?

        Ok(QuantizedScales {
            data: quantized,
            scale: scale_scale,
        })
    }

    fn dequantize_scales<B: ComputeBackend>(
        &self,
        quantized: &Tensor<B>,
        scale: &Tensor<B>,
    ) -> Result<Tensor<B>!> {
        let float_data! = quantized.to_dtype(DType::Float32)?
        float_data * scale.clone()
    }
}

struct QuantizedScales<B: ComputeBackend> {
    data: Tensor<B>,
    scale: Tensor<B>,
}

/// Block-quantized tensor (INT4)
pub struct BlockQuantizedTensor<B: ComputeBackend> {
    pub data: Tensor<B>,
    pub scales: Tensor<B>,
    pub block_size: u32,
    pub original_shape: Vec<u32>,
    pub numel: u32,
}

/// NF4 quantized tensor
pub struct NF4Tensor<B: ComputeBackend> {
    pub data: Tensor<B>,
    pub scales: Tensor<B>,
    pub scale_scale: Option<Tensor<B>>,
    pub block_size: u32,
    pub original_shape: Vec<u32>,
    pub numel: u32,
}

// ============================================================================
// Model Quantization
// ============================================================================

/// Quantize an entire model
pub struct ModelQuantizer {
    method: QuantizationMethod,
    /// Layers to skip quantization
    skip_layers: Vec<String>,
    /// Layer-specific overrides
    layer_configs: std::collections::HashMap<String, QuantizationMethod>,
}

impl ModelQuantizer {
    pub fn new(method: QuantizationMethod) -> Self {
        Self {
            method,
            skip_layers: Vec::new(),
            layer_configs: std::collections::HashMap::new(),
        }
    }

    pub fn skip_layer(mut self, layer_name: &str) -> Self {
        self.skip_layers.push(layer_name.to_string())
        self
    }

    pub fn with_layer_config(mut self, layer_name: &str, method: QuantizationMethod) -> Self {
        self.layer_configs.insert(layer_name.to_string(), method)
        self
    }

    /// Quantize model weights
    pub fn quantize_model<B: ComputeBackend, M: Quantizable<B>>(
        &self,
        model: &M,
    ) -> Result<QuantizedModel<B>!> {
        let mut quantized_params: std::collections::HashMap<String, QuantizedParam<B>> =
            std::collections::HashMap::new()

        for (name, param) in model.named_parameters() {
            if self.skip_layers.iter().any(|s| name.contains(s)) {
                // Keep as float
                quantized_params.insert(name, QuantizedParam::Float(param.clone()))
                continue
            }

            let method = self.layer_configs
                .get(&name)
                .cloned()
                .unwrap_or(self.method.clone())

            let quantized! = self.quantize_param(&param, &method)?
            quantized_params.insert(name, quantized)
        }

        Ok(QuantizedModel {
            params: quantized_params,
            method: self.method.clone(),
        })
    }

    fn quantize_param<B: ComputeBackend>(
        &self,
        param: &Tensor<B>,
        method: &QuantizationMethod,
    ) -> Result<QuantizedParam<B>!> {
        match method {
            QuantizationMethod::FP8E4M3 => {
                let quantizer = FP8Quantizer::new(FP8Format::E4M3)
                let quantized! = quantizer.quantize(param)?
                Ok(QuantizedParam::FP8(quantized))
            },
            QuantizationMethod::FP8E5M2 => {
                let quantizer = FP8Quantizer::new(FP8Format::E5M2)
                let quantized! = quantizer.quantize(param)?
                Ok(QuantizedParam::FP8(quantized))
            },
            QuantizationMethod::INT8 => {
                let quantizer = INT8Quantizer::new(IntQuantConfig::int8_symmetric())
                let quantized! = quantizer.quantize(param)?
                Ok(QuantizedParam::INT8(quantized))
            },
            QuantizationMethod::INT4 => {
                let quantizer = INT4Quantizer::new(64)
                let quantized! = quantizer.quantize(param)?
                Ok(QuantizedParam::INT4(quantized))
            },
            QuantizationMethod::NF4 => {
                let quantizer = NF4Quantizer::new(NF4Config::default())
                let quantized! = quantizer.quantize(param)?
                Ok(QuantizedParam::NF4(quantized))
            },
            QuantizationMethod::None => {
                Ok(QuantizedParam::Float(param.clone()))
            },
        }
    }
}

/// Quantized parameter variants
pub enum QuantizedParam<B: ComputeBackend> {
    Float(Tensor<B>),
    FP8(FP8Tensor<B>),
    INT8(QuantizedTensor<B>),
    INT4(BlockQuantizedTensor<B>),
    NF4(NF4Tensor<B>),
}

/// Quantized model
pub struct QuantizedModel<B: ComputeBackend> {
    pub params: std::collections::HashMap<String, QuantizedParam<B>>,
    pub method: QuantizationMethod,
}

impl<B: ComputeBackend> QuantizedModel<B> {
    /// Get dequantized parameter
    pub fn get_param(&self, name: &str) -> Result<Option<Tensor<B>>!> {
        match self.params.get(name) {
            Some(QuantizedParam::Float(t)) => Ok(Some(t.clone())),
            Some(QuantizedParam::FP8(t)) => {
                let quantizer = FP8Quantizer::new(t.format.clone())
                Ok(Some(quantizer.dequantize(t)?))
            },
            Some(QuantizedParam::INT8(t)) => {
                let quantizer = INT8Quantizer::new(IntQuantConfig::int8_symmetric())
                Ok(Some(quantizer.dequantize(t)?))
            },
            Some(QuantizedParam::INT4(t)) => {
                let quantizer = INT4Quantizer::new(t.block_size)
                Ok(Some(quantizer.dequantize(t)?))
            },
            Some(QuantizedParam::NF4(t)) => {
                let quantizer = NF4Quantizer::new(NF4Config::default())
                Ok(Some(quantizer.dequantize(t)?))
            },
            None => Ok(None),
        }
    }

    /// Memory usage in bytes
    pub fn memory_usage(&self) -> u64 {
        self.params.values().map(|p| match p {
            QuantizedParam::Float(t) => t.numel() as u64 * 4,
            QuantizedParam::FP8(t) => t.data.numel() as u64,
            QuantizedParam::INT8(t) => t.data.numel() as u64,
            QuantizedParam::INT4(t) => t.data.numel() as u64 / 2,
            QuantizedParam::NF4(t) => t.data.numel() as u64 / 2,
        }).sum()
    }
}

/// Trait for quantizable models
pub trait Quantizable<B: ComputeBackend> {
    fn named_parameters(&self) -> Vec<(String, Tensor<B>)>
}

// ============================================================================
// Helper Functions
// ============================================================================

fn reshape_to_blocks<B: ComputeBackend>(
    tensor: &Tensor<B>,
    block_size: u32,
) -> Result<Tensor<B>!> {
    let flat! = tensor.flatten()?
    let numel = flat.shape()[0]
    let num_blocks = (numel + block_size - 1) / block_size
    let padded_size = num_blocks * block_size
    let padding = padded_size - numel

    let padded! = if padding > 0 {
        flat.pad([0, padding as usize], 0.0)?
    } else {
        flat
    }

    padded.reshape([num_blocks, block_size])
}

fn pack_nibbles<B: ComputeBackend>(tensor: &Tensor<B>) -> Result<Tensor<B>!> {
    let flat! = tensor.flatten()?
    let numel = flat.shape()[0]

    let padded! = if numel % 2 != 0 {
        flat.pad([0, 1], 0.0)?
    } else {
        flat
    }

    let pairs! = padded.reshape([numel / 2, 2])?
    let low! = pairs.slice([.., 0])?
    let high! = pairs.slice([.., 1])?

    let packed! = low + (high * 16.0)?
    packed.to_dtype(DType::Int8)
}

fn unpack_nibbles<B: ComputeBackend>(packed: &Tensor<B>) -> Result<Tensor<B>!> {
    let float_packed! = packed.to_dtype(DType::Float32)?
    let low! = float_packed.clone() % 16.0
    let high! = (float_packed / 16.0)?.floor()
    stack_interleave(&low, &high)
}

fn stack_interleave<B: ComputeBackend>(
    a: &Tensor<B>,
    b: &Tensor<B>,
) -> Result<Tensor<B>!> {
    unimplemented!()
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_fp8_max_values() {
        let e4m3 = FP8Quantizer::new(FP8Format::E4M3)
        assert_eq!(e4m3.max_value(), 448.0)

        let e5m2 = FP8Quantizer::new(FP8Format::E5M2)
        assert_eq!(e5m2.max_value(), 57344.0)
    }

    #[test]
    fn test_nf4_levels() {
        let quantizer = NF4Quantizer::new(NF4Config::default())
        assert_eq!(quantizer.levels.len(), 16)
        assert_eq!(quantizer.levels[0], -1.0)
        assert_eq!(quantizer.levels[15], 1.0)
    }

    #[test]
    fn test_int_quant_config() {
        let config = IntQuantConfig::int8_symmetric()
        assert_eq!(config.bits, 8)
        assert!(config.symmetric)

        let config = IntQuantConfig::int4_symmetric()
        assert_eq!(config.bits, 4)
    }
}
