/// Fusion statistics
#[derive(Default)]
pub struct FusionStats {
    pub attention_fusions: u32,
    pub gelu_fusions: u32,
    pub layernorm_fusions: u32,
    pub linear_fusions: u32,
    pub add_layernorm_fusions: u32,
}

impl FusionStats {
    pub fn total(&self) -> u32 {
        self.attention_fusions
            + self.gelu_fusions
            + self.layernorm_fusions
            + self.linear_fusions
            + self.add_layernorm_fusions
    }
}

// ============================================================================
// Torch Compile (inductor)
// ============================================================================

/// torch.compile configuration
pub struct TorchCompileConfig {
    /// Backend (inductor, cudagraphs, etc.)
    pub backend: CompileBackend,
    /// Compilation mode
    pub mode: CompileMode,
    /// Enable dynamic shapes
    pub dynamic: bool,
    /// Fullgraph mode
    pub fullgraph: bool,
    /// Disable CUDA graphs in inductor
    pub disable_cuda_graph: bool,
}

pub enum CompileBackend {
    Inductor,
    CUDAGraphs,
    ONNXRT,
    TensorRT,
    OpenXLA,
}

pub enum CompileMode {
    /// Default: balance compilation time and performance
    Default,
    /// Reduce overhead: faster compile, moderate speedup
    ReduceOverhead,
    /// Max autotune: slower compile, maximum speedup
    MaxAutotune,
}

impl TorchCompileConfig {
    pub fn default() -> Self {
        Self {
            backend: CompileBackend::Inductor,
            mode: CompileMode::Default,
            dynamic: true,
            fullgraph: false,
            disable_cuda_graph: false,
        }
    }

    pub fn max_performance() -> Self {
        Self {
            backend: CompileBackend::Inductor,
            mode: CompileMode::MaxAutotune,
            dynamic: false,
            fullgraph: true,
            disable_cuda_graph: false,
        }
    }

    pub fn for_diffusion() -> Self {
        Self {
            backend: CompileBackend::Inductor,
            mode: CompileMode::ReduceOverhead,
            dynamic: true,  // Support variable resolutions
            fullgraph: false,  // Diffusion has control flow
            disable_cuda_graph: false,
        }
    }
}

/// Compiled model wrapper
pub struct CompiledModel<M> {
    inner: M,
    config: TorchCompileConfig,
    compiled: bool,
}

impl<M> CompiledModel<M> {
    pub fn new(model: M, config: TorchCompileConfig) -> Self {
        Self {
            inner: model,
            config,
            compiled: false,
        }
    }

    /// Compile the model
    pub fn compile(&mut self) -> Result<()!> {
        // Would trigger torch.compile on the model
        self.compiled = true
        Ok(())
    }

    /// Get inner model
    pub fn inner(&self) -> &M {
        &self.inner
    }

    /// Get mutable inner model
    pub fn inner_mut(&mut self) -> &mut M {
        &mut self.inner
    }

    /// Check if compiled
    pub fn is_compiled(&self) -> bool {
        self.compiled
    }
}

// ============================================================================
// Unified Compilation Pipeline
// ============================================================================

/// Full compilation pipeline
pub struct CompilationPipeline {
    /// ONNX export config
    onnx_config: Option<ONNXExportConfig>,
    /// TensorRT config
    tensorrt_config: Option<TensorRTConfig>,
    /// Kernel fusion config
    fusion_config: Option<KernelFusionConfig>,
    /// Torch compile config
    compile_config: Option<TorchCompileConfig>,
}

impl CompilationPipeline {
    pub fn new() -> Self {
        Self {
            onnx_config: None,
            tensorrt_config: None,
            fusion_config: None,
            compile_config: None,
        }
    }

    pub fn with_onnx(mut self, config: ONNXExportConfig) -> Self {
        self.onnx_config = Some(config)
        self
    }

    pub fn with_tensorrt(mut self, config: TensorRTConfig) -> Self {
        self.tensorrt_config = Some(config)
        self
    }

    pub fn with_fusion(mut self, config: KernelFusionConfig) -> Self {
        self.fusion_config = Some(config)
        self
    }

    pub fn with_torch_compile(mut self, config: TorchCompileConfig) -> Self {
        self.compile_config = Some(config)
        self
    }

    /// Run full compilation pipeline
    pub fn compile<B: ComputeBackend, M: Exportable<B>>(
        &self,
        model: &M,
        example_inputs: &[Tensor<B>],
        output_dir: &Path,
    ) -> Result<CompiledArtifacts!> {
        let mut artifacts = CompiledArtifacts::default()

        // Export to ONNX if configured
        if let Some(ref onnx_config) = self.onnx_config {
            let onnx_path = output_dir.join("model.onnx")
            let exporter = ONNXExporter::new(onnx_config.clone())
            let onnx_model! = exporter.export(model, &onnx_path, example_inputs)?
            artifacts.onnx_model = Some(onnx_model)

            // Build TensorRT engine if configured
            if let Some(ref trt_config) = self.tensorrt_config {
                let trt_path = output_dir.join("model.engine")
                let builder = TensorRTBuilder::new(trt_config.clone())
                let trt_engine! = builder.build_from_onnx(&onnx_path, &trt_path)?
                artifacts.tensorrt_engine = Some(trt_engine)
            }
        }

        Ok(artifacts)
    }
}

