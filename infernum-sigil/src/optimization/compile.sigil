}

impl Clone for TensorRTConfig {
    fn clone(&self) -> Self {
        Self {
            precision: self.precision.clone(),
            workspace_size: self.workspace_size,
            max_batch_size: self.max_batch_size,
            dynamic_shapes: self.dynamic_shapes,
            optimization_profiles: self.optimization_profiles.clone(),
            profiling: self.profiling,
            timing_cache: self.timing_cache,
            timing_cache_path: self.timing_cache_path.clone(),
            cuda_graph: self.cuda_graph,
        }
    }
}

impl Clone for OptimizationProfile {
    fn clone(&self) -> Self {
        Self {
            name: self.name.clone(),
            inputs: self.inputs.clone(),
        }
    }
}

impl Clone for ShapeProfile {
    fn clone(&self) -> Self {
        Self {
            name: self.name.clone(),
            min_shape: self.min_shape.clone(),
            opt_shape: self.opt_shape.clone(),
            max_shape: self.max_shape.clone(),
        }
    }
}

/// Compiled model artifacts
#[derive(Default)]
pub struct CompiledArtifacts {
    pub onnx_model: Option<ONNXModel>,
    pub tensorrt_engine: Option<TensorRTEngine>,
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_onnx_config() {
        let config = ONNXExportConfig::for_tensorrt()
        assert_eq!(config.opset_version, 17)
        assert!(config.fp16_weights)
        assert!(config.dynamic_axes.is_some())
    }

    #[test]
    fn test_tensorrt_config() {
        let config = TensorRTConfig::high_performance()
        assert_eq!(config.workspace_size, 4 * 1024 * 1024 * 1024)
        assert!(config.cuda_graph)
    }

    #[test]
    fn test_kernel_fusion_config() {
        let config = KernelFusionConfig::default()
        assert!(config.fuse_attention)
        assert!(config.fuse_gelu)

        let none = KernelFusionConfig::none()
        assert!(!none.fuse_attention)
    }

    #[test]
    fn test_torch_compile_config() {
        let config = TorchCompileConfig::for_diffusion()
        assert!(config.dynamic)
        assert!(!config.fullgraph)
    }

    #[test]
    fn test_compilation_pipeline() {
        let pipeline = CompilationPipeline::new()
            .with_onnx(ONNXExportConfig::for_diffusion())
            .with_tensorrt(TensorRTConfig::default())
            .with_fusion(KernelFusionConfig::default())

        assert!(pipeline.onnx_config.is_some())
        assert!(pipeline.tensorrt_config.is_some())
        assert!(pipeline.fusion_config.is_some())
    }
}
