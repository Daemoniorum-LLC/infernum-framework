/// Optimization Configuration
///
/// Central configuration for all diffusion optimizations.

use crate::core::error::{InfernumError, Result}

// ============================================================================
// Main Configuration
// ============================================================================

/// Complete optimization configuration for diffusion models
pub struct DiffusionOptimizationConfig {
    // === Attention Optimizations ===
    /// Use Flash Attention 2
    pub flash_attention: bool,
    /// Use memory-efficient attention (xformers-style)
    pub memory_efficient_attention: bool,
    /// Sliding window attention size (for long sequences)
    pub sliding_window: Option<u32>,
    /// Use scaled dot-product attention (PyTorch 2.0+)
    pub sdpa: bool,

    // === Quantization ===
    /// U-Net quantization method
    pub unet_quantization: Option<QuantizationMethod>,
    /// Text encoder quantization
    pub text_encoder_quantization: Option<QuantizationMethod>,
    /// VAE quantization (usually kept in FP16/32)
    pub vae_quantization: Option<QuantizationMethod>,

    // === VAE Optimizations ===
    /// Enable tiled VAE decoding
    pub vae_tiling: bool,
    /// VAE tile size
    pub vae_tile_size: u32,
    /// VAE tile overlap
    pub vae_tile_overlap: u32,
    /// Enable VAE slicing (process batch sequentially)
    pub vae_slicing: bool,

    // === Memory Optimizations ===
    /// Offload entire model to CPU when not in use
    pub cpu_offload: bool,
    /// Sequential offload (layer by layer)
    pub sequential_offload: bool,
    /// Attention slicing (process attention in chunks)
    pub attention_slicing: Option<u32>,
    /// Channels last memory format
    pub channels_last: bool,
    /// Enable gradient checkpointing (for training)
    pub gradient_checkpointing: bool,

    // === Compilation ===
    /// Compile model (AOT/JIT)
    pub compile: bool,
    /// Compilation mode (reduce-overhead, max-autotune)
    pub compile_mode: CompileMode,
    /// Enable CUDA graphs
    pub cuda_graphs: bool,

    // === Caching ===
    /// Cache prompt embeddings
    pub cache_prompt_embeds: bool,
    /// Maximum cache size (MB)
    pub cache_size_mb: u32,
    /// Cache eviction strategy
    pub cache_strategy: CacheStrategy,

    // === Batch Optimizations ===
    /// Enable batch generation optimizations
    pub batch_mode: bool,
    /// Prefetch next batch during generation
    pub prefetch: bool,
}

impl DiffusionOptimizationConfig {
    /// Default balanced configuration
    pub fn default() -> Self {
        Self {
            flash_attention: true,
            memory_efficient_attention: false,
            sliding_window: None,
            sdpa: true,

            unet_quantization: None,
            text_encoder_quantization: None,
            vae_quantization: None,

            vae_tiling: false,
            vae_tile_size: 512,
            vae_tile_overlap: 64,
            vae_slicing: false,

            cpu_offload: false,
            sequential_offload: false,
            attention_slicing: None,
            channels_last: true,
            gradient_checkpointing: false,

            compile: false,
            compile_mode: CompileMode::ReduceOverhead,
            cuda_graphs: false,

            cache_prompt_embeds: true,
            cache_size_mb: 256,
            cache_strategy: CacheStrategy::LRU,

            batch_mode: true,
            prefetch: true,
        }
    }

    /// Fast preset - optimized for speed
    pub fn fast() -> Self {
        Self {
            flash_attention: true,
            memory_efficient_attention: false,
            sdpa: true,
            compile: true,
            compile_mode: CompileMode::MaxAutotune,
            cuda_graphs: true,
            channels_last: true,
            cache_prompt_embeds: true,
            batch_mode: true,
            prefetch: true,
            ..Self::default()
        }
    }

    /// Memory-efficient preset - minimize VRAM
    pub fn low_memory() -> Self {
        Self {
            flash_attention: true,
            memory_efficient_attention: true,
            vae_tiling: true,
            vae_tile_size: 256,
            vae_slicing: true,
            cpu_offload: true,
            sequential_offload: true,
            attention_slicing: Some(1),
            unet_quantization: Some(QuantizationMethod::FP8E4M3),
            ..Self::default()
        }
    }

    /// Quality preset - maximum quality
    pub fn quality() -> Self {
        Self {
            flash_attention: true,
            vae_tiling: false,
            vae_slicing: false,
            cpu_offload: false,
            unet_quantization: None,
            text_encoder_quantization: None,
            vae_quantization: None,
            compile: false,
            ..Self::default()
        }
    }

    /// Realtime preset - for interactive use
    pub fn realtime() -> Self {
        Self {
            flash_attention: true,
            sdpa: true,
            compile: true,
            compile_mode: CompileMode::MaxAutotune,
            cuda_graphs: true,
            channels_last: true,
            cache_prompt_embeds: true,
            unet_quantization: Some(QuantizationMethod::FP8E4M3),
            batch_mode: false,  // Single image at a time
            prefetch: false,
            ..Self::default()
        }
    }

    /// Validate configuration
    pub fn validate(&self) -> Result<()> {
        if self.flash_attention && self.memory_efficient_attention {
            return Err(InfernumError::InvalidConfig(
                "Cannot enable both flash_attention and memory_efficient_attention"
            ))
        }

        if self.sequential_offload && !self.cpu_offload {
            return Err(InfernumError::InvalidConfig(
                "sequential_offload requires cpu_offload to be enabled"
            ))
        }

        if self.cuda_graphs && self.cpu_offload {
            return Err(InfernumError::InvalidConfig(
                "CUDA graphs not compatible with CPU offloading"
            ))
        }

        Ok(())
    }

    /// Estimate VRAM usage in GB
    pub fn estimate_vram_gb(&self, model_size_gb: f32) -> f32 {
        let mut vram = model_size_gb

        // Quantization reduces memory
        if let Some(quant) = &self.unet_quantization {
            vram *= match quant {
                QuantizationMethod::FP8E4M3 | QuantizationMethod::FP8E5M2 => 0.5,
                QuantizationMethod::INT8 => 0.5,
                QuantizationMethod::INT4 => 0.25,
                QuantizationMethod::NF4 => 0.25,
            }
        }

        // Offloading eliminates most VRAM
        if self.cpu_offload {
            vram *= 0.3  // Only active layers in VRAM
        }

        // Tiling reduces peak memory
        if self.vae_tiling {
            vram *= 0.8
        }

        vram
    }
}

/// Optimization presets
pub enum OptimizationPreset {
    /// Default balanced settings
    Default,
    /// Optimized for speed
    Fast,
    /// Minimize memory usage
    LowMemory,
    /// Maximum quality
    Quality,
    /// For interactive/realtime use
    Realtime,
    /// Custom configuration
    Custom(DiffusionOptimizationConfig),
}

impl OptimizationPreset {
    /// Convert to config
    pub fn to_config(self) -> DiffusionOptimizationConfig {
        match self {
            Self::Default => DiffusionOptimizationConfig::default(),
            Self::Fast => DiffusionOptimizationConfig::fast(),
            Self::LowMemory => DiffusionOptimizationConfig::low_memory(),
            Self::Quality => DiffusionOptimizationConfig::quality(),
            Self::Realtime => DiffusionOptimizationConfig::realtime(),
            Self::Custom(config) => config,
        }
    }
}

// ============================================================================
// Sub-configurations
// ============================================================================

/// Attention-specific configuration
pub struct AttentionConfig {
    /// Attention implementation
    pub backend: AttentionBackend,
    /// Number of attention heads
    pub num_heads: u32,
    /// Head dimension
    pub head_dim: u32,
    /// Dropout (training only)
    pub dropout: f32,
    /// Sliding window size
    pub window_size: Option<u32>,
    /// Use causal masking
    pub causal: bool,
}

impl AttentionConfig {
    pub fn default(num_heads: u32, head_dim: u32) -> Self {
        Self {
            backend: AttentionBackend::Auto,
            num_heads,
            head_dim,
            dropout: 0.0,
            window_size: None,
            causal: false,
        }
    }
}

/// Attention backend selection
pub enum AttentionBackend {
    /// Auto-select best backend
    Auto,
    /// Flash Attention 2
    FlashAttention,
    /// Memory-efficient (xformers)
    MemoryEfficient,
    /// PyTorch SDPA
    SDPA,
    /// Naive implementation
    Naive,
}

/// Memory configuration
pub struct MemoryConfig {
    /// Total VRAM budget (MB)
    pub vram_budget_mb: u32,
    /// Reserve VRAM for system (MB)
    pub vram_reserve_mb: u32,
    /// Enable memory pooling
    pub memory_pooling: bool,
    /// Clear cache between batches
    pub clear_cache: bool,
}

impl MemoryConfig {
    pub fn default() -> Self {
        Self {
            vram_budget_mb: 0,  // 0 = no limit
            vram_reserve_mb: 512,
            memory_pooling: true,
            clear_cache: false,
        }
    }

    pub fn for_vram(vram_gb: f32) -> Self {
        Self {
            vram_budget_mb: (vram_gb * 1024.0) as u32,
            vram_reserve_mb: 512,
            memory_pooling: true,
            clear_cache: vram_gb < 8.0,
        }
    }
}

/// Quantization method
pub enum QuantizationMethod {
    /// FP8 E4M3 (NVIDIA Ada+)
    FP8E4M3,
    /// FP8 E5M2
    FP8E5M2,
    /// INT8 symmetric
    INT8,
    /// INT4 packed
    INT4,
    /// NormalFloat 4-bit
    NF4,
}

impl QuantizationMethod {
    /// Bits per weight
    pub fn bits(&self) -> u32 {
        match self {
            Self::FP8E4M3 | Self::FP8E5M2 | Self::INT8 => 8,
            Self::INT4 | Self::NF4 => 4,
        }
    }

    /// Memory reduction factor
    pub fn reduction_factor(&self) -> f32 {
        16.0 / self.bits() as f32
    }
}

/// Quantization configuration
pub struct QuantizationConfig {
    /// Quantization method
    pub method: QuantizationMethod,
    /// Calibration samples
    pub num_calibration_samples: u32,
    /// Per-channel quantization
    pub per_channel: bool,
    /// Symmetric quantization
    pub symmetric: bool,
    /// Layers to skip
    pub skip_layers: Vec<str>,
}

impl QuantizationConfig {
    pub fn default(method: QuantizationMethod) -> Self {
        Self {
            method,
            num_calibration_samples: 128,
            per_channel: true,
            symmetric: true,
            skip_layers: vec![],
        }
    }

    pub fn fp8() -> Self {
        Self::default(QuantizationMethod::FP8E4M3)
    }

    pub fn int8() -> Self {
        Self::default(QuantizationMethod::INT8)
    }
}

/// Compilation mode
pub enum CompileMode {
    /// Minimize compilation overhead
    ReduceOverhead,
    /// Maximum performance through autotuning
    MaxAutotune,
    /// Default mode
    Default,
}

/// Compilation configuration
pub struct CompileConfig {
    /// Compilation mode
    pub mode: CompileMode,
    /// Enable CUDA graphs
    pub cuda_graphs: bool,
    /// Enable kernel fusion
    pub kernel_fusion: bool,
    /// Dynamic shapes
    pub dynamic_shapes: bool,
    /// Full graph compilation
    pub fullgraph: bool,
}

impl CompileConfig {
    pub fn default() -> Self {
        Self {
            mode: CompileMode::ReduceOverhead,
            cuda_graphs: false,
            kernel_fusion: true,
            dynamic_shapes: true,
            fullgraph: false,
        }
    }

    pub fn max_performance() -> Self {
        Self {
            mode: CompileMode::MaxAutotune,
            cuda_graphs: true,
            kernel_fusion: true,
            dynamic_shapes: false,
            fullgraph: true,
        }
    }
}

/// Cache eviction strategy
pub enum CacheStrategy {
    /// Least Recently Used
    LRU,
    /// Least Frequently Used
    LFU,
    /// First In First Out
    FIFO,
    /// Time-based expiration
    TTL { seconds: u32 },
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_default_config() {
        let config = DiffusionOptimizationConfig::default()
        assert!(config.flash_attention)
        assert!(config.sdpa)
        assert!(!config.cpu_offload)
    }

    #[test]
    fn test_low_memory_config() {
        let config = DiffusionOptimizationConfig::low_memory()
        assert!(config.vae_tiling)
        assert!(config.cpu_offload)
        assert!(config.sequential_offload)
    }

    #[test]
    fn test_config_validation() {
        let mut config = DiffusionOptimizationConfig::default()
        config.flash_attention = true
        config.memory_efficient_attention = true
        assert!(config.validate().is_err())
    }

    #[test]
    fn test_vram_estimation() {
        let config = DiffusionOptimizationConfig::default()
        let vram = config.estimate_vram_gb(4.0)
        assert!(vram > 0.0)

        let low_mem = DiffusionOptimizationConfig::low_memory()
        let low_vram = low_mem.estimate_vram_gb(4.0)
        assert!(low_vram < vram)
    }

    #[test]
    fn test_quantization_bits() {
        assert_eq!(QuantizationMethod::FP8E4M3.bits(), 8)
        assert_eq!(QuantizationMethod::INT4.bits(), 4)
    }
}
