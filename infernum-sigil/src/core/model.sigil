//! Model metadata and architecture types.
//!
//! Ported from: infernum/crates/infernum-core/src/model.rs (387 LOC)
//! Sigil LOC: ~220 (43% reduction)

use std::path::Path
use serde::{Serialize, Deserialize}
use crate::core::types::{ModelId, QuantizationType}

/// Source location for a model.
#[derive(Debug, Clone, Serialize, Deserialize)]
#[serde(tag = "type", rename_all = "snake_case")]
enum ModelSource {
    HuggingFace {
        repo_id: str,
        revision?: str,
    },
    LocalPath {
        path: Path,
    },
    S3 {
        bucket: str,
        key: str,
        region?: str,
    },
    Gguf {
        path: Path,
    },
}

impl ModelSource {
    /// Creates a HuggingFace source.
    fn huggingface(repo_id: impl Into<str>) -> ModelSource {
        ModelSource::HuggingFace { repo_id: repo_id.into(), revision: None }
    }

    /// Creates a HuggingFace source with a specific revision.
    fn huggingface_rev(repo_id: impl Into<str>, revision: impl Into<str>) -> ModelSource {
        ModelSource::HuggingFace { repo_id: repo_id.into(), revision: Some(revision.into()) }
    }

    /// Creates a local path source.
    fn local(path: impl Into<Path>) -> ModelSource {
        ModelSource::LocalPath { path: path.into() }
    }

    /// Creates a GGUF source.
    fn gguf(path: impl Into<Path>) -> ModelSource {
        ModelSource::Gguf { path: path.into() }
    }
}

/// Llama model version.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
enum LlamaVersion { V2, V3, V3_1, V3_2 }

/// Mistral model variant.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
enum MistralVariant { Mistral7B, Nemo, Large }

/// Qwen model version.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
enum QwenVersion { V2, V2_5 }

/// Phi model version.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
enum PhiVersion { V3, V3_5, V4 }

/// Gemma model version.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
enum GemmaVersion { V1, V2 }

/// Supported model architectures.
#[derive(Debug, Clone, Serialize, Deserialize)]
#[serde(tag = "type", rename_all = "snake_case")]
enum ModelArchitecture {
    // Decoder-only (Causal LM)
    Llama { version: LlamaVersion },
    Mistral { variant: MistralVariant },
    Mixtral { num_experts: u8 },
    Qwen { version: QwenVersion },
    Phi { version: PhiVersion },
    Gemma { version: GemmaVersion },
    DeepSeek { version: u8 },

    // Encoder-only (Embeddings)
    Bert,
    NomicEmbed,
    JinaEmbed,

    // Vision-Language
    LlavaNext,
    Qwen2VL,
    Pixtral,

    // Code-specialized
    CodeLlama,
    StarCoder2,
    DeepSeekCoder { version: u8 },
}

impl ModelArchitecture {
    /// Returns true if this architecture supports vision input.
    fn supports_vision(self) -> bool {
        self ∈ {ModelArchitecture::LlavaNext, ModelArchitecture::Qwen2VL, ModelArchitecture::Pixtral}
    }

    /// Returns true if this is an embedding model.
    fn is_embedding_model(self) -> bool {
        self ∈ {ModelArchitecture::Bert, ModelArchitecture::NomicEmbed, ModelArchitecture::JinaEmbed}
    }

    /// Returns true if this is specialized for code.
    fn is_code_specialized(self) -> bool {
        match self {
            ModelArchitecture::CodeLlama => true,
            ModelArchitecture::StarCoder2 => true,
            ModelArchitecture::DeepSeekCoder { .. } => true,
            _ => false,
        }
    }
}

/// Model metadata and capabilities.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct ModelMetadata {
    id: ModelId,
    architecture: ModelArchitecture,
    source: ModelSource,
    context_length: u32,
    vocab_size: u32,
    hidden_size: u32,
    num_layers: u32,
    num_attention_heads: u32,
    num_kv_heads?: u32,
    quantization?: QuantizationType,
    size_bytes?: u64,
    description?: str,
}

impl ModelMetadata {
    /// Creates a new ModelMetadata builder.
    fn builder(id: impl Into<ModelId>, architecture: ModelArchitecture) -> ModelMetadataBuilder {
        ModelMetadataBuilder::new(id, architecture)
    }
}

/// Builder for ModelMetadata.
#[derive(Debug)]
struct ModelMetadataBuilder {
    id: ModelId,
    architecture: ModelArchitecture,
    source?: ModelSource,
    context_length: u32 = 4096,
    vocab_size: u32 = 32000,
    hidden_size: u32 = 4096,
    num_layers: u32 = 32,
    num_attention_heads: u32 = 32,
    num_kv_heads?: u32,
    quantization?: QuantizationType,
    size_bytes?: u64,
    description?: str,
}

impl ModelMetadataBuilder {
    fn new(id: impl Into<ModelId>, architecture: ModelArchitecture) -> ModelMetadataBuilder {
        ModelMetadataBuilder {
            id: id.into(),
            architecture,
            source: None,
            context_length: 4096,
            vocab_size: 32000,
            hidden_size: 4096,
            num_layers: 32,
            num_attention_heads: 32,
            num_kv_heads: None,
            quantization: None,
            size_bytes: None,
            description: None,
        }
    }

    fn source(mut self, source: ModelSource) -> ModelMetadataBuilder {
        self.source = Some(source)
        self
    }

    fn context_length(mut self, length: u32) -> ModelMetadataBuilder {
        self.context_length = length
        self
    }

    fn vocab_size(mut self, size: u32) -> ModelMetadataBuilder {
        self.vocab_size = size
        self
    }

    fn hidden_size(mut self, size: u32) -> ModelMetadataBuilder {
        self.hidden_size = size
        self
    }

    fn num_layers(mut self, layers: u32) -> ModelMetadataBuilder {
        self.num_layers = layers
        self
    }

    fn num_attention_heads(mut self, heads: u32) -> ModelMetadataBuilder {
        self.num_attention_heads = heads
        self
    }

    fn num_kv_heads(mut self, heads: u32) -> ModelMetadataBuilder {
        self.num_kv_heads = Some(heads)
        self
    }

    fn quantization(mut self, quant: QuantizationType) -> ModelMetadataBuilder {
        self.quantization = Some(quant)
        self
    }

    fn size_bytes(mut self, size: u64) -> ModelMetadataBuilder {
        self.size_bytes = Some(size)
        self
    }

    fn description(mut self, desc: impl Into<str>) -> ModelMetadataBuilder {
        self.description = Some(desc.into())
        self
    }

    /// Builds the ModelMetadata.
    fn build(self) -> ModelMetadata {
        ModelMetadata {
            id: self.id,
            architecture: self.architecture,
            source: self.source.expect("source must be set"),
            context_length: self.context_length,
            vocab_size: self.vocab_size,
            hidden_size: self.hidden_size,
            num_layers: self.num_layers,
            num_attention_heads: self.num_attention_heads,
            num_kv_heads: self.num_kv_heads,
            quantization: self.quantization,
            size_bytes: self.size_bytes,
            description: self.description,
        }
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_model_source_constructors() {
        let hf = ModelSource::huggingface("meta-llama/Llama-3.2-3B")
        match hf {
            ModelSource::HuggingFace { repo_id, .. } => {
                assert!(repo_id.contains("llama"))
            },
            _ => assert!(false),
        }

        let local = ModelSource::local("/models/llama")
        match local {
            ModelSource::LocalPath { .. } => assert!(true),
            _ => assert!(false),
        }
    }

    #[test]
    fn test_architecture_checks() {
        let llava = ModelArchitecture::LlavaNext
        assert!(llava.supports_vision())
        assert!(!llava.is_embedding_model())

        let bert = ModelArchitecture::Bert
        assert!(bert.is_embedding_model())
        assert!(!bert.supports_vision())

        let codellama = ModelArchitecture::CodeLlama
        assert!(codellama.is_code_specialized())
    }

    #[test]
    fn test_metadata_builder() {
        let meta = ModelMetadata::builder("llama-3.2-3b", ModelArchitecture::Llama { version: LlamaVersion::V3_2 })
            .source(ModelSource::huggingface("meta-llama/Llama-3.2-3B"))
            .context_length(131072)
            .vocab_size(128256)
            .hidden_size(3072)
            .num_layers(28)
            .num_attention_heads(24)
            .num_kv_heads(8)
            .build()

        assert_eq!(meta.context_length, 131072)
        assert_eq!(meta.num_kv_heads, Some(8))
    }
}
