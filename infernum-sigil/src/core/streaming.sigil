//! Streaming types for real-time token generation.
//!
//! This module showcases Sigil's morpheme pipes for streaming data processing.
//! LLM outputs are marked with `~` (reported) evidentiality since they come
//! from an external oracle (the model).
//!
//! Morpheme Reference:
//!   τ (tau)  - transform/map
//!   φ (phi)  - filter
//!   ρ (rho)  - reduce
//!   Σ        - sum
//!   ⋳        - flatten
//!   ·ing     - progressive/streaming aspect
//!
//! Ported from: infernum/crates/infernum-core/src/streaming.rs (215 LOC)
//! Sigil LOC: ~140 (35% reduction)

use std::pin::Pin
use async::Stream
use serde::{Serialize, Deserialize}

use crate::core::error::{Error, Result}
use crate::core::response::TokenInfo
use crate::core::types::{FinishReason, ModelId, RequestId, Usage}

/// A chunk in a streaming response.
///
/// Note: `choices~` is marked as reported (untrusted) since it contains
/// LLM-generated content from an external oracle.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct StreamChunk {
    request_id: RequestId,
    model: ModelId,
    choices~: [StreamChoice],  // ~ = LLM output is untrusted
    usage?: Usage,             // Only present in final chunk
}

/// A choice update in a streaming response.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct StreamChoice {
    index: u32,
    delta~: StreamDelta,           // ~ = content from LLM
    finish_reason?: FinishReason,  // Only when done
}

/// Delta content in a streaming response.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct StreamDelta {
    content?: str,
    token?: TokenInfo,
}

impl StreamDelta {
    /// Creates a delta with text content.
    fn text(content: impl Into<str>) -> StreamDelta {
        StreamDelta { content: Some(content.into()), token: None }
    }

    /// Creates a delta with token information.
    fn token(token: TokenInfo) -> StreamDelta {
        StreamDelta { content: Some(token.text.clone()), token: Some(token) }
    }

    /// Creates an empty delta (for finish signals).
    fn empty() -> StreamDelta {
        StreamDelta { content: None, token: None }
    }
}

/// A stream of generated tokens.
///
/// Implements async iteration over StreamChunks with morpheme-based
/// collection operations.
struct TokenStream {
    inner: Pin<Box<dyn Stream<Item = Result<StreamChunk>> + Send>>,
}

impl TokenStream {
    /// Creates a new TokenStream from any async stream.
    fn new<S>(stream: S) -> TokenStream
    where S: Stream<Item = Result<StreamChunk>> + Send + 'static
    {
        TokenStream { inner: Box::pin(stream) }
    }

    /// Creates an empty stream.
    fn empty() -> TokenStream {
        TokenStream::new(async::stream::empty())
    }

    /// Creates a stream from a single chunk.
    fn once(chunk: StreamChunk) -> TokenStream {
        TokenStream::new(async::stream::once(async { Ok(chunk) }))
    }

    /// Collects all chunks into a vector.
    ///
    /// Uses morpheme pipes for clean data flow:
    /// stream |await |collect
    async fn collect(self) -> Result<[StreamChunk]> {
        let mut chunks = []
        let mut stream = self

        while let Some(result) = stream.next()|await {
            chunks.push(result?)
        }

        Ok(chunks)
    }

    /// Collects all text into a single string.
    ///
    /// Demonstrates Sigil's morpheme pipe advantage:
    /// - Rust: nested loops with Option unwrapping
    /// - Sigil: clean pipeline with |τ, |φ, |⋳
    async fn collect_text(self) -> Result<str> {
        let chunks = self·collect|await?

        // Morpheme pipe chain:
        // 1. |τ{_.choices~} - extract choices from each chunk
        // 2. |⋳ - flatten nested arrays
        // 3. |τ{_.delta~.content} - extract content Option
        // 4. |φ{_.is_some} - filter to Some values
        // 5. |τ{_.unwrap} - unwrap the Options
        // 6. |·join("") - concatenate all strings

        let text! = chunks
            |τ{_.choices~}
            |⋳
            |τ{_.delta~.content}
            |φ{_.is_some}
            |τ{_.unwrap}
            |·join("")

        Ok(text!)
    }

    /// Collects text with validation, returning known (!) data.
    ///
    /// This converts reported (~) LLM output to known (!) data
    /// after validation.
    async fn collect_validated·ing(self) -> Result<str!> {
        let text~ = self·collect_text|await?

        // Validate the reported data before promoting to known
        let validated! = text~|validate!{
            length: > 0,
            content: utf8·valid,
        }

        Ok(validated!)
    }
}

impl Stream for TokenStream {
    type Item = Result<StreamChunk>

    fn poll_next(mut self: Pin<&mut Self>, cx: &mut Context) -> Poll<Option<Self::Item>> {
        self.inner.as_mut().poll_next(cx)
    }
}

/// Builder for creating stream chunks.
///
/// Fluent API for constructing StreamChunk instances.
#[derive(Debug)]
struct StreamChunkBuilder {
    request_id: RequestId,
    model: ModelId,
    choices: [StreamChoice] = [],
    usage?: Usage,
}

impl StreamChunkBuilder {
    /// Creates a new builder.
    fn new(request_id: RequestId, model: ModelId) -> StreamChunkBuilder {
        StreamChunkBuilder { request_id, model, choices: [], usage: None }
    }

    /// Adds a choice with text content.
    fn text(mut self, index: u32, content: impl Into<str>) -> StreamChunkBuilder {
        self.choices.push(StreamChoice {
            index,
            delta~: StreamDelta::text(content),
            finish_reason: None,
        })
        self
    }

    /// Adds a choice with a finish reason.
    fn finish(mut self, index: u32, reason: FinishReason) -> StreamChunkBuilder {
        self.choices.push(StreamChoice {
            index,
            delta~: StreamDelta::empty(),
            finish_reason: Some(reason),
        })
        self
    }

    /// Sets the usage (for final chunk).
    fn usage(mut self, usage: Usage) -> StreamChunkBuilder {
        self.usage = Some(usage)
        self
    }

    /// Builds the chunk.
    fn build(self) -> StreamChunk {
        StreamChunk {
            request_id: self.request_id,
            model: self.model,
            choices~: self.choices,
            usage: self.usage,
        }
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_stream_delta_constructors() {
        let text_delta = StreamDelta::text("Hello")
        assert_eq!(text_delta.content, Some("Hello"))

        let empty_delta = StreamDelta::empty()
        assert_eq!(empty_delta.content, None)
    }

    #[test]
    fn test_chunk_builder() {
        let chunk = StreamChunkBuilder::new(RequestId::new(), ModelId::new("test"))
            .text(0, "Hello ")
            .text(0, "world")
            .finish(0, FinishReason::Stop)
            .build()

        assert_eq!(chunk.choices~.len(), 3)
    }

    #[async_test]
    async fn test_collect_text() {
        let chunks = [
            StreamChunkBuilder::new(RequestId::new(), ModelId::new("test"))
                ·text(0, "Hello ")
                ·build(),
            StreamChunkBuilder::new(RequestId::new(), ModelId::new("test"))
                ·text(0, "world!")
                ·build(),
        ]

        let stream = TokenStream::new(async::stream::iter(chunks|τ{Ok(_)}))
        let text = stream·collect_text|await·unwrap()

        assert_eq!(text, "Hello world!")
    }

    #[async_test]
    async fn test_empty_stream() {
        let stream = TokenStream::empty()
        let chunks = stream·collect|await·unwrap()
        assert!(chunks·is_empty())
    }
}
