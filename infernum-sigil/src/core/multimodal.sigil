/// Multimodal Input Handling - Text + Image Integration
///
/// Extends core request/response types to support multimodal content,
/// enabling vision-language model inference with interleaved text and images.
///
/// Leverages Sigil's evidentiality types:
/// - `data~` for untrusted external inputs (user images, text)
/// - `found?` for optional/nullable values
/// - `computed!` for verified processed outputs

use serde::{Serialize, Deserialize}
use crate::core::types::{Role, Message, RequestId, ModelId, Usage}
use crate::core::sampling::SamplingParams
use crate::vision::types::{ImageInput, ImageSource, ImageFeatures}
use crate::vision::encoder::{ImageEncoder, EncoderOutput}

// ============================================================================
// Multimodal Content Types
// ============================================================================

/// A single part of multimodal content
#[derive(Debug, Clone, Serialize, Deserialize)]
#[serde(tag = "type")]
pub enum ContentPart~ {
    /// Text content
    Text { text~: str },

    /// Image content from various sources
    Image { image~: ImageReference },

    /// Image URL (OpenAI-compatible format)
    ImageUrl { image_url~: ImageUrlSpec },

    /// Audio content (future support)
    Audio { audio~: AudioReference },

    /// Video content (future support)
    Video { video~: VideoReference },
}

/// Reference to an image
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ImageReference~ {
    /// Base64-encoded image data
    pub data~: str?,

    /// URL to fetch image from
    pub url~: str?,

    /// Local file path
    pub path~: str?,

    /// MIME type (image/png, image/jpeg, etc.)
    pub media_type~: str?,

    /// Image detail level for processing
    pub detail~: ImageDetail = ImageDetail::Auto,
}

/// OpenAI-compatible image URL specification
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ImageUrlSpec~ {
    /// URL of the image
    pub url~: str,

    /// Detail level for processing
    pub detail~: ImageDetail = ImageDetail::Auto,
}

/// Image detail level (controls resolution/token count tradeoff)
#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "lowercase")]
pub enum ImageDetail {
    /// Automatic selection based on image size
    #[default]
    Auto,
    /// Low resolution (faster, fewer tokens)
    Low,
    /// High resolution (anyres tiling, more tokens)
    High,
}

/// Audio content reference (placeholder for future)
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct AudioReference~ {
    pub data~: str?,
    pub url~: str?,
    pub format~: str?,
}

/// Video content reference (placeholder for future)
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct VideoReference~ {
    pub data~: str?,
    pub url~: str?,
    pub num_frames~: u32?,
}

// ============================================================================
// Multimodal Messages
// ============================================================================

/// Multimodal message content - either simple text or complex parts
#[derive(Debug, Clone, Serialize, Deserialize)]
#[serde(untagged)]
pub enum MessageContent~ {
    /// Simple text-only content
    Text(str~),

    /// Multimodal content with multiple parts
    Parts([ContentPart~]),
}

impl MessageContent~ {
    /// Create text-only content
    pub fn text(s: impl Into<str>) -> Self {
        Self::Text(s.into())
    }

    /// Create multimodal content from parts
    pub fn parts(parts: [ContentPart~]) -> Self {
        Self::Parts(parts)
    }

    /// Check if content contains any images
    pub fn has_images(self) -> bool {
        match self {
            Self::Text(_) => false,
            Self::Parts(parts~) => parts~
                .iter()
                .any(|p| matches!(p, ContentPart~::Image { .. } | ContentPart~::ImageUrl { .. })),
        }
    }

    /// Check if content contains any audio
    pub fn has_audio(self) -> bool {
        match self {
            Self::Text(_) => false,
            Self::Parts(parts~) => parts~
                .iter()
                .any(|p| matches!(p, ContentPart~::Audio { .. })),
        }
    }

    /// Check if content contains any video
    pub fn has_video(self) -> bool {
        match self {
            Self::Text(_) => false,
            Self::Parts(parts~) => parts~
                .iter()
                .any(|p| matches!(p, ContentPart~::Video { .. })),
        }
    }

    /// Check if this is text-only content
    pub fn is_text_only(self) -> bool {
        match self {
            Self::Text(_) => true,
            Self::Parts(parts~) => parts~
                .iter()
                .all(|p| matches!(p, ContentPart~::Text { .. })),
        }
    }

    /// Extract all text parts concatenated
    pub fn text_content(self) -> str {
        match self {
            Self::Text(s~) => s~.to_string(),
            Self::Parts(parts~) => parts~
                φ{ p => matches!(p, ContentPart~::Text { .. }) }
                τ{ p => match p {
                    ContentPart~::Text { text~ } => text~.to_string(),
                    _ => String::new(),
                }}
                .join(" "),
        }
    }

    /// Extract all image references
    pub fn image_refs(self) -> [ImageReference~] {
        match self {
            Self::Text(_) => [],
            Self::Parts(parts~) => parts~
                φ{ p => matches!(p, ContentPart~::Image { .. } | ContentPart~::ImageUrl { .. }) }
                τ{ p => match p {
                    ContentPart~::Image { image~ } => image~,
                    ContentPart~::ImageUrl { image_url~ } => ImageReference~ {
                        data~: None,
                        url~: Some(image_url~.url~.clone()),
                        path~: None,
                        media_type~: None,
                        detail~: image_url~.detail~,
                    },
                    _ => unreachable!(),
                }},
        }
    }

    /// Count number of images in content
    pub fn image_count(self) -> usize {
        self.image_refs().len()
    }
}

/// Multimodal message extending base Message
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct MultimodalMessage~ {
    /// Role of the message sender
    pub role: Role,

    /// Multimodal content (text or parts)
    pub content~: MessageContent~,

    /// Optional name for the message author
    pub name~: str?,

    /// Tool call ID if this is a tool response
    pub tool_call_id~: str?,
}

impl MultimodalMessage~ {
    /// Create a system message (text only)
    pub fn system(content: impl Into<str>) -> Self {
        Self {
            role: Role::System,
            content~: MessageContent~::text(content),
            name~: None,
            tool_call_id~: None,
        }
    }

    /// Create a user message with text
    pub fn user_text(content: impl Into<str>) -> Self {
        Self {
            role: Role::User,
            content~: MessageContent~::text(content),
            name~: None,
            tool_call_id~: None,
        }
    }

    /// Create a user message with multimodal content
    pub fn user_parts(parts: [ContentPart~]) -> Self {
        Self {
            role: Role::User,
            content~: MessageContent~::parts(parts),
            name~: None,
            tool_call_id~: None,
        }
    }

    /// Create a user message with text and a single image
    pub fn user_with_image(text: impl Into<str>, image: ImageReference~) -> Self {
        Self::user_parts([
            ContentPart~::Text { text~: text.into() },
            ContentPart~::Image { image~ },
        ])
    }

    /// Create a user message with text and multiple images
    pub fn user_with_images(text: impl Into<str>, images: [ImageReference~]) -> Self {
        let mut parts = vec![ContentPart~::Text { text~: text.into() }]
        for img~ in images {
            parts.push(ContentPart~::Image { image~: img~ })
        }
        Self::user_parts(parts)
    }

    /// Create an assistant message (text only for now)
    pub fn assistant(content: impl Into<str>) -> Self {
        Self {
            role: Role::Assistant,
            content~: MessageContent~::text(content),
            name~: None,
            tool_call_id~: None,
        }
    }

    /// Check if message contains images
    pub fn has_images(self) -> bool {
        self.content~.has_images()
    }

    /// Convert to base Message (loses image data)
    pub fn to_text_message(self) -> Message {
        Message {
            role: self.role,
            content: self.content~.text_content(),
            name: self.name~.clone(),
            tool_call_id: self.tool_call_id~.clone(),
        }
    }
}

// ============================================================================
// Multimodal Request/Response
// ============================================================================

/// Multimodal prompt input
#[derive(Debug, Clone, Serialize, Deserialize)]
#[serde(untagged)]
pub enum MultimodalPrompt~ {
    /// Simple text prompt
    Text(str~),

    /// Multimodal messages
    Messages([MultimodalMessage~]),

    /// Pre-tokenized with image features already embedded
    Prepared(PreparedPrompt!),
}

/// Prepared multimodal prompt with processed images
#[derive(Debug, Clone)]
pub struct PreparedPrompt! {
    /// Token IDs for text portions
    pub token_ids!: [u32],

    /// Processed image features
    pub image_features!: [ImageFeatures!],

    /// Image insertion positions (token index -> image index)
    pub image_positions!: [(usize, usize)],

    /// Total number of tokens including image tokens
    pub total_tokens!: u32,
}

/// Multimodal generation request
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct MultimodalRequest~ {
    /// Unique request ID
    pub request_id: RequestId = RequestId::new(),

    /// Model to use
    pub model~: ModelId?,

    /// Multimodal prompt (text or messages with images)
    pub prompt~: MultimodalPrompt~,

    /// Sampling parameters
    pub sampling: SamplingParams = SamplingParams::default(),

    /// Enable streaming
    pub stream: bool = false,

    /// Echo prompt in response
    pub echo: bool = false,

    /// Number of completions to generate
    pub n: u32 = 1,

    /// Image processing detail level
    pub image_detail: ImageDetail = ImageDetail::Auto,

    /// Maximum images to process (for resource limits)
    pub max_images: u32 = 16,
}

impl MultimodalRequest~ {
    /// Create a new text-only request
    pub fn new(prompt: impl Into<str>) -> Self {
        Self {
            request_id: RequestId::new(),
            model~: None,
            prompt~: MultimodalPrompt~::Text(prompt.into()),
            sampling: SamplingParams::default(),
            stream: false,
            echo: false,
            n: 1,
            image_detail: ImageDetail::Auto,
            max_images: 16,
        }
    }

    /// Create a chat request with multimodal messages
    pub fn chat(messages: [MultimodalMessage~]) -> Self {
        Self {
            request_id: RequestId::new(),
            model~: None,
            prompt~: MultimodalPrompt~::Messages(messages),
            sampling: SamplingParams::default(),
            stream: false,
            echo: false,
            n: 1,
            image_detail: ImageDetail::Auto,
            max_images: 16,
        }
    }

    /// Create a vision request with text and image
    pub fn vision(text: impl Into<str>, image: ImageReference~) -> Self {
        Self::chat([MultimodalMessage~::user_with_image(text, image)])
    }

    /// Set the model
    pub fn with_model(mut self, model: impl Into<ModelId>) -> Self {
        self.model~ = Some(model.into())
        self
    }

    /// Set sampling parameters
    pub fn with_sampling(mut self, sampling: SamplingParams) -> Self {
        self.sampling = sampling
        self
    }

    /// Enable streaming
    pub fn with_stream(mut self) -> Self {
        self.stream = true
        self
    }

    /// Set image detail level
    pub fn with_image_detail(mut self, detail: ImageDetail) -> Self {
        self.image_detail = detail
        self
    }

    /// Check if this request contains any images
    pub fn has_images(self) -> bool {
        match &self.prompt~ {
            MultimodalPrompt~::Text(_) => false,
            MultimodalPrompt~::Messages(msgs~) => msgs~.iter().any(|m| m.has_images()),
            MultimodalPrompt~::Prepared(p!) => !p!.image_features!.is_empty(),
        }
    }

    /// Count total images in request
    pub fn image_count(self) -> usize {
        match &self.prompt~ {
            MultimodalPrompt~::Text(_) => 0,
            MultimodalPrompt~::Messages(msgs~) => msgs~
                .iter()
                .map(|m| m.content~.image_count())
                ρ+{ |a, b| a + b },
            MultimodalPrompt~::Prepared(p!) => p!.image_features!.len(),
        }
    }
}

// ============================================================================
// Image Loading and Processing
// ============================================================================

/// Image loader for converting references to ImageInput
pub struct ImageLoader {
    /// HTTP client for fetching URLs
    http_client: HttpClient?,

    /// Maximum image size in bytes
    max_size_bytes: usize,

    /// Allowed domains for URL fetching
    allowed_domains: [str]?,
}

impl ImageLoader {
    /// Create a new image loader with defaults
    pub fn new() -> Self {
        Self {
            http_client: None,
            max_size_bytes: 20 * 1024 * 1024, // 20MB
            allowed_domains: None,
        }
    }

    /// Create loader with HTTP support
    pub fn with_http(client: HttpClient) -> Self {
        Self {
            http_client: Some(client),
            max_size_bytes: 20 * 1024 * 1024,
            allowed_domains: None,
        }
    }

    /// Load image from reference
    pub fn load(self, reference~: ImageReference~) -> Result<ImageInput, LoadError> {
        // Try base64 data first
        if let Some(data~) = &reference~.data~ {
            return self.load_base64(data~, reference~.media_type~.as_deref())
        }

        // Try URL
        if let Some(url~) = &reference~.url~ {
            return self.load_url(url~)
        }

        // Try file path
        if let Some(path~) = &reference~.path~ {
            return self.load_file(path~)
        }

        Err(LoadError::NoSource)
    }

    /// Load from base64-encoded data
    fn load_base64(self, data~: &str, media_type~: str?) -> Result<ImageInput, LoadError> {
        // Decode base64
        let bytes~ = base64::decode(data~)
            .map_err(|e| LoadError::Base64DecodeError(e.to_string()))?

        // Validate size
        if bytes~.len() > self.max_size_bytes {
            return Err(LoadError::ImageTooLarge {
                size: bytes~.len(),
                max: self.max_size_bytes,
            })
        }

        // Determine format
        let format = media_type~
            .and_then(|mt| ImageFormat::from_mime(mt))
            .or_else(|| ImageFormat::from_bytes(&bytes~))
            .ok_or(LoadError::UnknownFormat)?

        Ok(ImageInput {
            source~: ImageSource::Bytes {
                data~: bytes~,
                format~
            },
            resize_mode: ResizeMode::default(),
            target_size: None,
        })
    }

    /// Load from URL
    fn load_url(self, url~: &str) -> Result<ImageInput, LoadError> {
        // Check allowed domains
        if let Some(domains) = &self.allowed_domains {
            let host = extract_host(url~)?
            if !domains.contains(&host) {
                return Err(LoadError::DomainNotAllowed(host))
            }
        }

        // Require HTTP client
        let client = self.http_client.as_ref()
            .ok_or(LoadError::HttpNotConfigured)?

        // Fetch image
        let response~ = client.get(url~)?
        let bytes~ = response~.bytes()?

        // Validate size
        if bytes~.len() > self.max_size_bytes {
            return Err(LoadError::ImageTooLarge {
                size: bytes~.len(),
                max: self.max_size_bytes,
            })
        }

        // Determine format from content-type or bytes
        let format = response~.headers()
            .get("content-type")
            .and_then(|ct| ImageFormat::from_mime(ct))
            .or_else(|| ImageFormat::from_bytes(&bytes~))
            .ok_or(LoadError::UnknownFormat)?

        Ok(ImageInput {
            source~: ImageSource::Bytes { data~: bytes~, format~ },
            resize_mode: ResizeMode::default(),
            target_size: None,
        })
    }

    /// Load from local file
    fn load_file(self, path~: &str) -> Result<ImageInput, LoadError> {
        Ok(ImageInput {
            source~: ImageSource::Path(path~.to_string()),
            resize_mode: ResizeMode::default(),
            target_size: None,
        })
    }
}

/// Errors during image loading
#[derive(Debug, Clone)]
pub enum LoadError {
    NoSource,
    Base64DecodeError(str),
    HttpNotConfigured,
    HttpError(str),
    DomainNotAllowed(str),
    ImageTooLarge { size: usize, max: usize },
    UnknownFormat,
    IoError(str),
}

impl std::fmt::Display for LoadError {
    fn fmt(self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
        match self {
            Self::NoSource => write!(f, "No image source provided"),
            Self::Base64DecodeError(e) => write!(f, "Base64 decode error: {}", e),
            Self::HttpNotConfigured => write!(f, "HTTP client not configured for URL loading"),
            Self::HttpError(e) => write!(f, "HTTP error: {}", e),
            Self::DomainNotAllowed(d) => write!(f, "Domain not allowed: {}", d),
            Self::ImageTooLarge { size, max } =>
                write!(f, "Image too large: {} bytes (max: {})", size, max),
            Self::UnknownFormat => write!(f, "Unknown image format"),
            Self::IoError(e) => write!(f, "IO error: {}", e),
        }
    }
}

// ============================================================================
// Multimodal Prompt Preparation
// ============================================================================

/// Prepares multimodal prompts for inference
pub struct PromptPreparer {
    /// Image encoder for processing images
    encoder: ImageEncoder,

    /// Image loader
    loader: ImageLoader,

    /// Tokenizer for text
    tokenizer: Tokenizer,

    /// Special tokens
    image_token: str,
    image_token_id: u32,
}

impl PromptPreparer {
    /// Create a new prompt preparer
    pub fn new(
        encoder: ImageEncoder,
        loader: ImageLoader,
        tokenizer: Tokenizer,
        image_token: str,
    ) -> Result<Self, PrepareError> {
        let image_token_id = tokenizer.encode(&image_token)?
            .first()
            .copied()
            .ok_or(PrepareError::InvalidImageToken)?

        Ok(Self {
            encoder,
            loader,
            tokenizer,
            image_token: image_token.to_string(),
            image_token_id,
        })
    }

    /// Prepare a multimodal request for inference
    pub fn prepare(self, request~: &MultimodalRequest~) -> Result<PreparedPrompt!, PrepareError> {
        match &request~.prompt~ {
            MultimodalPrompt~::Text(text~) => self.prepare_text_only(text~),
            MultimodalPrompt~::Messages(msgs~) => self.prepare_messages(msgs~, request~.image_detail),
            MultimodalPrompt~::Prepared(p!) => Ok(p!.clone()),
        }
    }

    /// Prepare text-only prompt
    fn prepare_text_only(self, text~: &str) -> Result<PreparedPrompt!, PrepareError> {
        let token_ids! = self.tokenizer.encode(text~)?

        Ok(PreparedPrompt! {
            token_ids!,
            image_features!: [],
            image_positions!: [],
            total_tokens!: token_ids!.len() as u32,
        })
    }

    /// Prepare multimodal messages
    fn prepare_messages(
        self,
        messages~: &[MultimodalMessage~],
        detail: ImageDetail,
    ) -> Result<PreparedPrompt!, PrepareError> {
        let mut all_tokens!: [u32] = []
        let mut all_features!: [ImageFeatures!] = []
        let mut positions!: [(usize, usize)] = []
        let mut image_idx = 0usize

        for msg~ in messages~ {
            match &msg~.content~ {
                MessageContent~::Text(text~) => {
                    // Simple text message
                    let formatted = self.format_message(msg~.role, text~)
                    let tokens! = self.tokenizer.encode(&formatted)?
                    all_tokens!.extend(tokens!)
                }

                MessageContent~::Parts(parts~) => {
                    // Multimodal message - process each part
                    let role_prefix = self.role_prefix(msg~.role)
                    let prefix_tokens! = self.tokenizer.encode(&role_prefix)?
                    all_tokens!.extend(prefix_tokens!)

                    for part~ in parts~ {
                        match part~ {
                            ContentPart~::Text { text~ } => {
                                let tokens! = self.tokenizer.encode(text~)?
                                all_tokens!.extend(tokens!)
                            }

                            ContentPart~::Image { image~ } |
                            ContentPart~::ImageUrl { image_url~: ImageUrlSpec~ { url~: _, detail~: _ } as image~ } => {
                                // Record position before image tokens
                                let pos = all_tokens!.len()

                                // Load and encode image
                                let img_ref~ = match part~ {
                                    ContentPart~::Image { image~ } => image~.clone(),
                                    ContentPart~::ImageUrl { image_url~ } => ImageReference~ {
                                        url~: Some(image_url~.url~.clone()),
                                        ..Default::default()
                                    },
                                    _ => unreachable!(),
                                }

                                let input = self.loader.load(img_ref~)?
                                let output! = self.encoder.encode(input)?

                                // Add image token placeholders
                                let num_tokens = output!.num_image_tokens!
                                for _ in 0..num_tokens {
                                    all_tokens!.push(self.image_token_id)
                                }

                                // Record position and features
                                positions!.push((pos, image_idx))
                                all_features!.push(output!.features!)
                                image_idx += 1
                            }

                            ContentPart~::Audio { .. } | ContentPart~::Video { .. } => {
                                // Future: handle audio/video
                                return Err(PrepareError::UnsupportedModality)
                            }
                        }
                    }

                    // Add role suffix
                    let suffix_tokens! = self.tokenizer.encode(&self.role_suffix(msg~.role))?
                    all_tokens!.extend(suffix_tokens!)
                }
            }
        }

        let total = all_tokens!.len() as u32

        Ok(PreparedPrompt! {
            token_ids!: all_tokens!,
            image_features!: all_features!,
            image_positions!: positions!,
            total_tokens!: total,
        })
    }

    /// Format a text message with role prefix/suffix
    fn format_message(self, role: Role, content: &str) -> str {
        format!("{}{}{}", self.role_prefix(role), content, self.role_suffix(role))
    }

    /// Get role prefix (model-specific, defaults to ChatML style)
    fn role_prefix(self, role: Role) -> str {
        match role {
            Role::System => "<|im_start|>system\n".to_string(),
            Role::User => "<|im_start|>user\n".to_string(),
            Role::Assistant => "<|im_start|>assistant\n".to_string(),
            Role::Tool => "<|im_start|>tool\n".to_string(),
        }
    }

    /// Get role suffix
    fn role_suffix(self, _role: Role) -> str {
        "<|im_end|>\n".to_string()
    }
}

/// Errors during prompt preparation
#[derive(Debug, Clone)]
pub enum PrepareError {
    TokenizationError(str),
    ImageLoadError(LoadError),
    ImageEncodeError(str),
    InvalidImageToken,
    UnsupportedModality,
    TooManyImages { count: usize, max: usize },
}

impl From<LoadError> for PrepareError {
    fn from(e: LoadError) -> Self {
        PrepareError::ImageLoadError(e)
    }
}

// ============================================================================
// Helper Types (extern declarations for external dependencies)
// ============================================================================

extern struct HttpClient
extern struct HttpResponse {
    fn bytes(self) -> Result<[u8], str>
    fn headers(self) -> HttpHeaders
}
extern struct HttpHeaders {
    fn get(self, key: &str) -> str?
}
extern struct Tokenizer {
    fn encode(self, text: &str) -> Result<[u32], str>
}

fn extract_host(url: &str) -> Result<str, LoadError> {
    // Simple host extraction
    url.split("://")
        .nth(1)
        .and_then(|s| s.split('/').next())
        .map(|s| s.to_string())
        .ok_or(LoadError::HttpError("Invalid URL".to_string()))
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_message_content_text() {
        let content~ = MessageContent~::text("Hello, world!")
        assert!(content~.is_text_only())
        assert!(!content~.has_images())
        assert_eq!(content~.text_content(), "Hello, world!")
    }

    #[test]
    fn test_message_content_with_image() {
        let parts~ = [
            ContentPart~::Text { text~: "What's in this image?" },
            ContentPart~::Image {
                image~: ImageReference~ {
                    data~: Some("base64data".to_string()),
                    url~: None,
                    path~: None,
                    media_type~: Some("image/png".to_string()),
                    detail~: ImageDetail::Auto,
                }
            },
        ]
        let content~ = MessageContent~::parts(parts~)

        assert!(!content~.is_text_only())
        assert!(content~.has_images())
        assert_eq!(content~.image_count(), 1)
    }

    #[test]
    fn test_multimodal_message_creation() {
        let msg~ = MultimodalMessage~::user_with_image(
            "Describe this",
            ImageReference~ {
                url~: Some("https://example.com/image.jpg".to_string()),
                ..Default::default()
            }
        )

        assert_eq!(msg~.role, Role::User)
        assert!(msg~.has_images())
    }

    #[test]
    fn test_multimodal_request() {
        let req~ = MultimodalRequest~::vision(
            "What do you see?",
            ImageReference~ {
                path~: Some("/tmp/test.jpg".to_string()),
                ..Default::default()
            }
        )
        .with_model("llava-1.5-7b")
        .with_image_detail(ImageDetail::High)

        assert!(req~.has_images())
        assert_eq!(req~.image_count(), 1)
    }

    #[test]
    fn test_image_detail_serialization() {
        let detail = ImageDetail::High
        let json = serde_json::to_string(&detail).unwrap()
        assert_eq!(json, "\"high\"")
    }
}
