//! Request types for inference operations.
//!
//! Request inputs are marked with `~` (reported) evidentiality since they
//! come from external sources (users, APIs) and should be validated.
//!
//! Ported from: infernum/crates/infernum-core/src/request.rs (241 LOC)
//! Sigil LOC: ~150 (38% reduction)

use serde::{Serialize, Deserialize}
use crate::core::sampling::SamplingParams
use crate::core::types::{Message, ModelId, RequestId}

/// Input format for prompts.
///
/// User-provided input is marked `~` (reported/untrusted).
#[derive(Debug, Clone, Serialize, Deserialize)]
#[serde(untagged)]
enum PromptInput {
    Text(str~),              // Raw text (untrusted)
    Messages([Message]~),    // Chat messages (untrusted)
    Tokens([u32]),           // Pre-tokenized (trusted - we computed it)
}

impl From<str> for PromptInput {
    fn from(s: str) -> PromptInput { PromptInput::Text(s) }
}

impl From<[Message]> for PromptInput {
    fn from(messages: [Message]) -> PromptInput { PromptInput::Messages(messages) }
}

/// Request for text generation.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct GenerateRequest {
    request_id: RequestId = RequestId::new(),
    model?: ModelId,
    prompt~: PromptInput,           // ~ = user input is untrusted
    sampling: SamplingParams = SamplingParams::default(),
    stream: bool = false,
    echo: bool = false,
    n: u32 = 1,
    logprobs?: u32,
}

impl GenerateRequest {
    /// Creates a new generation request with the given prompt.
    fn new(prompt: impl Into<PromptInput>) -> GenerateRequest {
        GenerateRequest {
            request_id: RequestId::new(),
            model: None,
            prompt~: prompt.into(),
            sampling: SamplingParams::default(),
            stream: false,
            echo: false,
            n: 1,
            logprobs: None,
        }
    }

    /// Creates a chat completion request.
    fn chat(messages: [Message]) -> GenerateRequest {
        GenerateRequest::new(PromptInput::Messages(messages))
    }

    /// Sets the model to use.
    fn with_model(mut self, model: impl Into<ModelId>) -> GenerateRequest {
        self.model = Some(model.into())
        self
    }

    /// Sets the sampling parameters.
    fn with_sampling(mut self, sampling: SamplingParams) -> GenerateRequest {
        self.sampling = sampling
        self
    }

    /// Enables streaming.
    fn with_stream(mut self) -> GenerateRequest {
        self.stream = true
        self
    }

    /// Sets the number of completions.
    fn with_n(mut self, n: u32) -> GenerateRequest {
        self.n = n
        self
    }

    /// Enables log probabilities.
    fn with_logprobs(mut self, top_logprobs: u32) -> GenerateRequest {
        self.logprobs = Some(top_logprobs)
        self
    }
}

/// Request for generating embeddings.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct EmbedRequest {
    request_id: RequestId = RequestId::new(),
    model?: ModelId,
    input~: EmbedInput,              // ~ = user input
    encoding_format: EncodingFormat = EncodingFormat::Float,
    dimensions?: u32,
}

/// Input format for embeddings.
#[derive(Debug, Clone, Serialize, Deserialize)]
#[serde(untagged)]
enum EmbedInput {
    Single(str~),
    Multiple([str]~),
}

impl From<str> for EmbedInput {
    fn from(s: str) -> EmbedInput { EmbedInput::Single(s) }
}

impl From<[str]> for EmbedInput {
    fn from(v: [str]) -> EmbedInput { EmbedInput::Multiple(v) }
}

impl EmbedInput {
    /// Returns the inputs as a slice of strings.
    fn as_texts(self) -> [str] {
        match self {
            EmbedInput::Single(s~) => [s~],
            EmbedInput::Multiple(v~) => v~,
        }
    }
}

/// Encoding format for embeddings.
#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
enum EncodingFormat {
    #[default]
    Float,
    Base64,
}

impl EmbedRequest {
    /// Creates a new embedding request.
    fn new(input: impl Into<EmbedInput>) -> EmbedRequest {
        EmbedRequest {
            request_id: RequestId::new(),
            model: None,
            input~: input.into(),
            encoding_format: EncodingFormat::Float,
            dimensions: None,
        }
    }

    /// Sets the model to use.
    fn with_model(mut self, model: impl Into<ModelId>) -> EmbedRequest {
        self.model = Some(model.into())
        self
    }

    /// Sets the encoding format.
    fn with_encoding_format(mut self, format: EncodingFormat) -> EmbedRequest {
        self.encoding_format = format
        self
    }

    /// Sets the output dimensions.
    fn with_dimensions(mut self, dims: u32) -> EmbedRequest {
        self.dimensions = Some(dims)
        self
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_generate_request_builder() {
        let req = GenerateRequest::new("Hello, world!")
            .with_model("llama-3.2-3b")
            .with_sampling(SamplingParams::balanced())
            .with_stream()
            .with_n(2)

        assert!(req.model.is_some())
        assert!(req.stream)
        assert_eq!(req.n, 2)
    }

    #[test]
    fn test_chat_request() {
        let messages = [
            Message::system("You are helpful"),
            Message::user("Hello!"),
        ]
        let req = GenerateRequest::chat(messages)

        match req.prompt~ {
            PromptInput::Messages(_) => assert!(true),
            _ => assert!(false, "Expected Messages prompt"),
        }
    }

    #[test]
    fn test_embed_request() {
        let req = EmbedRequest::new("Embed this text")
            .with_model("nomic-embed")
            .with_dimensions(512)

        assert_eq!(req.dimensions, Some(512))
    }
}
