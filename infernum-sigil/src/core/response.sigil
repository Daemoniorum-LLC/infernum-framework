//! Response types for inference operations.
//!
//! Response outputs are marked with `~` (reported) evidentiality since they
//! come from an external oracle (the LLM model).
//!
//! Ported from: infernum/crates/infernum-core/src/response.rs (152 LOC)
//! Sigil LOC: ~100 (34% reduction)

use serde::{Serialize, Deserialize}
use crate::core::types::{FinishReason, ModelId, RequestId, Usage}

/// Response from text generation.
///
/// All generated content is marked `~` (reported) since it comes from
/// an external oracle (the LLM).
#[derive(Debug, Clone, Serialize, Deserialize)]
struct GenerateResponse {
    request_id: RequestId,
    model: ModelId,
    choices~: [Choice],              // ~ = LLM output is untrusted
    usage: Usage,                    // Usage is computed locally (trusted)
    time_to_first_token_ms?: f64,
    total_time_ms?: f64,
}

/// A single completion choice.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct Choice {
    index: u32,
    text~: str,                      // ~ = generated text is untrusted
    finish_reason?: FinishReason,
    logprobs?: LogProbs,
}

/// Log probability information.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct LogProbs {
    tokens: [str],
    token_logprobs: [f32],
    top_logprobs?: [[TopLogProb]],
}

/// Top log probability entry.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct TopLogProb {
    token: str,
    logprob: f32,
}

/// Information about a single generated token.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct TokenInfo {
    id: u32,
    text: str,
    logprob?: f32,
    special: bool = false,
}

/// Response from embedding generation.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct EmbedResponse {
    request_id: RequestId,
    model: ModelId,
    data: [Embedding],               // Embeddings are computed (trusted)
    usage: Usage,
}

/// A single embedding.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct Embedding {
    index: u32,
    embedding: EmbeddingData,
}

/// Embedding data in different formats.
#[derive(Debug, Clone, Serialize, Deserialize)]
#[serde(untagged)]
enum EmbeddingData {
    Float([f32]),
    Base64(str),
}

impl EmbeddingData {
    /// Returns the embedding as a float vector.
    fn as_floats(self) -> Result<[f32], str> {
        match self {
            EmbeddingData::Float(v) => Ok(v),
            EmbeddingData::Base64(_) => Err("base64 decoding not implemented"),
        }
    }

    /// Returns the dimensionality of the embedding.
    fn dimensions(self) -> usize {
        match self {
            EmbeddingData::Float(v) => v.len(),
            EmbeddingData::Base64(s) => (s.len() * 3) / 16,
        }
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_token_info() {
        let token = TokenInfo {
            id: 1234,
            text: "hello",
            logprob: Some(-0.5),
            special: false,
        }
        assert_eq!(token.id, 1234)
        assert!(!token.special)
    }

    #[test]
    fn test_embedding_dimensions() {
        let emb = EmbeddingData::Float([0.1, 0.2, 0.3, 0.4])
        assert_eq!(emb.dimensions(), 4)
    }

    #[test]
    fn test_embedding_as_floats() {
        let emb = EmbeddingData::Float([1.0, 2.0, 3.0])
        let floats = emb.as_floats().unwrap()
        assert_eq!(floats.len(), 3)
    }
}
