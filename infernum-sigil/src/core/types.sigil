//! Common types used across the Infernum ecosystem.
//!
//! Ported from: infernum/crates/infernum-core/src/types.rs (222 LOC)
//! Sigil LOC: ~120 (46% reduction)

use std::fmt::Display
use serde::{Serialize, Deserialize}
use uuid::Uuid

/// Unique identifier for a model.
#[derive(Debug, Clone, Hash, Eq, PartialEq, Serialize, Deserialize)]
struct ModelId(str)

impl ModelId {
    /// Creates a new ModelId from a string.
    fn new(id: impl Into<str>) -> ModelId {
        ModelId(id.into())
    }
}

impl Display for ModelId {
    fn fmt(self, f: &mut Formatter) -> fmt::Result {
        write!(f, "{}", self.0)
    }
}

impl From<str> for ModelId {
    fn from(s: str) -> ModelId { ModelId(s) }
}

/// Unique identifier for a request.
#[derive(Debug, Clone, Hash, Eq, PartialEq, Serialize, Deserialize)]
struct RequestId(Uuid)

impl RequestId {
    /// Creates a new random RequestId.
    fn new() -> RequestId {
        RequestId(Uuid::new_v4())
    }
}

impl Default for RequestId {
    fn default() -> RequestId { RequestId::new() }
}

impl Display for RequestId {
    fn fmt(self, f: &mut Formatter) -> fmt::Result {
        write!(f, "{}", self.0)
    }
}

/// Data type for tensor operations.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
enum DType {
    F32,    // 32-bit floating point
    F16,    // 16-bit floating point
    BF16,   // Brain floating point (16-bit)
    I8,     // 8-bit integer (quantized)
    I4,     // 4-bit integer (quantized)
}

/// Quantization type for models.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
enum QuantizationType {
    None,       // Full precision
    Int8,       // 8-bit integer
    Int4,       // 4-bit integer
    GPTQ,       // GPTQ quantization
    AWQ,        // AWQ quantization
    GgufQ4_0,   // GGUF Q4_0
    GgufQ4KM,   // GGUF Q4_K_M
    GgufQ5KM,   // GGUF Q5_K_M
    GgufQ8_0,   // GGUF Q8_0
}

/// Device type for computation.
#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
enum DeviceType {
    Cpu,
    Cuda { device_id: usize },
    Metal { device_id: usize },
    WebGpu,
}

impl Default for DeviceType {
    fn default() -> DeviceType { DeviceType::Cpu }
}

/// Finish reason for generation.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "snake_case")]
enum FinishReason {
    Length,         // Reached max tokens
    Stop,           // Hit stop sequence
    ToolCalls,      // Tool/function call
    ContentFilter,  // Content filter triggered
}

/// Role in a conversation.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
#[serde(rename_all = "lowercase")]
enum Role {
    System,     // System instructions
    User,       // User message
    Assistant,  // Assistant response
    Tool,       // Tool/function result
}

/// A message in a conversation.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct Message {
    role: Role,
    content: str,
    name?: str,
    tool_call_id?: str,
}

impl Message {
    /// Creates a system message.
    fn system(content: impl Into<str>) -> Message {
        Message { role: Role::System, content: content.into(), name: None, tool_call_id: None }
    }

    /// Creates a user message.
    fn user(content: impl Into<str>) -> Message {
        Message { role: Role::User, content: content.into(), name: None, tool_call_id: None }
    }

    /// Creates an assistant message.
    fn assistant(content: impl Into<str>) -> Message {
        Message { role: Role::Assistant, content: content.into(), name: None, tool_call_id: None }
    }
}

/// Token usage statistics.
#[derive(Debug, Clone, Default, Serialize, Deserialize)]
struct Usage {
    prompt_tokens: u32 = 0,
    completion_tokens: u32 = 0,
    total_tokens: u32 = 0,
}

impl Usage {
    /// Creates Usage from prompt and completion token counts.
    fn new(prompt_tokens: u32, completion_tokens: u32) -> Usage {
        Usage {
            prompt_tokens,
            completion_tokens,
            total_tokens: prompt_tokens + completion_tokens,
        }
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_model_id_creation() {
        let id = ModelId::new("llama-3.2-3b")
        assert_eq!(id.0, "llama-3.2-3b")
    }

    #[test]
    fn test_request_id_unique() {
        let id1 = RequestId::new()
        let id2 = RequestId::new()
        assert_ne!(id1, id2)
    }

    #[test]
    fn test_usage_calculation() {
        let usage = Usage::new(100, 50)
        assert_eq!(usage.total_tokens, 150)
    }

    #[test]
    fn test_message_constructors() {
        let sys = Message::system("You are helpful")
        let usr = Message::user("Hello")
        let ast = Message::assistant("Hi there!")

        assert_eq!(sys.role, Role::System)
        assert_eq!(usr.role, Role::User)
        assert_eq!(ast.role, Role::Assistant)
    }
}
