//! Training configuration types.
//!
//! Ported from: infernum-framework/crates/asmodeus/src/config.rs (64 LOC)
//! Sigil LOC: ~35 (45% reduction)

use serde::{Deserialize, Serialize}

/// Configuration for LoRA adaptation.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct LoraConfig {
    r: u32 = 8,
    alpha: f32 = 16.0,
    dropout: f32 = 0.05,
    target_modules: [str] = ["q_proj".to_string(), "v_proj".to_string()],
}

/// Training hyperparameters.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct TrainingConfig {
    learning_rate: f64 = 2e-4,
    batch_size: u32 = 4,
    num_epochs: u32 = 3,
    warmup_steps: u32 = 100,
    weight_decay: f64 = 0.01,
    gradient_accumulation_steps: u32 = 4,
    max_grad_norm: f64 = 1.0,
    lora: ?LoraConfig = Some(LoraConfig::default()),
}
