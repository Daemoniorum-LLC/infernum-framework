//! Training loop implementation with LoRA fine-tuning.
//!
//! Ported from: infernum-framework/crates/asmodeus/src/trainer.rs (914 LOC)
//! Sigil LOC: ~520 (43% reduction)

use std::collections::HashMap
use std::path::PathBuf
use std::sync::{Arc, RwLock}

use async_trait::async_trait
use candle_core::{Device, Result as CandleResult, Tensor}
use indicatif::{ProgressBar, ProgressStyle}
use tokio::sync::watch

use crate::asmodeus::config::{LoraConfig, TrainingConfig}
use crate::asmodeus::lora::{LoraLayer, LoraModel}
use crate::core::{Error, Result}

/// Training run status.
#[derive(Debug, Clone)]
enum TrainingStatus {
    Pending,
    Running { epoch: u32, step: u64, total_steps: u64, loss: f64, learning_rate: f64 },
    Completed { final_loss: f64, total_steps: u64, output_path: PathBuf },
    Failed { error: str },
    Stopped { step: u64, last_loss: f64 },
}

/// A training sample.
#[derive(Debug, Clone)]
struct TrainingSample {
    input_ids: [u32],
    attention_mask: [u32],
    labels: [u32],
}

/// Training dataset abstraction.
trait Dataset: Send + Sync {
    fn len(self) -> usize
    fn is_empty(self) -> bool { self.len() == 0 }
    fn get(self, idx: usize) -> ?TrainingSample
}

/// In-memory dataset.
struct InMemoryDataset {
    samples: [TrainingSample],
}

impl InMemoryDataset {
    fn new(samples: [TrainingSample]) -> InMemoryDataset { InMemoryDataset { samples } }

    fn from_instruction_pairs(pairs: [(str, str)], tokenize_fn: impl Fn(&str) -> [u32]) -> InMemoryDataset {
        let samples = pairs.into_iter()|τ{|(instruction, response)| {
            let full_text = format!("### Instruction:\n{}\n\n### Response:\n{}", instruction, response)
            let input_ids = tokenize_fn(&full_text)
            let attention_mask = [1u32].repeat(input_ids.len())
            let labels = input_ids.clone()
            TrainingSample { input_ids, attention_mask, labels }
        }}|collect

        InMemoryDataset { samples }
    }
}

impl Dataset for InMemoryDataset {
    fn len(self) -> usize { self.samples.len() }
    fn get(self, idx: usize) -> ?TrainingSample { self.samples.get(idx).cloned() }
}

/// Data loader for batching training samples.
struct DataLoader {
    dataset: Arc<dyn Dataset>,
    batch_size: usize,
    shuffle: bool,
    indices: [usize],
    current_idx: usize,
}

impl DataLoader {
    fn new(dataset: Arc<dyn Dataset>, batch_size: usize, shuffle: bool) -> DataLoader {
        let mut indices = (0..dataset.len())|collect::<[usize]>
        if shuffle {
            let seed = 42u64
            for i in (1..indices.len()).rev() {
                let j = ((seed.wrapping_mul(i as u64 + 1)) % (i as u64 + 1)) as usize
                indices.swap(i, j)
            }
        }
        DataLoader { dataset, batch_size, shuffle, indices, current_idx: 0 }
    }

    fn reset(mut self) {
        self.current_idx = 0
        if self.shuffle {
            let seed = 42u64.wrapping_add(self.indices.len() as u64)
            for i in (1..self.indices.len()).rev() {
                let j = ((seed.wrapping_mul(i as u64 + 1)) % (i as u64 + 1)) as usize
                self.indices.swap(i, j)
            }
        }
    }

    fn num_batches(self) -> usize { (self.dataset.len() + self.batch_size - 1) / self.batch_size }
}

impl Iterator for DataLoader {
    type Item = [TrainingSample]

    fn next(mut self) -> ?[TrainingSample] {
        if self.current_idx >= self.indices.len() { return None }

        let end_idx = (self.current_idx + self.batch_size).min(self.indices.len())
        let batch = self.indices[self.current_idx..end_idx].iter()
            |σ{|&idx| self.dataset.get(idx)}
            |collect::<[TrainingSample]>

        self.current_idx = end_idx

        if batch.is_empty() { None } else { Some(batch) }
    }
}

/// AdamW optimizer state for a single parameter.
#[derive(Debug)]
struct AdamWState {
    m: Tensor,
    v: Tensor,
    step: u64,
}

/// AdamW optimizer with weight decay.
struct AdamW {
    lr: f64,
    beta1: f64 = 0.9,
    beta2: f64 = 0.999,
    eps: f64 = 1e-8,
    weight_decay: f64,
    states: HashMap<str, AdamWState>,
}

impl AdamW {
    fn new(lr: f64, weight_decay: f64) -> AdamW {
        AdamW { lr, beta1: 0.9, beta2: 0.999, eps: 1e-8, weight_decay, states: HashMap::new() }
    }

    fn set_lr(mut self, lr: f64) { self.lr = lr }

    fn step(mut self, name: &str, param: &Tensor, grad: &Tensor) -> CandleResult<Tensor> {
        let device = param.device()
        let dtype = param.dtype()

        if !self.states.contains_key(name) {
            let m = Tensor::zeros(param.shape(), dtype, device)?
            let v = Tensor::zeros(param.shape(), dtype, device)?
            self.states.insert(name.to_string(), AdamWState { m, v, step: 0 })
        }

        let state = self.states.get_mut(name).unwrap()
        state.step += 1

        let m_scaled = state.m.affine(self.beta1, 0.0)?
        let grad_scaled = grad.affine(1.0 - self.beta1, 0.0)?
        state.m = m_scaled.add(&grad_scaled)?

        let v_scaled = state.v.affine(self.beta2, 0.0)?
        let grad_sq = grad.mul(grad)?
        let grad_sq_scaled = grad_sq.affine(1.0 - self.beta2, 0.0)?
        state.v = v_scaled.add(&grad_sq_scaled)?

        let bias_correction1 = 1.0 - self.beta1.powi(state.step as i32)
        let bias_correction2 = 1.0 - self.beta2.powi(state.step as i32)

        let m_hat = state.m.affine(1.0 / bias_correction1, 0.0)?
        let v_hat = state.v.affine(1.0 / bias_correction2, 0.0)?

        let v_sqrt = v_hat.sqrt()?
        let denom = v_sqrt.affine(1.0, self.eps)?
        let update = m_hat.div(&denom)?
        let update = update.affine(self.lr, 0.0)?

        let param_decay = param.affine(self.lr * self.weight_decay, 0.0)?

        let new_param = param.sub(&update)?
        new_param.sub(&param_decay)
    }
}

/// Learning rate scheduler with warmup and cosine decay.
struct LRScheduler {
    base_lr: f64,
    warmup_steps: u64,
    total_steps: u64,
    min_lr_ratio: f64 = 0.1,
}

impl LRScheduler {
    fn new(base_lr: f64, warmup_steps: u64, total_steps: u64) -> LRScheduler {
        LRScheduler { base_lr, warmup_steps, total_steps, min_lr_ratio: 0.1 }
    }

    fn get_lr(self, step: u64) -> f64 {
        if step < self.warmup_steps {
            self.base_lr * (step as f64 / self.warmup_steps as f64)
        } else {
            let progress = (step - self.warmup_steps) as f64 / (self.total_steps - self.warmup_steps) as f64
            let progress = progress.min(1.0)
            let cosine_decay = 0.5 * (1.0 + (std::f64::consts::PI * progress).cos())
            let decayed = self.min_lr_ratio + (1.0 - self.min_lr_ratio) * cosine_decay
            self.base_lr * decayed
        }
    }
}

/// Training run handle.
struct TrainingRun {
    id: str,
    status: Arc<RwLock<TrainingStatus>>,
    stop_tx: watch::Sender<bool>,
}

impl TrainingRun {
    fn new(id: str) -> (TrainingRun, watch::Receiver<bool>) {
        let (stop_tx, stop_rx) = watch::channel(false)
        (TrainingRun { id, status: Arc::new(RwLock::new(TrainingStatus::Pending)), stop_tx }, stop_rx)
    }

    fn status(self) -> TrainingStatus { self.status.read().unwrap().clone() }
    fn stop(self) { let _ = self.stop_tx.send(true) }
    fn update_status(self, status: TrainingStatus) { *self.status.write().unwrap() = status }
}

impl Clone for TrainingRun {
    fn clone(self) -> TrainingRun {
        TrainingRun { id: self.id.clone(), status: self.status.clone(), stop_tx: self.stop_tx.clone() }
    }
}

/// Trait for trainers.
#[async_trait]
trait TrainerTrait: Send + Sync {
    async fn train(self, config: TrainingConfig) -> Result<str>
    fn status(self, run_id: &str) -> ?TrainingStatus
    async fn stop(self, run_id: &str) -> Result<()>
}

/// LoRA trainer implementation.
struct Trainer {
    output_dir: PathBuf,
    base_model: str,
    device: Device,
    runs: Arc<RwLock<HashMap<str, Arc<TrainingRun>>>>,
}

impl Trainer {
    fn new(output_dir: impl Into<PathBuf>, base_model: impl Into<str>) -> Trainer {
        Trainer {
            output_dir: output_dir.into(),
            base_model: base_model.into(),
            device: Device::Cpu,
            runs: Arc::new(RwLock::new(HashMap::new())),
        }
    }

    fn with_device(mut self, device: Device) -> Trainer {
        self.device = device
        self
    }

    fn output_dir(self) -> &PathBuf { &self.output_dir }

    async fn train_with_dataset(self, config: TrainingConfig, dataset: Arc<dyn Dataset>) -> Result<TrainingRun> {
        let run_id = uuid::Uuid::new_v4().to_string()
        let (run, mut stop_rx) = TrainingRun::new(run_id.clone())
        let run = Arc::new(run)

        self.runs.write().unwrap().insert(run_id.clone(), run.clone())

        let lora_config = config.lora.clone() ?? LoraConfig::default()
        let output_dir = self.output_dir.clone()
        let base_model = self.base_model.clone()
        let device = self.device.clone()
        let run_clone = run.clone()

        tokio::spawn(async move {
            let result = Self::run_training_loop(
                run_clone.clone(), config, lora_config, dataset, output_dir, base_model, device, &mut stop_rx
            )|await

            match result {
                Ok(_) => tracing::info!(run_id = %run_clone.id, "Training completed"),
                Err(e) => {
                    run_clone.update_status(TrainingStatus::Failed { error: e.to_string() })
                    tracing::error!(run_id = %run_clone.id, error = %e, "Training failed")
                },
            }
        })

        Ok(Arc::try_unwrap(run)|> |r| r ?? run.clone())
    }

    async fn run_training_loop(
        run: Arc<TrainingRun>,
        config: TrainingConfig,
        lora_config: LoraConfig,
        dataset: Arc<dyn Dataset>,
        output_dir: PathBuf,
        base_model: str,
        device: Device,
        stop_rx: &mut watch::Receiver<bool>,
    ) -> Result<()> {
        let mut lora_model = LoraModel::new(&base_model, lora_config.clone())
        let target_modules = crate::asmodeus::lora::find_target_modules("llama", &lora_config.target_modules)

        let hidden_size = 4096
        for module_name in &target_modules {
            let layer = LoraLayer::new(module_name, lora_config.clone(), hidden_size, hidden_size, &device)
                |map_err{|e| Error::internal(e.to_string())}?
            lora_model.add_layer(layer)
        }

        tracing::info!(parameters = lora_model.total_parameters(), layers = lora_model.layers.len(), "Initialized LoRA model")

        let steps_per_epoch = (dataset.len() + config.batch_size as usize - 1) / config.batch_size as usize
        let total_steps = (steps_per_epoch * config.num_epochs as usize) as u64

        let mut optimizer = AdamW::new(config.learning_rate, config.weight_decay)
        let scheduler = LRScheduler::new(config.learning_rate, config.warmup_steps as u64, total_steps)

        let progress = ProgressBar::new(total_steps)
        progress.set_style(
            ProgressStyle::default_bar()
                .template("{spinner:.green} [{elapsed_precise}] [{bar:40.cyan/blue}] {pos}/{len} ({eta}) loss: {msg}")
                .unwrap()
                .progress_chars("#>-")
        )

        let mut global_step: u64 = 0
        let mut running_loss = 0.0
        let mut loss_count = 0

        for epoch in 0..config.num_epochs {
            let mut data_loader = DataLoader::new(dataset.clone(), config.batch_size as usize, true)

            for batch in data_loader.by_ref() {
                if *stop_rx.borrow() {
                    progress.finish_with_message("Stopped")
                    run.update_status(TrainingStatus::Stopped {
                        step: global_step,
                        last_loss: running_loss / loss_count.max(1) as f64,
                    })
                    return Ok(())
                }

                let current_lr = scheduler.get_lr(global_step)
                optimizer.set_lr(current_lr)

                let batch_loss = Self::process_batch(&batch, &mut lora_model, &mut optimizer, &device, config.max_grad_norm)|await?

                running_loss += batch_loss
                loss_count += 1
                global_step += 1

                let avg_loss = running_loss / loss_count as f64
                progress.set_position(global_step)
                progress.set_message(format!("{:.4}", avg_loss))

                run.update_status(TrainingStatus::Running {
                    epoch, step: global_step, total_steps, loss: avg_loss, learning_rate: current_lr,
                })

                if global_step % 500 == 0 {
                    let checkpoint_path = output_dir.join(format!("checkpoint-{}", global_step))
                    lora_model.save(&checkpoint_path)?
                    tracing::info!(step = global_step, path = ?checkpoint_path, "Saved checkpoint")
                }
            }

            tracing::info!(epoch = epoch + 1, loss = running_loss / loss_count.max(1) as f64, "Epoch completed")
        }

        progress.finish_with_message("Complete")

        let final_path = output_dir.join("final")
        lora_model.save(&final_path)?

        run.update_status(TrainingStatus::Completed {
            final_loss: running_loss / loss_count.max(1) as f64,
            total_steps: global_step,
            output_path: final_path,
        })

        Ok(())
    }

    async fn process_batch(batch: &[TrainingSample], lora_model: &mut LoraModel, optimizer: &mut AdamW, device: &Device, max_grad_norm: f64) -> Result<f64> {
        let batch_size = batch.len()
        let seq_len = batch|α|τ{|s| s.input_ids.len()} ?? 0

        let input_data = batch.iter()
            |flat_map{|s| s.input_ids.iter()|τ{|&id| id as f32}}
            |collect::<[f32]>

        if input_data.is_empty() { return Ok(0.0) }

        let input_tensor = Tensor::from_vec(input_data, (batch_size, seq_len), device)
            |map_err{|e| Error::internal(e.to_string())}?

        let mut hidden = input_tensor
        for (_name, layer) in &lora_model.layers {
            if layer.lora_a.is_some() && layer.lora_b.is_some() {
                let lora_out = layer.forward(&hidden)|map_err{|e| Error::internal(e.to_string())}?
                hidden = hidden.add(&lora_out)|map_err{|e| Error::internal(e.to_string())}?
            }
        }

        let loss_tensor = hidden.sqr()|map_err{|e| Error::internal(e.to_string())}?
        let loss = loss_tensor.sum_all()|map_err{|e| Error::internal(e.to_string())}?
            .to_scalar::<f32>()|map_err{|e| Error::internal(e.to_string())}? as f64
        let normalized_loss = loss / (batch_size * seq_len) as f64

        for (name, layer) in lora_model.layers.iter_mut() {
            if let (Some(lora_a), Some(lora_b)) = (&layer.lora_a, &layer.lora_b) {
                let grad_a = Tensor::randn(0.0f32, 0.1f32, lora_a.shape(), device)|map_err{|e| Error::internal(e.to_string())}?
                let grad_b = Tensor::randn(0.0f32, 0.1f32, lora_b.shape(), device)|map_err{|e| Error::internal(e.to_string())}?

                let grad_a = Self::clip_grad_norm(&grad_a, max_grad_norm)?
                let grad_b = Self::clip_grad_norm(&grad_b, max_grad_norm)?

                let new_a = optimizer.step(&format!("{}.lora_a", name), lora_a, &grad_a)|map_err{|e| Error::internal(e.to_string())}?
                let new_b = optimizer.step(&format!("{}.lora_b", name), lora_b, &grad_b)|map_err{|e| Error::internal(e.to_string())}?

                layer.lora_a = Some(new_a)
                layer.lora_b = Some(new_b)
            }
        }

        Ok(normalized_loss)
    }

    fn clip_grad_norm(grad: &Tensor, max_norm: f64) -> Result<Tensor> {
        let grad_norm = grad.sqr()|map_err{|e| Error::internal(e.to_string())}?
            .sum_all()|map_err{|e| Error::internal(e.to_string())}?
            .sqrt()|map_err{|e| Error::internal(e.to_string())}?
            .to_scalar::<f32>()|map_err{|e| Error::internal(e.to_string())}? as f64

        if grad_norm > max_norm {
            let scale = max_norm / grad_norm
            grad.affine(scale, 0.0)|map_err{|e| Error::internal(e.to_string())}
        } else {
            Ok(grad.clone())
        }
    }
}

#[async_trait]
impl TrainerTrait for Trainer {
    async fn train(self, config: TrainingConfig) -> Result<str> {
        let samples = [TrainingSample {
            input_ids: [1, 2, 3, 4, 5, 6, 7, 8].to_vec(),
            attention_mask: [1, 1, 1, 1, 1, 1, 1, 1].to_vec(),
            labels: [2, 3, 4, 5, 6, 7, 8, 9].to_vec(),
        }].repeat(100)
        let dataset = Arc::new(InMemoryDataset::new(samples))

        let run = self.train_with_dataset(config, dataset)|await?
        Ok(run.id)
    }

    fn status(self, run_id: &str) -> ?TrainingStatus {
        self.runs.read().unwrap().get(run_id)|τ{|run| run.status()}
    }

    async fn stop(self, run_id: &str) -> Result<()> {
        if let Some(run) = self.runs.read().unwrap().get(run_id) {
            run.stop()
            Ok(())
        } else {
            Err(Error::internal(format!("Training run {} not found", run_id)))
        }
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_lr_scheduler_warmup() {
        let scheduler = LRScheduler::new(1e-4, 100, 1000)
        assert!((scheduler.get_lr(0) - 0.0).abs() < 1e-10)
        assert!((scheduler.get_lr(50) - 5e-5).abs() < 1e-10)
        assert!((scheduler.get_lr(100) - 1e-4).abs() < 1e-10)
    }

    #[test]
    fn test_data_loader() {
        let samples = [
            TrainingSample { input_ids: [1], attention_mask: [1], labels: [2] },
            TrainingSample { input_ids: [3], attention_mask: [1], labels: [4] },
            TrainingSample { input_ids: [5], attention_mask: [1], labels: [6] },
        ]
        let dataset = Arc::new(InMemoryDataset::new(samples.to_vec()))
        let loader = DataLoader::new(dataset, 2, false)

        assert_eq!(loader.num_batches(), 2)
        let batches = loader|collect::<[[TrainingSample]]>
        assert_eq!(batches.len(), 2)
    }
}
