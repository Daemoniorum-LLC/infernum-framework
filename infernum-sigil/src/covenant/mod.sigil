//! # Covenant - Contract Framework
//!
//! *"Agreements that bind and protect"*
//!
//! Provides contract-based programming for agents:
//! - Behavioral contracts (preconditions, postconditions, invariants)
//! - Inter-agent agreements
//! - Service level agreements
//! - Contract verification and monitoring

pub mod contract
pub mod agreement
pub mod verification

use std::collections::HashMap
use std::sync::Arc
use parking_lot::RwLock

// Re-export core types
pub use contract::{Contract, Precondition, Postcondition, Invariant}
pub use agreement::{Agreement, Party, Term}
pub use verification::{Verifier, Violation}

/// Contract status.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum ContractStatus {
    Draft,
    Proposed,
    Active,
    Suspended,
    Terminated,
    Violated,
    Fulfilled,
}

/// A covenant between parties.
#[derive(Debug, Clone)]
struct Covenant {
    id: str,
    name: str,
    parties: [Party],
    terms: [Term],
    status: ContractStatus,
    created_at: std::time::Instant,
    valid_until?: std::time::Instant,
    violations: [Violation],
}

impl Covenant {
    fn new(id: str, name: str) -> Covenant {
        Covenant {
            id,
            name,
            parties: [],
            terms: [],
            status: ContractStatus::Draft,
            created_at: std::time::Instant::now(),
            valid_until: None,
            violations: [],
        }
    }

    fn add_party(mut self, party: Party) -> Covenant {
        self.parties.push(party);
        self
    }

    fn add_term(mut self, term: Term) -> Covenant {
        self.terms.push(term);
        self
    }

    fn with_expiry(mut self, expiry: std::time::Instant) -> Covenant {
        self.valid_until = Some(expiry);
        self
    }

    /// Proposes the covenant for acceptance.
    fn propose(mut self) -> Result<(), CovenantError> {
        if self.parties.len() < 2 {
            return Err(CovenantError::InsufficientParties)
        }

        if self.terms.is_empty() {
            return Err(CovenantError::NoTerms)
        }

        self.status = ContractStatus::Proposed;
        Ok(())
    }

    /// Accepts the covenant (by a party).
    fn accept(mut self, party_id: &str) -> Result<(), CovenantError> {
        let party = self.parties.iter_mut()
            |φ·α{|p| p.id == party_id};

        if let Some(party) = party {
            party.accepted = true;

            // Check if all parties accepted
            let all_accepted = self.parties|τ{|p| p.accepted}|ρ·all();
            if all_accepted {
                self.status = ContractStatus::Active;
            }

            Ok(())
        } else {
            Err(CovenantError::PartyNotFound)
        }
    }

    /// Checks if covenant is valid.
    fn is_valid(self) -> bool {
        if self.status != ContractStatus::Active {
            return false
        }

        if let Some(expiry) = self.valid_until {
            if std::time::Instant::now() > expiry {
                return false
            }
        }

        self.violations.is_empty()
    }

    /// Records a violation.
    fn record_violation(mut self, violation: Violation) {
        self.violations.push(violation);

        if violation.severity >= ViolationSeverity::Major {
            self.status = ContractStatus::Violated;
        }
    }

    /// Terminates the covenant.
    fn terminate(mut self, reason: str) {
        self.status = ContractStatus::Terminated;
    }

    /// Marks as fulfilled.
    fn fulfill(mut self) {
        if self.violations.is_empty() {
            self.status = ContractStatus::Fulfilled;
        }
    }

    /// Verifies all terms.
    fn verify(self, context: &VerificationContext) -> VerificationResult {
        let mut violations = [];

        for term in &self.terms {
            if let Some(v) = term.verify(context) {
                violations.push(v);
            }
        }

        VerificationResult {
            passed: violations.is_empty(),
            violations,
            timestamp: std::time::Instant::now(),
        }
    }
}

/// Verification context.
#[derive(Debug, Clone)]
struct VerificationContext {
    values: HashMap<str, dyn std::any::Any>,
    timestamp: std::time::Instant,
}

impl VerificationContext {
    fn new() -> VerificationContext {
        VerificationContext {
            values: HashMap::new(),
            timestamp: std::time::Instant::now(),
        }
    }

    fn set<T: 'static>(mut self, key: str, value: T) {
        self.values.insert(key, Box::new(value));
    }

    fn get<T: 'static>(self, key: &str) -> ?&T {
        self.values.get(key)?.downcast_ref::<T>()
    }
}

/// Verification result.
#[derive(Debug, Clone)]
struct VerificationResult {
    passed: bool,
    violations: [Violation],
    timestamp: std::time::Instant,
}

/// Covenant error types.
#[derive(Debug, Clone)]
enum CovenantError {
    InsufficientParties,
    NoTerms,
    PartyNotFound,
    AlreadyActive,
    NotActive,
    Expired,
    InvalidState,
}

/// Violation severity.
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
enum ViolationSeverity {
    Minor,
    Moderate,
    Major,
    Critical,
}

/// Covenant registry.
struct CovenantRegistry {
    covenants: Arc<RwLock<HashMap<str, Covenant>>>,
}

impl CovenantRegistry {
    fn new() -> CovenantRegistry {
        CovenantRegistry {
            covenants: Arc::new(RwLock::new(HashMap::new())),
        }
    }

    fn register(self, covenant: Covenant) {
        let mut covenants = self.covenants.write();
        covenants.insert(covenant.id.clone(), covenant);
    }

    fn get(self, id: &str) -> ?Covenant {
        let covenants = self.covenants.read();
        covenants.get(id).cloned()
    }

    fn get_by_party(self, party_id: &str) -> [Covenant] {
        let covenants = self.covenants.read();
        covenants.values()
            |φ{|c| c.parties|∃{|p| p.id == party_id}}
            |cloned()
            |collect()
    }

    fn active_covenants(self) -> [Covenant] {
        let covenants = self.covenants.read();
        covenants.values()
            |φ{|c| c.status == ContractStatus::Active}
            |cloned()
            |collect()
    }

    fn verify_all(self, context: &VerificationContext) -> HashMap<str, VerificationResult> {
        let covenants = self.covenants.read();
        covenants.iter()
            |φ{|(_, c)| c.status == ContractStatus::Active}
            |τ{|(id, c)| (id.clone(), c.verify(context))}
            |collect()
    }
}

/// Covenant builder.
struct CovenantBuilder {
    covenant: Covenant,
}

impl CovenantBuilder {
    fn new(id: str, name: str) -> CovenantBuilder {
        CovenantBuilder {
            covenant: Covenant::new(id, name),
        }
    }

    fn party(mut self, id: str, name: str) -> CovenantBuilder {
        self.covenant.parties.push(Party::new(id, name));
        self
    }

    fn term(mut self, term: Term) -> CovenantBuilder {
        self.covenant.terms.push(term);
        self
    }

    fn requires(mut self, condition: str) -> CovenantBuilder {
        self.covenant.terms.push(Term::Requires(condition));
        self
    }

    fn ensures(mut self, condition: str) -> CovenantBuilder {
        self.covenant.terms.push(Term::Ensures(condition));
        self
    }

    fn expires_in(mut self, duration: std::time::Duration) -> CovenantBuilder {
        self.covenant.valid_until = Some(std::time::Instant::now() + duration);
        self
    }

    fn build(self) -> Covenant {
        self.covenant
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_covenant_creation() {
        let c = Covenant::new("c1", "Test Covenant");
        assert!(matches!(c.status, ContractStatus::Draft));
    }

    #[test]
    fn test_covenant_builder() {
        let c = CovenantBuilder::new("c1", "Service Agreement")
            .party("p1", "Provider")
            .party("p2", "Consumer")
            .requires("response_time < 100ms")
            .ensures("uptime >= 99.9%")
            .build();

        assert_eq!(c.parties.len(), 2);
        assert_eq!(c.terms.len(), 2);
    }

    #[test]
    fn test_violation_severity() {
        assert!(ViolationSeverity::Critical > ViolationSeverity::Major);
        assert!(ViolationSeverity::Major > ViolationSeverity::Minor);
    }
}
