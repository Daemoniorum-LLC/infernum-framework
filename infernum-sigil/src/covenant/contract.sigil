//! Behavioral contracts (Design by Contract).

use std::collections::HashMap

/// A behavioral contract for functions/methods.
#[derive(Debug, Clone)]
struct Contract {
    name: str,
    preconditions: [Precondition],
    postconditions: [Postcondition],
    invariants: [Invariant],
}

/// A precondition that must hold before execution.
#[derive(Debug, Clone)]
struct Precondition {
    name: str,
    condition: str,
    message: str,
}

impl Precondition {
    fn new(condition: str) -> Precondition {
        Precondition {
            name: "".to_string(),
            condition: condition.clone(),
            message: format!("Precondition failed: {}", condition),
        }
    }

    fn with_name(mut self, name: str) -> Precondition {
        self.name = name;
        self
    }

    fn with_message(mut self, message: str) -> Precondition {
        self.message = message;
        self
    }

    fn check<T>(self, value: &T, predicate: fn(&T) -> bool) -> Result<(), ContractViolation> {
        if predicate(value) {
            Ok(())
        } else {
            Err(ContractViolation {
                violation_type: ViolationType::Precondition,
                message: self.message,
                condition: self.condition,
            })
        }
    }
}

/// A postcondition that must hold after execution.
#[derive(Debug, Clone)]
struct Postcondition {
    name: str,
    condition: str,
    message: str,
}

impl Postcondition {
    fn new(condition: str) -> Postcondition {
        Postcondition {
            name: "".to_string(),
            condition: condition.clone(),
            message: format!("Postcondition failed: {}", condition),
        }
    }

    fn with_name(mut self, name: str) -> Postcondition {
        self.name = name;
        self
    }

    fn with_message(mut self, message: str) -> Postcondition {
        self.message = message;
        self
    }

    fn check<T>(self, value: &T, predicate: fn(&T) -> bool) -> Result<(), ContractViolation> {
        if predicate(value) {
            Ok(())
        } else {
            Err(ContractViolation {
                violation_type: ViolationType::Postcondition,
                message: self.message,
                condition: self.condition,
            })
        }
    }
}

/// An invariant that must always hold.
#[derive(Debug, Clone)]
struct Invariant {
    name: str,
    condition: str,
    message: str,
}

impl Invariant {
    fn new(condition: str) -> Invariant {
        Invariant {
            name: "".to_string(),
            condition: condition.clone(),
            message: format!("Invariant violated: {}", condition),
        }
    }

    fn with_name(mut self, name: str) -> Invariant {
        self.name = name;
        self
    }

    fn check<T>(self, value: &T, predicate: fn(&T) -> bool) -> Result<(), ContractViolation> {
        if predicate(value) {
            Ok(())
        } else {
            Err(ContractViolation {
                violation_type: ViolationType::Invariant,
                message: self.message,
                condition: self.condition,
            })
        }
    }
}

/// Types of contract violations.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum ViolationType {
    Precondition,
    Postcondition,
    Invariant,
}

/// A contract violation.
#[derive(Debug, Clone)]
struct ContractViolation {
    violation_type: ViolationType,
    message: str,
    condition: str,
}

impl Contract {
    fn new(name: str) -> Contract {
        Contract {
            name,
            preconditions: [],
            postconditions: [],
            invariants: [],
        }
    }

    fn requires(mut self, condition: str) -> Contract {
        self.preconditions.push(Precondition::new(condition));
        self
    }

    fn requires_with_message(mut self, condition: str, message: str) -> Contract {
        self.preconditions.push(Precondition::new(condition).with_message(message));
        self
    }

    fn ensures(mut self, condition: str) -> Contract {
        self.postconditions.push(Postcondition::new(condition));
        self
    }

    fn ensures_with_message(mut self, condition: str, message: str) -> Contract {
        self.postconditions.push(Postcondition::new(condition).with_message(message));
        self
    }

    fn maintains(mut self, condition: str) -> Contract {
        self.invariants.push(Invariant::new(condition));
        self
    }

    /// Checks all preconditions.
    fn check_preconditions<T>(self, value: &T, predicates: &[fn(&T) -> bool]) -> Result<(), ContractViolation> {
        for (pre, pred) in self.preconditions.iter().zip(predicates.iter()) {
            pre.check(value, *pred)?;
        }
        Ok(())
    }

    /// Checks all postconditions.
    fn check_postconditions<T>(self, value: &T, predicates: &[fn(&T) -> bool]) -> Result<(), ContractViolation> {
        for (post, pred) in self.postconditions.iter().zip(predicates.iter()) {
            post.check(value, *pred)?;
        }
        Ok(())
    }

    /// Checks all invariants.
    fn check_invariants<T>(self, value: &T, predicates: &[fn(&T) -> bool]) -> Result<(), ContractViolation> {
        for (inv, pred) in self.invariants.iter().zip(predicates.iter()) {
            inv.check(value, *pred)?;
        }
        Ok(())
    }
}

/// Contract-wrapped function executor.
struct ContractedFunction<F, A, R> {
    function: F,
    contract: Contract,
    pre_checks: [fn(&A) -> bool],
    post_checks: [fn(&R) -> bool],
}

impl<F, A, R> ContractedFunction<F, A, R>
where
    F: Fn(A) -> R,
{
    fn new(function: F, contract: Contract) -> ContractedFunction<F, A, R> {
        ContractedFunction {
            function,
            contract,
            pre_checks: [],
            post_checks: [],
        }
    }

    fn with_pre_check(mut self, check: fn(&A) -> bool) -> ContractedFunction<F, A, R> {
        self.pre_checks.push(check);
        self
    }

    fn with_post_check(mut self, check: fn(&R) -> bool) -> ContractedFunction<F, A, R> {
        self.post_checks.push(check);
        self
    }

    fn call(self, arg: A) -> Result<R, ContractViolation> {
        // Check preconditions
        self.contract.check_preconditions(&arg, &self.pre_checks)?;

        // Execute function
        let result = (self.function)(arg);

        // Check postconditions
        self.contract.check_postconditions(&result, &self.post_checks)?;

        Ok(result)
    }
}

/// Type contracts for compile-time checking (marker types).
mod type_contracts {
    /// Marker for non-null values.
    struct NonNull<T>(T);

    impl<T> NonNull<T> {
        fn new(value: T) -> NonNull<T> {
            NonNull(value)
        }

        fn get(self) -> &T {
            &self.0
        }
    }

    /// Marker for positive numbers.
    struct Positive<T>(T);

    /// Marker for non-empty collections.
    struct NonEmpty<T>(T);

    /// Marker for bounded values.
    struct Bounded<T, const MIN: i64, const MAX: i64>(T);
}

/// Contract assertions macro-like functions.
fn require(condition: bool, message: &str) -> Result<(), ContractViolation> {
    if condition {
        Ok(())
    } else {
        Err(ContractViolation {
            violation_type: ViolationType::Precondition,
            message: message.to_string(),
            condition: "".to_string(),
        })
    }
}

fn ensure(condition: bool, message: &str) -> Result<(), ContractViolation> {
    if condition {
        Ok(())
    } else {
        Err(ContractViolation {
            violation_type: ViolationType::Postcondition,
            message: message.to_string(),
            condition: "".to_string(),
        })
    }
}

fn assert_invariant(condition: bool, message: &str) -> Result<(), ContractViolation> {
    if condition {
        Ok(())
    } else {
        Err(ContractViolation {
            violation_type: ViolationType::Invariant,
            message: message.to_string(),
            condition: "".to_string(),
        })
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_precondition() {
        let pre = Precondition::new("x > 0");
        let result = pre.check(&5, |x| *x > 0);
        assert!(result.is_ok());
    }

    #[test]
    fn test_precondition_failure() {
        let pre = Precondition::new("x > 0");
        let result = pre.check(&-1, |x| *x > 0);
        assert!(result.is_err());
    }

    #[test]
    fn test_contract_builder() {
        let c = Contract::new("divide")
            .requires("divisor != 0")
            .ensures("result * divisor == dividend");

        assert_eq!(c.preconditions.len(), 1);
        assert_eq!(c.postconditions.len(), 1);
    }

    #[test]
    fn test_require_function() {
        assert!(require(true, "should pass").is_ok());
        assert!(require(false, "should fail").is_err());
    }
}
