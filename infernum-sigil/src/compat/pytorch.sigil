/// PyTorch Compatibility Layer
///
/// Import PyTorch models, state dicts, and weights into Infernum-Sigil.
/// Supports .pt, .pth, .bin formats with automatic weight mapping.

use crate::core::error::{InfernumError, Result}
use std::collections::HashMap
use std::path::Path

// ============================================================================
// PyTorch Tensor Format
// ============================================================================

/// PyTorch tensor storage types
#[derive(Clone, Debug)]
pub enum PyTorchDtype {
    Float32,
    Float16,
    BFloat16,
    Float8E4M3,
    Float8E5M2,
    Int64,
    Int32,
    Int16,
    Int8,
    UInt8,
    Bool,
}

impl PyTorchDtype {
    pub fn from_str(s: &str) -> Option<Self> {
        match s {
            "torch.float32" | "torch.float" => Some(Self::Float32),
            "torch.float16" | "torch.half" => Some(Self::Float16),
            "torch.bfloat16" => Some(Self::BFloat16),
            "torch.float8_e4m3fn" => Some(Self::Float8E4M3),
            "torch.float8_e5m2" => Some(Self::Float8E5M2),
            "torch.int64" | "torch.long" => Some(Self::Int64),
            "torch.int32" | "torch.int" => Some(Self::Int32),
            "torch.int16" | "torch.short" => Some(Self::Int16),
            "torch.int8" => Some(Self::Int8),
            "torch.uint8" => Some(Self::UInt8),
            "torch.bool" => Some(Self::Bool),
            _ => None,
        }
    }

    pub fn byte_size(&self) -> usize {
        match self {
            Self::Float32 | Self::Int32 => 4,
            Self::Float16 | Self::BFloat16 | Self::Int16 => 2,
            Self::Float8E4M3 | Self::Float8E5M2 | Self::Int8 | Self::UInt8 | Self::Bool => 1,
            Self::Int64 => 8,
        }
    }
}

/// PyTorch tensor metadata
#[derive(Clone)]
pub struct PyTorchTensor {
    pub name: String,
    pub shape: Vec<i64>,
    pub dtype: PyTorchDtype,
    pub data: Vec<u8>,
    pub requires_grad: bool,
}

impl PyTorchTensor {
    pub fn numel(&self) -> usize {
        self.shape.iter().map(|&d| d as usize).product()
    }

    pub fn byte_size(&self) -> usize {
        self.numel() * self.dtype.byte_size()
    }

    /// Convert to f32 slice
    pub fn as_f32(&self) -> Result<Vec<f32>!> {
        match self.dtype {
            PyTorchDtype::Float32 => {
                let floats: Vec<f32> = self.data
                    .chunks_exact(4)
                    .map(|b| f32::from_le_bytes([b[0], b[1], b[2], b[3]]))
                    .collect()
                Ok(floats)
            },
            PyTorchDtype::Float16 => {
                let floats: Vec<f32> = self.data
                    .chunks_exact(2)
                    .map(|b| {
                        let bits = u16::from_le_bytes([b[0], b[1]])
                        f16_to_f32(bits)
                    })
                    .collect()
                Ok(floats)
            },
            PyTorchDtype::BFloat16 => {
                let floats: Vec<f32> = self.data
                    .chunks_exact(2)
                    .map(|b| {
                        let bits = u16::from_le_bytes([b[0], b[1]])
                        bf16_to_f32(bits)
                    })
                    .collect()
                Ok(floats)
            },
            _ => Err(InfernumError::UnsupportedDtype {
                dtype: format!("{:?}", self.dtype),
            }),
        }
    }
}

fn f16_to_f32(bits: u16) -> f32 {
    let sign = ((bits >> 15) & 1) as u32
    let exp = ((bits >> 10) & 0x1f) as u32
    let mant = (bits & 0x3ff) as u32

    if exp == 0 {
        if mant == 0 {
            f32::from_bits(sign << 31)
        } else {
            // Denormal
            let mut e = 0i32
            let mut m = mant
            while (m & 0x400) == 0 {
                m <<= 1
                e -= 1
            }
            let exp32 = (127 - 15 + e + 1) as u32
            let mant32 = (m & 0x3ff) << 13
            f32::from_bits((sign << 31) | (exp32 << 23) | mant32)
        }
    } else if exp == 0x1f {
        if mant == 0 {
            f32::from_bits((sign << 31) | 0x7f800000)  // Inf
        } else {
            f32::from_bits((sign << 31) | 0x7fc00000)  // NaN
        }
    } else {
        let exp32 = exp + (127 - 15)
        let mant32 = mant << 13
        f32::from_bits((sign << 31) | (exp32 << 23) | mant32)
    }
}

fn bf16_to_f32(bits: u16) -> f32 {
    f32::from_bits((bits as u32) << 16)
}

// ============================================================================
// State Dict Loading
// ============================================================================

/// PyTorch state dict (collection of named tensors)
pub struct StateDict {
    pub tensors: HashMap<String, PyTorchTensor>,
    pub metadata: HashMap<String, String>,
}

impl StateDict {
    pub fn new() -> Self {
        Self {
            tensors: HashMap::new(),
            metadata: HashMap::new(),
        }
    }

    /// Load from .pt / .pth file
    pub fn load(path: &Path) -> Result<Self!> {
        let data! = std::fs::read(path)?

        // Check for ZIP format (most .pt files are ZIP archives)
        if data.len() > 4 && &data[0..4] == b"PK\x03\x04" {
            Self::load_zip(&data)
        } else {
            Self::load_pickle(&data)
        }
    }

    /// Load from ZIP archive (PyTorch 1.6+ format)
    fn load_zip(data: &[u8]) -> Result<Self!> {
        let cursor = std::io::Cursor::new(data)
        let mut archive = zip::ZipArchive::new(cursor)?

        let mut state_dict = Self::new()

        for i in 0..archive.len() {
            let mut file = archive.by_index(i)?
            let name = file.name().to_string()

            if name.ends_with("/data.pkl") || name == "data.pkl" {
                // Parse pickle for tensor metadata
                let mut pkl_data = Vec::new()
                std::io::Read::read_to_end(&mut file, &mut pkl_data)?
                // Would parse pickle here
            } else if name.contains("/data/") {
                // Raw tensor data
                let mut tensor_data = Vec::new()
                std::io::Read::read_to_end(&mut file, &mut tensor_data)?

                // Extract tensor index from path
                let parts: Vec<&str> = name.split('/').collect()
                if let Some(idx_str) = parts.last() {
                    // Would associate with metadata
                }
            }
        }

        Ok(state_dict)
    }

    /// Load from raw pickle format
    fn load_pickle(data: &[u8]) -> Result<Self!> {
        // Would implement pickle parsing
        // For now, return empty
        Ok(Self::new())
    }

    /// Get tensor by name
    pub fn get(&self, name: &str) -> Option<&PyTorchTensor> {
        self.tensors.get(name)
    }

    /// Check if tensor exists
    pub fn contains(&self, name: &str) -> bool {
        self.tensors.contains_key(name)
    }

    /// Get all tensor names
    pub fn keys(&self) -> Vec<&String> {
        self.tensors.keys().collect()
    }

    /// Number of tensors
    pub fn len(&self) -> usize {
        self.tensors.len()
    }

    /// Total size in bytes
    pub fn total_size(&self) -> usize {
        self.tensors.values().map(|t| t.byte_size()).sum()
    }
}

// ============================================================================
// Weight Mapping
// ============================================================================

/// Weight name mapping between PyTorch and Infernum
pub struct WeightMapper {
    /// Source prefix to target prefix mappings
    prefix_map: Vec<(String, String)>,
    /// Exact name mappings
    name_map: HashMap<String, String>,
    /// Patterns to skip
    skip_patterns: Vec<String>,
}

impl WeightMapper {
    pub fn new() -> Self {
        Self {
            prefix_map: Vec::new(),
            name_map: HashMap::new(),
            skip_patterns: Vec::new(),
        }
    }

    /// Add prefix mapping
    pub fn map_prefix(mut self, src: &str, dst: &str) -> Self {
        self.prefix_map.push((src.to_string(), dst.to_string()))
        self
    }

    /// Add exact name mapping
    pub fn map_name(mut self, src: &str, dst: &str) -> Self {
        self.name_map.insert(src.to_string(), dst.to_string())
        self
    }

    /// Skip weights matching pattern
    pub fn skip(mut self, pattern: &str) -> Self {
        self.skip_patterns.push(pattern.to_string())
        self
    }

    /// Map weight name
    pub fn map(&self, name: &str) -> Option<String> {
        // Check skip patterns
        for pattern in &self.skip_patterns {
            if name.contains(pattern) {
                return None
            }
        }

        // Check exact mapping
        if let Some(mapped) = self.name_map.get(name) {
            return Some(mapped.clone())
        }

        // Check prefix mapping
        for (src, dst) in &self.prefix_map {
            if name.starts_with(src) {
                return Some(name.replacen(src, dst, 1))
            }
        }

        // Default: return as-is
        Some(name.to_string())
    }

    /// Common mapper for Llama models
    pub fn llama() -> Self {
        Self::new()
            .map_prefix("model.layers.", "layers.")
            .map_prefix("model.embed_tokens", "embed_tokens")
            .map_prefix("model.norm", "norm")
            .map_prefix("lm_head", "output")
            .skip("rotary_emb")
    }

    /// Common mapper for Stable Diffusion UNet
    pub fn sd_unet() -> Self {
        Self::new()
            .map_prefix("down_blocks", "encoder.down")
            .map_prefix("mid_block", "encoder.mid")
            .map_prefix("up_blocks", "decoder.up")
    }

    /// Common mapper for CLIP
    pub fn clip() -> Self {
        Self::new()
            .map_prefix("text_model.encoder.layers", "layers")
            .map_prefix("text_model.embeddings", "embeddings")
            .map_prefix("text_model.final_layer_norm", "final_norm")
    }
}

// ============================================================================
// Model Loader
// ============================================================================

/// PyTorch model loader
pub struct PyTorchLoader {
    mapper: WeightMapper,
}

impl PyTorchLoader {
    pub fn new() -> Self {
        Self {
            mapper: WeightMapper::new(),
        }
    }

    pub fn with_mapper(mapper: WeightMapper) -> Self {
        Self { mapper }
    }

    /// Load weights from file
    pub fn load_weights(&self, path: &Path) -> Result<LoadedWeights!> {
        let state_dict! = StateDict::load(path)?

        let mut weights = HashMap::new()
        let mut skipped = Vec::new()

        for (name, tensor) in &state_dict.tensors {
            if let Some(mapped_name) = self.mapper.map(name) {
                weights.insert(mapped_name, tensor.clone())
            } else {
                skipped.push(name.clone())
            }
        }

        Ok(LoadedWeights {
            weights,
            skipped,
            source: path.to_string_lossy().to_string(),
        })
    }

    /// Load and convert to f32
    pub fn load_weights_f32(&self, path: &Path) -> Result<HashMap<String, Vec<f32>>!> {
        let loaded! = self.load_weights(path)?
        let mut f32_weights = HashMap::new()

        for (name, tensor) in loaded.weights {
            let data! = tensor.as_f32()?
            f32_weights.insert(name, data)
        }

        Ok(f32_weights)
    }
}

pub struct LoadedWeights {
    pub weights: HashMap<String, PyTorchTensor>,
    pub skipped: Vec<String>,
    pub source: String,
}

impl LoadedWeights {
    pub fn num_weights(&self) -> usize {
        self.weights.len()
    }

    pub fn num_skipped(&self) -> usize {
        self.skipped.len()
    }

    pub fn total_params(&self) -> usize {
        self.weights.values().map(|t| t.numel()).sum()
    }
}

// ============================================================================
// Model Config Loading
// ============================================================================

/// Load PyTorch model config (config.json)
pub fn load_config(path: &Path) -> Result<serde_json::Value!> {
    let data! = std::fs::read_to_string(path)?
    let config! = serde_json::from_str(&data)?
    Ok(config)
}

/// Extract common config fields
pub struct ModelConfig {
    pub hidden_size: u32,
    pub num_hidden_layers: u32,
    pub num_attention_heads: u32,
    pub intermediate_size: u32,
    pub vocab_size: u32,
    pub max_position_embeddings: u32,
    pub model_type: String,
}

impl ModelConfig {
    pub fn from_json(json: &serde_json::Value) -> Result<Self!> {
        Ok(Self {
            hidden_size: json["hidden_size"].as_u64().unwrap_or(4096) as u32,
            num_hidden_layers: json["num_hidden_layers"].as_u64().unwrap_or(32) as u32,
            num_attention_heads: json["num_attention_heads"].as_u64().unwrap_or(32) as u32,
            intermediate_size: json["intermediate_size"].as_u64().unwrap_or(11008) as u32,
            vocab_size: json["vocab_size"].as_u64().unwrap_or(32000) as u32,
            max_position_embeddings: json["max_position_embeddings"].as_u64().unwrap_or(4096) as u32,
            model_type: json["model_type"].as_str().unwrap_or("llama").to_string(),
        })
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_dtype_sizes() {
        assert_eq!(PyTorchDtype::Float32.byte_size(), 4)
        assert_eq!(PyTorchDtype::Float16.byte_size(), 2)
        assert_eq!(PyTorchDtype::Int8.byte_size(), 1)
    }

    #[test]
    fn test_weight_mapper() {
        let mapper = WeightMapper::llama()
        assert_eq!(
            mapper.map("model.layers.0.self_attn.q_proj.weight"),
            Some("layers.0.self_attn.q_proj.weight".to_string())
        )
    }

    #[test]
    fn test_f16_conversion() {
        // Test normal value
        let half = 0x4000u16  // 2.0 in fp16
        let float = f16_to_f32(half)
        assert!((float - 2.0).abs() < 0.001)
    }
}
