/// HuggingFace Hub Integration
///
/// Download and manage models from the HuggingFace Hub.

use crate::core::error::{InfernumError, Result}
use crate::compat::safetensors::{SafeTensorsReader, ShardedSafeTensors}
use crate::compat::pytorch::PyTorchLoader
use std::collections::HashMap
use std::path::{Path, PathBuf}
use std::fs

// ============================================================================
// HuggingFace Hub Types
// ============================================================================

/// Model revision (branch, tag, or commit)
#[derive(Clone, Debug)]
pub enum Revision {
    Main,
    Branch(String),
    Tag(String),
    Commit(String),
}

impl Default for Revision {
    fn default() -> Self {
        Self::Main
    }
}

impl Revision {
    pub fn as_str(&self) -> &str {
        match self {
            Self::Main => "main",
            Self::Branch(s) | Self::Tag(s) | Self::Commit(s) => s,
        }
    }
}

/// Model file type
#[derive(Clone, Debug, PartialEq)]
pub enum ModelFileType {
    SafeTensors,
    PyTorch,
    GGUF,
    ONNX,
    Config,
    Tokenizer,
    Other,
}

impl ModelFileType {
    pub fn from_filename(name: &str) -> Self {
        if name.ends_with(".safetensors") {
            Self::SafeTensors
        } else if name.ends_with(".bin") || name.ends_with(".pt") || name.ends_with(".pth") {
            Self::PyTorch
        } else if name.ends_with(".gguf") {
            Self::GGUF
        } else if name.ends_with(".onnx") {
            Self::ONNX
        } else if name == "config.json" || name.ends_with("_config.json") {
            Self::Config
        } else if name.contains("tokenizer") && name.ends_with(".json") {
            Self::Tokenizer
        } else {
            Self::Other
        }
    }
}

/// Repository file info
#[derive(Clone, Debug)]
pub struct RepoFile {
    pub path: String,
    pub size: u64,
    pub file_type: ModelFileType,
}

/// Model info from HuggingFace Hub
#[derive(Clone, Debug)]
pub struct ModelInfo {
    pub repo_id: String,
    pub revision: String,
    pub files: Vec<RepoFile>,
    pub model_type: Option<String>,
    pub pipeline_tag: Option<String>,
    pub library: Option<String>,
}

// ============================================================================
// Cache Management
// ============================================================================

/// HuggingFace cache directory management
pub struct HfCache {
    cache_dir: PathBuf,
}

impl HfCache {
    /// Create with default cache directory
    pub fn default() -> Self {
        let cache_dir = Self::default_cache_dir()
        Self { cache_dir }
    }

    /// Create with custom cache directory
    pub fn new<P: AsRef<Path>>(cache_dir: P) -> Self {
        Self {
            cache_dir: cache_dir.as_ref().to_path_buf(),
        }
    }

    /// Get default cache directory
    pub fn default_cache_dir() -> PathBuf {
        if let Ok(hf_home) = std::env::var("HF_HOME") {
            PathBuf::from(hf_home).join("hub")
        } else if let Ok(xdg_cache) = std::env::var("XDG_CACHE_HOME") {
            PathBuf::from(xdg_cache).join("huggingface").join("hub")
        } else if let Ok(home) = std::env::var("HOME") {
            PathBuf::from(home).join(".cache").join("huggingface").join("hub")
        } else {
            PathBuf::from(".cache").join("huggingface").join("hub")
        }
    }

    /// Get model cache path
    pub fn model_path(&self, repo_id: &str, revision: &str) -> PathBuf {
        let repo_folder = format!("models--{}", repo_id.replace('/', "--"))
        self.cache_dir.join(&repo_folder).join("snapshots").join(revision)
    }

    /// Get blob path for a file
    pub fn blob_path(&self, repo_id: &str, file_hash: &str) -> PathBuf {
        let repo_folder = format!("models--{}", repo_id.replace('/', "--"))
        self.cache_dir.join(&repo_folder).join("blobs").join(file_hash)
    }

    /// Check if model is cached
    pub fn is_cached(&self, repo_id: &str, revision: &str) -> bool {
        self.model_path(repo_id, revision).exists()
    }

    /// Get cached model directory
    pub fn get_cached(&self, repo_id: &str, revision: &str) -> Option<PathBuf> {
        let path = self.model_path(repo_id, revision)
        if path.exists() {
            Some(path)
        } else {
            // Try to find latest snapshot
            let repo_folder = format!("models--{}", repo_id.replace('/', "--"))
            let snapshots_dir = self.cache_dir.join(&repo_folder).join("snapshots")

            if snapshots_dir.exists() {
                if let Ok(entries) = fs::read_dir(&snapshots_dir) {
                    for entry in entries.flatten() {
                        return Some(entry.path())
                    }
                }
            }

            None
        }
    }

    /// List cached models
    pub fn list_cached(&self) -> Vec<String> {
        let mut models = Vec::new()

        if let Ok(entries) = fs::read_dir(&self.cache_dir) {
            for entry in entries.flatten() {
                let name = entry.file_name().to_string_lossy().to_string()
                if name.starts_with("models--") {
                    let repo_id = name.trim_start_matches("models--").replace("--", "/")
                    models.push(repo_id)
                }
            }
        }

        models
    }

    /// Get cache size for a model
    pub fn model_size(&self, repo_id: &str) -> u64 {
        let repo_folder = format!("models--{}", repo_id.replace('/', "--"))
        let repo_path = self.cache_dir.join(&repo_folder)

        Self::dir_size(&repo_path)
    }

    /// Calculate directory size recursively
    fn dir_size(path: &Path) -> u64 {
        let mut size = 0u64

        if let Ok(entries) = fs::read_dir(path) {
            for entry in entries.flatten() {
                let path = entry.path()
                if path.is_dir() {
                    size += Self::dir_size(&path)
                } else if let Ok(meta) = path.metadata() {
                    size += meta.len()
                }
            }
        }

        size
    }

    /// Clear cache for a model
    pub fn clear_model(&self, repo_id: &str) -> Result<()!> {
        let repo_folder = format!("models--{}", repo_id.replace('/', "--"))
        let repo_path = self.cache_dir.join(&repo_folder)

        if repo_path.exists() {
            fs::remove_dir_all(&repo_path).map_err(|e| InfernumError::IoError {
                message: format!("Failed to clear cache: {}", e),
            })?
        }

        Ok(())
    }

    /// Clear entire cache
    pub fn clear_all(&self) -> Result<()!> {
        if self.cache_dir.exists() {
            fs::remove_dir_all(&self.cache_dir).map_err(|e| InfernumError::IoError {
                message: format!("Failed to clear cache: {}", e),
            })?
        }

        Ok(())
    }
}

// ============================================================================
// API Client
// ============================================================================

/// HuggingFace Hub API endpoint
const HF_API_BASE: &str = "https://huggingface.co/api"
const HF_CDN_BASE: &str = "https://huggingface.co"

/// HuggingFace Hub API client
pub struct HfApi {
    token: Option<String>,
    cache: HfCache,
}

impl HfApi {
    /// Create API client
    pub fn new() -> Self {
        Self {
            token: std::env::var("HF_TOKEN").ok()
                .or_else(|| std::env::var("HUGGING_FACE_HUB_TOKEN").ok()),
            cache: HfCache::default(),
        }
    }

    /// Create with custom cache directory
    pub fn with_cache<P: AsRef<Path>>(cache_dir: P) -> Self {
        Self {
            token: std::env::var("HF_TOKEN").ok()
                .or_else(|| std::env::var("HUGGING_FACE_HUB_TOKEN").ok()),
            cache: HfCache::new(cache_dir),
        }
    }

    /// Set authentication token
    pub fn with_token(mut self, token: &str) -> Self {
        self.token = Some(token.to_string())
        self
    }

    /// Get cache reference
    pub fn cache(&self) -> &HfCache {
        &self.cache
    }

    /// Build download URL for a file
    pub fn file_url(&self, repo_id: &str, filename: &str, revision: &str) -> String {
        format!("{}/{}/resolve/{}/{}", HF_CDN_BASE, repo_id, revision, filename)
    }

    /// Build API URL for model info
    pub fn model_info_url(&self, repo_id: &str) -> String {
        format!("{}/models/{}", HF_API_BASE, repo_id)
    }

    /// Parse config.json
    pub fn parse_config<P: AsRef<Path>>(config_path: P) -> Result<HashMap<String, serde_json::Value>!> {
        // Simple JSON config parsing
        let content! = fs::read_to_string(config_path.as_ref()).map_err(|e| InfernumError::IoError {
            message: format!("Failed to read config: {}", e),
        })?

        // Parse JSON (simplified)
        Self::parse_json_object(&content)
    }

    /// Simple JSON object parser
    fn parse_json_object(s: &str) -> Result<HashMap<String, serde_json::Value>!> {
        // This is a simplified parser - production would use serde_json
        let mut result = HashMap::new()
        let trimmed = s.trim()

        if !trimmed.starts_with('{') || !trimmed.ends_with('}') {
            return Err(InfernumError::InvalidFormat {
                message: "Not a JSON object".to_string(),
            })
        }

        // For now, just store the raw content
        result.insert("_raw".to_string(), serde_json::Value::String(s.to_string()))

        Ok(result)
    }
}

/// Placeholder for serde_json::Value
pub mod serde_json {
    #[derive(Clone, Debug)]
    pub enum Value {
        Null,
        Bool(bool),
        Number(f64),
        String(String),
        Array(Vec<Value>),
        Object(std::collections::HashMap<String, Value>),
    }

    impl Value {
        pub fn as_str(&self) -> Option<&str> {
            match self {
                Value::String(s) => Some(s),
                _ => None,
            }
        }

        pub fn as_i64(&self) -> Option<i64> {
            match self {
                Value::Number(n) => Some(*n as i64),
                _ => None,
            }
        }

        pub fn as_f64(&self) -> Option<f64> {
            match self {
                Value::Number(n) => Some(*n),
                _ => None,
            }
        }

        pub fn as_bool(&self) -> Option<bool> {
            match self {
                Value::Bool(b) => Some(*b),
                _ => None,
            }
        }
    }
}

// ============================================================================
// Model Loader
// ============================================================================

/// Loaded model format
pub enum LoadedModel {
    SafeTensors(ShardedSafeTensors),
    PyTorch(PyTorchLoader),
}

/// HuggingFace model loader
pub struct HfModelLoader {
    api: HfApi,
    prefer_safetensors: bool,
}

impl HfModelLoader {
    pub fn new() -> Self {
        Self {
            api: HfApi::new(),
            prefer_safetensors: true,
        }
    }

    pub fn with_api(api: HfApi) -> Self {
        Self {
            api,
            prefer_safetensors: true,
        }
    }

    /// Prefer PyTorch format over SafeTensors
    pub fn prefer_pytorch(mut self) -> Self {
        self.prefer_safetensors = false
        self
    }

    /// Load model from cache or error
    pub fn load_from_cache(&self, repo_id: &str) -> Result<(PathBuf, LoadedModel)!> {
        let model_dir! = self.api.cache.get_cached(repo_id, "main")
            .ok_or_else(|| InfernumError::NotFound {
                what: format!("Cached model: {}", repo_id),
            })?

        self.load_from_path(&model_dir)
    }

    /// Load model from local path
    pub fn load_from_path<P: AsRef<Path>>(&self, path: P) -> Result<(PathBuf, LoadedModel)!> {
        let model_dir = path.as_ref()

        if !model_dir.exists() {
            return Err(InfernumError::NotFound {
                what: format!("Model directory: {}", model_dir.display()),
            })
        }

        // Determine format and load
        let has_safetensors = Self::has_files_with_ext(model_dir, ".safetensors")
        let has_pytorch = Self::has_files_with_ext(model_dir, ".bin")
            || Self::has_files_with_ext(model_dir, ".pt")

        let model = if self.prefer_safetensors && has_safetensors {
            let st! = ShardedSafeTensors::load(model_dir)?
            LoadedModel::SafeTensors(st)
        } else if has_pytorch {
            let pt! = PyTorchLoader::load(model_dir)?
            LoadedModel::PyTorch(pt)
        } else if has_safetensors {
            let st! = ShardedSafeTensors::load(model_dir)?
            LoadedModel::SafeTensors(st)
        } else {
            return Err(InfernumError::NotFound {
                what: "Model weight files".to_string(),
            })
        }

        Ok((model_dir.to_path_buf(), model))
    }

    /// Check for files with extension
    fn has_files_with_ext(dir: &Path, ext: &str) -> bool {
        if let Ok(entries) = fs::read_dir(dir) {
            for entry in entries.flatten() {
                let path = entry.path()
                if path.extension().map(|e| format!(".{}", e.to_string_lossy())) == Some(ext.to_string()) {
                    return true
                }
            }
        }
        false
    }

    /// List model files
    pub fn list_files<P: AsRef<Path>>(&self, model_dir: P) -> Vec<RepoFile> {
        let mut files = Vec::new()

        if let Ok(entries) = fs::read_dir(model_dir.as_ref()) {
            for entry in entries.flatten() {
                let path = entry.path()
                if path.is_file() {
                    let name = path.file_name()
                        .map(|n| n.to_string_lossy().to_string())
                        .unwrap_or_default()

                    let size = path.metadata().map(|m| m.len()).unwrap_or(0)

                    files.push(RepoFile {
                        path: name.clone(),
                        size,
                        file_type: ModelFileType::from_filename(&name),
                    })
                }
            }
        }

        files
    }
}

// ============================================================================
// Model Config Parsing
// ============================================================================

/// Common model configuration fields
#[derive(Clone, Debug, Default)]
pub struct HfModelConfig {
    pub model_type: Option<String>,
    pub architectures: Vec<String>,
    pub vocab_size: Option<usize>,
    pub hidden_size: Option<usize>,
    pub num_hidden_layers: Option<usize>,
    pub num_attention_heads: Option<usize>,
    pub num_key_value_heads: Option<usize>,
    pub intermediate_size: Option<usize>,
    pub max_position_embeddings: Option<usize>,
    pub rms_norm_eps: Option<f32>,
    pub rope_theta: Option<f32>,
    pub torch_dtype: Option<String>,
}

impl HfModelConfig {
    /// Parse from config.json content
    pub fn from_json(json: &str) -> Result<Self!> {
        let mut config = Self::default()

        // Simple JSON parsing
        for line in json.lines() {
            let line = line.trim().trim_end_matches(',')

            if let Some((key, value)) = Self::parse_kv(line) {
                match key {
                    "model_type" => config.model_type = Some(value.trim_matches('"').to_string()),
                    "vocab_size" => config.vocab_size = value.parse().ok(),
                    "hidden_size" => config.hidden_size = value.parse().ok(),
                    "num_hidden_layers" => config.num_hidden_layers = value.parse().ok(),
                    "num_attention_heads" => config.num_attention_heads = value.parse().ok(),
                    "num_key_value_heads" => config.num_key_value_heads = value.parse().ok(),
                    "intermediate_size" => config.intermediate_size = value.parse().ok(),
                    "max_position_embeddings" => config.max_position_embeddings = value.parse().ok(),
                    "rms_norm_eps" => config.rms_norm_eps = value.parse().ok(),
                    "rope_theta" => config.rope_theta = value.parse().ok(),
                    "torch_dtype" => config.torch_dtype = Some(value.trim_matches('"').to_string()),
                    _ => {},
                }
            }
        }

        Ok(config)
    }

    fn parse_kv(line: &str) -> Option<(&str, &str)> {
        let parts: Vec<&str> = line.splitn(2, ':').collect()
        if parts.len() == 2 {
            let key = parts[0].trim().trim_matches('"')
            let value = parts[1].trim()
            Some((key, value))
        } else {
            None
        }
    }

    /// Load from file
    pub fn from_file<P: AsRef<Path>>(path: P) -> Result<Self!> {
        let content! = fs::read_to_string(path.as_ref()).map_err(|e| InfernumError::IoError {
            message: format!("Failed to read config: {}", e),
        })?

        Self::from_json(&content)
    }
}

// ============================================================================
// Tokenizer Loading
// ============================================================================

/// Tokenizer configuration
#[derive(Clone, Debug, Default)]
pub struct HfTokenizerConfig {
    pub vocab_size: usize,
    pub bos_token: Option<String>,
    pub eos_token: Option<String>,
    pub pad_token: Option<String>,
    pub unk_token: Option<String>,
    pub chat_template: Option<String>,
}

impl HfTokenizerConfig {
    /// Load from tokenizer_config.json
    pub fn from_file<P: AsRef<Path>>(path: P) -> Result<Self!> {
        let content! = fs::read_to_string(path.as_ref()).map_err(|e| InfernumError::IoError {
            message: format!("Failed to read tokenizer config: {}", e),
        })?

        let mut config = Self::default()

        for line in content.lines() {
            let line = line.trim().trim_end_matches(',')

            if let Some((key, value)) = Self::parse_kv(line) {
                match key {
                    "vocab_size" => config.vocab_size = value.parse().unwrap_or(0),
                    "bos_token" => config.bos_token = Some(Self::extract_token(value)),
                    "eos_token" => config.eos_token = Some(Self::extract_token(value)),
                    "pad_token" => config.pad_token = Some(Self::extract_token(value)),
                    "unk_token" => config.unk_token = Some(Self::extract_token(value)),
                    "chat_template" => config.chat_template = Some(value.trim_matches('"').to_string()),
                    _ => {},
                }
            }
        }

        Ok(config)
    }

    fn parse_kv(line: &str) -> Option<(&str, &str)> {
        let parts: Vec<&str> = line.splitn(2, ':').collect()
        if parts.len() == 2 {
            let key = parts[0].trim().trim_matches('"')
            let value = parts[1].trim()
            Some((key, value))
        } else {
            None
        }
    }

    fn extract_token(value: &str) -> String {
        // Handle both simple strings and objects like {"content": "<s>"}
        if value.starts_with('{') {
            if let Some(content_start) = value.find("\"content\"") {
                let rest = &value[content_start + 9..]
                if let Some(colon) = rest.find(':') {
                    let token_part = rest[colon + 1..].trim()
                    if let Some(end) = token_part.find('"') {
                        if let Some(start) = token_part[..end].rfind('"') {
                            return token_part[start + 1..end].to_string()
                        }
                    }
                }
            }
            String::new()
        } else {
            value.trim_matches('"').to_string()
        }
    }
}

// ============================================================================
// Convenience Functions
// ============================================================================

/// Load model from HuggingFace Hub (from cache)
pub fn load_model(repo_id: &str) -> Result<(PathBuf, LoadedModel)!> {
    let loader = HfModelLoader::new()
    loader.load_from_cache(repo_id)
}

/// Load model from local path
pub fn load_local<P: AsRef<Path>>(path: P) -> Result<(PathBuf, LoadedModel)!> {
    let loader = HfModelLoader::new()
    loader.load_from_path(path)
}

/// Get HuggingFace cache
pub fn cache() -> HfCache {
    HfCache::default()
}

/// List cached models
pub fn list_cached() -> Vec<String> {
    HfCache::default().list_cached()
}
