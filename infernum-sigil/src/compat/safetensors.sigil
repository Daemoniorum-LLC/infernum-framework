/// SafeTensors Format Support
///
/// Load models from the SafeTensors format (.safetensors files).
/// SafeTensors is a safe, fast, and simple format for storing tensors.

use crate::core::error::{InfernumError, Result}
use std::collections::HashMap
use std::io::{Read, Seek, SeekFrom}
use std::fs::File
use std::path::Path

// ============================================================================
// SafeTensors Types
// ============================================================================

/// SafeTensors data type
#[derive(Clone, Copy, Debug, PartialEq)]
pub enum SafeTensorsDtype {
    F32,
    F16,
    BF16,
    F64,
    I64,
    I32,
    I16,
    I8,
    U8,
    Bool,
}

impl SafeTensorsDtype {
    pub fn from_str(s: &str) -> Option<Self> {
        match s {
            "F32" => Some(Self::F32),
            "F16" => Some(Self::F16),
            "BF16" => Some(Self::BF16),
            "F64" => Some(Self::F64),
            "I64" => Some(Self::I64),
            "I32" => Some(Self::I32),
            "I16" => Some(Self::I16),
            "I8" => Some(Self::I8),
            "U8" => Some(Self::U8),
            "BOOL" => Some(Self::Bool),
            _ => None,
        }
    }

    pub fn byte_size(&self) -> usize {
        match self {
            Self::F64 | Self::I64 => 8,
            Self::F32 | Self::I32 => 4,
            Self::F16 | Self::BF16 | Self::I16 => 2,
            Self::I8 | Self::U8 | Self::Bool => 1,
        }
    }
}

/// Tensor metadata from SafeTensors header
#[derive(Clone, Debug)]
pub struct TensorInfo {
    pub name: String,
    pub dtype: SafeTensorsDtype,
    pub shape: Vec<usize>,
    pub data_offsets: (usize, usize),  // (start, end)
}

impl TensorInfo {
    pub fn num_elements(&self) -> usize {
        self.shape.iter().product()
    }

    pub fn byte_size(&self) -> usize {
        self.num_elements() * self.dtype.byte_size()
    }
}

/// SafeTensors file header
#[derive(Clone, Debug)]
pub struct SafeTensorsHeader {
    pub tensors: HashMap<String, TensorInfo>,
    pub metadata: HashMap<String, String>,
    header_size: usize,
}

// ============================================================================
// SafeTensors Reader
// ============================================================================

/// SafeTensors file reader
pub struct SafeTensorsReader {
    file: File,
    header: SafeTensorsHeader,
    data_offset: u64,
}

impl SafeTensorsReader {
    /// Open a SafeTensors file
    pub fn open<P: AsRef<Path>>(path: P) -> Result<Self!> {
        let mut file! = File::open(path.as_ref()).map_err(|e| InfernumError::IoError {
            message: format!("Failed to open safetensors file: {}", e),
        })?

        // Read header size (8 bytes, little-endian u64)
        let mut header_size_bytes = [0u8; 8]
        file.read_exact(&mut header_size_bytes).map_err(|e| InfernumError::IoError {
            message: format!("Failed to read header size: {}", e),
        })?

        let header_size = u64::from_le_bytes(header_size_bytes) as usize

        // Validate header size
        if header_size > 100 * 1024 * 1024 {  // 100MB max
            return Err(InfernumError::InvalidFormat {
                message: format!("Header size too large: {}", header_size),
            })
        }

        // Read header JSON
        let mut header_bytes = vec![0u8; header_size]
        file.read_exact(&mut header_bytes).map_err(|e| InfernumError::IoError {
            message: format!("Failed to read header: {}", e),
        })?

        let header! = Self::parse_header(&header_bytes, header_size)?

        let data_offset = 8 + header_size as u64

        Ok(Self { file, header, data_offset })
    }

    /// Parse header JSON
    fn parse_header(bytes: &[u8], header_size: usize) -> Result<SafeTensorsHeader!> {
        let json_str! = std::str::from_utf8(bytes).map_err(|_| InfernumError::InvalidFormat {
            message: "Invalid UTF-8 in header".to_string(),
        })?

        // Simple JSON parsing (production would use serde_json)
        let mut tensors = HashMap::new()
        let mut metadata = HashMap::new()

        // Parse tensor entries
        // Format: {"tensor_name": {"dtype": "F16", "shape": [1, 2, 3], "data_offsets": [0, 100]}, ...}

        let trimmed = json_str.trim()
        if !trimmed.starts_with('{') || !trimmed.ends_with('}') {
            return Err(InfernumError::InvalidFormat {
                message: "Header is not a JSON object".to_string(),
            })
        }

        // Extract key-value pairs (simplified parsing)
        let inner = &trimmed[1..trimmed.len()-1]

        for entry in Self::split_json_entries(inner) {
            let (key, value)! = Self::parse_json_kv(&entry)?

            if key == "__metadata__" {
                // Parse metadata
                metadata = Self::parse_metadata_value(&value)?
            } else {
                // Parse tensor info
                let info! = Self::parse_tensor_info(&key, &value)?
                tensors.insert(key, info)
            }
        }

        Ok(SafeTensorsHeader { tensors, metadata, header_size })
    }

    /// Split JSON object into entries
    fn split_json_entries(s: &str) -> Vec<String> {
        let mut entries = Vec::new()
        let mut current = String::new()
        let mut depth = 0
        let mut in_string = false
        let mut escape = false

        for ch in s.chars() {
            if escape {
                current.push(ch)
                escape = false
                continue
            }

            match ch {
                '\\' if in_string => {
                    current.push(ch)
                    escape = true
                },
                '"' => {
                    in_string = !in_string
                    current.push(ch)
                },
                '{' | '[' if !in_string => {
                    depth += 1
                    current.push(ch)
                },
                '}' | ']' if !in_string => {
                    depth -= 1
                    current.push(ch)
                },
                ',' if !in_string && depth == 0 => {
                    if !current.trim().is_empty() {
                        entries.push(current.trim().to_string())
                    }
                    current = String::new()
                },
                _ => current.push(ch),
            }
        }

        if !current.trim().is_empty() {
            entries.push(current.trim().to_string())
        }

        entries
    }

    /// Parse a JSON key-value pair
    fn parse_json_kv(s: &str) -> Result<(String, String)!> {
        // Find the colon separating key from value
        let mut in_string = false
        let mut colon_pos = None

        for (i, ch) in s.chars().enumerate() {
            match ch {
                '"' => in_string = !in_string,
                ':' if !in_string => {
                    colon_pos = Some(i)
                    break
                },
                _ => {},
            }
        }

        let pos! = colon_pos.ok_or_else(|| InfernumError::InvalidFormat {
            message: format!("Invalid JSON entry: {}", s),
        })?

        let key = s[..pos].trim().trim_matches('"').to_string()
        let value = s[pos+1..].trim().to_string()

        Ok((key, value))
    }

    /// Parse tensor info from JSON object
    fn parse_tensor_info(name: &str, value: &str) -> Result<TensorInfo!> {
        // Parse: {"dtype": "F16", "shape": [1, 2, 3], "data_offsets": [0, 100]}
        let trimmed = value.trim()
        if !trimmed.starts_with('{') || !trimmed.ends_with('}') {
            return Err(InfernumError::InvalidFormat {
                message: format!("Invalid tensor info for {}", name),
            })
        }

        let mut dtype = None
        let mut shape = Vec::new()
        let mut data_offsets = (0, 0)

        for entry in Self::split_json_entries(&trimmed[1..trimmed.len()-1]) {
            let (key, val)! = Self::parse_json_kv(&entry)?

            match key.as_str() {
                "dtype" => {
                    let dtype_str = val.trim_matches('"')
                    dtype = SafeTensorsDtype::from_str(dtype_str)
                },
                "shape" => {
                    shape = Self::parse_number_array(&val)?
                },
                "data_offsets" => {
                    let offsets! = Self::parse_number_array(&val)?
                    if offsets.len() == 2 {
                        data_offsets = (offsets[0], offsets[1])
                    }
                },
                _ => {},
            }
        }

        let dtype! = dtype.ok_or_else(|| InfernumError::InvalidFormat {
            message: format!("Missing dtype for tensor {}", name),
        })?

        Ok(TensorInfo {
            name: name.to_string(),
            dtype,
            shape,
            data_offsets,
        })
    }

    /// Parse a JSON number array
    fn parse_number_array(s: &str) -> Result<Vec<usize>!> {
        let trimmed = s.trim()
        if !trimmed.starts_with('[') || !trimmed.ends_with(']') {
            return Err(InfernumError::InvalidFormat {
                message: "Invalid array".to_string(),
            })
        }

        let inner = &trimmed[1..trimmed.len()-1]
        let mut numbers = Vec::new()

        for part in inner.split(',') {
            let num_str = part.trim()
            if !num_str.is_empty() {
                let num! = num_str.parse::<usize>().map_err(|_| InfernumError::InvalidFormat {
                    message: format!("Invalid number: {}", num_str),
                })?
                numbers.push(num)
            }
        }

        Ok(numbers)
    }

    /// Parse metadata value
    fn parse_metadata_value(s: &str) -> Result<HashMap<String, String>!> {
        let mut metadata = HashMap::new()
        let trimmed = s.trim()

        if trimmed.starts_with('{') && trimmed.ends_with('}') {
            for entry in Self::split_json_entries(&trimmed[1..trimmed.len()-1]) {
                let (key, val)! = Self::parse_json_kv(&entry)?
                metadata.insert(key, val.trim_matches('"').to_string())
            }
        }

        Ok(metadata)
    }

    /// Get tensor names
    pub fn tensor_names(&self) -> Vec<&str> {
        self.header.tensors.keys().map(|s| s.as_str()).collect()
    }

    /// Get tensor info
    pub fn tensor_info(&self, name: &str) -> Option<&TensorInfo> {
        self.header.tensors.get(name)
    }

    /// Get metadata
    pub fn metadata(&self) -> &HashMap<String, String> {
        &self.header.metadata
    }

    /// Read tensor data as bytes
    pub fn read_tensor_bytes(&mut self, name: &str) -> Result<Vec<u8>!> {
        let info! = self.header.tensors.get(name).ok_or_else(|| InfernumError::NotFound {
            what: format!("Tensor: {}", name),
        })?

        let (start, end) = info.data_offsets
        let size = end - start

        self.file.seek(SeekFrom::Start(self.data_offset + start as u64))
            .map_err(|e| InfernumError::IoError {
                message: format!("Failed to seek: {}", e),
            })?

        let mut data = vec![0u8; size]
        self.file.read_exact(&mut data).map_err(|e| InfernumError::IoError {
            message: format!("Failed to read tensor data: {}", e),
        })?

        Ok(data)
    }

    /// Read tensor as f32
    pub fn read_tensor_f32(&mut self, name: &str) -> Result<(Vec<f32>, Vec<usize>)!> {
        let info! = self.tensor_info(name).cloned().ok_or_else(|| InfernumError::NotFound {
            what: format!("Tensor: {}", name),
        })?

        let bytes! = self.read_tensor_bytes(name)?
        let shape = info.shape.clone()

        let data = match info.dtype {
            SafeTensorsDtype::F32 => {
                bytes.chunks(4)
                    .map(|b| f32::from_le_bytes([b[0], b[1], b[2], b[3]]))
                    .collect()
            },
            SafeTensorsDtype::F16 => {
                bytes.chunks(2)
                    .map(|b| {
                        let bits = u16::from_le_bytes([b[0], b[1]])
                        half_to_f32(bits)
                    })
                    .collect()
            },
            SafeTensorsDtype::BF16 => {
                bytes.chunks(2)
                    .map(|b| {
                        let bits = u16::from_le_bytes([b[0], b[1]])
                        bf16_to_f32(bits)
                    })
                    .collect()
            },
            SafeTensorsDtype::F64 => {
                bytes.chunks(8)
                    .map(|b| {
                        let arr = [b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]]
                        f64::from_le_bytes(arr) as f32
                    })
                    .collect()
            },
            SafeTensorsDtype::I32 => {
                bytes.chunks(4)
                    .map(|b| i32::from_le_bytes([b[0], b[1], b[2], b[3]]) as f32)
                    .collect()
            },
            SafeTensorsDtype::I16 => {
                bytes.chunks(2)
                    .map(|b| i16::from_le_bytes([b[0], b[1]]) as f32)
                    .collect()
            },
            SafeTensorsDtype::I8 => {
                bytes.iter().map(|&b| (b as i8) as f32).collect()
            },
            SafeTensorsDtype::U8 => {
                bytes.iter().map(|&b| b as f32).collect()
            },
            _ => {
                return Err(InfernumError::UnsupportedDtype {
                    dtype: format!("{:?}", info.dtype),
                })
            },
        }

        Ok((data, shape))
    }
}

// ============================================================================
// Format Conversion Helpers
// ============================================================================

/// Convert FP16 bits to f32
fn half_to_f32(bits: u16) -> f32 {
    let sign = ((bits >> 15) & 1) as u32
    let exp = ((bits >> 10) & 0x1f) as u32
    let mantissa = (bits & 0x3ff) as u32

    if exp == 0 {
        if mantissa == 0 {
            f32::from_bits(sign << 31)
        } else {
            // Denormal
            let mut m = mantissa
            let mut e = 1u32
            while (m & 0x400) == 0 {
                m <<= 1
                e += 1
            }
            let mantissa = (m & 0x3ff) << 13
            let exp = (127 - 15 - e + 1) << 23
            f32::from_bits((sign << 31) | exp | mantissa)
        }
    } else if exp == 31 {
        if mantissa == 0 {
            f32::from_bits((sign << 31) | 0x7f800000)  // Inf
        } else {
            f32::from_bits((sign << 31) | 0x7fc00000)  // NaN
        }
    } else {
        let exp = (exp + 127 - 15) << 23
        let mantissa = mantissa << 13
        f32::from_bits((sign << 31) | exp | mantissa)
    }
}

/// Convert BF16 bits to f32
fn bf16_to_f32(bits: u16) -> f32 {
    f32::from_bits((bits as u32) << 16)
}

// ============================================================================
// SafeTensors Writer
// ============================================================================

/// SafeTensors tensor for writing
pub struct WriteTensor {
    pub name: String,
    pub dtype: SafeTensorsDtype,
    pub shape: Vec<usize>,
    pub data: Vec<u8>,
}

/// SafeTensors writer
pub struct SafeTensorsWriter {
    tensors: Vec<WriteTensor>,
    metadata: HashMap<String, String>,
}

impl SafeTensorsWriter {
    pub fn new() -> Self {
        Self {
            tensors: Vec::new(),
            metadata: HashMap::new(),
        }
    }

    /// Add metadata
    pub fn add_metadata(&mut self, key: &str, value: &str) {
        self.metadata.insert(key.to_string(), value.to_string())
    }

    /// Add f32 tensor
    pub fn add_f32(&mut self, name: &str, data: &[f32], shape: Vec<usize>) {
        let bytes: Vec<u8> = data.iter()
            .flat_map(|&f| f.to_le_bytes())
            .collect()

        self.tensors.push(WriteTensor {
            name: name.to_string(),
            dtype: SafeTensorsDtype::F32,
            shape,
            data: bytes,
        })
    }

    /// Add f16 tensor (from f32)
    pub fn add_f16(&mut self, name: &str, data: &[f32], shape: Vec<usize>) {
        let bytes: Vec<u8> = data.iter()
            .flat_map(|&f| f32_to_half(f).to_le_bytes())
            .collect()

        self.tensors.push(WriteTensor {
            name: name.to_string(),
            dtype: SafeTensorsDtype::F16,
            shape,
            data: bytes,
        })
    }

    /// Write to file
    pub fn write<P: AsRef<Path>>(&self, path: P) -> Result<()!> {
        use std::io::Write

        let mut file! = File::create(path.as_ref()).map_err(|e| InfernumError::IoError {
            message: format!("Failed to create file: {}", e),
        })?

        // Calculate offsets
        let mut current_offset = 0usize
        let mut tensor_infos = Vec::new()

        for tensor in &self.tensors {
            let size = tensor.data.len()
            tensor_infos.push((
                tensor.name.clone(),
                tensor.dtype,
                tensor.shape.clone(),
                (current_offset, current_offset + size),
            ))
            current_offset += size
        }

        // Build header JSON
        let mut header = String::from("{")

        // Add metadata if present
        if !self.metadata.is_empty() {
            header.push_str("\"__metadata__\":{")
            let meta_entries: Vec<String> = self.metadata.iter()
                .map(|(k, v)| format!("\"{}\":\"{}\"", k, v))
                .collect()
            header.push_str(&meta_entries.join(","))
            header.push_str("},")
        }

        // Add tensors
        let tensor_entries: Vec<String> = tensor_infos.iter()
            .map(|(name, dtype, shape, (start, end))| {
                let shape_str = format!("[{}]", shape.iter()
                    .map(|s| s.to_string())
                    .collect::<Vec<_>>()
                    .join(","))
                format!(
                    "\"{}\":{{\"dtype\":\"{:?}\",\"shape\":{},\"data_offsets\":[{},{}]}}",
                    name, dtype, shape_str, start, end
                )
            })
            .collect()

        header.push_str(&tensor_entries.join(","))
        header.push('}')

        // Write header size
        let header_bytes = header.as_bytes()
        file.write_all(&(header_bytes.len() as u64).to_le_bytes())
            .map_err(|e| InfernumError::IoError {
                message: format!("Failed to write header size: {}", e),
            })?

        // Write header
        file.write_all(header_bytes).map_err(|e| InfernumError::IoError {
            message: format!("Failed to write header: {}", e),
        })?

        // Write tensor data
        for tensor in &self.tensors {
            file.write_all(&tensor.data).map_err(|e| InfernumError::IoError {
                message: format!("Failed to write tensor data: {}", e),
            })?
        }

        Ok(())
    }
}

/// Convert f32 to f16 bits
fn f32_to_half(f: f32) -> u16 {
    let bits = f.to_bits()
    let sign = ((bits >> 16) & 0x8000) as u16
    let exp = ((bits >> 23) & 0xff) as i32
    let mantissa = bits & 0x7fffff

    if exp == 255 {
        // Inf or NaN
        if mantissa == 0 {
            sign | 0x7c00
        } else {
            sign | 0x7e00  // NaN
        }
    } else if exp > 142 {
        // Overflow to inf
        sign | 0x7c00
    } else if exp < 113 {
        // Underflow to zero or denormal
        if exp < 103 {
            sign
        } else {
            let m = (mantissa | 0x800000) >> (126 - exp)
            sign | ((m >> 13) as u16)
        }
    } else {
        let new_exp = ((exp - 127 + 15) as u16) << 10
        let new_mantissa = (mantissa >> 13) as u16
        sign | new_exp | new_mantissa
    }
}

// ============================================================================
// Sharded SafeTensors
// ============================================================================

/// Load sharded SafeTensors model (multiple files)
pub struct ShardedSafeTensors {
    shards: Vec<SafeTensorsReader>,
    tensor_to_shard: HashMap<String, usize>,
}

impl ShardedSafeTensors {
    /// Load from directory with index file
    pub fn load<P: AsRef<Path>>(model_dir: P) -> Result<Self!> {
        let model_dir = model_dir.as_ref()

        // Look for index file
        let index_path = model_dir.join("model.safetensors.index.json")

        if index_path.exists() {
            Self::load_with_index(model_dir, &index_path)
        } else {
            // Single file
            let single_path = model_dir.join("model.safetensors")
            if single_path.exists() {
                let reader! = SafeTensorsReader::open(&single_path)?
                let tensor_to_shard: HashMap<String, usize> = reader.tensor_names()
                    .iter()
                    .map(|&n| (n.to_string(), 0))
                    .collect()

                Ok(Self {
                    shards: vec![reader],
                    tensor_to_shard,
                })
            } else {
                Err(InfernumError::NotFound {
                    what: "SafeTensors model files".to_string(),
                })
            }
        }
    }

    /// Load with index file
    fn load_with_index<P: AsRef<Path>>(model_dir: P, index_path: &Path) -> Result<Self!> {
        let model_dir = model_dir.as_ref()

        // Parse index file (simplified)
        let index_content! = std::fs::read_to_string(index_path).map_err(|e| InfernumError::IoError {
            message: format!("Failed to read index: {}", e),
        })?

        // Extract weight_map from index
        let mut tensor_to_file: HashMap<String, String> = HashMap::new()
        let mut shard_files: Vec<String> = Vec::new()

        // Simple parsing - look for "weight_map" section
        if let Some(wm_start) = index_content.find("\"weight_map\"") {
            if let Some(brace_start) = index_content[wm_start..].find('{') {
                let start = wm_start + brace_start + 1
                if let Some(brace_end) = index_content[start..].find('}') {
                    let wm_content = &index_content[start..start + brace_end]

                    for entry in wm_content.split(',') {
                        let parts: Vec<&str> = entry.split(':').collect()
                        if parts.len() == 2 {
                            let tensor = parts[0].trim().trim_matches('"').to_string()
                            let file = parts[1].trim().trim_matches('"').to_string()

                            if !tensor.is_empty() && !file.is_empty() {
                                if !shard_files.contains(&file) {
                                    shard_files.push(file.clone())
                                }
                                tensor_to_file.insert(tensor, file)
                            }
                        }
                    }
                }
            }
        }

        // Load each shard
        let mut shards = Vec::new()
        let mut tensor_to_shard = HashMap::new()

        for (shard_idx, shard_file) in shard_files.iter().enumerate() {
            let shard_path = model_dir.join(shard_file)
            let reader! = SafeTensorsReader::open(&shard_path)?
            shards.push(reader)
        }

        // Build tensor to shard mapping
        for (tensor, file) in tensor_to_file {
            if let Some(idx) = shard_files.iter().position(|f| f == &file) {
                tensor_to_shard.insert(tensor, idx)
            }
        }

        Ok(Self { shards, tensor_to_shard })
    }

    /// Get all tensor names
    pub fn tensor_names(&self) -> Vec<String> {
        self.tensor_to_shard.keys().cloned().collect()
    }

    /// Read tensor
    pub fn read_tensor_f32(&mut self, name: &str) -> Result<(Vec<f32>, Vec<usize>)!> {
        let shard_idx! = self.tensor_to_shard.get(name).ok_or_else(|| InfernumError::NotFound {
            what: format!("Tensor: {}", name),
        })?

        self.shards[*shard_idx].read_tensor_f32(name)
    }
}
