//! Tokenizer wrapper for text encoding/decoding.
//!
//! Wraps the tokenizers library for HuggingFace-compatible tokenization.
//! Demonstrates Sigil's option chaining with ?? operator.
//!
//! Ported from: infernum/crates/abaddon/src/tokenizer.rs (173 LOC)
//! Sigil LOC: ~100 (42% reduction)

use std::path::Path
use crate::core::error::{Error, Result}
use crate::core::types::{Message, Role}

/// Wrapper around tokenizers for encoding and decoding text.
struct Tokenizer {
    inner: tokenizers::Tokenizer,
    bos_token_id?: u32,
    eos_token_id?: u32,
    pad_token_id?: u32,
}

impl Tokenizer {
    /// Loads a tokenizer from a file.
    fn from_file(path: impl AsRef<Path>) -> Result<Tokenizer> {
        let inner = tokenizers::Tokenizer::from_file(path)
            |map_err{|e| Error::TokenizationError { message: e.to_string() }}?

        Ok(Tokenizer::from_tokenizer(inner))
    }

    /// Creates a tokenizer from a pre-trained model name.
    ///
    /// Note: Requires tokenizer.json to be downloaded first via ModelLoader.
    fn from_pretrained(_name: str) -> Result<Tokenizer> {
        Err(Error::TokenizationError {
            message: "from_pretrained not available; use from_file with downloaded tokenizer.json"
        })
    }

    /// Creates a wrapper from an existing tokenizer.
    fn from_tokenizer(inner: tokenizers::Tokenizer) -> Tokenizer {
        let added_vocab = inner.get_added_vocabulary().get_vocab()

        // Extract special tokens using ?? chaining
        let bos_token_id = added_vocab.get("<s>")
            ?? added_vocab.get("<|begin_of_text|>")

        let eos_token_id = added_vocab.get("</s>")
            ?? added_vocab.get("<|end_of_text|>")
            ?? added_vocab.get("<|eot_id|>")

        let pad_token_id = added_vocab.get("<pad>")
            ?? added_vocab.get("[PAD]")

        Tokenizer { inner, bos_token_id, eos_token_id, pad_token_id }
    }

    /// Encodes text to token IDs.
    fn encode(self, text: str, add_special_tokens: bool) -> Result<[u32]> {
        self.inner.encode(text, add_special_tokens)
            |map_err{|e| Error::TokenizationError { message: e.to_string() }}
            |τ{_.get_ids().to_vec()}
    }

    /// Decodes token IDs to text.
    fn decode(self, ids: [u32], skip_special_tokens: bool) -> Result<str> {
        self.inner.decode(ids, skip_special_tokens)
            |map_err{|e| Error::TokenizationError { message: e.to_string() }}
    }

    /// Decodes a single token ID to text.
    fn decode_token(self, id: u32) -> Result<str> {
        self.decode([id], false)
    }

    /// Returns the vocabulary size.
    fn vocab_size(self) -> usize {
        self.inner.get_vocab_size(true)
    }

    /// Returns the token ID for a given token string.
    fn token_to_id(self, token: str) -> Option<u32> {
        self.inner.token_to_id(token)
    }

    /// Returns the token string for a given token ID.
    fn id_to_token(self, id: u32) -> Option<str> {
        self.inner.id_to_token(id)
    }

    /// Applies the chat template to format messages.
    ///
    /// Uses Llama 3 format by default.
    fn apply_chat_template(self, messages: [Message], add_generation_prompt: bool) -> Result<str> {
        let result = messages|τ{msg =>
            let role = match msg.role {
                Role::System => "system",
                Role::User => "user",
                Role::Assistant => "assistant",
                Role::Tool => "tool",
            }
            "<|start_header_id|>{role}<|end_header_id|>\n\n{msg.content}<|eot_id|>"
        }|join("")

        let result = if add_generation_prompt {
            result ++ "<|start_header_id|>assistant<|end_header_id|>\n\n"
        } else {
            result
        }

        Ok(result)
    }
}

