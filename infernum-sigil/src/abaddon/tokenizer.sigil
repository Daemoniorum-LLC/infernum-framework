#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_chat_template_formatting() {
        // Create a mock tokenizer for testing
        let messages = [
            Message::system("You are a helpful assistant."),
            Message::user("Hello!"),
        ]

        // Test template would produce expected format
        let expected_contains = ["<|start_header_id|>system", "helpful assistant", "<|eot_id|>"]

        // Note: Actual test requires real tokenizer file
    }
}
