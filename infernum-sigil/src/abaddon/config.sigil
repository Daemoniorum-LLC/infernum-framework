//! Configuration types for the Abaddon inference engine.
//!
//! Demonstrates Sigil's inline defaults eliminating verbose Default impls
//! and builder patterns with validation.
//!
//! Ported from: infernum/crates/abaddon/src/config.rs (254 LOC)
//! Sigil LOC: ~140 (45% reduction)

use std::path::Path
use serde::{Serialize, Deserialize}
use crate::core::types::{DeviceType, QuantizationType}
use crate::core::model::ModelSource

/// Configuration for the inference engine.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct EngineConfig {
    model: ModelSource,
    device: DeviceType = DeviceType::Cpu,
    memory: MemoryConfig = MemoryConfig::default(),
    quantization?: QuantizationType,
    max_batch_size: u32 = 32,
    max_seq_len: u32 = 4096,
    speculative?: SpeculativeConfig,
    cache_dir?: Path,
}

impl EngineConfig {
    /// Creates a new configuration builder.
    fn builder() -> EngineConfigBuilder {
        EngineConfigBuilder::default()
    }
}

/// Builder for EngineConfig.
#[derive(Debug, Default)]
struct EngineConfigBuilder {
    model?: ModelSource,
    device?: DeviceType,
    memory?: MemoryConfig,
    quantization?: QuantizationType,
    max_batch_size?: u32,
    max_seq_len?: u32,
    speculative?: SpeculativeConfig,
    cache_dir?: Path,
}

impl EngineConfigBuilder {
    /// Sets the model from a HuggingFace repository ID.
    fn model(mut self, repo_id: impl Into<str>) -> EngineConfigBuilder {
        self.model = Some(ModelSource::huggingface(repo_id))
        self
    }

    /// Sets the model source directly.
    fn model_source(mut self, source: ModelSource) -> EngineConfigBuilder {
        self.model = Some(source)
        self
    }

    /// Sets the device.
    fn device(mut self, device: DeviceType) -> EngineConfigBuilder {
        self.device = Some(device)
        self
    }

    /// Sets to use CUDA with the specified device.
    fn cuda(mut self, device_id: usize) -> EngineConfigBuilder {
        self.device = Some(DeviceType::Cuda { device_id })
        self
    }

    /// Sets to use Metal.
    fn metal(mut self) -> EngineConfigBuilder {
        self.device = Some(DeviceType::Metal { device_id: 0 })
        self
    }

    /// Sets the memory configuration.
    fn memory(mut self, config: MemoryConfig) -> EngineConfigBuilder {
        self.memory = Some(config)
        self
    }

    /// Sets the quantization.
    fn quantization(mut self, quant: QuantizationType) -> EngineConfigBuilder {
        self.quantization = Some(quant)
        self
    }

    /// Sets the maximum batch size.
    fn max_batch_size(mut self, size: u32) -> EngineConfigBuilder {
        self.max_batch_size = Some(size)
        self
    }

    /// Sets the maximum sequence length.
    fn max_seq_len(mut self, len: u32) -> EngineConfigBuilder {
        self.max_seq_len = Some(len)
        self
    }

    /// Enables speculative decoding.
    fn speculative(mut self, config: SpeculativeConfig) -> EngineConfigBuilder {
        self.speculative = Some(config)
        self
    }

    /// Sets the cache directory.
    fn cache_dir(mut self, path: impl Into<Path>) -> EngineConfigBuilder {
        self.cache_dir = Some(path.into())
        self
    }

    /// Builds the configuration.
    fn build(self) -> Result<EngineConfig, str> {
        let model = self.model ?? return Err("model is required")

        Ok(EngineConfig {
            model,
            device: self.device ?? DeviceType::Cpu,
            memory: self.memory ?? MemoryConfig::default(),
            quantization: self.quantization,
            max_batch_size: self.max_batch_size ?? 32,
            max_seq_len: self.max_seq_len ?? 4096,
            speculative: self.speculative,
            cache_dir: self.cache_dir,
        })
    }
}

/// Memory configuration for the engine.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct MemoryConfig {
    gpu_memory_limit: usize = 0,        // 0 = auto-detect
    kv_cache_fraction: f32 = 0.9,
    mmap_enabled: bool = true,
    cpu_offload: bool = false,
    gpu_layers?: u32,                    // None = all layers on GPU
}

impl Default for MemoryConfig {
    fn default() -> MemoryConfig { MemoryConfig {} }
}

impl MemoryConfig {
    /// Creates a configuration optimized for low memory usage.
    fn low_memory() -> MemoryConfig {
        MemoryConfig {
            kv_cache_fraction: 0.5,
            cpu_offload: true,
            gpu_layers: Some(20),
            ..Default::default()
        }
    }

    /// Creates a configuration for maximum throughput.
    fn high_throughput() -> MemoryConfig {
        MemoryConfig {
            kv_cache_fraction: 0.95,
            ..Default::default()
        }
    }
}

/// Configuration for speculative decoding.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct SpeculativeConfig {
    draft_model: ModelSource,
    num_speculative_tokens: u32 = 5,
    acceptance_threshold: f32 = 0.9,
}

impl SpeculativeConfig {
    /// Creates a new speculative decoding configuration.
    fn new(draft_model: ModelSource) -> SpeculativeConfig {
        SpeculativeConfig {
            draft_model,
            num_speculative_tokens: 5,
            acceptance_threshold: 0.9,
        }
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_engine_config_builder() {
        let config = EngineConfig::builder()
            .model("meta-llama/Llama-3.2-3B")
            .cuda(0)
            .max_seq_len(8192)
            .quantization(QuantizationType::GgufQ4KM)
            .build()
            .unwrap()

        assert_eq!(config.max_seq_len, 8192)
        match config.device {
            DeviceType::Cuda { device_id } => assert_eq!(device_id, 0),
            _ => assert!(false, "Expected CUDA device"),
        }
    }

    #[test]
    fn test_memory_presets() {
        let low = MemoryConfig::low_memory()
        assert!(low.cpu_offload)
        assert_eq!(low.gpu_layers, Some(20))

        let high = MemoryConfig::high_throughput()
        assert_eq!(high.kv_cache_fraction, 0.95)
    }

    #[test]
    fn test_builder_requires_model() {
        let result = EngineConfig::builder()
            .cuda(0)
            .build()

        assert!(result.is_err())
    }
}
