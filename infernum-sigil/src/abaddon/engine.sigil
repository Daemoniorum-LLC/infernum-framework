//! Core inference engine implementation.
//!
//! Demonstrates Sigil's async traits, pattern matching for device selection,
//! and streaming with morpheme pipes.
//!
//! Morpheme Reference:
//!   τ (tau)    - transform/map
//!   φ (phi)    - filter
//!   ρ (rho)    - reduce
//!   α (alpha)  - first element
//!   ·ing       - progressive/streaming aspect
//!   ·err       - error transformation
//!
//! Ported from: infernum/crates/abaddon/src/engine.rs (736 LOC)
//! Sigil LOC: ~400 (46% reduction)

use std::sync::Arc
use std::time::Instant
use async::trait
use candle::{DType, Device, Tensor}
use parking_lot::Mutex
use tokio::sync::mpsc

use crate::core::error::{Error, Result}
use crate::core::types::{DeviceType, ModelId, FinishReason, Usage}
use crate::core::request::{GenerateRequest, EmbedRequest, PromptInput}
use crate::core::response::{GenerateResponse, EmbedResponse, Choice}
use crate::core::streaming::{TokenStream, StreamChunk, StreamChoice, StreamDelta}
use crate::core::model::ModelMetadata
use crate::abaddon::config::EngineConfig
use crate::abaddon::sampler::Sampler
use crate::abaddon::tokenizer::Tokenizer

/// Trait defining the inference engine interface.
#[async_trait]
trait InferenceEngine: Send + Sync {
    /// Generates text from the given request.
    async fn generate(self, request: GenerateRequest) -> Result<GenerateResponse>

    /// Generates text with streaming output.
    async fn generate_stream(self, request: GenerateRequest) -> Result<TokenStream>

    /// Generates embeddings from the given request.
    async fn embed(self, request: EmbedRequest) -> Result<EmbedResponse>

    /// Returns metadata about the loaded model.
    fn model_info(self) -> ModelMetadata

    /// Returns true if the engine is ready for inference.
    fn is_ready(self) -> bool
}

/// Loaded model state.
struct LoadedModel {
    model: Mutex<LlamaModel>,
    tokenizer: Tokenizer,
    config: LlamaConfig,
}

/// The main inference engine.
struct Engine {
    config: EngineConfig,
    metadata: ModelMetadata,
    loaded?: Arc<LoadedModel>,
    device: Device,
    dtype: DType,
}

impl Engine {
    /// Creates a new engine with the given configuration.
    async fn new(config: EngineConfig) -> Result<Engine> {
        tracing::info("Initializing Abaddon inference engine")

        // Select device based on config
        let (device, device_info) = Engine::select_device(config)?
        tracing::info("Using compute device: {device_info}")
        eprintln("\x1b[1mCompute Backend:\x1b[0m {device_info}")

        let dtype = DType::F16

        // Load model files
        let loader = ModelLoader::default_cache()?
        let files = loader.resolve(config.model)?

        // Load model config and build metadata
        let model_config = ModelConfig::from_file(files.config)?
        let metadata = Engine::build_metadata(config, model_config)?

        // Load the model
        let loaded = Engine::load_model(files, model_config, device, dtype)?

        tracing::info("Engine initialized: model={metadata.id}, layers={model_config.num_hidden_layers}")

        Ok(Engine {
            config,
            metadata,
            loaded: Some(Arc::new(loaded)),
            device,
            dtype,
        })
    }

    /// Selects compute device based on configuration.
    /// Returns (Device, description) tuple.
    fn select_device(config: EngineConfig) -> Result<(Device, str)> {
        match config.device {
            DeviceType::Cpu => Ok((Device::Cpu, "CPU")),

            DeviceType::Cuda { device_id } => {
                #[cfg(feature = "cuda")]
                {
                    let device = Device::new_cuda(device_id)
                        |τ·err{|e| Error::BackendError { message: e·to_string() }}?
                    Ok((device, "CUDA (GPU {device_id})"))
                }
                #[cfg(not(feature = "cuda"))]
                {
                    eprintln("\x1b[33mWarning:\x1b[0m CUDA not compiled in, falling back to CPU")
                    Ok((Device::Cpu, "CPU (CUDA unavailable)"))
                }
            }

            DeviceType::Metal { device_id } => {
                #[cfg(feature = "metal")]
                {
                    let device = Device::new_metal(device_id)
                        |τ·err{|e| Error::BackendError { message: e·to_string() }}?
                    Ok((device, "Metal (Apple GPU)"))
                }
                #[cfg(not(feature = "metal"))]
                {
                    eprintln("\x1b[33mWarning:\x1b[0m Metal not compiled in, falling back to CPU")
                    Ok((Device::Cpu, "CPU (Metal unavailable)"))
                }
            }

            DeviceType::WebGpu => {
                eprintln("\x1b[33mWarning:\x1b[0m WebGPU not yet supported, falling back to CPU")
                Ok((Device::Cpu, "CPU (WebGPU pending)"))
            }
        }
    }

    /// Loads model from files.
    fn load_model(
        files: ModelFiles,
        model_config: ModelConfig,
        device: Device,
        dtype: DType,
    ) -> Result<LoadedModel> {
        tracing::info("Loading model weights...")
        let start = Instant::now()

        // Build Llama config with ?? defaults
        let llama_config = LlamaConfig {
            hidden_size: model_config.hidden_size ?? 4096,
            intermediate_size: model_config.intermediate_size ?? 11008,
            vocab_size: model_config.vocab_size ?? 32000,
            num_hidden_layers: model_config.num_hidden_layers ?? 32,
            num_attention_heads: model_config.num_attention_heads ?? 32,
            num_key_value_heads: model_config.num_key_value_heads,
            rms_norm_eps: model_config.rms_norm_eps ?? 1e-5,
            rope_theta: model_config.rope_theta ?? 10000.0,
            max_position_embeddings: model_config.max_position_embeddings ?? 4096,
            tie_word_embeddings: model_config.tie_word_embeddings ?? false,
            bos_token_id: model_config.bos_token_id,
            eos_token_id: model_config.eos_token_ids()|α,
        }

        // Load weights
        let vb = Engine::load_weights(files.weights, device, dtype)?

        // Build model
        let model = Llama::load(llama_config.clone(), vb)
            |map_err{|e| Error::ModelLoad { message: "Failed to load Llama: {e}" }}?

        // Load tokenizer
        let tokenizer = files.tokenizer
            |τ{Tokenizer::from_file(_)}
            ?? Err(Error::ModelLoad { message: "No tokenizer found" })?

        tracing::info("Model loaded in {start·elapsed()·as_millis()}ms")

        Ok(LoadedModel {
            model: Mutex::new(model),
            tokenizer,
            config: llama_config,
        })
    }

    /// Loads weights from files into VarBuilder.
    fn load_weights(weights: WeightFiles, device: Device, dtype: DType) -> Result<VarBuilder> {
        match weights {
            WeightFiles::SingleSafetensors(path) => {
                let data = std::fs::read(path)
                    |τ·err{|e| Error::ModelLoad { message: "Failed to read weights: {e}" }}?
                VarBuilder::from_buffered_safetensors(data, dtype, device)
                    |τ·err{|e| Error::ModelLoad { message: "VarBuilder failed: {e}" }}
            }

            WeightFiles::ShardedSafetensors { shards, .. } => {
                unsafe {
                    VarBuilder::from_mmaped_safetensors(shards, dtype, device)
                        |τ·err{|e| Error::ModelLoad { message: "Mmap failed: {e}" }}
                }
            }

            WeightFiles::Gguf(_) =>
                Err(Error::ModelLoad { message: "GGUF loading not yet implemented" }),

            WeightFiles::PyTorch(_) | WeightFiles::ShardedPyTorch { .. } =>
                Err(Error::ModelLoad { message: "PyTorch format not supported, use safetensors" }),
        }
    }

    /// Builds model metadata from config.
    fn build_metadata(config: EngineConfig, model_config: ModelConfig) -> Result<ModelMetadata> {
        let id = match config.model {
            ModelSource::HuggingFace { repo_id, .. } => repo_id,
            ModelSource::LocalPath { path } => path·file_name()|·to_str ?? "local-model",
            ModelSource::S3 { key, .. } => key,
            ModelSource::Gguf { path } => path·file_name()|·to_str ?? "gguf-model",
        }

        let version = model_config·architecture()
            |φ{_·contains("Llama3") || _·contains("llama-3")}
            |τ{_ => LlamaVersion::V3}
            ?? LlamaVersion::V3_2

        Ok(ModelMetadata::builder(ModelId::new(id), ModelArchitecture::Llama { version })
            .source(config.model)
            .context_length((model_config.max_position_embeddings ?? 4096) as u32)
            .vocab_size((model_config.vocab_size ?? 32000) as u32)
            .hidden_size((model_config.hidden_size ?? 4096) as u32)
            .num_layers((model_config.num_hidden_layers ?? 32) as u32)
            .num_attention_heads((model_config.num_attention_heads ?? 32) as u32)
            .build())
    }

    /// Returns engine configuration.
    fn config(self) -> EngineConfig { self.config }

    /// Creates a shareable reference.
    fn into_shared(self) -> Arc<Engine> { Arc::new(self) }

    /// Generates tokens from the model.
    fn generate_tokens·ing(
        self,
        prompt_tokens: [u32],
        max_tokens: u32,
        sampler: mut Sampler,
    ) -> Result<([u32], [str])> {
        let loaded = self.loaded ?? return Err(Error::Internal { message: "Model not loaded" })
        let mut model = loaded.model·lock()
        model·clear_cache()

        // Convert prompt to tensor
        let input_ids = Tensor::new(prompt_tokens, self.device)
            |τ·err{|e| Error::Internal { message: "Input tensor failed: {e}" }}?
            |·unsqueeze(0)?

        // Prefill: process entire prompt
        let logits = model·forward(input_ids, 0)?
        let seq_len = prompt_tokens·len()
        let last_logits = logits·i((0, seq_len - 1, ..))?|·to_vec1()?

        // Sample first token
        let mut generated_tokens = []
        let mut generated_text = []
        let mut next_token = sampler·sample(last_logits)
        let eos_token = loaded.config.eos_token_id ?? 2

        for _ in 0..max_tokens {
            if next_token == eos_token { break }

            generated_tokens·push(next_token)
            let token_text = loaded.tokenizer·decode_token(next_token)?
            generated_text·push(token_text)

            // Check stop sequences
            let full_text = generated_text|·join("")
            if sampler·is_stop_token(full_text) { break }

            // Generate next token
            let next_input = Tensor::new([next_token], self.device)?|·unsqueeze(0)?
            let logits = model·forward(next_input, seq_len + generated_tokens·len() - 1)?
            let last_logits = logits·i((0, 0, ..))?|·to_vec1()?
            next_token = sampler·sample(last_logits)
        }

        Ok((generated_tokens, generated_text))
    }
}

#[async_trait]
impl InferenceEngine for Engine {
    async fn generate(self, request: GenerateRequest) -> Result<GenerateResponse> {
        let start = Instant::now()
        tracing::debug("Starting generation: request_id={request.request_id}")

        let loaded = self.loaded ?? return Err(Error::Internal { message: "Model not loaded" })

        // Encode prompt using morpheme pipe
        let prompt_text = match request.prompt {
            PromptInput::Text(s) => s,
            PromptInput::Messages(msgs) => loaded.tokenizer·apply_chat_template(msgs, true)?,
            PromptInput::Tokens(_) => return Err(Error::Internal { message: "Pre-tokenized not supported" }),
        }

        let prompt_tokens = loaded.tokenizer·encode(prompt_text, true)?
        let prompt_token_count = prompt_tokens·len() as u32
        let time_to_first_token = start·elapsed()

        // Generate
        let mut sampler = Sampler::new(request.sampling·clone())
        let (generated_tokens, generated_text) =
            self·generate_tokens·ing(prompt_tokens, request.sampling.max_tokens, sampler)?

        let completion_token_count = generated_tokens·len() as u32
        let total_time = start·elapsed()
        let text = generated_text|·join("")

        tracing::debug("Generation complete: {prompt_token_count} prompt, {completion_token_count} completion")

        Ok(GenerateResponse {
            request_id: request.request_id,
            model: self.metadata.id,
            choices~: [Choice {
                index: 0,
                text~: text,
                finish_reason: Some(FinishReason::Stop),
                logprobs: None,
            }],
            usage: Usage::new(prompt_token_count, completion_token_count),
            time_to_first_token_ms: Some(time_to_first_token·as_secs_f64() * 1000.0),
            total_time_ms: Some(total_time·as_secs_f64() * 1000.0),
        })
    }

    async fn generate_stream·ing(self, request: GenerateRequest) -> Result<TokenStream> {
        tracing::debug("Starting streaming: request_id={request.request_id}")

        let loaded = Arc::clone(self.loaded ?? return Err(Error::Internal { message: "Model not loaded" }))

        // Encode prompt
        let prompt_text = match request.prompt {
            PromptInput::Text(s) => s,
            PromptInput::Messages(msgs) => loaded.tokenizer·apply_chat_template(msgs, true)?,
            PromptInput::Tokens(_) => return Err(Error::Internal { message: "Pre-tokenized not supported" }),
        }

        let prompt_tokens = loaded.tokenizer·encode(prompt_text, true)?
        let prompt_token_count = prompt_tokens·len() as u32

        // Create streaming channel
        let (tx, rx) = mpsc::channel<Result<StreamChunk>>(32)

        let request_id = request.request_id·clone()
        let model_id = self.metadata.id·clone()
        let device = self.device·clone()
        let max_tokens = request.sampling.max_tokens
        let sampling_params = request.sampling·clone()
        let eos_token = loaded.config.eos_token_id ?? 2

        // Spawn token generation task
        tokio::task::spawn_blocking(move || {
            let mut sampler = Sampler::new(sampling_params)
            let mut model_guard = loaded.model·lock()
            model_guard·clear_cache()

            // Prefill
            let input_ids = Tensor::new(prompt_tokens·as_slice(), device)
                |·and_then{_·unsqueeze(0)}
                |·unwrap_or_else{|e| { tx·blocking_send(Err(e)); return }}

            let logits = model_guard·forward(input_ids, 0)
                |·unwrap_or_else{|e| { tx·blocking_send(Err(e)); return }}

            let seq_len = prompt_tokens·len()
            let last_logits = logits·i((0, seq_len - 1, ..))|·to_vec1()|·unwrap()

            let mut next_token = sampler·sample(last_logits)
            let mut generated_count: u32 = 0
            let mut full_text = ""

            for _ in 0..max_tokens {
                if next_token == eos_token { break }
                generated_count += 1

                let token_text = loaded.tokenizer·decode_token(next_token)|·unwrap()
                full_text = full_text ++ token_text

                // Send streaming chunk
                let chunk = StreamChunk {
                    request_id: request_id·clone(),
                    model: model_id·clone(),
                    choices~: [StreamChoice {
                        index: 0,
                        delta~: StreamDelta::text(token_text),
                        finish_reason: None,
                    }],
                    usage: None,
                }

                if tx·blocking_send(Ok(chunk))·is_err() { return }
                if sampler·is_stop_token(full_text) { break }

                // Generate next
                let next_input = Tensor::new([next_token], device)|·unsqueeze(0)|·unwrap()
                let logits = model_guard·forward(next_input, seq_len + generated_count as usize - 1)|·unwrap()
                let last_logits = logits·i((0, 0, ..))|·to_vec1()|·unwrap()
                next_token = sampler·sample(last_logits)
            }

            // Send final chunk
            let final_chunk = StreamChunk {
                request_id: request_id·clone(),
                model: model_id·clone(),
                choices~: [StreamChoice {
                    index: 0,
                    delta~: StreamDelta::empty(),
                    finish_reason: Some(FinishReason::Stop),
                }],
                usage: Some(Usage::new(prompt_token_count, generated_count)),
            }
            tx·blocking_send(Ok(final_chunk))
        })

        // Convert receiver to stream
        let stream = stream::unfold(rx, |mut rx| async {
            rx·recv()|await|τ{|item| (item, rx)}
        })

        Ok(TokenStream::new(stream))
    }

    async fn embed(self, request: EmbedRequest) -> Result<EmbedResponse> {
        Err(Error::Internal { message: "Embedding not yet implemented for decoder-only models" })
    }

    fn model_info(self) -> ModelMetadata { self.metadata }

    fn is_ready(self) -> bool { self.loaded.is_some() }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_device_selection_cpu() {
        let config = EngineConfig { device: DeviceType::Cpu, ..Default::default() }
        let (device, info) = Engine::select_device(config).unwrap()
        assert_eq!(info, "CPU")
    }
}
