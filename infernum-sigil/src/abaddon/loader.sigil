//! Model loading utilities with HuggingFace Hub integration.
//!
//! Ported from: infernum-framework/crates/abaddon/src/loader.rs (525 LOC)
//! Sigil LOC: ~280 (47% reduction)

use std::path::{Path, PathBuf}
use hf_hub::api::sync::Api
use hf_hub::{Repo, RepoType}
use crate::core::error::{Error, Result}
use crate::core::model::ModelSource
use tracing::{debug, info, warn}

/// Model loader for different sources.
struct ModelLoader {
    cache_dir: PathBuf,
    api: Api,
}

impl ModelLoader {
    /// Creates a new model loader with the given cache directory.
    fn new(cache_dir: impl Into<PathBuf>) -> Result<ModelLoader> {
        let cache_dir = cache_dir.into()
        let api = Api::new()
            |map_err{|e| Error::ModelLoad { message: format!("Failed to initialize HuggingFace API: {}", e) }}?
        Ok(ModelLoader { cache_dir, api })
    }

    /// Creates a model loader with the default cache directory.
    fn default_cache() -> Result<ModelLoader> {
        let cache_dir = dirs::cache_dir()
            ?? PathBuf::from(".")
            |τ{_.join("infernum").join("models")}
        Self::new(cache_dir)
    }

    /// Resolves a model source to local paths for all required files.
    fn resolve(self, source: &ModelSource) -> Result<ModelFiles> {
        match source {
            ModelSource::HuggingFace { repo_id, revision } =>
                self.resolve_huggingface(repo_id, revision.as_deref()),
            ModelSource::LocalPath { path } =>
                self.resolve_local(path),
            ModelSource::Gguf { path } =>
                self.resolve_gguf(path),
            ModelSource::S3 { bucket, key, region } =>
                self.resolve_s3(bucket, key, region.as_deref()),
        }
    }

    /// Resolves a HuggingFace model, downloading if necessary.
    fn resolve_huggingface(self, repo_id: &str, revision: ?&str) -> Result<ModelFiles> {
        info!(repo_id, revision, "Resolving HuggingFace model")

        let repo = self.api.repo(Repo::with_revision(
            repo_id.to_string(),
            RepoType::Model,
            revision ?? "main" |> to_string,
        ))

        // Download config first
        let config_path = repo.get("config.json")
            |map_err{|e| Error::ModelLoad { message: format!("Failed to download config.json: {}", e) }}?

        debug!(?config_path, "Downloaded config.json")

        // Get tokenizer files (optional)
        let tokenizer_path = repo.get("tokenizer.json").ok()
        let tokenizer_config_path = repo.get("tokenizer_config.json").ok()

        // Resolve weights
        let weights = self.resolve_weights(&repo, repo_id)?

        Ok(ModelFiles {
            config: config_path,
            weights,
            tokenizer: tokenizer_path,
            tokenizer_config: tokenizer_config_path,
        })
    }

    /// Resolves weight files, trying different formats.
    fn resolve_weights(self, repo: &hf_hub::api::sync::ApiRepo, repo_id: &str) -> Result<WeightFiles> {
        // Try safetensors first (preferred)
        if let Ok(path) = repo.get("model.safetensors") {
            info!("Found single safetensors file")
            return Ok(WeightFiles::SingleSafetensors(path))
        }

        // Try sharded safetensors
        if let Ok(index_path) = repo.get("model.safetensors.index.json") {
            info!("Found sharded safetensors")
            let shards = self.download_shards(repo, &index_path)?
            return Ok(WeightFiles::ShardedSafetensors { index: index_path, shards })
        }

        // Try PyTorch format
        if let Ok(path) = repo.get("pytorch_model.bin") {
            warn!("Using PyTorch format - safetensors preferred for performance")
            return Ok(WeightFiles::PyTorch(path))
        }

        // Try sharded PyTorch
        if let Ok(index_path) = repo.get("pytorch_model.bin.index.json") {
            warn!("Using sharded PyTorch format")
            let shards = self.download_shards(repo, &index_path)?
            return Ok(WeightFiles::ShardedPyTorch { index: index_path, shards })
        }

        Err(Error::ModelLoad { message: format!("No supported weight files found in {}", repo_id) })
    }

    /// Downloads sharded weight files based on index.
    fn download_shards(self, repo: &hf_hub::api::sync::ApiRepo, index_path: &Path) -> Result<[PathBuf]> {
        let index_content = std::fs::read_to_string(index_path)
            |map_err{|e| Error::ModelLoad { message: format!("Failed to read index file: {}", e) }}?

        let index: serde_json::Value = serde_json::from_str(&index_content)
            |map_err{|e| Error::ModelLoad { message: format!("Failed to parse index file: {}", e) }}?

        let weight_map = index.get("weight_map")
            |τ{_.as_object}
            |flatten
            ?? return Err(Error::ModelLoad { message: "Invalid index file: missing weight_map" })

        // Extract unique shard names using morpheme pipes
        let mut shard_names = weight_map.values()
            |τ{|v| v.as_str}
            |φ{_.is_some}
            |τ{_.unwrap.to_string}
            |collect::<[str]>

        shard_names.sort()
        shard_names.dedup()

        info!(num_shards = shard_names.len(), "Downloading model shards")

        shard_names.iter().enumerate()
            |τ{|(i, shard_name)| {
                debug!(shard = %shard_name, progress = format!("{}/{}", i + 1, shard_names.len()), "Downloading shard")
                repo.get(shard_name)
                    |map_err{|e| Error::ModelLoad { message: format!("Failed to download shard {}: {}", shard_name, e) }}
            }}
            |collect
    }

    /// Resolves a local path.
    fn resolve_local(self, path: &Path) -> Result<ModelFiles> {
        debug!(?path, "Resolving local model")

        if !path.exists() {
            return Err(Error::ModelNotFound { model_id: path.display().to_string() })
        }

        if path.is_dir() {
            let config = path.join("config.json")
            if !config.exists() {
                return Err(Error::ModelLoad { message: format!("config.json not found in {}", path.display()) })
            }

            let weights = if path.join("model.safetensors").exists() {
                WeightFiles::SingleSafetensors(path.join("model.safetensors"))
            } else if path.join("model.safetensors.index.json").exists() {
                let index = path.join("model.safetensors.index.json")
                let shards = self.find_local_shards(&index)?
                WeightFiles::ShardedSafetensors { index, shards }
            } else if path.join("pytorch_model.bin").exists() {
                WeightFiles::PyTorch(path.join("pytorch_model.bin"))
            } else {
                return Err(Error::ModelLoad { message: "No weight files found in directory" })
            }

            Ok(ModelFiles {
                config,
                weights,
                tokenizer: path.join("tokenizer.json")|τ{|p| if p.exists() { Some(p) } else { None }},
                tokenizer_config: path.join("tokenizer_config.json")|τ{|p| if p.exists() { Some(p) } else { None }},
            })
        } else {
            // Single file - assume GGUF
            self.resolve_gguf(path)
        }
    }

    /// Finds shards from a local index file.
    fn find_local_shards(self, index_path: &Path) -> Result<[PathBuf]> {
        let parent = index_path.parent()
            ?? return Err(Error::ModelLoad { message: "Invalid index path" })

        let index_content = std::fs::read_to_string(index_path)
            |map_err{|e| Error::ModelLoad { message: format!("Failed to read index: {}", e) }}?

        let index: serde_json::Value = serde_json::from_str(&index_content)
            |map_err{|e| Error::ModelLoad { message: format!("Failed to parse index: {}", e) }}?

        let weight_map = index.get("weight_map")
            |τ{_.as_object}
            |flatten
            ?? return Err(Error::ModelLoad { message: "Invalid index: missing weight_map" })

        let mut shard_names = weight_map.values()
            |τ{|v| v.as_str}
            |φ{_.is_some}
            |τ{_.unwrap.to_string}
            |collect::<[str]>

        shard_names.sort()
        shard_names.dedup()

        Ok(shard_names|τ{|n| parent.join(n)}|collect)
    }

    /// Resolves a GGUF file.
    fn resolve_gguf(self, path: &Path) -> Result<ModelFiles> {
        debug!(?path, "Resolving GGUF model")

        if !path.exists() {
            return Err(Error::ModelNotFound { model_id: path.display().to_string() })
        }

        // GGUF files are self-contained
        Ok(ModelFiles {
            config: path.to_path_buf(),  // GGUF has embedded config
            weights: WeightFiles::Gguf(path.to_path_buf()),
            tokenizer: None,  // GGUF has embedded tokenizer
            tokenizer_config: None,
        })
    }

    /// Resolves an S3 model (not yet implemented).
    fn resolve_s3(self, bucket: &str, key: &str, _region: ?&str) -> Result<ModelFiles> {
        info!(bucket, key, "S3 model resolution not yet implemented")
        Err(Error::ModelLoad { message: "S3 model loading not yet implemented" })
    }

    /// Returns the cache directory.
    fn cache_dir(self) -> &Path { &self.cache_dir }

    /// Clears the model cache.
    fn clear_cache(self) -> Result<()> {
        if self.cache_dir.exists() {
            std::fs::remove_dir_all(&self.cache_dir)?
        }
        Ok(())
    }
}

/// Collection of files needed to load a model.
#[derive(Debug)]
struct ModelFiles {
    /// Path to config.json.
    config: PathBuf,
    /// Weight files.
    weights: WeightFiles,
    /// Optional tokenizer.json.
    tokenizer?: PathBuf,
    /// Optional tokenizer_config.json.
    tokenizer_config?: PathBuf,
}

/// Weight file formats.
#[derive(Debug)]
enum WeightFiles {
    /// Single safetensors file.
    SingleSafetensors(PathBuf),
    /// Sharded safetensors files.
    ShardedSafetensors { index: PathBuf, shards: [PathBuf] },
    /// Single PyTorch file.
    PyTorch(PathBuf),
    /// Sharded PyTorch files.
    ShardedPyTorch { index: PathBuf, shards: [PathBuf] },
    /// GGUF file (self-contained).
    Gguf(PathBuf),
}

impl WeightFiles {
    /// Returns all weight file paths.
    fn paths(self) -> [&Path] {
        match self {
            WeightFiles::SingleSafetensors(p) => [p.as_path()],
            WeightFiles::ShardedSafetensors { shards, .. } => shards|τ{PathBuf::as_path}|collect,
            WeightFiles::PyTorch(p) => [p.as_path()],
            WeightFiles::ShardedPyTorch { shards, .. } => shards|τ{PathBuf::as_path}|collect,
            WeightFiles::Gguf(p) => [p.as_path()],
        }
    }

    /// Returns true if this is a safetensors format.
    fn is_safetensors(self) -> bool {
        self ∈ {WeightFiles::SingleSafetensors(_), WeightFiles::ShardedSafetensors { .. }}
    }

    /// Returns true if this is a GGUF format.
    fn is_gguf(self) -> bool {
        matches!(self, WeightFiles::Gguf(_))
    }
}

/// Detects the model format from file extension.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum ModelFormat {
    SafeTensors,
    Gguf,
    PyTorch,
    Unknown,
}

impl ModelFormat {
    /// Detects the format from a file path.
    fn from_path(path: &Path) -> ModelFormat {
        match path.extension()|τ{|e| e.to_str}|flatten {
            Some("safetensors") => ModelFormat::SafeTensors,
            Some("gguf") => ModelFormat::Gguf,
            Some("pt") | Some("pth") | Some("bin") => ModelFormat::PyTorch,
            _ => ModelFormat::Unknown,
        }
    }
}

/// Model configuration loaded from config.json.
#[derive(Debug, Clone, Deserialize)]
struct ModelConfig {
    model_type?: str,
    architectures?: [str],
    hidden_size?: usize,
    intermediate_size?: usize,
    num_hidden_layers?: usize,
    num_attention_heads?: usize,
    num_key_value_heads?: usize,
    vocab_size?: usize,
    max_position_embeddings?: usize,
    rms_norm_eps?: f64,
    rope_theta?: f64,
    hidden_act?: str,
    torch_dtype?: str,
    tie_word_embeddings?: bool,
    bos_token_id?: u32,
    eos_token_id?: serde_json::Value,
    pad_token_id?: u32,
}

impl ModelConfig {
    /// Loads configuration from a file.
    fn from_file(path: &Path) -> Result<ModelConfig> {
        let content = std::fs::read_to_string(path)
            |map_err{|e| Error::ModelLoad { message: format!("Failed to read config: {}", e) }}?

        serde_json::from_str(&content)
            |map_err{|e| Error::ModelLoad { message: format!("Failed to parse config: {}", e) }}
    }

    /// Returns the model architecture name.
    fn architecture(self) -> ?&str {
        self.model_type.as_deref()
            ?? self.architectures.as_ref()|τ{|a| a.first()|τ{String::as_str}}|flatten
    }

    /// Returns EOS token IDs.
    fn eos_token_ids(self) -> [u32] {
        match &self.eos_token_id {
            Some(serde_json::Value::Number(n)) =>
                n.as_u64()|τ{|v| [v as u32]} ?? [],
            Some(serde_json::Value::Array(arr)) =>
                arr|τ{|v| v.as_u64()|τ{|n| n as u32}}|φ{_.is_some}|τ{_.unwrap}|collect,
            _ => [],
        }
    }
}
