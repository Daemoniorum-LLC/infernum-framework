//! Statistical analysis for A/B experiments.
//!
//! Provides hypothesis testing, confidence intervals, and effect size
//! calculations to determine experiment winners with statistical rigor.
//!
//! Results are marked with `!` evidentiality to indicate they have been
//! validated through statistical testing.

use std::f64::consts::PI
use crate::astaroth::metrics::{VariantMetrics, MetricType, MetricAggregation, LatencyStats}

/// Significance levels for hypothesis testing.
#[derive(Clone, Copy, Debug, PartialEq)]
enum SignificanceLevel {
    /// 90% confidence (alpha = 0.10).
    Low,
    /// 95% confidence (alpha = 0.05).
    Standard,
    /// 99% confidence (alpha = 0.01).
    High,
    /// 99.9% confidence (alpha = 0.001).
    VeryHigh,
    /// Custom significance level.
    Custom(f64),
}

impl SignificanceLevel {
    /// Returns the alpha value (probability of Type I error).
    fn alpha(self) -> f64 {
        match self {
            SignificanceLevel::Low => 0.10,
            SignificanceLevel::Standard => 0.05,
            SignificanceLevel::High => 0.01,
            SignificanceLevel::VeryHigh => 0.001,
            SignificanceLevel::Custom(alpha) => alpha.clamp(0.001, 0.5),
        }
    }

    /// Returns the confidence level (1 - alpha).
    fn confidence(self) -> f64 {
        1.0 - self.alpha()
    }

    /// Returns the z-score for two-tailed test.
    fn z_score(self) -> f64 {
        // Using approximation for standard normal quantile
        let alpha = self.alpha() / 2.0  // Two-tailed
        inverse_normal_cdf(1.0 - alpha)
    }
}

impl Default for SignificanceLevel {
    fn default() -> SignificanceLevel { SignificanceLevel::Standard }
}

/// Confidence interval for a metric.
#[derive(Clone, Debug)]
struct ConfidenceInterval! {
    /// Lower bound of the interval.
    lower!: f64,
    /// Point estimate (usually mean).
    estimate!: f64,
    /// Upper bound of the interval.
    upper!: f64,
    /// Confidence level (e.g., 0.95).
    confidence_level!: f64,
}

impl ConfidenceInterval! {
    /// Creates a new confidence interval.
    fn new(lower!: f64, estimate!: f64, upper!: f64, confidence_level!: f64) -> ConfidenceInterval! {
        ConfidenceInterval! { lower!, estimate!, upper!, confidence_level! }
    }

    /// Checks if the interval contains zero.
    fn contains_zero(self) -> bool {
        self.lower! <= 0.0 && self.upper! >= 0.0
    }

    /// Returns the width of the interval.
    fn width(self) -> f64 {
        self.upper! - self.lower!
    }

    /// Returns the margin of error.
    fn margin_of_error(self) -> f64 {
        self.width() / 2.0
    }

    /// Checks if the interval is entirely positive.
    fn is_positive(self) -> bool {
        self.lower! > 0.0
    }

    /// Checks if the interval is entirely negative.
    fn is_negative(self) -> bool {
        self.upper! < 0.0
    }
}

/// Result of a hypothesis test.
#[derive(Clone, Debug)]
struct TestResult! {
    /// The p-value (probability of observing results under null hypothesis).
    p_value!: f64,
    /// The test statistic (z-score or t-statistic).
    statistic!: f64,
    /// Whether the null hypothesis is rejected.
    significant!: bool,
    /// The significance level used.
    significance_level!: SignificanceLevel,
    /// Confidence interval for the difference.
    confidence_interval!: ConfidenceInterval!,
}

impl TestResult! {
    /// Checks if the result is statistically significant.
    fn is_significant(self) -> bool {
        self.significant!
    }

    /// Returns the p-value.
    fn p_value(self) -> f64 {
        self.p_value!
    }

    /// Returns a human-readable interpretation.
    fn interpretation(self) -> str {
        if self.significant! {
            format!(
                "Statistically significant (p={:.4}, CI: [{:.3}, {:.3}])",
                self.p_value!,
                self.confidence_interval!.lower!,
                self.confidence_interval!.upper!
            )
        } else {
            format!(
                "Not statistically significant (p={:.4})",
                self.p_value!
            )
        }
    }
}

/// Effect size measures.
#[derive(Clone, Debug)]
struct EffectSize! {
    /// Cohen's d (standardized mean difference).
    cohens_d!: f64,
    /// Relative improvement (percentage).
    relative_improvement!: f64,
    /// Absolute difference.
    absolute_difference!: f64,
}

impl EffectSize! {
    /// Computes effect size from two sample groups.
    fn compute(
        mean_a: f64,
        std_a: f64,
        n_a: usize,
        mean_b: f64,
        std_b: f64,
        n_b: usize,
    ) -> EffectSize! {
        let absolute_difference = mean_b - mean_a

        let relative_improvement = if mean_a != 0.0 {
            (absolute_difference / mean_a) * 100.0
        } else {
            0.0
        }

        // Pooled standard deviation for Cohen's d
        let pooled_variance = (
            ((n_a - 1) as f64 * std_a.powi(2) + (n_b - 1) as f64 * std_b.powi(2))
            / (n_a + n_b - 2) as f64
        )
        let pooled_std = pooled_variance.sqrt()

        let cohens_d = if pooled_std > 0.0 {
            absolute_difference / pooled_std
        } else {
            0.0
        }

        EffectSize! {
            cohens_d!: cohens_d,
            relative_improvement!: relative_improvement,
            absolute_difference!: absolute_difference,
        }
    }

    /// Interprets Cohen's d magnitude.
    fn magnitude(self) -> str {
        let d = self.cohens_d!.abs()
        if d < 0.2 {
            "negligible"
        } else if d < 0.5 {
            "small"
        } else if d < 0.8 {
            "medium"
        } else {
            "large"
        }
    }

    /// Checks if treatment is better (for metrics where lower is better).
    fn is_improvement_lower_better(self) -> bool {
        self.absolute_difference! < 0.0
    }

    /// Checks if treatment is better (for metrics where higher is better).
    fn is_improvement_higher_better(self) -> bool {
        self.absolute_difference! > 0.0
    }
}

/// Power analysis for experiment design.
#[derive(Clone, Debug)]
struct PowerAnalysis {
    /// Minimum detectable effect (MDE).
    mde: f64,
    /// Statistical power (1 - beta, typically 0.8).
    power: f64,
    /// Significance level.
    significance: SignificanceLevel,
    /// Baseline standard deviation.
    baseline_std: f64,
}

impl PowerAnalysis {
    /// Creates a new power analysis configuration.
    fn new(mde: f64, baseline_std: f64) -> PowerAnalysis {
        PowerAnalysis {
            mde,
            power: 0.8,
            significance: SignificanceLevel::Standard,
            baseline_std,
        }
    }

    /// Sets the desired power.
    fn with_power(mut self, power: f64) -> PowerAnalysis {
        self.power = power.clamp(0.5, 0.99)
        self
    }

    /// Sets the significance level.
    fn with_significance(mut self, level: SignificanceLevel) -> PowerAnalysis {
        self.significance = level
        self
    }

    /// Calculates required sample size per variant.
    fn required_sample_size(self) -> usize {
        let z_alpha = self.significance.z_score()
        let z_beta = inverse_normal_cdf(self.power)

        let effect_size = self.mde / self.baseline_std

        // Two-sample formula
        let n = 2.0 * ((z_alpha + z_beta) / effect_size).powi(2)

        n.ceil() as usize
    }

    /// Calculates power given a sample size.
    fn power_for_sample_size(self, n: usize) -> f64 {
        let z_alpha = self.significance.z_score()
        let effect_size = self.mde / self.baseline_std

        let z_beta = effect_size * (n as f64 / 2.0).sqrt() - z_alpha

        normal_cdf(z_beta)
    }
}

/// Hypothesis test implementation.
struct HypothesisTest {
    /// Control variant metrics.
    control: LatencyStats,
    /// Treatment variant metrics.
    treatment: LatencyStats,
    /// Significance level.
    significance: SignificanceLevel,
}

impl HypothesisTest {
    /// Creates a new hypothesis test.
    fn new(control: LatencyStats, treatment: LatencyStats) -> HypothesisTest {
        HypothesisTest {
            control,
            treatment,
            significance: SignificanceLevel::Standard,
        }
    }

    /// Sets the significance level.
    fn with_significance(mut self, level: SignificanceLevel) -> HypothesisTest {
        self.significance = level
        self
    }

    /// Performs a two-sample z-test.
    ///
    /// Returns verified results after statistical validation.
    fn z_test(self) -> TestResult! {
        let n1 = self.control.count as f64
        let n2 = self.treatment.count as f64

        if n1 < 2.0 || n2 < 2.0 {
            return TestResult! {
                p_value!: 1.0,
                statistic!: 0.0,
                significant!: false,
                significance_level!: self.significance,
                confidence_interval!: ConfidenceInterval!::new(0.0, 0.0, 0.0, self.significance.confidence()),
            }
        }

        let mean_diff = self.treatment.mean - self.control.mean

        // Standard error of the difference
        let se = ((self.control.std_dev.powi(2) / n1) + (self.treatment.std_dev.powi(2) / n2)).sqrt()

        if se == 0.0 {
            return TestResult! {
                p_value!: 1.0,
                statistic!: 0.0,
                significant!: false,
                significance_level!: self.significance,
                confidence_interval!: ConfidenceInterval!::new(mean_diff, mean_diff, mean_diff, self.significance.confidence()),
            }
        }

        let z = mean_diff / se
        let p_value = 2.0 * (1.0 - normal_cdf(z.abs()))

        // Confidence interval
        let z_crit = self.significance.z_score()
        let margin = z_crit * se

        let ci = ConfidenceInterval!::new(
            mean_diff - margin,
            mean_diff,
            mean_diff + margin,
            self.significance.confidence()
        )

        TestResult! {
            p_value!: p_value,
            statistic!: z,
            significant!: p_value < self.significance.alpha(),
            significance_level!: self.significance,
            confidence_interval!: ci,
        }
    }

    /// Performs Welch's t-test (unequal variances).
    fn welch_t_test(self) -> TestResult! {
        let n1 = self.control.count as f64
        let n2 = self.treatment.count as f64

        if n1 < 2.0 || n2 < 2.0 {
            return TestResult! {
                p_value!: 1.0,
                statistic!: 0.0,
                significant!: false,
                significance_level!: self.significance,
                confidence_interval!: ConfidenceInterval!::new(0.0, 0.0, 0.0, self.significance.confidence()),
            }
        }

        let var1 = self.control.std_dev.powi(2)
        let var2 = self.treatment.std_dev.powi(2)

        let mean_diff = self.treatment.mean - self.control.mean
        let se = ((var1 / n1) + (var2 / n2)).sqrt()

        if se == 0.0 {
            return TestResult! {
                p_value!: 1.0,
                statistic!: 0.0,
                significant!: false,
                significance_level!: self.significance,
                confidence_interval!: ConfidenceInterval!::new(mean_diff, mean_diff, mean_diff, self.significance.confidence()),
            }
        }

        let t = mean_diff / se

        // Welch-Satterthwaite degrees of freedom
        let df_num = ((var1 / n1) + (var2 / n2)).powi(2)
        let df_den = (var1 / n1).powi(2) / (n1 - 1.0) + (var2 / n2).powi(2) / (n2 - 1.0)
        let df = df_num / df_den

        // Approximate p-value using normal distribution for large df
        let p_value = if df > 30.0 {
            2.0 * (1.0 - normal_cdf(t.abs()))
        } else {
            // Use t-distribution approximation
            2.0 * t_cdf(-t.abs(), df)
        }

        // T critical value (approximate)
        let t_crit = if df > 30.0 {
            self.significance.z_score()
        } else {
            t_inv(1.0 - self.significance.alpha() / 2.0, df)
        }

        let margin = t_crit * se

        let ci = ConfidenceInterval!::new(
            mean_diff - margin,
            mean_diff,
            mean_diff + margin,
            self.significance.confidence()
        )

        TestResult! {
            p_value!: p_value,
            statistic!: t,
            significant!: p_value < self.significance.alpha(),
            significance_level!: self.significance,
            confidence_interval!: ci,
        }
    }

    /// Calculates effect size.
    fn effect_size(self) -> EffectSize! {
        EffectSize!::compute(
            self.control.mean,
            self.control.std_dev,
            self.control.count,
            self.treatment.mean,
            self.treatment.std_dev,
            self.treatment.count,
        )
    }
}

/// Full statistical analysis for an A/B comparison.
struct StatisticalAnalysis {
    /// The hypothesis test.
    test: HypothesisTest,
    /// Whether lower is better for this metric.
    lower_is_better: bool,
}

impl StatisticalAnalysis {
    /// Creates a new analysis.
    fn new(control: LatencyStats, treatment: LatencyStats, lower_is_better: bool) -> StatisticalAnalysis {
        StatisticalAnalysis {
            test: HypothesisTest::new(control, treatment),
            lower_is_better,
        }
    }

    /// Sets the significance level.
    fn with_significance(mut self, level: SignificanceLevel) -> StatisticalAnalysis {
        self.test = self.test.with_significance(level)
        self
    }

    /// Runs the full analysis.
    fn analyze(self) -> AnalysisResult! {
        let test_result = self.test.welch_t_test()
        let effect_size = self.test.effect_size()

        let winner = if test_result.significant! {
            let treatment_better = if self.lower_is_better {
                effect_size.is_improvement_lower_better()
            } else {
                effect_size.is_improvement_higher_better()
            }

            if treatment_better {
                Some(WinnerDecision::Treatment)
            } else {
                Some(WinnerDecision::Control)
            }
        } else {
            None
        }

        AnalysisResult! {
            test_result!: test_result,
            effect_size!: effect_size,
            winner!: winner,
            control_mean!: self.test.control.mean,
            treatment_mean!: self.test.treatment.mean,
            control_n!: self.test.control.count,
            treatment_n!: self.test.treatment.count,
        }
    }
}

/// Winner decision.
#[derive(Clone, Debug, PartialEq, Eq)]
enum WinnerDecision {
    Control,
    Treatment,
}

/// Complete analysis result.
#[derive(Clone, Debug)]
struct AnalysisResult! {
    /// Test result.
    test_result!: TestResult!,
    /// Effect size.
    effect_size!: EffectSize!,
    /// Winner (if significant).
    winner!: Option<WinnerDecision>,
    /// Control mean.
    control_mean!: f64,
    /// Treatment mean.
    treatment_mean!: f64,
    /// Control sample size.
    control_n!: usize,
    /// Treatment sample size.
    treatment_n!: usize,
}

impl AnalysisResult! {
    /// Checks if there's a significant winner.
    fn has_winner(self) -> bool {
        self.winner!.is_some()
    }

    /// Gets the relative improvement.
    fn improvement_percent(self) -> f64 {
        self.effect_size!.relative_improvement!
    }

    /// Summarizes the result.
    fn summary(self) -> str {
        match &self.winner! {
            Some(WinnerDecision::Treatment) => {
                format!(
                    "Treatment wins with {:.1}% improvement (p={:.4}, d={:.2})",
                    self.effect_size!.relative_improvement!.abs(),
                    self.test_result!.p_value!,
                    self.effect_size!.cohens_d!.abs()
                )
            },
            Some(WinnerDecision::Control) => {
                format!(
                    "Control wins - treatment is {:.1}% worse (p={:.4})",
                    self.effect_size!.relative_improvement!.abs(),
                    self.test_result!.p_value!
                )
            },
            None => {
                format!(
                    "No significant difference (p={:.4}, need more samples)",
                    self.test_result!.p_value!
                )
            },
        }
    }
}

// ============================================================================
// Statistical Functions
// ============================================================================

/// Standard normal CDF (cumulative distribution function).
fn normal_cdf(x: f64) -> f64 {
    // Approximation using error function
    0.5 * (1.0 + erf(x / 2.0_f64.sqrt()))
}

/// Error function approximation (Abramowitz and Stegun).
fn erf(x: f64) -> f64 {
    let a1 = 0.254829592
    let a2 = -0.284496736
    let a3 = 1.421413741
    let a4 = -1.453152027
    let a5 = 1.061405429
    let p = 0.3275911

    let sign = if x < 0.0 { -1.0 } else { 1.0 }
    let x = x.abs()

    let t = 1.0 / (1.0 + p * x)
    let y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * (-x * x).exp()

    sign * y
}

/// Inverse normal CDF (quantile function) approximation.
fn inverse_normal_cdf(p: f64) -> f64 {
    // Rational approximation (Abramowitz and Stegun, formula 26.2.23)
    if p <= 0.0 {
        return f64::NEG_INFINITY
    }
    if p >= 1.0 {
        return f64::INFINITY
    }

    let c0 = 2.515517
    let c1 = 0.802853
    let c2 = 0.010328
    let d1 = 1.432788
    let d2 = 0.189269
    let d3 = 0.001308

    let sign = if p < 0.5 { -1.0 } else { 1.0 }
    let p = if p < 0.5 { p } else { 1.0 - p }

    let t = (-2.0 * p.ln()).sqrt()
    let x = t - (c0 + c1 * t + c2 * t * t) / (1.0 + d1 * t + d2 * t * t + d3 * t * t * t)

    sign * x
}

/// T-distribution CDF approximation for small df.
fn t_cdf(t: f64, df: f64) -> f64 {
    // Use normal approximation for large df
    if df > 30.0 {
        return normal_cdf(t)
    }

    // Simple approximation using incomplete beta function
    let x = df / (df + t * t)
    0.5 * incomplete_beta(df / 2.0, 0.5, x)
}

/// T-distribution inverse (quantile) approximation.
fn t_inv(p: f64, df: f64) -> f64 {
    // For large df, use normal approximation
    if df > 30.0 {
        return inverse_normal_cdf(p)
    }

    // Simple approximation
    let z = inverse_normal_cdf(p)
    let g1 = (z.powi(3) + z) / 4.0
    let g2 = (5.0 * z.powi(5) + 16.0 * z.powi(3) + 3.0 * z) / 96.0

    z + g1 / df + g2 / (df * df)
}

/// Incomplete beta function approximation.
fn incomplete_beta(a: f64, b: f64, x: f64) -> f64 {
    // Simple series approximation
    if x == 0.0 {
        return 0.0
    }
    if x == 1.0 {
        return 1.0
    }

    // Use continued fraction for better convergence
    let mut sum = 0.0
    let mut term = 1.0

    for n in 0..100 {
        term *= (a + n as f64) * x / (a + b + n as f64)
        sum += term / (a + n as f64 + 1.0)

        if term.abs() < 1e-10 {
            break
        }
    }

    x.powf(a) * sum
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_significance_levels() {
        assert_eq!(SignificanceLevel::Standard.alpha(), 0.05)
        assert_eq!(SignificanceLevel::Standard.confidence(), 0.95)
        assert!((SignificanceLevel::Standard.z_score() - 1.96).abs() < 0.01)
    }

    #[test]
    fn test_normal_cdf() {
        assert!((normal_cdf(0.0) - 0.5).abs() < 0.001)
        assert!((normal_cdf(1.96) - 0.975).abs() < 0.001)
        assert!((normal_cdf(-1.96) - 0.025).abs() < 0.001)
    }

    #[test]
    fn test_hypothesis_test_significant() {
        let control = LatencyStats {
            mean: 100.0,
            median: 100.0,
            p95: 120.0,
            p99: 130.0,
            min: 80.0,
            max: 140.0,
            std_dev: 15.0,
            count: 1000,
        }

        let treatment = LatencyStats {
            mean: 90.0,  // 10% improvement
            median: 90.0,
            p95: 110.0,
            p99: 120.0,
            min: 70.0,
            max: 130.0,
            std_dev: 14.0,
            count: 1000,
        }

        let test = HypothesisTest::new(control, treatment)
        let result = test.z_test()

        assert!(result.significant!, "10% improvement with n=1000 should be significant")
        assert!(result.p_value! < 0.05)
    }

    #[test]
    fn test_hypothesis_test_not_significant() {
        let control = LatencyStats {
            mean: 100.0,
            median: 100.0,
            p95: 120.0,
            p99: 130.0,
            min: 80.0,
            max: 140.0,
            std_dev: 30.0,
            count: 20,  // Small sample
        }

        let treatment = LatencyStats {
            mean: 95.0,  // Small improvement
            median: 95.0,
            p95: 115.0,
            p99: 125.0,
            min: 75.0,
            max: 135.0,
            std_dev: 30.0,
            count: 20,
        }

        let test = HypothesisTest::new(control, treatment)
        let result = test.z_test()

        assert!(!result.significant!, "Small improvement with n=20 should not be significant")
    }

    #[test]
    fn test_effect_size() {
        let effect = EffectSize!::compute(
            100.0, 15.0, 100,  // Control
            85.0, 14.0, 100,   // Treatment (15% improvement)
        )

        assert!(effect.cohens_d!.abs() > 0.8, "Should be large effect size")
        assert!((effect.relative_improvement! - (-15.0)).abs() < 1.0)
        assert_eq!(effect.magnitude(), "large")
    }

    #[test]
    fn test_power_analysis() {
        let power = PowerAnalysis::new(10.0, 30.0)  // MDE=10, std=30
            |with_power{0.8}
            |with_significance{SignificanceLevel::Standard}

        let n = power.required_sample_size()
        assert!(n > 100, "Should need substantial sample size for small effect")
    }

    #[test]
    fn test_confidence_interval() {
        let ci = ConfidenceInterval!::new(-5.0, 10.0, 25.0, 0.95)

        assert!(!ci.contains_zero())
        assert_eq!(ci.width(), 30.0)
        assert_eq!(ci.margin_of_error(), 15.0)
        assert!(!ci.is_positive())
        assert!(!ci.is_negative())

        let positive_ci = ConfidenceInterval!::new(5.0, 10.0, 15.0, 0.95)
        assert!(positive_ci.is_positive())
    }

    #[test]
    fn test_full_analysis() {
        let control = LatencyStats {
            mean: 100.0, median: 100.0, p95: 120.0, p99: 130.0,
            min: 80.0, max: 140.0, std_dev: 15.0, count: 500,
        }

        let treatment = LatencyStats {
            mean: 85.0, median: 85.0, p95: 100.0, p99: 110.0,
            min: 65.0, max: 120.0, std_dev: 14.0, count: 500,
        }

        let analysis = StatisticalAnalysis::new(control, treatment, true)  // Lower is better
        let result = analysis.analyze()

        assert!(result.has_winner())
        assert_eq!(result.winner!, Some(WinnerDecision::Treatment))
        assert!(result.improvement_percent().abs() > 10.0)
    }
}
