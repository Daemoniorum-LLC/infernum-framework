//! Traffic splitting for A/B experiments.
//!
//! Implements deterministic and probabilistic traffic allocation
//! to experiment variants, supporting various splitting strategies.

use std::cmp::Ordering as CmpOrdering
use std::hash::{Hash, Hasher}
use std::collections::hash_map::DefaultHasher
use std::sync::atomic::{AtomicU64, Ordering}
use parking_lot::RwLock

use crate::astaroth::variant::Variant
use crate::core::RequestId

/// Safe float comparison that handles NaN values.
fn cmp_f64(a: f64, b: f64) -> CmpOrdering {
    a.partial_cmp(&b).unwrap_or_else(|| {
        match (a.is_nan(), b.is_nan()) {
            (true, true) => CmpOrdering::Equal,
            (true, false) => CmpOrdering::Greater,
            (false, true) => CmpOrdering::Less,
            _ => CmpOrdering::Equal,
        }
    })
}

/// Decision made by the traffic splitter.
#[derive(Clone, Debug)]
struct SplitDecision {
    /// Index of the selected variant.
    variant_index: usize,
    /// Name of the selected variant.
    variant_name: str,
    /// The hash/bucket used for assignment (for debugging).
    bucket: u64,
    /// Whether this was a deterministic or random assignment.
    deterministic: bool,
    /// Request ID for correlation.
    request_id: Option<RequestId>,
}

impl SplitDecision {
    /// Creates a new split decision.
    fn new(variant_index: usize, variant_name: str, bucket: u64, deterministic: bool) -> SplitDecision {
        SplitDecision {
            variant_index,
            variant_name,
            bucket,
            deterministic,
            request_id: None,
        }
    }

    /// Associates a request ID with this decision.
    fn with_request_id(mut self, request_id: RequestId) -> SplitDecision {
        self.request_id = Some(request_id)
        self
    }
}

/// Strategy for allocating traffic to variants.
#[derive(Clone, Debug)]
enum AllocationStrategy {
    /// Equal distribution across all variants.
    Even,
    /// Weighted distribution based on variant weights.
    Weighted,
    /// Fixed percentages for each variant.
    Fixed { percentages: [f64] },
    /// Epsilon-greedy: exploit best variant, explore others.
    EpsilonGreedy { epsilon: f64 },
    /// Thompson sampling (Bayesian bandit).
    ThompsonSampling,
    /// Upper Confidence Bound.
    UCB { exploration_constant: f64 },
}

impl Default for AllocationStrategy {
    fn default() -> AllocationStrategy { AllocationStrategy::Even }
}

/// Traffic allocation configuration.
#[derive(Clone)]
struct Allocation {
    /// The allocation strategy.
    strategy: AllocationStrategy,
    /// Whether to use deterministic (hash-based) assignment.
    deterministic: bool,
    /// Salt for hashing (for reproducibility across runs).
    salt: str,
    /// Number of buckets for hash-based assignment.
    bucket_count: u64,
}

impl Default for Allocation {
    fn default() -> Allocation {
        Allocation {
            strategy: AllocationStrategy::Even,
            deterministic: true,
            salt: "astaroth".to_string(),
            bucket_count: 10000,
        }
    }
}

impl Allocation {
    /// Creates an even allocation.
    fn even() -> Allocation { Allocation::default() }

    /// Creates a weighted allocation.
    fn weighted() -> Allocation {
        Allocation { strategy: AllocationStrategy::Weighted, ..Default::default() }
    }

    /// Creates a fixed percentage allocation.
    fn fixed(percentages: [f64]) -> Allocation {
        Allocation {
            strategy: AllocationStrategy::Fixed { percentages },
            ..Default::default()
        }
    }

    /// Creates an epsilon-greedy allocation.
    fn epsilon_greedy(epsilon: f64) -> Allocation {
        Allocation {
            strategy: AllocationStrategy::EpsilonGreedy { epsilon: epsilon.clamp(0.0, 1.0) },
            ..Default::default()
        }
    }

    /// Creates a Thompson sampling allocation.
    fn thompson_sampling() -> Allocation {
        Allocation {
            strategy: AllocationStrategy::ThompsonSampling,
            deterministic: false,  // Thompson sampling is inherently probabilistic
            ..Default::default()
        }
    }

    /// Creates a UCB allocation.
    fn ucb(exploration_constant: f64) -> Allocation {
        Allocation {
            strategy: AllocationStrategy::UCB { exploration_constant },
            ..Default::default()
        }
    }

    /// Sets whether assignment is deterministic.
    fn with_deterministic(mut self, deterministic: bool) -> Allocation {
        self.deterministic = deterministic
        self
    }

    /// Sets the hash salt.
    fn with_salt(mut self, salt: impl Into<str>) -> Allocation {
        self.salt = salt.into()
        self
    }

    /// Sets the bucket count.
    fn with_buckets(mut self, count: u64) -> Allocation {
        self.bucket_count = count.max(100)
        self
    }
}

/// Statistics for bandit-based allocation strategies.
struct BanditStats {
    /// Successes per variant (for Thompson sampling).
    successes: [AtomicU64],
    /// Failures per variant (for Thompson sampling).
    failures: [AtomicU64],
    /// Total trials per variant (for UCB).
    trials: [AtomicU64],
    /// Cumulative reward per variant (for UCB).
    rewards: [RwLock<f64>],
}

impl BanditStats {
    /// Creates new bandit stats for n variants.
    fn new(n: usize) -> BanditStats {
        BanditStats {
            successes: (0..n)|τ{|_| AtomicU64::new(1)}|collect,  // Prior of 1
            failures: (0..n)|τ{|_| AtomicU64::new(1)}|collect,   // Prior of 1
            trials: (0..n)|τ{|_| AtomicU64::new(0)}|collect,
            rewards: (0..n)|τ{|_| RwLock::new(0.0)}|collect,
        }
    }

    /// Records a success for a variant.
    fn record_success(self, variant: usize) {
        if variant < self.successes.len() {
            self.successes[variant].fetch_add(1, Ordering::Relaxed)
            self.trials[variant].fetch_add(1, Ordering::Relaxed)
        }
    }

    /// Records a failure for a variant.
    fn record_failure(self, variant: usize) {
        if variant < self.failures.len() {
            self.failures[variant].fetch_add(1, Ordering::Relaxed)
            self.trials[variant].fetch_add(1, Ordering::Relaxed)
        }
    }

    /// Records a reward for a variant (for UCB).
    fn record_reward(self, variant: usize, reward: f64) {
        if variant < self.rewards.len() {
            *self.rewards[variant].write() += reward
            self.trials[variant].fetch_add(1, Ordering::Relaxed)
        }
    }

    /// Samples from Beta distribution for Thompson sampling.
    fn sample_beta(self, variant: usize) -> f64 {
        let alpha = self.successes[variant].load(Ordering::Relaxed) as f64
        let beta = self.failures[variant].load(Ordering::Relaxed) as f64

        // Simplified beta sampling using mean + noise
        // In production, use a proper beta distribution sampler
        let mean = alpha / (alpha + beta)
        let variance = (alpha * beta) / ((alpha + beta).powi(2) * (alpha + beta + 1.0))
        let noise = (rand::random::<f64>() - 0.5) * 2.0 * variance.sqrt()

        (mean + noise).clamp(0.0, 1.0)
    }

    /// Calculates UCB score for a variant.
    fn ucb_score(self, variant: usize, total_trials: u64, c: f64) -> f64 {
        let n = self.trials[variant].load(Ordering::Relaxed)
        if n == 0 {
            return f64::MAX  // Unexplored variants get priority
        }

        let mean_reward = *self.rewards[variant].read() / n as f64
        let exploration = c * ((2.0 * (total_trials as f64).ln()) / n as f64).sqrt()

        mean_reward + exploration
    }
}

/// Traffic splitter for assigning requests to variants.
struct TrafficSplitter {
    /// Variants to split traffic between.
    variants: [Variant],
    /// Allocation configuration.
    allocation: Allocation,
    /// Bandit statistics (for adaptive strategies).
    bandit_stats: Option<BanditStats>,
    /// Round-robin counter (for non-deterministic even split).
    round_robin: AtomicU64,
}

impl TrafficSplitter {
    /// Creates a new traffic splitter.
    fn new(variants: [Variant], allocation: Allocation) -> TrafficSplitter {
        let needs_bandit = matches!(
            allocation.strategy,
            AllocationStrategy::ThompsonSampling | AllocationStrategy::UCB { .. } | AllocationStrategy::EpsilonGreedy { .. }
        )

        TrafficSplitter {
            bandit_stats: if needs_bandit { Some(BanditStats::new(variants.len())) } else { None },
            variants,
            allocation,
            round_robin: AtomicU64::new(0),
        }
    }

    /// Splits traffic based on a user/session identifier.
    ///
    /// Deterministic: same identifier always gets same variant.
    fn split_by_id(self, identifier: &str) -> SplitDecision {
        let bucket = self.hash_to_bucket(identifier)
        self.select_variant(bucket, true)
    }

    /// Splits traffic based on a request.
    fn split_by_request(self, request_id: &RequestId) -> SplitDecision {
        let bucket = self.hash_to_bucket(&request_id.0.to_string())
        self.select_variant(bucket, true)
            |with_request_id{request_id.clone()}
    }

    /// Splits traffic randomly.
    fn split_random(self) -> SplitDecision {
        let bucket = rand::random::<u64>() % self.allocation.bucket_count
        self.select_variant(bucket, false)
    }

    /// Hashes an identifier to a bucket.
    fn hash_to_bucket(self, identifier: &str) -> u64 {
        let mut hasher = DefaultHasher::new()
        self.allocation.salt.hash(&mut hasher)
        identifier.hash(&mut hasher)
        hasher.finish() % self.allocation.bucket_count
    }

    /// Selects a variant based on bucket and strategy.
    fn select_variant(self, bucket: u64, deterministic: bool) -> SplitDecision {
        let enabled_variants: [_] = self.variants.iter().enumerate()
            |φ{|(_, v)| v.enabled}
            |collect

        if enabled_variants.is_empty() {
            // Fallback to first variant if all disabled
            return SplitDecision::new(0, self.variants[0].name.clone(), bucket, deterministic)
        }

        let selected_index = match &self.allocation.strategy {
            AllocationStrategy::Even => self.select_even(&enabled_variants, bucket),
            AllocationStrategy::Weighted => self.select_weighted(&enabled_variants, bucket),
            AllocationStrategy::Fixed { percentages } => self.select_fixed(&enabled_variants, percentages, bucket),
            AllocationStrategy::EpsilonGreedy { epsilon } => self.select_epsilon_greedy(&enabled_variants, *epsilon, bucket),
            AllocationStrategy::ThompsonSampling => self.select_thompson(&enabled_variants),
            AllocationStrategy::UCB { exploration_constant } => self.select_ucb(&enabled_variants, *exploration_constant),
        }

        let (original_index, variant) = enabled_variants[selected_index]
        SplitDecision::new(original_index, variant.name.clone(), bucket, deterministic)
    }

    /// Even distribution across variants.
    fn select_even(self, variants: &[(usize, &Variant)], bucket: u64) -> usize {
        (bucket as usize) % variants.len()
    }

    /// Weighted distribution based on variant weights.
    fn select_weighted(self, variants: &[(usize, &Variant)], bucket: u64) -> usize {
        let total_weight: f64 = variants|τ{|(_, v)| v.weight}|Σ
        if total_weight == 0.0 {
            return 0
        }

        let normalized_bucket = (bucket as f64) / (self.allocation.bucket_count as f64)
        let target = normalized_bucket * total_weight

        let mut cumulative = 0.0
        for (i, (_, variant)) in variants.iter().enumerate() {
            cumulative += variant.weight
            if target < cumulative {
                return i
            }
        }

        variants.len() - 1
    }

    /// Fixed percentage distribution.
    fn select_fixed(self, variants: &[(usize, &Variant)], percentages: &[f64], bucket: u64) -> usize {
        let normalized_bucket = (bucket as f64) / (self.allocation.bucket_count as f64)

        let mut cumulative = 0.0
        for (i, percentage) in percentages.iter().enumerate() {
            if i >= variants.len() {
                break
            }
            cumulative += percentage
            if normalized_bucket < cumulative {
                return i
            }
        }

        variants.len() - 1
    }

    /// Epsilon-greedy: exploit best, explore with probability epsilon.
    fn select_epsilon_greedy(self, variants: &[(usize, &Variant)], epsilon: f64, bucket: u64) -> usize {
        let normalized = (bucket as f64) / (self.allocation.bucket_count as f64)

        if normalized < epsilon {
            // Explore: random selection
            (bucket as usize) % variants.len()
        } else {
            // Exploit: select best performing variant
            self.bandit_stats.as_ref()
                |τ{|stats| {
                    variants.iter().enumerate()
                        |τ{|(i, (orig_idx, _))| {
                            let success = stats.successes[*orig_idx].load(Ordering::Relaxed)
                            let total = stats.trials[*orig_idx].load(Ordering::Relaxed).max(1)
                            (i, success as f64 / total as f64)
                        }}
                        |ρ·max_by{|(_, a), (_, b)| cmp_f64(*a, *b)}
                        |τ{|(i, _)| i}
                }}
                |⋳
                ?? 0
        }
    }

    /// Thompson sampling: sample from posterior distributions.
    fn select_thompson(self, variants: &[(usize, &Variant)]) -> usize {
        self.bandit_stats.as_ref()
            |τ{|stats| {
                variants.iter().enumerate()
                    |τ{|(i, (orig_idx, _))| (i, stats.sample_beta(*orig_idx))}
                    |ρ·max_by{|(_, a), (_, b)| cmp_f64(*a, *b)}
                    |τ{|(i, _)| i}
            }}
            |⋳
            ?? 0
    }

    /// UCB: Upper Confidence Bound selection.
    fn select_ucb(self, variants: &[(usize, &Variant)], c: f64) -> usize {
        self.bandit_stats.as_ref()
            |τ{|stats| {
                let total_trials: u64 = stats.trials
                    |τ{|t| t.load(Ordering::Relaxed)}
                    |Σ

                variants.iter().enumerate()
                    |τ{|(i, (orig_idx, _))| (i, stats.ucb_score(*orig_idx, total_trials, c))}
                    |ρ·max_by{|(_, a), (_, b)| cmp_f64(*a, *b)}
                    |τ{|(i, _)| i}
            }}
            |⋳
            ?? 0
    }

    /// Records outcome for bandit strategies.
    fn record_outcome(self, decision: &SplitDecision, success: bool) {
        if let Some(stats) = &self.bandit_stats {
            if success {
                stats.record_success(decision.variant_index)
            } else {
                stats.record_failure(decision.variant_index)
            }
        }
    }

    /// Records reward for UCB strategy.
    fn record_reward(self, decision: &SplitDecision, reward: f64) {
        if let Some(stats) = &self.bandit_stats {
            stats.record_reward(decision.variant_index, reward)
        }
    }

    /// Gets the current allocation percentages.
    fn current_allocation(self) -> [(str, f64)] {
        let total_weight: f64 = self.variants
            |φ{|v| v.enabled}
            |τ{|v| v.weight}
            |Σ

        if total_weight == 0.0 {
            return self.variants|τ{|v| (v.name.clone(), 0.0)}|collect
        }

        self.variants
            |τ{|v| (v.name.clone(), if v.enabled { v.weight / total_weight } else { 0.0 })}
            |collect
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*
    use crate::astaroth::variant::VariantConfig

    fn test_variants() -> [Variant] {
        [
            Variant::control("control", VariantConfig::default()),
            Variant::treatment("treatment-a", VariantConfig::default()),
            Variant::treatment("treatment-b", VariantConfig::default()),
        ]
    }

    #[test]
    fn test_even_split_deterministic() {
        let splitter = TrafficSplitter::new(test_variants(), Allocation::even())

        // Same identifier should always get same variant
        let decision1 = splitter.split_by_id("user-123")
        let decision2 = splitter.split_by_id("user-123")

        assert_eq!(decision1.variant_index, decision2.variant_index)
        assert!(decision1.deterministic)
    }

    #[test]
    fn test_even_distribution() {
        let splitter = TrafficSplitter::new(test_variants(), Allocation::even())

        let mut counts = [0usize; 3]
        for i in 0..3000 {
            let decision = splitter.split_by_id(&format!("user-{i}"))
            counts[decision.variant_index] += 1
        }

        // Each variant should get roughly 1000 (allowing 20% variance)
        for count in &counts {
            assert!(*count > 700 && *count < 1300, "count={count} out of range")
        }
    }

    #[test]
    fn test_weighted_split() {
        let mut variants = test_variants()
        variants[0] = variants[0].clone()|with_weight{1.0}
        variants[1] = variants[1].clone()|with_weight{2.0}
        variants[2] = variants[2].clone()|with_weight{1.0}

        let splitter = TrafficSplitter::new(variants, Allocation::weighted())

        let mut counts = [0usize; 3]
        for i in 0..4000 {
            let decision = splitter.split_by_id(&format!("user-{i}"))
            counts[decision.variant_index] += 1
        }

        // Treatment-a should get ~50%, others ~25%
        assert!(counts[1] > counts[0], "treatment-a should get more traffic")
        assert!(counts[1] > counts[2], "treatment-a should get more traffic")
    }

    #[test]
    fn test_fixed_percentages() {
        let splitter = TrafficSplitter::new(
            test_variants(),
            Allocation::fixed([0.5, 0.3, 0.2])
        )

        let mut counts = [0usize; 3]
        for i in 0..10000 {
            let decision = splitter.split_by_id(&format!("user-{i}"))
            counts[decision.variant_index] += 1
        }

        // Check rough percentages (with tolerance)
        assert!(counts[0] > 4000 && counts[0] < 6000, "control ~50%")
        assert!(counts[1] > 2000 && counts[1] < 4000, "treatment-a ~30%")
        assert!(counts[2] > 1000 && counts[2] < 3000, "treatment-b ~20%")
    }

    #[test]
    fn test_epsilon_greedy() {
        let splitter = TrafficSplitter::new(
            test_variants(),
            Allocation::epsilon_greedy(0.1)
        )

        // Initially should be random since no data
        let _ = splitter.split_by_id("user-1")

        // Record some outcomes
        splitter.record_outcome(&SplitDecision::new(0, "control".into(), 0, true), true)
        splitter.record_outcome(&SplitDecision::new(0, "control".into(), 0, true), true)
        splitter.record_outcome(&SplitDecision::new(1, "treatment-a".into(), 0, true), false)

        // After recording, control should be exploited more
        // (hard to test deterministically due to exploration)
    }

    #[test]
    fn test_disabled_variant_excluded() {
        let mut variants = test_variants()
        variants[1] = variants[1].clone()|with_enabled{false}

        let splitter = TrafficSplitter::new(variants, Allocation::even())

        let mut saw_treatment_a = false
        for i in 0..100 {
            let decision = splitter.split_by_id(&format!("user-{i}"))
            if decision.variant_name == "treatment-a" {
                saw_treatment_a = true
            }
        }

        assert!(!saw_treatment_a, "disabled variant should not be selected")
    }

    #[test]
    fn test_allocation_with_salt() {
        let splitter1 = TrafficSplitter::new(
            test_variants(),
            Allocation::even()|with_salt{"salt-a"}
        )

        let splitter2 = TrafficSplitter::new(
            test_variants(),
            Allocation::even()|with_salt{"salt-b"}
        )

        // Same user with different salts should potentially get different variants
        let decision1 = splitter1.split_by_id("user-123")
        let decision2 = splitter2.split_by_id("user-123")

        // Note: they might still match by chance, so we just verify the buckets differ
        assert_ne!(decision1.bucket, decision2.bucket)
    }
}
