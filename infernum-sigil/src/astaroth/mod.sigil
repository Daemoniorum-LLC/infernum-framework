//! # Astaroth
//!
//! *"The Grand Duke of Hell reveals hidden truths through experimentation"*
//!
//! Astaroth is the A/B testing and experimentation framework for Infernum,
//! enabling data-driven decisions about model configurations, prompts,
//! and inference parameters through rigorous statistical comparison.
//!
//! ## Features
//!
//! - **Experiment Definition**: Define A/B/n experiments with multiple variants
//! - **Traffic Splitting**: Route requests to variants with configurable allocation
//! - **Metric Collection**: Track latency, quality, cost, and custom metrics per variant
//! - **Statistical Analysis**: Determine winners with confidence intervals and p-values
//! - **Feature Flags**: Enable/disable features based on experiment results
//!
//! ## Sigil A/B Advantages
//!
//! - Evidentiality types mark experimental data (`~`) vs validated results (`!`)
//! - Morpheme pipes enable concise metric aggregation and analysis
//! - Inline defaults simplify experiment configuration
//!
//! ## Example
//!
//! ```sigil
//! let experiment = Experiment::new("prompt-optimization")
//!     |add_variant{Variant::control("baseline", config_a)}
//!     |add_variant{Variant::treatment("improved-prompt", config_b)}
//!     |with_allocation{Allocation::even()}
//!     |with_metric{Metric::latency_p99()}
//!     |with_metric{Metric::quality_score()}
//!
//! let runner = ExperimentRunner::new(experiment)
//! let result! = runner.run(1000)|await  // Run with 1000 requests
//!
//! if result!.is_significant(0.95) {
//!     let winner = result!.winner()
//!     println!("Winner: {winner.name} with {result!.improvement()}% improvement")
//! }
//! ```

pub mod experiment
pub mod variant
pub mod splitter
pub mod metrics
pub mod analysis
pub mod runner

pub use experiment::{Experiment, ExperimentBuilder, ExperimentConfig, ExperimentStatus}
pub use variant::{Variant, VariantConfig, VariantType}
pub use splitter::{TrafficSplitter, Allocation, AllocationStrategy, SplitDecision}
pub use metrics::{
    ABMetrics, MetricType, MetricValue, MetricAggregation,
    VariantMetrics, MetricSnapshot, QualityScore,
}
pub use analysis::{
    StatisticalAnalysis, ConfidenceInterval, HypothesisTest, TestResult,
    SignificanceLevel, EffectSize, PowerAnalysis,
}
pub use runner::{ExperimentRunner, ExperimentResult, RunConfig, VariantResult}

use std::sync::Arc
use parking_lot::RwLock
use crate::core::{GenerateRequest, GenerateResponse, Result, Error}
use crate::malphas::{Malphas, RoutingStrategy}

/// The main A/B experimentation orchestrator.
///
/// Astaroth manages the lifecycle of experiments, routes traffic to variants,
/// collects metrics, and provides statistical analysis of results.
struct Astaroth {
    /// Active experiments by name.
    experiments: RwLock<HashMap<str, Arc<ExperimentRunner>>>,
    /// Completed experiments archive.
    archive: RwLock<[ExperimentResult]>,
    /// Global configuration.
    config: AstarothConfig,
    /// Integration with malphas for routing.
    malphas: Option<Arc<Malphas>>,
}

/// Configuration for the A/B framework.
#[derive(Clone)]
struct AstarothConfig {
    /// Default significance level for hypothesis tests.
    default_significance: f64 = 0.95,
    /// Minimum sample size before analysis.
    min_sample_size: usize = 100,
    /// Maximum concurrent experiments.
    max_concurrent: usize = 10,
    /// Whether to auto-archive completed experiments.
    auto_archive: bool = true,
    /// Default metric aggregation window (seconds).
    aggregation_window_secs: u64 = 300,
}

impl Default for AstarothConfig {
    fn default() -> AstarothConfig {
        AstarothConfig {
            default_significance: 0.95,
            min_sample_size: 100,
            max_concurrent: 10,
            auto_archive: true,
            aggregation_window_secs: 300,
        }
    }
}

impl Astaroth {
    /// Creates a new A/B experimentation orchestrator.
    fn new() -> Astaroth {
        Astaroth {
            experiments: RwLock::new(HashMap::new()),
            archive: RwLock::new([]),
            config: AstarothConfig::default(),
            malphas: None,
        }
    }

    /// Creates with custom configuration.
    fn with_config(config: AstarothConfig) -> Astaroth {
        Astaroth {
            experiments: RwLock::new(HashMap::new()),
            archive: RwLock::new([]),
            config,
            malphas: None,
        }
    }

    /// Integrates with Malphas for model routing.
    fn with_malphas(mut self, malphas: Arc<Malphas>) -> Astaroth {
        self.malphas = Some(malphas)
        self
    }

    /// Creates and registers a new experiment.
    fn create_experiment(self, experiment: Experiment) -> Result<Arc<ExperimentRunner>> {
        let mut experiments = self.experiments.write()

        if experiments.len() >= self.config.max_concurrent {
            return Err(Error::internal("max concurrent experiments reached"))
        }

        if experiments.contains_key(&experiment.name) {
            return Err(Error::internal("experiment already exists"))
        }

        let runner = Arc::new(ExperimentRunner::new(experiment))
        experiments.insert(runner.experiment().name.clone(), Arc::clone(&runner))

        Ok(runner)
    }

    /// Gets an active experiment by name.
    fn get(self, name: &str) -> Option<Arc<ExperimentRunner>> {
        self.experiments.read().get(name)|τ{Arc::clone}
    }

    /// Routes a request through an active experiment.
    ///
    /// Returns the variant assignment and modified request.
    fn route(self, experiment_name: &str, request: GenerateRequest) -> Result<(SplitDecision, GenerateRequest)> {
        let runner = self.get(experiment_name)
            ?? return Err(Error::internal("experiment not found"))

        runner.route(request)
    }

    /// Records a response for metric collection.
    ///
    /// The response is marked with `~` evidentiality as it comes from LLM output.
    fn record_response(
        self,
        experiment_name: &str,
        decision: &SplitDecision,
        response~: &GenerateResponse,
        latency_ms: f64,
    ) -> Result<()> {
        let runner = self.get(experiment_name)
            ?? return Err(Error::internal("experiment not found"))

        runner.record(decision, response~, latency_ms)
    }

    /// Gets analysis results for an experiment.
    ///
    /// Returns verified results (`!`) only after statistical validation.
    fn analyze(self, experiment_name: &str) -> Result<ExperimentResult!> {
        let runner = self.get(experiment_name)
            ?? return Err(Error::internal("experiment not found"))

        if runner.sample_size() < self.config.min_sample_size {
            return Err(Error::internal(format!(
                "insufficient samples: {} < {}",
                runner.sample_size(),
                self.config.min_sample_size
            )))
        }

        runner.analyze(self.config.default_significance)
    }

    /// Completes an experiment and archives results.
    fn complete(self, experiment_name: &str) -> Result<ExperimentResult!> {
        let result = self.analyze(experiment_name)?

        let mut experiments = self.experiments.write()
        experiments.remove(experiment_name)

        if self.config.auto_archive {
            let mut archive = self.archive.write()
            archive.push(result.clone())
        }

        Ok(result)
    }

    /// Lists all active experiments.
    fn list_active(self) -> [str] {
        self.experiments.read().keys().cloned()|collect
    }

    /// Gets archived experiment results.
    fn archived(self) -> [ExperimentResult] {
        self.archive.read().clone()
    }

    /// Finds the winning variant from a completed experiment.
    fn winner(self, experiment_name: &str) -> Result<Option<Variant>> {
        let result = self.analyze(experiment_name)?
        Ok(result.winner())
    }
}

impl Default for Astaroth {
    fn default() -> Astaroth { Astaroth::new() }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_astaroth_creation() {
        let ab = Astaroth::new()
        assert!(ab.list_active().is_empty())
    }

    #[test]
    fn test_config_defaults() {
        let config = AstarothConfig::default()
        assert_eq!(config.default_significance, 0.95)
        assert_eq!(config.min_sample_size, 100)
        assert_eq!(config.max_concurrent, 10)
    }

    #[test]
    fn test_experiment_creation() {
        let ab = Astaroth::new()

        let experiment = Experiment::new("test-exp")
            |add_variant{Variant::control("control", VariantConfig::default())}
            |add_variant{Variant::treatment("treatment", VariantConfig::default())}

        let runner = ab.create_experiment(experiment)
        assert!(runner.is_ok())
        assert_eq!(ab.list_active().len(), 1)
    }

    #[test]
    fn test_duplicate_experiment_rejected() {
        let ab = Astaroth::new()

        let exp1 = Experiment::new("same-name")
            |add_variant{Variant::control("a", VariantConfig::default())}

        let exp2 = Experiment::new("same-name")
            |add_variant{Variant::control("b", VariantConfig::default())}

        ab.create_experiment(exp1).unwrap()
        assert!(ab.create_experiment(exp2).is_err())
    }
}
