//! Variant definitions for A/B experiments.
//!
//! Variants represent different configurations being tested in an experiment.
//! Each variant can modify model selection, sampling parameters, prompts, or
//! any other inference configuration.

use crate::core::{GenerateRequest, SamplingParams, ModelId}

/// Type of variant in an experiment.
#[derive(Clone, Debug, PartialEq, Eq)]
enum VariantType {
    /// Control variant - the baseline/current behavior.
    Control,
    /// Treatment variant - the new behavior being tested.
    Treatment,
    /// Holdout variant - receives no treatment (for measuring overall lift).
    Holdout { percentage: f64 },
    /// Shadow variant - runs in parallel but results are discarded.
    Shadow,
}

impl Default for VariantType {
    fn default() -> VariantType { VariantType::Treatment }
}

/// Configuration for a variant's inference behavior.
#[derive(Clone)]
struct VariantConfig {
    /// Model to use (None = use default/router selection).
    model_id: Option<ModelId>,
    /// Sampling parameters override.
    sampling: Option<SamplingParams>,
    /// System prompt override.
    system_prompt: Option<str>,
    /// Prompt template (use {input} placeholder).
    prompt_template: Option<str>,
    /// Additional model parameters.
    model_params: HashMap<str, serde_json::Value>,
    /// Custom metadata for tracking.
    metadata: HashMap<str, str>,
    /// Whether to enable streaming for this variant.
    streaming: Option<bool>,
    /// Max tokens override.
    max_tokens: Option<u32>,
    /// Stop sequences override.
    stop_sequences: Option<[str]>,
}

impl Default for VariantConfig {
    fn default() -> VariantConfig {
        VariantConfig {
            model_id: None,
            sampling: None,
            system_prompt: None,
            prompt_template: None,
            model_params: HashMap::new(),
            metadata: HashMap::new(),
            streaming: None,
            max_tokens: None,
            stop_sequences: None,
        }
    }
}

impl VariantConfig {
    /// Creates a config with a specific model.
    fn with_model(model_id: impl Into<str>) -> VariantConfig {
        let mut config = VariantConfig::default()
        config.model_id = Some(ModelId(model_id.into()))
        config
    }

    /// Creates a config with sampling parameters.
    fn with_sampling(sampling: SamplingParams) -> VariantConfig {
        let mut config = VariantConfig::default()
        config.sampling = Some(sampling)
        config
    }

    /// Creates a config with a system prompt.
    fn with_system_prompt(prompt: impl Into<str>) -> VariantConfig {
        let mut config = VariantConfig::default()
        config.system_prompt = Some(prompt.into())
        config
    }

    /// Creates a config with a prompt template.
    fn with_prompt_template(template: impl Into<str>) -> VariantConfig {
        let mut config = VariantConfig::default()
        config.prompt_template = Some(template.into())
        config
    }

    /// Sets model ID.
    fn model(mut self, model_id: impl Into<str>) -> VariantConfig {
        self.model_id = Some(ModelId(model_id.into()))
        self
    }

    /// Sets sampling parameters.
    fn sampling(mut self, params: SamplingParams) -> VariantConfig {
        self.sampling = Some(params)
        self
    }

    /// Sets system prompt.
    fn system_prompt(mut self, prompt: impl Into<str>) -> VariantConfig {
        self.system_prompt = Some(prompt.into())
        self
    }

    /// Sets prompt template.
    fn prompt_template(mut self, template: impl Into<str>) -> VariantConfig {
        self.prompt_template = Some(template.into())
        self
    }

    /// Adds a model parameter.
    fn param(mut self, key: impl Into<str>, value: impl Into<serde_json::Value>) -> VariantConfig {
        self.model_params.insert(key.into(), value.into())
        self
    }

    /// Adds metadata.
    fn meta(mut self, key: impl Into<str>, value: impl Into<str>) -> VariantConfig {
        self.metadata.insert(key.into(), value.into())
        self
    }

    /// Sets streaming mode.
    fn streaming(mut self, enabled: bool) -> VariantConfig {
        self.streaming = Some(enabled)
        self
    }

    /// Sets max tokens.
    fn max_tokens(mut self, tokens: u32) -> VariantConfig {
        self.max_tokens = Some(tokens)
        self
    }

    /// Sets stop sequences.
    fn stop_sequences(mut self, sequences: [str]) -> VariantConfig {
        self.stop_sequences = Some(sequences)
        self
    }

    /// Applies this variant's configuration to a request.
    fn apply_to(self, mut request: GenerateRequest) -> GenerateRequest {
        // Apply model override
        if let Some(model_id) = &self.model_id {
            request.model = Some(model_id.clone())
        }

        // Apply sampling override
        if let Some(sampling) = &self.sampling {
            request.sampling = sampling.clone()
        }

        // Apply max tokens override
        if let Some(max_tokens) = self.max_tokens {
            request.sampling.max_tokens = max_tokens
        }

        // Apply stop sequences override
        if let Some(stop) = &self.stop_sequences {
            request.stop = stop.clone()
        }

        // Apply prompt template if set
        if let Some(template) = &self.prompt_template {
            request = self.apply_template(request, template)
        }

        // Apply system prompt if set
        if let Some(system) = &self.system_prompt {
            request = self.apply_system_prompt(request, system)
        }

        request
    }

    /// Applies a prompt template to the request.
    fn apply_template(self, request: GenerateRequest, template: &str) -> GenerateRequest {
        use crate::core::PromptInput

        match &request.prompt {
            PromptInput::Text(text) => {
                let transformed = template.replace("{input}", text)
                GenerateRequest { prompt: PromptInput::Text(transformed), ..request }
            },
            PromptInput::Messages(messages) => {
                // Apply template to last user message
                let mut new_messages = messages.clone()
                if let Some(last) = new_messages.last_mut() {
                    if last.role == crate::core::Role::User {
                        last.content = template.replace("{input}", &last.content)
                    }
                }
                GenerateRequest { prompt: PromptInput::Messages(new_messages), ..request }
            },
            PromptInput::Tokens(_) => request, // Can't template tokens
        }
    }

    /// Applies a system prompt to the request.
    fn apply_system_prompt(self, request: GenerateRequest, system: &str) -> GenerateRequest {
        use crate::core::{PromptInput, Message, Role}

        match &request.prompt {
            PromptInput::Messages(messages) => {
                let mut new_messages = [Message { role: Role::System, content: system.to_string() }]
                // Skip existing system message if present
                for msg in messages {
                    if msg.role != Role::System {
                        new_messages.push(msg.clone())
                    }
                }
                GenerateRequest { prompt: PromptInput::Messages(new_messages), ..request }
            },
            _ => request, // Only applies to message format
        }
    }
}

/// A variant in an A/B experiment.
#[derive(Clone)]
struct Variant {
    /// Unique name within the experiment.
    name: str,
    /// Type of variant.
    variant_type: VariantType,
    /// Configuration for this variant.
    config: VariantConfig,
    /// Traffic allocation weight (relative to other variants).
    weight: f64,
    /// Whether this variant is enabled.
    enabled: bool,
}

impl Variant {
    /// Creates a new variant.
    fn new(name: impl Into<str>, variant_type: VariantType, config: VariantConfig) -> Variant {
        Variant {
            name: name.into(),
            variant_type,
            config,
            weight: 1.0,
            enabled: true,
        }
    }

    /// Creates a control variant.
    fn control(name: impl Into<str>, config: VariantConfig) -> Variant {
        Variant::new(name, VariantType::Control, config)
    }

    /// Creates a treatment variant.
    fn treatment(name: impl Into<str>, config: VariantConfig) -> Variant {
        Variant::new(name, VariantType::Treatment, config)
    }

    /// Creates a holdout variant.
    fn holdout(name: impl Into<str>, percentage: f64) -> Variant {
        Variant::new(name, VariantType::Holdout { percentage }, VariantConfig::default())
    }

    /// Creates a shadow variant.
    fn shadow(name: impl Into<str>, config: VariantConfig) -> Variant {
        Variant::new(name, VariantType::Shadow, config)
    }

    /// Sets the traffic weight.
    fn with_weight(mut self, weight: f64) -> Variant {
        self.weight = weight.max(0.0)
        self
    }

    /// Enables or disables the variant.
    fn with_enabled(mut self, enabled: bool) -> Variant {
        self.enabled = enabled
        self
    }

    /// Checks if this is the control variant.
    fn is_control(self) -> bool {
        matches!(self.variant_type, VariantType::Control)
    }

    /// Checks if this is a treatment variant.
    fn is_treatment(self) -> bool {
        matches!(self.variant_type, VariantType::Treatment)
    }

    /// Checks if this is a holdout variant.
    fn is_holdout(self) -> bool {
        matches!(self.variant_type, VariantType::Holdout { .. })
    }

    /// Checks if this is a shadow variant.
    fn is_shadow(self) -> bool {
        matches!(self.variant_type, VariantType::Shadow)
    }

    /// Applies this variant's config to a request.
    fn apply(self, request: GenerateRequest) -> GenerateRequest {
        if !self.enabled {
            return request
        }
        self.config.apply_to(request)
    }
}

// ============================================================================
// Preset Variants
// ============================================================================

/// Common variant presets for quick experiment setup.
mod presets {
    use super::*

    /// Creates a temperature comparison experiment variants.
    fn temperature_comparison() -> [Variant] {
        [
            Variant::control("temp-0.7", VariantConfig::with_sampling(
                SamplingParams::new()|with_temperature{0.7}
            )),
            Variant::treatment("temp-0.3", VariantConfig::with_sampling(
                SamplingParams::new()|with_temperature{0.3}
            )),
            Variant::treatment("temp-1.0", VariantConfig::with_sampling(
                SamplingParams::new()|with_temperature{1.0}
            )),
        ]
    }

    /// Creates a model comparison experiment variants.
    fn model_comparison(control_model: &str, treatment_models: &[&str]) -> [Variant] {
        let mut variants = [Variant::control("control", VariantConfig::with_model(control_model))]

        for (i, model) in treatment_models.iter().enumerate() {
            variants.push(Variant::treatment(
                format!("treatment-{i}"),
                VariantConfig::with_model(*model)
            ))
        }

        variants
    }

    /// Creates a prompt optimization experiment variants.
    fn prompt_optimization(control_prompt: &str, treatment_prompts: &[&str]) -> [Variant] {
        let mut variants = [Variant::control(
            "baseline-prompt",
            VariantConfig::with_system_prompt(control_prompt)
        )]

        for (i, prompt) in treatment_prompts.iter().enumerate() {
            variants.push(Variant::treatment(
                format!("prompt-v{}", i + 1),
                VariantConfig::with_system_prompt(*prompt)
            ))
        }

        variants
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_variant_creation() {
        let control = Variant::control("baseline", VariantConfig::default())
        assert!(control.is_control())
        assert!(control.enabled)
        assert_eq!(control.weight, 1.0)

        let treatment = Variant::treatment("new-model", VariantConfig::with_model("llama-3"))
        assert!(treatment.is_treatment())
    }

    #[test]
    fn test_variant_config_chaining() {
        let config = VariantConfig::default()
            |model{"gpt-4"}
            |system_prompt{"You are a helpful assistant."}
            |max_tokens{1000}
            |meta{"version", "2.0"}

        assert_eq!(config.model_id, Some(ModelId("gpt-4".into())))
        assert_eq!(config.system_prompt, Some("You are a helpful assistant.".into()))
        assert_eq!(config.max_tokens, Some(1000))
        assert_eq!(config.metadata.get("version"), Some(&"2.0".into()))
    }

    #[test]
    fn test_variant_with_weight() {
        let variant = Variant::treatment("weighted", VariantConfig::default())
            |with_weight{2.0}

        assert_eq!(variant.weight, 2.0)

        // Negative weights should be clamped to 0
        let clamped = Variant::treatment("clamped", VariantConfig::default())
            |with_weight{-1.0}

        assert_eq!(clamped.weight, 0.0)
    }

    #[test]
    fn test_holdout_variant() {
        let holdout = Variant::holdout("holdout-10", 0.10)

        assert!(holdout.is_holdout())
        assert!(matches!(holdout.variant_type, VariantType::Holdout { percentage: 0.10 }))
    }

    #[test]
    fn test_temperature_presets() {
        let variants = presets::temperature_comparison()
        assert_eq!(variants.len(), 3)
        assert!(variants[0].is_control())
        assert!(variants[1].is_treatment())
        assert!(variants[2].is_treatment())
    }
}
