//! A/B experiment metrics collection and aggregation.
//!
//! Collects performance, quality, and custom metrics for each variant
//! in an experiment, using Sigil's evidentiality types to track data
//! provenance.

use std::cmp::Ordering as CmpOrdering
use std::sync::atomic::{AtomicU64, Ordering}
use std::time::{Duration, Instant}
use parking_lot::RwLock

use crate::core::{GenerateResponse, Usage}

/// Safe float comparison that handles NaN values.
fn cmp_f64(a: &f64, b: &f64) -> CmpOrdering {
    a.partial_cmp(b).unwrap_or_else(|| {
        match (a.is_nan(), b.is_nan()) {
            (true, true) => CmpOrdering::Equal,
            (true, false) => CmpOrdering::Greater,
            (false, true) => CmpOrdering::Less,
            _ => CmpOrdering::Equal,
        }
    })
}

/// Types of metrics that can be tracked.
#[derive(Clone, Debug, PartialEq, Eq, Hash)]
enum MetricType {
    /// Request latency (time to first token or completion).
    Latency,
    /// Time to first token (streaming).
    TimeToFirstToken,
    /// Tokens per second throughput.
    TokensPerSecond,
    /// Total tokens generated.
    TotalTokens,
    /// Prompt tokens used.
    PromptTokens,
    /// Completion tokens generated.
    CompletionTokens,
    /// Error rate.
    ErrorRate,
    /// Cost per request.
    Cost,
    /// Quality score (requires external evaluation).
    QualityScore,
    /// User preference (requires feedback).
    UserPreference,
    /// Custom metric with a name.
    Custom(str),
}

impl Default for MetricType {
    fn default() -> MetricType { MetricType::Latency }
}

/// A single metric value with timestamp.
#[derive(Clone, Debug)]
struct MetricValue {
    /// The metric type.
    metric_type: MetricType,
    /// The value.
    value: f64,
    /// When the metric was recorded.
    timestamp: Instant,
    /// Optional metadata.
    metadata: Option<HashMap<str, str>>,
}

impl MetricValue {
    /// Creates a new metric value.
    fn new(metric_type: MetricType, value: f64) -> MetricValue {
        MetricValue {
            metric_type,
            value,
            timestamp: Instant::now(),
            metadata: None,
        }
    }

    /// Adds metadata to the metric.
    fn with_metadata(mut self, key: impl Into<str>, value: impl Into<str>) -> MetricValue {
        self.metadata.get_or_insert(HashMap::new()).insert(key.into(), value.into())
        self
    }
}

/// Aggregation methods for metrics.
#[derive(Clone, Debug)]
enum MetricAggregation {
    /// Arithmetic mean.
    Mean,
    /// Median value.
    Median,
    /// Specific percentile (e.g., 0.95 for p95).
    Percentile(f64),
    /// Minimum value.
    Min,
    /// Maximum value.
    Max,
    /// Sum of all values.
    Sum,
    /// Count of values.
    Count,
    /// Standard deviation.
    StdDev,
}

impl Default for MetricAggregation {
    fn default() -> MetricAggregation { MetricAggregation::Mean }
}

/// Quality score from external evaluation.
///
/// Marked with `~` evidentiality as it comes from external/LLM evaluation.
#[derive(Clone, Debug)]
struct QualityScore~ {
    /// Overall quality score (0.0 - 1.0).
    overall~: f64,
    /// Coherence score.
    coherence~: Option<f64>,
    /// Relevance score.
    relevance~: Option<f64>,
    /// Helpfulness score.
    helpfulness~: Option<f64>,
    /// Factual accuracy score.
    accuracy~: Option<f64>,
    /// Free-form feedback.
    feedback~: Option<str>,
}

impl QualityScore~ {
    /// Creates a quality score with overall rating.
    fn new(overall~: f64) -> QualityScore~ {
        QualityScore~ {
            overall~: overall~.clamp(0.0, 1.0),
            coherence~: None,
            relevance~: None,
            helpfulness~: None,
            accuracy~: None,
            feedback~: None,
        }
    }

    /// Adds coherence score.
    fn with_coherence(mut self, score~: f64) -> QualityScore~ {
        self.coherence~ = Some(score~.clamp(0.0, 1.0))
        self
    }

    /// Adds relevance score.
    fn with_relevance(mut self, score~: f64) -> QualityScore~ {
        self.relevance~ = Some(score~.clamp(0.0, 1.0))
        self
    }

    /// Adds helpfulness score.
    fn with_helpfulness(mut self, score~: f64) -> QualityScore~ {
        self.helpfulness~ = Some(score~.clamp(0.0, 1.0))
        self
    }

    /// Adds accuracy score.
    fn with_accuracy(mut self, score~: f64) -> QualityScore~ {
        self.accuracy~ = Some(score~.clamp(0.0, 1.0))
        self
    }

    /// Adds feedback.
    fn with_feedback(mut self, feedback~: impl Into<str>) -> QualityScore~ {
        self.feedback~ = Some(feedback~.into())
        self
    }

    /// Calculates a composite score from all dimensions.
    fn composite(self) -> f64 {
        let mut sum = self.overall~
        let mut count = 1.0

        if let Some(c) = self.coherence~ { sum += c; count += 1.0 }
        if let Some(r) = self.relevance~ { sum += r; count += 1.0 }
        if let Some(h) = self.helpfulness~ { sum += h; count += 1.0 }
        if let Some(a) = self.accuracy~ { sum += a; count += 1.0 }

        sum / count
    }
}

/// Snapshot of metrics for a variant at a point in time.
#[derive(Clone)]
struct MetricSnapshot {
    /// Variant name.
    variant_name: str,
    /// Sample count.
    sample_count: u64,
    /// Metrics with their aggregated values.
    metrics: HashMap<MetricType, f64>,
    /// When the snapshot was taken.
    timestamp: Instant,
}

impl MetricSnapshot {
    /// Gets a metric value.
    fn get(self, metric_type: &MetricType) -> Option<f64> {
        self.metrics.get(metric_type).copied()
    }

    /// Gets latency.
    fn latency(self) -> Option<f64> { self.get(&MetricType::Latency) }

    /// Gets tokens per second.
    fn tokens_per_second(self) -> Option<f64> { self.get(&MetricType::TokensPerSecond) }

    /// Gets error rate.
    fn error_rate(self) -> Option<f64> { self.get(&MetricType::ErrorRate) }

    /// Gets quality score.
    fn quality_score(self) -> Option<f64> { self.get(&MetricType::QualityScore) }
}

/// Metrics for a single variant.
struct VariantMetrics {
    /// Variant name.
    name: str,
    /// Raw latency samples (ms).
    latencies: RwLock<[f64]>,
    /// Time to first token samples (ms).
    ttft: RwLock<[f64]>,
    /// Total tokens per request.
    total_tokens: RwLock<[u32]>,
    /// Prompt tokens per request.
    prompt_tokens: RwLock<[u32]>,
    /// Completion tokens per request.
    completion_tokens: RwLock<[u32]>,
    /// Error count.
    error_count: AtomicU64,
    /// Success count.
    success_count: AtomicU64,
    /// Quality scores.
    quality_scores: RwLock<[f64]>,
    /// User preference votes.
    preference_votes: AtomicU64,
    /// Custom metrics.
    custom_metrics: RwLock<HashMap<str, [f64]>>,
    /// Costs per request.
    costs: RwLock<[f64]>,
}

impl VariantMetrics {
    /// Creates metrics for a variant.
    fn new(name: impl Into<str>) -> VariantMetrics {
        VariantMetrics {
            name: name.into(),
            latencies: RwLock::new([]),
            ttft: RwLock::new([]),
            total_tokens: RwLock::new([]),
            prompt_tokens: RwLock::new([]),
            completion_tokens: RwLock::new([]),
            error_count: AtomicU64::new(0),
            success_count: AtomicU64::new(0),
            quality_scores: RwLock::new([]),
            preference_votes: AtomicU64::new(0),
            custom_metrics: RwLock::new(HashMap::new()),
            costs: RwLock::new([]),
        }
    }

    /// Records a successful response.
    ///
    /// Response is marked with `~` as it comes from LLM output.
    fn record_success(self, response~: &GenerateResponse, latency_ms: f64) {
        self.success_count.fetch_add(1, Ordering::Relaxed)
        self.latencies.write().push(latency_ms)

        if let Some(usage) = &response~.usage {
            self.total_tokens.write().push(usage.total_tokens)
            self.prompt_tokens.write().push(usage.prompt_tokens)
            self.completion_tokens.write().push(usage.completion_tokens)
        }
    }

    /// Records a streaming response with TTFT.
    fn record_stream_success(self, response~: &GenerateResponse, latency_ms: f64, ttft_ms: f64) {
        self.record_success(response~, latency_ms)
        self.ttft.write().push(ttft_ms)
    }

    /// Records an error.
    fn record_error(self) {
        self.error_count.fetch_add(1, Ordering::Relaxed)
    }

    /// Records a quality score.
    fn record_quality(self, score~: &QualityScore~) {
        self.quality_scores.write().push(score~.composite())
    }

    /// Records a user preference vote.
    fn record_preference_vote(self) {
        self.preference_votes.fetch_add(1, Ordering::Relaxed)
    }

    /// Records a custom metric.
    fn record_custom(self, name: &str, value: f64) {
        let mut custom = self.custom_metrics.write()
        custom.entry(name.to_string()).or_insert([]).push(value)
    }

    /// Records cost for a request.
    fn record_cost(self, cost: f64) {
        self.costs.write().push(cost)
    }

    /// Gets total sample count.
    fn sample_count(self) -> u64 {
        self.success_count.load(Ordering::Relaxed) + self.error_count.load(Ordering::Relaxed)
    }

    /// Aggregates a metric using the specified method.
    fn aggregate(self, metric_type: &MetricType, method: &MetricAggregation) -> Option<f64> {
        let values = match metric_type {
            MetricType::Latency => self.latencies.read().clone(),
            MetricType::TimeToFirstToken => self.ttft.read().clone(),
            MetricType::TokensPerSecond => {
                let latencies = self.latencies.read()
                let completion = self.completion_tokens.read()
                latencies.iter().zip(completion.iter())
                    |τ{|(lat, tokens)| if *lat > 0.0 { (*tokens as f64 / *lat) * 1000.0 } else { 0.0 }}
                    |collect
            },
            MetricType::TotalTokens => self.total_tokens.read()|τ{|t| *t as f64}|collect,
            MetricType::PromptTokens => self.prompt_tokens.read()|τ{|t| *t as f64}|collect,
            MetricType::CompletionTokens => self.completion_tokens.read()|τ{|t| *t as f64}|collect,
            MetricType::ErrorRate => {
                let errors = self.error_count.load(Ordering::Relaxed) as f64
                let total = self.sample_count() as f64
                return if total > 0.0 { Some(errors / total) } else { None }
            },
            MetricType::Cost => self.costs.read().clone(),
            MetricType::QualityScore => self.quality_scores.read().clone(),
            MetricType::UserPreference => {
                return Some(self.preference_votes.load(Ordering::Relaxed) as f64)
            },
            MetricType::Custom(name) => {
                self.custom_metrics.read().get(name).cloned() ?? return None
            },
        }

        if values.is_empty() {
            return None
        }

        Some(self.compute_aggregation(&values, method))
    }

    /// Computes an aggregation over values.
    fn compute_aggregation(self, values: &[f64], method: &MetricAggregation) -> f64 {
        match method {
            MetricAggregation::Mean => {
                values|Σ / values.len() as f64
            },
            MetricAggregation::Median => {
                let mut sorted = values.to_vec()
                sorted.sort_by(cmp_f64)
                let mid = sorted.len() / 2
                if sorted.len() % 2 == 0 {
                    (sorted[mid - 1] + sorted[mid]) / 2.0
                } else {
                    sorted[mid]
                }
            },
            MetricAggregation::Percentile(p) => {
                let mut sorted = values.to_vec()
                sorted.sort_by(cmp_f64)
                let idx = ((p * sorted.len() as f64) as usize).min(sorted.len() - 1)
                sorted[idx]
            },
            MetricAggregation::Min => values|ρ·min ?? 0.0,
            MetricAggregation::Max => values|ρ·max ?? 0.0,
            MetricAggregation::Sum => values|Σ,
            MetricAggregation::Count => values.len() as f64,
            MetricAggregation::StdDev => {
                let mean = values|Σ / values.len() as f64
                let variance = values
                    |τ{|v| (v - mean).powi(2)}
                    |Σ / values.len() as f64
                variance.sqrt()
            },
        }
    }

    /// Creates a snapshot of current metrics.
    fn snapshot(self, aggregation: &MetricAggregation) -> MetricSnapshot {
        let mut metrics = HashMap::new()

        let metric_types = [
            MetricType::Latency,
            MetricType::TimeToFirstToken,
            MetricType::TokensPerSecond,
            MetricType::TotalTokens,
            MetricType::ErrorRate,
            MetricType::QualityScore,
            MetricType::Cost,
        ]

        for metric_type in metric_types {
            if let Some(value) = self.aggregate(&metric_type, aggregation) {
                metrics.insert(metric_type, value)
            }
        }

        MetricSnapshot {
            variant_name: self.name.clone(),
            sample_count: self.sample_count(),
            metrics,
            timestamp: Instant::now(),
        }
    }

    /// Gets latency statistics.
    fn latency_stats(self) -> LatencyStats {
        let latencies = self.latencies.read()
        LatencyStats::from_samples(&latencies)
    }
}

/// Latency statistics.
#[derive(Clone, Debug)]
struct LatencyStats {
    /// Mean latency (ms).
    mean: f64,
    /// Median latency (ms).
    median: f64,
    /// P95 latency (ms).
    p95: f64,
    /// P99 latency (ms).
    p99: f64,
    /// Min latency (ms).
    min: f64,
    /// Max latency (ms).
    max: f64,
    /// Standard deviation.
    std_dev: f64,
    /// Sample count.
    count: usize,
}

impl LatencyStats {
    /// Computes statistics from samples.
    fn from_samples(samples: &[f64]) -> LatencyStats {
        if samples.is_empty() {
            return LatencyStats {
                mean: 0.0, median: 0.0, p95: 0.0, p99: 0.0,
                min: 0.0, max: 0.0, std_dev: 0.0, count: 0,
            }
        }

        let mut sorted = samples.to_vec()
        sorted.sort_by(cmp_f64)

        let sum: f64 = samples|Σ
        let mean = sum / samples.len() as f64

        let variance = samples
            |τ{|v| (v - mean).powi(2)}
            |Σ / samples.len() as f64

        let percentile = |p: f64| {
            let idx = ((p * sorted.len() as f64) as usize).min(sorted.len() - 1)
            sorted[idx]
        }

        LatencyStats {
            mean,
            median: percentile(0.5),
            p95: percentile(0.95),
            p99: percentile(0.99),
            min: sorted[0],
            max: sorted[sorted.len() - 1],
            std_dev: variance.sqrt(),
            count: samples.len(),
        }
    }
}

/// Collector for all variant metrics in an experiment.
struct ABMetrics {
    /// Metrics per variant.
    variants: HashMap<str, VariantMetrics>,
    /// Default aggregation method.
    default_aggregation: MetricAggregation,
    /// Start time.
    started_at: Instant,
}

impl ABMetrics {
    /// Creates a new metrics collector.
    fn new(variant_names: &[str]) -> ABMetrics {
        let variants = variant_names
            |τ{|name| (name.clone(), VariantMetrics::new(name))}
            |collect

        ABMetrics {
            variants,
            default_aggregation: MetricAggregation::Mean,
            started_at: Instant::now(),
        }
    }

    /// Sets the default aggregation method.
    fn with_aggregation(mut self, aggregation: MetricAggregation) -> ABMetrics {
        self.default_aggregation = aggregation
        self
    }

    /// Gets metrics for a variant.
    fn get(self, variant_name: &str) -> Option<&VariantMetrics> {
        self.variants.get(variant_name)
    }

    /// Gets mutable metrics for a variant.
    fn get_mut(mut self, variant_name: &str) -> Option<&mut VariantMetrics> {
        self.variants.get_mut(variant_name)
    }

    /// Records a successful response for a variant.
    fn record_success(self, variant_name: &str, response~: &GenerateResponse, latency_ms: f64) {
        if let Some(metrics) = self.get_mut(variant_name) {
            metrics.record_success(response~, latency_ms)
        }
    }

    /// Records an error for a variant.
    fn record_error(self, variant_name: &str) {
        if let Some(metrics) = self.get_mut(variant_name) {
            metrics.record_error()
        }
    }

    /// Gets total sample count across all variants.
    fn total_samples(self) -> u64 {
        self.variants.values()|τ{|m| m.sample_count()}|Σ
    }

    /// Gets snapshots for all variants.
    fn snapshots(self) -> [MetricSnapshot] {
        self.variants.values()
            |τ{|m| m.snapshot(&self.default_aggregation)}
            |collect
    }

    /// Compares two variants on a specific metric.
    fn compare(self, variant_a: &str, variant_b: &str, metric: &MetricType) -> Option<(f64, f64)> {
        let a = self.get(variant_a)?.aggregate(metric, &self.default_aggregation)?
        let b = self.get(variant_b)?.aggregate(metric, &self.default_aggregation)?
        Some((a, b))
    }

    /// Gets the elapsed time since start.
    fn elapsed(self) -> Duration {
        self.started_at.elapsed()
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    fn mock_response(prompt_tokens: u32, completion_tokens: u32) -> GenerateResponse {
        GenerateResponse {
            choices: [],
            usage: Some(Usage {
                prompt_tokens,
                completion_tokens,
                total_tokens: prompt_tokens + completion_tokens,
            }),
        }
    }

    #[test]
    fn test_variant_metrics_basic() {
        let metrics = VariantMetrics::new("test")

        let response = mock_response(10, 20)
        metrics.record_success(&response, 100.0)
        metrics.record_success(&response, 150.0)
        metrics.record_error()

        assert_eq!(metrics.sample_count(), 3)
        assert_eq!(metrics.success_count.load(Ordering::Relaxed), 2)
        assert_eq!(metrics.error_count.load(Ordering::Relaxed), 1)
    }

    #[test]
    fn test_latency_aggregation() {
        let metrics = VariantMetrics::new("test")

        for lat in [100.0, 120.0, 140.0, 160.0, 180.0] {
            metrics.record_success(&mock_response(10, 20), lat)
        }

        let mean = metrics.aggregate(&MetricType::Latency, &MetricAggregation::Mean)
        assert_eq!(mean, Some(140.0))

        let median = metrics.aggregate(&MetricType::Latency, &MetricAggregation::Median)
        assert_eq!(median, Some(140.0))

        let min = metrics.aggregate(&MetricType::Latency, &MetricAggregation::Min)
        assert_eq!(min, Some(100.0))

        let max = metrics.aggregate(&MetricType::Latency, &MetricAggregation::Max)
        assert_eq!(max, Some(180.0))
    }

    #[test]
    fn test_error_rate() {
        let metrics = VariantMetrics::new("test")

        metrics.record_success(&mock_response(10, 20), 100.0)
        metrics.record_success(&mock_response(10, 20), 100.0)
        metrics.record_success(&mock_response(10, 20), 100.0)
        metrics.record_error()

        let error_rate = metrics.aggregate(&MetricType::ErrorRate, &MetricAggregation::Mean)
        assert_eq!(error_rate, Some(0.25))  // 1 error out of 4
    }

    #[test]
    fn test_quality_score() {
        let score = QualityScore~::new(0.8)
            |with_coherence{0.9}
            |with_relevance{0.85}
            |with_helpfulness{0.75}

        assert!((score.composite() - 0.825).abs() < 0.01)
    }

    #[test]
    fn test_ab_metrics_collection() {
        let ab = ABMetrics::new(&["control", "treatment"])

        ab.record_success("control", &mock_response(10, 20), 100.0)
        ab.record_success("control", &mock_response(10, 20), 120.0)
        ab.record_success("treatment", &mock_response(10, 25), 90.0)
        ab.record_success("treatment", &mock_response(10, 25), 95.0)

        let (control_lat, treatment_lat) = ab.compare("control", "treatment", &MetricType::Latency).unwrap()
        assert_eq!(control_lat, 110.0)  // Mean of 100, 120
        assert_eq!(treatment_lat, 92.5) // Mean of 90, 95
    }

    #[test]
    fn test_latency_stats() {
        let samples = [10.0, 20.0, 30.0, 40.0, 50.0, 60.0, 70.0, 80.0, 90.0, 100.0]
        let stats = LatencyStats::from_samples(&samples)

        assert_eq!(stats.mean, 55.0)
        assert_eq!(stats.min, 10.0)
        assert_eq!(stats.max, 100.0)
        assert_eq!(stats.count, 10)
    }
}
