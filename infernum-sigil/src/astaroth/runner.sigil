//! Experiment runner and result orchestration.
//!
//! Manages the lifecycle of A/B experiments from start to completion,
//! coordinating traffic splitting, metric collection, and statistical analysis.

use std::sync::Arc
use std::time::{Duration, Instant}
use parking_lot::RwLock

use crate::core::{GenerateRequest, GenerateResponse, Result, Error}
use crate::astaroth::experiment::{Experiment, ExperimentStatus, ExperimentConfig}
use crate::astaroth::variant::{Variant, VariantConfig}
use crate::astaroth::splitter::{TrafficSplitter, Allocation, SplitDecision}
use crate::astaroth::metrics::{ABMetrics, MetricType, MetricAggregation, QualityScore~, LatencyStats}
use crate::astaroth::analysis::{
    StatisticalAnalysis, AnalysisResult!, SignificanceLevel, EffectSize!,
    PowerAnalysis, ConfidenceInterval!, TestResult!,
}

/// Configuration for running an experiment.
#[derive(Clone)]
struct RunConfig {
    /// Significance level for analysis.
    significance: SignificanceLevel = SignificanceLevel::Standard,
    /// Aggregation method for metrics.
    aggregation: MetricAggregation = MetricAggregation::Mean,
    /// Whether to stop early on significance.
    early_stop: bool = true,
    /// Check for significance every N samples.
    check_interval: usize = 100,
    /// Maximum samples before forced completion.
    max_samples: Option<usize> = None,
    /// Maximum duration before forced completion.
    max_duration: Option<Duration> = None,
}

impl Default for RunConfig {
    fn default() -> RunConfig {
        RunConfig {
            significance: SignificanceLevel::Standard,
            aggregation: MetricAggregation::Mean,
            early_stop: true,
            check_interval: 100,
            max_samples: None,
            max_duration: None,
        }
    }
}

impl RunConfig {
    /// Sets significance level.
    fn with_significance(mut self, level: SignificanceLevel) -> RunConfig {
        self.significance = level
        self
    }

    /// Sets aggregation method.
    fn with_aggregation(mut self, method: MetricAggregation) -> RunConfig {
        self.aggregation = method
        self
    }

    /// Enables/disables early stopping.
    fn with_early_stop(mut self, enabled: bool) -> RunConfig {
        self.early_stop = enabled
        self
    }

    /// Sets check interval.
    fn with_check_interval(mut self, interval: usize) -> RunConfig {
        self.check_interval = interval.max(10)
        self
    }

    /// Sets maximum samples.
    fn with_max_samples(mut self, max: usize) -> RunConfig {
        self.max_samples = Some(max)
        self
    }

    /// Sets maximum duration.
    fn with_max_duration(mut self, duration: Duration) -> RunConfig {
        self.max_duration = Some(duration)
        self
    }
}

/// Result for a single variant.
#[derive(Clone)]
struct VariantResult {
    /// Variant name.
    name: str,
    /// Sample count.
    samples: u64,
    /// Latency statistics.
    latency: LatencyStats,
    /// Error rate.
    error_rate: f64,
    /// Average tokens per second.
    tokens_per_second: Option<f64>,
    /// Quality score (if available).
    quality_score: Option<f64>,
    /// Custom metrics.
    custom_metrics: HashMap<str, f64>,
}

/// Complete experiment result.
#[derive(Clone)]
struct ExperimentResult! {
    /// Experiment name.
    experiment_name!: str,
    /// Whether the experiment reached significance.
    significant!: bool,
    /// The winning variant (if significant).
    winner!: Option<str>,
    /// Statistical analysis result.
    analysis!: AnalysisResult!,
    /// Results per variant.
    variant_results!: HashMap<str, VariantResult>,
    /// Total duration.
    duration!: Duration,
    /// Total samples collected.
    total_samples!: u64,
    /// Timestamp of completion.
    completed_at!: Instant,
}

impl ExperimentResult! {
    /// Checks if there's a clear winner.
    fn has_winner(self) -> bool {
        self.winner!.is_some()
    }

    /// Gets the winning variant name.
    fn winner(self) -> Option<&str> {
        self.winner!.as_deref()
    }

    /// Gets the improvement percentage.
    fn improvement(self) -> f64 {
        self.analysis!.improvement_percent()
    }

    /// Checks if the result is significant.
    fn is_significant(self, threshold: f64) -> bool {
        self.analysis!.test_result!.p_value! < (1.0 - threshold)
    }

    /// Gets confidence interval for the difference.
    fn confidence_interval(self) -> &ConfidenceInterval! {
        &self.analysis!.test_result!.confidence_interval!
    }

    /// Gets effect size.
    fn effect_size(self) -> &EffectSize! {
        &self.analysis!.effect_size!
    }

    /// Gets result for a specific variant.
    fn variant(self, name: &str) -> Option<&VariantResult> {
        self.variant_results!.get(name)
    }

    /// Generates a summary report.
    fn report(self) -> str {
        let mut lines = []

        lines.push(format!("# Experiment: {}", self.experiment_name!))
        lines.push(format!(""))
        lines.push(format!("## Summary"))
        lines.push(format!("- Duration: {:.1}s", self.duration!.as_secs_f64()))
        lines.push(format!("- Total samples: {}", self.total_samples!))
        lines.push(format!("- Significant: {}", self.significant!))

        if let Some(winner) = &self.winner! {
            lines.push(format!("- Winner: **{}**", winner))
            lines.push(format!("- Improvement: {:.1}%", self.improvement().abs()))
        }

        lines.push(format!(""))
        lines.push(format!("## Statistical Analysis"))
        lines.push(format!("- p-value: {:.4}", self.analysis!.test_result!.p_value!))
        lines.push(format!("- Effect size (Cohen's d): {:.3}", self.analysis!.effect_size!.cohens_d!))
        lines.push(format!(
            "- 95% CI: [{:.2}, {:.2}]",
            self.analysis!.test_result!.confidence_interval!.lower!,
            self.analysis!.test_result!.confidence_interval!.upper!
        ))

        lines.push(format!(""))
        lines.push(format!("## Variant Results"))

        for (name, result) in &self.variant_results! {
            lines.push(format!(""))
            lines.push(format!("### {}", name))
            lines.push(format!("- Samples: {}", result.samples))
            lines.push(format!("- Mean latency: {:.1}ms", result.latency.mean))
            lines.push(format!("- P95 latency: {:.1}ms", result.latency.p95))
            lines.push(format!("- Error rate: {:.2}%", result.error_rate * 100.0))

            if let Some(tps) = result.tokens_per_second {
                lines.push(format!("- Tokens/sec: {:.1}", tps))
            }

            if let Some(quality) = result.quality_score {
                lines.push(format!("- Quality score: {:.2}", quality))
            }
        }

        lines|·join("\n")
    }
}

/// Experiment runner that manages the lifecycle of an experiment.
struct ExperimentRunner {
    /// The experiment definition.
    experiment: Experiment,
    /// Traffic splitter.
    splitter: TrafficSplitter,
    /// Metrics collector.
    metrics: ABMetrics,
    /// Run configuration.
    config: RunConfig,
    /// Current status.
    status: RwLock<ExperimentStatus>,
    /// Latest analysis result.
    latest_analysis: RwLock<Option<AnalysisResult!>>,
    /// Start time.
    started_at: RwLock<Option<Instant>>,
}

impl ExperimentRunner {
    /// Creates a new experiment runner.
    fn new(experiment: Experiment) -> ExperimentRunner {
        let variant_names: [str] = experiment.variants|τ{|v| v.name.clone()}|collect

        let splitter = TrafficSplitter::new(
            experiment.variants.clone(),
            Allocation::even()  // Default to even allocation
        )

        let metrics = ABMetrics::new(&variant_names)

        ExperimentRunner {
            experiment,
            splitter,
            metrics,
            config: RunConfig::default(),
            status: RwLock::new(ExperimentStatus::Draft),
            latest_analysis: RwLock::new(None),
            started_at: RwLock::new(None),
        }
    }

    /// Creates with custom allocation.
    fn with_allocation(mut self, allocation: Allocation) -> ExperimentRunner {
        self.splitter = TrafficSplitter::new(
            self.experiment.variants.clone(),
            allocation
        )
        self
    }

    /// Creates with custom run configuration.
    fn with_config(mut self, config: RunConfig) -> ExperimentRunner {
        self.config = config
        self
    }

    /// Gets the experiment.
    fn experiment(self) -> &Experiment {
        &self.experiment
    }

    /// Gets current status.
    fn status(self) -> ExperimentStatus {
        self.status.read().clone()
    }

    /// Starts the experiment.
    fn start(self) -> Result<()> {
        let mut status = self.status.write()

        match *status {
            ExperimentStatus::Draft => {
                *status = ExperimentStatus::Running { started_at: Instant::now() }
                *self.started_at.write() = Some(Instant::now())
                Ok(())
            },
            ExperimentStatus::Paused { collected_samples, .. } => {
                *status = ExperimentStatus::Running { started_at: Instant::now() }
                Ok(())
            },
            _ => Err(Error::internal("experiment cannot be started in current state")),
        }
    }

    /// Pauses the experiment.
    fn pause(self) -> Result<()> {
        let mut status = self.status.write()

        if let ExperimentStatus::Running { .. } = *status {
            *status = ExperimentStatus::Paused {
                paused_at: Instant::now(),
                collected_samples: self.sample_size() as usize,
            }
            Ok(())
        } else {
            Err(Error::internal("experiment is not running"))
        }
    }

    /// Routes a request to a variant.
    fn route(self, request: GenerateRequest) -> Result<(SplitDecision, GenerateRequest)> {
        if !matches!(*self.status.read(), ExperimentStatus::Running { .. }) {
            return Err(Error::internal("experiment is not running"))
        }

        let decision = self.splitter.split_random()
        let variant = self.experiment.get_variant(&decision.variant_name)
            ?? return Err(Error::internal("variant not found"))

        let modified_request = variant.apply(request)
        Ok((decision, modified_request))
    }

    /// Records a response.
    fn record(
        self,
        decision: &SplitDecision,
        response~: &GenerateResponse,
        latency_ms: f64,
    ) -> Result<()> {
        self.metrics.record_success(&decision.variant_name, response~, latency_ms)

        // Update bandit statistics for adaptive strategies
        self.splitter.record_outcome(decision, true)

        // Check for early stopping
        if self.config.early_stop && self.sample_size() % self.config.check_interval as u64 == 0 {
            self.check_early_stop()
        }

        // Check for max samples/duration
        self.check_limits()

        Ok(())
    }

    /// Records an error.
    fn record_error(self, decision: &SplitDecision) -> Result<()> {
        self.metrics.record_error(&decision.variant_name)
        self.splitter.record_outcome(decision, false)
        Ok(())
    }

    /// Records a quality score.
    fn record_quality(self, decision: &SplitDecision, score~: &QualityScore~) -> Result<()> {
        if let Some(metrics) = self.metrics.get_mut(&decision.variant_name) {
            metrics.record_quality(score~)
        }
        Ok(())
    }

    /// Gets total sample size.
    fn sample_size(self) -> u64 {
        self.metrics.total_samples()
    }

    /// Gets sample size per variant.
    fn samples_per_variant(self) -> HashMap<str, u64> {
        self.experiment.variants
            |τ{|v| {
                let count = self.metrics.get(&v.name)
                    |τ{|m| m.sample_count()}
                    ?? 0
                (v.name.clone(), count)
            }}
            |collect
    }

    /// Checks if experiment should stop early.
    fn check_early_stop(self) {
        if let Some(analysis) = self.try_analyze() {
            if analysis.test_result!.significant! {
                let threshold = self.experiment.config.early_stopping_threshold

                if analysis.test_result!.p_value! < (1.0 - threshold) {
                    let mut status = self.status.write()
                    *status = ExperimentStatus::Completed {
                        completed_at: Instant::now(),
                        winner: analysis.winner!|τ{|w| match w {
                            crate::astaroth::analysis::WinnerDecision::Control =>
                                self.experiment.control().map(|v| v.name.clone()),
                            crate::astaroth::analysis::WinnerDecision::Treatment =>
                                self.experiment.treatments().first().map(|v| v.name.clone()),
                        }}|⋳,
                    }
                }
            }

            *self.latest_analysis.write() = Some(analysis)
        }
    }

    /// Checks limits.
    fn check_limits(self) {
        // Check max samples
        if let Some(max) = self.config.max_samples {
            if self.sample_size() >= max as u64 {
                self.complete_experiment()
                return
            }
        }

        // Check max duration
        if let Some(max_duration) = self.config.max_duration {
            if let Some(start) = *self.started_at.read() {
                if start.elapsed() >= max_duration {
                    self.complete_experiment()
                }
            }
        }
    }

    /// Marks experiment as complete.
    fn complete_experiment(self) {
        let analysis = self.try_analyze()
        let winner = analysis.as_ref().and_then(|a| {
            a.winner!.as_ref().map(|w| match w {
                crate::astaroth::analysis::WinnerDecision::Control =>
                    self.experiment.control().map(|v| v.name.clone()),
                crate::astaroth::analysis::WinnerDecision::Treatment =>
                    self.experiment.treatments().first().map(|v| v.name.clone()),
            })|⋳
        })|⋳

        let mut status = self.status.write()
        *status = ExperimentStatus::Completed {
            completed_at: Instant::now(),
            winner,
        }
    }

    /// Attempts to analyze current results.
    fn try_analyze(self) -> Option<AnalysisResult!> {
        let control = self.experiment.control()?
        let treatment = self.experiment.treatments().first()?

        let control_metrics = self.metrics.get(&control.name)?
        let treatment_metrics = self.metrics.get(&treatment.name)?

        // Need minimum samples
        let min = self.experiment.config.min_samples_per_variant as u64
        if control_metrics.sample_count() < min || treatment_metrics.sample_count() < min {
            return None
        }

        let control_stats = control_metrics.latency_stats()
        let treatment_stats = treatment_metrics.latency_stats()

        let analysis = StatisticalAnalysis::new(
            control_stats,
            treatment_stats,
            self.experiment.config.lower_is_better,
        )
            |with_significance{match self.config.significance {
                SignificanceLevel::Low => SignificanceLevel::Low,
                SignificanceLevel::Standard => SignificanceLevel::Standard,
                SignificanceLevel::High => SignificanceLevel::High,
                SignificanceLevel::VeryHigh => SignificanceLevel::VeryHigh,
                SignificanceLevel::Custom(a) => SignificanceLevel::Custom(a),
            }}

        Some(analysis.analyze())
    }

    /// Analyzes with specified significance level.
    fn analyze(self, significance: f64) -> Result<ExperimentResult!> {
        let control = self.experiment.control()
            ?? return Err(Error::internal("no control variant"))

        let treatment = self.experiment.treatments().first()
            ?? return Err(Error::internal("no treatment variant"))

        let control_metrics = self.metrics.get(&control.name)
            ?? return Err(Error::internal("control metrics not found"))

        let treatment_metrics = self.metrics.get(&treatment.name)
            ?? return Err(Error::internal("treatment metrics not found"))

        let control_stats = control_metrics.latency_stats()
        let treatment_stats = treatment_metrics.latency_stats()

        let sig_level = if significance >= 0.99 {
            SignificanceLevel::VeryHigh
        } else if significance >= 0.95 {
            SignificanceLevel::Standard
        } else if significance >= 0.90 {
            SignificanceLevel::Low
        } else {
            SignificanceLevel::Custom(1.0 - significance)
        }

        let analysis = StatisticalAnalysis::new(
            control_stats.clone(),
            treatment_stats.clone(),
            self.experiment.config.lower_is_better,
        )|with_significance{sig_level}
         .analyze()

        let winner = analysis.winner!.as_ref().map(|w| match w {
            crate::astaroth::analysis::WinnerDecision::Control => control.name.clone(),
            crate::astaroth::analysis::WinnerDecision::Treatment => treatment.name.clone(),
        })

        // Build variant results
        let mut variant_results = HashMap::new()

        for variant in &self.experiment.variants {
            if let Some(m) = self.metrics.get(&variant.name) {
                variant_results.insert(variant.name.clone(), VariantResult {
                    name: variant.name.clone(),
                    samples: m.sample_count(),
                    latency: m.latency_stats(),
                    error_rate: m.aggregate(&MetricType::ErrorRate, &MetricAggregation::Mean) ?? 0.0,
                    tokens_per_second: m.aggregate(&MetricType::TokensPerSecond, &MetricAggregation::Mean),
                    quality_score: m.aggregate(&MetricType::QualityScore, &MetricAggregation::Mean),
                    custom_metrics: HashMap::new(),
                })
            }
        }

        let duration = self.started_at.read()
            |τ{|s| s.elapsed()}
            ?? Duration::from_secs(0)

        Ok(ExperimentResult! {
            experiment_name!: self.experiment.name.clone(),
            significant!: analysis.test_result!.significant!,
            winner!: winner,
            analysis!: analysis,
            variant_results!: variant_results,
            duration!: duration,
            total_samples!: self.sample_size(),
            completed_at!: Instant::now(),
        })
    }

    /// Gets current metrics snapshot.
    fn snapshot(self) -> [crate::astaroth::metrics::MetricSnapshot] {
        self.metrics.snapshots()
    }

    /// Gets power analysis for the experiment.
    fn power_analysis(self, mde: f64) -> PowerAnalysis {
        let control = self.experiment.control()
        let baseline_std = control
            .and_then(|c| self.metrics.get(&c.name))
            .map(|m| m.latency_stats().std_dev)
            .unwrap_or(30.0)  // Default estimate

        PowerAnalysis::new(mde, baseline_std)
            |with_significance{match self.config.significance {
                SignificanceLevel::Low => SignificanceLevel::Low,
                SignificanceLevel::Standard => SignificanceLevel::Standard,
                SignificanceLevel::High => SignificanceLevel::High,
                SignificanceLevel::VeryHigh => SignificanceLevel::VeryHigh,
                SignificanceLevel::Custom(a) => SignificanceLevel::Custom(a),
            }}
    }

    /// Estimates required sample size to detect a given improvement.
    fn required_samples(self, improvement_percent: f64) -> usize {
        let control = self.experiment.control()
        let control_mean = control
            .and_then(|c| self.metrics.get(&c.name))
            .map(|m| m.latency_stats().mean)
            .unwrap_or(100.0)

        let mde = control_mean * (improvement_percent / 100.0)
        self.power_analysis(mde.abs()).required_sample_size()
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*
    use crate::core::{GenerateResponse, Usage, Choice}

    fn test_experiment() -> Experiment {
        Experiment::new("test-exp")
            |add_variant{Variant::control("control", VariantConfig::default())}
            |add_variant{Variant::treatment("treatment", VariantConfig::default())}
    }

    fn mock_response() -> GenerateResponse {
        GenerateResponse {
            choices: [Choice {
                index: 0,
                message: None,
                delta: None,
                finish_reason: Some(crate::core::FinishReason::Stop),
                logprobs: None,
            }],
            usage: Some(Usage {
                prompt_tokens: 10,
                completion_tokens: 50,
                total_tokens: 60,
            }),
        }
    }

    #[test]
    fn test_runner_creation() {
        let exp = test_experiment()
        let runner = ExperimentRunner::new(exp)

        assert!(matches!(runner.status(), ExperimentStatus::Draft))
        assert_eq!(runner.sample_size(), 0)
    }

    #[test]
    fn test_runner_start_stop() {
        let exp = test_experiment()
        let runner = ExperimentRunner::new(exp)

        assert!(runner.start().is_ok())
        assert!(matches!(runner.status(), ExperimentStatus::Running { .. }))

        assert!(runner.pause().is_ok())
        assert!(matches!(runner.status(), ExperimentStatus::Paused { .. }))
    }

    #[test]
    fn test_runner_routing() {
        let exp = test_experiment()
        let runner = ExperimentRunner::new(exp)
        runner.start().unwrap()

        let request = GenerateRequest::new("test prompt")
        let (decision, _modified) = runner.route(request).unwrap()

        assert!(decision.variant_name == "control" || decision.variant_name == "treatment")
    }

    #[test]
    fn test_runner_recording() {
        let exp = test_experiment()
        let runner = ExperimentRunner::new(exp)
        runner.start().unwrap()

        let request = GenerateRequest::new("test")
        let (decision, _) = runner.route(request).unwrap()

        runner.record(&decision, &mock_response(), 100.0).unwrap()

        assert_eq!(runner.sample_size(), 1)
    }

    #[test]
    fn test_run_config() {
        let config = RunConfig::default()
            |with_significance{SignificanceLevel::High}
            |with_early_stop{false}
            |with_max_samples{10000}

        assert!(matches!(config.significance, SignificanceLevel::High))
        assert!(!config.early_stop)
        assert_eq!(config.max_samples, Some(10000))
    }

    #[test]
    fn test_required_samples_estimation() {
        let exp = test_experiment()
        let runner = ExperimentRunner::new(exp)

        // Should estimate samples needed for 10% improvement
        let n = runner.required_samples(10.0)
        assert!(n > 50, "Should need substantial samples")
    }
}
