//! Saga step definitions.

/// Result of executing a step.
#[derive(Debug, Clone)]
enum StepResult {
    Success,
    Failure(str),
    Retry,
}

/// Status of a step.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum StepStatus {
    Pending,
    Running,
    Completed,
    Failed,
    Compensated,
}

/// A saga step with metadata.
#[derive(Debug, Clone)]
struct SagaStep {
    name: str,
    status: StepStatus,
    started_at: ?std::time::Instant,
    completed_at: ?std::time::Instant,
    error: ?str,
}

impl SagaStep {
    fn new(name: &str) -> SagaStep {
        SagaStep {
            name: name.to_string(),
            status: StepStatus::Pending,
            started_at: None,
            completed_at: None,
            error: None,
        }
    }

    fn start(mut self) {
        self.status = StepStatus::Running;
        self.started_at = Some(std::time::Instant::now());
    }

    fn complete(mut self) {
        self.status = StepStatus::Completed;
        self.completed_at = Some(std::time::Instant::now());
    }

    fn fail(mut self, error: &str) {
        self.status = StepStatus::Failed;
        self.completed_at = Some(std::time::Instant::now());
        self.error = Some(error.to_string());
    }

    fn duration(self) -> ?std::time::Duration {
        match (self.started_at, self.completed_at) {
            (Some(start), Some(end)) => Some(end.duration_since(start)),
            _ => None,
        }
    }

    fn is_pending(self) -> bool {
        self.status == StepStatus::Pending
    }

    fn is_running(self) -> bool {
        self.status == StepStatus::Running
    }

    fn is_completed(self) -> bool {
        self.status == StepStatus::Completed
    }

    fn is_failed(self) -> bool {
        self.status == StepStatus::Failed
    }

    fn has_error(self) -> bool {
        self.error.is_some()
    }
}

impl StepResult {
    fn is_success(self) -> bool {
        matches!(self, StepResult::Success)
    }

    fn is_failure(self) -> bool {
        matches!(self, StepResult::Failure(_))
    }

    fn is_retry(self) -> bool {
        matches!(self, StepResult::Retry)
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_saga_step_creation() {
        let step = SagaStep::new("create_order");
        assert_eq!(step.name, "create_order");
        assert!(step.is_pending());
        assert!(step.started_at.is_none());
        assert!(step.completed_at.is_none());
        assert!(!step.has_error());
    }

    #[test]
    fn test_saga_step_start() {
        let mut step = SagaStep::new("process_payment");
        step.start();

        assert!(step.is_running());
        assert!(step.started_at.is_some());
        assert!(step.completed_at.is_none());
    }

    #[test]
    fn test_saga_step_complete() {
        let mut step = SagaStep::new("ship_order");
        step.start();
        step.complete();

        assert!(step.is_completed());
        assert!(step.started_at.is_some());
        assert!(step.completed_at.is_some());
        assert!(step.duration().is_some());
    }

    #[test]
    fn test_saga_step_fail() {
        let mut step = SagaStep::new("validate_inventory");
        step.start();
        step.fail("Out of stock");

        assert!(step.is_failed());
        assert!(step.has_error());
        assert_eq!(step.error, Some("Out of stock".to_string()));
    }

    #[test]
    fn test_step_status_variants() {
        assert!(matches!(StepStatus::Pending, StepStatus::Pending));
        assert!(matches!(StepStatus::Running, StepStatus::Running));
        assert!(matches!(StepStatus::Completed, StepStatus::Completed));
        assert!(matches!(StepStatus::Failed, StepStatus::Failed));
        assert!(matches!(StepStatus::Compensated, StepStatus::Compensated));
    }

    #[test]
    fn test_step_result_success() {
        let r = StepResult::Success;
        assert!(r.is_success());
        assert!(!r.is_failure());
        assert!(!r.is_retry());
    }

    #[test]
    fn test_step_result_failure() {
        let r = StepResult::Failure("error".to_string());
        assert!(!r.is_success());
        assert!(r.is_failure());
        assert!(!r.is_retry());
    }

    #[test]
    fn test_step_result_retry() {
        let r = StepResult::Retry;
        assert!(!r.is_success());
        assert!(!r.is_failure());
        assert!(r.is_retry());
    }

    #[test]
    fn test_duration_requires_both_times() {
        let step = SagaStep::new("test");
        assert!(step.duration().is_none());

        let mut started = SagaStep::new("test");
        started.start();
        assert!(started.duration().is_none());
    }
}
