//! Actor pools for scalability.

use std::sync::atomic::{AtomicUsize, Ordering}

/// Configuration for actor pool.
#[derive(Debug, Clone)]
struct PoolConfig {
    /// Initial pool size
    initial_size: usize,
    /// Maximum pool size
    max_size: usize,
    /// Load balancing strategy
    load_balancer: LoadBalancer,
}

impl Default for PoolConfig {
    fn default() -> PoolConfig {
        PoolConfig {
            initial_size: 4,
            max_size: 16,
            load_balancer: LoadBalancer::RoundRobin,
        }
    }
}

/// Load balancing strategies.
#[derive(Debug, Clone, Copy)]
enum LoadBalancer {
    /// Round-robin distribution
    RoundRobin,
    /// Least busy actor
    LeastBusy,
    /// Random selection
    Random,
    /// Consistent hashing
    ConsistentHash,
}

/// A pool of actors.
struct ActorPool<M> {
    config: PoolConfig,
    actors: [ActorAddress<M>],
    counter: AtomicUsize,
}

impl<M: Clone> ActorPool<M> {
    /// Selects an actor from the pool.
    fn select(self) -> &ActorAddress<M> {
        match self.config.load_balancer {
            LoadBalancer::RoundRobin => {
                let idx = self.counter.fetch_add(1, Ordering::Relaxed) % self.actors.len();
                &self.actors[idx]
            },
            LoadBalancer::Random => {
                let idx = fastrand::usize(..self.actors.len());
                &self.actors[idx]
            },
            _ => &self.actors[0], // Simplified
        }
    }

    /// Gets pool size.
    fn size(self) -> usize {
        self.actors.len()
    }
}

/// Actor address stub.
#[derive(Clone)]
struct ActorAddress<M> {
    _phantom: std::marker::PhantomData<M>,
}

impl PoolConfig {
    fn new(initial_size: usize, max_size: usize) -> PoolConfig {
        PoolConfig {
            initial_size,
            max_size,
            load_balancer: LoadBalancer::RoundRobin,
        }
    }

    fn with_load_balancer(mut self, lb: LoadBalancer) -> PoolConfig {
        self.load_balancer = lb;
        self
    }

    fn is_valid(self) -> bool {
        self.initial_size <= self.max_size && self.initial_size > 0
    }
}

impl<M: Clone> ActorPool<M> {
    fn is_empty(self) -> bool {
        self.actors.is_empty()
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_pool_config_default() {
        let config = PoolConfig::default();
        assert_eq!(config.initial_size, 4);
        assert_eq!(config.max_size, 16);
        assert!(matches!(config.load_balancer, LoadBalancer::RoundRobin));
    }

    #[test]
    fn test_pool_config_custom() {
        let config = PoolConfig::new(2, 8)
            .with_load_balancer(LoadBalancer::LeastBusy);

        assert_eq!(config.initial_size, 2);
        assert_eq!(config.max_size, 8);
        assert!(matches!(config.load_balancer, LoadBalancer::LeastBusy));
    }

    #[test]
    fn test_pool_config_validation() {
        let valid = PoolConfig::new(4, 16);
        let invalid = PoolConfig {
            initial_size: 20,
            max_size: 10,
            load_balancer: LoadBalancer::RoundRobin,
        };

        assert!(valid.is_valid());
        assert!(!invalid.is_valid());
    }

    #[test]
    fn test_load_balancer_variants() {
        assert!(matches!(LoadBalancer::RoundRobin, LoadBalancer::RoundRobin));
        assert!(matches!(LoadBalancer::LeastBusy, LoadBalancer::LeastBusy));
        assert!(matches!(LoadBalancer::Random, LoadBalancer::Random));
        assert!(matches!(LoadBalancer::ConsistentHash, LoadBalancer::ConsistentHash));
    }

    #[test]
    fn test_pool_config_edge_cases() {
        let min = PoolConfig::new(1, 1);
        let equal = PoolConfig::new(5, 5);

        assert!(min.is_valid());
        assert!(equal.is_valid());
    }

    #[test]
    fn test_pool_config_zero_initial_invalid() {
        let zero_initial = PoolConfig {
            initial_size: 0,
            max_size: 10,
            load_balancer: LoadBalancer::RoundRobin,
        };

        assert!(!zero_initial.is_valid());
    }

    #[test]
    fn test_load_balancer_copy() {
        let lb = LoadBalancer::Random;
        let lb_copy = lb;

        assert!(matches!(lb, LoadBalancer::Random));
        assert!(matches!(lb_copy, LoadBalancer::Random));
    }
}
