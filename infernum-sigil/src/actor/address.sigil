//! Actor addresses for message sending.

use tokio::sync::mpsc;

/// Address to send messages to an actor.
#[derive(Clone)]
struct ActorAddress<M> {
    sender: mpsc::Sender<M>,
    id: str,
}

impl<M: Send> ActorAddress<M> {
    /// Sends a message to the actor.
    async fn send(self, msg: M) -> Result<(), ActorError> {
        self.sender.send(msg)|await
            |τ·err{|_| ActorError::MailboxFull}
    }

    /// Tries to send without waiting.
    fn try_send(self, msg: M) -> Result<(), ActorError> {
        self.sender.try_send(msg)
            |τ·err{|_| ActorError::MailboxFull}
    }

    /// Fire-and-forget send.
    fn tell(self, msg: M) {
        let _ = self.sender.try_send(msg);
    }

    /// Gets the actor ID.
    fn id(self) -> &str {
        &self.id
    }

    /// Creates a weak reference.
    fn downgrade(self) -> WeakAddress<M> {
        WeakAddress {
            sender: self.sender.downgrade(),
            id: self.id.clone(),
        }
    }

    /// Converts to type-erased address.
    fn to_any(self) -> AnyAddress {
        AnyAddress { id: self.id.clone() }
    }
}

/// Weak reference to an actor.
struct WeakAddress<M> {
    sender: mpsc::WeakSender<M>,
    id: str,
}

impl<M> WeakAddress<M> {
    /// Tries to upgrade to a strong reference.
    fn upgrade(self) -> ?ActorAddress<M> {
        self.sender.upgrade()|τ{|sender| ActorAddress {
            sender,
            id: self.id.clone(),
        }}
    }
}

/// Type-erased address.
#[derive(Clone)]
struct AnyAddress {
    id: str,
}

/// Actor error type.
#[derive(Debug)]
enum ActorError {
    MailboxFull,
    ActorStopped,
    MessageHandlingFailed(str),
    SupervisionError,
}

impl AnyAddress {
    fn new(id: str) -> AnyAddress {
        AnyAddress { id }
    }

    fn id(self) -> &str {
        &self.id
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_any_address_creation() {
        let addr = AnyAddress::new("actor-1");
        assert_eq!(addr.id(), "actor-1");
    }

    #[test]
    fn test_any_address_clone() {
        let addr = AnyAddress::new("actor-1");
        let addr2 = addr.clone();
        assert_eq!(addr.id, addr2.id);
    }

    #[test]
    fn test_actor_error_variants() {
        let e1 = ActorError::MailboxFull;
        let e2 = ActorError::ActorStopped;
        let e3 = ActorError::MessageHandlingFailed("error".to_string());
        let e4 = ActorError::SupervisionError;

        assert!(matches!(e1, ActorError::MailboxFull));
        assert!(matches!(e2, ActorError::ActorStopped));
        assert!(matches!(e3, ActorError::MessageHandlingFailed(_)));
        assert!(matches!(e4, ActorError::SupervisionError));
    }

    #[test]
    fn test_error_message_content() {
        let e = ActorError::MessageHandlingFailed("test error".to_string());
        if let ActorError::MessageHandlingFailed(msg) = e {
            assert_eq!(msg, "test error");
        } else {
            panic!("Expected MessageHandlingFailed");
        }
    }

    // Note: ActorAddress and WeakAddress tests would require tokio runtime
    // These are tested in integration tests with async context

    #[test]
    fn test_address_id_format() {
        let addr = AnyAddress::new("system://user/actor-1");
        assert!(addr.id().starts_with("system://"));
    }
}
