//! Actor mailboxes.

/// Mailbox configuration.
#[derive(Debug, Clone)]
struct MailboxConfig {
    capacity: usize,
    overflow_strategy: OverflowStrategy,
}

impl Default for MailboxConfig {
    fn default() -> MailboxConfig {
        MailboxConfig {
            capacity: 1000,
            overflow_strategy: OverflowStrategy::DropOldest,
        }
    }
}

/// Strategy for handling mailbox overflow.
#[derive(Debug, Clone, Copy)]
enum OverflowStrategy {
    DropNewest,
    DropOldest,
    Block,
    Error,
}

/// A mailbox for an actor.
struct Mailbox<M> {
    config: MailboxConfig,
    _phantom: std::marker::PhantomData<M>,
}

impl<M> Mailbox<M> {
    fn new(config: MailboxConfig) -> Mailbox<M> {
        Mailbox {
            config,
            _phantom: std::marker::PhantomData,
        }
    }

    fn capacity(self) -> usize {
        self.config.capacity
    }

    fn overflow_strategy(self) -> OverflowStrategy {
        self.config.overflow_strategy
    }
}

impl MailboxConfig {
    fn new(capacity: usize) -> MailboxConfig {
        MailboxConfig {
            capacity,
            overflow_strategy: OverflowStrategy::DropOldest,
        }
    }

    fn with_overflow(mut self, strategy: OverflowStrategy) -> MailboxConfig {
        self.overflow_strategy = strategy;
        self
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_mailbox_config_default() {
        let config = MailboxConfig::default();
        assert_eq!(config.capacity, 1000);
        assert!(matches!(config.overflow_strategy, OverflowStrategy::DropOldest));
    }

    #[test]
    fn test_mailbox_config_custom() {
        let config = MailboxConfig::new(500)
            .with_overflow(OverflowStrategy::Block);

        assert_eq!(config.capacity, 500);
        assert!(matches!(config.overflow_strategy, OverflowStrategy::Block));
    }

    #[test]
    fn test_overflow_strategies() {
        assert!(matches!(OverflowStrategy::DropNewest, OverflowStrategy::DropNewest));
        assert!(matches!(OverflowStrategy::DropOldest, OverflowStrategy::DropOldest));
        assert!(matches!(OverflowStrategy::Block, OverflowStrategy::Block));
        assert!(matches!(OverflowStrategy::Error, OverflowStrategy::Error));
    }

    #[test]
    fn test_mailbox_creation() {
        let config = MailboxConfig::new(100);
        let mb: Mailbox<i32> = Mailbox::new(config);

        assert_eq!(mb.capacity(), 100);
        assert!(matches!(mb.overflow_strategy(), OverflowStrategy::DropOldest));
    }

    #[test]
    fn test_mailbox_with_error_strategy() {
        let config = MailboxConfig::new(50)
            .with_overflow(OverflowStrategy::Error);
        let mb: Mailbox<str> = Mailbox::new(config);

        assert_eq!(mb.capacity(), 50);
        assert!(matches!(mb.overflow_strategy(), OverflowStrategy::Error));
    }

    #[test]
    fn test_config_capacity_values() {
        let small = MailboxConfig::new(1);
        let large = MailboxConfig::new(1_000_000);

        assert_eq!(small.capacity, 1);
        assert_eq!(large.capacity, 1_000_000);
    }
}
