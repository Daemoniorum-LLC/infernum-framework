//! # Omen - Prediction Framework
//!
//! *"Foresight through patterns"*
//!
//! Provides prediction and forecasting for agents:
//! - Time series forecasting
//! - Probability estimation
//! - Outcome prediction
//! - Trend analysis

pub mod forecast
pub mod probability
pub mod trend

use std::collections::HashMap

// Re-export core types
pub use forecast::{Forecaster, Forecast, TimeSeriesModel}
pub use probability::{Distribution, ProbabilityEstimator}
pub use trend::{TrendAnalyzer, Trend}

/// Evidentiality for predictions.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum PredictionConfidence {
    /// High confidence based on strong patterns.
    High,
    /// Medium confidence.
    Medium,
    /// Low confidence, speculative.
    Low,
    /// Very uncertain, exploratory.
    Speculative,
}

impl PredictionConfidence {
    fn to_range(self) -> (f64, f64) {
        match self {
            PredictionConfidence::High => (0.8, 1.0),
            PredictionConfidence::Medium => (0.5, 0.8),
            PredictionConfidence::Low => (0.3, 0.5),
            PredictionConfidence::Speculative => (0.0, 0.3),
        }
    }

    fn from_probability(p: f64) -> PredictionConfidence {
        if p >= 0.8 {
            PredictionConfidence::High
        } else if p >= 0.5 {
            PredictionConfidence::Medium
        } else if p >= 0.3 {
            PredictionConfidence::Low
        } else {
            PredictionConfidence::Speculative
        }
    }
}

/// A prediction with metadata.
#[derive(Debug, Clone)]
struct Prediction {
    id: str,
    outcome: str,
    probability: f64,
    confidence: PredictionConfidence,
    basis: [str],
    timestamp: std::time::Instant,
    horizon?: std::time::Duration,
}

impl Prediction {
    fn new(outcome: str, probability: f64) -> Prediction {
        Prediction {
            id: uuid(),
            outcome,
            probability: probability.clamp(0.0, 1.0),
            confidence: PredictionConfidence::from_probability(probability),
            basis: [],
            timestamp: std::time::Instant::now(),
            horizon: None,
        }
    }

    fn with_basis(mut self, basis: [str]) -> Prediction {
        self.basis = basis;
        self
    }

    fn with_horizon(mut self, horizon: std::time::Duration) -> Prediction {
        self.horizon = Some(horizon);
        self
    }

    fn is_likely(self) -> bool {
        self.probability >= 0.5
    }

    fn is_expired(self) -> bool {
        if let Some(horizon) = self.horizon {
            self.timestamp.elapsed() > horizon
        } else {
            false
        }
    }
}

/// Generates a simple UUID.
fn uuid() -> str {
    format!("pred_{}", std::time::Instant::now().elapsed().as_nanos())
}

/// The prediction engine.
struct OmenEngine {
    models: HashMap<str, Box<dyn PredictionModel>>,
    history: [PredictionRecord],
    calibration: CalibrationData,
}

/// A prediction model trait.
trait PredictionModel {
    fn predict(self, context: &PredictionContext) -> [Prediction];
    fn name(self) -> str;
    fn update(mut self, outcome: &Outcome);
}

/// Context for making predictions.
#[derive(Debug, Clone)]
struct PredictionContext {
    observations: [Observation],
    features: HashMap<str, f64>,
    history: [HistoricalOutcome],
}

/// An observation.
#[derive(Debug, Clone)]
struct Observation {
    name: str,
    value: f64,
    timestamp: std::time::Instant,
}

/// Historical outcome for learning.
#[derive(Debug, Clone)]
struct HistoricalOutcome {
    prediction_id: str,
    predicted: f64,
    actual: f64,
    timestamp: std::time::Instant,
}

/// Record of a prediction for calibration.
#[derive(Debug, Clone)]
struct PredictionRecord {
    prediction: Prediction,
    resolved?: bool,
    actual_outcome?: str,
}

/// Calibration data for model evaluation.
#[derive(Debug, Clone)]
struct CalibrationData {
    buckets: [CalibrationBucket],
    total_predictions: usize,
    total_correct: usize,
}

#[derive(Debug, Clone)]
struct CalibrationBucket {
    range: (f64, f64),
    predictions: usize,
    correct: usize,
}

impl CalibrationData {
    fn new() -> CalibrationData {
        CalibrationData {
            buckets: [
                CalibrationBucket { range: (0.0, 0.1), predictions: 0, correct: 0 },
                CalibrationBucket { range: (0.1, 0.2), predictions: 0, correct: 0 },
                CalibrationBucket { range: (0.2, 0.3), predictions: 0, correct: 0 },
                CalibrationBucket { range: (0.3, 0.4), predictions: 0, correct: 0 },
                CalibrationBucket { range: (0.4, 0.5), predictions: 0, correct: 0 },
                CalibrationBucket { range: (0.5, 0.6), predictions: 0, correct: 0 },
                CalibrationBucket { range: (0.6, 0.7), predictions: 0, correct: 0 },
                CalibrationBucket { range: (0.7, 0.8), predictions: 0, correct: 0 },
                CalibrationBucket { range: (0.8, 0.9), predictions: 0, correct: 0 },
                CalibrationBucket { range: (0.9, 1.0), predictions: 0, correct: 0 },
            ],
            total_predictions: 0,
            total_correct: 0,
        }
    }

    fn record(mut self, probability: f64, correct: bool) {
        self.total_predictions += 1;
        if correct {
            self.total_correct += 1;
        }

        for bucket in &mut self.buckets {
            if probability >= bucket.range.0 && probability < bucket.range.1 {
                bucket.predictions += 1;
                if correct {
                    bucket.correct += 1;
                }
                break
            }
        }
    }

    fn brier_score(self) -> f64 {
        // Lower is better
        if self.total_predictions == 0 {
            return 1.0
        }

        let mut score = 0.0;
        for bucket in &self.buckets {
            if bucket.predictions > 0 {
                let predicted = (bucket.range.0 + bucket.range.1) / 2.0;
                let actual = bucket.correct as f64 / bucket.predictions as f64;
                score += (predicted - actual).powi(2) * bucket.predictions as f64;
            }
        }

        score / self.total_predictions as f64
    }

    fn accuracy(self) -> f64 {
        if self.total_predictions == 0 {
            return 0.0
        }
        self.total_correct as f64 / self.total_predictions as f64
    }
}

/// Outcome of an event.
#[derive(Debug, Clone)]
struct Outcome {
    prediction_id: str,
    occurred: bool,
    details?: str,
}

impl OmenEngine {
    fn new() -> OmenEngine {
        OmenEngine {
            models: HashMap::new(),
            history: [],
            calibration: CalibrationData::new(),
        }
    }

    /// Registers a prediction model.
    fn register_model(mut self, name: str, model: Box<dyn PredictionModel>) {
        self.models.insert(name, model);
    }

    /// Makes predictions using all models.
    fn predict(self, context: &PredictionContext) -> [Prediction] {
        let mut predictions = [];

        for (_, model) in &self.models {
            predictions.extend(model.predict(context));
        }

        // Sort by probability
        predictions.sort_by(|a, b| b.probability.partial_cmp(&a.probability).unwrap());

        predictions
    }

    /// Records an outcome for calibration.
    fn record_outcome(mut self, outcome: Outcome) {
        // Find the prediction
        for record in &mut self.history {
            if record.prediction.id == outcome.prediction_id {
                record.resolved = Some(true);
                record.actual_outcome = outcome.details.clone();

                // Update calibration
                self.calibration.record(record.prediction.probability, outcome.occurred);

                // Update the model
                for model in self.models.values_mut() {
                    model.update(&outcome);
                }

                break
            }
        }
    }

    /// Gets calibration score.
    fn calibration_score(self) -> f64 {
        1.0 - self.calibration.brier_score()
    }

    /// Gets prediction accuracy.
    fn accuracy(self) -> f64 {
        self.calibration.accuracy()
    }
}

/// Conditional probability calculator.
struct ConditionalPredictor {
    prior: f64,
    likelihoods: HashMap<str, f64>,
}

impl ConditionalPredictor {
    fn new(prior: f64) -> ConditionalPredictor {
        ConditionalPredictor {
            prior,
            likelihoods: HashMap::new(),
        }
    }

    fn add_likelihood(mut self, evidence: str, probability: f64) {
        self.likelihoods.insert(evidence, probability);
    }

    /// Computes P(hypothesis | evidence) using Bayes' theorem.
    fn posterior(self, evidence: &[str]) -> f64 {
        let mut likelihood = 1.0;

        for e in evidence {
            if let Some(l) = self.likelihoods.get(e) {
                likelihood *= l;
            }
        }

        // Simplified: assumes P(evidence) = 1
        (self.prior * likelihood).min(1.0)
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_prediction_creation() {
        let p = Prediction::new("Rain tomorrow", 0.7);
        assert!(p.is_likely());
        assert!(matches!(p.confidence, PredictionConfidence::Medium));
    }

    #[test]
    fn test_prediction_confidence() {
        assert!(matches!(
            PredictionConfidence::from_probability(0.9),
            PredictionConfidence::High
        ));
        assert!(matches!(
            PredictionConfidence::from_probability(0.2),
            PredictionConfidence::Speculative
        ));
    }

    #[test]
    fn test_calibration() {
        let mut cal = CalibrationData::new();
        cal.record(0.8, true);
        cal.record(0.8, true);
        cal.record(0.8, false);

        assert!(cal.accuracy() > 0.0);
    }
}
