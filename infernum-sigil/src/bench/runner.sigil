/// Benchmark Runner
///
/// Core infrastructure for running and measuring benchmarks.

use std::time::{Duration, Instant}
use crate::bench::config::{BenchmarkConfig, BenchmarkMeta, BenchmarkCategory, HardwareConfig}
use crate::core::error::{InfernumError, Result}

// ============================================================================
// Benchmark Trait
// ============================================================================

/// Trait for implementing benchmarks
pub trait Benchmark {
    /// Benchmark metadata
    fn meta(&self) -> BenchmarkMeta

    /// Setup before benchmark (not measured)
    fn setup(&mut self) -> Result<()!> {
        Ok(())
    }

    /// The code to benchmark
    fn run(&mut self) -> Result<()!>

    /// Teardown after benchmark (not measured)
    fn teardown(&mut self) -> Result<()!> {
        Ok(())
    }
}

// ============================================================================
// Measurement
// ============================================================================

/// Single measurement
#[derive(Clone)]
pub struct Measurement {
    /// Elapsed time
    pub elapsed: Duration,
    /// Memory allocated (bytes)
    pub memory_allocated: u64,
    /// Peak memory (bytes)
    pub peak_memory: u64,
    /// Iteration number
    pub iteration: u32,
}

/// Statistics from measurements
pub struct Statistics {
    /// Mean time
    pub mean: Duration,
    /// Median time
    pub median: Duration,
    /// Standard deviation
    pub std_dev: Duration,
    /// Minimum time
    pub min: Duration,
    /// Maximum time
    pub max: Duration,
    /// Percentiles
    pub p50: Duration,
    pub p90: Duration,
    pub p95: Duration,
    pub p99: Duration,
    /// Confidence interval (lower, upper)
    pub confidence_interval: (Duration, Duration),
    /// Throughput (ops/sec)
    pub throughput: f64,
    /// Memory statistics
    pub memory_stats: MemoryStats,
}

pub struct MemoryStats {
    pub mean_allocated: u64,
    pub peak_allocated: u64,
    pub min_allocated: u64,
    pub max_allocated: u64,
}

impl Statistics {
    pub fn from_measurements(measurements: &[Measurement], confidence_level: f64) -> Self {
        let n = measurements.len()
        if n == 0 {
            return Self::zero()
        }

        // Sort by elapsed time
        let mut times: Vec<Duration> = measurements.iter().map(|m| m.elapsed).collect()
        times.sort()

        let total: Duration = times.iter().sum()
        let mean = total / n as u32

        let median = times[n / 2]
        let min = times[0]
        let max = times[n - 1]

        // Percentiles
        let p50 = times[n * 50 / 100]
        let p90 = times[n * 90 / 100]
        let p95 = times[n * 95 / 100]
        let p99 = times.get(n * 99 / 100).cloned().unwrap_or(max)

        // Standard deviation
        let mean_nanos = mean.as_nanos() as f64
        let variance: f64 = times.iter()
            .map(|t| {
                let diff = t.as_nanos() as f64 - mean_nanos
                diff * diff
            })
            .sum::<f64>() / n as f64

        let std_dev_nanos = variance.sqrt()
        let std_dev = Duration::from_nanos(std_dev_nanos as u64)

        // Confidence interval (using t-distribution approximation)
        let t_value = t_critical(confidence_level, n as u32)
        let margin = std_dev_nanos * t_value / (n as f64).sqrt()
        let ci_lower = Duration::from_nanos((mean_nanos - margin).max(0.0) as u64)
        let ci_upper = Duration::from_nanos((mean_nanos + margin) as u64)

        // Throughput
        let throughput = if mean.as_secs_f64() > 0.0 {
            1.0 / mean.as_secs_f64()
        } else {
            0.0
        }

        // Memory stats
        let memory_stats = MemoryStats {
            mean_allocated: measurements.iter().map(|m| m.memory_allocated).sum::<u64>() / n as u64,
            peak_allocated: measurements.iter().map(|m| m.peak_memory).max().unwrap_or(0),
            min_allocated: measurements.iter().map(|m| m.memory_allocated).min().unwrap_or(0),
            max_allocated: measurements.iter().map(|m| m.memory_allocated).max().unwrap_or(0),
        }

        Self {
            mean,
            median,
            std_dev,
            min,
            max,
            p50,
            p90,
            p95,
            p99,
            confidence_interval: (ci_lower, ci_upper),
            throughput,
            memory_stats,
        }
    }

    fn zero() -> Self {
        Self {
            mean: Duration::ZERO,
            median: Duration::ZERO,
            std_dev: Duration::ZERO,
            min: Duration::ZERO,
            max: Duration::ZERO,
            p50: Duration::ZERO,
            p90: Duration::ZERO,
            p95: Duration::ZERO,
            p99: Duration::ZERO,
            confidence_interval: (Duration::ZERO, Duration::ZERO),
            throughput: 0.0,
            memory_stats: MemoryStats {
                mean_allocated: 0,
                peak_allocated: 0,
                min_allocated: 0,
                max_allocated: 0,
            },
        }
    }
}

fn t_critical(confidence: f64, df: u32) -> f64 {
    // Approximate t-critical values
    if df >= 120 {
        if confidence >= 0.99 { 2.576 }
        else if confidence >= 0.95 { 1.96 }
        else { 1.645 }
    } else if df >= 30 {
        if confidence >= 0.99 { 2.75 }
        else if confidence >= 0.95 { 2.04 }
        else { 1.70 }
    } else {
        if confidence >= 0.99 { 3.0 }
        else if confidence >= 0.95 { 2.26 }
        else { 1.83 }
    }
}

// ============================================================================
// Benchmark Result
// ============================================================================

/// Result of running a benchmark
pub struct BenchmarkResult {
    /// Benchmark metadata
    pub meta: BenchmarkMeta,
    /// All measurements
    pub measurements: Vec<Measurement>,
    /// Computed statistics
    pub statistics: Statistics,
    /// Hardware configuration used
    pub hardware: HardwareConfig,
    /// Timestamp
    pub timestamp: u64,
    /// Success status
    pub success: bool,
    /// Error message if failed
    pub error: Option<String>,
}

impl BenchmarkResult {
    pub fn format_time(d: Duration) -> String {
        let nanos = d.as_nanos()
        if nanos < 1_000 {
            format!("{} ns", nanos)
        } else if nanos < 1_000_000 {
            format!("{:.2} µs", nanos as f64 / 1_000.0)
        } else if nanos < 1_000_000_000 {
            format!("{:.2} ms", nanos as f64 / 1_000_000.0)
        } else {
            format!("{:.2} s", nanos as f64 / 1_000_000_000.0)
        }
    }

    pub fn format_throughput(&self) -> String {
        let t = self.statistics.throughput
        if t >= 1_000_000.0 {
            format!("{:.2}M ops/s", t / 1_000_000.0)
        } else if t >= 1_000.0 {
            format!("{:.2}K ops/s", t / 1_000.0)
        } else {
            format!("{:.2} ops/s", t)
        }
    }

    pub fn format_memory(bytes: u64) -> String {
        if bytes >= 1024 * 1024 * 1024 {
            format!("{:.2} GB", bytes as f64 / (1024.0 * 1024.0 * 1024.0))
        } else if bytes >= 1024 * 1024 {
            format!("{:.2} MB", bytes as f64 / (1024.0 * 1024.0))
        } else if bytes >= 1024 {
            format!("{:.2} KB", bytes as f64 / 1024.0)
        } else {
            format!("{} B", bytes)
        }
    }
}

// ============================================================================
// Benchmark Runner
// ============================================================================

/// Main benchmark runner
pub struct BenchmarkRunner {
    config: BenchmarkConfig,
    hardware: HardwareConfig,
    results: Vec<BenchmarkResult>,
}

impl BenchmarkRunner {
    pub fn new(config: BenchmarkConfig) -> Self {
        Self {
            config,
            hardware: HardwareConfig::detect(),
            results: Vec::new(),
        }
    }

    pub fn with_hardware(mut self, hardware: HardwareConfig) -> Self {
        self.hardware = hardware
        self
    }

    /// Run a single benchmark
    pub fn run<B: Benchmark>(&mut self, bench: &mut B) -> Result<BenchmarkResult!> {
        let meta = bench.meta()

        // Check filter
        if let Some(ref filter) = self.config.filter {
            if !meta.name.contains(filter) {
                return Ok(BenchmarkResult {
                    meta,
                    measurements: Vec::new(),
                    statistics: Statistics::zero(),
                    hardware: self.hardware.clone(),
                    timestamp: current_timestamp(),
                    success: true,
                    error: Some("Filtered out".to_string()),
                })
            }
        }

        // Check slow
        if self.config.skip_slow && meta.slow {
            println!("  Skipping slow benchmark: {}", meta.name)
            return Ok(BenchmarkResult {
                meta,
                measurements: Vec::new(),
                statistics: Statistics::zero(),
                hardware: self.hardware.clone(),
                timestamp: current_timestamp(),
                success: true,
                error: Some("Skipped (slow)".to_string()),
            })
        }

        println!("  Running: {}", meta.name)

        // Setup
        bench.setup()?

        // Warmup
        for _ in 0..self.config.warmup_iterations {
            bench.run()?
        }

        // Measured iterations
        let mut measurements = Vec::with_capacity(self.config.iterations as usize)
        let start_time = Instant::now()

        for i in 0..self.config.iterations {
            // Check time limit
            if start_time.elapsed() > self.config.max_time {
                break
            }

            let mem_before = get_memory_usage()
            let iter_start = Instant::now()

            bench.run()?

            let elapsed = iter_start.elapsed()
            let mem_after = get_memory_usage()

            measurements.push(Measurement {
                elapsed,
                memory_allocated: mem_after.saturating_sub(mem_before),
                peak_memory: mem_after,
                iteration: i,
            })

            // Check minimum time
            if i > 10 && start_time.elapsed() >= self.config.min_time {
                // We have enough samples
            }
        }

        // Teardown
        bench.teardown()?

        // Compute statistics
        let statistics = Statistics::from_measurements(&measurements, self.config.confidence_level)

        let result = BenchmarkResult {
            meta: bench.meta(),
            measurements,
            statistics,
            hardware: self.hardware.clone(),
            timestamp: current_timestamp(),
            success: true,
            error: None,
        }

        // Print summary
        println!("    Mean: {} | Median: {} | Throughput: {}",
            BenchmarkResult::format_time(result.statistics.mean),
            BenchmarkResult::format_time(result.statistics.median),
            result.format_throughput(),
        )

        self.results.push(result.clone())
        Ok(result)
    }

    /// Run all benchmarks in a category
    pub fn run_category<B: Benchmark>(
        &mut self,
        category: BenchmarkCategory,
        benchmarks: &mut [B],
    ) -> Result<Vec<BenchmarkResult>!> {
        println!("\n=== {} Benchmarks ===", category.name().to_uppercase())

        let mut results = Vec::new()
        for bench in benchmarks.iter_mut() {
            let meta = bench.meta()
            if matches!(category, BenchmarkCategory::All) ||
               std::mem::discriminant(&meta.category) == std::mem::discriminant(&category) {
                let result! = self.run(bench)?
                results.push(result)
            }
        }
        Ok(results)
    }

    /// Get all results
    pub fn results(&self) -> &[BenchmarkResult] {
        &self.results
    }

    /// Compare with baseline
    pub fn compare_baseline(&self, baseline_path: &str) -> Result<Comparison!> {
        let baseline! = load_baseline(baseline_path)?

        let mut comparisons = Vec::new()
        for result in &self.results {
            if let Some(base) = baseline.iter().find(|b| b.name == result.meta.name) {
                let current_ns = result.statistics.mean.as_nanos() as f64
                let baseline_ns = base.mean_ns
                let change = (current_ns - baseline_ns) / baseline_ns * 100.0

                comparisons.push(BenchComparison {
                    name: result.meta.name.clone(),
                    current: result.statistics.mean,
                    baseline: Duration::from_nanos(baseline_ns as u64),
                    change_percent: change,
                    regression: change > 5.0,  // >5% slower is a regression
                    improvement: change < -5.0,  // >5% faster is an improvement
                })
            }
        }

        Ok(Comparison { comparisons })
    }
}

impl Clone for HardwareConfig {
    fn clone(&self) -> Self {
        Self {
            device: match self.device {
                DeviceType::CPU => DeviceType::CPU,
                DeviceType::CUDA => DeviceType::CUDA,
                DeviceType::Metal => DeviceType::Metal,
                DeviceType::Vulkan => DeviceType::Vulkan,
            },
            num_threads: self.num_threads,
            gpu_id: self.gpu_id,
            tensor_cores: self.tensor_cores,
            memory_limit: self.memory_limit,
        }
    }
}

use crate::bench::config::DeviceType;

// ============================================================================
// Comparison
// ============================================================================

pub struct Comparison {
    pub comparisons: Vec<BenchComparison>,
}

pub struct BenchComparison {
    pub name: String,
    pub current: Duration,
    pub baseline: Duration,
    pub change_percent: f64,
    pub regression: bool,
    pub improvement: bool,
}

impl Comparison {
    pub fn has_regressions(&self) -> bool {
        self.comparisons.iter().any(|c| c.regression)
    }

    pub fn print_summary(&self) {
        println!("\n=== Comparison with Baseline ===\n")

        for comp in &self.comparisons {
            let status = if comp.regression {
                "⚠️  REGRESSION"
            } else if comp.improvement {
                "✅ IMPROVED"
            } else {
                "   unchanged"
            }

            println!("{}: {} -> {} ({:+.1}%) {}",
                comp.name,
                BenchmarkResult::format_time(comp.baseline),
                BenchmarkResult::format_time(comp.current),
                comp.change_percent,
                status,
            )
        }
    }
}

struct BaselineEntry {
    name: String,
    mean_ns: f64,
}

fn load_baseline(path: &str) -> Result<Vec<BaselineEntry>!> {
    // Would load from JSON file
    Ok(Vec::new())
}

fn current_timestamp() -> u64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap()
        .as_secs()
}

fn get_memory_usage() -> u64 {
    // Would query actual memory usage
    0
}

// ============================================================================
// Benchmark Group
// ============================================================================

/// Group of related benchmarks
pub struct BenchmarkGroup {
    name: String,
    benchmarks: Vec<Box<dyn Benchmark>>,
}

impl BenchmarkGroup {
    pub fn new(name: &str) -> Self {
        Self {
            name: name.to_string(),
            benchmarks: Vec::new(),
        }
    }

    pub fn add<B: Benchmark + 'static>(mut self, bench: B) -> Self {
        self.benchmarks.push(Box::new(bench))
        self
    }

    pub fn run(&mut self, runner: &mut BenchmarkRunner) -> Result<Vec<BenchmarkResult>!> {
        println!("\n--- {} ---", self.name)
        let mut results = Vec::new()
        for bench in &mut self.benchmarks {
            let result! = runner.run(bench.as_mut())?
            results.push(result)
        }
        Ok(results)
    }
}

// ============================================================================
// Timing Utilities
// ============================================================================

/// Black box to prevent optimization
#[inline(never)]
pub fn black_box<T>(x: T) -> T {
    // Prevent compiler from optimizing away the computation
    let ptr = &x as *const T
    unsafe { std::ptr::read_volatile(ptr) }
}

/// Timer for manual measurements
pub struct Timer {
    start: Instant,
    splits: Vec<(String, Duration)>,
}

impl Timer {
    pub fn start() -> Self {
        Self {
            start: Instant::now(),
            splits: Vec::new(),
        }
    }

    pub fn split(&mut self, name: &str) {
        self.splits.push((name.to_string(), self.start.elapsed()))
    }

    pub fn elapsed(&self) -> Duration {
        self.start.elapsed()
    }

    pub fn report(&self) {
        println!("\nTimer Report:")
        let mut prev = Duration::ZERO
        for (name, elapsed) in &self.splits {
            let delta = *elapsed - prev
            println!("  {}: {} (delta: {})",
                name,
                BenchmarkResult::format_time(*elapsed),
                BenchmarkResult::format_time(delta),
            )
            prev = *elapsed
        }
        println!("  Total: {}", BenchmarkResult::format_time(self.elapsed()))
    }
}
