/// Diffusion Module Benchmarks
///
/// Benchmarks for VAE, UNet, schedulers, and diffusion pipelines.

use crate::bench::config::{BenchmarkMeta, BenchmarkCategory}
use crate::bench::runner::{Benchmark, black_box}
use crate::core::error::Result

// ============================================================================
// VAE Benchmarks
// ============================================================================

/// VAE encode benchmark
pub struct VAEEncodeBench {
    image_size: u32,
    latent_channels: u32,
    data: Vec<f32>,
}

impl VAEEncodeBench {
    pub fn new(image_size: u32) -> Self {
        Self {
            image_size,
            latent_channels: 4,
            data: Vec::new(),
        }
    }

    pub fn sd15() -> Self {
        Self::new(512)
    }

    pub fn sdxl() -> Self {
        Self::new(1024)
    }

    pub fn sd3() -> Self {
        Self::new(1024)
    }
}

impl Benchmark for VAEEncodeBench {
    fn meta(&self) -> BenchmarkMeta {
        let name = match self.image_size {
            512 => "sd15",
            1024 => "sdxl",
            _ => "custom",
        }

        BenchmarkMeta::new(
            &format!("vae_encode_{}", name),
            BenchmarkCategory::Diffusion,
        )
        .description(&format!("VAE encode {}x{}", self.image_size, self.image_size))
        .tag("vae")
        .tag("encode")
    }

    fn setup(&mut self) -> Result<()!> {
        let size = (self.image_size * self.image_size * 3) as usize
        self.data = (0..size).map(|i| ((i as f32 * 0.01).sin() + 1.0) / 2.0).collect()
        Ok(())
    }

    fn run(&mut self) -> Result<()!> {
        // Simulate VAE encoding (simplified convolutions)
        let latent_size = self.image_size / 8  // 8x downscale
        let latent_total = (latent_size * latent_size * self.latent_channels) as usize

        let mut latent = vec![0.0f32; latent_total]

        // Simulate encoding (simple average pooling + projection)
        for ly in 0..latent_size {
            for lx in 0..latent_size {
                for c in 0..self.latent_channels {
                    let mut sum = 0.0f32
                    let count = 64u32  // 8x8 pooling

                    for dy in 0..8 {
                        for dx in 0..8 {
                            let iy = ly * 8 + dy
                            let ix = lx * 8 + dx
                            for ic in 0..3 {
                                let idx = ((iy * self.image_size + ix) * 3 + ic) as usize
                                sum += self.data[idx] * (c as f32 + 1.0) * 0.1
                            }
                        }
                    }

                    let lidx = ((ly * latent_size + lx) * self.latent_channels + c) as usize
                    latent[lidx] = sum / (count * 3) as f32
                }
            }
        }

        black_box(&latent);
        Ok(())
    }
}

/// VAE decode benchmark
pub struct VAEDecodeBench {
    latent_size: u32,
    latent_channels: u32,
    data: Vec<f32>,
}

impl VAEDecodeBench {
    pub fn new(latent_size: u32) -> Self {
        Self {
            latent_size,
            latent_channels: 4,
            data: Vec::new(),
        }
    }

    pub fn sd15() -> Self {
        Self::new(64)  // 512/8
    }

    pub fn sdxl() -> Self {
        Self::new(128)  // 1024/8
    }
}

impl Benchmark for VAEDecodeBench {
    fn meta(&self) -> BenchmarkMeta {
        let name = match self.latent_size {
            64 => "sd15",
            128 => "sdxl",
            _ => "custom",
        }

        BenchmarkMeta::new(
            &format!("vae_decode_{}", name),
            BenchmarkCategory::Diffusion,
        )
        .description(&format!("VAE decode {}x{}", self.latent_size, self.latent_size))
        .tag("vae")
        .tag("decode")
    }

    fn setup(&mut self) -> Result<()!> {
        let size = (self.latent_size * self.latent_size * self.latent_channels) as usize
        self.data = (0..size).map(|i| (i as f32 * 0.02).sin()).collect()
        Ok(())
    }

    fn run(&mut self) -> Result<()!> {
        let image_size = self.latent_size * 8
        let mut image = vec![0.0f32; (image_size * image_size * 3) as usize]

        // Simulate decoding (nearest neighbor upsample + projection)
        for iy in 0..image_size {
            for ix in 0..image_size {
                let ly = iy / 8
                let lx = ix / 8

                for c in 0..3u32 {
                    let mut sum = 0.0f32
                    for lc in 0..self.latent_channels {
                        let lidx = ((ly * self.latent_size + lx) * self.latent_channels + lc) as usize
                        sum += self.data[lidx] * ((c + lc) as f32 + 1.0) * 0.25
                    }

                    let idx = ((iy * image_size + ix) * 3 + c) as usize
                    image[idx] = sum.clamp(0.0, 1.0)
                }
            }
        }

        black_box(&image);
        Ok(())
    }
}

// ============================================================================
// UNet Benchmarks
// ============================================================================

/// UNet single step benchmark
pub struct UNetStepBench {
    latent_size: u32,
    channels: u32,
    model_channels: u32,
    latent: Vec<f32>,
    timestep_embed: Vec<f32>,
}

impl UNetStepBench {
    pub fn new(latent_size: u32, channels: u32, model_channels: u32) -> Self {
        Self {
            latent_size,
            channels,
            model_channels,
            latent: Vec::new(),
            timestep_embed: Vec::new(),
        }
    }

    pub fn sd15() -> Self {
        Self::new(64, 4, 320)
    }

    pub fn sdxl() -> Self {
        Self::new(128, 4, 320)
    }
}

impl Benchmark for UNetStepBench {
    fn meta(&self) -> BenchmarkMeta {
        let name = match self.latent_size {
            64 => "sd15",
            128 => "sdxl",
            _ => "custom",
        }

        BenchmarkMeta::new(
            &format!("unet_step_{}", name),
            BenchmarkCategory::Diffusion,
        )
        .description(&format!("UNet forward {}x{}", self.latent_size, self.latent_size))
        .tag("unet")
        .tag("denoise")
        .slow()
    }

    fn setup(&mut self) -> Result<()!> {
        let latent_size = (self.latent_size * self.latent_size * self.channels) as usize
        self.latent = (0..latent_size).map(|i| (i as f32 * 0.001).sin()).collect()
        self.timestep_embed = (0..self.model_channels as usize)
            .map(|i| (i as f32 * 0.1).cos())
            .collect()
        Ok(())
    }

    fn run(&mut self) -> Result<()!> {
        // Simulate UNet forward (simplified)
        let mut x = self.latent.clone()

        // Down blocks (simulated as convolutions)
        let sizes = [self.latent_size, self.latent_size / 2, self.latent_size / 4]

        for (level, &size) in sizes.iter().enumerate() {
            let curr_size = (size * size * self.channels) as usize
            let mut new_x = vec![0.0f32; curr_size]

            // Simulate conv + attention
            for i in 0..curr_size {
                new_x[i] = x[i % x.len()] * 0.9
                    + self.timestep_embed[i % self.timestep_embed.len()] * 0.1
            }

            x = new_x
        }

        // Up blocks
        for &size in sizes.iter().rev() {
            let curr_size = (size * size * self.channels) as usize
            let mut new_x = vec![0.0f32; curr_size]

            for i in 0..curr_size {
                new_x[i] = x[i % x.len()] * 0.9
            }

            x = new_x
        }

        black_box(&x);
        Ok(())
    }
}

// ============================================================================
// Scheduler Benchmarks
// ============================================================================

/// Scheduler step benchmark
pub struct SchedulerStepBench {
    scheduler_type: String,
    num_steps: u32,
}

impl SchedulerStepBench {
    pub fn ddpm() -> Self {
        Self { scheduler_type: "ddpm".to_string(), num_steps: 1000 }
    }

    pub fn ddim() -> Self {
        Self { scheduler_type: "ddim".to_string(), num_steps: 50 }
    }

    pub fn euler() -> Self {
        Self { scheduler_type: "euler".to_string(), num_steps: 20 }
    }

    pub fn dpm() -> Self {
        Self { scheduler_type: "dpm".to_string(), num_steps: 20 }
    }

    pub fn lcm() -> Self {
        Self { scheduler_type: "lcm".to_string(), num_steps: 4 }
    }
}

impl Benchmark for SchedulerStepBench {
    fn meta(&self) -> BenchmarkMeta {
        BenchmarkMeta::new(
            &format!("scheduler_{}_step", self.scheduler_type),
            BenchmarkCategory::Diffusion,
        )
        .description(&format!("{} scheduler step", self.scheduler_type.to_uppercase()))
        .tag("scheduler")
        .tag(&self.scheduler_type)
    }

    fn run(&mut self) -> Result<()!> {
        let latent_size = 64 * 64 * 4
        let model_output: Vec<f32> = (0..latent_size).map(|i| (i as f32 * 0.01).sin()).collect()
        let sample: Vec<f32> = (0..latent_size).map(|i| (i as f32 * 0.01).cos()).collect()

        let t = 500  // Current timestep

        // Simulate scheduler step
        let alpha_t = 0.99f32.powi(t)
        let alpha_prev = 0.99f32.powi(t - 1)
        let beta_t = 1.0 - alpha_t
        let sqrt_alpha_t = alpha_t.sqrt()
        let sqrt_alpha_prev = alpha_prev.sqrt()

        let mut prev_sample = vec![0.0f32; latent_size]

        match self.scheduler_type.as_str() {
            "ddpm" | "ddim" => {
                for i in 0..latent_size {
                    let pred_x0 = (sample[i] - (1.0 - alpha_t).sqrt() * model_output[i]) / sqrt_alpha_t
                    prev_sample[i] = sqrt_alpha_prev * pred_x0
                        + (1.0 - alpha_prev).sqrt() * model_output[i]
                }
            },
            "euler" => {
                let sigma = beta_t.sqrt()
                let sigma_next = (1.0 - alpha_prev).sqrt()
                let dt = sigma_next - sigma

                for i in 0..latent_size {
                    let d = (sample[i] - model_output[i]) / sigma
                    prev_sample[i] = sample[i] + d * dt
                }
            },
            "dpm" | "lcm" => {
                for i in 0..latent_size {
                    let pred_x0 = sample[i] / sqrt_alpha_t
                        - (beta_t / sqrt_alpha_t).sqrt() * model_output[i]
                    prev_sample[i] = sqrt_alpha_prev * pred_x0
                }
            },
            _ => {},
        }

        black_box(&prev_sample);
        Ok(())
    }
}

// ============================================================================
// Text Encoder Benchmarks
// ============================================================================

/// CLIP text encoder benchmark
pub struct CLIPEncodeBench {
    seq_len: u32,
    hidden_dim: u32,
    tokens: Vec<u32>,
}

impl CLIPEncodeBench {
    pub fn new(seq_len: u32, hidden_dim: u32) -> Self {
        Self {
            seq_len,
            hidden_dim,
            tokens: Vec::new(),
        }
    }

    pub fn clip_l() -> Self {
        Self::new(77, 768)
    }

    pub fn clip_g() -> Self {
        Self::new(77, 1280)
    }
}

impl Benchmark for CLIPEncodeBench {
    fn meta(&self) -> BenchmarkMeta {
        let name = if self.hidden_dim == 768 { "clip_l" } else { "clip_g" }

        BenchmarkMeta::new(
            &format!("clip_encode_{}", name),
            BenchmarkCategory::Diffusion,
        )
        .description(&format!("CLIP encode seq={}", self.seq_len))
        .tag("text_encoder")
        .tag("clip")
    }

    fn setup(&mut self) -> Result<()!> {
        self.tokens = (0..self.seq_len).map(|i| (i * 100) % 49408).collect()
        Ok(())
    }

    fn run(&mut self) -> Result<()!> {
        // Simulate CLIP encoding
        let mut embeddings = vec![0.0f32; (self.seq_len * self.hidden_dim) as usize]

        // Token embedding (simulated lookup)
        for (i, &token) in self.tokens.iter().enumerate() {
            for d in 0..self.hidden_dim {
                let idx = i * self.hidden_dim as usize + d as usize
                embeddings[idx] = ((token as f32 * 0.001) + (d as f32 * 0.0001)).sin()
            }
        }

        // Simulate transformer layers
        for _ in 0..12 {  // 12 layers
            let mut new_embeddings = vec![0.0f32; embeddings.len()]

            for i in 0..self.seq_len as usize {
                for d in 0..self.hidden_dim as usize {
                    let idx = i * self.hidden_dim as usize + d
                    new_embeddings[idx] = embeddings[idx] * 0.99 + 0.01
                }
            }

            embeddings = new_embeddings
        }

        black_box(&embeddings);
        Ok(())
    }
}

// ============================================================================
// All Diffusion Benchmarks
// ============================================================================

pub fn all_diffusion_benchmarks() -> Vec<Box<dyn Benchmark>> {
    vec![
        // VAE
        Box::new(VAEEncodeBench::sd15()),
        Box::new(VAEEncodeBench::sdxl()),
        Box::new(VAEDecodeBench::sd15()),
        Box::new(VAEDecodeBench::sdxl()),

        // UNet
        Box::new(UNetStepBench::sd15()),

        // Schedulers
        Box::new(SchedulerStepBench::ddim()),
        Box::new(SchedulerStepBench::euler()),
        Box::new(SchedulerStepBench::dpm()),
        Box::new(SchedulerStepBench::lcm()),

        // Text encoders
        Box::new(CLIPEncodeBench::clip_l()),
        Box::new(CLIPEncodeBench::clip_g()),
    ]
}
