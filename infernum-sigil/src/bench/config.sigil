/// Benchmark Configuration
///
/// Configuration for benchmark runs, iterations, warmup, and reporting.

use std::time::Duration

// ============================================================================
// Benchmark Configuration
// ============================================================================

/// Main benchmark configuration
pub struct BenchmarkConfig {
    /// Number of warmup iterations
    pub warmup_iterations: u32,
    /// Number of measured iterations
    pub iterations: u32,
    /// Minimum time per benchmark
    pub min_time: Duration,
    /// Maximum time per benchmark
    pub max_time: Duration,
    /// Confidence level for statistics (e.g., 0.95)
    pub confidence_level: f64,
    /// Output format
    pub output_format: OutputFormat,
    /// Save results to file
    pub save_results: bool,
    /// Results directory
    pub results_dir: String,
    /// Enable detailed profiling
    pub profiling: bool,
    /// Filter benchmarks by name pattern
    pub filter: Option<String>,
    /// Skip slow benchmarks
    pub skip_slow: bool,
    /// Baseline comparison file
    pub baseline: Option<String>,
}

pub enum OutputFormat {
    /// Human-readable console output
    Console,
    /// JSON format
    Json,
    /// CSV format
    Csv,
    /// Markdown table
    Markdown,
    /// HTML report
    Html,
}

impl BenchmarkConfig {
    pub fn default() -> Self {
        Self {
            warmup_iterations: 3,
            iterations: 100,
            min_time: Duration::from_millis(100),
            max_time: Duration::from_secs(10),
            confidence_level: 0.95,
            output_format: OutputFormat::Console,
            save_results: true,
            results_dir: "bench_results".to_string(),
            profiling: false,
            filter: None,
            skip_slow: false,
            baseline: None,
        }
    }

    pub fn quick() -> Self {
        Self {
            warmup_iterations: 1,
            iterations: 10,
            min_time: Duration::from_millis(10),
            max_time: Duration::from_secs(1),
            confidence_level: 0.90,
            output_format: OutputFormat::Console,
            save_results: false,
            results_dir: "bench_results".to_string(),
            profiling: false,
            filter: None,
            skip_slow: true,
            baseline: None,
        }
    }

    pub fn thorough() -> Self {
        Self {
            warmup_iterations: 10,
            iterations: 1000,
            min_time: Duration::from_secs(1),
            max_time: Duration::from_secs(60),
            confidence_level: 0.99,
            output_format: OutputFormat::Json,
            save_results: true,
            results_dir: "bench_results".to_string(),
            profiling: true,
            filter: None,
            skip_slow: false,
            baseline: None,
        }
    }

    pub fn ci() -> Self {
        Self {
            warmup_iterations: 2,
            iterations: 50,
            min_time: Duration::from_millis(50),
            max_time: Duration::from_secs(5),
            confidence_level: 0.95,
            output_format: OutputFormat::Json,
            save_results: true,
            results_dir: "bench_results".to_string(),
            profiling: false,
            filter: None,
            skip_slow: true,
            baseline: Some("baseline.json".to_string()),
        }
    }
}

// ============================================================================
// Benchmark Categories
// ============================================================================

/// Benchmark category
pub enum BenchmarkCategory {
    /// Core types and operations
    Core,
    /// Inference engine
    Inference,
    /// Vision/VLM
    Vision,
    /// Image diffusion
    Diffusion,
    /// Video generation
    Video,
    /// Optimization techniques
    Optimization,
    /// Memory operations
    Memory,
    /// All categories
    All,
}

impl BenchmarkCategory {
    pub fn name(&self) -> &'static str {
        match self {
            Self::Core => "core",
            Self::Inference => "inference",
            Self::Vision => "vision",
            Self::Diffusion => "diffusion",
            Self::Video => "video",
            Self::Optimization => "optimization",
            Self::Memory => "memory",
            Self::All => "all",
        }
    }

    pub fn from_str(s: &str) -> Option<Self> {
        match s.to_lowercase().as_str() {
            "core" => Some(Self::Core),
            "inference" => Some(Self::Inference),
            "vision" => Some(Self::Vision),
            "diffusion" => Some(Self::Diffusion),
            "video" => Some(Self::Video),
            "optimization" => Some(Self::Optimization),
            "memory" => Some(Self::Memory),
            "all" => Some(Self::All),
            _ => None,
        }
    }
}

// ============================================================================
// Benchmark Sizes
// ============================================================================

/// Standard benchmark sizes for consistent testing
pub struct BenchmarkSizes {
    /// Tiny: Quick sanity checks
    pub tiny: SizeConfig,
    /// Small: Fast benchmarks
    pub small: SizeConfig,
    /// Medium: Standard benchmarks
    pub medium: SizeConfig,
    /// Large: Realistic workloads
    pub large: SizeConfig,
    /// XLarge: Stress tests
    pub xlarge: SizeConfig,
}

pub struct SizeConfig {
    /// Batch size
    pub batch: u32,
    /// Sequence length (for text)
    pub seq_len: u32,
    /// Image size (width = height)
    pub image_size: u32,
    /// Number of frames (for video)
    pub num_frames: u32,
    /// Hidden dimension
    pub hidden_dim: u32,
    /// Number of attention heads
    pub num_heads: u32,
}

impl BenchmarkSizes {
    pub fn standard() -> Self {
        Self {
            tiny: SizeConfig {
                batch: 1,
                seq_len: 32,
                image_size: 64,
                num_frames: 4,
                hidden_dim: 256,
                num_heads: 4,
            },
            small: SizeConfig {
                batch: 1,
                seq_len: 128,
                image_size: 256,
                num_frames: 8,
                hidden_dim: 512,
                num_heads: 8,
            },
            medium: SizeConfig {
                batch: 2,
                seq_len: 512,
                image_size: 512,
                num_frames: 16,
                hidden_dim: 1024,
                num_heads: 16,
            },
            large: SizeConfig {
                batch: 4,
                seq_len: 2048,
                image_size: 1024,
                num_frames: 24,
                hidden_dim: 2048,
                num_heads: 32,
            },
            xlarge: SizeConfig {
                batch: 8,
                seq_len: 8192,
                image_size: 2048,
                num_frames: 48,
                hidden_dim: 4096,
                num_heads: 64,
            },
        }
    }
}

// ============================================================================
// Hardware Configuration
// ============================================================================

/// Hardware configuration for benchmarks
pub struct HardwareConfig {
    /// Device type
    pub device: DeviceType,
    /// Number of threads (CPU)
    pub num_threads: u32,
    /// GPU device ID
    pub gpu_id: u32,
    /// Enable tensor cores
    pub tensor_cores: bool,
    /// Memory limit in bytes
    pub memory_limit: Option<u64>,
}

pub enum DeviceType {
    CPU,
    CUDA,
    Metal,
    Vulkan,
}

impl HardwareConfig {
    pub fn cpu(threads: u32) -> Self {
        Self {
            device: DeviceType::CPU,
            num_threads: threads,
            gpu_id: 0,
            tensor_cores: false,
            memory_limit: None,
        }
    }

    pub fn cuda(gpu_id: u32) -> Self {
        Self {
            device: DeviceType::CUDA,
            num_threads: 1,
            gpu_id,
            tensor_cores: true,
            memory_limit: None,
        }
    }

    pub fn detect() -> Self {
        // Would detect available hardware
        Self::cpu(num_cpus())
    }
}

fn num_cpus() -> u32 {
    // Would detect CPU count
    8
}

// ============================================================================
// Benchmark Metadata
// ============================================================================

/// Metadata for a benchmark
pub struct BenchmarkMeta {
    /// Unique benchmark name
    pub name: String,
    /// Category
    pub category: BenchmarkCategory,
    /// Description
    pub description: String,
    /// Tags for filtering
    pub tags: Vec<String>,
    /// Is this a slow benchmark?
    pub slow: bool,
    /// Required features
    pub requires: Vec<String>,
}

impl BenchmarkMeta {
    pub fn new(name: &str, category: BenchmarkCategory) -> Self {
        Self {
            name: name.to_string(),
            category,
            description: String::new(),
            tags: Vec::new(),
            slow: false,
            requires: Vec::new(),
        }
    }

    pub fn description(mut self, desc: &str) -> Self {
        self.description = desc.to_string()
        self
    }

    pub fn tag(mut self, tag: &str) -> Self {
        self.tags.push(tag.to_string())
        self
    }

    pub fn slow(mut self) -> Self {
        self.slow = true
        self
    }

    pub fn requires(mut self, feature: &str) -> Self {
        self.requires.push(feature.to_string())
        self
    }
}
