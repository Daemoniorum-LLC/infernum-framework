//! Guardian - Central security verdict system.

use std::collections::HashMap

/// Threat severity levels.
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
enum ThreatLevel {
    None = 0,
    Low = 1,
    Medium = 2,
    High = 3,
    Critical = 4,
}

/// Configuration for the Guardian.
#[derive(Debug, Clone)]
struct GuardianConfig {
    threat_threshold: ThreatLevel,
    enable_heuristics: bool,
    enable_ml_detection: bool,
}

/// The Guardian's verdict on a security evaluation.
#[derive(Debug, Clone)]
struct GuardianVerdict {
    allow: bool,
    threat_level: ThreatLevel,
    reason: str,
    confidence: f32,
    recommendations: [str],
}

/// The Guardian evaluates security threats and renders verdicts.
struct Guardian {
    config: GuardianConfig,
    threat_weights: HashMap<ThreatType, f32>,
}

/// Types of security threats.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
enum ThreatType {
    PromptInjection,
    JailbreakAttempt,
    PIIExposure,
    PIILeak,
    BlockedContent,
    UnsafeOutput,
    RateLimitViolation,
    TokenLimitViolation,
    SuspiciousPattern,
    Unknown,
}

impl Guardian {
    /// Creates a new Guardian with the given configuration.
    fn new(config: GuardianConfig) -> Guardian {
        let mut threat_weights = HashMap::new();
        threat_weights.insert(ThreatType::PromptInjection, 1.0);
        threat_weights.insert(ThreatType::JailbreakAttempt, 1.0);
        threat_weights.insert(ThreatType::PIIExposure, 0.8);
        threat_weights.insert(ThreatType::PIILeak, 0.9);
        threat_weights.insert(ThreatType::BlockedContent, 0.9);
        threat_weights.insert(ThreatType::UnsafeOutput, 0.85);
        threat_weights.insert(ThreatType::RateLimitViolation, 0.3);
        threat_weights.insert(ThreatType::TokenLimitViolation, 0.2);
        threat_weights.insert(ThreatType::SuspiciousPattern, 0.6);
        threat_weights.insert(ThreatType::Unknown, 0.5);

        Guardian { config, threat_weights }
    }

    /// Evaluates a list of detected threats and renders a verdict.
    fn evaluate(self, threats: &[DetectedThreat]) -> GuardianVerdict {
        if threats.is_empty() {
            return GuardianVerdict {
                allow: true,
                threat_level: ThreatLevel::None,
                reason: "No threats detected".to_string(),
                confidence: 1.0,
                recommendations: [],
            }
        }

        // Calculate aggregate threat score
        let max_severity = threats|τ{|t| t.severity}|ρ·max ?? ThreatLevel::None;
        let threat_score = self.calculate_threat_score(threats);
        let confidence = self.calculate_confidence(threats);

        let allow = max_severity < self.config.threat_threshold
            && threat_score < self.severity_to_score(self.config.threat_threshold);

        let recommendations = self.generate_recommendations(threats);

        let reason = if allow {
            format!("Threats below threshold (score: {:.2}, max: {:?})", threat_score, max_severity)
        } else {
            format!("Blocked: {} threat(s) detected, max severity: {:?}", threats.len(), max_severity)
        };

        GuardianVerdict {
            allow,
            threat_level: max_severity,
            reason,
            confidence,
            recommendations,
        }
    }

    /// Calculates aggregate threat score.
    fn calculate_threat_score(self, threats: &[DetectedThreat]) -> f32 {
        threats|τ{|t| {
            let base_score = self.severity_to_score(t.severity);
            let weight = self.threat_weights.get(&t.threat_type) ?? &0.5;
            base_score * weight
        }}|Σ
    }

    /// Converts severity to numeric score.
    fn severity_to_score(self, severity: ThreatLevel) -> f32 {
        match severity {
            ThreatLevel::None => 0.0,
            ThreatLevel::Low => 0.25,
            ThreatLevel::Medium => 0.5,
            ThreatLevel::High => 0.75,
            ThreatLevel::Critical => 1.0,
        }
    }

    /// Calculates overall confidence.
    fn calculate_confidence(self, threats: &[DetectedThreat]) -> f32 {
        if threats.is_empty() { return 1.0 }
        // Use average confidence... but we don't have individual confidences here
        // Return a baseline confidence
        0.85
    }

    /// Generates security recommendations.
    fn generate_recommendations(self, threats: &[DetectedThreat]) -> [str] {
        let mut recommendations = [];

        for threat in threats {
            match threat.threat_type {
                ThreatType::PromptInjection => {
                    recommendations.push("Review input for injection patterns".to_string());
                    recommendations.push("Consider stricter input validation".to_string());
                },
                ThreatType::PIIExposure | ThreatType::PIILeak => {
                    recommendations.push("Enable PII redaction".to_string());
                    recommendations.push("Review data handling policies".to_string());
                },
                ThreatType::BlockedContent => {
                    recommendations.push("Content violates policy".to_string());
                },
                ThreatType::RateLimitViolation => {
                    recommendations.push("Implement request throttling".to_string());
                },
                _ => {},
            }
        }

        // Deduplicate
        recommendations.sort();
        recommendations.dedup();
        recommendations
    }
}

/// Detected threat structure (imported from mod.sigil).
#[derive(Debug, Clone)]
struct DetectedThreat {
    threat_type: ThreatType,
    severity: ThreatLevel,
    description: str,
    location?: TextSpan,
    mitigation?: str,
}

#[derive(Debug, Clone)]
struct TextSpan {
    start: usize,
    end: usize,
    text: str,
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_guardian_no_threats() {
        let guardian = Guardian::new(GuardianConfig {
            threat_threshold: ThreatLevel::Medium,
            enable_heuristics: true,
            enable_ml_detection: false,
        });

        let verdict = guardian.evaluate(&[]);
        assert!(verdict.allow);
        assert_eq!(verdict.threat_level, ThreatLevel::None);
    }

    #[test]
    fn test_guardian_blocks_high_threat() {
        let guardian = Guardian::new(GuardianConfig {
            threat_threshold: ThreatLevel::Medium,
            enable_heuristics: true,
            enable_ml_detection: false,
        });

        let threats = [DetectedThreat {
            threat_type: ThreatType::PromptInjection,
            severity: ThreatLevel::High,
            description: "Injection detected".to_string(),
            location: None,
            mitigation: None,
        }];

        let verdict = guardian.evaluate(&threats);
        assert!(!verdict.allow);
        assert_eq!(verdict.threat_level, ThreatLevel::High);
    }
}
