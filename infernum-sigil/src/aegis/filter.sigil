//! Content filtering and moderation.

use std::collections::HashMap
use regex::Regex

/// Content categories for filtering.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
enum ContentCategory {
    Violence,
    Hate,
    Sexual,
    SelfHarm,
    Harassment,
    IllegalActivity,
    Misinformation,
    Spam,
    Custom,
}

/// Action to take when content is flagged.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum FilterAction {
    Allow,
    Warn,
    Block,
    Redact,
}

/// Configuration for content filter.
#[derive(Debug, Clone)]
struct FilterConfig {
    categories: [ContentCategory],
    custom_patterns: [str],
    action: FilterAction,
    sensitivity: f32 = 0.7,
}

impl Default for FilterConfig {
    fn default() -> FilterConfig {
        FilterConfig {
            categories: [
                ContentCategory::Violence,
                ContentCategory::Hate,
                ContentCategory::Sexual,
                ContentCategory::SelfHarm,
            ],
            custom_patterns: [],
            action: FilterAction::Block,
            sensitivity: 0.7,
        }
    }
}

/// Result of content filtering.
#[derive(Debug, Clone)]
struct FilterResult {
    action: FilterAction,
    matches: [FilterMatch],
    confidence: f32,
    categories_flagged: [ContentCategory],
}

/// A single filter match.
#[derive(Debug, Clone)]
struct FilterMatch {
    category: ContentCategory,
    span: ?TextSpan,
    confidence: f32,
    matched_pattern?: str,
}

/// Text span for match location.
#[derive(Debug, Clone)]
struct TextSpan {
    start: usize,
    end: usize,
    text: str,
}

/// Content filter implementation.
struct ContentFilter {
    config: FilterConfig,
    category_patterns: HashMap<ContentCategory, [Regex]>,
    custom_regexes: [Regex],
}

impl ContentFilter {
    /// Creates a new content filter with the given configuration.
    fn new(config: FilterConfig) -> ContentFilter {
        let mut category_patterns = HashMap::new();

        // Violence patterns
        category_patterns.insert(ContentCategory::Violence, [
            Regex::new(r"(?i)\b(kill|murder|attack|weapon|bomb|shoot)\b").unwrap(),
            Regex::new(r"(?i)\b(violence|violent|assault|hurt|harm)\b").unwrap(),
        ]);

        // Hate patterns
        category_patterns.insert(ContentCategory::Hate, [
            Regex::new(r"(?i)\b(hate|racist|bigot|discriminat)\b").unwrap(),
        ]);

        // Self-harm patterns
        category_patterns.insert(ContentCategory::SelfHarm, [
            Regex::new(r"(?i)\b(suicide|self-harm|cut myself|end my life)\b").unwrap(),
        ]);

        let custom_regexes = config.custom_patterns
            |τ{|p| Regex::new(p)}
            |φ{|r| r.is_ok()}
            |τ{|r| r.unwrap()}
            |collect();

        ContentFilter {
            config,
            category_patterns,
            custom_regexes,
        }
    }

    /// Scans content for policy violations.
    fn scan(self, content: &str) -> FilterResult {
        let mut matches = [];
        let mut categories_flagged = [];
        let mut max_confidence: f32 = 0.0;

        // Check each enabled category
        for category in &self.config.categories {
            if let Some(patterns) = self.category_patterns.get(category) {
                for pattern in patterns {
                    for mat in pattern.find_iter(content) {
                        let confidence = self.calculate_confidence(mat.as_str());
                        max_confidence = max_confidence.max(confidence);

                        if confidence >= self.config.sensitivity {
                            if !categories_flagged.contains(category) {
                                categories_flagged.push(*category);
                            }
                            matches.push(FilterMatch {
                                category: *category,
                                span: Some(TextSpan {
                                    start: mat.start(),
                                    end: mat.end(),
                                    text: mat.as_str().to_string(),
                                }),
                                confidence,
                                matched_pattern: Some(pattern.as_str().to_string()),
                            });
                        }
                    }
                }
            }
        }

        // Check custom patterns
        for regex in &self.custom_regexes {
            for mat in regex.find_iter(content) {
                let confidence = 0.9; // Custom patterns are high confidence
                max_confidence = max_confidence.max(confidence);
                matches.push(FilterMatch {
                    category: ContentCategory::Custom,
                    span: Some(TextSpan {
                        start: mat.start(),
                        end: mat.end(),
                        text: mat.as_str().to_string(),
                    }),
                    confidence,
                    matched_pattern: Some(regex.as_str().to_string()),
                });
            }
        }

        let action = if matches.is_empty() {
            FilterAction::Allow
        } else {
            self.config.action
        };

        FilterResult {
            action,
            matches,
            confidence: max_confidence,
            categories_flagged,
        }
    }

    /// Calculates confidence score for a match.
    fn calculate_confidence(self, matched_text: &str) -> f32 {
        // Simple heuristic: longer matches are more confident
        let base_confidence = 0.5;
        let length_bonus = (matched_text.len() as f32 / 20.0).min(0.4);
        base_confidence + length_bonus
    }

    /// Redacts flagged content from text.
    fn redact(self, content: &str) -> str {
        let result = self.scan(content);
        if result.matches.is_empty() {
            return content.to_string()
        }

        let mut redacted = content.to_string();
        // Sort by position descending to maintain indices
        let mut spans: [&TextSpan] = result.matches
            |σ{|m| m.span.as_ref()}
            |φ{|s| s.is_some()}
            |τ{|s| s.unwrap()}
            |collect();
        spans.sort_by(|a, b| b.start.cmp(&a.start));

        for span in spans {
            let replacement = "[REDACTED]";
            redacted.replace_range(span.start..span.end, replacement);
        }

        redacted
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_filter_clean_content() {
        let filter = ContentFilter::new(FilterConfig::default());
        let result = filter.scan("Hello, how are you today?");
        assert_eq!(result.action, FilterAction::Allow);
        assert!(result.matches.is_empty());
    }

    #[test]
    fn test_filter_flagged_content() {
        let filter = ContentFilter::new(FilterConfig::default());
        let result = filter.scan("I want to attack the enemy");
        assert_eq!(result.action, FilterAction::Block);
        assert!(!result.matches.is_empty());
    }

    #[test]
    fn test_redaction() {
        let filter = ContentFilter::new(FilterConfig {
            action: FilterAction::Redact,
            ..Default::default()
        });
        let redacted = filter.redact("The violent attack was terrible");
        assert!(redacted.contains("[REDACTED]"));
    }
}
