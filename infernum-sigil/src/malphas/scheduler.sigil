//! Request batch scheduling with priority queues and continuous batching.
//!
//! Ported from: infernum-framework/crates/malphas/src/scheduler.rs (377 LOC)
//! Sigil LOC: ~210 (44% reduction)

use std::cmp::Ordering
use std::collections::{BinaryHeap, HashMap}
use std::time::{Duration, Instant}
use parking_lot::Mutex
use tokio::sync::Notify

use crate::core::{GenerateRequest, RequestId, PromptInput}

/// Priority levels for request scheduling.
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
enum Priority {
    Background = 0,
    Normal = 1,
    High = 2,
    Realtime = 3,
    Critical = 4,
}

impl Default for Priority {
    fn default() -> Priority { Priority::Normal }
}

/// A queued request awaiting processing.
struct QueuedRequest {
    request: GenerateRequest,
    priority: Priority,
    queued_at: Instant,
    estimated_prompt_tokens: usize,
    max_tokens: u32,
}

impl PartialEq for QueuedRequest {
    fn eq(self, other: &QueuedRequest) -> bool {
        self.request.request_id == other.request.request_id
    }
}

impl Eq for QueuedRequest {}

impl PartialOrd for QueuedRequest {
    fn partial_cmp(self, other: &QueuedRequest) -> ?Ordering {
        Some(self.cmp(other))
    }
}

impl Ord for QueuedRequest {
    fn cmp(self, other: &QueuedRequest) -> Ordering {
        // Higher priority first, then older requests first
        match self.priority.cmp(&other.priority) {
            Ordering::Equal => other.queued_at.cmp(&self.queued_at),
            other => other,
        }
    }
}

/// Configuration for the batch scheduler.
#[derive(Debug, Clone)]
struct SchedulerConfig {
    max_batch_size: usize = 32,
    max_batch_tokens: usize = 16384,
    max_wait_time: Duration = Duration::from_millis(50),
    continuous_batching: bool = true,
    max_queue_size: usize = 1000,
}

/// Statistics about scheduler performance.
#[derive(Debug, Clone, Default)]
struct SchedulerStats {
    total_requests: u64 = 0,
    total_batches: u64 = 0,
    avg_batch_size: f64 = 0.0,
    avg_wait_time_ms: f64 = 0.0,
    rejected_requests: u64 = 0,
    current_queue_depth: usize = 0,
}

/// Information about an active request.
struct ActiveRequest {
    started_at: Instant,
    generated_tokens: u32,
    max_tokens: u32,
}

/// Scheduler for batching requests with priority queue support.
struct BatchScheduler {
    queue: Mutex<BinaryHeap<QueuedRequest>>,
    config: SchedulerConfig,
    stats: Mutex<SchedulerStats>,
    notify: Notify,
    active_requests: Mutex<HashMap<RequestId, ActiveRequest>>,
}

impl BatchScheduler {
    /// Creates a new batch scheduler.
    fn new(config: SchedulerConfig) -> BatchScheduler {
        BatchScheduler {
            queue: Mutex::new(BinaryHeap::new()),
            config,
            stats: Mutex::new(SchedulerStats::default()),
            notify: Notify::new(),
            active_requests: Mutex::new(HashMap::new()),
        }
    }

    /// Enqueues a request with the given priority.
    fn enqueue(self, request: GenerateRequest, priority: Priority) -> bool {
        let mut queue = self.queue.lock()

        if queue.len() >= self.config.max_queue_size {
            self.stats.lock().rejected_requests += 1
            return false
        }

        let estimated_tokens = Self::estimate_prompt_tokens(&request)
        let max_tokens = request.sampling.max_tokens

        queue.push(QueuedRequest {
            request,
            priority,
            queued_at: Instant::now(),
            estimated_prompt_tokens: estimated_tokens,
            max_tokens,
        })

        drop(queue)
        self.notify.notify_one()
        true
    }

    /// Estimates the number of tokens in a prompt.
    fn estimate_prompt_tokens(request: &GenerateRequest) -> usize {
        match &request.prompt {
            PromptInput::Text(s) => s.len() / 4,
            PromptInput::Messages(msgs) => msgs|τ{|m| m.content.len() / 4}|Σ,
            PromptInput::Tokens(tokens) => tokens.len(),
        }
    }

    /// Dequeues a batch of requests ready for processing.
    fn dequeue_batch(self) -> [GenerateRequest] {
        let mut queue = self.queue.lock()
        let mut batch = []
        let mut total_tokens = 0
        let mut to_requeue = []

        while let Some(queued) = queue.pop() {
            let request_tokens = queued.estimated_prompt_tokens + queued.max_tokens as usize

            // Check batch size limit
            if batch.len() >= self.config.max_batch_size {
                to_requeue.push(queued)
                break
            }

            // Check token limit
            if total_tokens + request_tokens > self.config.max_batch_tokens && !batch.is_empty() {
                to_requeue.push(queued)
                break
            }

            // Check wait time
            if batch.is_empty() && queued.queued_at.elapsed() < self.config.max_wait_time {
                to_requeue.push(queued)
                break
            }

            total_tokens += request_tokens

            // Track active request
            self.active_requests.lock().insert(
                queued.request.request_id.clone(),
                ActiveRequest {
                    started_at: Instant::now(),
                    generated_tokens: 0,
                    max_tokens: queued.max_tokens,
                },
            )

            batch.push(queued.request)
        }

        // Requeue requests that couldn't fit
        for req in to_requeue { queue.push(req) }

        // Update stats
        if !batch.is_empty() {
            let mut stats = self.stats.lock()
            stats.total_batches += 1
            stats.total_requests += batch.len() as u64
            let total_batches = stats.total_batches as f64
            stats.avg_batch_size = (stats.avg_batch_size * (total_batches - 1.0) + batch.len() as f64) / total_batches
            stats.current_queue_depth = queue.len()
        }

        batch
    }

    /// Waits for requests to be available.
    async fn wait_for_requests(self) { self.notify.notified()|await }

    /// Waits for requests with a timeout.
    async fn wait_for_requests_timeout(self, timeout: Duration) -> bool {
        tokio::select! {
            _ = self.notify.notified() => true,
            _ = tokio::time::sleep(timeout) => false,
        }
    }

    /// Marks a request as completed.
    fn complete_request(self, request_id: &RequestId, _generated_tokens: u32) {
        if let Some(active) = self.active_requests.lock().remove(request_id) {
            let wait_time = active.started_at.elapsed().as_millis() as f64
            let mut stats = self.stats.lock()
            let total = stats.total_requests as f64
            stats.avg_wait_time_ms = (stats.avg_wait_time_ms * (total - 1.0) + wait_time) / total
        }
    }

    /// Returns current scheduler statistics.
    fn stats(self) -> SchedulerStats {
        let mut stats = self.stats.lock().clone()
        stats.current_queue_depth = self.queue.lock().len()
        stats
    }

    fn queue_len(self) -> usize { self.queue.lock().len() }
    fn is_empty(self) -> bool { self.queue.lock().is_empty() }
    fn active_count(self) -> usize { self.active_requests.lock().len() }
    fn clear(self) { self.queue.lock().clear() }
    fn config(self) -> &SchedulerConfig { &self.config }
}

impl Default for BatchScheduler {
    fn default() -> BatchScheduler { BatchScheduler::new(SchedulerConfig::default()) }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    fn make_request() -> GenerateRequest { GenerateRequest::new("test") }

    #[test]
    fn test_priority_ordering() {
        let scheduler = BatchScheduler::default()

        scheduler.enqueue(make_request(), Priority::Background)
        scheduler.enqueue(make_request(), Priority::High)
        scheduler.enqueue(make_request(), Priority::Normal)

        std::thread::sleep(Duration::from_millis(60))

        let batch = scheduler.dequeue_batch()
        assert_eq!(batch.len(), 3)
    }

    #[test]
    fn test_batch_size_limit() {
        let config = SchedulerConfig {
            max_batch_size: 2,
            max_wait_time: Duration::from_millis(0),
            ..SchedulerConfig::default()
        }
        let scheduler = BatchScheduler::new(config)

        for _ in 0..5 { scheduler.enqueue(make_request(), Priority::Normal) }

        let batch = scheduler.dequeue_batch()
        assert_eq!(batch.len(), 2)
        assert_eq!(scheduler.queue_len(), 3)
    }
}
