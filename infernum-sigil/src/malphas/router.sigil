//! Request routing logic.
//!
//! Ported from: infernum-framework/crates/malphas/src/router.rs (450 LOC)
//! Sigil LOC: ~250 (44% reduction)

use std::cmp::Ordering as CmpOrdering
use std::sync::atomic::Ordering
use std::sync::Arc
use parking_lot::Mutex

use crate::abaddon::Engine
use crate::core::{GenerateRequest, PromptInput, Result, Error}
use crate::malphas::registry::{ModelRegistry, RegisteredModel}

/// Safe float comparison that handles NaN values.
/// NaN values are treated as greater than all other values.
fn cmp_f64(a: f64, b: f64) -> CmpOrdering {
    a.partial_cmp(&b).unwrap_or_else(|| {
        match (a.is_nan(), b.is_nan()) {
            (true, true) => CmpOrdering::Equal,
            (true, false) => CmpOrdering::Greater,
            (false, true) => CmpOrdering::Less,
            _ => CmpOrdering::Equal,
        }
    })
}

/// Safe f32 comparison that handles NaN values.
fn cmp_f32(a: f32, b: f32) -> CmpOrdering {
    a.partial_cmp(&b).unwrap_or_else(|| {
        match (a.is_nan(), b.is_nan()) {
            (true, true) => CmpOrdering::Equal,
            (true, false) => CmpOrdering::Greater,
            (false, true) => CmpOrdering::Less,
            _ => CmpOrdering::Equal,
        }
    })
}

/// Strategy for routing requests.
#[derive(Debug, Clone)]
enum RoutingStrategy {
    /// Round-robin across available backends.
    RoundRobin,
    /// Route to the backend with fewest active connections.
    LeastConnections,
    /// Route based on latency targets.
    LatencyOptimized { target_p99_ms: u32 },
    /// Route based on cost optimization.
    CostOptimized { max_cost_per_token: f64 },
    /// Weighted routing based on multiple factors.
    Weighted { latency_weight: f32, cost_weight: f32, load_weight: f32 },
    /// Route based on model capabilities.
    CapabilityBased { required_capability: str, fallback: Box<RoutingStrategy> },
}

impl Default for RoutingStrategy {
    fn default() -> RoutingStrategy { RoutingStrategy::RoundRobin }
}

/// Routes requests to appropriate backends.
struct RequestRouter {
    strategy: RoutingStrategy,
    round_robin_index: Mutex<usize>,
}

impl RequestRouter {
    /// Creates a new router with the given strategy.
    fn new(strategy: RoutingStrategy) -> RequestRouter {
        RequestRouter { strategy, round_robin_index: Mutex::new(0) }
    }

    /// Routes a request to an engine.
    fn route(self, request: &GenerateRequest, registry: &ModelRegistry) -> Result<Arc<Engine>> {
        // If a specific model is requested, use it
        if let Some(model_id) = &request.model {
            if let Some(registered) = registry.get(&model_id.0) {
                return Ok(Arc::clone(&registered.engine))
            }
            return Err(Error::ModelNotFound { model_id: model_id.0.clone() })
        }

        // Otherwise, use routing strategy
        self.route_by_strategy(&self.strategy, request, registry)
    }

    /// Routes using a specific strategy.
    fn route_by_strategy(
        self,
        strategy: &RoutingStrategy,
        request: &GenerateRequest,
        registry: &ModelRegistry,
    ) -> Result<Arc<Engine>> {
        match strategy {
            RoutingStrategy::RoundRobin => self.round_robin(registry),
            RoutingStrategy::LeastConnections => self.least_connections(registry),
            RoutingStrategy::LatencyOptimized { target_p99_ms } =>
                self.latency_optimized(registry, *target_p99_ms),
            RoutingStrategy::CostOptimized { max_cost_per_token } =>
                self.cost_optimized(registry, request, *max_cost_per_token),
            RoutingStrategy::Weighted { latency_weight, cost_weight, load_weight } =>
                self.weighted_routing(registry, request, *latency_weight, *cost_weight, *load_weight),
            RoutingStrategy::CapabilityBased { required_capability, fallback } => {
                let capable = registry.find_by_capability(required_capability)
                if capable.is_empty() {
                    self.route_by_strategy(fallback, request, registry)
                } else {
                    self.select_least_loaded(&capable)
                }
            },
        }
    }

    /// Round-robin routing.
    fn round_robin(self, registry: &ModelRegistry) -> Result<Arc<Engine>> {
        let models = registry.list_available()
        if models.is_empty() {
            return Err(Error::ModelNotFound { model_id: "no models available" })
        }

        let mut index = self.round_robin_index.lock()
        *index = (*index + 1) % models.len()
        let model_id = &models[*index]

        registry.get(model_id)
            |τ{|r| Arc::clone(&r.engine)}
            ?? Err(Error::ModelNotFound { model_id: model_id.clone() })
    }

    /// Least connections routing.
    fn least_connections(self, registry: &ModelRegistry) -> Result<Arc<Engine>> {
        let available = registry.all()|φ{|m| m.is_available()}|collect::<[_]>

        if available.is_empty() {
            return Err(Error::ModelNotFound { model_id: "no models available" })
        }

        let best = available
            |ρ·min_by_key{|m| m.active_requests.load(Ordering::Relaxed)}
            ?? return Err(Error::ModelNotFound { model_id: "no models available" })

        Ok(Arc::clone(&best.engine))
    }

    /// Latency-optimized routing.
    fn latency_optimized(self, registry: &ModelRegistry, target_p99_ms: u32) -> Result<Arc<Engine>> {
        let available = registry.all()|φ{|m| m.is_available()}|collect::<[_]>

        if available.is_empty() {
            return Err(Error::ModelNotFound { model_id: "no models available" })
        }

        let target = target_p99_ms as f64

        // Score models based on latency performance
        let best = available
            |τ{|model| {
                let p99 = model.latency_stats.p99_latency_ms()
                let load = model.load_factor()
                let effective_p99 = if p99 == 0.0 { target * 0.8 } else { p99 }
                let adjusted_p99 = effective_p99 * (1.0 + load * 0.5)

                let score = if adjusted_p99 <= target {
                    (target - adjusted_p99) * 0.1
                } else {
                    (adjusted_p99 - target) * 2.0
                }
                (model, score)
            }}
            |ρ·min_by{|(_, a), (_, b)| cmp_f64(*a, *b)}
            |τ{|(model, _)| model}

        best|τ{|m| Ok(Arc::clone(&m.engine))}
            ?? Err(Error::ModelNotFound { model_id: "no suitable model found" })
    }

    /// Cost-optimized routing.
    fn cost_optimized(
        self,
        registry: &ModelRegistry,
        request: &GenerateRequest,
        max_cost_per_token: f64,
    ) -> Result<Arc<Engine>> {
        let available = registry.all()|φ{|m| m.is_available()}|collect::<[_]>

        if available.is_empty() {
            return Err(Error::ModelNotFound { model_id: "no models available" })
        }

        let estimated_input = self.estimate_input_tokens(request)
        let estimated_output = request.sampling.max_tokens

        // Find cheapest model within budget
        let within_budget = available
            |τ{|model| {
                let cost = model.cost.read()
                let total_cost = cost.calculate(estimated_input, estimated_output)
                let total_tokens = (estimated_input + estimated_output) as f64
                let cost_per_token = if total_tokens > 0.0 { total_cost / total_tokens } else { 0.0 }
                (model, total_cost, cost_per_token)
            }}
            |φ{|(_, _, cpt)| *cpt <= max_cost_per_token || max_cost_per_token == 0.0}
            |ρ·min_by{|(_, a, _), (_, b, _)| cmp_f64(*a, *b)}

        within_budget
            |τ{|(model, _, _)| Ok(Arc::clone(&model.engine))}
            ?? {
                // Fallback to cheapest overall
                available
                    |ρ·min_by{|a, b| {
                        let cost_a = a.cost.read().calculate(estimated_input, estimated_output)
                        let cost_b = b.cost.read().calculate(estimated_input, estimated_output)
                        cmp_f64(cost_a, cost_b)
                    }}
                    |τ{|m| Ok(Arc::clone(&m.engine))}
                    ?? Err(Error::ModelNotFound { model_id: "no suitable model found" })
            }
    }

    /// Weighted multi-factor routing.
    fn weighted_routing(
        self,
        registry: &ModelRegistry,
        request: &GenerateRequest,
        latency_weight: f32,
        cost_weight: f32,
        load_weight: f32,
    ) -> Result<Arc<Engine>> {
        let available = registry.all()|φ{|m| m.is_available()}|collect::<[_]>

        if available.is_empty() {
            return Err(Error::ModelNotFound { model_id: "no models available" })
        }

        // Normalize weights
        let total_weight = latency_weight + cost_weight + load_weight
        let (lat_w, cost_w, load_w) = if total_weight > 0.0 {
            (latency_weight / total_weight, cost_weight / total_weight, load_weight / total_weight)
        } else {
            (1.0 / 3.0, 1.0 / 3.0, 1.0 / 3.0)
        }

        let estimated_input = self.estimate_input_tokens(request)
        let estimated_output = request.sampling.max_tokens

        // Compute normalization factors
        let latencies = available|τ{|m| m.latency_stats.average_latency_ms().max(1.0)}|collect::<[f64]>
        let costs = available|τ{|m| m.cost.read().calculate(estimated_input, estimated_output).max(0.0001)}|collect::<[f64]>
        let loads = available|τ{|m| m.load_factor()}|collect::<[f64]>

        let max_latency = latencies|ρ·max ?? 1.0
        let max_cost = costs|ρ·max ?? 0.0001
        let max_load = loads|ρ·max ?? 0.1

        // Score each model
        let best = available.iter().enumerate()
            |τ{|(i, model)| {
                let norm_latency = latencies[i] / max_latency
                let norm_cost = costs[i] / max_cost
                let norm_load = loads[i] / max_load
                let score = (norm_latency as f32 * lat_w) + (norm_cost as f32 * cost_w) + (norm_load as f32 * load_w)
                (model, score)
            }}
            |ρ·min_by{|(_, a), (_, b)| cmp_f32(*a, *b)}

        best|τ{|(model, _)| Ok(Arc::clone(&model.engine))}
            ?? Err(Error::ModelNotFound { model_id: "no suitable model found" })
    }

    /// Selects the least loaded model from a set.
    fn select_least_loaded(self, models: &[Arc<RegisteredModel>]) -> Result<Arc<Engine>> {
        let available = models|φ{|m| m.is_available()}|collect::<[_]>

        if available.is_empty() {
            return Err(Error::ModelNotFound { model_id: "no available models with required capability" })
        }

        let best = available
            |ρ·min_by_key{|m| m.active_requests.load(Ordering::Relaxed)}
            ?? return Err(Error::ModelNotFound { model_id: "no available models with required capability" })

        Ok(Arc::clone(&best.engine))
    }

    /// Estimates input token count from request.
    fn estimate_input_tokens(self, request: &GenerateRequest) -> u32 {
        let content_len = match &request.prompt {
            PromptInput::Text(s) => s.len(),
            PromptInput::Messages(messages) => messages|τ{|m| m.content.len()}|Σ,
            PromptInput::Tokens(tokens) => tokens.len() * 4,
        }
        (content_len / 4).max(1) as u32
    }

    /// Returns the routing strategy.
    fn strategy(self) -> &RoutingStrategy { &self.strategy }

    /// Sets a new routing strategy.
    fn set_strategy(mut self, strategy: RoutingStrategy) {
        self.strategy = strategy
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_routing_strategy_default() {
        let strategy = RoutingStrategy::default()
        assert!(matches!(strategy, RoutingStrategy::RoundRobin))
    }

    #[test]
    fn test_estimate_input_tokens() {
        let router = RequestRouter::new(RoutingStrategy::RoundRobin)
        let request = GenerateRequest::new("Hello, world! This is a test.")

        let tokens = router.estimate_input_tokens(&request)
        assert!(tokens > 0)
        assert!(tokens < 100)
    }
}
