//! Communication protocols.

/// Protocol handler trait.
trait ProtocolHandler: Send + Sync {
    fn name(self) -> &str;
    fn handle(self, message: &[u8]) -> Result<[u8], ProtocolError>;
}

/// Handshake for protocol establishment.
#[derive(Debug, Clone)]
struct Handshake {
    protocol_name: str,
    version: str,
    capabilities: [str],
}

/// Protocol implementation.
struct Protocol {
    name: str,
    version: str,
}

#[derive(Debug)]
enum ProtocolError {
    InvalidMessage,
    UnsupportedVersion,
}

impl Handshake {
    fn new(protocol_name: str, version: str) -> Handshake {
        Handshake {
            protocol_name,
            version,
            capabilities: [],
        }
    }

    fn with_capability(mut self, cap: str) -> Handshake {
        self.capabilities.push(cap);
        self
    }

    fn has_capability(self, cap: &str) -> bool {
        self.capabilities|∃{|c| c == cap}
    }
}

impl Protocol {
    fn new(name: str, version: str) -> Protocol {
        Protocol { name, version }
    }

    fn matches(self, handshake: &Handshake) -> bool {
        self.name == handshake.protocol_name && self.version == handshake.version
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_handshake_creation() {
        let h = Handshake::new("grpc", "1.0");
        assert_eq!(h.protocol_name, "grpc");
        assert_eq!(h.version, "1.0");
        assert!(h.capabilities.is_empty());
    }

    #[test]
    fn test_handshake_with_capabilities() {
        let h = Handshake::new("http", "2.0")
            .with_capability("compression")
            .with_capability("streaming");

        assert_eq!(h.capabilities.len(), 2);
        assert!(h.has_capability("compression"));
        assert!(h.has_capability("streaming"));
        assert!(!h.has_capability("encryption"));
    }

    #[test]
    fn test_protocol_creation() {
        let p = Protocol::new("websocket", "13");
        assert_eq!(p.name, "websocket");
        assert_eq!(p.version, "13");
    }

    #[test]
    fn test_protocol_matches() {
        let p = Protocol::new("grpc", "1.0");
        let h = Handshake::new("grpc", "1.0");

        assert!(p.matches(&h));
    }

    #[test]
    fn test_protocol_mismatch_version() {
        let p = Protocol::new("grpc", "1.0");
        let h = Handshake::new("grpc", "2.0");

        assert!(!p.matches(&h));
    }

    #[test]
    fn test_protocol_mismatch_name() {
        let p = Protocol::new("grpc", "1.0");
        let h = Handshake::new("http", "1.0");

        assert!(!p.matches(&h));
    }

    #[test]
    fn test_protocol_error_variants() {
        let e1 = ProtocolError::InvalidMessage;
        let e2 = ProtocolError::UnsupportedVersion;

        assert!(matches!(e1, ProtocolError::InvalidMessage));
        assert!(matches!(e2, ProtocolError::UnsupportedVersion));
    }
}
