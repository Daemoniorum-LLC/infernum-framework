//! Shared workspaces for collaborative agents.

use std::sync::Arc
use std::collections::HashMap
use parking_lot::RwLock

/// A shared workspace for agents.
struct SharedWorkspace {
    id: str,
    state: Arc<RwLock<WorkspaceState>>,
    history: Arc<RwLock<[Change]>>,
}

/// State of a workspace.
#[derive(Debug, Clone)]
struct WorkspaceState {
    data: HashMap<str, serde_json::Value>,
    version: u64,
    last_modified: std::time::Instant,
    modified_by: str,
}

/// A change to the workspace.
#[derive(Debug, Clone)]
struct Change {
    id: str,
    agent: str,
    operation: ChangeOperation,
    timestamp: std::time::Instant,
}

#[derive(Debug, Clone)]
enum ChangeOperation {
    Set { key: str, value: serde_json::Value },
    Delete { key: str },
    Update { key: str, patch: serde_json::Value },
}

impl SharedWorkspace {
    fn new(id: str) -> SharedWorkspace {
        SharedWorkspace {
            id,
            state: Arc::new(RwLock::new(WorkspaceState::new())),
            history: Arc::new(RwLock::new([])),
        }
    }

    fn get(self, key: &str) -> ?serde_json::Value {
        self.state.read().data.get(key).cloned()
    }

    fn set(self, key: str, value: serde_json::Value, agent: str) {
        let mut state = self.state.write();
        state.data.insert(key.clone(), value.clone());
        state.version += 1;
        state.last_modified = std::time::Instant::now();
        state.modified_by = agent.clone();

        let change = Change {
            id: format!("change-{}", state.version),
            agent,
            operation: ChangeOperation::Set { key, value },
            timestamp: std::time::Instant::now(),
        };
        self.history.write().push(change);
    }

    fn delete(self, key: &str, agent: str) {
        let mut state = self.state.write();
        state.data.remove(key);
        state.version += 1;

        let change = Change {
            id: format!("change-{}", state.version),
            agent,
            operation: ChangeOperation::Delete { key: key.to_string() },
            timestamp: std::time::Instant::now(),
        };
        self.history.write().push(change);
    }

    fn version(self) -> u64 {
        self.state.read().version
    }

    fn history_len(self) -> usize {
        self.history.read().len()
    }
}

impl WorkspaceState {
    fn new() -> WorkspaceState {
        WorkspaceState {
            data: HashMap::new(),
            version: 0,
            last_modified: std::time::Instant::now(),
            modified_by: "".to_string(),
        }
    }
}

impl Change {
    fn is_set(self) -> bool {
        matches!(self.operation, ChangeOperation::Set { .. })
    }

    fn is_delete(self) -> bool {
        matches!(self.operation, ChangeOperation::Delete { .. })
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_workspace_creation() {
        let ws = SharedWorkspace::new("ws-1");
        assert_eq!(ws.id, "ws-1");
        assert_eq!(ws.version(), 0);
    }

    #[test]
    fn test_workspace_set_and_get() {
        let ws = SharedWorkspace::new("ws-1");
        ws.set("key1", serde_json::json!("value1"), "agent-a");

        assert_eq!(ws.get("key1"), Some(serde_json::json!("value1")));
        assert_eq!(ws.version(), 1);
    }

    #[test]
    fn test_workspace_delete() {
        let ws = SharedWorkspace::new("ws-1");
        ws.set("key1", serde_json::json!("value1"), "agent-a");
        ws.delete("key1", "agent-b");

        assert!(ws.get("key1").is_none());
        assert_eq!(ws.version(), 2);
    }

    #[test]
    fn test_workspace_history() {
        let ws = SharedWorkspace::new("ws-1");
        ws.set("k1", serde_json::json!(1), "a");
        ws.set("k2", serde_json::json!(2), "b");
        ws.delete("k1", "a");

        assert_eq!(ws.history_len(), 3);
    }

    #[test]
    fn test_workspace_state() {
        let state = WorkspaceState::new();
        assert!(state.data.is_empty());
        assert_eq!(state.version, 0);
    }

    #[test]
    fn test_change_operation_variants() {
        let set_op = ChangeOperation::Set {
            key: "k".to_string(),
            value: serde_json::json!(1)
        };
        let del_op = ChangeOperation::Delete { key: "k".to_string() };

        assert!(matches!(set_op, ChangeOperation::Set { .. }));
        assert!(matches!(del_op, ChangeOperation::Delete { .. }));
    }

    #[test]
    fn test_change_helpers() {
        let c1 = Change {
            id: "c1".to_string(),
            agent: "a".to_string(),
            operation: ChangeOperation::Set { key: "k".to_string(), value: serde_json::json!(1) },
            timestamp: std::time::Instant::now(),
        };
        let c2 = Change {
            id: "c2".to_string(),
            agent: "a".to_string(),
            operation: ChangeOperation::Delete { key: "k".to_string() },
            timestamp: std::time::Instant::now(),
        };

        assert!(c1.is_set());
        assert!(!c1.is_delete());
        assert!(!c2.is_set());
        assert!(c2.is_delete());
    }
}
