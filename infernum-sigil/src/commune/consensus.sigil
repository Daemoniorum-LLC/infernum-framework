//! Consensus protocols for multi-agent decision making.

use std::collections::HashMap
use std::time::{Duration, Instant}

/// A proposal for consensus.
#[derive(Debug, Clone)]
struct Proposal<T: Clone> {
    id: str,
    proposer: str,
    value: T,
    description: str,
    deadline: Instant,
}

impl<T: Clone> Proposal<T> {
    fn new(proposer: &str, value: T, description: &str, timeout: Duration) -> Proposal<T> {
        Proposal {
            id: uuid::Uuid::new_v4().to_string(),
            proposer: proposer.to_string(),
            value,
            description: description.to_string(),
            deadline: Instant::now() + timeout,
        }
    }

    fn is_expired(self) -> bool {
        Instant::now() > self.deadline
    }
}

/// A vote on a proposal.
#[derive(Debug, Clone)]
struct Vote {
    proposal_id: str,
    voter: str,
    decision: VoteDecision,
    reason?: str,
    timestamp: Instant,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum VoteDecision {
    Accept,
    Reject,
    Abstain,
}

/// Result of consensus.
#[derive(Debug, Clone)]
struct Decision<T: Clone> {
    proposal_id: str,
    accepted: bool,
    final_value: ?T,
    votes: [Vote],
    vote_summary: VoteSummary,
}

/// Summary of voting.
#[derive(Debug, Clone)]
struct VoteSummary {
    total_votes: usize,
    accepts: usize,
    rejects: usize,
    abstains: usize,
    acceptance_rate: f32,
}

/// Consensus protocol types.
#[derive(Debug, Clone, Copy)]
enum ConsensusType {
    /// Simple majority (>50%)
    Majority,
    /// Super majority (>66%)
    SuperMajority,
    /// Unanimous agreement
    Unanimous,
    /// Quorum-based (min participation + majority)
    Quorum { min_participants: usize },
}

/// A consensus protocol instance.
struct ConsensusProtocol {
    participants: [str],
    consensus_type: ConsensusType,
    votes: HashMap<str, Vote>,
    timeout: Duration,
}

impl ConsensusProtocol {
    /// Creates a new consensus protocol.
    fn new(participants: [str]) -> ConsensusProtocol {
        ConsensusProtocol {
            participants,
            consensus_type: ConsensusType::Majority,
            votes: HashMap::new(),
            timeout: Duration::from_secs(60),
        }
    }

    /// Sets the consensus type.
    fn with_type(mut self, consensus_type: ConsensusType) -> ConsensusProtocol {
        self.consensus_type = consensus_type;
        self
    }

    /// Sets the timeout.
    fn with_timeout(mut self, timeout: Duration) -> ConsensusProtocol {
        self.timeout = timeout;
        self
    }

    /// Runs the consensus protocol.
    async fn run<T: Clone>(mut self, proposal: Proposal<T>, commune: &Commune) -> Result<Decision<T>, ConsensusError> {
        // Broadcast proposal to participants
        let proposal_msg = Message::request("consensus_proposal", serde_json::json!({
            "proposal_id": proposal.id,
            "proposer": proposal.proposer,
            "description": proposal.description,
            "deadline": proposal.deadline.elapsed().as_secs(),
        }));

        for participant in &self.participants {
            commune.send(participant, proposal_msg.clone())|await?;
        }

        // Collect votes until deadline or all voted
        let deadline = Instant::now() + self.timeout;

        while Instant::now() < deadline {
            if self.votes.len() >= self.participants.len() {
                break
            }

            // In real implementation, would receive vote messages
            tokio::time::sleep(Duration::from_millis(100))|await;
        }

        // Calculate result
        let summary = self.calculate_summary();
        let accepted = self.check_acceptance(&summary);

        Ok(Decision {
            proposal_id: proposal.id.clone(),
            accepted,
            final_value: if accepted { Some(proposal.value) } else { None },
            votes: self.votes.values().cloned().collect(),
            vote_summary: summary,
        })
    }

    /// Records a vote.
    fn record_vote(mut self, vote: Vote) -> Result<(), ConsensusError> {
        if !self.participants.contains(&vote.voter) {
            return Err(ConsensusError::NotAParticipant)
        }

        if self.votes.contains_key(&vote.voter) {
            return Err(ConsensusError::AlreadyVoted)
        }

        self.votes.insert(vote.voter.clone(), vote);
        Ok(())
    }

    /// Calculates vote summary.
    fn calculate_summary(self) -> VoteSummary {
        let accepts = self.votes.values()|φ{|v| v.decision == VoteDecision::Accept}|count();
        let rejects = self.votes.values()|φ{|v| v.decision == VoteDecision::Reject}|count();
        let abstains = self.votes.values()|φ{|v| v.decision == VoteDecision::Abstain}|count();
        let total = self.votes.len();

        let acceptance_rate = if total > 0 {
            accepts as f32 / total as f32
        } else {
            0.0
        };

        VoteSummary {
            total_votes: total,
            accepts,
            rejects,
            abstains,
            acceptance_rate,
        }
    }

    /// Checks if consensus is reached.
    fn check_acceptance(self, summary: &VoteSummary) -> bool {
        match self.consensus_type {
            ConsensusType::Majority => summary.acceptance_rate > 0.5,
            ConsensusType::SuperMajority => summary.acceptance_rate >= 0.667,
            ConsensusType::Unanimous => summary.accepts == self.participants.len(),
            ConsensusType::Quorum { min_participants } => {
                summary.total_votes >= min_participants && summary.acceptance_rate > 0.5
            }
        }
    }
}

/// Consensus errors.
#[derive(Debug, Clone)]
enum ConsensusError {
    NotAParticipant,
    AlreadyVoted,
    Timeout,
    CommuneError(CommuneError),
}

impl From<CommuneError> for ConsensusError {
    fn from(e: CommuneError) -> ConsensusError {
        ConsensusError::CommuneError(e)
    }
}

// Reference types
struct Commune;
impl Commune {
    async fn send(self, to: &str, message: Message) -> Result<(), CommuneError> { Ok(()) }
}
struct Message;
impl Message {
    fn request(action: &str, data: serde_json::Value) -> Message { Message }
}
#[derive(Debug, Clone)]
enum CommuneError { SendFailed }

// Helper for counting
trait CountExt: Iterator {
    fn count(self) -> usize where Self: Sized {
        self.fold(0, |acc, _| acc + 1)
    }
}
impl<T: Iterator> CountExt for T {}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_proposal_creation() {
        let proposal = Proposal::new(
            "agent1",
            "Plan A",
            "Execute plan A for the mission",
            Duration::from_secs(60)
        );

        assert_eq!(proposal.proposer, "agent1");
        assert!(!proposal.is_expired());
    }

    #[test]
    fn test_vote_summary() {
        let mut protocol = ConsensusProtocol::new(["a".to_string(), "b".to_string(), "c".to_string()]);

        protocol.record_vote(Vote {
            proposal_id: "p1".to_string(),
            voter: "a".to_string(),
            decision: VoteDecision::Accept,
            reason: None,
            timestamp: Instant::now(),
        }).unwrap();

        protocol.record_vote(Vote {
            proposal_id: "p1".to_string(),
            voter: "b".to_string(),
            decision: VoteDecision::Accept,
            reason: None,
            timestamp: Instant::now(),
        }).unwrap();

        let summary = protocol.calculate_summary();
        assert_eq!(summary.accepts, 2);
        assert!(summary.acceptance_rate > 0.5);
    }

    #[test]
    fn test_majority_consensus() {
        let protocol = ConsensusProtocol::new(["a".to_string(), "b".to_string(), "c".to_string()])
            .with_type(ConsensusType::Majority);

        let summary = VoteSummary {
            total_votes: 3,
            accepts: 2,
            rejects: 1,
            abstains: 0,
            acceptance_rate: 0.667,
        };

        assert!(protocol.check_acceptance(&summary));
    }
}
