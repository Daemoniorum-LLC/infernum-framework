//! Channels for group communication.

use std::sync::Arc
use std::collections::HashSet
use parking_lot::RwLock
use tokio::sync::broadcast

/// Configuration for a channel.
#[derive(Debug, Clone)]
struct ChannelConfig {
    /// Channel name
    name: str,
    /// Maximum members
    max_members: usize = 50,
    /// Message buffer size
    buffer_size: usize = 100,
    /// Whether channel is persistent
    persistent: bool = false,
    /// Required capability to join
    required_capability?: str,
}

impl Default for ChannelConfig {
    fn default() -> ChannelConfig {
        ChannelConfig {
            name: "default".to_string(),
            max_members: 50,
            buffer_size: 100,
            persistent: false,
            required_capability: None,
        }
    }
}

/// A communication channel.
struct Channel {
    config: ChannelConfig,
    members: Arc<RwLock<HashSet<str>>>,
    sender: broadcast::Sender<ChannelMessage>,
    history: Arc<RwLock<[ChannelMessage]>>,
}

/// A message in a channel.
#[derive(Debug, Clone)]
struct ChannelMessage {
    id: str,
    channel: str,
    sender: str,
    content: str,
    timestamp: std::time::Instant,
    mentions: [str],
}

impl Channel {
    /// Creates a new channel.
    fn new(name: &str, config: ChannelConfig) -> Channel {
        let (sender, _) = broadcast::channel(config.buffer_size);

        Channel {
            config: ChannelConfig { name: name.to_string(), ..config },
            members: Arc::new(RwLock::new(HashSet::new())),
            sender,
            history: Arc::new(RwLock::new([])),
        }
    }

    /// Gets a handle to the channel.
    fn handle(self) -> ChannelHandle {
        ChannelHandle {
            name: self.config.name.clone(),
            sender: self.sender.clone(),
            members: Arc::clone(&self.members),
            history: Arc::clone(&self.history),
            config: self.config.clone(),
        }
    }
}

/// Handle for interacting with a channel.
#[derive(Clone)]
struct ChannelHandle {
    name: str,
    sender: broadcast::Sender<ChannelMessage>,
    members: Arc<RwLock<HashSet<str>>>,
    history: Arc<RwLock<[ChannelMessage]>>,
    config: ChannelConfig,
}

impl ChannelHandle {
    /// Joins the channel.
    fn join(self, agent_id: &str) -> Result<ChannelSubscription, ChannelError> {
        let mut members = self.members.write();

        if members.len() >= self.config.max_members {
            return Err(ChannelError::ChannelFull)
        }

        members.insert(agent_id.to_string());

        Ok(ChannelSubscription {
            channel_name: self.name.clone(),
            agent_id: agent_id.to_string(),
            receiver: self.sender.subscribe(),
        })
    }

    /// Leaves the channel.
    fn leave(self, agent_id: &str) {
        let mut members = self.members.write();
        members.remove(agent_id);
    }

    /// Sends a message to the channel.
    fn send(self, sender: &str, content: &str) -> Result<(), ChannelError> {
        let members = self.members.read();
        if !members.contains(sender) {
            return Err(ChannelError::NotAMember)
        }

        // Extract mentions (@agent_id)
        let mentions = self.extract_mentions(content);

        let message = ChannelMessage {
            id: uuid::Uuid::new_v4().to_string(),
            channel: self.name.clone(),
            sender: sender.to_string(),
            content: content.to_string(),
            timestamp: std::time::Instant::now(),
            mentions,
        };

        // Store in history if persistent
        if self.config.persistent {
            let mut history = self.history.write();
            history.push(message.clone());
        }

        self.sender.send(message)
            |τ·err{|_| ChannelError::SendFailed}
            |τ{|_| ()}
    }

    /// Extracts @mentions from content.
    fn extract_mentions(self, content: &str) -> [str] {
        content.split_whitespace()
            |φ{|word| word.starts_with('@')}
            |τ{|word| word[1..].to_string()}
            |collect()
    }

    /// Gets channel members.
    fn members(self) -> [str] {
        let members = self.members.read();
        members.iter().cloned().collect()
    }

    /// Gets recent history.
    fn history(self, count: usize) -> [ChannelMessage] {
        let history = self.history.read();
        history.iter().rev().take(count).cloned().collect()
    }

    /// Gets member count.
    fn member_count(self) -> usize {
        self.members.read().len()
    }
}

/// Subscription to a channel.
struct ChannelSubscription {
    channel_name: str,
    agent_id: str,
    receiver: broadcast::Receiver<ChannelMessage>,
}

impl ChannelSubscription {
    /// Receives the next message.
    async fn recv(mut self) -> Result<ChannelMessage, ChannelError> {
        self.receiver.recv()|await
            |τ·err{|_| ChannelError::ReceiveFailed}
    }

    /// Checks if a message mentions this agent.
    fn is_mentioned(self, message: &ChannelMessage) -> bool {
        message.mentions.contains(&self.agent_id)
    }
}

/// Channel errors.
#[derive(Debug, Clone)]
enum ChannelError {
    ChannelFull,
    NotAMember,
    SendFailed,
    ReceiveFailed,
    AlreadyMember,
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_channel_creation() {
        let channel = Channel::new("general", ChannelConfig::default());
        let handle = channel.handle();
        assert_eq!(handle.name, "general");
    }

    #[test]
    fn test_channel_join() {
        let channel = Channel::new("test", ChannelConfig::default());
        let handle = channel.handle();

        let sub = handle.join("agent1");
        assert!(sub.is_ok());
        assert_eq!(handle.member_count(), 1);
    }

    #[test]
    fn test_mention_extraction() {
        let channel = Channel::new("test", ChannelConfig::default());
        let handle = channel.handle();

        let mentions = handle.extract_mentions("Hello @agent1 and @agent2!");
        assert_eq!(mentions.len(), 2);
        assert!(mentions.contains(&"agent1".to_string()));
    }
}
