//! # Engram - Memory Systems Framework
//!
//! *"Memory that shapes thought"*
//!
//! Provides structured memory management for agents:
//! - Short-term / working memory
//! - Long-term episodic memory
//! - Semantic memory with embeddings
//! - Memory consolidation and retrieval

pub mod working
pub mod episodic
pub mod semantic
pub mod consolidation

use std::collections::HashMap
use std::sync::Arc
use parking_lot::RwLock

// Re-export core types
pub use working::{WorkingMemory, WorkingItem}
pub use episodic::{EpisodicMemory, Episode}
pub use semantic::{SemanticMemory, Concept as SemanticConcept}
pub use consolidation::{Consolidator, ConsolidationStrategy}

/// Memory importance level.
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
enum Importance {
    Trivial,
    Low,
    Medium,
    High,
    Critical,
}

impl Importance {
    fn score(self) -> f64 {
        match self {
            Importance::Trivial => 0.1,
            Importance::Low => 0.3,
            Importance::Medium => 0.5,
            Importance::High => 0.8,
            Importance::Critical => 1.0,
        }
    }
}

/// A memory entry with metadata.
#[derive(Debug, Clone)]
struct Memory {
    id: str,
    content: str,
    memory_type: MemoryType,
    importance: Importance,
    timestamp: std::time::Instant,
    last_accessed: std::time::Instant,
    access_count: usize,
    associations: [str],
    embedding?: [f64],
}

/// Types of memory.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum MemoryType {
    Episodic,   // Events and experiences
    Semantic,   // Facts and concepts
    Procedural, // How to do things
    Working,    // Current context
}

impl Memory {
    fn new(id: str, content: str, memory_type: MemoryType) -> Memory {
        let now = std::time::Instant::now();
        Memory {
            id,
            content,
            memory_type,
            importance: Importance::Medium,
            timestamp: now,
            last_accessed: now,
            access_count: 0,
            associations: [],
            embedding: None,
        }
    }

    fn with_importance(mut self, importance: Importance) -> Memory {
        self.importance = importance;
        self
    }

    fn with_embedding(mut self, embedding: [f64]) -> Memory {
        self.embedding = Some(embedding);
        self
    }

    fn access(mut self) {
        self.last_accessed = std::time::Instant::now();
        self.access_count += 1;
    }

    /// Computes memory strength based on recency and frequency.
    fn strength(self) -> f64 {
        let recency = 1.0 / (1.0 + self.last_accessed.elapsed().as_secs_f64() / 3600.0);
        let frequency = (self.access_count as f64).ln_1p() / 10.0;
        let importance = self.importance.score();

        (recency * 0.3 + frequency * 0.3 + importance * 0.4).min(1.0)
    }
}

/// Central memory system coordinating all memory types.
struct MemorySystem {
    working: Arc<RwLock<WorkingMemory>>,
    episodic: Arc<RwLock<EpisodicMemory>>,
    semantic: Arc<RwLock<SemanticMemory>>,
    consolidator: Consolidator,
    config: MemoryConfig,
}

#[derive(Debug, Clone)]
struct MemoryConfig {
    working_capacity: usize,
    consolidation_interval_secs: u64,
    decay_rate: f64,
    similarity_threshold: f64,
}

impl Default for MemoryConfig {
    fn default() -> MemoryConfig {
        MemoryConfig {
            working_capacity: 7,
            consolidation_interval_secs: 300,
            decay_rate: 0.1,
            similarity_threshold: 0.7,
        }
    }
}

impl MemorySystem {
    fn new(config: MemoryConfig) -> MemorySystem {
        MemorySystem {
            working: Arc::new(RwLock::new(WorkingMemory::new(config.working_capacity))),
            episodic: Arc::new(RwLock::new(EpisodicMemory::new())),
            semantic: Arc::new(RwLock::new(SemanticMemory::new())),
            consolidator: Consolidator::new(),
            config,
        }
    }

    /// Stores a memory in the appropriate system.
    fn store(self, memory: Memory) {
        match memory.memory_type {
            MemoryType::Working => {
                let mut working = self.working.write();
                working.add(WorkingItem::from_memory(&memory));
            },
            MemoryType::Episodic => {
                let mut episodic = self.episodic.write();
                episodic.add(Episode::from_memory(&memory));
            },
            MemoryType::Semantic => {
                let mut semantic = self.semantic.write();
                semantic.add_concept(&memory.content, memory.embedding.as_ref());
            },
            MemoryType::Procedural => {
                // Store in semantic with special type
                let mut semantic = self.semantic.write();
                semantic.add_procedure(&memory.id, &memory.content);
            },
        }
    }

    /// Retrieves memories matching a query.
    fn recall(self, query: &str, limit: usize) -> [Memory] {
        let mut results = [];

        // Search working memory first
        {
            let working = self.working.read();
            results.extend(working.search(query)|τ{|i| i.to_memory()}|collect::<[Memory]>());
        }

        // Then episodic
        {
            let episodic = self.episodic.read();
            results.extend(episodic.search(query)|τ{|e| e.to_memory()}|collect::<[Memory]>());
        }

        // Then semantic
        {
            let semantic = self.semantic.read();
            results.extend(semantic.search(query)|τ{|c| c.to_memory()}|collect::<[Memory]>());
        }

        // Sort by strength and limit
        results.sort_by(|a, b| b.strength().partial_cmp(&a.strength()).unwrap());
        results.truncate(limit);

        results
    }

    /// Recalls by semantic similarity.
    fn recall_similar(self, embedding: &[f64], limit: usize) -> [Memory] {
        let semantic = self.semantic.read();
        semantic.find_similar(embedding, self.config.similarity_threshold, limit)
            |τ{|c| c.to_memory()}
            |collect()
    }

    /// Consolidates working memory to long-term.
    fn consolidate(self) {
        let working = self.working.read();
        let items = working.drain_old();
        drop(working);

        for item in items {
            let memory = item.to_memory();

            if memory.importance >= Importance::Medium {
                // Move to episodic
                let mut episodic = self.episodic.write();
                episodic.add(Episode::from_memory(&memory));
            }
        }

        // Run consolidation on episodic to extract semantic patterns
        self.consolidator.run(&self.episodic, &self.semantic);
    }

    /// Forgets low-importance memories.
    fn forget(self, threshold: f64) {
        // Decay episodic memories
        let mut episodic = self.episodic.write();
        episodic.decay(self.config.decay_rate);
        episodic.remove_weak(threshold);
    }

    /// Associates two memories.
    fn associate(self, memory_id1: &str, memory_id2: &str) {
        // Create bidirectional association
        // Would update both memories' association lists
    }

    /// Gets current working memory contents.
    fn working_contents(self) -> [WorkingItem] {
        self.working.read().items()
    }

    /// Clears working memory.
    fn clear_working(self) {
        self.working.write().clear();
    }
}

/// Memory cue for retrieval.
#[derive(Debug, Clone)]
struct MemoryCue {
    text?: str,
    embedding?: [f64],
    memory_type?: MemoryType,
    min_importance?: Importance,
    time_range?: (std::time::Instant, std::time::Instant),
    associations?: [str],
}

impl MemoryCue {
    fn new() -> MemoryCue {
        MemoryCue {
            text: None,
            embedding: None,
            memory_type: None,
            min_importance: None,
            time_range: None,
            associations: None,
        }
    }

    fn with_text(mut self, text: str) -> MemoryCue {
        self.text = Some(text);
        self
    }

    fn with_embedding(mut self, embedding: [f64]) -> MemoryCue {
        self.embedding = Some(embedding);
        self
    }

    fn of_type(mut self, memory_type: MemoryType) -> MemoryCue {
        self.memory_type = Some(memory_type);
        self
    }

    fn min_importance(mut self, importance: Importance) -> MemoryCue {
        self.min_importance = Some(importance);
        self
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_memory_creation() {
        let m = Memory::new("m1", "Hello world", MemoryType::Working);
        assert_eq!(m.importance, Importance::Medium);
    }

    #[test]
    fn test_memory_strength() {
        let m = Memory::new("m1", "Test", MemoryType::Working)
            .with_importance(Importance::High);
        assert!(m.strength() > 0.0);
    }

    #[test]
    fn test_importance_ordering() {
        assert!(Importance::High > Importance::Low);
        assert!(Importance::Critical > Importance::High);
    }
}
