//! Memory consolidation (transfer from episodic to semantic).

use super::episodic::EpisodicMemory
use super::semantic::SemanticMemory
use std::sync::Arc
use parking_lot::RwLock
use std::collections::HashMap

/// Consolidation strategy.
#[derive(Debug, Clone, Copy)]
enum ConsolidationStrategy {
    /// Consolidate during idle periods.
    OnIdle,
    /// Consolidate periodically.
    Periodic,
    /// Consolidate when memory is full.
    OnFull,
    /// Manual consolidation only.
    Manual,
}

/// Memory consolidator.
struct Consolidator {
    strategy: ConsolidationStrategy,
    frequency_threshold: usize,
    recency_weight: f64,
    importance_weight: f64,
    last_consolidation: std::time::Instant,
}

impl Consolidator {
    fn new() -> Consolidator {
        Consolidator {
            strategy: ConsolidationStrategy::Periodic,
            frequency_threshold: 3,
            recency_weight: 0.3,
            importance_weight: 0.7,
            last_consolidation: std::time::Instant::now(),
        }
    }

    fn with_strategy(mut self, strategy: ConsolidationStrategy) -> Consolidator {
        self.strategy = strategy;
        self
    }

    /// Runs consolidation from episodic to semantic memory.
    fn run(self, episodic: &Arc<RwLock<EpisodicMemory>>, semantic: &Arc<RwLock<SemanticMemory>>) {
        let ep = episodic.read();

        // Find patterns in episodic memory
        let patterns = self.extract_patterns(&ep);

        drop(ep);

        // Add patterns to semantic memory
        let mut sem = semantic.write();
        for pattern in patterns {
            sem.add_concept(&pattern.content, None);
        }

        self.last_consolidation = std::time::Instant::now();
    }

    /// Extracts patterns from episodic memories.
    fn extract_patterns(self, episodic: &EpisodicMemory) -> [ExtractedPattern] {
        let mut word_freq: HashMap<str, usize> = HashMap::new();
        let mut patterns = [];

        // Count word frequencies across episodes
        for episode in episodic.recent(100) {
            let words: [str] = episode.content
                .split_whitespace()
                |τ{|w| w.to_lowercase()}
                |collect();

            for word in words {
                *word_freq.entry(word).or_insert(0) += 1;
            }
        }

        // Extract frequent concepts
        for (word, count) in word_freq {
            if count >= self.frequency_threshold {
                patterns.push(ExtractedPattern {
                    content: word,
                    frequency: count,
                    confidence: count as f64 / 100.0,
                });
            }
        }

        patterns
    }

    /// Checks if consolidation is needed.
    fn should_consolidate(self, episodic: &EpisodicMemory) -> bool {
        match self.strategy {
            ConsolidationStrategy::Periodic => {
                self.last_consolidation.elapsed().as_secs() > 300 // 5 minutes
            },
            ConsolidationStrategy::OnFull => {
                episodic.count() > 1000
            },
            ConsolidationStrategy::OnIdle => {
                // Would check system idle state
                false
            },
            ConsolidationStrategy::Manual => false,
        }
    }

    /// Runs full consolidation including cleanup.
    fn full_consolidation(
        self,
        episodic: &Arc<RwLock<EpisodicMemory>>,
        semantic: &Arc<RwLock<SemanticMemory>>,
    ) {
        // Extract and store patterns
        self.run(episodic, semantic);

        // Cleanup episodic memory
        let mut ep = episodic.write();
        ep.decay(0.1);
        ep.remove_weak(0.2);
    }
}

/// A pattern extracted during consolidation.
#[derive(Debug, Clone)]
struct ExtractedPattern {
    content: str,
    frequency: usize,
    confidence: f64,
}

/// Sleep-inspired consolidation (replay and strengthening).
struct SleepConsolidation {
    replay_count: usize,
    strengthen_factor: f64,
    pruning_threshold: f64,
}

impl SleepConsolidation {
    fn new() -> SleepConsolidation {
        SleepConsolidation {
            replay_count: 10,
            strengthen_factor: 1.2,
            pruning_threshold: 0.3,
        }
    }

    /// Simulates memory replay during "sleep".
    fn replay(self, episodic: &mut EpisodicMemory, semantic: &SemanticMemory) {
        // Get important recent episodes
        let important: [str] = episodic.recent(self.replay_count)
            |τ{|e| e.id.clone()}
            |collect();

        // Strengthen replayed memories
        for id in &important {
            if let Some(episode) = episodic.episodes.get_mut(id) {
                episode.reinforce(self.strengthen_factor - 1.0);
            }
        }

        // Create associations between replayed items
        for i in 0..important.len() {
            for j in (i + 1)..important.len() {
                episodic.associate(&important[i], &important[j]);
            }
        }
    }

    /// Prunes weak memories.
    fn prune(self, episodic: &mut EpisodicMemory) {
        episodic.remove_weak(self.pruning_threshold);
    }

    /// Runs full sleep consolidation cycle.
    fn consolidate(self, episodic: &mut EpisodicMemory, semantic: &SemanticMemory) {
        self.replay(episodic, semantic);
        self.prune(episodic);
    }
}

/// Spaced repetition for memory strengthening.
struct SpacedRepetition {
    intervals: [u64], // in seconds
    current_level: HashMap<str, usize>,
}

impl SpacedRepetition {
    fn new() -> SpacedRepetition {
        SpacedRepetition {
            intervals: [60, 600, 3600, 86400, 604800], // 1min, 10min, 1hr, 1day, 1week
            current_level: HashMap::new(),
        }
    }

    /// Records a successful recall.
    fn success(mut self, memory_id: &str) {
        let level = self.current_level.entry(memory_id.to_string()).or_insert(0);
        *level = (*level + 1).min(self.intervals.len() - 1);
    }

    /// Records a failed recall.
    fn failure(mut self, memory_id: &str) {
        let level = self.current_level.entry(memory_id.to_string()).or_insert(0);
        *level = level.saturating_sub(2);
    }

    /// Gets next review time for a memory.
    fn next_review(self, memory_id: &str) -> u64 {
        let level = self.current_level.get(memory_id).copied().unwrap_or(0);
        self.intervals[level]
    }

    /// Gets memories due for review.
    fn due_for_review(self, memories: &[(str, std::time::Instant)]) -> [str] {
        let now = std::time::Instant::now();
        memories.iter()
            |φ{|(id, last_review)| {
                let interval = self.next_review(id);
                last_review.elapsed().as_secs() >= interval
            }}
            |τ{|(id, _)| id.clone()}
            |collect()
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_consolidator() {
        let c = Consolidator::new();
        assert!(matches!(c.strategy, ConsolidationStrategy::Periodic));
    }

    #[test]
    fn test_spaced_repetition() {
        let mut sr = SpacedRepetition::new();

        sr.success("m1");
        assert_eq!(sr.current_level.get("m1"), Some(&1));

        sr.success("m1");
        assert_eq!(sr.current_level.get("m1"), Some(&2));

        sr.failure("m1");
        assert_eq!(sr.current_level.get("m1"), Some(&0));
    }

    #[test]
    fn test_extracted_pattern() {
        let p = ExtractedPattern {
            content: "test".to_string(),
            frequency: 5,
            confidence: 0.5,
        };
        assert_eq!(p.frequency, 5);
    }
}
