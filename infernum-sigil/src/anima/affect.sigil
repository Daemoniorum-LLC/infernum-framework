//! Affective (emotional) state modeling.

use std::time::Instant

/// Primary emotions.
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
enum Emotion {
    // Positive
    Joy,
    Interest,
    Serenity,
    Satisfaction,
    Gratitude,
    Pride,
    Hope,

    // Negative
    Sadness,
    Fear,
    Anger,
    Disgust,
    Disappointment,
    Frustration,
    Anxiety,

    // Neutral/Mixed
    Surprise,
    Anticipation,
    Curiosity,
    Confusion,
}

impl Emotion {
    /// Gets the valence (positive/negative) of an emotion.
    fn valence(self) -> Valence {
        match self {
            Emotion::Joy | Emotion::Interest | Emotion::Serenity |
            Emotion::Satisfaction | Emotion::Gratitude | Emotion::Pride |
            Emotion::Hope => Valence::Positive,

            Emotion::Sadness | Emotion::Fear | Emotion::Anger |
            Emotion::Disgust | Emotion::Disappointment | Emotion::Frustration |
            Emotion::Anxiety => Valence::Negative,

            Emotion::Surprise | Emotion::Anticipation | Emotion::Curiosity |
            Emotion::Confusion => Valence::Neutral,
        }
    }

    /// Gets typical arousal level.
    fn base_arousal(self) -> f32 {
        match self {
            Emotion::Joy | Emotion::Fear | Emotion::Anger |
            Emotion::Surprise | Emotion::Anxiety => 0.8,

            Emotion::Interest | Emotion::Anticipation | Emotion::Curiosity |
            Emotion::Frustration => 0.6,

            Emotion::Sadness | Emotion::Satisfaction | Emotion::Hope |
            Emotion::Disappointment | Emotion::Confusion => 0.4,

            Emotion::Serenity | Emotion::Gratitude | Emotion::Pride |
            Emotion::Disgust => 0.3,
        }
    }
}

/// Valence - positive, negative, or neutral.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum Valence {
    Positive,
    Negative,
    Neutral,
}

/// Arousal level - how activated/energized.
#[derive(Debug, Clone, Copy)]
struct Arousal(f32); // 0.0 (calm) to 1.0 (excited)

/// Mood - longer-term affective state.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum Mood {
    Elated,
    Content,
    Calm,
    Neutral,
    Melancholic,
    Anxious,
    Irritable,
}

impl Mood {
    fn valence(self) -> Valence {
        match self {
            Mood::Elated | Mood::Content => Valence::Positive,
            Mood::Calm | Mood::Neutral => Valence::Neutral,
            Mood::Melancholic | Mood::Anxious | Mood::Irritable => Valence::Negative,
        }
    }
}

/// An active emotion with intensity.
#[derive(Debug, Clone)]
struct ActiveEmotion {
    emotion: Emotion,
    intensity: f32, // 0.0 to 1.0
    onset: Instant,
    decay_rate: f32, // How fast it fades
}

impl ActiveEmotion {
    fn current_intensity(self) -> f32 {
        let elapsed = self.onset.elapsed().as_secs_f32();
        (self.intensity - elapsed * self.decay_rate).max(0.0)
    }

    fn is_active(self) -> bool {
        self.current_intensity() > 0.1
    }
}

/// The complete affective state.
#[derive(Debug, Clone)]
struct AffectState {
    mood: Mood,
    active_emotions: [ActiveEmotion],
    arousal: f32,
    valence_bias: f32, // -1.0 to 1.0, persistent tendency
    history: [EmotionEvent],
}

/// Record of an emotional event.
#[derive(Debug, Clone)]
struct EmotionEvent {
    emotion: Emotion,
    intensity: f32,
    trigger?: str,
    timestamp: Instant,
}

impl AffectState {
    /// Creates a neutral affective state.
    fn neutral() -> AffectState {
        AffectState {
            mood: Mood::Neutral,
            active_emotions: [],
            arousal: 0.5,
            valence_bias: 0.0,
            history: [],
        }
    }

    /// Creates a positive affective state.
    fn positive() -> AffectState {
        AffectState {
            mood: Mood::Content,
            active_emotions: [],
            arousal: 0.5,
            valence_bias: 0.3,
            history: [],
        }
    }

    /// Gets the dominant (strongest) current emotion.
    fn dominant_emotion(self) -> ?Emotion {
        self.active_emotions
            |φ{|e| e.is_active()}
            |ρ·max_by{|a, b| a.current_intensity().partial_cmp(&b.current_intensity()).unwrap()}
            |τ{|e| e.emotion}
    }

    /// Gets current overall valence.
    fn current_valence(self) -> f32 {
        let emotion_valence = self.active_emotions
            |φ{|e| e.is_active()}
            |τ{|e| {
                let sign = match e.emotion.valence() {
                    Valence::Positive => 1.0,
                    Valence::Negative => -1.0,
                    Valence::Neutral => 0.0,
                };
                sign * e.current_intensity()
            }}
            |Σ;

        let mood_valence = match self.mood.valence() {
            Valence::Positive => 0.3,
            Valence::Negative => -0.3,
            Valence::Neutral => 0.0,
        };

        (emotion_valence + mood_valence + self.valence_bias).clamp(-1.0, 1.0)
    }

    /// Applies an emotion to the state.
    fn apply_emotion(mut self, emotion: Emotion, intensity: f32) {
        // Record in history
        self.history.push(EmotionEvent {
            emotion,
            intensity,
            trigger: None,
            timestamp: Instant::now(),
        });

        // Update arousal
        self.arousal = (self.arousal * 0.7 + emotion.base_arousal() * intensity * 0.3).clamp(0.0, 1.0);

        // Add or update active emotion
        let existing = self.active_emotions.iter_mut()
            |φ·α{|e| e.emotion == emotion};

        if let Some(existing_emotion) = existing {
            // Blend with existing
            existing_emotion.intensity = (existing_emotion.intensity + intensity) / 2.0;
            existing_emotion.onset = Instant::now();
        } else {
            self.active_emotions.push(ActiveEmotion {
                emotion,
                intensity: intensity.clamp(0.0, 1.0),
                onset: Instant::now(),
                decay_rate: 0.1, // Decay over ~10 seconds
            });
        }

        // Update mood if emotion is strong and persistent
        if intensity > 0.7 {
            self.update_mood(emotion);
        }

        // Clean up inactive emotions
        self.active_emotions.retain(|e| e.is_active());
    }

    /// Updates mood based on emotion.
    fn update_mood(mut self, emotion: Emotion) {
        self.mood = match emotion.valence() {
            Valence::Positive => {
                if self.arousal > 0.7 { Mood::Elated }
                else if self.arousal > 0.4 { Mood::Content }
                else { Mood::Calm }
            },
            Valence::Negative => {
                if emotion == Emotion::Anxiety { Mood::Anxious }
                else if emotion == Emotion::Anger || emotion == Emotion::Frustration { Mood::Irritable }
                else { Mood::Melancholic }
            },
            Valence::Neutral => Mood::Neutral,
        };
    }

    /// Checks alignment with a goal.
    fn alignment_with_goal(self, goal: &Goal) -> f32 {
        // Positive mood and low anxiety help with goal pursuit
        let mood_factor = match self.mood.valence() {
            Valence::Positive => 0.8,
            Valence::Neutral => 0.5,
            Valence::Negative => 0.2,
        };

        let arousal_factor = if goal.requires_focus {
            // Moderate arousal is best for focus
            1.0 - (self.arousal - 0.5).abs() * 2.0
        } else {
            0.5
        };

        (mood_factor + arousal_factor) / 2.0
    }

    /// Describes current state in natural language.
    fn describe(self) -> str {
        let dominant = self.dominant_emotion();
        let mood_desc = format!("{:?}", self.mood).to_lowercase();

        match dominant {
            Some(emotion) => format!(
                "Feeling {:?} (intensity: {:.1}) with {} mood and arousal at {:.1}",
                emotion,
                self.active_emotions|φ·α{|e| e.emotion == emotion}|τ{|e| e.current_intensity()} ?? 0.0,
                mood_desc,
                self.arousal
            ),
            None => format!(
                "In a {} mood with arousal at {:.1}",
                mood_desc,
                self.arousal
            ),
        }
    }
}

/// Goal reference for alignment checking.
#[derive(Debug, Clone)]
struct Goal {
    requires_focus: bool,
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_neutral_state() {
        let state = AffectState::neutral();
        assert_eq!(state.mood, Mood::Neutral);
        assert!(state.dominant_emotion().is_none());
    }

    #[test]
    fn test_apply_emotion() {
        let mut state = AffectState::neutral();
        state.apply_emotion(Emotion::Joy, 0.8);

        assert_eq!(state.dominant_emotion(), Some(Emotion::Joy));
        assert!(state.current_valence() > 0.0);
    }

    #[test]
    fn test_emotion_valence() {
        assert_eq!(Emotion::Joy.valence(), Valence::Positive);
        assert_eq!(Emotion::Sadness.valence(), Valence::Negative);
        assert_eq!(Emotion::Surprise.valence(), Valence::Neutral);
    }
}
