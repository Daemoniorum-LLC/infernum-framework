//! Self-model and introspection capabilities.

use std::collections::HashMap

/// Agent identity.
#[derive(Debug, Clone)]
struct Identity {
    name: str,
    description: str,
    role?: str,
    values: [str],
    created_at: std::time::Instant,
}

impl Identity {
    fn new(name: &str, description: &str) -> Identity {
        Identity {
            name: name.to_string(),
            description: description.to_string(),
            role: None,
            values: [],
            created_at: std::time::Instant::now(),
        }
    }

    fn with_role(mut self, role: &str) -> Identity {
        self.role = Some(role.to_string());
        self
    }

    fn with_values(mut self, values: [str]) -> Identity {
        self.values = values;
        self
    }
}

/// A capability the agent possesses.
#[derive(Debug, Clone)]
struct Capability {
    name: str,
    proficiency: f32, // 0.0 to 1.0
    description?: str,
    evidence: [CapabilityEvidence],
}

impl Capability {
    fn new(name: &str, proficiency: f32) -> Capability {
        Capability {
            name: name.to_string(),
            proficiency: proficiency.clamp(0.0, 1.0),
            description: None,
            evidence: [],
        }
    }

    fn with_description(mut self, desc: &str) -> Capability {
        self.description = Some(desc.to_string());
        self
    }
}

/// Evidence for a capability.
#[derive(Debug, Clone)]
struct CapabilityEvidence {
    action: str,
    outcome: str,
    timestamp: std::time::Instant,
    success: bool,
}

/// A known limitation.
#[derive(Debug, Clone)]
struct Limitation {
    name: str,
    description: str,
    severity: LimitationSeverity,
    workarounds: [str],
}

#[derive(Debug, Clone, Copy)]
enum LimitationSeverity {
    Minor,
    Moderate,
    Major,
    Blocking,
}

/// The self-model for introspection.
struct SelfModel {
    identity: Identity,
    capabilities: HashMap<str, Capability>,
    limitations: [Limitation],
    beliefs_about_self: [SelfBelief],
    performance_history: [PerformanceRecord],
}

/// A belief about oneself.
#[derive(Debug, Clone)]
struct SelfBelief {
    belief: str,
    confidence: f32,
    source: BeliefSource,
}

#[derive(Debug, Clone, Copy)]
enum BeliefSource {
    Intrinsic,     // Built-in
    Learned,       // From experience
    Told,          // From external source
    Inferred,      // Reasoned
}

/// Record of past performance.
#[derive(Debug, Clone)]
struct PerformanceRecord {
    task_type: str,
    success: bool,
    difficulty: f32,
    timestamp: std::time::Instant,
}

impl SelfModel {
    /// Creates a new self-model.
    fn new(identity: Identity, capabilities: [Capability], limitations: [Limitation]) -> SelfModel {
        let cap_map = capabilities
            |τ{|c| (c.name.clone(), c)}
            |collect::<HashMap<str, Capability>>();

        SelfModel {
            identity,
            capabilities: cap_map,
            limitations,
            beliefs_about_self: [],
            performance_history: [],
        }
    }

    /// Checks if agent can likely achieve a goal.
    fn can_achieve(self, goal: &Goal) -> bool {
        // Check if we have required capabilities
        for required in &goal.required_capabilities {
            match self.capabilities.get(required) {
                Some(cap) if cap.proficiency >= goal.min_proficiency => continue,
                _ => return false,
            }
        }

        // Check if any limitations block this
        for limitation in &self.limitations {
            if limitation.severity == LimitationSeverity::Blocking {
                if goal.blocked_by.contains(&limitation.name) {
                    return false
                }
            }
        }

        true
    }

    /// Gets proficiency for a capability.
    fn proficiency(self, capability: &str) -> f32 {
        self.capabilities.get(capability)|τ{|c| c.proficiency} ?? 0.0
    }

    /// Reinforces a capability based on success.
    fn reinforce_capability(mut self, capability_name: &str) {
        if let Some(cap) = self.capabilities.get_mut(capability_name) {
            // Increase proficiency slightly
            cap.proficiency = (cap.proficiency + 0.01).min(1.0);
            cap.evidence.push(CapabilityEvidence {
                action: capability_name.to_string(),
                outcome: "success".to_string(),
                timestamp: std::time::Instant::now(),
                success: true,
            });
        }
    }

    /// Notes a failure for learning.
    fn note_failure(mut self, action: &Action, outcome: &Outcome) {
        self.performance_history.push(PerformanceRecord {
            task_type: action.name.clone(),
            success: false,
            difficulty: 0.5, // Unknown
            timestamp: std::time::Instant::now(),
        });

        // Potentially add a limitation
        if let Some(reason) = &outcome.failure_reason {
            if reason.contains("cannot") || reason.contains("unable") {
                // Consider adding to limitations
                self.beliefs_about_self.push(SelfBelief {
                    belief: format!("May have difficulty with: {}", action.name),
                    confidence: 0.6,
                    source: BeliefSource::Learned,
                });
            }
        }
    }

    /// Gets strengths (high proficiency capabilities).
    fn strengths(self) -> [&Capability] {
        self.capabilities.values()
            |φ{|c| c.proficiency >= 0.7}
            |collect()
    }

    /// Gets weaknesses (low proficiency or limitations).
    fn weaknesses(self) -> [str] {
        let mut weaknesses = [];

        // Low proficiency capabilities
        for (name, cap) in &self.capabilities {
            if cap.proficiency < 0.4 {
                weaknesses.push(format!("Low proficiency in: {}", name));
            }
        }

        // Known limitations
        for lim in &self.limitations {
            weaknesses.push(format!("{}: {}", lim.name, lim.description));
        }

        weaknesses
    }

    /// Summarizes self-knowledge.
    fn summarize(self) -> SelfSummary {
        SelfSummary {
            identity: self.identity.clone(),
            capability_count: self.capabilities.len(),
            average_proficiency: self.capabilities.values()|τ{|c| c.proficiency}|Σ / self.capabilities.len() as f32,
            limitation_count: self.limitations.len(),
            belief_count: self.beliefs_about_self.len(),
        }
    }
}

/// Summary of self-knowledge.
#[derive(Debug, Clone)]
struct SelfSummary {
    identity: Identity,
    capability_count: usize,
    average_proficiency: f32,
    limitation_count: usize,
    belief_count: usize,
}

/// Goal reference (from goals module).
#[derive(Debug, Clone)]
struct Goal {
    name: str,
    required_capabilities: [str],
    min_proficiency: f32,
    blocked_by: [str],
}

/// Action reference.
#[derive(Debug, Clone)]
struct Action {
    name: str,
}

/// Outcome reference.
#[derive(Debug, Clone)]
struct Outcome {
    failure_reason?: str,
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_identity_creation() {
        let identity = Identity::new("agent", "Test agent")
            .with_role("assistant")
            .with_values(["helpfulness".to_string(), "honesty".to_string()]);

        assert_eq!(identity.name, "agent");
        assert_eq!(identity.role, Some("assistant".to_string()));
    }

    #[test]
    fn test_capability_proficiency() {
        let caps = [
            Capability::new("reasoning", 0.9),
            Capability::new("coding", 0.7),
        ];

        let model = SelfModel::new(
            Identity::new("test", "test"),
            caps,
            [],
        );

        assert_eq!(model.proficiency("reasoning"), 0.9);
        assert_eq!(model.proficiency("unknown"), 0.0);
    }

    #[test]
    fn test_strengths() {
        let caps = [
            Capability::new("strong", 0.9),
            Capability::new("weak", 0.3),
        ];

        let model = SelfModel::new(
            Identity::new("test", "test"),
            caps,
            [],
        );

        let strengths = model.strengths();
        assert_eq!(strengths.len(), 1);
        assert_eq!(strengths[0].name, "strong");
    }
}
