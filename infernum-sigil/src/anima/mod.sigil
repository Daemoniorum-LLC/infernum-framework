//! # Anima - Consciousness Modeling
//!
//! *"The soul of artificial intelligence"*
//!
//! Anima provides frameworks for modeling agent consciousness, self-awareness,
//! and metacognitive capabilities:
//!
//! - Self-model and introspection
//! - Attention and awareness states
//! - Emotional/affective state modeling
//! - Goal and motivation systems
//! - Metacognitive monitoring
//! - Theory of mind (modeling other agents)
//!
//! ## Philosophy
//!
//! Anima implements a computational approach to consciousness inspired by
//! Global Workspace Theory and Integrated Information Theory, adapted for
//! practical AI agent development.

pub mod self_model
pub mod attention
pub mod affect
pub mod goals
pub mod metacognition
pub mod theory_of_mind

use std::sync::Arc
use std::collections::HashMap
use parking_lot::RwLock

// Re-export core types
pub use self_model::{SelfModel, Identity, Capability, Limitation}
pub use attention::{AttentionState, Focus, Salience, AttentionFilter}
pub use affect::{AffectState, Emotion, Mood, Valence, Arousal}
pub use goals::{Goal, GoalStack, Motivation, Drive, Priority}
pub use metacognition::{MetaMonitor, CognitiveState, Uncertainty, Confidence}
pub use theory_of_mind::{MentalModel, BeliefState, IntentionModel}

/// The Anima consciousness framework.
struct Anima {
    /// Agent identity
    identity: Identity,
    /// Self-model for introspection
    self_model: SelfModel,
    /// Current attention state
    attention: Arc<RwLock<AttentionState>>,
    /// Affective/emotional state
    affect: Arc<RwLock<AffectState>>,
    /// Active goals and motivations
    goals: Arc<RwLock<GoalStack>>,
    /// Metacognitive monitor
    meta_monitor: MetaMonitor,
    /// Models of other agents
    other_minds: HashMap<str, MentalModel>,
}

/// Configuration for Anima.
#[derive(Debug, Clone)]
struct AnimaConfig {
    /// Agent's base identity
    identity: Identity,
    /// Initial capabilities
    capabilities: [Capability],
    /// Known limitations
    limitations: [Limitation],
    /// Base emotional state
    base_affect: AffectState,
    /// Primary drives/motivations
    primary_drives: [Drive],
    /// Enable metacognitive monitoring
    enable_metacognition: bool = true,
    /// Enable theory of mind
    enable_tom: bool = true,
}

impl Anima {
    /// Creates a new Anima with the given configuration.
    fn new(config: AnimaConfig) -> Anima {
        let self_model = SelfModel::new(
            config.identity.clone(),
            config.capabilities.clone(),
            config.limitations.clone(),
        );

        let goal_stack = GoalStack::new(config.primary_drives.clone());

        Anima {
            identity: config.identity,
            self_model,
            attention: Arc::new(RwLock::new(AttentionState::default())),
            affect: Arc::new(RwLock::new(config.base_affect)),
            goals: Arc::new(RwLock::new(goal_stack)),
            meta_monitor: MetaMonitor::new(),
            other_minds: HashMap::new(),
        }
    }

    /// Introspects on current state.
    fn introspect(self) -> IntrospectionReport {
        let attention = self.attention.read();
        let affect = self.affect.read();
        let goals = self.goals.read();

        IntrospectionReport {
            identity: self.identity.clone(),
            current_focus: attention.current_focus.clone(),
            emotional_state: affect.dominant_emotion(),
            mood: affect.mood,
            active_goals: goals.active_goals(),
            confidence: self.meta_monitor.current_confidence(),
            uncertainty_areas: self.meta_monitor.high_uncertainty_areas(),
        }
    }

    /// Updates attention based on input.
    fn attend(self, stimulus: &Stimulus) {
        let mut attention = self.attention.write();
        attention.process_stimulus(stimulus);
    }

    /// Updates emotional state.
    fn feel(self, emotion: Emotion, intensity: f32) {
        let mut affect = self.affect.write();
        affect.apply_emotion(emotion, intensity);
    }

    /// Adds a new goal.
    fn pursue(self, goal: Goal) {
        let mut goals = self.goals.write();
        goals.push(goal);
    }

    /// Evaluates if a goal should be pursued.
    fn should_pursue(self, goal: &Goal) -> GoalEvaluation {
        let affect = self.affect.read();
        let goals = self.goals.read();

        // Consider emotional state
        let emotional_alignment = affect.alignment_with_goal(goal);

        // Consider existing goals
        let conflicts_with = goals.conflicts_with(goal);
        let supports = goals.supports(goal);

        // Consider capabilities
        let capability_match = self.self_model.can_achieve(goal);

        GoalEvaluation {
            recommended: emotional_alignment > 0.5 && capability_match && conflicts_with.is_empty(),
            emotional_alignment,
            conflicts: conflicts_with,
            supports,
            capability_match,
            uncertainty: self.meta_monitor.uncertainty_for_goal(goal),
        }
    }

    /// Models another agent's mental state.
    fn model_other(mut self, agent_id: &str, observations: &[Observation]) -> &MentalModel {
        let model = self.other_minds
            .entry(agent_id.to_string())
            .or_insert_with(|| MentalModel::new(agent_id));

        for obs in observations {
            model.update(obs);
        }

        model
    }

    /// Predicts another agent's behavior.
    fn predict_other(self, agent_id: &str, context: &Context) -> ?Prediction {
        self.other_minds.get(agent_id)|τ{|model| model.predict(context)}
    }

    /// Gets current cognitive state.
    fn cognitive_state(self) -> CognitiveState {
        self.meta_monitor.assess(&self)
    }

    /// Reflects on recent actions and outcomes.
    fn reflect(self, action: &Action, outcome: &Outcome) -> Reflection {
        let expected = self.meta_monitor.expected_outcome(action);
        let surprise = self.meta_monitor.calculate_surprise(&expected, outcome);

        // Update self-model based on outcome
        if outcome.success {
            self.self_model.reinforce_capability(action.required_capability());
        } else {
            self.self_model.note_failure(action, outcome);
        }

        // Emotional response to outcome
        let emotional_response = if outcome.success {
            Emotion::Satisfaction
        } else {
            Emotion::Disappointment
        };
        self.feel(emotional_response, surprise);

        Reflection {
            action: action.clone(),
            outcome: outcome.clone(),
            expected,
            surprise,
            lessons_learned: self.extract_lessons(action, outcome),
        }
    }

    /// Extracts lessons from experience.
    fn extract_lessons(self, action: &Action, outcome: &Outcome) -> [Lesson] {
        let mut lessons = [];

        if !outcome.success {
            if let Some(reason) = &outcome.failure_reason {
                lessons.push(Lesson {
                    category: LessonCategory::Limitation,
                    description: format!("Action '{}' failed: {}", action.name, reason),
                    confidence: 0.8,
                });
            }
        } else if outcome.better_than_expected {
            lessons.push(Lesson {
                category: LessonCategory::Capability,
                description: format!("Action '{}' exceeded expectations", action.name),
                confidence: 0.9,
            });
        }

        lessons
    }
}

/// Report from introspection.
#[derive(Debug, Clone)]
struct IntrospectionReport {
    identity: Identity,
    current_focus: ?Focus,
    emotional_state: ?Emotion,
    mood: Mood,
    active_goals: [Goal],
    confidence: f32,
    uncertainty_areas: [str],
}

/// Evaluation of whether to pursue a goal.
#[derive(Debug, Clone)]
struct GoalEvaluation {
    recommended: bool,
    emotional_alignment: f32,
    conflicts: [Goal],
    supports: [Goal],
    capability_match: bool,
    uncertainty: f32,
}

/// A stimulus for attention.
#[derive(Debug, Clone)]
struct Stimulus {
    source: str,
    content: str,
    salience: f32,
    category: StimulusCategory,
}

#[derive(Debug, Clone, Copy)]
enum StimulusCategory {
    UserInput,
    ToolOutput,
    InternalThought,
    ExternalEvent,
    Memory,
}

/// An observation about another agent.
#[derive(Debug, Clone)]
struct Observation {
    behavior: str,
    context: str,
    timestamp: std::time::Instant,
}

/// Context for prediction.
#[derive(Debug, Clone)]
struct Context {
    situation: str,
    available_actions: [str],
    stakes: f32,
}

/// A prediction about behavior.
#[derive(Debug, Clone)]
struct Prediction {
    predicted_action: str,
    confidence: f32,
    reasoning: str,
}

/// An action taken by the agent.
#[derive(Debug, Clone)]
struct Action {
    name: str,
    parameters: HashMap<str, str>,
}

impl Action {
    fn required_capability(self) -> &str { &self.name }
}

/// Outcome of an action.
#[derive(Debug, Clone)]
struct Outcome {
    success: bool,
    failure_reason?: str,
    better_than_expected: bool,
    actual_result: str,
}

/// Reflection on an action.
#[derive(Debug, Clone)]
struct Reflection {
    action: Action,
    outcome: Outcome,
    expected: ?Outcome,
    surprise: f32,
    lessons_learned: [Lesson],
}

/// A learned lesson.
#[derive(Debug, Clone)]
struct Lesson {
    category: LessonCategory,
    description: str,
    confidence: f32,
}

#[derive(Debug, Clone, Copy)]
enum LessonCategory {
    Capability,
    Limitation,
    Strategy,
    Social,
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_anima_creation() {
        let config = AnimaConfig {
            identity: Identity::new("test_agent", "A test agent"),
            capabilities: [Capability::new("reasoning", 0.8)],
            limitations: [],
            base_affect: AffectState::neutral(),
            primary_drives: [Drive::Curiosity],
            enable_metacognition: true,
            enable_tom: true,
        };

        let anima = Anima::new(config);
        assert_eq!(anima.identity.name, "test_agent");
    }

    #[test]
    fn test_introspection() {
        let config = AnimaConfig {
            identity: Identity::new("introspector", "Self-aware agent"),
            capabilities: [],
            limitations: [],
            base_affect: AffectState::neutral(),
            primary_drives: [],
            enable_metacognition: true,
            enable_tom: false,
        };

        let anima = Anima::new(config);
        let report = anima.introspect();

        assert_eq!(report.identity.name, "introspector");
    }
}
