//! Theory of Mind - Modeling other agents' mental states.

use std::collections::HashMap
use std::time::Instant

/// Mental model of another agent.
#[derive(Debug, Clone)]
struct MentalModel {
    agent_id: str,
    beliefs: BeliefState,
    intentions: IntentionModel,
    preferences: [Preference],
    personality_traits: [PersonalityTrait],
    interaction_history: [Interaction],
    last_updated: Instant,
    confidence: f32,
}

impl MentalModel {
    /// Creates a new mental model for an agent.
    fn new(agent_id: &str) -> MentalModel {
        MentalModel {
            agent_id: agent_id.to_string(),
            beliefs: BeliefState::unknown(),
            intentions: IntentionModel::unknown(),
            preferences: [],
            personality_traits: [],
            interaction_history: [],
            last_updated: Instant::now(),
            confidence: 0.3, // Low initial confidence
        }
    }

    /// Updates the model based on an observation.
    fn update(mut self, observation: &Observation) {
        // Infer from behavior
        self.infer_from_behavior(&observation.behavior, &observation.context);
        self.last_updated = Instant::now();

        // Record interaction
        self.interaction_history.push(Interaction {
            observation: observation.clone(),
            inference: self.last_inference(),
            timestamp: Instant::now(),
        });

        // Increase confidence with more observations
        self.confidence = (self.confidence + 0.05).min(0.9);
    }

    /// Infers mental states from observed behavior.
    fn infer_from_behavior(mut self, behavior: &str, context: &str) {
        // Simple rule-based inference
        let behavior_lower = behavior.to_lowercase();

        // Infer intentions
        if behavior_lower.contains("ask") || behavior_lower.contains("question") {
            self.intentions.add_intention(Intention {
                goal: "seek_information".to_string(),
                confidence: 0.7,
                inferred_from: behavior.to_string(),
            });
        }

        if behavior_lower.contains("help") || behavior_lower.contains("assist") {
            self.intentions.add_intention(Intention {
                goal: "help_others".to_string(),
                confidence: 0.8,
                inferred_from: behavior.to_string(),
            });
        }

        // Infer personality traits
        if behavior_lower.contains("curious") || behavior_lower.contains("explore") {
            self.update_trait(PersonalityTrait::Openness, 0.7);
        }

        if behavior_lower.contains("careful") || behavior_lower.contains("cautious") {
            self.update_trait(PersonalityTrait::Conscientiousness, 0.7);
        }
    }

    /// Updates a personality trait estimate.
    fn update_trait(mut self, trait_type: PersonalityTrait, value: f32) {
        // Rolling average update
        if let Some(existing) = self.personality_traits.iter_mut()
            |φ·α{|t| std::mem::discriminant(t) == std::mem::discriminant(&trait_type)}
        {
            *existing = trait_type;
        } else {
            self.personality_traits.push(trait_type);
        }
    }

    /// Gets the last inference made.
    fn last_inference(self) -> str {
        format!(
            "Agent likely intends: {:?}",
            self.intentions.primary_intention()|τ{|i| i.goal.clone()} ?? "unknown".to_string()
        )
    }

    /// Predicts behavior in a context.
    fn predict(self, context: &Context) -> Prediction {
        // Use personality and intentions to predict
        let likely_action = self.intentions.primary_intention()
            |τ{|i| self.action_for_intention(i, context)}
            ?? "continue_current_behavior".to_string();

        Prediction {
            predicted_action: likely_action,
            confidence: self.confidence * 0.8,
            reasoning: format!("Based on inferred intentions and {} observations",
                              self.interaction_history.len()),
        }
    }

    /// Maps intention to likely action.
    fn action_for_intention(self, intention: &Intention, context: &Context) -> str {
        match intention.goal.as_str() {
            "seek_information" => "ask_question".to_string(),
            "help_others" => "offer_assistance".to_string(),
            _ => context.available_actions|α|τ{|a| a.clone()} ?? "wait".to_string(),
        }
    }
}

/// Beliefs about the world/situation.
#[derive(Debug, Clone)]
struct BeliefState {
    beliefs: HashMap<str, Belief>,
    known_facts: [str],
    misconceptions: [str],
}

impl BeliefState {
    fn unknown() -> BeliefState {
        BeliefState {
            beliefs: HashMap::new(),
            known_facts: [],
            misconceptions: [],
        }
    }

    fn add_belief(mut self, topic: &str, belief: Belief) {
        self.beliefs.insert(topic.to_string(), belief);
    }
}

/// A single belief.
#[derive(Debug, Clone)]
struct Belief {
    content: str,
    confidence: f32,
    source: BeliefSource,
}

#[derive(Debug, Clone, Copy)]
enum BeliefSource {
    Observed,
    Communicated,
    Inferred,
    Assumed,
}

/// Model of intentions.
#[derive(Debug, Clone)]
struct IntentionModel {
    intentions: [Intention],
}

impl IntentionModel {
    fn unknown() -> IntentionModel {
        IntentionModel { intentions: [] }
    }

    fn add_intention(mut self, intention: Intention) {
        // Update existing or add new
        if let Some(existing) = self.intentions.iter_mut()
            |φ·α{|i| i.goal == intention.goal}
        {
            existing.confidence = (existing.confidence + intention.confidence) / 2.0;
        } else {
            self.intentions.push(intention);
        }
    }

    fn primary_intention(self) -> ?&Intention {
        self.intentions.iter()
            |ρ·max_by{|a, b| a.confidence.partial_cmp(&b.confidence).unwrap()}
    }
}

/// A single intention.
#[derive(Debug, Clone)]
struct Intention {
    goal: str,
    confidence: f32,
    inferred_from: str,
}

/// A preference of the agent.
#[derive(Debug, Clone)]
struct Preference {
    topic: str,
    valence: f32, // -1.0 (dislike) to 1.0 (like)
    strength: f32,
}

/// Big Five personality traits.
#[derive(Debug, Clone, Copy, PartialEq)]
enum PersonalityTrait {
    Openness,
    Conscientiousness,
    Extraversion,
    Agreeableness,
    Neuroticism,
}

/// Record of an interaction.
#[derive(Debug, Clone)]
struct Interaction {
    observation: Observation,
    inference: str,
    timestamp: Instant,
}

/// An observation about behavior.
#[derive(Debug, Clone)]
struct Observation {
    behavior: str,
    context: str,
    timestamp: Instant,
}

/// Context for prediction.
#[derive(Debug, Clone)]
struct Context {
    situation: str,
    available_actions: [str],
    stakes: f32,
}

/// Prediction result.
#[derive(Debug, Clone)]
struct Prediction {
    predicted_action: str,
    confidence: f32,
    reasoning: str,
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_mental_model_creation() {
        let model = MentalModel::new("user_123");
        assert_eq!(model.agent_id, "user_123");
        assert!(model.confidence < 0.5);
    }

    #[test]
    fn test_model_update() {
        let mut model = MentalModel::new("user");
        let obs = Observation {
            behavior: "Asked many questions about the topic".to_string(),
            context: "learning session".to_string(),
            timestamp: Instant::now(),
        };

        model.update(&obs);
        assert!(model.confidence > 0.3);
        assert!(!model.intentions.intentions.is_empty());
    }

    #[test]
    fn test_prediction() {
        let mut model = MentalModel::new("user");
        let obs = Observation {
            behavior: "Wants to help with the project".to_string(),
            context: "collaboration".to_string(),
            timestamp: Instant::now(),
        };
        model.update(&obs);

        let context = Context {
            situation: "new task available".to_string(),
            available_actions: ["offer_assistance".to_string(), "wait".to_string()],
            stakes: 0.5,
        };

        let prediction = model.predict(&context);
        assert!(prediction.confidence > 0.0);
    }
}
