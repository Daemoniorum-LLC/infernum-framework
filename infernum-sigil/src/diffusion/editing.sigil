// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_inpaint_config() {
        let config = InpaintConfig::default()
        assert_eq!(config.strength, 1.0)
        assert_eq!(config.mask_blur, 4)
    }

    #[test]
    fn test_outpaint_config() {
        let config = OutpaintConfig::default(OutpaintDirection::Right)
        assert_eq!(config.extend_pixels, 256)
    }

    #[test]
    fn test_img2img_config() {
        let light = Img2ImgConfig::light()
        let strong = Img2ImgConfig::strong()
        assert!(light.strength < strong.strength)
    }

    #[test]
    fn test_upscale_config() {
        let config = UpscaleConfig::hq_4x()
        assert_eq!(config.scale_factor, 4)
        assert!(config.use_refiner)
    }
}
