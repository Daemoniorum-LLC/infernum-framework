/// Variational Autoencoder (VAE) - Latent Space Encoding/Decoding
///
/// Implements the VAE component used in latent diffusion models.
/// Encodes images to a compressed latent space where diffusion operates,
/// then decodes latents back to pixel space.
///
/// Sigil features:
/// - `data~` for input images (untrusted user data)
/// - `computed!` for encoded latents and decoded images
/// - `grad()` for training/fine-tuning support
/// - `τ{}` morpheme for batch processing

use core::tensor::{Tensor, DType, Device}
use core::error::Result
use candle_nn::{Conv2d, GroupNorm, Linear, Module, VarBuilder}
use diffusion::types::{LatentTensor, DiffusionArchitecture}

// ============================================================================
// VAE Configuration
// ============================================================================

/// VAE configuration
#[derive(Debug, Clone)]
pub struct VAEConfig {
    /// Input/output image channels (3 for RGB)
    pub in_channels: u32 = 3,

    /// Latent space channels (4 for SD, 16 for SD3/Flux)
    pub latent_channels: u32 = 4,

    /// Block output channels for encoder/decoder
    pub block_out_channels: [u32] = [128, 256, 512, 512],

    /// Number of ResNet blocks per stage
    pub layers_per_block: u32 = 2,

    /// Scaling factor for latents
    pub scaling_factor: f32 = 0.18215,

    /// Whether to use attention in middle block
    pub use_attention: bool = true,

    /// GroupNorm num_groups
    pub norm_num_groups: u32 = 32,

    /// Enable tiled encoding/decoding for large images
    pub enable_tiling: bool = false,

    /// Tile size for tiled mode
    pub tile_size: u32 = 512,

    /// Tile overlap for tiled mode
    pub tile_overlap: u32 = 64,
}

impl VAEConfig {
    /// Config for Stable Diffusion 1.x/2.x/XL VAE
    pub fn sd_vae() -> Self {
        Self {
            in_channels: 3,
            latent_channels: 4,
            block_out_channels: [128, 256, 512, 512],
            layers_per_block: 2,
            scaling_factor: 0.18215,
            use_attention: true,
            norm_num_groups: 32,
            enable_tiling: false,
            tile_size: 512,
            tile_overlap: 64,
        }
    }

    /// Config for SDXL VAE (same architecture, different weights)
    pub fn sdxl_vae() -> Self {
        Self::sd_vae()
    }

    /// Config for SD3/Flux VAE (16 latent channels)
    pub fn sd3_vae() -> Self {
        Self {
            in_channels: 3,
            latent_channels: 16,
            block_out_channels: [128, 256, 512, 512],
            layers_per_block: 2,
            scaling_factor: 0.13025,
            use_attention: true,
            norm_num_groups: 32,
            enable_tiling: false,
            tile_size: 512,
            tile_overlap: 64,
        }
    }

    /// Get config for architecture
    pub fn for_architecture(arch: DiffusionArchitecture) -> Self {
        match arch {
            DiffusionArchitecture::SD_1_5 | DiffusionArchitecture::SD_2_1 => Self::sd_vae(),
            DiffusionArchitecture::SDXL => Self::sdxl_vae(),
            DiffusionArchitecture::SD3 | DiffusionArchitecture::Flux => Self::sd3_vae(),
            _ => Self::sd_vae(),
        }
    }
}

// ============================================================================
// VAE Components
// ============================================================================

/// ResNet block for VAE
pub struct VAEResNetBlock {
    norm1: GroupNorm,
    conv1: Conv2d,
    norm2: GroupNorm,
    conv2: Conv2d,
    shortcut?: Conv2d,
    in_channels: u32,
    out_channels: u32,
}

impl VAEResNetBlock {
    pub fn new(
        in_channels: u32,
        out_channels: u32,
        groups: u32,
        vb: VarBuilder,
    ) -> Result<Self> {
        let norm1 = GroupNorm::new(groups, in_channels, 1e-6, vb.pp("norm1"))?
        let conv1 = Conv2d::new(in_channels, out_channels, 3, 1, 1, vb.pp("conv1"))?
        let norm2 = GroupNorm::new(groups, out_channels, 1e-6, vb.pp("norm2"))?
        let conv2 = Conv2d::new(out_channels, out_channels, 3, 1, 1, vb.pp("conv2"))?

        let shortcut = if in_channels != out_channels {
            Some(Conv2d::new(in_channels, out_channels, 1, 1, 0, vb.pp("shortcut"))?)
        } else {
            None
        }

        Ok(Self {
            norm1, conv1, norm2, conv2, shortcut,
            in_channels, out_channels,
        })
    }
}

impl Module for VAEResNetBlock {
    fn forward(self, x: &Tensor) -> Result<Tensor> {
        let residual = match &self.shortcut {
            Some(conv) => conv.forward(x)?,
            None => x.clone(),
        }

        let h = self.norm1.forward(x)?
        let h = h.silu()?
        let h = self.conv1.forward(&h)?
        let h = self.norm2.forward(&h)?
        let h = h.silu()?
        let h = self.conv2.forward(&h)?

        h + residual
    }
}

/// Self-attention block for VAE
pub struct VAEAttentionBlock {
    group_norm: GroupNorm,
    to_q: Linear,
    to_k: Linear,
    to_v: Linear,
    to_out: Linear,
    num_heads: u32,
    head_dim: u32,
}

impl VAEAttentionBlock {
    pub fn new(channels: u32, groups: u32, vb: VarBuilder) -> Result<Self> {
        let num_heads = 1u32 // VAE typically uses single-head attention
        let head_dim = channels

        let group_norm = GroupNorm::new(groups, channels, 1e-6, vb.pp("group_norm"))?
        let to_q = Linear::new(channels, channels, vb.pp("to_q"))?
        let to_k = Linear::new(channels, channels, vb.pp("to_k"))?
        let to_v = Linear::new(channels, channels, vb.pp("to_v"))?
        let to_out = Linear::new(channels, channels, vb.pp("to_out"))?

        Ok(Self {
            group_norm, to_q, to_k, to_v, to_out,
            num_heads, head_dim,
        })
    }
}

impl Module for VAEAttentionBlock {
    fn forward(self, x: &Tensor) -> Result<Tensor> {
        let residual = x
        let (batch, channels, height, width) = x.dims4()?

        // Reshape to [batch, channels, height*width]
        let x = self.group_norm.forward(x)?
        let x = x.reshape([batch, channels, height * width])?
        let x = x.transpose(1, 2)? // [batch, seq, channels]

        // Attention
        let q = self.to_q.forward(&x)?
        let k = self.to_k.forward(&x)?
        let v = self.to_v.forward(&x)?

        let scale = (self.head_dim as f64).sqrt().recip()
        let attn = (q.matmul(&k.transpose(-1, -2)?)? * scale)?
        let attn = attn.softmax(-1)?
        let out = attn.matmul(&v)?

        // Project and reshape back
        let out = self.to_out.forward(&out)?
        let out = out.transpose(1, 2)? // [batch, channels, seq]
        let out = out.reshape([batch, channels, height, width])?

        out + residual
    }
}

/// Downsample block for encoder
pub struct VAEDownsample {
    conv: Conv2d,
}

impl VAEDownsample {
    pub fn new(channels: u32, vb: VarBuilder) -> Result<Self> {
        // Asymmetric padding: pad(0,1,0,1) then stride 2
        let conv = Conv2d::new(channels, channels, 3, 2, 0, vb.pp("conv"))?
        Ok(Self { conv })
    }
}

impl Module for VAEDownsample {
    fn forward(self, x: &Tensor) -> Result<Tensor> {
        // Pad asymmetrically
        let x = x.pad_with_zeros(2, 0, 1)?.pad_with_zeros(3, 0, 1)?
        self.conv.forward(&x)
    }
}

/// Upsample block for decoder
pub struct VAEUpsample {
    conv: Conv2d,
}

impl VAEUpsample {
    pub fn new(channels: u32, vb: VarBuilder) -> Result<Self> {
        let conv = Conv2d::new(channels, channels, 3, 1, 1, vb.pp("conv"))?
        Ok(Self { conv })
    }
}

impl Module for VAEUpsample {
    fn forward(self, x: &Tensor) -> Result<Tensor> {
        // Nearest-neighbor upsample 2x
        let (_, _, h, w) = x.dims4()?
        let x = x.upsample_nearest2d(h * 2, w * 2)?
        self.conv.forward(&x)
    }
}

// ============================================================================
// VAE Encoder
// ============================================================================

/// VAE Encoder - compresses images to latent space
pub struct VAEEncoder {
    conv_in: Conv2d,
    down_blocks: [VAEEncoderBlock],
    mid_block: VAEMidBlock,
    conv_norm_out: GroupNorm,
    conv_out: Conv2d,
    quant_conv: Conv2d,
    config: VAEConfig,
}

pub struct VAEEncoderBlock {
    res_blocks: [VAEResNetBlock],
    downsample?: VAEDownsample,
}

pub struct VAEMidBlock {
    res_block1: VAEResNetBlock,
    attention: VAEAttentionBlock,
    res_block2: VAEResNetBlock,
}

impl VAEEncoder {
    pub fn new(config: VAEConfig, vb: VarBuilder) -> Result<Self> {
        let block_channels = &config.block_out_channels

        // Initial convolution
        let conv_in = Conv2d::new(
            config.in_channels,
            block_channels[0],
            3, 1, 1,
            vb.pp("conv_in")
        )?

        // Down blocks
        let mut down_blocks = vec![]
        let mut in_ch = block_channels[0]

        for (i, &out_ch) in block_channels.iter().enumerate() {
            let vb_block = vb.pp(format!("down_blocks.{}", i))

            let mut res_blocks = vec![]
            for j in 0..config.layers_per_block {
                let block_in = if j == 0 { in_ch } else { out_ch }
                res_blocks.push(VAEResNetBlock::new(
                    block_in, out_ch, config.norm_num_groups,
                    vb_block.pp(format!("resnets.{}", j))
                )?)
            }

            let downsample = if i < block_channels.len() - 1 {
                Some(VAEDownsample::new(out_ch, vb_block.pp("downsamplers.0"))?)
            } else {
                None
            }

            down_blocks.push(VAEEncoderBlock { res_blocks, downsample })
            in_ch = out_ch
        }

        // Mid block
        let last_ch = *block_channels.last().unwrap()
        let mid_block = VAEMidBlock {
            res_block1: VAEResNetBlock::new(
                last_ch, last_ch, config.norm_num_groups,
                vb.pp("mid_block.resnets.0")
            )?,
            attention: VAEAttentionBlock::new(
                last_ch, config.norm_num_groups,
                vb.pp("mid_block.attentions.0")
            )?,
            res_block2: VAEResNetBlock::new(
                last_ch, last_ch, config.norm_num_groups,
                vb.pp("mid_block.resnets.1")
            )?,
        }

        // Output layers
        let conv_norm_out = GroupNorm::new(
            config.norm_num_groups, last_ch, 1e-6,
            vb.pp("conv_norm_out")
        )?

        // Output conv: 2x latent channels for mean and log_var
        let conv_out = Conv2d::new(
            last_ch, config.latent_channels * 2,
            3, 1, 1,
            vb.pp("conv_out")
        )?

        // Quant conv for final projection
        let quant_conv = Conv2d::new(
            config.latent_channels * 2, config.latent_channels * 2,
            1, 1, 0,
            vb.pp("quant_conv")
        )?

        Ok(Self {
            conv_in, down_blocks, mid_block,
            conv_norm_out, conv_out, quant_conv, config,
        })
    }

    /// Encode image to latent distribution
    pub fn forward(self, x~: &Tensor) -> Result<LatentDistribution!> {
        // Input validation - x~ is untrusted user data
        let x = self.conv_in.forward(x~)?

        // Down blocks
        let mut h = x
        for block in &self.down_blocks {
            for res_block in &block.res_blocks {
                h = res_block.forward(&h)?
            }
            if let Some(down) = &block.downsample {
                h = down.forward(&h)?
            }
        }

        // Mid block
        h = self.mid_block.res_block1.forward(&h)?
        h = self.mid_block.attention.forward(&h)?
        h = self.mid_block.res_block2.forward(&h)?

        // Output
        h = self.conv_norm_out.forward(&h)?
        h = h.silu()?
        h = self.conv_out.forward(&h)?
        h! = self.quant_conv.forward(&h)?

        // Split into mean and log_var (computed! output)
        let (mean!, log_var!) = h!.chunk(2, 1)?

        Ok(LatentDistribution! {
            mean!,
            log_var!,
            scaling_factor!: self.config.scaling_factor,
        })
    }
}

// ============================================================================
// VAE Decoder
// ============================================================================

/// VAE Decoder - reconstructs images from latent space
pub struct VAEDecoder {
    post_quant_conv: Conv2d,
    conv_in: Conv2d,
    mid_block: VAEMidBlock,
    up_blocks: [VAEDecoderBlock],
    conv_norm_out: GroupNorm,
    conv_out: Conv2d,
    config: VAEConfig,
}

pub struct VAEDecoderBlock {
    res_blocks: [VAEResNetBlock],
    upsample?: VAEUpsample,
}

impl VAEDecoder {
    pub fn new(config: VAEConfig, vb: VarBuilder) -> Result<Self> {
        let block_channels = &config.block_out_channels
        let last_ch = *block_channels.last().unwrap()

        // Post-quant conv
        let post_quant_conv = Conv2d::new(
            config.latent_channels, config.latent_channels,
            1, 1, 0,
            vb.pp("post_quant_conv")
        )?

        // Input conv
        let conv_in = Conv2d::new(
            config.latent_channels, last_ch,
            3, 1, 1,
            vb.pp("conv_in")
        )?

        // Mid block
        let mid_block = VAEMidBlock {
            res_block1: VAEResNetBlock::new(
                last_ch, last_ch, config.norm_num_groups,
                vb.pp("mid_block.resnets.0")
            )?,
            attention: VAEAttentionBlock::new(
                last_ch, config.norm_num_groups,
                vb.pp("mid_block.attentions.0")
            )?,
            res_block2: VAEResNetBlock::new(
                last_ch, last_ch, config.norm_num_groups,
                vb.pp("mid_block.resnets.1")
            )?,
        }

        // Up blocks (reversed order)
        let mut up_blocks = vec![]
        let reversed_channels: [u32] = block_channels.iter().rev().copied().collect()

        for (i, &out_ch) in reversed_channels.iter().enumerate() {
            let vb_block = vb.pp(format!("up_blocks.{}", i))
            let in_ch = if i == 0 { last_ch } else { reversed_channels[i - 1] }

            let mut res_blocks = vec![]
            for j in 0..(config.layers_per_block + 1) {
                let block_in = if j == 0 { in_ch } else { out_ch }
                res_blocks.push(VAEResNetBlock::new(
                    block_in, out_ch, config.norm_num_groups,
                    vb_block.pp(format!("resnets.{}", j))
                )?)
            }

            let upsample = if i < reversed_channels.len() - 1 {
                Some(VAEUpsample::new(out_ch, vb_block.pp("upsamplers.0"))?)
            } else {
                None
            }

            up_blocks.push(VAEDecoderBlock { res_blocks, upsample })
        }

        // Output layers
        let conv_norm_out = GroupNorm::new(
            config.norm_num_groups, block_channels[0], 1e-6,
            vb.pp("conv_norm_out")
        )?

        let conv_out = Conv2d::new(
            block_channels[0], config.in_channels,
            3, 1, 1,
            vb.pp("conv_out")
        )?

        Ok(Self {
            post_quant_conv, conv_in, mid_block, up_blocks,
            conv_norm_out, conv_out, config,
        })
    }

    /// Decode latents to image
    pub fn forward(self, z!: &LatentTensor!) -> Result<Tensor!> {
        let z = self.post_quant_conv.forward(&z!.tensor!)?
        let mut h = self.conv_in.forward(&z)?

        // Mid block
        h = self.mid_block.res_block1.forward(&h)?
        h = self.mid_block.attention.forward(&h)?
        h = self.mid_block.res_block2.forward(&h)?

        // Up blocks
        for block in &self.up_blocks {
            for res_block in &block.res_blocks {
                h = res_block.forward(&h)?
            }
            if let Some(up) = &block.upsample {
                h = up.forward(&h)?
            }
        }

        // Output
        h = self.conv_norm_out.forward(&h)?
        h = h.silu()?
        let out! = self.conv_out.forward(&h)?

        Ok(out!)
    }
}

// ============================================================================
// Full VAE
// ============================================================================

/// Latent distribution from VAE encoder
#[derive(Debug, Clone)]
pub struct LatentDistribution! {
    /// Mean of the distribution
    pub mean!: Tensor,

    /// Log variance of the distribution
    pub log_var!: Tensor,

    /// Scaling factor to apply
    pub scaling_factor!: f32,
}

impl LatentDistribution! {
    /// Sample from the distribution using reparameterization trick
    pub fn sample(self, generator?: &mut Generator) -> LatentTensor! {
        // z = mean + std * epsilon
        let std! = (self.log_var! * 0.5)!.exp()?
        let eps! = if let Some(gen) = generator {
            Tensor::randn_like_with_generator(&self.mean!, gen)?
        } else {
            Tensor::randn_like(&self.mean!)?
        }

        let z! = (self.mean! + std! * eps!)!

        // Apply scaling factor
        let scaled! = (z! * self.scaling_factor!)!

        LatentTensor!::new(scaled!, self.scaling_factor!)
    }

    /// Get mode (most likely value) - just the scaled mean
    pub fn mode(self) -> LatentTensor! {
        let scaled! = (self.mean!.clone() * self.scaling_factor!)!
        LatentTensor!::new(scaled!, self.scaling_factor!)
    }

    /// Compute KL divergence from standard normal (for training)
    pub fn kl_divergence(self) -> Tensor! {
        // KL(q(z|x) || p(z)) = -0.5 * sum(1 + log_var - mean^2 - exp(log_var))
        let kl! = (self.log_var!.exp()? + self.mean!.sqr()? - 1.0 - self.log_var!)?
        (kl! * 0.5)?
    }
}

/// Complete VAE module
pub struct VAE {
    encoder: VAEEncoder,
    decoder: VAEDecoder,
    config: VAEConfig,
    device: Device,
    dtype: DType,
}

impl VAE {
    /// Create new VAE
    pub fn new(config: VAEConfig, device: Device, dtype: DType, vb: VarBuilder) -> Result<Self> {
        let encoder = VAEEncoder::new(config.clone(), vb.pp("encoder"))?
        let decoder = VAEDecoder::new(config.clone(), vb.pp("decoder"))?

        Ok(Self { encoder, decoder, config, device, dtype })
    }

    /// Create VAE for architecture
    pub fn for_architecture(
        arch: DiffusionArchitecture,
        device: Device,
        dtype: DType,
        vb: VarBuilder,
    ) -> Result<Self> {
        let config = VAEConfig::for_architecture(arch)
        Self::new(config, device, dtype, vb)
    }

    /// Encode image to latent space
    /// Input: data~ (untrusted user image)
    /// Output: computed! (verified latent tensor)
    pub fn encode(self, image~: &Tensor) -> Result<LatentTensor!> {
        // Normalize image from [0, 1] to [-1, 1] if needed
        let normalized~ = (image~ * 2.0 - 1.0)?

        // Encode to distribution
        let dist! = self.encoder.forward(&normalized~)?

        // Return mode (deterministic) for inference
        Ok(dist!.mode())
    }

    /// Encode to distribution (for training with KL loss)
    pub fn encode_to_distribution(self, image~: &Tensor) -> Result<LatentDistribution!> {
        let normalized~ = (image~ * 2.0 - 1.0)?
        self.encoder.forward(&normalized~)
    }

    /// Decode latents to image
    /// Input: computed! (verified latents)
    /// Output: computed! (generated image)
    pub fn decode(self, latents!: &LatentTensor!) -> Result<Tensor!> {
        // Unscale latents
        let unscaled! = latents!.clone().unscale()

        // Decode
        let image! = self.decoder.forward(&unscaled!)?

        // Denormalize from [-1, 1] to [0, 1]
        let output! = ((image! + 1.0)? * 0.5)?.clamp(0.0, 1.0)?

        Ok(output!)
    }

    /// Encode and decode (reconstruction)
    pub fn reconstruct(self, image~: &Tensor) -> Result<Tensor!> {
        let latents! = self.encode(image~)?
        self.decode(&latents!)
    }

    /// Get config
    pub fn config(self) -> &VAEConfig {
        &self.config
    }

    /// Tiled encode for large images
    pub fn encode_tiled(self, image~: &Tensor) -> Result<LatentTensor!> {
        if !self.config.enable_tiling {
            return self.encode(image~)
        }

        let (_, _, height, width) = image~.dims4()?
        let tile_size = self.config.tile_size as usize
        let overlap = self.config.tile_overlap as usize
        let stride = tile_size - overlap

        // Process tiles
        let latent_tiles!: [[Tensor!]] = []
        let mut y = 0usize
        while y < height {
            let mut row!: [Tensor!] = []
            let mut x = 0usize
            while x < width {
                let tile_h = (tile_size).min(height - y)
                let tile_w = (tile_size).min(width - x)

                let tile~ = image~.narrow(2, y, tile_h)?.narrow(3, x, tile_w)?
                let latent! = self.encode(&tile~)?

                row!.push(latent!.tensor!)
                x += stride
            }
            latent_tiles!.push(row!)
            y += stride
        }

        // Blend tiles together
        blend_latent_tiles(latent_tiles!, overlap / 8, self.config.scaling_factor)
    }

    /// Tiled decode for large latents
    pub fn decode_tiled(self, latents!: &LatentTensor!) -> Result<Tensor!> {
        if !self.config.enable_tiling {
            return self.decode(latents!)
        }

        // Similar tiled processing for decode
        // (Implementation follows same pattern as encode_tiled)
        self.decode(latents!) // Simplified for now
    }
}

// ============================================================================
// Helper Functions
// ============================================================================

fn blend_latent_tiles(
    tiles!: [[Tensor!]],
    overlap: usize,
    scale_factor: f32,
) -> Result<LatentTensor!> {
    // Simple concatenation for now
    // Full implementation would use feathered blending in overlap regions
    let rows!: [Tensor!] = tiles!
        τ{ row! => Tensor::cat(&row!, 3)? }!

    let full! = Tensor::cat(&rows!, 2)?

    Ok(LatentTensor!::new(full!, scale_factor))
}

extern struct Generator

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_vae_config() {
        let config = VAEConfig::sd_vae()
        assert_eq!(config.latent_channels, 4)
        assert_eq!(config.scaling_factor, 0.18215)

        let sd3_config = VAEConfig::sd3_vae()
        assert_eq!(sd3_config.latent_channels, 16)
    }

    #[test]
    fn test_latent_distribution() {
        let mean! = Tensor::zeros([1, 4, 64, 64], &Device::Cpu, DType::F32)?
        let log_var! = Tensor::zeros([1, 4, 64, 64], &Device::Cpu, DType::F32)?

        let dist! = LatentDistribution! {
            mean!,
            log_var!,
            scaling_factor!: 0.18215,
        }

        let latent! = dist!.mode()
        assert_eq!(latent!.channels!, 4)
    }

    #[test]
    fn test_guidance_scale_apply() {
        let guidance = GuidanceScale::new(7.5)
        // Would test CFG application with actual tensors
    }
}
