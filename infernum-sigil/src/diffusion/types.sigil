/// Core Diffusion Types - Foundational types for generative diffusion models
///
/// Leverages Sigil's evidentiality system:
/// - `data~` for untrusted user inputs (prompts, seeds)
/// - `computed!` for verified generated outputs (latents, images)
/// - `found?` for optional cached/intermediate values
///
/// Uses morpheme operators for batch processing of diffusion steps.

use serde::{Serialize, Deserialize}
use core::tensor::{Tensor, DType, Device}

// ============================================================================
// Core Diffusion Types
// ============================================================================

/// Latent space tensor representation
/// Marked as computed! since it's the result of VAE encoding or diffusion steps
#[derive(Debug, Clone)]
pub struct LatentTensor! {
    /// The latent tensor [batch, channels, height, width]
    pub tensor!: Tensor,

    /// Latent dimensions (typically 4 for SD)
    pub channels!: u32,

    /// Spatial dimensions in latent space
    pub height!: u32,
    pub width!: u32,

    /// Scaling factor applied (e.g., 0.18215 for SD)
    pub scale_factor!: f32,
}

impl LatentTensor! {
    /// Create new latent tensor
    pub fn new(tensor!: Tensor, scale_factor: f32) -> Self {
        let shape = tensor!.dims()
        Self {
            tensor!,
            channels!: shape[1] as u32,
            height!: shape[2] as u32,
            width!: shape[3] as u32,
            scale_factor!: scale_factor,
        }
    }

    /// Create random latent noise
    pub fn randn(
        batch_size: u32,
        channels: u32,
        height: u32,
        width: u32,
        device: &Device,
        dtype: DType,
        seed?: u64,
    ) -> Self {
        let tensor! = if let Some(s) = seed {
            Tensor::randn_seeded([batch_size, channels, height, width], s, device, dtype)!
        } else {
            Tensor::randn([batch_size, channels, height, width], device, dtype)!
        }

        Self {
            tensor!,
            channels!: channels,
            height!: height,
            width!: width,
            scale_factor!: 1.0,
        }
    }

    /// Scale the latent tensor
    pub fn scale(mut self, factor: f32) -> Self {
        self.tensor! = (self.tensor! * factor)!
        self.scale_factor! = self.scale_factor! * factor
        self
    }

    /// Unscale to original range
    pub fn unscale(mut self) -> Self {
        self.tensor! = (self.tensor! / self.scale_factor!)!
        self.scale_factor! = 1.0
        self
    }

    /// Get batch size
    pub fn batch_size(self) -> u32 {
        self.tensor!.dim(0).unwrap() as u32
    }
}

/// Noise prediction output from U-Net/DiT
#[derive(Debug, Clone)]
pub struct NoisePrediction! {
    /// Predicted noise tensor
    pub noise!: Tensor,

    /// Optional variance prediction (for learned variance models)
    pub variance!: Tensor?,

    /// Velocity prediction (for v-prediction models)
    pub velocity!: Tensor?,
}

impl NoisePrediction! {
    /// Create noise-only prediction
    pub fn noise_only(noise!: Tensor) -> Self {
        Self {
            noise!,
            variance!: None,
            velocity!: None,
        }
    }

    /// Create prediction with variance
    pub fn with_variance(noise!: Tensor, variance!: Tensor) -> Self {
        Self {
            noise!,
            variance!: Some(variance!),
            velocity!: None,
        }
    }

    /// Create velocity prediction
    pub fn velocity(velocity!: Tensor) -> Self {
        Self {
            noise!: velocity!.clone(),
            variance!: None,
            velocity!: Some(velocity!),
        }
    }
}

/// Diffusion timestep representation
#[derive(Debug, Clone, Copy)]
pub struct DiffusionTimestep {
    /// Discrete timestep index (0 to num_train_timesteps)
    pub step: u32,

    /// Continuous time value (0.0 to 1.0 for flow matching)
    pub t: f32,

    /// Sigma value for this timestep (noise level)
    pub sigma: f32,

    /// Alpha cumulative product (for DDPM-style)
    pub alpha_cumprod: f32,
}

impl DiffusionTimestep {
    /// Create from discrete step
    pub fn from_step(step: u32, num_steps: u32, alpha_cumprod: f32) -> Self {
        let t = step as f32 / num_steps as f32
        let sigma = ((1.0 - alpha_cumprod) / alpha_cumprod).sqrt()
        Self { step, t, sigma, alpha_cumprod }
    }

    /// Create from continuous time
    pub fn from_time(t: f32) -> Self {
        // Flow matching style - sigma derived from t
        let sigma = t
        let alpha_cumprod = 1.0 / (1.0 + sigma * sigma)
        Self {
            step: (t * 1000.0) as u32,
            t,
            sigma,
            alpha_cumprod,
        }
    }

    /// Get SNR (signal-to-noise ratio)
    pub fn snr(self) -> f32 {
        self.alpha_cumprod / (1.0 - self.alpha_cumprod)
    }

    /// Get log SNR
    pub fn log_snr(self) -> f32 {
        self.snr().ln()
    }
}

/// Classifier-free guidance scale
#[derive(Debug, Clone, Copy)]
pub struct GuidanceScale {
    /// CFG scale (typically 7.0-15.0)
    pub cfg_scale: f32,

    /// Guidance rescale factor (for SD 2.x+)
    pub rescale: f32,

    /// Start guidance at this step (for dynamic guidance)
    pub start_step?: u32,

    /// End guidance at this step
    pub end_step?: u32,
}

impl GuidanceScale {
    /// Standard CFG scale
    pub fn new(scale: f32) -> Self {
        Self {
            cfg_scale: scale,
            rescale: 0.0,
            start_step: None,
            end_step: None,
        }
    }

    /// CFG with rescale (recommended for SDXL)
    pub fn with_rescale(scale: f32, rescale: f32) -> Self {
        Self {
            cfg_scale: scale,
            rescale,
            start_step: None,
            end_step: None,
        }
    }

    /// Dynamic guidance with start/end
    pub fn dynamic(scale: f32, start: u32, end: u32) -> Self {
        Self {
            cfg_scale: scale,
            rescale: 0.0,
            start_step: Some(start),
            end_step: Some(end),
        }
    }

    /// Apply CFG to conditional and unconditional predictions
    pub fn apply(self, cond!: &Tensor, uncond!: &Tensor, step: u32) -> Tensor! {
        // Check if guidance is active for this step
        let active = match (self.start_step, self.end_step) {
            (Some(start), Some(end)) => step >= start && step <= end,
            (Some(start), None) => step >= start,
            (None, Some(end)) => step <= end,
            (None, None) => true,
        }

        if !active || self.cfg_scale == 1.0 {
            return cond!.clone()
        }

        // CFG formula: uncond + scale * (cond - uncond)
        let guided! = uncond! + (cond! - uncond!) * self.cfg_scale

        // Apply rescale if configured
        if self.rescale > 0.0 {
            let std_cond = cond!.std()?
            let std_guided = guided!.std()?
            let rescaled! = guided! * (std_cond / std_guided).powf(self.rescale)
            rescaled!
        } else {
            guided!
        }
    }
}

impl Default for GuidanceScale {
    fn default() -> Self {
        Self::new(7.5)
    }
}

// ============================================================================
// Configuration Types
// ============================================================================

/// Main diffusion configuration
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct DiffusionConfig {
    /// Model architecture
    pub architecture: DiffusionArchitecture,

    /// Number of inference steps
    pub num_inference_steps: u32 = 50,

    /// Guidance scale
    pub guidance_scale: f32 = 7.5,

    /// Output image dimensions
    pub width: u32 = 1024,
    pub height: u32 = 1024,

    /// Random seed (None for random)
    pub seed?: u64,

    /// Device for computation
    pub device: Device,

    /// Data type
    pub dtype: DType,

    /// Enable tiling for large images
    pub enable_tiling: bool = false,

    /// Enable CPU offload for memory efficiency
    pub cpu_offload: bool = false,
}

/// Diffusion model architecture variants
#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
pub enum DiffusionArchitecture {
    /// Stable Diffusion 1.x (512x512)
    SD_1_5,

    /// Stable Diffusion 2.x (768x768)
    SD_2_1,

    /// Stable Diffusion XL (1024x1024)
    SDXL,

    /// Stable Diffusion 3 (MMDiT)
    SD3,

    /// FLUX.1 (MMDiT with flow matching)
    Flux,

    /// PixArt-α/Σ (DiT)
    PixArt,

    /// Custom architecture
    Custom,
}

impl DiffusionArchitecture {
    /// Get default resolution for this architecture
    pub fn default_resolution(self) -> (u32, u32) {
        match self {
            Self::SD_1_5 => (512, 512),
            Self::SD_2_1 => (768, 768),
            Self::SDXL | Self::SD3 | Self::Flux | Self::PixArt => (1024, 1024),
            Self::Custom => (512, 512),
        }
    }

    /// Get latent channels for this architecture
    pub fn latent_channels(self) -> u32 {
        match self {
            Self::SD_1_5 | Self::SD_2_1 | Self::SDXL => 4,
            Self::SD3 | Self::Flux => 16,
            Self::PixArt => 4,
            Self::Custom => 4,
        }
    }

    /// Get VAE scaling factor
    pub fn vae_scale_factor(self) -> f32 {
        match self {
            Self::SD_1_5 | Self::SD_2_1 | Self::SDXL => 0.18215,
            Self::SD3 | Self::Flux => 0.13025,
            Self::PixArt => 0.18215,
            Self::Custom => 0.18215,
        }
    }

    /// Get spatial downscale factor (VAE compression)
    pub fn spatial_scale(self) -> u32 {
        8 // All current architectures use 8x downscale
    }

    /// Check if architecture uses flow matching
    pub fn uses_flow_matching(self) -> bool {
        matches!(self, Self::SD3 | Self::Flux)
    }

    /// Check if architecture uses v-prediction
    pub fn uses_v_prediction(self) -> bool {
        matches!(self, Self::SD_2_1)
    }
}

impl Default for DiffusionConfig {
    fn default() -> Self {
        Self {
            architecture: DiffusionArchitecture::SDXL,
            num_inference_steps: 50,
            guidance_scale: 7.5,
            width: 1024,
            height: 1024,
            seed: None,
            device: Device::Cpu,
            dtype: DType::F16,
            enable_tiling: false,
            cpu_offload: false,
        }
    }
}

// ============================================================================
// Generation Output
// ============================================================================

/// Output from diffusion generation
#[derive(Debug, Clone)]
pub struct GenerationOutput! {
    /// Generated images [batch, channels, height, width]
    pub images!: Tensor,

    /// Final latents (before VAE decode)
    pub latents!: LatentTensor!,

    /// Generation metadata
    pub metadata!: GenerationMetadata!,
}

/// Generation metadata
#[derive(Debug, Clone)]
pub struct GenerationMetadata! {
    /// Seed used for generation
    pub seed!: u64,

    /// Actual number of steps performed
    pub steps!: u32,

    /// Time spent in each stage (ms)
    pub timing!: GenerationTiming!,

    /// Guidance scale used
    pub guidance_scale!: f32,
}

/// Timing breakdown for generation
#[derive(Debug, Clone, Default)]
pub struct GenerationTiming! {
    /// Text encoding time
    pub text_encode_ms!: f64,

    /// VAE encoding time (for img2img)
    pub vae_encode_ms!: f64,

    /// Total diffusion loop time
    pub diffusion_ms!: f64,

    /// VAE decoding time
    pub vae_decode_ms!: f64,

    /// Total generation time
    pub total_ms!: f64,
}

// ============================================================================
// Input Types (Untrusted)
// ============================================================================

/// User prompt input (untrusted external data)
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct PromptInput~ {
    /// Main prompt text
    pub prompt~: str,

    /// Negative prompt
    pub negative_prompt~: str?,

    /// Prompt 2 for SDXL/SD3 (second text encoder)
    pub prompt_2~: str?,

    /// Negative prompt 2
    pub negative_prompt_2~: str?,

    /// Prompt 3 for SD3 (T5 encoder)
    pub prompt_3~: str?,
}

impl PromptInput~ {
    /// Create simple prompt
    pub fn new(prompt~: impl Into<str>) -> Self {
        Self {
            prompt~: prompt~.into(),
            negative_prompt~: None,
            prompt_2~: None,
            negative_prompt_2~: None,
            prompt_3~: None,
        }
    }

    /// Add negative prompt
    pub fn with_negative(mut self, negative~: impl Into<str>) -> Self {
        self.negative_prompt~ = Some(negative~.into())
        self
    }

    /// Add second prompt (for SDXL)
    pub fn with_prompt_2(mut self, prompt_2~: impl Into<str>) -> Self {
        self.prompt_2~ = Some(prompt_2~.into())
        self
    }

    /// Get effective second prompt (defaults to first prompt)
    pub fn get_prompt_2(self) -> &str {
        self.prompt_2~.as_deref().unwrap_or(&self.prompt~)
    }

    /// Get effective negative prompt
    pub fn get_negative(self) -> &str {
        self.negative_prompt~.as_deref().unwrap_or("")
    }
}

/// Image input for img2img (untrusted)
#[derive(Debug, Clone)]
pub struct ImageInput~ {
    /// Input image tensor [batch, channels, height, width]
    pub image~: Tensor,

    /// Denoising strength (0.0 = no change, 1.0 = full denoise)
    pub strength~: f32,

    /// Optional mask for inpainting [batch, 1, height, width]
    pub mask~: Tensor?,
}

impl ImageInput~ {
    /// Create from tensor
    pub fn new(image~: Tensor, strength: f32) -> Self {
        Self {
            image~,
            strength~: strength.clamp(0.0, 1.0),
            mask~: None,
        }
    }

    /// Add inpainting mask
    pub fn with_mask(mut self, mask~: Tensor) -> Self {
        self.mask~ = Some(mask~)
        self
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_latent_tensor_creation() {
        let latent! = LatentTensor!::randn(1, 4, 64, 64, &Device::Cpu, DType::F32, Some(42))
        assert_eq!(latent!.batch_size(), 1)
        assert_eq!(latent!.channels!, 4)
        assert_eq!(latent!.height!, 64)
    }

    #[test]
    fn test_guidance_scale() {
        let guidance = GuidanceScale::new(7.5)
        assert_eq!(guidance.cfg_scale, 7.5)
    }

    #[test]
    fn test_timestep() {
        let ts = DiffusionTimestep::from_step(500, 1000, 0.5)
        assert_eq!(ts.step, 500)
        assert!((ts.t - 0.5).abs() < 0.001)
    }

    #[test]
    fn test_architecture_properties() {
        let arch = DiffusionArchitecture::SDXL
        assert_eq!(arch.default_resolution(), (1024, 1024))
        assert_eq!(arch.latent_channels(), 4)
        assert!(!arch.uses_flow_matching())

        let flux = DiffusionArchitecture::Flux
        assert!(flux.uses_flow_matching())
    }

    #[test]
    fn test_prompt_input() {
        let prompt~ = PromptInput~::new("a photo of a cat")
            .with_negative("blurry, low quality")
        assert_eq!(prompt~.prompt~, "a photo of a cat")
        assert_eq!(prompt~.get_negative(), "blurry, low quality")
    }
}
