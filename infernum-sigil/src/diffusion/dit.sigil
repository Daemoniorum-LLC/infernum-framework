/// DiT Architecture - Diffusion Transformer
///
/// Implements transformer-based diffusion architectures:
/// - DiT: Original Diffusion Transformer (Peebles & Xie)
/// - MMDiT: Multi-Modal DiT (SD3, Flux)
///
/// Sigil features:
/// - `computed!` for all intermediate activations
/// - `grad()` for training support (auto-differentiation)
/// - `τ{}` morpheme for layer application
/// - AdaLayerNorm with `computed!` conditioning

use core::tensor::{Tensor, DType, Device}
use core::error::Result
use candle_nn::{Linear, Module, VarBuilder, Embedding}

// ============================================================================
// DiT Configuration
// ============================================================================

/// DiT configuration
#[derive(Debug, Clone)]
pub struct DiTConfig {
    /// Patch size for patchifying latents
    pub patch_size: u32 = 2,

    /// Input channels (latent channels)
    pub in_channels: u32 = 4,

    /// Hidden size (transformer dimension)
    pub hidden_size: u32 = 1152,

    /// Number of transformer layers
    pub num_layers: u32 = 28,

    /// Number of attention heads
    pub num_heads: u32 = 16,

    /// MLP ratio (hidden_dim = hidden_size * mlp_ratio)
    pub mlp_ratio: f32 = 4.0,

    /// Whether to learn sigma (variance)
    pub learn_sigma: bool = true,

    /// Class embedding dimension (for class-conditional)
    pub class_embed_dim?: u32,

    /// Number of classes (for class-conditional)
    pub num_classes?: u32,

    /// Caption/text embedding dimension
    pub caption_embed_dim?: u32,

    /// Dropout probability
    pub dropout: f32 = 0.0,

    /// Layer norm epsilon
    pub layer_norm_eps: f64 = 1e-6,
}

impl DiTConfig {
    /// DiT-XL/2 config (PixArt-α style)
    pub fn dit_xl_2() -> Self {
        Self {
            patch_size: 2,
            in_channels: 4,
            hidden_size: 1152,
            num_layers: 28,
            num_heads: 16,
            mlp_ratio: 4.0,
            learn_sigma: true,
            class_embed_dim: None,
            num_classes: None,
            caption_embed_dim: Some(4096), // T5-XXL
            dropout: 0.0,
            layer_norm_eps: 1e-6,
        }
    }

    /// DiT-L/2 config
    pub fn dit_l_2() -> Self {
        Self {
            hidden_size: 1024,
            num_layers: 24,
            num_heads: 16,
            ..Self::dit_xl_2()
        }
    }

    /// Get MLP hidden dimension
    pub fn mlp_hidden_dim(self) -> u32 {
        (self.hidden_size as f32 * self.mlp_ratio) as u32
    }

    /// Get head dimension
    pub fn head_dim(self) -> u32 {
        self.hidden_size / self.num_heads
    }
}

/// MMDiT configuration (SD3/Flux style)
#[derive(Debug, Clone)]
pub struct MMDiTConfig {
    /// Patch size
    pub patch_size: u32 = 2,

    /// Input channels
    pub in_channels: u32 = 16, // SD3/Flux use 16-channel VAE

    /// Hidden size
    pub hidden_size: u32 = 3072,

    /// Number of transformer layers
    pub num_layers: u32 = 24,

    /// Number of attention heads
    pub num_heads: u32 = 24,

    /// MLP ratio
    pub mlp_ratio: f32 = 4.0,

    /// Text embedding dimension (pooled)
    pub pooled_projection_dim: u32 = 2048,

    /// Context embedding dimension (sequence)
    pub context_embed_dim: u32 = 4096,

    /// Whether to use joint attention
    pub joint_attention: bool = true,

    /// Number of joint attention layers
    pub num_joint_layers?: u32,

    /// QK normalization
    pub qk_norm: bool = true,

    /// Layer norm epsilon
    pub layer_norm_eps: f64 = 1e-6,
}

impl MMDiTConfig {
    /// SD3 Medium config
    pub fn sd3_medium() -> Self {
        Self {
            patch_size: 2,
            in_channels: 16,
            hidden_size: 1536,
            num_layers: 24,
            num_heads: 24,
            mlp_ratio: 4.0,
            pooled_projection_dim: 2048,
            context_embed_dim: 4096,
            joint_attention: true,
            num_joint_layers: Some(24),
            qk_norm: true,
            layer_norm_eps: 1e-6,
        }
    }

    /// Flux.1 config
    pub fn flux_1() -> Self {
        Self {
            patch_size: 2,
            in_channels: 16,
            hidden_size: 3072,
            num_layers: 19, // Single stream layers
            num_heads: 24,
            mlp_ratio: 4.0,
            pooled_projection_dim: 768,
            context_embed_dim: 4096,
            joint_attention: true,
            num_joint_layers: Some(38), // Double stream layers
            qk_norm: true,
            layer_norm_eps: 1e-6,
        }
    }

    /// Get head dimension
    pub fn head_dim(self) -> u32 {
        self.hidden_size / self.num_heads
    }
}

// ============================================================================
// Adaptive Layer Normalization
// ============================================================================

/// Adaptive Layer Normalization (adaLN)
/// Conditions normalization on timestep embedding
pub struct AdaLayerNorm {
    linear: Linear,
    norm: LayerNorm,
}

impl AdaLayerNorm {
    pub fn new(hidden_size: u32, condition_dim: u32, vb: VarBuilder) -> Result<Self> {
        // Project condition to scale and shift
        let linear = Linear::new(condition_dim, hidden_size * 2, vb.pp("linear"))?
        let norm = LayerNorm::new_no_bias(hidden_size, 1e-6, vb.pp("norm"))?

        Ok(Self { linear, norm })
    }

    /// Forward with conditioning
    /// `c!` is the timestep/class conditioning (computed!)
    pub fn forward(self, x: &Tensor, c!: &Tensor) -> Result<Tensor!> {
        let params = self.linear.forward(c!)?
        let (scale, shift) = params.chunk(2, -1)?

        let x = self.norm.forward(x)?

        // Apply adaptive scale and shift
        ((1.0 + scale.unsqueeze(1)?)? * x + shift.unsqueeze(1)?)!
    }
}

/// Adaptive Layer Norm Zero (adaLN-Zero)
/// Used in DiT for better training dynamics
pub struct AdaLayerNormZero {
    linear: Linear,
    norm: LayerNorm,
}

impl AdaLayerNormZero {
    pub fn new(hidden_size: u32, condition_dim: u32, vb: VarBuilder) -> Result<Self> {
        // Project to scale, shift, and gate (6x hidden for two norms + gate)
        let linear = Linear::new(condition_dim, hidden_size * 6, vb.pp("linear"))?
        let norm = LayerNorm::new_no_bias(hidden_size, 1e-6, vb.pp("norm"))?

        Ok(Self { linear, norm })
    }

    /// Forward returning all modulation parameters
    pub fn forward(self, x: &Tensor, c!: &Tensor) -> Result<AdaLNParams!> {
        let params = self.linear.forward(c!)?
        let chunks = params.chunk(6, -1)?

        Ok(AdaLNParams! {
            shift_msa!: chunks[0].clone(),
            scale_msa!: chunks[1].clone(),
            gate_msa!: chunks[2].clone(),
            shift_mlp!: chunks[3].clone(),
            scale_mlp!: chunks[4].clone(),
            gate_mlp!: chunks[5].clone(),
        })
    }

    pub fn norm(self, x: &Tensor) -> Result<Tensor> {
        self.norm.forward(x)
    }
}

/// Parameters from AdaLN-Zero
#[derive(Debug, Clone)]
pub struct AdaLNParams! {
    pub shift_msa!: Tensor,
    pub scale_msa!: Tensor,
    pub gate_msa!: Tensor,
    pub shift_mlp!: Tensor,
    pub scale_mlp!: Tensor,
    pub gate_mlp!: Tensor,
}

impl AdaLNParams! {
    /// Apply modulation to attention output
    pub fn modulate_attn(self, x: &Tensor, normed: &Tensor) -> Tensor! {
        let scaled! = ((1.0 + self.scale_msa!.unsqueeze(1)?)? * normed + self.shift_msa!.unsqueeze(1)?)?
        (x + self.gate_msa!.unsqueeze(1)? * scaled!)!
    }

    /// Apply modulation to MLP output
    pub fn modulate_mlp(self, x: &Tensor, normed: &Tensor) -> Tensor! {
        let scaled! = ((1.0 + self.scale_mlp!.unsqueeze(1)?)? * normed + self.shift_mlp!.unsqueeze(1)?)?
        (x + self.gate_mlp!.unsqueeze(1)? * scaled!)!
    }
}

// ============================================================================
// DiT Attention
// ============================================================================

/// Self-attention for DiT
pub struct DiTAttention {
    qkv: Linear,
    proj: Linear,
    num_heads: u32,
    head_dim: u32,
    scale: f32,
    qk_norm: bool,
    q_norm?: RMSNorm,
    k_norm?: RMSNorm,
}

impl DiTAttention {
    pub fn new(hidden_size: u32, num_heads: u32, qk_norm: bool, vb: VarBuilder) -> Result<Self> {
        let head_dim = hidden_size / num_heads
        let qkv = Linear::new(hidden_size, hidden_size * 3, vb.pp("qkv"))?
        let proj = Linear::new(hidden_size, hidden_size, vb.pp("proj"))?

        let (q_norm, k_norm) = if qk_norm {
            (
                Some(RMSNorm::new(head_dim, 1e-6, vb.pp("q_norm"))?),
                Some(RMSNorm::new(head_dim, 1e-6, vb.pp("k_norm"))?),
            )
        } else {
            (None, None)
        }

        let scale = (head_dim as f32).sqrt().recip()

        Ok(Self { qkv, proj, num_heads, head_dim, scale, qk_norm, q_norm, k_norm })
    }

    pub fn forward(self, x: &Tensor) -> Result<Tensor!> {
        let (batch, seq, _) = x.dims3()?

        // Compute Q, K, V
        let qkv = self.qkv.forward(x)?
        let qkv = qkv.reshape([batch, seq, 3, self.num_heads as usize, self.head_dim as usize])?
        let qkv = qkv.permute([2, 0, 3, 1, 4])? // [3, batch, heads, seq, head_dim]

        let q = qkv.get(0)?
        let k = qkv.get(1)?
        let v = qkv.get(2)?

        // Apply QK normalization if enabled
        let (q, k) = if self.qk_norm {
            let q = self.q_norm.as_ref().unwrap().forward(&q)?
            let k = self.k_norm.as_ref().unwrap().forward(&k)?
            (q, k)
        } else {
            (q, k)
        }

        // Attention
        let attn = (q.matmul(&k.transpose(-1, -2)?)? * self.scale)?
        let attn = attn.softmax(-1)?
        let out = attn.matmul(&v)?

        // Reshape back
        let out = out.transpose(1, 2)?.reshape([batch, seq, self.num_heads as usize * self.head_dim as usize])?

        self.proj.forward(&out)!
    }
}

// ============================================================================
// Joint Attention (MMDiT)
// ============================================================================

/// Joint attention for image and text tokens
pub struct JointAttention {
    /// Query projection for image
    to_q: Linear,
    /// Key projection for image
    to_k: Linear,
    /// Value projection for image
    to_v: Linear,

    /// Query projection for text
    to_q_text: Linear,
    /// Key projection for text
    to_k_text: Linear,
    /// Value projection for text
    to_v_text: Linear,

    /// Output projection for image
    to_out: Linear,
    /// Output projection for text
    to_out_text: Linear,

    num_heads: u32,
    head_dim: u32,
    scale: f32,

    /// QK normalization
    q_norm?: RMSNorm,
    k_norm?: RMSNorm,
}

impl JointAttention {
    pub fn new(
        hidden_size: u32,
        context_dim: u32,
        num_heads: u32,
        qk_norm: bool,
        vb: VarBuilder,
    ) -> Result<Self> {
        let head_dim = hidden_size / num_heads

        // Image projections
        let to_q = Linear::new(hidden_size, hidden_size, vb.pp("to_q"))?
        let to_k = Linear::new(hidden_size, hidden_size, vb.pp("to_k"))?
        let to_v = Linear::new(hidden_size, hidden_size, vb.pp("to_v"))?
        let to_out = Linear::new(hidden_size, hidden_size, vb.pp("to_out.0"))?

        // Text projections
        let to_q_text = Linear::new(context_dim, hidden_size, vb.pp("add_q_proj"))?
        let to_k_text = Linear::new(context_dim, hidden_size, vb.pp("add_k_proj"))?
        let to_v_text = Linear::new(context_dim, hidden_size, vb.pp("add_v_proj"))?
        let to_out_text = Linear::new(hidden_size, context_dim, vb.pp("to_add_out"))?

        let (q_norm, k_norm) = if qk_norm {
            (
                Some(RMSNorm::new(head_dim, 1e-6, vb.pp("norm_q"))?),
                Some(RMSNorm::new(head_dim, 1e-6, vb.pp("norm_k"))?),
            )
        } else {
            (None, None)
        }

        let scale = (head_dim as f32).sqrt().recip()

        Ok(Self {
            to_q, to_k, to_v, to_q_text, to_k_text, to_v_text,
            to_out, to_out_text, num_heads, head_dim, scale,
            q_norm, k_norm,
        })
    }

    /// Forward with joint attention over image and text
    /// `context~` is text embeddings (untrusted user input)
    pub fn forward(
        self,
        hidden_states: &Tensor,
        context~: &Tensor,
    ) -> Result<(Tensor!, Tensor!)> {
        let (batch, seq_img, _) = hidden_states.dims3()?
        let (_, seq_txt, _) = context~.dims3()?

        // Project image tokens
        let q_img = self.to_q.forward(hidden_states)?
        let k_img = self.to_k.forward(hidden_states)?
        let v_img = self.to_v.forward(hidden_states)?

        // Project text tokens
        let q_txt = self.to_q_text.forward(context~)?
        let k_txt = self.to_k_text.forward(context~)?
        let v_txt = self.to_v_text.forward(context~)?

        // Concatenate for joint attention
        let q = Tensor::cat(&[q_img, q_txt], 1)?
        let k = Tensor::cat(&[k_img, k_txt], 1)?
        let v = Tensor::cat(&[v_img, v_txt], 1)?

        let total_seq = seq_img + seq_txt

        // Reshape to multi-head
        let q = q.reshape([batch, total_seq, self.num_heads as usize, self.head_dim as usize])?
            .transpose(1, 2)?
        let k = k.reshape([batch, total_seq, self.num_heads as usize, self.head_dim as usize])?
            .transpose(1, 2)?
        let v = v.reshape([batch, total_seq, self.num_heads as usize, self.head_dim as usize])?
            .transpose(1, 2)?

        // Apply QK norm if enabled
        let (q, k) = if let (Some(qn), Some(kn)) = (&self.q_norm, &self.k_norm) {
            (qn.forward(&q)?, kn.forward(&k)?)
        } else {
            (q, k)
        }

        // Attention
        let attn = (q.matmul(&k.transpose(-1, -2)?)? * self.scale)?
        let attn = attn.softmax(-1)?
        let out = attn.matmul(&v)?

        // Reshape back
        let out = out.transpose(1, 2)?.reshape([batch, total_seq, self.num_heads as usize * self.head_dim as usize])?

        // Split back into image and text
        let out_img = out.narrow(1, 0, seq_img)?
        let out_txt = out.narrow(1, seq_img, seq_txt)?

        // Project outputs
        let out_img! = self.to_out.forward(&out_img)?
        let out_txt! = self.to_out_text.forward(&out_txt)?

        Ok((out_img!, out_txt!))
    }
}

// ============================================================================
// DiT MLP
// ============================================================================

/// Gated MLP for DiT
pub struct DiTMLP {
    fc1: Linear,
    fc2: Linear,
    act: GELUApprox,
}

impl DiTMLP {
    pub fn new(hidden_size: u32, mlp_ratio: f32, vb: VarBuilder) -> Result<Self> {
        let mlp_hidden = (hidden_size as f32 * mlp_ratio) as u32

        let fc1 = Linear::new(hidden_size, mlp_hidden, vb.pp("fc1"))?
        let fc2 = Linear::new(mlp_hidden, hidden_size, vb.pp("fc2"))?

        Ok(Self { fc1, fc2, act: GELUApprox })
    }
}

impl Module for DiTMLP {
    fn forward(self, x: &Tensor) -> Result<Tensor> {
        let x = self.fc1.forward(x)?
        let x = self.act.forward(&x)?
        self.fc2.forward(&x)
    }
}

/// Gated MLP with SwiGLU activation
pub struct GatedMLP {
    proj_in: Linear,
    proj_out: Linear,
}

impl GatedMLP {
    pub fn new(hidden_size: u32, mlp_ratio: f32, vb: VarBuilder) -> Result<Self> {
        let mlp_hidden = (hidden_size as f32 * mlp_ratio) as u32

        // Project to 2x for gating
        let proj_in = Linear::new(hidden_size, mlp_hidden * 2, vb.pp("proj_in"))?
        let proj_out = Linear::new(mlp_hidden, hidden_size, vb.pp("proj_out"))?

        Ok(Self { proj_in, proj_out })
    }
}

impl Module for GatedMLP {
    fn forward(self, x: &Tensor) -> Result<Tensor> {
        let x = self.proj_in.forward(x)?
        let (gate, x) = x.chunk(2, -1)?
        let x = (gate.silu()? * x)?
        self.proj_out.forward(&x)
    }
}

// ============================================================================
// DiT Block
// ============================================================================

/// Single DiT block
pub struct DiTBlock {
    norm1: AdaLayerNormZero,
    attn: DiTAttention,
    norm2: LayerNorm,
    mlp: DiTMLP,
}

impl DiTBlock {
    pub fn new(config: &DiTConfig, vb: VarBuilder) -> Result<Self> {
        let norm1 = AdaLayerNormZero::new(
            config.hidden_size,
            config.hidden_size, // condition same dim
            vb.pp("norm1")
        )?

        let attn = DiTAttention::new(
            config.hidden_size,
            config.num_heads,
            false, // DiT doesn't use QK norm
            vb.pp("attn")
        )?

        let norm2 = LayerNorm::new_no_bias(config.hidden_size, config.layer_norm_eps, vb.pp("norm2"))?
        let mlp = DiTMLP::new(config.hidden_size, config.mlp_ratio, vb.pp("mlp"))?

        Ok(Self { norm1, attn, norm2, mlp })
    }

    /// Forward with timestep conditioning
    pub fn forward(self, x: &Tensor, c!: &Tensor) -> Result<Tensor!> {
        // Get modulation parameters
        let params! = self.norm1.forward(x, c!)?

        // Self-attention with modulation
        let normed = self.norm1.norm(x)?
        let attn_out = self.attn.forward(&normed)?
        let x = params!.modulate_attn(x, &attn_out)

        // MLP with modulation
        let normed = self.norm2.forward(&x)?
        let mlp_out = self.mlp.forward(&normed)?
        params!.modulate_mlp(&x, &mlp_out)
    }
}

// ============================================================================
// MMDiT Block
// ============================================================================

/// MMDiT block with joint attention
pub struct MMDiTBlock {
    norm1_img: AdaLayerNorm,
    norm1_txt: LayerNorm,
    attn: JointAttention,
    norm2_img: LayerNorm,
    norm2_txt: LayerNorm,
    mlp_img: GatedMLP,
    mlp_txt: GatedMLP,
}

impl MMDiTBlock {
    pub fn new(config: &MMDiTConfig, vb: VarBuilder) -> Result<Self> {
        let norm1_img = AdaLayerNorm::new(
            config.hidden_size,
            config.hidden_size,
            vb.pp("norm1")
        )?
        let norm1_txt = LayerNorm::new_no_bias(
            config.context_embed_dim,
            config.layer_norm_eps,
            vb.pp("norm1_context")
        )?

        let attn = JointAttention::new(
            config.hidden_size,
            config.context_embed_dim,
            config.num_heads,
            config.qk_norm,
            vb.pp("attn")
        )?

        let norm2_img = LayerNorm::new_no_bias(config.hidden_size, config.layer_norm_eps, vb.pp("norm2"))?
        let norm2_txt = LayerNorm::new_no_bias(config.context_embed_dim, config.layer_norm_eps, vb.pp("norm2_context"))?

        let mlp_img = GatedMLP::new(config.hidden_size, config.mlp_ratio, vb.pp("ff"))?
        let mlp_txt = GatedMLP::new(config.context_embed_dim, config.mlp_ratio, vb.pp("ff_context"))?

        Ok(Self {
            norm1_img, norm1_txt, attn,
            norm2_img, norm2_txt, mlp_img, mlp_txt,
        })
    }

    /// Forward with image and text streams
    pub fn forward(
        self,
        hidden_states: &Tensor,
        context~: &Tensor,
        temb!: &Tensor,
    ) -> Result<(Tensor!, Tensor!)> {
        // Normalize
        let norm_hidden = self.norm1_img.forward(hidden_states, temb!)?
        let norm_context = self.norm1_txt.forward(context~)?

        // Joint attention
        let (attn_img!, attn_txt!) = self.attn.forward(&norm_hidden, &norm_context)?

        // Residual
        let hidden_states = (hidden_states + attn_img!)?
        let context = (context~ + attn_txt!)?

        // MLP
        let norm_hidden = self.norm2_img.forward(&hidden_states)?
        let norm_context = self.norm2_txt.forward(&context)?

        let hidden_states! = (hidden_states + self.mlp_img.forward(&norm_hidden)?)?
        let context! = (context + self.mlp_txt.forward(&norm_context)?)?

        Ok((hidden_states!, context!))
    }
}

// ============================================================================
// Patch Embedding
// ============================================================================

/// Patch embedding for DiT
pub struct PatchEmbed {
    proj: Linear,
    patch_size: u32,
    in_channels: u32,
    hidden_size: u32,
}

impl PatchEmbed {
    pub fn new(patch_size: u32, in_channels: u32, hidden_size: u32, vb: VarBuilder) -> Result<Self> {
        let proj = Linear::new(
            in_channels * patch_size * patch_size,
            hidden_size,
            vb.pp("proj")
        )?

        Ok(Self { proj, patch_size, in_channels, hidden_size })
    }

    /// Patchify and embed latent
    pub fn forward(self, x: &Tensor) -> Result<Tensor!> {
        let (batch, channels, height, width) = x.dims4()?
        let p = self.patch_size as usize

        // Reshape to patches: [B, C, H, W] -> [B, H/p * W/p, C*p*p]
        let x = x.reshape([batch, channels, height / p, p, width / p, p])?
        let x = x.permute([0, 2, 4, 1, 3, 5])? // [B, H/p, W/p, C, p, p]
        let x = x.reshape([batch, (height / p) * (width / p), channels * p * p])?

        self.proj.forward(&x)!
    }

    /// Number of patches for given resolution
    pub fn num_patches(self, height: u32, width: u32) -> u32 {
        (height / self.patch_size) * (width / self.patch_size)
    }
}

/// Unpatchify back to image
pub fn unpatchify(
    x: &Tensor,
    height: u32,
    width: u32,
    patch_size: u32,
    out_channels: u32,
) -> Result<Tensor!> {
    let (batch, num_patches, _) = x.dims3()?
    let p = patch_size as usize
    let h = height as usize / p
    let w = width as usize / p
    let c = out_channels as usize

    // [B, H/p * W/p, C*p*p] -> [B, C, H, W]
    let x = x.reshape([batch, h, w, c, p, p])?
    let x = x.permute([0, 3, 1, 4, 2, 5])? // [B, C, H/p, p, W/p, p]
    x.reshape([batch, c, h * p, w * p])!
}

// ============================================================================
// Full DiT Model
// ============================================================================

/// Complete DiT model
pub struct DiT {
    config: DiTConfig,
    patch_embed: PatchEmbed,
    pos_embed: Tensor,
    time_embed: TimestepMLPEmbedding,
    caption_embed?: CaptionProjection,
    blocks: [DiTBlock],
    final_layer: FinalLayer,
}

impl DiT {
    pub fn new(config: DiTConfig, vb: VarBuilder) -> Result<Self> {
        let patch_embed = PatchEmbed::new(
            config.patch_size,
            config.in_channels,
            config.hidden_size,
            vb.pp("x_embedder")
        )?

        // Positional embedding (learnable)
        // Assume max resolution 256x256 / patch_size
        let max_patches = (256 / config.patch_size) * (256 / config.patch_size)
        let pos_embed = vb.get([1, max_patches as usize, config.hidden_size as usize], "pos_embed")?

        // Time embedding
        let time_embed = TimestepMLPEmbedding::new(
            256, // frequency dim
            config.hidden_size,
            vb.pp("t_embedder")
        )?

        // Caption embedding (optional)
        let caption_embed = if let Some(caption_dim) = config.caption_embed_dim {
            Some(CaptionProjection::new(caption_dim, config.hidden_size, vb.pp("y_embedder"))?)
        } else {
            None
        }

        // Transformer blocks
        let blocks = (0..config.num_layers)
            τ{ |i| DiTBlock::new(&config, vb.pp(format!("blocks.{}", i)))? }
            |collect::<Result<[_]>>?

        // Final layer
        let final_layer = FinalLayer::new(
            config.hidden_size,
            config.patch_size,
            config.in_channels * (if config.learn_sigma { 2 } else { 1 }),
            vb.pp("final_layer")
        )?

        Ok(Self {
            config, patch_embed, pos_embed, time_embed,
            caption_embed, blocks, final_layer,
        })
    }

    /// Forward pass
    pub fn forward(
        self,
        x: &Tensor,
        t: &Tensor,
        y~?: &Tensor, // Optional caption embedding
    ) -> Result<NoisePrediction!> {
        let (_, _, height, width) = x.dims4()?

        // Embed patches
        let x = self.patch_embed.forward(x)?
        let num_patches = x.dim(1)?

        // Add positional embedding
        let pos_embed = self.pos_embed.narrow(1, 0, num_patches)?
        let x = (x + pos_embed)?

        // Time embedding
        let t_emb = self.time_embed.forward(t)?

        // Add caption embedding if provided
        let c! = if let (Some(proj), Some(y~)) = (&self.caption_embed, y~) {
            let y_emb = proj.forward(y~)?
            (t_emb + y_emb)?
        } else {
            t_emb
        }

        // Apply transformer blocks
        let mut x = x
        for block in &self.blocks {
            x = block.forward(&x, &c!)?
        }

        // Final layer
        let x = self.final_layer.forward(&x, &c!)?

        // Unpatchify
        let out! = unpatchify(
            &x,
            height as u32,
            width as u32,
            self.config.patch_size,
            self.config.in_channels * (if self.config.learn_sigma { 2 } else { 1 }),
        )?

        // Split into noise and variance if learning sigma
        if self.config.learn_sigma {
            let (noise!, variance!) = out!.chunk(2, 1)?
            Ok(NoisePrediction!::with_variance(noise!, variance!))
        } else {
            Ok(NoisePrediction!::noise_only(out!))
        }
    }
}

// ============================================================================
// MMDiT Model
// ============================================================================

/// Complete MMDiT model (SD3/Flux style)
pub struct MMDiT {
    config: MMDiTConfig,
    patch_embed: PatchEmbed,
    pos_embed: RotaryEmbedding2D,
    time_embed: TimestepMLPEmbedding,
    context_embed: Linear,
    pooled_embed: Linear,
    joint_blocks: [MMDiTBlock],
    single_blocks?: [DiTBlock],
    final_layer: FinalLayer,
}

impl MMDiT {
    pub fn new(config: MMDiTConfig, vb: VarBuilder) -> Result<Self> {
        let patch_embed = PatchEmbed::new(
            config.patch_size,
            config.in_channels,
            config.hidden_size,
            vb.pp("x_embedder")
        )?

        // 2D rotary position embedding
        let pos_embed = RotaryEmbedding2D::new(config.head_dim(), 10000.0)?

        // Embeddings
        let time_embed = TimestepMLPEmbedding::new(256, config.hidden_size, vb.pp("time_in"))?
        let context_embed = Linear::new(config.context_embed_dim, config.hidden_size, vb.pp("context_embedder"))?
        let pooled_embed = Linear::new(config.pooled_projection_dim, config.hidden_size, vb.pp("y_embedder"))?

        // Joint attention blocks
        let num_joint = config.num_joint_layers.unwrap_or(config.num_layers)
        let joint_blocks = (0..num_joint)
            τ{ |i| MMDiTBlock::new(&config, vb.pp(format!("joint_blocks.{}", i)))? }
            |collect::<Result<[_]>>?

        // Single stream blocks (Flux style)
        let single_blocks = if config.num_joint_layers.is_some() {
            let dit_config = DiTConfig {
                hidden_size: config.hidden_size,
                num_heads: config.num_heads,
                mlp_ratio: config.mlp_ratio,
                ..Default::default()
            }
            Some((0..config.num_layers)
                τ{ |i| DiTBlock::new(&dit_config, vb.pp(format!("single_blocks.{}", i)))? }
                |collect::<Result<[_]>>?)
        } else {
            None
        }

        let final_layer = FinalLayer::new(
            config.hidden_size,
            config.patch_size,
            config.in_channels,
            vb.pp("final_layer")
        )?

        Ok(Self {
            config, patch_embed, pos_embed, time_embed,
            context_embed, pooled_embed, joint_blocks,
            single_blocks, final_layer,
        })
    }

    /// Forward pass
    /// - `context~`: Text sequence embeddings (untrusted)
    /// - `pooled~`: Pooled text embeddings (untrusted)
    pub fn forward(
        self,
        x: &Tensor,
        t: &Tensor,
        context~: &Tensor,
        pooled~: &Tensor,
    ) -> Result<NoisePrediction!> {
        let (_, _, height, width) = x.dims4()?

        // Embed patches
        let x = self.patch_embed.forward(x)?

        // Add positional embedding (RoPE applied in attention)
        // ...

        // Embed timestep and pooled text
        let t_emb = self.time_embed.forward(t)?
        let y_emb = self.pooled_embed.forward(pooled~)?
        let temb! = (t_emb + y_emb)?

        // Embed context
        let context = self.context_embed.forward(context~)?

        // Joint attention blocks
        let (mut x, mut context) = (x, context)
        for block in &self.joint_blocks {
            let (x_new!, ctx_new!) = block.forward(&x, &context, &temb!)?
            x = x_new!
            context = ctx_new!
        }

        // Single stream blocks (Flux style)
        if let Some(single_blocks) = &self.single_blocks {
            for block in single_blocks {
                x = block.forward(&x, &temb!)?
            }
        }

        // Final layer
        let x = self.final_layer.forward(&x, &temb!)?

        // Unpatchify
        let out! = unpatchify(
            &x,
            height as u32,
            width as u32,
            self.config.patch_size,
            self.config.in_channels,
        )?

        Ok(NoisePrediction!::noise_only(out!))
    }
}

// ============================================================================
// Helper Components
// ============================================================================

/// Timestep MLP embedding
pub struct TimestepMLPEmbedding {
    mlp: [Linear; 2],
    frequency_dim: u32,
}

impl TimestepMLPEmbedding {
    pub fn new(frequency_dim: u32, hidden_size: u32, vb: VarBuilder) -> Result<Self> {
        let mlp = [
            Linear::new(frequency_dim, hidden_size, vb.pp("mlp.0"))?,
            Linear::new(hidden_size, hidden_size, vb.pp("mlp.2"))?,
        ]
        Ok(Self { mlp, frequency_dim })
    }
}

impl Module for TimestepMLPEmbedding {
    fn forward(self, t: &Tensor) -> Result<Tensor> {
        // Get sinusoidal embedding
        let emb = get_timestep_embedding_dit(t, self.frequency_dim)?
        let x = self.mlp[0].forward(&emb)?
        let x = x.silu()?
        self.mlp[1].forward(&x)
    }
}

/// Get timestep embedding (DiT style)
fn get_timestep_embedding_dit(t: &Tensor, dim: u32) -> Result<Tensor!> {
    let half_dim = dim / 2
    let freqs = (0..half_dim as usize)
        τ{ |i| (-((i as f64) / half_dim as f64) * 10000.0f64.ln()).exp() as f32 }
        |collect::<[f32]>

    let freqs = Tensor::new(freqs.as_slice(), t.device())?
    let t = t.unsqueeze(1)?
    let args = t.broadcast_mul(&freqs.unsqueeze(0)?)?

    Tensor::cat(&[args.cos()?, args.sin()?], 1)!
}

/// Caption projection
pub struct CaptionProjection {
    linear: Linear,
}

impl CaptionProjection {
    pub fn new(caption_dim: u32, hidden_size: u32, vb: VarBuilder) -> Result<Self> {
        let linear = Linear::new(caption_dim, hidden_size, vb.pp("linear"))?
        Ok(Self { linear })
    }
}

impl Module for CaptionProjection {
    fn forward(self, x: &Tensor) -> Result<Tensor> {
        self.linear.forward(x)
    }
}

/// Final layer with adaLN
pub struct FinalLayer {
    norm: AdaLayerNorm,
    linear: Linear,
}

impl FinalLayer {
    pub fn new(hidden_size: u32, patch_size: u32, out_channels: u32, vb: VarBuilder) -> Result<Self> {
        let norm = AdaLayerNorm::new(hidden_size, hidden_size, vb.pp("norm_final"))?
        let linear = Linear::new(
            hidden_size,
            patch_size * patch_size * out_channels,
            vb.pp("linear")
        )?
        Ok(Self { norm, linear })
    }

    pub fn forward(self, x: &Tensor, c!: &Tensor) -> Result<Tensor!> {
        let x = self.norm.forward(x, c!)?
        self.linear.forward(&x)!
    }
}

/// RMS normalization
pub struct RMSNorm {
    weight: Tensor,
    eps: f64,
}

impl RMSNorm {
    pub fn new(dim: u32, eps: f64, vb: VarBuilder) -> Result<Self> {
        let weight = vb.get(dim as usize, "weight")?
        Ok(Self { weight, eps })
    }
}

impl Module for RMSNorm {
    fn forward(self, x: &Tensor) -> Result<Tensor> {
        let variance = x.sqr()?.mean_keepdim(-1)?
        let x = x.broadcast_div(&(variance + self.eps)?.sqrt()?)?
        x.broadcast_mul(&self.weight)
    }
}

/// Layer normalization without bias
pub struct LayerNorm {
    weight: Tensor,
    bias?: Tensor,
    eps: f64,
}

impl LayerNorm {
    pub fn new_no_bias(dim: u32, eps: f64, vb: VarBuilder) -> Result<Self> {
        let weight = vb.get(dim as usize, "weight")?
        Ok(Self { weight, bias: None, eps })
    }

    pub fn new(dim: u32, eps: f64, vb: VarBuilder) -> Result<Self> {
        let weight = vb.get(dim as usize, "weight")?
        let bias = vb.get(dim as usize, "bias")?
        Ok(Self { weight, bias: Some(bias), eps })
    }
}

impl Module for LayerNorm {
    fn forward(self, x: &Tensor) -> Result<Tensor> {
        if let Some(bias) = &self.bias {
            x.layer_norm(&self.weight, bias, self.eps)
        } else {
            // RMS-style without bias
            let mean = x.mean_keepdim(-1)?
            let variance = (x - &mean)?.sqr()?.mean_keepdim(-1)?
            let x = (x - &mean)?.broadcast_div(&(variance + self.eps)?.sqrt()?)?
            x.broadcast_mul(&self.weight)
        }
    }
}

/// 2D Rotary Position Embedding
pub struct RotaryEmbedding2D {
    inv_freq: Tensor,
}

impl RotaryEmbedding2D {
    pub fn new(dim: u32, base: f32) -> Result<Self> {
        let inv_freq = (0..dim as usize / 2)
            τ{ |i| 1.0 / base.powf(2.0 * i as f32 / dim as f32) }
            |collect::<[f32]>
        let inv_freq = Tensor::new(inv_freq.as_slice(), &Device::Cpu)?
        Ok(Self { inv_freq })
    }
}

/// GELU approximation
pub struct GELUApprox;

impl Module for GELUApprox {
    fn forward(self, x: &Tensor) -> Result<Tensor> {
        x.gelu()
    }
}

