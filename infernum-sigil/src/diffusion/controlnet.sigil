// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_controlnet_config() {
        let config = ControlNetConfig::default()
        assert_eq!(config.conditioning_scale, 1.0)
        assert!(!config.guess_mode)
    }

    #[test]
    fn test_should_apply() {
        let config = ControlNetConfig {
            control_guidance_start: 0.2,
            control_guidance_end: 0.8,
            ..ControlNetConfig::default()
        }
        assert!(!config.should_apply(0.1))
        assert!(config.should_apply(0.5))
        assert!(!config.should_apply(0.9))
    }

    #[test]
    fn test_ip_adapter_config() {
        let config = IPAdapterConfig::plus()
        assert_eq!(config.num_tokens, 16)
    }
}
