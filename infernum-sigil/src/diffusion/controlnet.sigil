/// ControlNet & Conditioning Module
///
/// This module provides ControlNet architecture and various conditioning
/// methods for fine-grained control over image generation.
///
/// Supports: Canny, Depth, Pose, Segmentation, Tile, IP-Adapter, Reference

use crate::core::error::{InfernumError, Result}
use crate::abaddon::backend::{Tensor, TensorOps, ComputeBackend}
use crate::diffusion::unet::{UNet2D, UNet2DConfig, DownBlock, UpBlock, CrossAttnDownBlock}

// ============================================================================
// ControlNet Condition Types
// ============================================================================

/// Types of conditions ControlNet can accept
pub enum ControlNetCondition {
    /// Edge detection (Canny)
    Canny,
    /// Depth estimation
    Depth,
    /// Human pose estimation (OpenPose)
    Pose,
    /// Semantic segmentation
    Segmentation,
    /// Scribble/sketch
    Scribble,
    /// Tile-based (for upscaling)
    Tile,
    /// Soft edge (HED/PiDiNet)
    SoftEdge,
    /// Normal map
    Normal,
    /// Lineart
    Lineart,
    /// M-LSD lines
    MLSD,
    /// Shuffle (style transfer)
    Shuffle,
    /// Inpaint condition
    Inpaint,
    /// IP-Adapter (image prompt)
    IPAdapter,
    /// Reference-only
    Reference,
    /// InstantID (face)
    InstantID,
}

// ============================================================================
// ControlNet Configuration
// ============================================================================

/// Configuration for ControlNet
pub struct ControlNetConfig {
    /// Type of condition
    pub condition_type: ControlNetCondition,
    /// Conditioning scale (strength)
    pub conditioning_scale: f32,
    /// Guess mode (no prompt required)
    pub guess_mode: bool,
    /// Control guidance start (0.0-1.0 of steps)
    pub control_guidance_start: f32,
    /// Control guidance end (0.0-1.0 of steps)
    pub control_guidance_end: f32,
    /// Global pool conditioning (for some models)
    pub global_pool: bool,
}

impl ControlNetConfig {
    /// Default configuration
    pub fn default() -> Self {
        Self {
            condition_type: ControlNetCondition::Canny,
            conditioning_scale: 1.0,
            guess_mode: false,
            control_guidance_start: 0.0,
            control_guidance_end: 1.0,
            global_pool: false,
        }
    }

    /// Soft control (lower strength)
    pub fn soft(condition_type: ControlNetCondition) -> Self {
        Self {
            condition_type,
            conditioning_scale: 0.5,
            guess_mode: false,
            control_guidance_start: 0.0,
            control_guidance_end: 1.0,
            global_pool: false,
        }
    }

    /// Strong control
    pub fn strong(condition_type: ControlNetCondition) -> Self {
        Self {
            condition_type,
            conditioning_scale: 1.5,
            guess_mode: false,
            control_guidance_start: 0.0,
            control_guidance_end: 1.0,
            global_pool: false,
        }
    }

    /// Check if control should be applied at given step ratio
    pub fn should_apply(&self, step_ratio: f32) -> bool {
        step_ratio >= self.control_guidance_start && step_ratio <= self.control_guidance_end
    }
}

// ============================================================================
// ControlNet Architecture
// ============================================================================

/// ControlNet model architecture
pub struct ControlNet<B: ComputeBackend> {
    /// Configuration
    config: ControlNetConfig,

    /// Input convolution (condition -> latent space)
    controlnet_cond_embedding: ControlNetConditioningEmbedding<B>,

    /// Time embedding
    time_embed: TimeEmbedding<B>,

    /// Down blocks (mirrors U-Net encoder)
    down_blocks: Vec<ControlNetDownBlock<B>>,

    /// Mid block
    mid_block: ControlNetMidBlock<B>,

    /// Zero convolutions for down block outputs
    controlnet_down_blocks: Vec<ZeroConv<B>>,

    /// Zero convolution for mid block output
    controlnet_mid_block: ZeroConv<B>,

    /// Backend
    backend: B,
}

impl<B: ComputeBackend> ControlNet<B> {
    /// Create ControlNet from configuration
    pub fn new(config: ControlNetConfig, unet_config: &UNet2DConfig, backend: B) -> Result<Self> {
        // Condition embedding (3 -> 320 for SD)
        let controlnet_cond_embedding = ControlNetConditioningEmbedding::new(
            3,  // RGB condition image
            unet_config.block_out_channels[0],
            backend.clone(),
        )?

        // Time embedding (same as U-Net)
        let time_embed = TimeEmbedding::new(
            unet_config.block_out_channels[0],
            unet_config.block_out_channels[0] * 4,
            backend.clone(),
        )?

        // Build down blocks mirroring U-Net
        let mut down_blocks = Vec::new()
        let mut controlnet_down_blocks = Vec::new()

        let mut in_channels = unet_config.block_out_channels[0]
        for (i, &out_channels) in unet_config.block_out_channels.iter().enumerate() {
            let is_last = i == unet_config.block_out_channels.len() - 1

            let block = ControlNetDownBlock::new(
                in_channels,
                out_channels,
                unet_config.layers_per_block,
                !is_last,  // add downsampler except for last
                unet_config.cross_attention_dim,
                backend.clone(),
            )?
            down_blocks.push(block)

            // Zero conv for each output
            for _ in 0..unet_config.layers_per_block {
                controlnet_down_blocks.push(ZeroConv::new(out_channels, out_channels, backend.clone())?)
            }
            if !is_last {
                controlnet_down_blocks.push(ZeroConv::new(out_channels, out_channels, backend.clone())?)
            }

            in_channels = out_channels
        }

        // Mid block
        let mid_block = ControlNetMidBlock::new(
            in_channels,
            unet_config.cross_attention_dim,
            backend.clone(),
        )?
        let controlnet_mid_block = ZeroConv::new(in_channels, in_channels, backend.clone())?

        Ok(Self {
            config,
            controlnet_cond_embedding,
            time_embed,
            down_blocks,
            mid_block,
            controlnet_down_blocks,
            controlnet_mid_block,
            backend,
        })
    }

    /// Forward pass - returns residuals to add to U-Net
    pub fn forward(
        &self,
        sample~: &Tensor<B>,        // Noisy latents
        timestep: u32,
        encoder_hidden_states~: &Tensor<B>,  // Text embeddings
        controlnet_cond~: &Tensor<B>,        // Condition image
    ) -> Result<ControlNetOutput<B>!> {
        // Embed condition image
        let conditioning! = self.controlnet_cond_embedding.forward(controlnet_cond~)?

        // Add to sample
        let sample! = sample~ + conditioning

        // Time embedding
        let t_emb! = self.time_embed.forward(timestep)?

        // Down blocks
        let mut down_block_res_samples: Vec<Tensor<B>> = Vec::new()
        let mut sample = sample

        let mut zero_idx = 0
        for block in self.down_blocks.iter() {
            let (new_sample, res_samples) = block.forward(&sample, &t_emb, encoder_hidden_states~)?

            for res in res_samples {
                let controlled! = self.controlnet_down_blocks[zero_idx].forward(&res)?
                down_block_res_samples.push(controlled * self.config.conditioning_scale)
                zero_idx += 1
            }

            sample = new_sample
        }

        // Mid block
        let mid_out! = self.mid_block.forward(&sample, &t_emb, encoder_hidden_states~)?
        let mid_block_res_sample! = self.controlnet_mid_block.forward(&mid_out)?
            * self.config.conditioning_scale

        Ok(ControlNetOutput {
            down_block_res_samples,
            mid_block_res_sample,
        })
    }

    /// Load from checkpoint
    pub fn load(path: str~, config: ControlNetConfig, backend: B) -> Result<Self> {
        let state_dict = safetensors::load(path~)?
        let unet_config = infer_config_from_state(&state_dict)?
        let mut model = Self::new(config, &unet_config, backend)?
        model.load_state_dict(state_dict)?
        Ok(model)
    }

    /// Load state dictionary
    pub fn load_state_dict(&mut self, state_dict: Map<str, Tensor<B>>) -> Result<()> {
        // Load each component
        self.controlnet_cond_embedding.load_state_dict(&state_dict, "controlnet_cond_embedding")?
        self.time_embed.load_state_dict(&state_dict, "time_embedding")?

        for (i, block) in self.down_blocks.iter_mut().enumerate() {
            block.load_state_dict(&state_dict, &format!("down_blocks.{}", i))?
        }

        self.mid_block.load_state_dict(&state_dict, "mid_block")?

        for (i, zero_conv) in self.controlnet_down_blocks.iter_mut().enumerate() {
            zero_conv.load_state_dict(&state_dict, &format!("controlnet_down_blocks.{}", i))?
        }

        self.controlnet_mid_block.load_state_dict(&state_dict, "controlnet_mid_block")?

        Ok(())
    }
}

/// ControlNet output (residuals)
pub struct ControlNetOutput<B: ComputeBackend> {
    /// Residuals for each down block
    pub down_block_res_samples: Vec<Tensor<B>>,
    /// Residual for mid block
    pub mid_block_res_sample: Tensor<B>,
}

// ============================================================================
// ControlNet Building Blocks
// ============================================================================

/// Zero-initialized convolution (for stable training)
pub struct ZeroConv<B: ComputeBackend> {
    conv: Conv2d<B>,
}

impl<B: ComputeBackend> ZeroConv<B> {
    pub fn new(in_channels: u32, out_channels: u32, backend: B) -> Result<Self> {
        let mut conv = Conv2d::new(in_channels, out_channels, 1, 1, 0, backend)?
        // Initialize weights to zero
        conv.weight = backend.zeros(conv.weight.shape())?
        conv.bias = Some(backend.zeros([out_channels])?)?
        Ok(Self { conv })
    }

    pub fn forward(&self, x: &Tensor<B>) -> Result<Tensor<B>!> {
        self.conv.forward(x)
    }

    pub fn load_state_dict(&mut self, state_dict: &Map<str, Tensor<B>>, prefix: &str) -> Result<()> {
        if let Some(w) = state_dict.get(&format!("{}.weight", prefix)) {
            self.conv.weight = w.clone()
        }
        if let Some(b) = state_dict.get(&format!("{}.bias", prefix)) {
            self.conv.bias = Some(b.clone())
        }
        Ok(())
    }
}

/// Condition embedding network
pub struct ControlNetConditioningEmbedding<B: ComputeBackend> {
    /// Input projection
    conv_in: Conv2d<B>,
    /// Embedding blocks
    blocks: Vec<Conv2d<B>>,
    /// Final projection
    conv_out: Conv2d<B>,
}

impl<B: ComputeBackend> ControlNetConditioningEmbedding<B> {
    pub fn new(in_channels: u32, out_channels: u32, backend: B) -> Result<Self> {
        // Progressive downsampling: 3 -> 16 -> 32 -> 96 -> 256 -> 320
        let block_channels = [16, 32, 96, 256]

        let conv_in = Conv2d::new(in_channels, block_channels[0], 3, 1, 1, backend.clone())?

        let mut blocks = Vec::new()
        let mut ch = block_channels[0]
        for &next_ch in &block_channels[1..] {
            blocks.push(Conv2d::new(ch, ch, 3, 1, 1, backend.clone())?)
            blocks.push(Conv2d::new(ch, next_ch, 3, 2, 1, backend.clone())?)  // Downsample
            ch = next_ch
        }

        let conv_out = Conv2d::new(ch, out_channels, 3, 1, 1, backend)?

        Ok(Self { conv_in, blocks, conv_out })
    }

    pub fn forward(&self, x~: &Tensor<B>) -> Result<Tensor<B>!> {
        let mut h! = self.conv_in.forward(x~)?.silu()

        for block in self.blocks.iter() {
            h = block.forward(&h)?.silu()
        }

        self.conv_out.forward(&h)
    }

    pub fn load_state_dict(&mut self, state_dict: &Map<str, Tensor<B>>, prefix: &str) -> Result<()> {
        self.conv_in.load_state_dict(state_dict, &format!("{}.conv_in", prefix))?
        for (i, block) in self.blocks.iter_mut().enumerate() {
            block.load_state_dict(state_dict, &format!("{}.blocks.{}", prefix, i))?
        }
        self.conv_out.load_state_dict(state_dict, &format!("{}.conv_out", prefix))?
        Ok(())
    }
}

/// ControlNet down block
pub struct ControlNetDownBlock<B: ComputeBackend> {
    /// ResNet blocks
    resnets: Vec<ResNetBlock<B>>,
    /// Attention blocks
    attentions: Vec<SpatialTransformer<B>>,
    /// Downsampler
    downsampler: Option<Downsample2D<B>>,
}

impl<B: ComputeBackend> ControlNetDownBlock<B> {
    pub fn new(
        in_channels: u32,
        out_channels: u32,
        num_layers: u32,
        add_downsample: bool,
        cross_attention_dim: u32,
        backend: B,
    ) -> Result<Self> {
        let mut resnets = Vec::new()
        let mut attentions = Vec::new()

        for i in 0..num_layers {
            let in_ch = if i == 0 { in_channels } else { out_channels }
            resnets.push(ResNetBlock::new(in_ch, out_channels, backend.clone())?)
            attentions.push(SpatialTransformer::new(
                out_channels,
                cross_attention_dim,
                out_channels / 64,  // num_heads
                backend.clone(),
            )?)
        }

        let downsampler = if add_downsample {
            Some(Downsample2D::new(out_channels, out_channels, backend)?)
        } else {
            None
        }

        Ok(Self { resnets, attentions, downsampler })
    }

    pub fn forward(
        &self,
        x: &Tensor<B>,
        t_emb: &Tensor<B>,
        encoder_hidden_states: &Tensor<B>,
    ) -> Result<(Tensor<B>!, Vec<Tensor<B>>)> {
        let mut hidden_states! = x.clone()
        let mut output_states: Vec<Tensor<B>> = Vec::new()

        for (resnet, attn) in self.resnets.iter().zip(self.attentions.iter()) {
            hidden_states = resnet.forward(&hidden_states, t_emb)?
            hidden_states = attn.forward(&hidden_states, encoder_hidden_states)?
            output_states.push(hidden_states.clone())
        }

        if let Some(ref down) = self.downsampler {
            hidden_states = down.forward(&hidden_states)?
            output_states.push(hidden_states.clone())
        }

        Ok((hidden_states, output_states))
    }

    pub fn load_state_dict(&mut self, state_dict: &Map<str, Tensor<B>>, prefix: &str) -> Result<()> {
        for (i, resnet) in self.resnets.iter_mut().enumerate() {
            resnet.load_state_dict(state_dict, &format!("{}.resnets.{}", prefix, i))?
        }
        for (i, attn) in self.attentions.iter_mut().enumerate() {
            attn.load_state_dict(state_dict, &format!("{}.attentions.{}", prefix, i))?
        }
        if let Some(ref mut down) = self.downsampler {
            down.load_state_dict(state_dict, &format!("{}.downsamplers.0", prefix))?
        }
        Ok(())
    }
}

/// ControlNet mid block
pub struct ControlNetMidBlock<B: ComputeBackend> {
    resnet_1: ResNetBlock<B>,
    attn: SpatialTransformer<B>,
    resnet_2: ResNetBlock<B>,
}

impl<B: ComputeBackend> ControlNetMidBlock<B> {
    pub fn new(channels: u32, cross_attention_dim: u32, backend: B) -> Result<Self> {
        let resnet_1 = ResNetBlock::new(channels, channels, backend.clone())?
        let attn = SpatialTransformer::new(
            channels,
            cross_attention_dim,
            channels / 64,
            backend.clone(),
        )?
        let resnet_2 = ResNetBlock::new(channels, channels, backend)?

        Ok(Self { resnet_1, attn, resnet_2 })
    }

    pub fn forward(
        &self,
        x: &Tensor<B>,
        t_emb: &Tensor<B>,
        encoder_hidden_states: &Tensor<B>,
    ) -> Result<Tensor<B>!> {
        let mut h! = self.resnet_1.forward(x, t_emb)?
        h = self.attn.forward(&h, encoder_hidden_states)?
        self.resnet_2.forward(&h, t_emb)
    }

    pub fn load_state_dict(&mut self, state_dict: &Map<str, Tensor<B>>, prefix: &str) -> Result<()> {
        self.resnet_1.load_state_dict(state_dict, &format!("{}.resnets.0", prefix))?
        self.attn.load_state_dict(state_dict, &format!("{}.attentions.0", prefix))?
        self.resnet_2.load_state_dict(state_dict, &format!("{}.resnets.1", prefix))?
        Ok(())
    }
}

// ============================================================================
// Multi-ControlNet
// ============================================================================

/// Multiple ControlNets applied together
pub struct MultiControlNet<B: ComputeBackend> {
    /// Individual ControlNets
    pub controlnets: Vec<ControlNet<B>>,
    /// Per-controlnet scales
    pub scales: Vec<f32>,
}

impl<B: ComputeBackend> MultiControlNet<B> {
    /// Create from list of ControlNets
    pub fn new(controlnets: Vec<(ControlNet<B>, f32)>) -> Self {
        let (nets, scales): (Vec<_>, Vec<_>) = controlnets.into_iter().unzip()
        Self { controlnets: nets, scales }
    }

    /// Forward pass - combines all controlnet outputs
    pub fn forward(
        &self,
        sample~: &Tensor<B>,
        timestep: u32,
        encoder_hidden_states~: &Tensor<B>,
        conditions~: &[Tensor<B>],
    ) -> Result<ControlNetOutput<B>!> {
        assert_eq!(self.controlnets.len(), conditions~.len(), "Must provide condition for each ControlNet")

        let mut combined_down: Vec<Tensor<B>> = Vec::new()
        let mut combined_mid: Option<Tensor<B>> = None

        for (i, (controlnet, cond)) in self.controlnets.iter().zip(conditions~.iter()).enumerate() {
            let scale = self.scales[i]
            let output! = controlnet.forward(sample~, timestep, encoder_hidden_states~, cond)?

            // Combine down block residuals
            if combined_down.is_empty() {
                combined_down = output.down_block_res_samples
                    τ{ |t| t * scale }
                    .collect()
            } else {
                for (j, res) in output.down_block_res_samples.into_iter().enumerate() {
                    combined_down[j] = combined_down[j].clone() + res * scale
                }
            }

            // Combine mid block residual
            combined_mid = Some(match combined_mid {
                None => output.mid_block_res_sample * scale,
                Some(prev) => prev + output.mid_block_res_sample * scale,
            })
        }

        Ok(ControlNetOutput {
            down_block_res_samples: combined_down,
            mid_block_res_sample: combined_mid.unwrap(),
        })
    }
}

// ============================================================================
// IP-Adapter
// ============================================================================

/// IP-Adapter configuration
pub struct IPAdapterConfig {
    /// Number of image tokens
    pub num_tokens: u32,
    /// Image embedding dimension
    pub image_embed_dim: u32,
    /// Cross attention dimension
    pub cross_attention_dim: u32,
    /// Scale for IP-Adapter influence
    pub scale: f32,
    /// Use face ID (for InstantID-style)
    pub use_face_id: bool,
}

impl IPAdapterConfig {
    /// Standard IP-Adapter
    pub fn standard() -> Self {
        Self {
            num_tokens: 4,
            image_embed_dim: 1024,  // CLIP image embedding
            cross_attention_dim: 768,
            scale: 1.0,
            use_face_id: false,
        }
    }

    /// IP-Adapter Plus (more tokens, higher fidelity)
    pub fn plus() -> Self {
        Self {
            num_tokens: 16,
            image_embed_dim: 1024,
            cross_attention_dim: 768,
            scale: 1.0,
            use_face_id: false,
        }
    }

    /// IP-Adapter for faces
    pub fn face_id() -> Self {
        Self {
            num_tokens: 4,
            image_embed_dim: 512,  // Face embedding
            cross_attention_dim: 768,
            scale: 1.0,
            use_face_id: true,
        }
    }

    /// SDXL variant
    pub fn sdxl() -> Self {
        Self {
            num_tokens: 4,
            image_embed_dim: 1280,  // OpenCLIP
            cross_attention_dim: 2048,
            scale: 1.0,
            use_face_id: false,
        }
    }
}

/// IP-Adapter for image prompting
pub struct IPAdapter<B: ComputeBackend> {
    /// Configuration
    config: IPAdapterConfig,
    /// Image encoder (CLIP)
    image_encoder: CLIPImageEncoder<B>,
    /// Image projection
    image_proj: ImageProjection<B>,
    /// Adapter modules (one per attention layer)
    adapter_modules: Vec<IPAdapterAttnProcessor<B>>,
}

impl<B: ComputeBackend> IPAdapter<B> {
    /// Create IP-Adapter
    pub fn new(config: IPAdapterConfig, num_attention_layers: u32, backend: B) -> Result<Self> {
        let image_encoder = CLIPImageEncoder::new(config.image_embed_dim, backend.clone())?

        let image_proj = ImageProjection::new(
            config.image_embed_dim,
            config.cross_attention_dim,
            config.num_tokens,
            backend.clone(),
        )?

        let adapter_modules: Vec<_> = (0..num_attention_layers)
            τ{ |_| IPAdapterAttnProcessor::new(
                config.cross_attention_dim,
                config.scale,
                backend.clone(),
            )}
            .collect::<Result<_>>()?

        Ok(Self {
            config,
            image_encoder,
            image_proj,
            adapter_modules,
        })
    }

    /// Encode image to embeddings
    pub fn encode_image(&self, image~: &Tensor<B>) -> Result<Tensor<B>!> {
        // Get CLIP image embedding
        let clip_embed! = self.image_encoder.forward(image~)?

        // Project to adapter space
        let projected! = self.image_proj.forward(&clip_embed)?

        Ok(projected)  // [batch, num_tokens, cross_attention_dim]
    }

    /// Get adapter modules for injection
    pub fn get_adapter_modules(&self) -> &[IPAdapterAttnProcessor<B>] {
        &self.adapter_modules
    }

    /// Set scale
    pub fn set_scale(&mut self, scale: f32) {
        for module in self.adapter_modules.iter_mut() {
            module.scale = scale
        }
    }

    /// Load from checkpoint
    pub fn load(path: str~, config: IPAdapterConfig, backend: B) -> Result<Self> {
        let state_dict = safetensors::load(path~)?

        // Count attention layers from state dict
        let num_layers = state_dict.keys()
            φ{ |k| k.starts_with("ip_adapter.") }
            .count() as u32

        let mut adapter = Self::new(config, num_layers, backend)?
        adapter.load_state_dict(state_dict)?
        Ok(adapter)
    }

    pub fn load_state_dict(&mut self, state_dict: Map<str, Tensor<B>>) -> Result<()> {
        self.image_encoder.load_state_dict(&state_dict, "image_encoder")?
        self.image_proj.load_state_dict(&state_dict, "image_proj")?

        for (i, module) in self.adapter_modules.iter_mut().enumerate() {
            module.load_state_dict(&state_dict, &format!("ip_adapter.{}", i))?
        }

        Ok(())
    }
}

/// Image projection for IP-Adapter
pub struct ImageProjection<B: ComputeBackend> {
    /// Linear projections
    proj: Linear<B>,
    /// Layer norm
    norm: LayerNorm<B>,
}

impl<B: ComputeBackend> ImageProjection<B> {
    pub fn new(in_dim: u32, out_dim: u32, num_tokens: u32, backend: B) -> Result<Self> {
        let proj = Linear::new(in_dim, out_dim * num_tokens, backend.clone())?
        let norm = LayerNorm::new(out_dim, backend)?
        Ok(Self { proj, norm })
    }

    pub fn forward(&self, x: &Tensor<B>) -> Result<Tensor<B>!> {
        let projected! = self.proj.forward(x)?
        // Reshape to [batch, num_tokens, out_dim]
        let reshaped! = projected.reshape([projected.shape()[0], -1, self.norm.normalized_shape[0]])
        self.norm.forward(&reshaped)
    }

    pub fn load_state_dict(&mut self, state_dict: &Map<str, Tensor<B>>, prefix: &str) -> Result<()> {
        self.proj.load_state_dict(state_dict, &format!("{}.proj", prefix))?
        self.norm.load_state_dict(state_dict, &format!("{}.norm", prefix))?
        Ok(())
    }
}

/// IP-Adapter attention processor
pub struct IPAdapterAttnProcessor<B: ComputeBackend> {
    /// K projection for image features
    to_k_ip: Linear<B>,
    /// V projection for image features
    to_v_ip: Linear<B>,
    /// Scale factor
    pub scale: f32,
}

impl<B: ComputeBackend> IPAdapterAttnProcessor<B> {
    pub fn new(dim: u32, scale: f32, backend: B) -> Result<Self> {
        let to_k_ip = Linear::new(dim, dim, backend.clone())?
        let to_v_ip = Linear::new(dim, dim, backend)?
        Ok(Self { to_k_ip, to_v_ip, scale })
    }

    /// Apply IP-Adapter attention
    pub fn forward(
        &self,
        hidden_states: &Tensor<B>,
        image_embeds: &Tensor<B>,
        attn: &CrossAttention<B>,
    ) -> Result<Tensor<B>!> {
        // Standard attention output
        let attn_output! = attn.forward(hidden_states)?

        // IP-Adapter attention
        let query! = attn.to_q.forward(hidden_states)?
        let key_ip! = self.to_k_ip.forward(image_embeds)?
        let value_ip! = self.to_v_ip.forward(image_embeds)?

        let ip_output! = scaled_dot_product_attention(&query, &key_ip, &value_ip, attn.num_heads)?

        // Combine with scale
        Ok(attn_output + ip_output * self.scale)
    }

    pub fn load_state_dict(&mut self, state_dict: &Map<str, Tensor<B>>, prefix: &str) -> Result<()> {
        self.to_k_ip.load_state_dict(state_dict, &format!("{}.to_k_ip", prefix))?
        self.to_v_ip.load_state_dict(state_dict, &format!("{}.to_v_ip", prefix))?
        Ok(())
    }
}

// ============================================================================
// Condition Preprocessors
// ============================================================================

/// Preprocessor for generating control conditions
pub struct ConditionPreprocessor<B: ComputeBackend> {
    backend: B,
}

impl<B: ComputeBackend> ConditionPreprocessor<B> {
    pub fn new(backend: B) -> Self {
        Self { backend }
    }

    /// Preprocess image for given condition type
    pub fn preprocess(
        &self,
        image~: &Tensor<B>,
        condition_type: &ControlNetCondition,
    ) -> Result<Tensor<B>!> {
        match condition_type {
            ControlNetCondition::Canny => self.canny_edge(image~),
            ControlNetCondition::Depth => self.depth_estimation(image~),
            ControlNetCondition::Pose => self.pose_estimation(image~),
            ControlNetCondition::Segmentation => self.segmentation(image~),
            ControlNetCondition::Scribble => self.scribble(image~),
            ControlNetCondition::SoftEdge => self.soft_edge(image~),
            ControlNetCondition::Normal => self.normal_map(image~),
            ControlNetCondition::Lineart => self.lineart(image~),
            ControlNetCondition::MLSD => self.mlsd_lines(image~),
            ControlNetCondition::Tile => self.tile_resample(image~),
            ControlNetCondition::Shuffle => self.content_shuffle(image~),
            ControlNetCondition::Inpaint => Ok(image~.clone()),  // Pass through
            ControlNetCondition::IPAdapter => Ok(image~.clone()),  // Handled by IP-Adapter
            ControlNetCondition::Reference => Ok(image~.clone()),  // Pass through
            ControlNetCondition::InstantID => self.face_embedding(image~),
        }
    }

    /// Canny edge detection
    fn canny_edge(&self, image~: &Tensor<B>) -> Result<Tensor<B>!> {
        // Convert to grayscale
        let gray! = rgb_to_grayscale(image~)?

        // Gaussian blur for noise reduction
        let blurred! = gaussian_blur(&gray, 5, 1.4)?

        // Sobel gradients
        let (gx!, gy!) = sobel_gradients(&blurred)?
        let magnitude! = (gx.square() + gy.square()).sqrt()
        let direction! = gy.atan2(&gx)

        // Non-maximum suppression
        let nms! = non_max_suppression(&magnitude, &direction)?

        // Double threshold and hysteresis
        let low_threshold = 0.1
        let high_threshold = 0.3
        let edges! = hysteresis_threshold(&nms, low_threshold, high_threshold)?

        // Convert to 3-channel
        Ok(edges.repeat([3, 1, 1]))
    }

    /// Depth estimation using MiDaS-style network
    fn depth_estimation(&self, image~: &Tensor<B>) -> Result<Tensor<B>!> {
        // This would use a pretrained depth model
        // For now, placeholder implementation
        let depth! = depth_anything_forward(image~, &self.backend)?
        // Normalize to 0-1
        let min_val = depth.min()
        let max_val = depth.max()
        let normalized! = (depth - min_val) / (max_val - min_val + 1e-8)
        Ok(normalized.repeat([3, 1, 1]))
    }

    /// Pose estimation using OpenPose-style detection
    fn pose_estimation(&self, image~: &Tensor<B>) -> Result<Tensor<B>!> {
        // Detect keypoints
        let keypoints! = openpose_forward(image~, &self.backend)?

        // Render skeleton
        let skeleton! = render_pose_skeleton(&keypoints, image~.shape())?
        Ok(skeleton)
    }

    /// Semantic segmentation
    fn segmentation(&self, image~: &Tensor<B>) -> Result<Tensor<B>!> {
        // Use segmentation model (e.g., SegFormer)
        let seg_map! = segformer_forward(image~, &self.backend)?
        // Convert to colored visualization
        let colored! = colorize_segmentation(&seg_map)?
        Ok(colored)
    }

    /// Scribble/sketch extraction
    fn scribble(&self, image~: &Tensor<B>) -> Result<Tensor<B>!> {
        // Use HED for soft edges, then threshold
        let edges! = hed_forward(image~, &self.backend)?
        let binary! = (edges > 0.5).float()
        Ok(binary.repeat([3, 1, 1]))
    }

    /// Soft edge detection (HED/PiDiNet)
    fn soft_edge(&self, image~: &Tensor<B>) -> Result<Tensor<B>!> {
        let edges! = hed_forward(image~, &self.backend)?
        Ok(edges.repeat([3, 1, 1]))
    }

    /// Normal map estimation
    fn normal_map(&self, image~: &Tensor<B>) -> Result<Tensor<B>!> {
        // Estimate depth first
        let depth! = self.depth_estimation(image~)?

        // Compute normals from depth gradients
        let (dx!, dy!) = depth_gradients(&depth)?
        let normals! = compute_normals(&dx, &dy)?

        // Map to 0-1 range (normal maps use 0.5 as neutral)
        Ok((normals + 1.0) / 2.0)
    }

    /// Lineart extraction
    fn lineart(&self, image~: &Tensor<B>) -> Result<Tensor<B>!> {
        let lines! = lineart_forward(image~, &self.backend)?
        // Invert (white background, black lines)
        Ok(1.0 - lines.repeat([3, 1, 1]))
    }

    /// M-LSD line detection
    fn mlsd_lines(&self, image~: &Tensor<B>) -> Result<Tensor<B>!> {
        let lines! = mlsd_forward(image~, &self.backend)?
        // Render line segments
        let rendered! = render_line_segments(&lines, image~.shape())?
        Ok(rendered)
    }

    /// Tile resample (for upscaling with ControlNet)
    fn tile_resample(&self, image~: &Tensor<B>) -> Result<Tensor<B>!> {
        // Blur and resample to reduce detail
        let blurred! = gaussian_blur(image~, 11, 5.0)?
        Ok(blurred)
    }

    /// Content shuffle (for style transfer)
    fn content_shuffle(&self, image~: &Tensor<B>) -> Result<Tensor<B>!> {
        let (_, _, h, w) = image~.shape4()

        // Shuffle patches
        let patch_size = 64
        let patches! = extract_patches(image~, patch_size)?
        let shuffled! = shuffle_patches(&patches)?
        let reconstructed! = reconstruct_from_patches(&shuffled, h, w, patch_size)?

        Ok(reconstructed)
    }

    /// Face embedding extraction (for InstantID)
    fn face_embedding(&self, image~: &Tensor<B>) -> Result<Tensor<B>!> {
        // Detect face and extract embedding
        let face_box! = detect_face(image~, &self.backend)?
        let face_crop! = crop_and_align_face(image~, &face_box)?
        let embedding! = face_encoder_forward(&face_crop, &self.backend)?
        Ok(embedding)
    }
}

// ============================================================================
// Reference-Only Control
// ============================================================================

/// Reference-only control (no separate ControlNet)
pub struct ReferenceOnlyControl<B: ComputeBackend> {
    /// Reference image features (cached)
    reference_features: Option<Vec<Tensor<B>>>,
    /// Attention mode
    mode: ReferenceMode,
    /// Style fidelity (0.0 - 1.0)
    style_fidelity: f32,
}

/// Reference attention modes
pub enum ReferenceMode {
    /// Concatenate reference features to self-attention
    Concat,
    /// Add reference features weighted
    AddWeighted,
    /// Use adapter-style attention
    Adapter,
}

impl<B: ComputeBackend> ReferenceOnlyControl<B> {
    pub fn new(mode: ReferenceMode, style_fidelity: f32) -> Self {
        Self {
            reference_features: None,
            mode,
            style_fidelity,
        }
    }

    /// Cache features from reference image
    pub fn cache_reference(
        &mut self,
        reference_image~: &Tensor<B>,
        unet: &UNet2D<B>,
        timestep: u32,
        text_embeds: &Tensor<B>,
    ) -> Result<()> {
        // Forward pass through U-Net to extract features
        let features! = unet.extract_features(reference_image~, timestep, text_embeds)?
        self.reference_features = Some(features)
        Ok(())
    }

    /// Modify attention outputs using reference
    pub fn modify_attention(
        &self,
        hidden_states: &Tensor<B>,
        layer_idx: usize,
    ) -> Result<Tensor<B>!> {
        let ref_features = self.reference_features.as_ref()
            .ok_or(InfernumError::InvalidState("Reference features not cached"))?

        let ref_feat = &ref_features[layer_idx]

        match self.mode {
            ReferenceMode::Concat => {
                // Attention with concatenated reference
                Ok(hidden_states.clone())  // Modified in attention layer
            },
            ReferenceMode::AddWeighted => {
                // Simple weighted addition
                Ok(hidden_states.clone() * (1.0 - self.style_fidelity)
                    + ref_feat * self.style_fidelity)
            },
            ReferenceMode::Adapter => {
                // Use adapter-style attention
                Ok(hidden_states.clone())  // Modified in attention layer
            },
        }
    }

    /// Clear cached features
    pub fn clear(&mut self) {
        self.reference_features = None
    }
}

