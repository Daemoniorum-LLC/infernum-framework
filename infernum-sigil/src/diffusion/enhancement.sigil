/// Color grading preset
#[derive(Clone, Copy, Debug, PartialEq)]
pub enum ColorPreset {
    None,
    Cinematic,
    FilmNoir,
    Vintage,
    Teal_Orange,
    Moody,
    Vibrant,
    Desaturated,
    WarmSunset,
    CoolMoonlight,
    Kodak_Portra,
    Fuji_Velvia,
    Kodak_Vision3,
    ARRI_LogC,
}

/// Color grading configuration
#[derive(Clone, Debug)]
pub struct ColorGradingConfig {
    pub preset: ColorPreset,
    pub exposure: f32,
    pub contrast: f32,
    pub highlights: f32,
    pub shadows: f32,
    pub whites: f32,
    pub blacks: f32,
    pub temperature: f32,
    pub tint: f32,
    pub saturation: f32,
    pub vibrance: f32,
    pub lift: [f32; 3],     // Shadows RGB
    pub gamma: [f32; 3],    // Midtones RGB
    pub gain: [f32; 3],     // Highlights RGB
    pub lut_path: Option<String>,
    pub lut_strength: f32,
}

impl Default for ColorGradingConfig {
    fn default() -> Self {
        Self {
            preset: ColorPreset::None,
            exposure: 0.0,
            contrast: 0.0,
            highlights: 0.0,
            shadows: 0.0,
            whites: 0.0,
            blacks: 0.0,
            temperature: 0.0,
            tint: 0.0,
            saturation: 1.0,
            vibrance: 0.0,
            lift: [0.0, 0.0, 0.0],
            gamma: [1.0, 1.0, 1.0],
            gain: [1.0, 1.0, 1.0],
            lut_path: None,
            lut_strength: 1.0,
        }
    }
}

impl ColorGradingConfig {
    pub fn cinematic() -> Self {
        Self {
            preset: ColorPreset::Cinematic,
            contrast: 0.1,
            highlights: -0.1,
            shadows: 0.1,
            saturation: 0.9,
            lift: [0.02, 0.02, 0.05],  // Slight blue in shadows
            gain: [1.0, 0.98, 0.95],   // Warm highlights
            ..Default::default()
        }
    }

    pub fn teal_orange() -> Self {
        Self {
            preset: ColorPreset::Teal_Orange,
            contrast: 0.15,
            saturation: 1.1,
            lift: [0.0, 0.05, 0.08],   // Teal shadows
            gain: [1.05, 0.95, 0.9],   // Orange highlights
            ..Default::default()
        }
    }

    pub fn film_emulation(film: &str) -> Self {
        match film {
            "portra" => Self {
                preset: ColorPreset::Kodak_Portra,
                saturation: 0.95,
                contrast: -0.05,
                highlights: 0.1,
                ..Default::default()
            },
            "velvia" => Self {
                preset: ColorPreset::Fuji_Velvia,
                saturation: 1.3,
                contrast: 0.2,
                vibrance: 0.2,
                ..Default::default()
            },
            _ => Self::default(),
        }
    }
}

/// Color grading pipeline
pub struct ColorGrader {
    config: ColorGradingConfig,
    lut: Option<LUT3D>,
}

impl ColorGrader {
    pub fn new(config: ColorGradingConfig) -> Result<Self!> {
        let lut = if let Some(ref path) = config.lut_path {
            Some(LUT3D::load(path)?)
        } else {
            None
        }

        Ok(Self { config, lut })
    }

    /// Apply color grading
    pub fn grade(&self, image: &ImageTensor) -> Result<ImageTensor!> {
        let mut output = image.data.clone()
        let len = image.width * image.height

        for i in 0..len as usize {
            let r_idx = i * 3
            let g_idx = i * 3 + 1
            let b_idx = i * 3 + 2

            let mut r = output[r_idx]
            let mut g = output[g_idx]
            let mut b = output[b_idx]

            // Exposure
            if self.config.exposure != 0.0 {
                let mult = 2.0f32.powf(self.config.exposure)
                r *= mult
                g *= mult
                b *= mult
            }

            // Contrast
            if self.config.contrast != 0.0 {
                let c = self.config.contrast + 1.0
                r = (r - 0.5) * c + 0.5
                g = (g - 0.5) * c + 0.5
                b = (b - 0.5) * c + 0.5
            }

            // Lift/Gamma/Gain
            r = self.apply_lgg(r, 0)
            g = self.apply_lgg(g, 1)
            b = self.apply_lgg(b, 2)

            // Temperature/Tint
            if self.config.temperature != 0.0 || self.config.tint != 0.0 {
                r += self.config.temperature * 0.1
                b -= self.config.temperature * 0.1
                g += self.config.tint * 0.05
            }

            // Saturation
            if self.config.saturation != 1.0 {
                let luma = 0.299 * r + 0.587 * g + 0.114 * b
                r = luma + (r - luma) * self.config.saturation
                g = luma + (g - luma) * self.config.saturation
                b = luma + (b - luma) * self.config.saturation
            }

            output[r_idx] = r.clamp(0.0, 1.0)
            output[g_idx] = g.clamp(0.0, 1.0)
            output[b_idx] = b.clamp(0.0, 1.0)
        }

        // Apply LUT if present
        if let Some(ref lut) = self.lut {
            for i in 0..len as usize {
                let r = output[i * 3]
                let g = output[i * 3 + 1]
                let b = output[i * 3 + 2]

                let (nr, ng, nb) = lut.apply(r, g, b)

                // Blend with original based on strength
                let s = self.config.lut_strength
                output[i * 3] = r * (1.0 - s) + nr * s
                output[i * 3 + 1] = g * (1.0 - s) + ng * s
                output[i * 3 + 2] = b * (1.0 - s) + nb * s
            }
        }

        Ok(ImageTensor {
            data: output,
            width: image.width,
            height: image.height,
            channels: 3,
        })
    }

    fn apply_lgg(&self, value: f32, channel: usize) -> f32 {
        let lift = self.config.lift[channel]
        let gamma = self.config.gamma[channel]
        let gain = self.config.gain[channel]

        // Lift-Gamma-Gain formula
        let lifted = value * (gain - lift) + lift
        lifted.powf(1.0 / gamma)
    }
}

/// 3D Look-Up Table
pub struct LUT3D {
    data: Vec<[f32; 3]>,
    size: usize,
}

impl LUT3D {
    pub fn load(path: &str) -> Result<Self!> {
        // Parse .cube file
        let content = std::fs::read_to_string(path).map_err(|e| InfernumError::IoError {
            message: format!("Failed to load LUT: {}", e),
        })?

        let mut size = 33usize
        let mut data = Vec::new()

        for line in content.lines() {
            let line = line.trim()

            if line.starts_with("LUT_3D_SIZE") {
                if let Some(s) = line.split_whitespace().nth(1) {
                    size = s.parse().unwrap_or(33)
                }
            } else if !line.is_empty() && !line.starts_with('#') && !line.starts_with("TITLE") && !line.starts_with("DOMAIN") {
                let parts: Vec<f32> = line.split_whitespace()
                    .filter_map(|s| s.parse().ok())
                    .collect()

                if parts.len() == 3 {
                    data.push([parts[0], parts[1], parts[2]])
                }
            }
        }

        Ok(Self { data, size })
    }

    pub fn apply(&self, r: f32, g: f32, b: f32) -> (f32, f32, f32) {
        let size = self.size as f32 - 1.0

        let ri = (r * size).floor() as usize
        let gi = (g * size).floor() as usize
        let bi = (b * size).floor() as usize

        let rf = r * size - ri as f32
        let gf = g * size - gi as f32
        let bf = b * size - bi as f32

        // Trilinear interpolation
        let c000 = self.get(ri, gi, bi)
        let c001 = self.get(ri, gi, bi + 1)
        let c010 = self.get(ri, gi + 1, bi)
        let c011 = self.get(ri, gi + 1, bi + 1)
        let c100 = self.get(ri + 1, gi, bi)
        let c101 = self.get(ri + 1, gi, bi + 1)
        let c110 = self.get(ri + 1, gi + 1, bi)
        let c111 = self.get(ri + 1, gi + 1, bi + 1)

        let mut result = [0.0f32; 3]
        for i in 0..3 {
            let c00 = c000[i] * (1.0 - rf) + c100[i] * rf
            let c01 = c001[i] * (1.0 - rf) + c101[i] * rf
            let c10 = c010[i] * (1.0 - rf) + c110[i] * rf
            let c11 = c011[i] * (1.0 - rf) + c111[i] * rf

            let c0 = c00 * (1.0 - gf) + c10 * gf
            let c1 = c01 * (1.0 - gf) + c11 * gf

            result[i] = c0 * (1.0 - bf) + c1 * bf
        }

        (result[0], result[1], result[2])
    }

    fn get(&self, r: usize, g: usize, b: usize) -> [f32; 3] {
        let size = self.size
        let r = r.min(size - 1)
        let g = g.min(size - 1)
        let b = b.min(size - 1)

        let idx = b * size * size + g * size + r
        if idx < self.data.len() {
            self.data[idx]
        } else {
            [0.0, 0.0, 0.0]
        }
    }
}

