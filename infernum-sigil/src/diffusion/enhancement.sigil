    pub edge_enhancement: f32,
    pub local_contrast: f32,
    pub denoise: f32,
}

impl Default for DetailEnhanceConfig {
    fn default() -> Self {
        Self {
            sharpness: 0.5,
            clarity: 0.3,
            texture_strength: 0.4,
            edge_enhancement: 0.2,
            local_contrast: 0.3,
            denoise: 0.2,
        }
    }
}

impl DetailEnhanceConfig {
    pub fn cinematic() -> Self {
        Self {
            sharpness: 0.4,
            clarity: 0.5,
            texture_strength: 0.3,
            edge_enhancement: 0.15,
            local_contrast: 0.4,
            denoise: 0.15,
        }
    }

    pub fn sharp() -> Self {
        Self {
            sharpness: 0.8,
            edge_enhancement: 0.5,
            ..Default::default()
        }
    }
}

/// Detail enhancement pipeline
pub struct DetailEnhancer {
    config: DetailEnhanceConfig,
}

impl DetailEnhancer {
    pub fn new(config: DetailEnhanceConfig) -> Self {
        Self { config }
    }

    /// Enhance image details
    pub fn enhance(&self, image: &ImageTensor) -> Result<ImageTensor!> {
        let mut output = image.clone()

        // Apply denoise first
        if self.config.denoise > 0.0 {
            output = self.denoise(&output, self.config.denoise)?
        }

        // Local contrast (clarity)
        if self.config.local_contrast > 0.0 {
            output = self.local_contrast(&output, self.config.local_contrast)?
        }

        // Unsharp mask for sharpness
        if self.config.sharpness > 0.0 {
            output = self.sharpen(&output, self.config.sharpness)?
        }

        // Edge enhancement
        if self.config.edge_enhancement > 0.0 {
            output = self.enhance_edges(&output, self.config.edge_enhancement)?
        }

        Ok(output)
    }

    fn denoise(&self, image: &ImageTensor, strength: f32) -> Result<ImageTensor!> {
        // Bilateral filter or ML-based denoising
        Ok(image.clone())
    }

    fn local_contrast(&self, image: &ImageTensor, strength: f32) -> Result<ImageTensor!> {
        // CLAHE or similar
        Ok(image.clone())
    }

    fn sharpen(&self, image: &ImageTensor, strength: f32) -> Result<ImageTensor!> {
        // Unsharp mask
        let mut output = image.data.clone()
        let w = image.width as i32
        let h = image.height as i32

        // Simple Laplacian-based sharpening
        for y in 1..h-1 {
            for x in 1..w-1 {
                for c in 0..3 {
                    let idx = ((y * w + x) * 3 + c) as usize

                    let center = image.data[idx]
                    let top = image.data[(((y-1) * w + x) * 3 + c) as usize]
                    let bottom = image.data[(((y+1) * w + x) * 3 + c) as usize]
                    let left = image.data[((y * w + (x-1)) * 3 + c) as usize]
                    let right = image.data[((y * w + (x+1)) * 3 + c) as usize]

                    let laplacian = 4.0 * center - top - bottom - left - right
                    output[idx] = (center + laplacian * strength).clamp(0.0, 1.0)
                }
            }
        }

        Ok(ImageTensor {
            data: output,
            width: image.width,
            height: image.height,
            channels: 3,
        })
    }

    fn enhance_edges(&self, image: &ImageTensor, strength: f32) -> Result<ImageTensor!> {
        // Sobel-based edge enhancement
        Ok(image.clone())
    }
}

