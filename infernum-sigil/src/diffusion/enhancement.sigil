/// Film grain generator
pub struct FilmGrain {
    config: FilmGrainConfig,
}

impl FilmGrain {
    pub fn new(config: FilmGrainConfig) -> Self {
        Self { config }
    }

    /// Apply film grain
    pub fn apply(&self, image: &ImageTensor) -> ImageTensor {
        let mut output = image.data.clone()
        let mut rng = SimpleRng::new(42)

        for i in 0..(image.width * image.height) as usize {
            let r = output[i * 3]
            let g = output[i * 3 + 1]
            let b = output[i * 3 + 2]

            // Luminance for protection
            let luma = 0.299 * r + 0.587 * g + 0.114 * b

            // Reduce grain in highlights
            let protection = if luma > 0.7 {
                1.0 - (luma - 0.7) / 0.3 * self.config.highlight_protection
            } else {
                1.0
            }

            // Boost in shadows
            let shadow_mult = if luma < 0.3 {
                1.0 + (0.3 - luma) / 0.3 * self.config.shadow_boost
            } else {
                1.0
            }

            let intensity = self.config.intensity * protection * shadow_mult

            // Generate grain
            let mono_grain = (rng.next_f32() - 0.5) * 2.0 * intensity

            if self.config.color_amount > 0.0 {
                let r_grain = mono_grain + (rng.next_f32() - 0.5) * intensity * self.config.color_amount
                let g_grain = mono_grain + (rng.next_f32() - 0.5) * intensity * self.config.color_amount
                let b_grain = mono_grain + (rng.next_f32() - 0.5) * intensity * self.config.color_amount

                output[i * 3] = (r + r_grain).clamp(0.0, 1.0)
                output[i * 3 + 1] = (g + g_grain).clamp(0.0, 1.0)
                output[i * 3 + 2] = (b + b_grain).clamp(0.0, 1.0)
            } else {
                output[i * 3] = (r + mono_grain).clamp(0.0, 1.0)
                output[i * 3 + 1] = (g + mono_grain).clamp(0.0, 1.0)
                output[i * 3 + 2] = (b + mono_grain).clamp(0.0, 1.0)
            }
        }

        ImageTensor {
            data: output,
            width: image.width,
            height: image.height,
            channels: 3,
        }
    }
}

// Simple RNG for grain
struct SimpleRng {
    state: u64,
}

impl SimpleRng {
    fn new(seed: u64) -> Self {
        Self { state: seed }
    }

    fn next_f32(&mut self) -> f32 {
        self.state = self.state.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407)
        ((self.state >> 33) as f32) / (u32::MAX as f32)
    }
}

// ============================================================================
// Image Tensor
// ============================================================================

/// Image tensor (RGB, 0-1 range)
#[derive(Clone, Debug)]
pub struct ImageTensor {
    pub data: Vec<f32>,
    pub width: u32,
    pub height: u32,
    pub channels: u32,
}

impl ImageTensor {
    pub fn new(width: u32, height: u32) -> Self {
        Self {
            data: vec![0.0f32; (width * height * 3) as usize],
            width,
            height,
            channels: 3,
        }
    }

    pub fn from_rgb(data: Vec<f32>, width: u32, height: u32) -> Self {
        Self {
            data,
            width,
            height,
            channels: 3,
        }
    }
}

// ============================================================================
// Complete Enhancement Pipeline
// ============================================================================

/// Complete enhancement pipeline
pub struct EnhancementPipeline {
    pub super_res: Option<SuperResolution>,
    pub face_restore: Option<FaceRestore>,
    pub detail: Option<DetailEnhancer>,
    pub color: Option<ColorGrader>,
    pub grain: Option<FilmGrain>,
}

impl EnhancementPipeline {
    pub fn new() -> Self {
        Self {
            super_res: None,
            face_restore: None,
            detail: None,
            color: None,
            grain: None,
        }
    }

    pub fn cinematic() -> Result<Self!> {
        Ok(Self {
            super_res: Some(SuperResolution::new(SuperResConfig::cinematic())?),
            face_restore: Some(FaceRestore::new(FaceRestoreConfig::default())?),
            detail: Some(DetailEnhancer::new(DetailEnhanceConfig::cinematic())),
            color: Some(ColorGrader::new(ColorGradingConfig::cinematic())?),
            grain: Some(FilmGrain::new(FilmGrainConfig::cinematic())),
        })
    }

    pub fn with_super_res(mut self, config: SuperResConfig) -> Result<Self!> {
        self.super_res = Some(SuperResolution::new(config)?)
        Ok(self)
    }

    pub fn with_face_restore(mut self, config: FaceRestoreConfig) -> Result<Self!> {
        self.face_restore = Some(FaceRestore::new(config)?)
        Ok(self)
    }

    pub fn with_color(mut self, config: ColorGradingConfig) -> Result<Self!> {
        self.color = Some(ColorGrader::new(config)?)
        Ok(self)
    }

    pub fn with_grain(mut self, config: FilmGrainConfig) -> Self {
        self.grain = Some(FilmGrain::new(config))
        self
    }

    /// Apply full pipeline
    pub fn enhance(&self, image: &ImageTensor) -> Result<ImageTensor!> {
        let mut output = image.clone()

        // 1. Face restoration (before upscaling for better results)
        if let Some(ref face) = self.face_restore {
            output = face.restore(&output)?
        }

        // 2. Super-resolution
        if let Some(ref sr) = self.super_res {
            output = sr.upscale(&output)?
        }

        // 3. Detail enhancement
        if let Some(ref detail) = self.detail {
            output = detail.enhance(&output)?
        }

        // 4. Color grading
        if let Some(ref color) = self.color {
            output = color.grade(&output)?
        }

        // 5. Film grain (last, after all other processing)
        if let Some(ref grain) = self.grain {
            output = grain.apply(&output)
        }

        Ok(output)
    }
}
