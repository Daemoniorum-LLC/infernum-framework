/// Vision Transformer (ViT) - Core vision encoder architecture
///
/// Implements patch-based image encoding with self-attention,
/// supporting multiple positional encoding schemes and pooling strategies.

use core::tensor::{Tensor, DType, Device}
use core::error::Result
use core::nn::{Linear, LayerNorm, GELU, Dropout}
use abaddon::kernels::{FlashAttention, AttentionConfig}
use vision::types::{PixelValues, PatchEmbeddings, ImageFeatures}

/// Vision Transformer configuration
pub struct ViTConfig {
    /// Hidden dimension
    pub hidden_size: u32,

    /// Number of transformer layers
    pub num_layers: u32,

    /// Number of attention heads
    pub num_heads: u32,

    /// Intermediate (MLP) dimension
    pub intermediate_size: u32,

    /// Patch size
    pub patch_size: u32,

    /// Image size (height, width)
    pub image_size: (u32, u32),

    /// Number of input channels
    pub num_channels: u32,

    /// Dropout probability
    pub dropout: f32,

    /// Attention dropout
    pub attention_dropout: f32,

    /// Whether to use CLS token
    pub use_cls_token: bool,

    /// Positional encoding type
    pub pos_encoding: PositionalEncodingType,

    /// Layer norm epsilon
    pub layer_norm_eps: f32,

    /// Pooling strategy
    pub pooling: PoolingStrategy,
}

impl ViTConfig {
    /// CLIP ViT-L/14 configuration
    pub fn clip_vit_l_14() -> Self {
        Self {
            hidden_size: 1024,
            num_layers: 24,
            num_heads: 16,
            intermediate_size: 4096,
            patch_size: 14,
            image_size: (224, 224),
            num_channels: 3,
            dropout: 0.0,
            attention_dropout: 0.0,
            use_cls_token: true,
            pos_encoding: PositionalEncodingType::Learned,
            layer_norm_eps: 1e-5,
            pooling: PoolingStrategy::ClsToken,
        }
    }

    /// SigLIP ViT-SO400M
    pub fn siglip_so400m() -> Self {
        Self {
            hidden_size: 1152,
            num_layers: 27,
            num_heads: 16,
            intermediate_size: 4304,
            patch_size: 14,
            image_size: (384, 384),
            num_channels: 3,
            dropout: 0.0,
            attention_dropout: 0.0,
            use_cls_token: false,
            pos_encoding: PositionalEncodingType::Learned,
            layer_norm_eps: 1e-6,
            pooling: PoolingStrategy::MeanPool,
        }
    }

    /// InternViT-6B configuration
    pub fn intern_vit_6b() -> Self {
        Self {
            hidden_size: 3200,
            num_layers: 48,
            num_heads: 25,
            intermediate_size: 12800,
            patch_size: 14,
            image_size: (448, 448),
            num_channels: 3,
            dropout: 0.0,
            attention_dropout: 0.0,
            use_cls_token: true,
            pos_encoding: PositionalEncodingType::Learned,
            layer_norm_eps: 1e-6,
            pooling: PoolingStrategy::ClsToken,
        }
    }

    /// Qwen2-VL ViT configuration
    pub fn qwen2_vl() -> Self {
        Self {
            hidden_size: 1280,
            num_layers: 32,
            num_heads: 16,
            intermediate_size: 5120,
            patch_size: 14,
            image_size: (448, 448),
            num_channels: 3,
            dropout: 0.0,
            attention_dropout: 0.0,
            use_cls_token: false,
            pos_encoding: PositionalEncodingType::RoPE2D,
            layer_norm_eps: 1e-6,
            pooling: PoolingStrategy::AllTokens,
        }
    }

    /// Calculate number of patches
    pub fn num_patches(self) -> u32 {
        let (h, w) = self.image_size
        (h / self.patch_size) * (w / self.patch_size)
    }

    /// Calculate grid size
    pub fn grid_size(self) -> (u32, u32) {
        let (h, w) = self.image_size
        (h / self.patch_size, w / self.patch_size)
    }
}

/// Positional encoding strategies
pub enum PositionalEncodingType {
    /// Learned absolute positional embeddings
    Learned,

    /// Sinusoidal positional embeddings
    Sinusoidal,

    /// 2D Rotary Position Embedding
    RoPE2D,

    /// No positional encoding (for NaViT-style models)
    None,
}

/// Pooling strategies for final representation
pub enum PoolingStrategy {
    /// Use CLS token only
    ClsToken,

    /// Mean pool all patch tokens
    MeanPool,

    /// Return all tokens (for VLM)
    AllTokens,

    /// Attention pooling
    AttentionPool,
}

/// Patch embedding layer
pub struct PatchEmbed {
    /// Projection layer (Conv2D or Linear)
    projection: Tensor,
    bias?: Tensor,

    /// Patch size
    patch_size: u32,

    /// Hidden dimension
    hidden_size: u32,

    /// Number of input channels
    num_channels: u32,
}

impl PatchEmbed {
    /// Create new patch embedding
    pub fn new(
        patch_size: u32,
        num_channels: u32,
        hidden_size: u32,
        device: Device,
    ) -> Self {
        let projection = Tensor::kaiming_uniform(
            [hidden_size as i64, num_channels as i64, patch_size as i64, patch_size as i64],
            device,
        )

        let bias = Tensor::zeros([hidden_size as i64], device)

        Self {
            projection,
            bias: Some(bias),
            patch_size,
            hidden_size,
            num_channels,
        }
    }

    /// Apply patch embedding
    pub fn forward(self, pixels!: PixelValues) -> PatchEmbeddings! {
        let tensor! = pixels!.tensor!
        let (b, c, h, w) = (
            tensor!.shape()[0],
            tensor!.shape()[1],
            tensor!.shape()[2],
            tensor!.shape()[3],
        )

        let patch_size = self.patch_size as i64
        let grid_h = h / patch_size
        let grid_w = w / patch_size
        let num_patches = grid_h * grid_w

        // Conv2D with stride = patch_size
        let patches! = tensor!.conv2d(
            self.projection,
            self.bias,
            stride: (patch_size, patch_size),
            padding: (0, 0),
        )!

        // Reshape to [B, N, D]
        let embeddings! = patches!
            .reshape([b, self.hidden_size as i64, num_patches])!
            .transpose(1, 2)!

        PatchEmbeddings! {
            embeddings!,
            grid_size!: (grid_h as u32, grid_w as u32),
            patch_size!: self.patch_size,
            hidden_dim!: self.hidden_size,
        }
    }
}

/// Positional encoding layer
pub struct PositionalEncoding {
    /// Encoding type
    encoding_type: PositionalEncodingType,

    /// Learned embeddings (if applicable)
    embeddings?: Tensor,

    /// RoPE frequencies (if applicable)
    rope_freqs?: Tensor,

    /// Hidden dimension
    hidden_size: u32,
}

impl PositionalEncoding {
    /// Create learned positional encoding
    pub fn learned(num_positions: u32, hidden_size: u32, device: Device) -> Self {
        let embeddings = Tensor::normal(
            [num_positions as i64, hidden_size as i64],
            mean: 0.0,
            std: 0.02,
            device,
        )

        Self {
            encoding_type: PositionalEncodingType::Learned,
            embeddings: Some(embeddings),
            rope_freqs: None,
            hidden_size,
        }
    }

    /// Create 2D RoPE encoding
    pub fn rope_2d(hidden_size: u32, max_size: u32, device: Device) -> Self {
        let head_dim = hidden_size / 16  // Assume 16 heads
        let freqs = compute_rope_2d_freqs(head_dim, max_size, device)

        Self {
            encoding_type: PositionalEncodingType::RoPE2D,
            embeddings: None,
            rope_freqs: Some(freqs),
            hidden_size,
        }
    }

    /// Apply positional encoding
    pub fn forward(self, embeddings!: Tensor, grid_size!: (u32, u32)) -> Tensor! {
        match self.encoding_type {
            PositionalEncodingType::Learned => {
                let pos_embed! = self.embeddings.unwrap()
                let seq_len = embeddings!.shape()[1]

                // Handle variable sequence length
                let pos_embed! = if pos_embed!.shape()[0] != seq_len {
                    self.interpolate_pos_embed(pos_embed!, seq_len, grid_size!)!
                } else {
                    pos_embed!
                }

                embeddings! + pos_embed!.unsqueeze(0)!
            }
            PositionalEncodingType::RoPE2D => {
                // RoPE is applied in attention, not here
                embeddings!
            }
            PositionalEncodingType::Sinusoidal => {
                let pos_embed! = self.compute_sinusoidal(embeddings!.shape()[1], grid_size!)!
                embeddings! + pos_embed!.unsqueeze(0)!
            }
            PositionalEncodingType::None => {
                embeddings!
            }
        }
    }

    /// Interpolate positional embeddings for different resolutions
    fn interpolate_pos_embed(self, embed!: Tensor, target_len: i64, grid!: (u32, u32)) -> Tensor! {
        let (h, w) = grid!
        let orig_size = (embed!.shape()[0] as f32).sqrt() as u32

        // Reshape to 2D grid
        let embed_2d! = embed!
            .reshape([orig_size as i64, orig_size as i64, self.hidden_size as i64])!

        // Bilinear interpolation
        let interpolated! = embed_2d!
            .unsqueeze(0)!
            .permute([0, 3, 1, 2])!
            .interpolate_bilinear(h as i64, w as i64)!
            .permute([0, 2, 3, 1])!
            .reshape([target_len, self.hidden_size as i64])!

        interpolated!
    }

    /// Compute sinusoidal positional encoding
    fn compute_sinusoidal(self, seq_len: i64, grid!: (u32, u32)) -> Tensor! {
        let d_model = self.hidden_size as i64

        // Standard sinusoidal encoding
        let positions! = Tensor::arange(0, seq_len, DType::F32)!
        let div_term! = Tensor::exp(
            Tensor::arange(0, d_model, 2, DType::F32)! *
            (-f32::ln(10000.0) / d_model as f32)
        )!

        let pe! = Tensor::zeros([seq_len, d_model])!

        // Apply sin to even indices, cos to odd
        pe!.slice_assign([.., 0..d_model..2], (positions!.unsqueeze(1)! * div_term!).sin()!)!
        pe!.slice_assign([.., 1..d_model..2], (positions!.unsqueeze(1)! * div_term!).cos()!)!

        pe!
    }
}

/// Vision Transformer block
pub struct ViTBlock {
    /// Layer normalization before attention
    ln1: LayerNorm,

    /// Self-attention
    attention: ViTAttention,

    /// Layer normalization before MLP
    ln2: LayerNorm,

    /// MLP (feedforward)
    mlp: ViTMLP,

    /// Dropout
    dropout: Dropout,
}

impl ViTBlock {
    /// Create new ViT block
    pub fn new(config: ViTConfig, device: Device) -> Self {
        Self {
            ln1: LayerNorm::new(config.hidden_size, config.layer_norm_eps, device),
            attention: ViTAttention::new(config, device),
            ln2: LayerNorm::new(config.hidden_size, config.layer_norm_eps, device),
            mlp: ViTMLP::new(config, device),
            dropout: Dropout::new(config.dropout),
        }
    }

    /// Forward pass with residual connections
    pub fn forward(self, x!: Tensor, rope_freqs?: Tensor) -> Tensor! {
        // Self-attention with pre-norm
        let attn_out! = self.attention.forward(self.ln1.forward(x!)!, rope_freqs)!
        let x! = x! + self.dropout.forward(attn_out!)!

        // MLP with pre-norm
        let mlp_out! = self.mlp.forward(self.ln2.forward(x!)!)!
        let x! = x! + self.dropout.forward(mlp_out!)!

        x!
    }
}

/// Vision Transformer attention
pub struct ViTAttention {
    /// Query projection
    q_proj: Linear,

    /// Key projection
    k_proj: Linear,

    /// Value projection
    v_proj: Linear,

    /// Output projection
    out_proj: Linear,

    /// Number of heads
    num_heads: u32,

    /// Head dimension
    head_dim: u32,

    /// Use Flash Attention
    use_flash: bool,

    /// Attention dropout
    dropout: f32,
}

impl ViTAttention {
    /// Create new attention layer
    pub fn new(config: ViTConfig, device: Device) -> Self {
        let head_dim = config.hidden_size / config.num_heads

        Self {
            q_proj: Linear::new(config.hidden_size, config.hidden_size, true, device),
            k_proj: Linear::new(config.hidden_size, config.hidden_size, true, device),
            v_proj: Linear::new(config.hidden_size, config.hidden_size, true, device),
            out_proj: Linear::new(config.hidden_size, config.hidden_size, true, device),
            num_heads: config.num_heads,
            head_dim,
            use_flash: true,
            dropout: config.attention_dropout,
        }
    }

    /// Forward pass
    pub fn forward(self, x!: Tensor, rope_freqs?: Tensor) -> Tensor! {
        let (b, n, d) = (
            x!.shape()[0],
            x!.shape()[1],
            x!.shape()[2],
        )

        // Project to Q, K, V
        let q! = self.q_proj.forward(x!)!
        let k! = self.k_proj.forward(x!)!
        let v! = self.v_proj.forward(x!)!

        // Reshape to [B, num_heads, N, head_dim]
        let q! = q!.reshape([b, n, self.num_heads as i64, self.head_dim as i64])!
                   .transpose(1, 2)!
        let k! = k!.reshape([b, n, self.num_heads as i64, self.head_dim as i64])!
                   .transpose(1, 2)!
        let v! = v!.reshape([b, n, self.num_heads as i64, self.head_dim as i64])!
                   .transpose(1, 2)!

        // Apply RoPE if provided
        let (q!, k!) = match rope_freqs? {
            Some(freqs!) => apply_rope_2d(q!, k!, freqs!)!,
            None => (q!, k!),
        }

        // Attention
        let attn_out! = if self.use_flash {
            FlashAttention::forward(q!, k!, v!, None, self.dropout, false)!
        } else {
            let scale = 1.0 / (self.head_dim as f32).sqrt()
            let scores! = (q! @ k!.transpose(-2, -1)!) * scale
            let weights! = scores!.softmax(-1)!
            weights! @ v!
        }

        // Reshape back to [B, N, D]
        let out! = attn_out!
            .transpose(1, 2)!
            .reshape([b, n, d])!

        self.out_proj.forward(out!)!
    }
}

/// Vision Transformer MLP
pub struct ViTMLP {
    /// First linear layer
    fc1: Linear,

    /// Second linear layer
    fc2: Linear,

    /// Activation function
    activation: GELU,

    /// Dropout
    dropout: Dropout,
}

impl ViTMLP {
    /// Create new MLP
    pub fn new(config: ViTConfig, device: Device) -> Self {
        Self {
            fc1: Linear::new(config.hidden_size, config.intermediate_size, true, device),
            fc2: Linear::new(config.intermediate_size, config.hidden_size, true, device),
            activation: GELU::new(),
            dropout: Dropout::new(config.dropout),
        }
    }

    /// Forward pass
    pub fn forward(self, x!: Tensor) -> Tensor! {
        let x! = self.fc1.forward(x!)!
        let x! = self.activation.forward(x!)!
        let x! = self.dropout.forward(x!)!
        let x! = self.fc2.forward(x!)!
        x!
    }
}

/// Complete Vision Transformer encoder
pub struct VisionTransformer {
    /// Configuration
    config: ViTConfig,

    /// Patch embedding
    patch_embed: PatchEmbed,

    /// CLS token (if used)
    cls_token?: Tensor,

    /// Positional encoding
    pos_encoding: PositionalEncoding,

    /// Transformer blocks
    blocks: [ViTBlock],

    /// Final layer norm
    ln_post: LayerNorm,

    /// Pooling layer (if needed)
    pooler?: AttentionPooler,
}

impl VisionTransformer {
    /// Create new Vision Transformer
    pub fn new(config: ViTConfig, device: Device) -> Self {
        let patch_embed = PatchEmbed::new(
            config.patch_size,
            config.num_channels,
            config.hidden_size,
            device,
        )

        let cls_token = if config.use_cls_token {
            Some(Tensor::normal([1, 1, config.hidden_size as i64], 0.0, 0.02, device))
        } else {
            None
        }

        let num_positions = config.num_patches() + if config.use_cls_token { 1 } else { 0 }

        let pos_encoding = match config.pos_encoding {
            PositionalEncodingType::Learned =>
                PositionalEncoding::learned(num_positions, config.hidden_size, device),
            PositionalEncodingType::RoPE2D =>
                PositionalEncoding::rope_2d(config.hidden_size, 32, device),
            _ =>
                PositionalEncoding::learned(num_positions, config.hidden_size, device),
        }

        let blocks = (0..config.num_layers)
            τ{ _ => ViTBlock::new(config, device) }

        let ln_post = LayerNorm::new(config.hidden_size, config.layer_norm_eps, device)

        let pooler = match config.pooling {
            PoolingStrategy::AttentionPool =>
                Some(AttentionPooler::new(config.hidden_size, config.num_heads, device)),
            _ => None,
        }

        Self {
            config,
            patch_embed,
            cls_token,
            pos_encoding,
            blocks,
            ln_post,
            pooler,
        }
    }

    /// Forward pass
    pub fn forward(self, pixels!: PixelValues) -> ImageFeatures! {
        // Patch embedding
        let patches! = self.patch_embed.forward(pixels!)!
        let grid_size! = patches!.grid_size!

        // Get embeddings
        let mut x! = patches!.embeddings!
        let b = x!.shape()[0]

        // Add CLS token if used
        if let Some(cls!) = self.cls_token {
            let cls_expanded! = cls!.expand([b, -1, -1])!
            x! = Tensor::cat([cls_expanded!, x!], dim: 1)!
        }

        // Add positional encoding
        x! = self.pos_encoding.forward(x!, grid_size!)!

        // Get RoPE frequencies if using RoPE
        let rope_freqs? = match self.config.pos_encoding {
            PositionalEncodingType::RoPE2D => self.pos_encoding.rope_freqs,
            _ => None,
        }

        // Apply transformer blocks
        for block in self.blocks {
            x! = block.forward(x!, rope_freqs?)!
        }

        // Post layer norm
        x! = self.ln_post.forward(x!)!

        // Apply pooling
        match self.config.pooling {
            PoolingStrategy::ClsToken => {
                let cls_out! = x!.slice([.., 0..1, ..])!.squeeze(1)!
                ImageFeatures!::pooled(cls_out!)
            }
            PoolingStrategy::MeanPool => {
                let pooled! = x!.mean(dim: 1)!
                ImageFeatures!::pooled(pooled!)
            }
            PoolingStrategy::AllTokens => {
                // Skip CLS token if present
                let features! = if self.cls_token.is_some() {
                    x!.slice([.., 1.., ..])!
                } else {
                    x!
                }
                ImageFeatures!::sequence(features!)
            }
            PoolingStrategy::AttentionPool => {
                let pooled! = self.pooler.unwrap().forward(x!)!
                ImageFeatures!::pooled(pooled!)
            }
        }
    }
}

/// Attention pooling layer
pub struct AttentionPooler {
    /// Query (single learnable vector)
    query: Tensor,

    /// Key projection
    k_proj: Linear,

    /// Value projection
    v_proj: Linear,

    /// Output projection
    out_proj: Linear,

    /// Number of heads
    num_heads: u32,
}

impl AttentionPooler {
    /// Create new attention pooler
    pub fn new(hidden_size: u32, num_heads: u32, device: Device) -> Self {
        Self {
            query: Tensor::normal([1, 1, hidden_size as i64], 0.0, 0.02, device),
            k_proj: Linear::new(hidden_size, hidden_size, true, device),
            v_proj: Linear::new(hidden_size, hidden_size, true, device),
            out_proj: Linear::new(hidden_size, hidden_size, true, device),
            num_heads,
        }
    }

    /// Forward pass
    pub fn forward(self, x!: Tensor) -> Tensor! {
        let b = x!.shape()[0]
        let d = x!.shape()[2]
        let head_dim = d / self.num_heads as i64

        // Query is learnable, expanded to batch
        let q! = self.query.expand([b, 1, d])!

        // Project K, V from input
        let k! = self.k_proj.forward(x!)!
        let v! = self.v_proj.forward(x!)!

        // Reshape for multi-head attention
        let q! = q!.reshape([b, 1, self.num_heads as i64, head_dim])!.transpose(1, 2)!
        let k! = k!.reshape([b, -1, self.num_heads as i64, head_dim])!.transpose(1, 2)!
        let v! = v!.reshape([b, -1, self.num_heads as i64, head_dim])!.transpose(1, 2)!

        // Scaled dot-product attention
        let scale = 1.0 / (head_dim as f32).sqrt()
        let scores! = (q! @ k!.transpose(-2, -1)!) * scale
        let weights! = scores!.softmax(-1)!
        let out! = weights! @ v!

        // Reshape and project output
        let out! = out!.transpose(1, 2)!.reshape([b, d])!
        self.out_proj.forward(out!)!
    }
}

// Helper functions
fn compute_rope_2d_freqs(head_dim: u32, max_size: u32, device: Device) -> Tensor {
    // Compute 2D RoPE frequencies for vision
    let dim = head_dim / 2
    let base = 10000.0_f32

    let freqs = (0..dim)
        τ{ i => base.powf(-2.0 * (i as f32) / dim as f32) }

    Tensor::from_vec(freqs, [dim as i64], device)
}

fn apply_rope_2d(q!: Tensor, k!: Tensor, freqs!: Tensor) -> (Tensor!, Tensor!)! {
    // Apply 2D rotary position embeddings
    // Implementation depends on grid structure
    let q_rot! = apply_rope_to_tensor(q!, freqs!)!
    let k_rot! = apply_rope_to_tensor(k!, freqs!)!
    (q_rot!, k_rot!)!
}

fn apply_rope_to_tensor(x!: Tensor, freqs!: Tensor) -> Tensor! {
    let (b, h, n, d) = (
        x!.shape()[0],
        x!.shape()[1],
        x!.shape()[2],
        x!.shape()[3],
    )

    // Split into pairs for rotation
    let x_reshape! = x!.reshape([b, h, n, d / 2, 2])!

    // Apply rotation using complex multiplication
    let cos! = freqs!.cos()!
    let sin! = freqs!.sin()!

    let x0! = x_reshape!.slice([.., .., .., .., 0])!
    let x1! = x_reshape!.slice([.., .., .., .., 1])!

    let rot0! = x0! * cos! - x1! * sin!
    let rot1! = x0! * sin! + x1! * cos!

    Tensor::stack([rot0!, rot1!], dim: -1)!.reshape([b, h, n, d])!
}
