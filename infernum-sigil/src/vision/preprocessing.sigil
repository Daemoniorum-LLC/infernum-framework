/// Image Preprocessing - Load, resize, normalize images for vision models
///
/// Handles the transformation from untrusted external image data (data~)
/// to verified pixel tensors (computed!) through a secure preprocessing pipeline.

use core::tensor::{Tensor, DType, Device}
use core::error::{Result, Error}
use vision::types::{
    ImageInput, ImageSource, ImageFormat, ImageDetail,
    PixelValues, AspectRatioBucket,
}

/// Image preprocessing configuration
pub struct PreprocessConfig {
    /// Target image size (height, width)
    pub image_size: (u32, u32),

    /// Patch size for vision transformer
    pub patch_size: u32,

    /// Normalization parameters
    pub normalization: NormalizationParams,

    /// Resize interpolation mode
    pub resize_mode: ResizeMode,

    /// Whether to use dynamic resolution (anyres)
    pub dynamic_resolution: bool,

    /// Maximum number of tiles for high-res
    pub max_tiles: u32,

    /// Whether to pad to square
    pub pad_to_square: bool,

    /// Background color for padding (RGB)
    pub pad_color: (f32, f32, f32),
}

impl PreprocessConfig {
    /// Default config for CLIP-style models
    pub fn clip_default() -> Self {
        Self {
            image_size: (224, 224),
            patch_size: 14,
            normalization: NormalizationParams::clip(),
            resize_mode: ResizeMode::Bicubic,
            dynamic_resolution: false,
            max_tiles: 1,
            pad_to_square: true,
            pad_color: (0.48145466, 0.4578275, 0.40821073),
        }
    }

    /// Config for SigLIP models
    pub fn siglip_default() -> Self {
        Self {
            image_size: (384, 384),
            patch_size: 14,
            normalization: NormalizationParams::siglip(),
            resize_mode: ResizeMode::Bicubic,
            dynamic_resolution: false,
            max_tiles: 1,
            pad_to_square: true,
            pad_color: (0.5, 0.5, 0.5),
        }
    }

    /// Config for LLaVA-style anyres models
    pub fn llava_anyres() -> Self {
        Self {
            image_size: (336, 336),
            patch_size: 14,
            normalization: NormalizationParams::clip(),
            resize_mode: ResizeMode::Bicubic,
            dynamic_resolution: true,
            max_tiles: 6,
            pad_to_square: false,
            pad_color: (0.0, 0.0, 0.0),
        }
    }

    /// Config for Qwen2-VL style
    pub fn qwen2_vl() -> Self {
        Self {
            image_size: (448, 448),
            patch_size: 14,
            normalization: NormalizationParams::openai(),
            resize_mode: ResizeMode::Bicubic,
            dynamic_resolution: true,
            max_tiles: 12,
            pad_to_square: false,
            pad_color: (0.0, 0.0, 0.0),
        }
    }
}

/// Normalization parameters for different models
pub struct NormalizationParams {
    /// Mean values per channel (RGB)
    pub mean: (f32, f32, f32),

    /// Standard deviation per channel (RGB)
    pub std: (f32, f32, f32),

    /// Whether to rescale from [0, 255] to [0, 1] before normalizing
    pub rescale: bool,
}

impl NormalizationParams {
    /// CLIP normalization (OpenAI)
    pub fn clip() -> Self {
        Self {
            mean: (0.48145466, 0.4578275, 0.40821073),
            std: (0.26862954, 0.26130258, 0.27577711),
            rescale: true,
        }
    }

    /// SigLIP normalization (Google)
    pub fn siglip() -> Self {
        Self {
            mean: (0.5, 0.5, 0.5),
            std: (0.5, 0.5, 0.5),
            rescale: true,
        }
    }

    /// OpenAI style (same as ImageNet)
    pub fn openai() -> Self {
        Self {
            mean: (0.485, 0.456, 0.406),
            std: (0.229, 0.224, 0.225),
            rescale: true,
        }
    }

    /// No normalization (identity)
    pub fn none() -> Self {
        Self {
            mean: (0.0, 0.0, 0.0),
            std: (1.0, 1.0, 1.0),
            rescale: true,
        }
    }
}

/// Resize interpolation modes
pub enum ResizeMode {
    /// Nearest neighbor (fastest)
    Nearest,

    /// Bilinear interpolation
    Bilinear,

    /// Bicubic interpolation (best quality)
    Bicubic,

    /// Lanczos resampling
    Lanczos,

    /// Area-based resampling (best for downscaling)
    Area,
}

/// Image preprocessor - transforms raw images to model inputs
pub struct ImagePreprocessor {
    /// Preprocessing configuration
    config: PreprocessConfig,

    /// Target device for tensors
    device: Device,

    /// Target dtype for tensors
    dtype: DType,
}

impl ImagePreprocessor {
    /// Create new preprocessor
    pub fn new(config: PreprocessConfig, device: Device, dtype: DType) -> Self {
        Self { config, device, dtype }
    }

    /// Create with CLIP defaults
    pub fn clip(device: Device) -> Self {
        Self::new(PreprocessConfig::clip_default(), device, DType::F32)
    }

    /// Create with SigLIP defaults
    pub fn siglip(device: Device) -> Self {
        Self::new(PreprocessConfig::siglip_default(), device, DType::F32)
    }

    /// Process a single image input
    /// Transforms untrusted data~ to verified computed! pixels
    pub fn process(self, input: ImageInput) -> Result<PixelValues!> {
        // Load raw pixels from source (untrusted)
        let raw_pixels~ = self.load_image(input.source~)?

        // Get original dimensions
        let original_size! = self.get_dimensions(raw_pixels~)!

        // Determine target size based on detail level
        let target_size! = self.compute_target_size(
            original_size!,
            input.detail,
        )!

        // Resize image
        let resized! = self.resize(raw_pixels~, target_size!)!

        // Apply padding if needed
        let padded! = if self.config.pad_to_square {
            self.pad_to_square(resized!)!
        } else {
            resized!
        }

        // Normalize pixel values
        let normalized! = self.normalize(padded!)!

        // Convert to tensor on target device
        let tensor! = self.to_tensor(normalized!)!

        Ok(PixelValues!::new(
            tensor!,
            original_size!,
            target_size!,
        ))
    }

    /// Process with anyres tiling for high-resolution images
    pub fn process_anyres(self, input: ImageInput) -> Result<PixelValues!> {
        // Load raw pixels
        let raw_pixels~ = self.load_image(input.source~)?

        let original_size! = self.get_dimensions(raw_pixels~)!
        let (orig_h, orig_w) = original_size!

        // Check if we need tiling
        let base_size = self.config.image_size.0

        if orig_h <= base_size && orig_w <= base_size {
            // Small image - process normally
            return self.process(input)
        }

        // Calculate optimal grid
        let (grid_h, grid_w) = self.compute_anyres_grid(orig_h, orig_w)!
        let num_tiles! = grid_h * grid_w

        // Limit tiles
        let (grid_h, grid_w) = if num_tiles! > self.config.max_tiles {
            self.reduce_grid(grid_h, grid_w, self.config.max_tiles)!
        } else {
            (grid_h, grid_w)
        }

        let num_tiles! = grid_h * grid_w

        // Resize to grid size
        let grid_size! = (grid_h * base_size, grid_w * base_size)
        let resized! = self.resize(raw_pixels~, grid_size!)!

        // Split into tiles
        let tiles! = self.split_into_tiles(resized!, grid_h, grid_w)!

        // Process each tile
        let processed_tiles! = tiles!
            τ{ tile! => self.normalize(tile!)! }
            τ{ tile! => self.to_tensor(tile!)! }!

        // Also create a low-res overview
        let overview! = self.resize(raw_pixels~, self.config.image_size)!
        let overview_normalized! = self.normalize(overview!)!
        let overview_tensor! = self.to_tensor(overview_normalized!)!

        // Stack tiles: [overview, tile1, tile2, ...]
        let all_tensors! = [overview_tensor!] ++ processed_tiles!
        let stacked! = Tensor::stack(all_tensors!, 0)!

        Ok(PixelValues!::tiled(
            stacked!,
            original_size!,
            grid_size!,
            num_tiles! + 1,  // +1 for overview
        ))
    }

    /// Process a batch of images
    pub fn process_batch(self, inputs: [ImageInput]) -> Result<PixelValues!> {
        let processed! = inputs
            τ{ input => self.process(input)? }!

        // Stack into batch
        let tensors! = processed!
            τ{ p! => p!.tensor! }!

        let stacked! = Tensor::stack(tensors!, 0)!

        // Use first image's sizes as reference
        let first! = processed!.first().unwrap()

        Ok(PixelValues! {
            tensor!: stacked!,
            original_size!: first!.original_size!,
            processed_size!: first!.processed_size!,
            num_tiles!: first!.num_tiles!,
        })
    }

    // ===== Internal methods =====

    /// Load image from source
    fn load_image(self, source~: ImageSource) -> Result<RawPixels~> {
        match source~ {
            ImageSource::Base64(data~) => {
                let bytes~ = base64_decode(data~)?
                decode_image_bytes(bytes~)
            }
            ImageSource::Url(url~) => {
                let bytes~ = fetch_url(url~)?
                decode_image_bytes(bytes~)
            }
            ImageSource::Path(path~) => {
                let bytes~ = read_file(path~)?
                decode_image_bytes(bytes~)
            }
            ImageSource::Tensor(tensor) => {
                Ok(RawPixels~::from_tensor(tensor))
            }
            ImageSource::Bytes { data~, format } => {
                decode_image_bytes_with_format(data~, format)
            }
        }
    }

    /// Get image dimensions
    fn get_dimensions(self, pixels~: RawPixels) -> (u32, u32)! {
        (pixels~.height() as u32, pixels~.width() as u32)!
    }

    /// Compute target size based on detail level
    fn compute_target_size(
        self,
        original!: (u32, u32),
        detail: ImageDetail,
    ) -> (u32, u32)! {
        let (h, w) = original!
        let base = self.config.image_size

        match detail {
            ImageDetail::Low => base,
            ImageDetail::High => {
                if self.config.dynamic_resolution {
                    self.compute_dynamic_size(h, w, 2048)!
                } else {
                    base
                }
            }
            ImageDetail::Auto => {
                if h > base.0 || w > base.1 {
                    self.compute_dynamic_size(h, w, 1024)!
                } else {
                    base
                }
            }
            ImageDetail::Custom { max_size } => {
                self.compute_dynamic_size(h, w, max_size)!
            }
        }
    }

    /// Compute size preserving aspect ratio
    fn compute_dynamic_size(self, h: u32, w: u32, max_size: u32) -> (u32, u32)! {
        let aspect = w as f32 / h as f32

        let (new_h, new_w) = if h > w {
            let new_h = max_size.min(h)
            let new_w = (new_h as f32 * aspect) as u32
            (new_h, new_w)
        } else {
            let new_w = max_size.min(w)
            let new_h = (new_w as f32 / aspect) as u32
            (new_h, new_w)
        }

        // Round to patch size
        let patch = self.config.patch_size
        let new_h = ((new_h + patch - 1) / patch) * patch
        let new_w = ((new_w + patch - 1) / patch) * patch

        (new_h, new_w)!
    }

    /// Compute grid for anyres
    fn compute_anyres_grid(self, h: u32, w: u32) -> (u32, u32)! {
        let base = self.config.image_size.0

        let grid_h = (h + base - 1) / base
        let grid_w = (w + base - 1) / base

        (grid_h, grid_w)!
    }

    /// Reduce grid to fit max tiles
    fn reduce_grid(self, h: u32, w: u32, max: u32) -> (u32, u32)! {
        let mut grid_h = h
        let mut grid_w = w

        while grid_h * grid_w > max {
            if grid_h > grid_w {
                grid_h -= 1
            } else {
                grid_w -= 1
            }
        }

        (grid_h.max(1), grid_w.max(1))!
    }

    /// Resize image
    fn resize(self, pixels~: RawPixels, size!: (u32, u32)) -> RawPixels! {
        let (h, w) = size!

        match self.config.resize_mode {
            ResizeMode::Nearest => pixels~.resize_nearest(h, w)!,
            ResizeMode::Bilinear => pixels~.resize_bilinear(h, w)!,
            ResizeMode::Bicubic => pixels~.resize_bicubic(h, w)!,
            ResizeMode::Lanczos => pixels~.resize_lanczos(h, w)!,
            ResizeMode::Area => pixels~.resize_area(h, w)!,
        }
    }

    /// Pad image to square
    fn pad_to_square(self, pixels!: RawPixels) -> RawPixels! {
        let h = pixels!.height()
        let w = pixels!.width()

        if h == w {
            return pixels!
        }

        let target = h.max(w)
        let pad_h = (target - h) / 2
        let pad_w = (target - w) / 2

        let (r, g, b) = self.config.pad_color

        pixels!.pad(
            pad_h, target - h - pad_h,  // top, bottom
            pad_w, target - w - pad_w,  // left, right
            r, g, b,
        )!
    }

    /// Split into tiles
    fn split_into_tiles(self, pixels!: RawPixels, grid_h: u32, grid_w: u32) -> [RawPixels!]! {
        let tile_h = pixels!.height() / grid_h
        let tile_w = pixels!.width() / grid_w

        let mut tiles: [RawPixels!] = []

        for row in 0..grid_h {
            for col in 0..grid_w {
                let y = row * tile_h
                let x = col * tile_w
                let tile! = pixels!.crop(x, y, tile_w, tile_h)!
                tiles.push(tile!)
            }
        }

        tiles!
    }

    /// Normalize pixel values
    fn normalize(self, pixels!: RawPixels) -> RawPixels! {
        let norm = self.config.normalization

        let mut result! = pixels!

        // Rescale from [0, 255] to [0, 1]
        if norm.rescale {
            result! = result!.scale(1.0 / 255.0)!
        }

        // Apply mean/std normalization per channel
        let (mean_r, mean_g, mean_b) = norm.mean
        let (std_r, std_g, std_b) = norm.std

        result!.normalize_channels(
            (mean_r, mean_g, mean_b),
            (std_r, std_g, std_b),
        )!
    }

    /// Convert to tensor
    fn to_tensor(self, pixels!: RawPixels) -> Tensor! {
        pixels!
            .to_tensor()!
            .to_device(self.device)!
            .to_dtype(self.dtype)!
    }
}

/// Raw pixel data (internal representation)
/// Marked as untrusted until fully processed
struct RawPixels~ {
    data~: [f32],
    height: u32,
    width: u32,
    channels: u32,
}

impl RawPixels~ {
    fn height(self~) -> u32 { self~.height }
    fn width(self~) -> u32 { self~.width }

    fn from_tensor(tensor: Tensor) -> Self~ {
        // Extract raw data from tensor
        let shape = tensor.shape()
        let data~ = tensor.to_vec()
        Self~ {
            data~,
            height: shape[1] as u32,
            width: shape[2] as u32,
            channels: shape[0] as u32,
        }
    }

    fn resize_bicubic(self~, h: u32, w: u32) -> Self! {
        // Bicubic interpolation implementation
        bicubic_resize(self~, h, w)!
    }

    fn resize_bilinear(self~, h: u32, w: u32) -> Self! {
        bilinear_resize(self~, h, w)!
    }

    fn resize_nearest(self~, h: u32, w: u32) -> Self! {
        nearest_resize(self~, h, w)!
    }

    fn resize_lanczos(self~, h: u32, w: u32) -> Self! {
        lanczos_resize(self~, h, w)!
    }

    fn resize_area(self~, h: u32, w: u32) -> Self! {
        area_resize(self~, h, w)!
    }

    fn pad(self!, top: u32, bottom: u32, left: u32, right: u32, r: f32, g: f32, b: f32) -> Self! {
        pad_image(self!, top, bottom, left, right, r, g, b)!
    }

    fn crop(self!, x: u32, y: u32, w: u32, h: u32) -> Self! {
        crop_image(self!, x, y, w, h)!
    }

    fn scale(self!, factor: f32) -> Self! {
        scale_pixels(self!, factor)!
    }

    fn normalize_channels(self!, mean: (f32, f32, f32), std: (f32, f32, f32)) -> Self! {
        normalize_channels(self!, mean, std)!
    }

    fn to_tensor(self!) -> Tensor! {
        Tensor::from_vec(
            self!.data,
            [self!.channels as i64, self!.height as i64, self!.width as i64],
        )!
    }
}

// External functions (implemented in backend)
extern fn base64_decode(data~: str) -> Result<[u8]~>
extern fn fetch_url(url~: str) -> Result<[u8]~>
extern fn read_file(path~: str) -> Result<[u8]~>
extern fn decode_image_bytes(bytes~: [u8]) -> Result<RawPixels~>
extern fn decode_image_bytes_with_format(bytes~: [u8], format: ImageFormat) -> Result<RawPixels~>
extern fn bicubic_resize(pixels~: RawPixels, h: u32, w: u32) -> RawPixels!
extern fn bilinear_resize(pixels~: RawPixels, h: u32, w: u32) -> RawPixels!
extern fn nearest_resize(pixels~: RawPixels, h: u32, w: u32) -> RawPixels!
extern fn lanczos_resize(pixels~: RawPixels, h: u32, w: u32) -> RawPixels!
extern fn area_resize(pixels~: RawPixels, h: u32, w: u32) -> RawPixels!
extern fn pad_image(pixels!: RawPixels, top: u32, bottom: u32, left: u32, right: u32, r: f32, g: f32, b: f32) -> RawPixels!
extern fn crop_image(pixels!: RawPixels, x: u32, y: u32, w: u32, h: u32) -> RawPixels!
extern fn scale_pixels(pixels!: RawPixels, factor: f32) -> RawPixels!
extern fn normalize_channels(pixels!: RawPixels, mean: (f32, f32, f32), std: (f32, f32, f32)) -> RawPixels!
