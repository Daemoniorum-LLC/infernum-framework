/// Vision Module - Multimodal Image Understanding & Generation
///
/// This module provides the foundation for vision-language models and
/// image generation capabilities using Sigil's evidentiality types
/// and morpheme operators for safe, performant image processing.
///
/// ## Components
///
/// - **encoder**: High-level image encoding API
/// - **preprocessing**: Image preprocessing pipeline
/// - **types**: Core vision types with evidentiality
/// - **vit**: Vision Transformer implementation
/// - **projector**: Multimodal projection layers
/// - **vlm**: Vision-Language Model integration

pub mod encoder
pub mod preprocessing
pub mod types
pub mod vit
pub mod projector
pub mod vlm

// Re-export core types
pub use encoder::{
    ImageEncoder,
    VisionArchitecture,
    VisionConfig,
    EncoderOutput,
}

pub use preprocessing::{
    ImagePreprocessor,
    PreprocessConfig,
    NormalizationParams,
    ResizeMode,
}

pub use types::{
    ImageInput,
    ImageSource,
    ImageDetail,
    PixelValues,
    PatchEmbeddings,
    ImageFeatures,
}

pub use vit::{
    VisionTransformer,
    ViTBlock,
    PatchEmbed,
    PositionalEncoding,
}

pub use projector::{
    MultimodalProjector,
    ProjectorType,
    ProjectorConfig,
}

pub use vlm::{
    VisionLanguageModel,
    VLMArchitecture,
    VLMConfig,
    VLMResponse,
    VLMTokenStream,
    VLMStreamChunk,
    PreparedMultimodalInput,
}
