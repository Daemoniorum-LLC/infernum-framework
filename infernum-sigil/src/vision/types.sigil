/// Vision Types - Core data structures for image processing
///
/// Uses Sigil's evidentiality types to track image data provenance:
/// - `data~` for untrusted external image inputs
/// - `found?` for optional/nullable image data
/// - `computed!` for verified tensor outputs

use core::tensor::{Tensor, DType, Device}
use core::error::Result

/// Input image from external source - marked as untrusted data
pub struct ImageInput {
    /// Image source - untrusted external data
    source~: ImageSource,

    /// Processing detail level
    detail: ImageDetail,

    /// Optional aspect ratio override
    aspect_ratio?: (u32, u32),
}

/// Image source variants - all marked as external data
pub enum ImageSource {
    /// Base64 encoded image data
    Base64(str~),

    /// URL to fetch image from
    Url(str~),

    /// Local filesystem path
    Path(str~),

    /// Raw pixel tensor (already loaded)
    Tensor(Tensor),

    /// PIL-style image bytes with format
    Bytes {
        data~: [u8],
        format: ImageFormat,
    },
}

/// Supported image formats
pub enum ImageFormat {
    PNG,
    JPEG,
    WebP,
    BMP,
    GIF,
    TIFF,
    AVIF,
}

/// Detail level for image processing
/// Controls resolution and token count
pub enum ImageDetail {
    /// Low resolution: 512x512, ~85 tokens
    Low,

    /// High resolution: up to 2048x2048, tiled
    High,

    /// Auto-select based on image size
    Auto,

    /// Custom resolution with max dimension
    Custom { max_size: u32 },
}

/// Decoded pixel values - verified after preprocessing
pub struct PixelValues! {
    /// Normalized pixel tensor [B, C, H, W]
    tensor!: Tensor,

    /// Original image dimensions before resize
    original_size!: (u32, u32),

    /// Actual size after preprocessing
    processed_size!: (u32, u32),

    /// Number of tiles (for high-res processing)
    num_tiles!: u32,
}

impl PixelValues! {
    /// Create verified pixel values from tensor
    pub fn new(
        tensor!: Tensor,
        original_size!: (u32, u32),
        processed_size!: (u32, u32),
    ) -> Self! {
        Self! {
            tensor!,
            original_size!,
            processed_size!,
            num_tiles!: 1,
        }
    }

    /// Create tiled pixel values for high-resolution images
    pub fn tiled(
        tensor!: Tensor,
        original_size!: (u32, u32),
        processed_size!: (u32, u32),
        num_tiles!: u32,
    ) -> Self! {
        Self! {
            tensor!,
            original_size!,
            processed_size!,
            num_tiles!,
        }
    }

    /// Get batch size
    pub fn batch_size(self!) -> u32! {
        self!.tensor!.shape()[0] as u32
    }

    /// Get number of channels
    pub fn channels(self!) -> u32! {
        self!.tensor!.shape()[1] as u32
    }

    /// Get height
    pub fn height(self!) -> u32! {
        self!.tensor!.shape()[2] as u32
    }

    /// Get width
    pub fn width(self!) -> u32! {
        self!.tensor!.shape()[3] as u32
    }
}

/// Patch embeddings from vision encoder
pub struct PatchEmbeddings! {
    /// Embedded patches [B, N, D] where N = num_patches
    embeddings!: Tensor,

    /// Grid size (patches per dimension)
    grid_size!: (u32, u32),

    /// Patch size used
    patch_size!: u32,

    /// Hidden dimension
    hidden_dim!: u32,
}

impl PatchEmbeddings! {
    /// Number of patches
    pub fn num_patches(self!) -> u32! {
        self!.grid_size!.0 * self!.grid_size!.1
    }

    /// Reshape to 2D grid [B, H, W, D]
    pub fn to_grid(self!) -> Tensor! {
        let (b, n, d) = (
            self!.embeddings!.shape()[0],
            self!.embeddings!.shape()[1],
            self!.embeddings!.shape()[2],
        )
        let (h, w) = self!.grid_size!

        self!.embeddings!
            .reshape([b, h as i64, w as i64, d])!
    }
}

/// Final image features from vision encoder
pub struct ImageFeatures! {
    /// Feature tensor [B, N, D] or [B, D] for pooled
    features!: Tensor,

    /// Whether features are pooled (single vector per image)
    is_pooled!: bool,

    /// Attention mask for variable-length sequences
    attention_mask?: Tensor,

    /// Optional CLS token features
    cls_features?: Tensor,
}

impl ImageFeatures! {
    /// Create sequence features (per-patch)
    pub fn sequence(features!: Tensor) -> Self! {
        Self! {
            features!,
            is_pooled!: false,
            attention_mask?: None,
            cls_features?: None,
        }
    }

    /// Create pooled features (single vector)
    pub fn pooled(features!: Tensor) -> Self! {
        Self! {
            features!,
            is_pooled!: true,
            attention_mask?: None,
            cls_features?: None,
        }
    }

    /// Add CLS token features
    pub fn with_cls(self!, cls!: Tensor) -> Self! {
        Self! {
            cls_features?: Some(cls!),
            ..self!
        }
    }

    /// Add attention mask
    pub fn with_mask(self!, mask!: Tensor) -> Self! {
        Self! {
            attention_mask?: Some(mask!),
            ..self!
        }
    }

    /// Get hidden dimension
    pub fn hidden_dim(self!) -> u32! {
        self!.features!.shape().last().unwrap() as u32
    }

    /// Get sequence length (or 1 if pooled)
    pub fn seq_len(self!) -> u32! {
        if self!.is_pooled! {
            1
        } else {
            self!.features!.shape()[1] as u32
        }
    }
}

/// Image aspect ratio bucket for efficient batching
pub struct AspectRatioBucket {
    /// Width ratio component
    width_ratio: u32,

    /// Height ratio component
    height_ratio: u32,

    /// Target resolution for this bucket
    target_size: (u32, u32),
}

impl AspectRatioBucket {
    /// Common aspect ratio buckets for vision models
    pub fn standard_buckets() -> [Self] {
        [
            Self { width_ratio: 1, height_ratio: 1, target_size: (384, 384) },   // Square
            Self { width_ratio: 4, height_ratio: 3, target_size: (512, 384) },   // Landscape
            Self { width_ratio: 3, height_ratio: 4, target_size: (384, 512) },   // Portrait
            Self { width_ratio: 16, height_ratio: 9, target_size: (672, 384) },  // Wide
            Self { width_ratio: 9, height_ratio: 16, target_size: (384, 672) },  // Tall
        ]
    }

    /// Find best matching bucket for image dimensions
    pub fn find_best(width: u32, height: u32, buckets: [Self]) -> Self {
        let aspect = width as f32 / height as f32

        buckets
            τ{ bucket =>
                let bucket_aspect = bucket.width_ratio as f32 / bucket.height_ratio as f32
                let diff = (aspect - bucket_aspect).abs()
                (bucket, diff)
            }
            σ{ |(_, diff_a), (_, diff_b)| diff_a.partial_cmp(diff_b) }
            .first()
            .map(|(bucket, _)| bucket)
            .unwrap_or(buckets[0])
    }
}

/// Multimodal content that can contain text and images
pub struct MultimodalContent {
    /// Ordered content parts
    parts~: [ContentPart],
}

/// A single part of multimodal content
pub enum ContentPart {
    /// Text content
    Text(str~),

    /// Image content
    Image(ImageInput),

    /// Video content (future)
    Video(VideoInput),
}

/// Video input placeholder for Phase 4
pub struct VideoInput {
    /// Video source
    source~: VideoSource,

    /// Frame sampling configuration
    sampling: FrameSampling,
}

/// Video source variants
pub enum VideoSource {
    Path(str~),
    Url(str~),
    Frames([ImageInput]),
}

/// Frame sampling strategy for video
pub enum FrameSampling {
    /// Uniform sampling of N frames
    Uniform { num_frames: u32 },

    /// Sample at specific FPS
    Fps { target_fps: f32 },

    /// Key frames only
    Keyframes,

    /// First and last frame
    FirstLast,
}

impl MultimodalContent {
    /// Create new multimodal content
    pub fn new() -> Self {
        Self { parts~: [] }
    }

    /// Add text content
    pub fn add_text(self, text~: str) -> Self {
        let mut parts = self.parts~
        parts.push(ContentPart::Text(text~))
        Self { parts~: parts }
    }

    /// Add image content
    pub fn add_image(self, image: ImageInput) -> Self {
        let mut parts = self.parts~
        parts.push(ContentPart::Image(image))
        Self { parts~: parts }
    }

    /// Count images in content
    pub fn image_count(self) -> u32 {
        self.parts~
            φ{ part => matches!(part, ContentPart::Image(_)) }
            .len() as u32
    }

    /// Extract all images
    pub fn images(self) -> [ImageInput] {
        self.parts~
            φ{ part => matches!(part, ContentPart::Image(_)) }
            τ{ part =>
                match part {
                    ContentPart::Image(img) => img,
                    _ => unreachable!(),
                }
            }
    }

    /// Check if content is text-only
    pub fn is_text_only(self) -> bool {
        self.parts~
            .iter()
            .all(|part| matches!(part, ContentPart::Text(_)))
    }
}
