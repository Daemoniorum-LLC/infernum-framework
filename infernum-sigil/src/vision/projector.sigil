/// Multimodal Projector - Bridge between vision encoder and LLM
///
/// Projects image features from vision encoder dimension to LLM hidden dimension,
/// enabling seamless integration of visual information into language models.

use core::tensor::{Tensor, DType, Device}
use core::error::Result
use core::nn::{Linear, LayerNorm, GELU, Conv2d}
use vision::types::ImageFeatures

/// Projector architecture types
pub enum ProjectorType {
    /// Simple linear projection
    Linear,

    /// Two-layer MLP (LLaVA-1.5 style)
    MLP,

    /// Perceiver resampler (Flamingo/Idefics style)
    Perceiver { num_latents: u32 },

    /// C-Abstractor (Honeybee style)
    CAbstractor { num_queries: u32 },

    /// Spatial merge (Qwen-VL style)
    SpatialMerge { merge_size: u32 },

    /// Pixel shuffle (InternVL style)
    PixelShuffle { downsample_ratio: u32 },

    /// Attention pooling + MLP
    AttentionPoolMLP,
}

/// Projector configuration
pub struct ProjectorConfig {
    /// Projector type
    pub projector_type: ProjectorType,

    /// Vision encoder hidden dimension
    pub vision_hidden_size: u32,

    /// LLM hidden dimension
    pub llm_hidden_size: u32,

    /// Intermediate dimension (for MLP)
    pub intermediate_size?: u32,

    /// Dropout probability
    pub dropout: f32,

    /// Number of attention heads (for attention-based projectors)
    pub num_heads?: u32,

    /// Layer norm epsilon
    pub layer_norm_eps: f32,
}

impl ProjectorConfig {
    /// LLaVA-1.5 style MLP projector
    pub fn llava_mlp(vision_dim: u32, llm_dim: u32) -> Self {
        Self {
            projector_type: ProjectorType::MLP,
            vision_hidden_size: vision_dim,
            llm_hidden_size: llm_dim,
            intermediate_size: Some(llm_dim),
            dropout: 0.0,
            num_heads: None,
            layer_norm_eps: 1e-5,
        }
    }

    /// Qwen-VL style spatial merge
    pub fn qwen_vl(vision_dim: u32, llm_dim: u32) -> Self {
        Self {
            projector_type: ProjectorType::SpatialMerge { merge_size: 2 },
            vision_hidden_size: vision_dim,
            llm_hidden_size: llm_dim,
            intermediate_size: None,
            dropout: 0.0,
            num_heads: None,
            layer_norm_eps: 1e-6,
        }
    }

    /// InternVL style pixel shuffle
    pub fn internvl(vision_dim: u32, llm_dim: u32) -> Self {
        Self {
            projector_type: ProjectorType::PixelShuffle { downsample_ratio: 2 },
            vision_hidden_size: vision_dim,
            llm_hidden_size: llm_dim,
            intermediate_size: Some(llm_dim),
            dropout: 0.0,
            num_heads: None,
            layer_norm_eps: 1e-6,
        }
    }

    /// Perceiver resampler
    pub fn perceiver(vision_dim: u32, llm_dim: u32, num_latents: u32) -> Self {
        Self {
            projector_type: ProjectorType::Perceiver { num_latents },
            vision_hidden_size: vision_dim,
            llm_hidden_size: llm_dim,
            intermediate_size: Some(llm_dim * 4),
            dropout: 0.0,
            num_heads: Some(16),
            layer_norm_eps: 1e-5,
        }
    }
}

/// Multimodal projector - maps vision features to LLM space
pub struct MultimodalProjector {
    /// Configuration
    config: ProjectorConfig,

    /// Projector implementation
    inner: ProjectorImpl,
}

/// Internal projector implementations
enum ProjectorImpl {
    Linear(LinearProjector),
    MLP(MLPProjector),
    Perceiver(PerceiverProjector),
    CAbstractor(CAbstractorProjector),
    SpatialMerge(SpatialMergeProjector),
    PixelShuffle(PixelShuffleProjector),
    AttentionPoolMLP(AttentionPoolMLPProjector),
}

impl MultimodalProjector {
    /// Create new projector
    pub fn new(config: ProjectorConfig, device: Device) -> Self {
        let inner = match config.projector_type {
            ProjectorType::Linear =>
                ProjectorImpl::Linear(LinearProjector::new(config, device)),

            ProjectorType::MLP =>
                ProjectorImpl::MLP(MLPProjector::new(config, device)),

            ProjectorType::Perceiver { num_latents } =>
                ProjectorImpl::Perceiver(PerceiverProjector::new(config, num_latents, device)),

            ProjectorType::CAbstractor { num_queries } =>
                ProjectorImpl::CAbstractor(CAbstractorProjector::new(config, num_queries, device)),

            ProjectorType::SpatialMerge { merge_size } =>
                ProjectorImpl::SpatialMerge(SpatialMergeProjector::new(config, merge_size, device)),

            ProjectorType::PixelShuffle { downsample_ratio } =>
                ProjectorImpl::PixelShuffle(PixelShuffleProjector::new(config, downsample_ratio, device)),

            ProjectorType::AttentionPoolMLP =>
                ProjectorImpl::AttentionPoolMLP(AttentionPoolMLPProjector::new(config, device)),
        }

        Self { config, inner }
    }

    /// Create LLaVA-style MLP projector
    pub fn llava(vision_dim: u32, llm_dim: u32, device: Device) -> Self {
        Self::new(ProjectorConfig::llava_mlp(vision_dim, llm_dim), device)
    }

    /// Create Qwen-VL style projector
    pub fn qwen_vl(vision_dim: u32, llm_dim: u32, device: Device) -> Self {
        Self::new(ProjectorConfig::qwen_vl(vision_dim, llm_dim), device)
    }

    /// Project vision features to LLM hidden space
    pub fn forward(self, features!: ImageFeatures) -> Tensor! {
        match self.inner {
            ProjectorImpl::Linear(p) => p.forward(features!)!,
            ProjectorImpl::MLP(p) => p.forward(features!)!,
            ProjectorImpl::Perceiver(p) => p.forward(features!)!,
            ProjectorImpl::CAbstractor(p) => p.forward(features!)!,
            ProjectorImpl::SpatialMerge(p) => p.forward(features!)!,
            ProjectorImpl::PixelShuffle(p) => p.forward(features!)!,
            ProjectorImpl::AttentionPoolMLP(p) => p.forward(features!)!,
        }
    }

    /// Get output sequence length for given input
    pub fn output_seq_len(self, input_seq_len: u32) -> u32 {
        match self.config.projector_type {
            ProjectorType::Linear => input_seq_len,
            ProjectorType::MLP => input_seq_len,
            ProjectorType::Perceiver { num_latents } => num_latents,
            ProjectorType::CAbstractor { num_queries } => num_queries,
            ProjectorType::SpatialMerge { merge_size } => input_seq_len / (merge_size * merge_size),
            ProjectorType::PixelShuffle { downsample_ratio } =>
                input_seq_len / (downsample_ratio * downsample_ratio),
            ProjectorType::AttentionPoolMLP => 1,
        }
    }
}

/// Simple linear projection
struct LinearProjector {
    linear: Linear,
}

impl LinearProjector {
    fn new(config: ProjectorConfig, device: Device) -> Self {
        Self {
            linear: Linear::new(
                config.vision_hidden_size,
                config.llm_hidden_size,
                true,
                device,
            ),
        }
    }

    fn forward(self, features!: ImageFeatures) -> Tensor! {
        self.linear.forward(features!.features!)!
    }
}

/// Two-layer MLP projector (LLaVA-1.5 style)
struct MLPProjector {
    fc1: Linear,
    activation: GELU,
    fc2: Linear,
}

impl MLPProjector {
    fn new(config: ProjectorConfig, device: Device) -> Self {
        let intermediate = config.intermediate_size.unwrap_or(config.llm_hidden_size)

        Self {
            fc1: Linear::new(config.vision_hidden_size, intermediate, true, device),
            activation: GELU::new(),
            fc2: Linear::new(intermediate, config.llm_hidden_size, true, device),
        }
    }

    fn forward(self, features!: ImageFeatures) -> Tensor! {
        let x! = features!.features!
        let x! = self.fc1.forward(x!)!
        let x! = self.activation.forward(x!)!
        self.fc2.forward(x!)!
    }
}

/// Perceiver resampler (Flamingo style)
struct PerceiverProjector {
    /// Learnable latent queries
    latents: Tensor,

    /// Cross-attention layers
    layers: [PerceiverLayer],

    /// Output projection
    out_proj: Linear,

    /// Layer norm
    ln: LayerNorm,

    num_latents: u32,
}

impl PerceiverProjector {
    fn new(config: ProjectorConfig, num_latents: u32, device: Device) -> Self {
        let latents = Tensor::normal(
            [1, num_latents as i64, config.vision_hidden_size as i64],
            0.0, 0.02, device
        )

        let num_heads = config.num_heads.unwrap_or(8)
        let num_layers = 2

        let layers = (0..num_layers)
            τ{ _ => PerceiverLayer::new(config.vision_hidden_size, num_heads, device) }

        let out_proj = Linear::new(
            config.vision_hidden_size,
            config.llm_hidden_size,
            true, device
        )

        let ln = LayerNorm::new(config.llm_hidden_size, config.layer_norm_eps, device)

        Self { latents, layers, out_proj, ln, num_latents }
    }

    fn forward(self, features!: ImageFeatures) -> Tensor! {
        let b = features!.features!.shape()[0]

        // Expand latents to batch size
        let mut x! = self.latents.expand([b, -1, -1])!
        let context! = features!.features!

        // Apply perceiver layers
        for layer in self.layers {
            x! = layer.forward(x!, context!)!
        }

        // Project to LLM dimension
        let x! = self.out_proj.forward(x!)!
        self.ln.forward(x!)!
    }
}

/// Single Perceiver layer with cross-attention
struct PerceiverLayer {
    ln1: LayerNorm,
    cross_attn: CrossAttention,
    ln2: LayerNorm,
    mlp: MLP,
}

impl PerceiverLayer {
    fn new(hidden_size: u32, num_heads: u32, device: Device) -> Self {
        Self {
            ln1: LayerNorm::new(hidden_size, 1e-5, device),
            cross_attn: CrossAttention::new(hidden_size, num_heads, device),
            ln2: LayerNorm::new(hidden_size, 1e-5, device),
            mlp: MLP::new(hidden_size, hidden_size * 4, device),
        }
    }

    fn forward(self, x!: Tensor, context!: Tensor) -> Tensor! {
        // Cross-attention with residual
        let attn_out! = self.cross_attn.forward(self.ln1.forward(x!)!, context!)!
        let x! = x! + attn_out!

        // MLP with residual
        let mlp_out! = self.mlp.forward(self.ln2.forward(x!)!)!
        x! + mlp_out!
    }
}

/// Cross-attention layer
struct CrossAttention {
    q_proj: Linear,
    k_proj: Linear,
    v_proj: Linear,
    out_proj: Linear,
    num_heads: u32,
    head_dim: u32,
}

impl CrossAttention {
    fn new(hidden_size: u32, num_heads: u32, device: Device) -> Self {
        let head_dim = hidden_size / num_heads
        Self {
            q_proj: Linear::new(hidden_size, hidden_size, true, device),
            k_proj: Linear::new(hidden_size, hidden_size, true, device),
            v_proj: Linear::new(hidden_size, hidden_size, true, device),
            out_proj: Linear::new(hidden_size, hidden_size, true, device),
            num_heads,
            head_dim,
        }
    }

    fn forward(self, x!: Tensor, context!: Tensor) -> Tensor! {
        let (b, n, d) = (x!.shape()[0], x!.shape()[1], x!.shape()[2])
        let m = context!.shape()[1]

        // Q from x, K/V from context
        let q! = self.q_proj.forward(x!)!
        let k! = self.k_proj.forward(context!)!
        let v! = self.v_proj.forward(context!)!

        // Reshape for multi-head
        let q! = q!.reshape([b, n, self.num_heads as i64, self.head_dim as i64])!.transpose(1, 2)!
        let k! = k!.reshape([b, m, self.num_heads as i64, self.head_dim as i64])!.transpose(1, 2)!
        let v! = v!.reshape([b, m, self.num_heads as i64, self.head_dim as i64])!.transpose(1, 2)!

        // Attention
        let scale = 1.0 / (self.head_dim as f32).sqrt()
        let scores! = (q! @ k!.transpose(-2, -1)!) * scale
        let weights! = scores!.softmax(-1)!
        let out! = weights! @ v!

        // Reshape and project
        let out! = out!.transpose(1, 2)!.reshape([b, n, d])!
        self.out_proj.forward(out!)!
    }
}

/// C-Abstractor projector (Honeybee style)
struct CAbstractorProjector {
    /// Learnable queries
    queries: Tensor,

    /// Convolutional layers for local features
    conv_layers: [Conv2d],

    /// Cross-attention layers
    attn_layers: [CrossAttention],

    /// Output projection
    out_proj: Linear,

    num_queries: u32,
}

impl CAbstractorProjector {
    fn new(config: ProjectorConfig, num_queries: u32, device: Device) -> Self {
        let queries = Tensor::normal(
            [1, num_queries as i64, config.vision_hidden_size as i64],
            0.0, 0.02, device
        )

        let conv_layers = [
            Conv2d::new(config.vision_hidden_size, config.vision_hidden_size, 3, 1, 1, device),
            Conv2d::new(config.vision_hidden_size, config.vision_hidden_size, 3, 1, 1, device),
        ]

        let num_heads = config.num_heads.unwrap_or(8)
        let attn_layers = [
            CrossAttention::new(config.vision_hidden_size, num_heads, device),
            CrossAttention::new(config.vision_hidden_size, num_heads, device),
        ]

        let out_proj = Linear::new(
            config.vision_hidden_size,
            config.llm_hidden_size,
            true, device
        )

        Self { queries, conv_layers, attn_layers, out_proj, num_queries }
    }

    fn forward(self, features!: ImageFeatures) -> Tensor! {
        // This requires knowing the grid size - simplified implementation
        let x! = features!.features!
        let b = x!.shape()[0]

        // Apply cross-attention with queries
        let mut q! = self.queries.expand([b, -1, -1])!

        for attn in self.attn_layers {
            q! = attn.forward(q!, x!)!
        }

        self.out_proj.forward(q!)!
    }
}

/// Spatial merge projector (Qwen-VL style)
struct SpatialMergeProjector {
    /// Merge convolution
    merge_conv: Conv2d,

    /// Layer norm
    ln: LayerNorm,

    /// Output MLP
    mlp: MLP,

    merge_size: u32,
}

impl SpatialMergeProjector {
    fn new(config: ProjectorConfig, merge_size: u32, device: Device) -> Self {
        let merged_dim = config.vision_hidden_size * merge_size * merge_size

        Self {
            merge_conv: Conv2d::new(
                config.vision_hidden_size,
                config.llm_hidden_size,
                merge_size,
                merge_size,
                0,
                device
            ),
            ln: LayerNorm::new(config.llm_hidden_size, config.layer_norm_eps, device),
            mlp: MLP::new(config.llm_hidden_size, config.llm_hidden_size * 4, device),
            merge_size,
        }
    }

    fn forward(self, features!: ImageFeatures) -> Tensor! {
        let x! = features!.features!
        let (b, n, d) = (x!.shape()[0], x!.shape()[1], x!.shape()[2])

        // Assume square grid
        let grid_size = (n as f32).sqrt() as i64

        // Reshape to 2D grid: [B, H, W, D] -> [B, D, H, W]
        let x! = x!.reshape([b, grid_size, grid_size, d])!.permute([0, 3, 1, 2])!

        // Apply merge convolution
        let x! = self.merge_conv.forward(x!)!

        // Reshape back to sequence: [B, D', H', W'] -> [B, N', D']
        let (_, d_new, h_new, w_new) = (
            x!.shape()[0], x!.shape()[1], x!.shape()[2], x!.shape()[3]
        )
        let x! = x!.permute([0, 2, 3, 1])!.reshape([b, h_new * w_new, d_new])!

        // Layer norm and MLP
        let x! = self.ln.forward(x!)!
        self.mlp.forward(x!)!
    }
}

/// Pixel shuffle projector (InternVL style)
struct PixelShuffleProjector {
    /// First MLP
    mlp1: MLP,

    /// Pixel unshuffle
    downsample_ratio: u32,

    /// Second MLP
    mlp2: MLP,

    /// Layer norm
    ln: LayerNorm,
}

impl PixelShuffleProjector {
    fn new(config: ProjectorConfig, downsample_ratio: u32, device: Device) -> Self {
        let expanded_dim = config.vision_hidden_size * downsample_ratio * downsample_ratio

        Self {
            mlp1: MLP::new(config.vision_hidden_size, config.vision_hidden_size * 4, device),
            downsample_ratio,
            mlp2: MLP::new(expanded_dim, config.llm_hidden_size, device),
            ln: LayerNorm::new(config.llm_hidden_size, config.layer_norm_eps, device),
        }
    }

    fn forward(self, features!: ImageFeatures) -> Tensor! {
        let x! = features!.features!
        let (b, n, d) = (x!.shape()[0], x!.shape()[1], x!.shape()[2])

        // First MLP
        let x! = self.mlp1.forward(x!)!

        // Pixel unshuffle (combine adjacent patches)
        let grid_size = (n as f32).sqrt() as i64
        let x! = x!.reshape([b, grid_size, grid_size, d])!

        let ratio = self.downsample_ratio as i64
        let new_grid = grid_size / ratio

        // Reshape to combine spatial patches
        let x! = x!
            .reshape([b, new_grid, ratio, new_grid, ratio, d])!
            .permute([0, 1, 3, 2, 4, 5])!
            .reshape([b, new_grid * new_grid, d * ratio * ratio])!

        // Second MLP
        let x! = self.mlp2.forward(x!)!
        self.ln.forward(x!)!
    }
}

/// Attention pool + MLP projector
struct AttentionPoolMLPProjector {
    /// Learnable query
    query: Tensor,

    /// Cross-attention
    cross_attn: CrossAttention,

    /// MLP
    mlp: MLP,

    /// Layer norm
    ln: LayerNorm,
}

impl AttentionPoolMLPProjector {
    fn new(config: ProjectorConfig, device: Device) -> Self {
        let num_heads = config.num_heads.unwrap_or(8)

        Self {
            query: Tensor::normal([1, 1, config.vision_hidden_size as i64], 0.0, 0.02, device),
            cross_attn: CrossAttention::new(config.vision_hidden_size, num_heads, device),
            mlp: MLP::new(config.vision_hidden_size, config.llm_hidden_size, device),
            ln: LayerNorm::new(config.llm_hidden_size, config.layer_norm_eps, device),
        }
    }

    fn forward(self, features!: ImageFeatures) -> Tensor! {
        let b = features!.features!.shape()[0]

        // Expand query to batch
        let q! = self.query.expand([b, 1, -1])!

        // Cross-attention pooling
        let pooled! = self.cross_attn.forward(q!, features!.features!)!

        // MLP and layer norm
        let x! = self.mlp.forward(pooled!)!
        self.ln.forward(x!)!
    }
}

/// Simple MLP helper
struct MLP {
    fc1: Linear,
    activation: GELU,
    fc2: Linear,
}

impl MLP {
    fn new(in_dim: u32, out_dim: u32, device: Device) -> Self {
        let intermediate = in_dim * 4

        Self {
            fc1: Linear::new(in_dim, intermediate, true, device),
            activation: GELU::new(),
            fc2: Linear::new(intermediate, out_dim, true, device),
        }
    }

    fn forward(self, x!: Tensor) -> Tensor! {
        let x! = self.fc1.forward(x!)!
        let x! = self.activation.forward(x!)!
        self.fc2.forward(x!)!
    }
}
