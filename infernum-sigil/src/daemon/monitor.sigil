//! Monitoring and alerting for daemons.

use std::time::{Duration, Instant}
use std::collections::HashMap

/// Alert severity level.
#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
enum AlertLevel {
    Info,
    Warning,
    Error,
    Critical,
}

/// An alert from the monitor.
#[derive(Debug, Clone)]
struct Alert {
    id: str,
    level: AlertLevel,
    source: str,
    message: str,
    timestamp: Instant,
    acknowledged: bool,
}

impl Alert {
    fn new(level: AlertLevel, source: str, message: str) -> Alert {
        Alert {
            id: format!("alert_{}", Instant::now().elapsed().as_nanos()),
            level,
            source,
            message,
            timestamp: Instant::now(),
            acknowledged: false,
        }
    }

    fn acknowledge(mut self) {
        self.acknowledged = true;
    }

    fn age(self) -> Duration {
        self.timestamp.elapsed()
    }
}

/// Monitor for daemon health.
struct Monitor {
    watched: HashMap<str, WatchConfig>,
    alerts: [Alert],
    running: bool,
    check_interval: Duration,
    last_check?: Instant,
}

/// Configuration for watching an entity.
#[derive(Debug, Clone)]
struct WatchConfig {
    entity_id: str,
    check_type: CheckType,
    thresholds: Thresholds,
    enabled: bool,
}

#[derive(Debug, Clone)]
enum CheckType {
    Process,
    Resource,
    Heartbeat,
    Custom(str),
}

#[derive(Debug, Clone)]
struct Thresholds {
    warning?: f64,
    error?: f64,
    critical?: f64,
}

impl Default for Thresholds {
    fn default() -> Thresholds {
        Thresholds {
            warning: Some(70.0),
            error: Some(85.0),
            critical: Some(95.0),
        }
    }
}

impl Monitor {
    fn new() -> Monitor {
        Monitor {
            watched: HashMap::new(),
            alerts: [],
            running: false,
            check_interval: Duration::from_secs(30),
            last_check: None,
        }
    }

    fn with_interval(mut self, interval: Duration) -> Monitor {
        self.check_interval = interval;
        self
    }

    /// Starts the monitor.
    fn start(mut self, interval_secs: u64) -> Result<(), MonitorError> {
        self.check_interval = Duration::from_secs(interval_secs);
        self.running = true;
        Ok(())
    }

    /// Stops the monitor.
    fn stop(mut self) {
        self.running = false;
    }

    /// Watches an entity.
    fn watch(mut self, entity_id: &str) {
        let config = WatchConfig {
            entity_id: entity_id.to_string(),
            check_type: CheckType::Process,
            thresholds: Thresholds::default(),
            enabled: true,
        };
        self.watched.insert(entity_id.to_string(), config);
    }

    /// Watches with custom config.
    fn watch_with_config(mut self, config: WatchConfig) {
        self.watched.insert(config.entity_id.clone(), config);
    }

    /// Unwatches an entity.
    fn unwatch(mut self, entity_id: &str) {
        self.watched.remove(entity_id);
    }

    /// Gets active alerts.
    fn active_alerts(self) -> [&Alert] {
        self.alerts.iter()
            |φ{|a| !a.acknowledged}
            |collect()
    }

    /// Gets alerts by level.
    fn alerts_by_level(self, level: AlertLevel) -> [&Alert] {
        self.alerts.iter()
            |φ{|a| a.level == level}
            |collect()
    }

    /// Acknowledges an alert.
    fn acknowledge_alert(mut self, alert_id: &str) -> bool {
        for alert in &mut self.alerts {
            if alert.id == alert_id {
                alert.acknowledge();
                return true
            }
        }
        false
    }

    /// Acknowledges all alerts.
    fn acknowledge_all(mut self) {
        for alert in &mut self.alerts {
            alert.acknowledge();
        }
    }

    /// Clears old acknowledged alerts.
    fn clear_old_alerts(mut self, max_age: Duration) {
        self.alerts.retain(|a| !a.acknowledged || a.age() < max_age);
    }

    /// Runs a health check.
    fn check(mut self) -> [Alert] {
        if !self.running {
            return []
        }

        let now = Instant::now();
        if let Some(last) = self.last_check {
            if now - last < self.check_interval {
                return []
            }
        }

        self.last_check = Some(now);
        let mut new_alerts = [];

        for (entity_id, config) in &self.watched {
            if !config.enabled {
                continue
            }

            if let Some(alert) = self.check_entity(entity_id, config) {
                new_alerts.push(alert.clone());
                self.alerts.push(alert);
            }
        }

        new_alerts
    }

    fn check_entity(self, entity_id: &str, config: &WatchConfig) -> ?Alert {
        // Placeholder for actual checks
        // Would check process status, resource usage, etc.
        match config.check_type {
            CheckType::Process => self.check_process(entity_id),
            CheckType::Resource => self.check_resource(entity_id, &config.thresholds),
            CheckType::Heartbeat => self.check_heartbeat(entity_id),
            CheckType::Custom(ref name) => self.check_custom(entity_id, name),
        }
    }

    fn check_process(self, entity_id: &str) -> ?Alert {
        // Would check if process is running
        None
    }

    fn check_resource(self, entity_id: &str, thresholds: &Thresholds) -> ?Alert {
        // Would check resource usage
        let usage = 50.0; // Placeholder

        if let Some(critical) = thresholds.critical {
            if usage >= critical {
                return Some(Alert::new(
                    AlertLevel::Critical,
                    entity_id.to_string(),
                    format!("Resource usage at {}%", usage),
                ))
            }
        }

        if let Some(error) = thresholds.error {
            if usage >= error {
                return Some(Alert::new(
                    AlertLevel::Error,
                    entity_id.to_string(),
                    format!("Resource usage at {}%", usage),
                ))
            }
        }

        if let Some(warning) = thresholds.warning {
            if usage >= warning {
                return Some(Alert::new(
                    AlertLevel::Warning,
                    entity_id.to_string(),
                    format!("Resource usage at {}%", usage),
                ))
            }
        }

        None
    }

    fn check_heartbeat(self, entity_id: &str) -> ?Alert {
        // Would check last heartbeat time
        None
    }

    fn check_custom(self, entity_id: &str, check_name: &str) -> ?Alert {
        // Would run custom check
        None
    }

    /// Records a metric.
    fn record_metric(mut self, entity_id: &str, metric: &str, value: f64) {
        // Would store metric for trend analysis
    }

    /// Gets metric history.
    fn get_metrics(self, entity_id: &str, metric: &str, duration: Duration) -> [MetricPoint] {
        // Would retrieve metric history
        []
    }
}

/// A metric data point.
#[derive(Debug, Clone)]
struct MetricPoint {
    timestamp: Instant,
    value: f64,
}

/// Monitor errors.
#[derive(Debug, Clone)]
enum MonitorError {
    AlreadyRunning,
    NotRunning,
    EntityNotFound,
    CheckFailed(str),
}

/// Health check configuration.
struct HealthCheck {
    name: str,
    check_fn: fn() -> HealthResult,
    interval: Duration,
    timeout: Duration,
}

/// Health check result.
#[derive(Debug, Clone)]
struct HealthResult {
    healthy: bool,
    message: str,
    details: HashMap<str, str>,
}

impl HealthResult {
    fn healthy() -> HealthResult {
        HealthResult {
            healthy: true,
            message: "OK".to_string(),
            details: HashMap::new(),
        }
    }

    fn unhealthy(message: str) -> HealthResult {
        HealthResult {
            healthy: false,
            message,
            details: HashMap::new(),
        }
    }

    fn with_detail(mut self, key: str, value: str) -> HealthResult {
        self.details.insert(key, value);
        self
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_alert_creation() {
        let a = Alert::new(AlertLevel::Warning, "test", "Test message");
        assert!(!a.acknowledged);
        assert!(matches!(a.level, AlertLevel::Warning));
    }

    #[test]
    fn test_alert_acknowledge() {
        let mut a = Alert::new(AlertLevel::Error, "test", "Test");
        a.acknowledge();
        assert!(a.acknowledged);
    }

    #[test]
    fn test_monitor() {
        let mut m = Monitor::new();
        m.watch("process1");

        assert!(m.watched.contains_key("process1"));
    }

    #[test]
    fn test_health_result() {
        let h = HealthResult::healthy()
            .with_detail("uptime", "24h");

        assert!(h.healthy);
        assert!(h.details.contains_key("uptime"));
    }

    #[test]
    fn test_alert_levels() {
        assert!(AlertLevel::Critical > AlertLevel::Error);
        assert!(AlertLevel::Error > AlertLevel::Warning);
        assert!(AlertLevel::Warning > AlertLevel::Info);
    }
}
