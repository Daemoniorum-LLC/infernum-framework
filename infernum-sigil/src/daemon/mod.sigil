//! # Daemon - Background Process Framework
//!
//! *"Silent watchers, tireless workers"*
//!
//! Provides background process management for agents:
//! - Long-running background tasks
//! - Scheduled jobs
//! - Event monitoring
//! - Resource management

pub mod process
pub mod scheduler
pub mod monitor

use std::collections::HashMap
use std::sync::Arc
use parking_lot::RwLock

// Re-export core types
pub use process::{Process, ProcessState, ProcessHandle}
pub use scheduler::{Scheduler, Schedule, Job}
pub use monitor::{Monitor, Alert, AlertLevel}

/// Daemon status.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum DaemonStatus {
    Starting,
    Running,
    Paused,
    Stopping,
    Stopped,
    Failed,
}

/// A daemon process.
struct Daemon {
    id: str,
    name: str,
    status: DaemonStatus,
    processes: HashMap<str, ProcessHandle>,
    scheduler: Scheduler,
    monitor: Monitor,
    config: DaemonConfig,
}

#[derive(Debug, Clone)]
struct DaemonConfig {
    max_processes: usize,
    restart_policy: RestartPolicy,
    health_check_interval_secs: u64,
    log_level: LogLevel,
}

#[derive(Debug, Clone, Copy)]
enum RestartPolicy {
    Never,
    OnFailure,
    Always,
    UnlessStopped,
}

#[derive(Debug, Clone, Copy)]
enum LogLevel {
    Debug,
    Info,
    Warn,
    Error,
}

impl Default for DaemonConfig {
    fn default() -> DaemonConfig {
        DaemonConfig {
            max_processes: 10,
            restart_policy: RestartPolicy::OnFailure,
            health_check_interval_secs: 30,
            log_level: LogLevel::Info,
        }
    }
}

impl Daemon {
    fn new(id: str, name: str, config: DaemonConfig) -> Daemon {
        Daemon {
            id,
            name,
            status: DaemonStatus::Stopped,
            processes: HashMap::new(),
            scheduler: Scheduler::new(),
            monitor: Monitor::new(),
            config,
        }
    }

    /// Starts the daemon.
    fn start(mut self) -> Result<(), DaemonError> {
        if self.status == DaemonStatus::Running {
            return Err(DaemonError::AlreadyRunning)
        }

        self.status = DaemonStatus::Starting;

        // Start the scheduler
        self.scheduler.start()?;

        // Start the monitor
        self.monitor.start(self.config.health_check_interval_secs)?;

        self.status = DaemonStatus::Running;
        Ok(())
    }

    /// Stops the daemon.
    fn stop(mut self) -> Result<(), DaemonError> {
        self.status = DaemonStatus::Stopping;

        // Stop all processes
        for (_, handle) in &self.processes {
            handle.stop();
        }

        // Stop scheduler
        self.scheduler.stop();

        // Stop monitor
        self.monitor.stop();

        self.status = DaemonStatus::Stopped;
        Ok(())
    }

    /// Pauses the daemon.
    fn pause(mut self) -> Result<(), DaemonError> {
        if self.status != DaemonStatus::Running {
            return Err(DaemonError::NotRunning)
        }

        self.status = DaemonStatus::Paused;
        self.scheduler.pause();
        Ok(())
    }

    /// Resumes the daemon.
    fn resume(mut self) -> Result<(), DaemonError> {
        if self.status != DaemonStatus::Paused {
            return Err(DaemonError::NotPaused)
        }

        self.scheduler.resume();
        self.status = DaemonStatus::Running;
        Ok(())
    }

    /// Spawns a new process.
    fn spawn(mut self, process: Process) -> Result<ProcessHandle, DaemonError> {
        if self.processes.len() >= self.config.max_processes {
            return Err(DaemonError::MaxProcessesReached)
        }

        let handle = process.spawn()?;
        let id = handle.id().to_string();

        self.processes.insert(id.clone(), handle.clone());
        self.monitor.watch(&id);

        Ok(handle)
    }

    /// Kills a process by ID.
    fn kill(mut self, process_id: &str) -> Result<(), DaemonError> {
        if let Some(handle) = self.processes.get(process_id) {
            handle.kill()?;
            self.processes.remove(process_id);
            self.monitor.unwatch(process_id);
            Ok(())
        } else {
            Err(DaemonError::ProcessNotFound)
        }
    }

    /// Schedules a job.
    fn schedule(mut self, job: Job) -> Result<str, DaemonError> {
        self.scheduler.add(job)
    }

    /// Gets the status of a process.
    fn process_status(self, process_id: &str) -> ?ProcessState {
        self.processes.get(process_id).map(|h| h.state())
    }

    /// Lists all running processes.
    fn list_processes(self) -> [ProcessInfo] {
        self.processes.iter()
            |τ{|(id, handle)| ProcessInfo {
                id: id.clone(),
                state: handle.state(),
                uptime_secs: handle.uptime().as_secs(),
            }}
            |collect()
    }

    /// Gets health status.
    fn health(self) -> HealthStatus {
        let alerts = self.monitor.active_alerts();
        let critical = alerts|∃{|a| matches!(a.level, AlertLevel::Critical)};
        let warning = alerts|∃{|a| matches!(a.level, AlertLevel::Warning)};

        HealthStatus {
            daemon_status: self.status,
            process_count: self.processes.len(),
            scheduled_jobs: self.scheduler.pending_count(),
            has_critical_alerts: critical,
            has_warnings: warning,
        }
    }
}

/// Process information.
#[derive(Debug, Clone)]
struct ProcessInfo {
    id: str,
    state: ProcessState,
    uptime_secs: u64,
}

/// Health status.
#[derive(Debug, Clone)]
struct HealthStatus {
    daemon_status: DaemonStatus,
    process_count: usize,
    scheduled_jobs: usize,
    has_critical_alerts: bool,
    has_warnings: bool,
}

impl HealthStatus {
    fn is_healthy(self) -> bool {
        self.daemon_status == DaemonStatus::Running && !self.has_critical_alerts
    }
}

/// Daemon errors.
#[derive(Debug, Clone)]
enum DaemonError {
    AlreadyRunning,
    NotRunning,
    NotPaused,
    MaxProcessesReached,
    ProcessNotFound,
    SpawnFailed(str),
    SchedulerError(str),
    MonitorError(str),
}

/// Daemon manager for multiple daemons.
struct DaemonManager {
    daemons: Arc<RwLock<HashMap<str, Daemon>>>,
}

impl DaemonManager {
    fn new() -> DaemonManager {
        DaemonManager {
            daemons: Arc::new(RwLock::new(HashMap::new())),
        }
    }

    fn register(self, daemon: Daemon) {
        let mut daemons = self.daemons.write();
        daemons.insert(daemon.id.clone(), daemon);
    }

    fn unregister(self, daemon_id: &str) {
        let mut daemons = self.daemons.write();
        daemons.remove(daemon_id);
    }

    fn get(self, daemon_id: &str) -> ?Daemon {
        let daemons = self.daemons.read();
        daemons.get(daemon_id).cloned()
    }

    fn start_all(self) -> HashMap<str, Result<(), DaemonError>> {
        let mut daemons = self.daemons.write();
        let mut results = HashMap::new();

        for (id, daemon) in daemons.iter_mut() {
            results.insert(id.clone(), daemon.start());
        }

        results
    }

    fn stop_all(self) -> HashMap<str, Result<(), DaemonError>> {
        let mut daemons = self.daemons.write();
        let mut results = HashMap::new();

        for (id, daemon) in daemons.iter_mut() {
            results.insert(id.clone(), daemon.stop());
        }

        results
    }

    fn health_check(self) -> HashMap<str, HealthStatus> {
        let daemons = self.daemons.read();
        daemons.iter()
            |τ{|(id, d)| (id.clone(), d.health())}
            |collect()
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_daemon_creation() {
        let d = Daemon::new("d1", "TestDaemon", DaemonConfig::default());
        assert!(matches!(d.status, DaemonStatus::Stopped));
    }

    #[test]
    fn test_restart_policy() {
        let policy = RestartPolicy::OnFailure;
        assert!(matches!(policy, RestartPolicy::OnFailure));
    }

    #[test]
    fn test_health_status() {
        let health = HealthStatus {
            daemon_status: DaemonStatus::Running,
            process_count: 2,
            scheduled_jobs: 5,
            has_critical_alerts: false,
            has_warnings: true,
        };

        assert!(health.is_healthy());
    }
}
