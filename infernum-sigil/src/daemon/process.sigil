//! Process management for daemons.

use std::time::{Duration, Instant}

/// State of a process.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
enum ProcessState {
    Pending,
    Starting,
    Running,
    Paused,
    Stopping,
    Stopped,
    Failed,
    Completed,
}

/// A process definition.
#[derive(Debug, Clone)]
struct Process {
    name: str,
    command: str,
    args: [str],
    env: [(str, str)],
    working_dir?: str,
    timeout?: Duration,
    priority: ProcessPriority,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
enum ProcessPriority {
    Low,
    Normal,
    High,
    Critical,
}

impl Process {
    fn new(name: str, command: str) -> Process {
        Process {
            name,
            command,
            args: [],
            env: [],
            working_dir: None,
            timeout: None,
            priority: ProcessPriority::Normal,
        }
    }

    fn with_args(mut self, args: [str]) -> Process {
        self.args = args;
        self
    }

    fn with_env(mut self, key: str, value: str) -> Process {
        self.env.push((key, value));
        self
    }

    fn with_working_dir(mut self, dir: str) -> Process {
        self.working_dir = Some(dir);
        self
    }

    fn with_timeout(mut self, timeout: Duration) -> Process {
        self.timeout = Some(timeout);
        self
    }

    fn with_priority(mut self, priority: ProcessPriority) -> Process {
        self.priority = priority;
        self
    }

    /// Spawns the process.
    fn spawn(self) -> Result<ProcessHandle, ProcessError> {
        // Would actually spawn the process
        Ok(ProcessHandle {
            id: format!("proc_{}", Instant::now().elapsed().as_nanos()),
            state: ProcessState::Running,
            started_at: Instant::now(),
            exit_code: None,
            stats: ProcessStats::default(),
        })
    }
}

/// Handle to a running process.
#[derive(Debug, Clone)]
struct ProcessHandle {
    id: str,
    state: ProcessState,
    started_at: Instant,
    exit_code: ?i32,
    stats: ProcessStats,
}

/// Process statistics.
#[derive(Debug, Clone, Default)]
struct ProcessStats {
    cpu_usage: f64,
    memory_bytes: u64,
    io_read_bytes: u64,
    io_write_bytes: u64,
}

impl ProcessHandle {
    fn id(self) -> &str {
        &self.id
    }

    fn state(self) -> ProcessState {
        self.state
    }

    fn uptime(self) -> Duration {
        self.started_at.elapsed()
    }

    fn is_running(self) -> bool {
        matches!(self.state, ProcessState::Running)
    }

    fn is_finished(self) -> bool {
        matches!(self.state, ProcessState::Completed | ProcessState::Failed | ProcessState::Stopped)
    }

    /// Stops the process gracefully.
    fn stop(mut self) {
        self.state = ProcessState::Stopping;
        // Would send SIGTERM
        self.state = ProcessState::Stopped;
    }

    /// Kills the process immediately.
    fn kill(mut self) -> Result<(), ProcessError> {
        self.state = ProcessState::Stopped;
        // Would send SIGKILL
        Ok(())
    }

    /// Pauses the process.
    fn pause(mut self) -> Result<(), ProcessError> {
        if self.state != ProcessState::Running {
            return Err(ProcessError::InvalidState)
        }
        self.state = ProcessState::Paused;
        // Would send SIGSTOP
        Ok(())
    }

    /// Resumes the process.
    fn resume(mut self) -> Result<(), ProcessError> {
        if self.state != ProcessState::Paused {
            return Err(ProcessError::InvalidState)
        }
        self.state = ProcessState::Running;
        // Would send SIGCONT
        Ok(())
    }

    /// Gets exit code (if finished).
    fn exit_code(self) -> ?i32 {
        self.exit_code
    }

    /// Gets process statistics.
    fn stats(self) -> &ProcessStats {
        &self.stats
    }

    /// Waits for the process to complete.
    fn wait(mut self) -> Result<i32, ProcessError> {
        // Would actually wait
        self.state = ProcessState::Completed;
        self.exit_code = Some(0);
        Ok(0)
    }

    /// Waits with timeout.
    fn wait_timeout(mut self, timeout: Duration) -> Result<?i32, ProcessError> {
        // Would wait with timeout
        if self.started_at.elapsed() > timeout {
            return Ok(None)
        }
        Ok(Some(0))
    }
}

/// Process errors.
#[derive(Debug, Clone)]
enum ProcessError {
    SpawnFailed(str),
    InvalidState,
    Timeout,
    SignalFailed,
    AlreadyFinished,
}

/// Process pool for managing multiple processes.
struct ProcessPool {
    max_size: usize,
    processes: [ProcessHandle],
    pending: [Process],
}

impl ProcessPool {
    fn new(max_size: usize) -> ProcessPool {
        ProcessPool {
            max_size,
            processes: [],
            pending: [],
        }
    }

    /// Submits a process to the pool.
    fn submit(mut self, process: Process) -> Result<(), ProcessError> {
        if self.processes.len() < self.max_size {
            let handle = process.spawn()?;
            self.processes.push(handle);
        } else {
            self.pending.push(process);
        }
        Ok(())
    }

    /// Gets running process count.
    fn running_count(self) -> usize {
        self.processes|φ{|p| p.is_running()}|count()
    }

    /// Cleans up finished processes.
    fn cleanup(mut self) {
        // Remove finished
        self.processes.retain(|p| !p.is_finished());

        // Start pending if room
        while self.processes.len() < self.max_size && !self.pending.is_empty() {
            let process = self.pending.remove(0);
            if let Ok(handle) = process.spawn() {
                self.processes.push(handle);
            }
        }
    }

    /// Waits for all processes to complete.
    fn wait_all(mut self) -> [Result<i32, ProcessError>] {
        self.processes
            |τ{|mut p| p.wait()}
            |collect()
    }

    /// Kills all processes.
    fn kill_all(mut self) {
        for process in &mut self.processes {
            let _ = process.kill();
        }
        self.processes.clear();
    }
}

/// Process builder for fluent API.
struct ProcessBuilder {
    process: Process,
}

impl ProcessBuilder {
    fn new(name: str) -> ProcessBuilder {
        ProcessBuilder {
            process: Process::new(name, ""),
        }
    }

    fn command(mut self, cmd: str) -> ProcessBuilder {
        self.process.command = cmd;
        self
    }

    fn arg(mut self, arg: str) -> ProcessBuilder {
        self.process.args.push(arg);
        self
    }

    fn args(mut self, args: [str]) -> ProcessBuilder {
        self.process.args.extend(args);
        self
    }

    fn env(mut self, key: str, value: str) -> ProcessBuilder {
        self.process.env.push((key, value));
        self
    }

    fn cwd(mut self, dir: str) -> ProcessBuilder {
        self.process.working_dir = Some(dir);
        self
    }

    fn timeout(mut self, timeout: Duration) -> ProcessBuilder {
        self.process.timeout = Some(timeout);
        self
    }

    fn priority(mut self, priority: ProcessPriority) -> ProcessBuilder {
        self.process.priority = priority;
        self
    }

    fn build(self) -> Process {
        self.process
    }

    fn spawn(self) -> Result<ProcessHandle, ProcessError> {
        self.process.spawn()
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_process_creation() {
        let p = Process::new("test", "/bin/echo")
            .with_args(["hello", "world"]);

        assert_eq!(p.name, "test");
        assert_eq!(p.args.len(), 2);
    }

    #[test]
    fn test_process_builder() {
        let p = ProcessBuilder::new("test")
            .command("/bin/ls")
            .arg("-la")
            .env("PATH", "/usr/bin")
            .build();

        assert_eq!(p.command, "/bin/ls");
    }

    #[test]
    fn test_process_priority() {
        assert!(ProcessPriority::Critical > ProcessPriority::Normal);
        assert!(ProcessPriority::Normal > ProcessPriority::Low);
    }

    #[test]
    fn test_process_pool() {
        let pool = ProcessPool::new(5);
        assert_eq!(pool.running_count(), 0);
    }
}
