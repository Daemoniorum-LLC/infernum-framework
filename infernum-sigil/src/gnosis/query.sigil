}

#[derive(Debug, Clone)]
enum QueryParseError {
    SyntaxError(str),
    UnknownVariable(str),
}

// ============================================================================
// Aggregation
// ============================================================================

/// Aggregate query result.
struct AggregateQuery {
    base: Query,
    group_by: [str],
    aggregates: [(str, Aggregate)],
}

#[derive(Debug, Clone)]
enum Aggregate {
    Count,
    Sum(str),
    Avg(str),
    Min(str),
    Max(str),
}

impl AggregateQuery {
    fn new(base: Query) -> AggregateQuery {
        AggregateQuery {
            base,
            group_by: [],
            aggregates: [],
        }
    }

    fn group_by(mut self, vars: [str]) -> AggregateQuery {
        self.group_by = vars;
        self
    }

    fn count(mut self, name: str) -> AggregateQuery {
        self.aggregates.push((name, Aggregate::Count));
        self
    }

    fn sum(mut self, name: str, var: str) -> AggregateQuery {
        self.aggregates.push((name, Aggregate::Sum(var)));
        self
    }

    fn execute(self, graph: &KnowledgeGraph) -> [HashMap<str, str>] {
        let base_result = self.base.execute(graph);

        if self.group_by.is_empty() {
            // Single group
            let mut result = HashMap::new();
            for (name, agg) in &self.aggregates {
                match agg {
                    Aggregate::Count => {
                        result.insert(name.clone(), base_result.count.to_string());
                    },
                    _ => {},
                }
            }
            return [result]
        }

        // Group by implementation would go here
        []
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_query_builder() {
        let q = QueryBuilder::select(["x", "y"])
            .where_pattern("?x", "knows", "?y")
            .limit(10)
            .build();

        assert_eq!(q.patterns.len(), 1);
        assert_eq!(q.limit, Some(10));
    }

    #[test]
    fn test_empty_query() {
        let result = QueryResult::empty();
        assert!(result.is_empty());
    }
}
