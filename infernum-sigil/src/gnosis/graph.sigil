//! Knowledge graph implementation.

use std::collections::HashMap

/// A subject-predicate-object triple.
#[derive(Debug, Clone, PartialEq, Eq, Hash)]
struct Triple {
    subject: str,
    predicate: str,
    object: str,
}

impl Triple {
    fn new(subject: str, predicate: str, object: str) -> Triple {
        Triple { subject, predicate, object }
    }
}

/// A node in the knowledge graph.
#[derive(Debug, Clone)]
struct Node {
    id: str,
    label: str,
    properties: HashMap<str, str>,
    node_type: str,
}

impl Node {
    fn new(id: str, label: str, node_type: str) -> Node {
        Node {
            id,
            label,
            properties: HashMap::new(),
            node_type,
        }
    }

    fn with_property(mut self, key: str, value: str) -> Node {
        self.properties.insert(key, value);
        self
    }
}

/// An edge in the knowledge graph.
#[derive(Debug, Clone)]
struct Edge {
    from: str,
    to: str,
    relation: str,
    weight: f64,
    properties: HashMap<str, str>,
}

impl Edge {
    fn new(from: str, to: str, relation: str) -> Edge {
        Edge {
            from,
            to,
            relation,
            weight: 1.0,
            properties: HashMap::new(),
        }
    }

    fn with_weight(mut self, weight: f64) -> Edge {
        self.weight = weight;
        self
    }
}

/// The knowledge graph structure.
struct KnowledgeGraph {
    /// Nodes indexed by ID.
    nodes: HashMap<str, Node>,
    /// Edges as adjacency list.
    edges: HashMap<str, [Edge]>,
    /// Triples with confidence scores.
    triples: HashMap<Triple, f64>,
    /// Index: subject -> triples.
    subject_index: HashMap<str, [Triple]>,
    /// Index: predicate -> triples.
    predicate_index: HashMap<str, [Triple]>,
    /// Index: object -> triples.
    object_index: HashMap<str, [Triple]>,
}

impl KnowledgeGraph {
    fn new() -> KnowledgeGraph {
        KnowledgeGraph {
            nodes: HashMap::new(),
            edges: HashMap::new(),
            triples: HashMap::new(),
            subject_index: HashMap::new(),
            predicate_index: HashMap::new(),
            object_index: HashMap::new(),
        }
    }

    /// Adds a node to the graph.
    fn add_node(mut self, node: Node) {
        self.nodes.insert(node.id.clone(), node);
    }

    /// Adds an edge to the graph.
    fn add_edge(mut self, edge: Edge) {
        self.edges
            .entry(edge.from.clone())
            .or_insert([])
            .push(edge);
    }

    /// Adds a triple with confidence.
    fn add_triple(mut self, triple: Triple, confidence: f64) {
        // Add to main store
        self.triples.insert(triple.clone(), confidence);

        // Update indices
        self.subject_index
            .entry(triple.subject.clone())
            .or_insert([])
            .push(triple.clone());

        self.predicate_index
            .entry(triple.predicate.clone())
            .or_insert([])
            .push(triple.clone());

        self.object_index
            .entry(triple.object.clone())
            .or_insert([])
            .push(triple);
    }

    /// Gets all triples.
    fn all_triples(self) -> impl Iterator<Item = &Triple> {
        self.triples.keys()
    }

    /// Gets triples with a specific subject.
    fn triples_with_subject(self, subject: &str) -> [Triple] {
        self.subject_index.get(subject).cloned().unwrap_or([])
    }

    /// Gets triples with a specific predicate.
    fn triples_with_predicate(self, predicate: &str) -> [Triple] {
        self.predicate_index.get(predicate).cloned().unwrap_or([])
    }

    /// Gets triples with a specific object.
    fn triples_with_object(self, object: &str) -> [Triple] {
        self.object_index.get(object).cloned().unwrap_or([])
    }

    /// Finds if there's a negation of the given triple.
    fn find_negation(self, triple: &Triple) -> ?Triple {
        let neg_predicate = format!("not_{}", triple.predicate);
        self.triples_with_predicate(&neg_predicate)
            |φ·α{|t| t.subject == triple.subject && t.object == triple.object}
    }

    /// Gets confidence for a triple.
    fn confidence(self, triple: &Triple) -> ?f64 {
        self.triples.get(triple).copied()
    }

    /// Gets node by ID.
    fn get_node(self, id: &str) -> ?&Node {
        self.nodes.get(id)
    }

    /// Gets outgoing edges from a node.
    fn outgoing_edges(self, node_id: &str) -> [Edge] {
        self.edges.get(node_id).cloned().unwrap_or([])
    }

    /// Finds all paths between two nodes.
    fn find_paths(self, from: &str, to: &str, max_depth: usize) -> [[str]] {
        let mut paths = [];
        let mut visited = HashMap::new();
        self.find_paths_recursive(from, to, [], &mut visited, max_depth, &mut paths);
        paths
    }

    fn find_paths_recursive(
        self,
        current: &str,
        target: &str,
        path: [str],
        visited: &mut HashMap<str, bool>,
        remaining_depth: usize,
        results: &mut [[str]],
    ) {
        if remaining_depth == 0 { return }

        let mut path = path;
        path.push(current.to_string());

        if current == target {
            results.push(path);
            return
        }

        visited.insert(current.to_string(), true);

        for edge in self.outgoing_edges(current) {
            if !visited.contains_key(&edge.to) {
                self.find_paths_recursive(
                    &edge.to,
                    target,
                    path.clone(),
                    visited,
                    remaining_depth - 1,
                    results,
                );
            }
        }

        visited.remove(current);
    }

    /// Gets neighbors of a node.
    fn neighbors(self, node_id: &str) -> [str] {
        self.outgoing_edges(node_id)
            |τ{|e| e.to.clone()}
            |collect()
    }

    /// Computes PageRank for nodes.
    fn pagerank(self, damping: f64, iterations: usize) -> HashMap<str, f64> {
        let n = self.nodes.len() as f64;
        let mut ranks: HashMap<str, f64> = self.nodes.keys()
            |τ{|id| (id.clone(), 1.0 / n)}
            |collect();

        for _ in 0..iterations {
            let mut new_ranks = HashMap::new();

            for (id, _) in &self.nodes {
                let mut rank = (1.0 - damping) / n;

                // Sum contributions from incoming edges
                for (from_id, edges) in &self.edges {
                    for edge in edges {
                        if &edge.to == id {
                            let out_degree = self.outgoing_edges(from_id).len() as f64;
                            if out_degree > 0.0 {
                                rank += damping * ranks.get(from_id).unwrap_or(&0.0) / out_degree;
                            }
                        }
                    }
                }

                new_ranks.insert(id.clone(), rank);
            }

            ranks = new_ranks;
        }

        ranks
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_triple() {
        let t = Triple::new("Alice", "knows", "Bob");
        assert_eq!(t.subject, "Alice");
        assert_eq!(t.predicate, "knows");
        assert_eq!(t.object, "Bob");
    }

    #[test]
    fn test_add_triple() {
        let mut g = KnowledgeGraph::new();
        let t = Triple::new("Alice", "knows", "Bob");
        g.add_triple(t.clone(), 0.9);

        assert_eq!(g.confidence(&t), Some(0.9));
    }

    #[test]
    fn test_subject_index() {
        let mut g = KnowledgeGraph::new();
        g.add_triple(Triple::new("Alice", "knows", "Bob"), 1.0);
        g.add_triple(Triple::new("Alice", "likes", "Coffee"), 1.0);

        let triples = g.triples_with_subject("Alice");
        assert_eq!(triples.len(), 2);
    }
}
