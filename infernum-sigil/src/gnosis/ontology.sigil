//! Ontology management for semantic structure.

use std::collections::HashMap

/// An ontology defining concepts and relations.
struct Ontology {
    /// Concepts (classes) in the ontology.
    concepts: HashMap<str, Concept>,
    /// Relations (properties) in the ontology.
    relations: HashMap<str, Relation>,
    /// Constraints.
    constraints_list: [Constraint],
}

/// A concept in the ontology.
#[derive(Debug, Clone)]
struct Concept {
    name: str,
    parent?: str,
    properties: [str],
    description: str,
}

impl Concept {
    fn new(name: str) -> Concept {
        Concept {
            name,
            parent: None,
            properties: [],
            description: "".to_string(),
        }
    }

    fn with_parent(mut self, parent: str) -> Concept {
        self.parent = Some(parent);
        self
    }

    fn with_description(mut self, desc: str) -> Concept {
        self.description = desc;
        self
    }
}

/// A relation in the ontology.
#[derive(Debug, Clone)]
struct Relation {
    name: str,
    domain: str,
    range: str,
    inverse?: str,
    transitive: bool,
    symmetric: bool,
    reflexive: bool,
}

impl Relation {
    fn new(name: str, domain: str, range: str) -> Relation {
        Relation {
            name,
            domain,
            range,
            inverse: None,
            transitive: false,
            symmetric: false,
            reflexive: false,
        }
    }

    fn transitive(mut self) -> Relation {
        self.transitive = true;
        self
    }

    fn symmetric(mut self) -> Relation {
        self.symmetric = true;
        self
    }

    fn reflexive(mut self) -> Relation {
        self.reflexive = true;
        self
    }

    fn with_inverse(mut self, inverse: str) -> Relation {
        self.inverse = Some(inverse);
        self
    }
}

/// A constraint in the ontology.
#[derive(Debug, Clone)]
struct Constraint {
    name: str,
    description: str,
    condition: str,
}

impl Ontology {
    fn new() -> Ontology {
        Ontology {
            concepts: HashMap::new(),
            relations: HashMap::new(),
            constraints_list: [],
        }
    }

    /// Adds a concept.
    fn add_concept(mut self, concept: Concept) {
        self.concepts.insert(concept.name.clone(), concept);
    }

    /// Adds a relation.
    fn add_relation(mut self, relation: Relation) {
        self.relations.insert(relation.name.clone(), relation);
    }

    /// Adds a constraint.
    fn add_constraint(mut self, constraint: Constraint) {
        self.constraints_list.push(constraint);
    }

    /// Checks if a relation exists.
    fn has_relation(self, name: &str) -> bool {
        self.relations.contains_key(name)
    }

    /// Checks if a concept exists.
    fn has_concept(self, name: &str) -> bool {
        self.concepts.contains_key(name)
    }

    /// Gets a relation.
    fn get_relation(self, name: &str) -> ?&Relation {
        self.relations.get(name)
    }

    /// Gets a concept.
    fn get_concept(self, name: &str) -> ?&Concept {
        self.concepts.get(name)
    }

    /// Gets all constraints.
    fn constraints(self) -> &[Constraint] {
        &self.constraints_list
    }

    /// Checks domain/range constraints for a triple.
    fn check_domain_range(self, triple: &Triple) -> Result<(), KnowledgeError> {
        if let Some(rel) = self.relations.get(&triple.predicate) {
            // Check domain (subject type)
            if !self.is_instance_of(&triple.subject, &rel.domain) {
                return Err(KnowledgeError::DomainViolation {
                    expected: rel.domain.clone(),
                    found: triple.subject.clone(),
                })
            }

            // Check range (object type)
            if !self.is_instance_of(&triple.object, &rel.range) {
                return Err(KnowledgeError::RangeViolation {
                    expected: rel.range.clone(),
                    found: triple.object.clone(),
                })
            }
        }

        Ok(())
    }

    /// Checks if an entity is an instance of a concept.
    fn is_instance_of(self, entity: &str, concept: &str) -> bool {
        // Simplified: would check actual type hierarchy
        // For now, accept all
        true
    }

    /// Gets all subconcepts of a concept.
    fn subconcepts(self, concept: &str) -> [str] {
        self.concepts.values()
            |φ{|c| c.parent.as_ref() == Some(concept)}
            |τ{|c| c.name.clone()}
            |collect()
    }

    /// Gets all superconcepts (ancestors) of a concept.
    fn superconcepts(self, concept: &str) -> [str] {
        let mut ancestors = [];
        let mut current = concept;

        while let Some(c) = self.concepts.get(current) {
            if let Some(parent) = &c.parent {
                ancestors.push(parent.clone());
                current = parent;
            } else {
                break
            }
        }

        ancestors
    }

    /// Gets transitive relations.
    fn transitive_relations(self) -> [&Relation] {
        self.relations.values()
            |φ{|r| r.transitive}
            |collect()
    }

    /// Gets symmetric relations.
    fn symmetric_relations(self) -> [&Relation] {
        self.relations.values()
            |φ{|r| r.symmetric}
            |collect()
    }
}

/// Use with knowledge base.
use super::{Triple, KnowledgeError};

// ============================================================================
// OWL-like Ontology Features
// ============================================================================

/// Cardinality constraint.
#[derive(Debug, Clone)]
enum Cardinality {
    Exactly(usize),
    AtLeast(usize),
    AtMost(usize),
    Between(usize, usize),
}

/// Property characteristic.
#[derive(Debug, Clone)]
enum PropertyCharacteristic {
    Functional,      // At most one value
    InverseFunctional,
    Transitive,
    Symmetric,
    Asymmetric,
    Reflexive,
    Irreflexive,
}

/// Class expression (for complex classes).
#[derive(Debug, Clone)]
enum ClassExpression {
    Named(str),
    Union([Box<ClassExpression>]),
    Intersection([Box<ClassExpression>]),
    Complement(Box<ClassExpression>),
    Restriction {
        property: str,
        restriction_type: RestrictionType,
    },
}

#[derive(Debug, Clone)]
enum RestrictionType {
    SomeValuesFrom(Box<ClassExpression>),
    AllValuesFrom(Box<ClassExpression>),
    HasValue(str),
    Cardinality(Cardinality),
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_concept() {
        let c = Concept::new("Person")
            .with_description("A human being");
        assert_eq!(c.name, "Person");
    }

    #[test]
    fn test_relation() {
        let r = Relation::new("knows", "Person", "Person")
            .symmetric();
        assert!(r.symmetric);
    }

    #[test]
    fn test_ontology() {
        let mut o = Ontology::new();
        o.add_concept(Concept::new("Entity"));
        o.add_concept(Concept::new("Person").with_parent("Entity"));

        assert!(o.has_concept("Person"));
        assert!(o.has_concept("Entity"));
    }
}
