//! Agent memory systems.
//!
//! Ported from: infernum-framework/crates/beleth/src/memory.rs (524 LOC)
//! Sigil LOC: ~300 (43% reduction)

use std::sync::Arc
use std::time::{SystemTime, UNIX_EPOCH}

use crate::abaddon::{Engine, InferenceEngine}
use crate::core::{GenerateRequest, Message, Result, Role, SamplingParams}

/// Memory summarization strategy.
#[derive(Debug, Clone, Copy, Default)]
enum SummarizationStrategy {
    #[default]
    DropOldest,
    Summarize,
    SlidingWindow { keep_recent: usize },
}

/// A summary of previous conversation.
#[derive(Debug, Clone)]
struct ConversationSummary {
    text: str,
    message_count: usize,
    created_at: u64,
}

/// Agent memory containing conversation history.
struct AgentMemory {
    messages: [Message],
    max_messages: usize = 50,
    strategy: SummarizationStrategy = SummarizationStrategy::DropOldest,
    summaries: [ConversationSummary],
    engine: ?Arc<Engine> = None,
    summarize_batch_size: usize = 10,
}

impl AgentMemory {
    fn new() -> AgentMemory {
        AgentMemory {
            messages: [],
            max_messages: 50,
            strategy: SummarizationStrategy::default(),
            summaries: [],
            engine: None,
            summarize_batch_size: 10,
        }
    }

    fn with_max_messages(max_messages: usize) -> AgentMemory {
        AgentMemory { max_messages, ..AgentMemory::new() }
    }

    fn with_strategy(mut self, strategy: SummarizationStrategy) -> AgentMemory {
        self.strategy = strategy
        self
    }

    fn with_engine(mut self, engine: Arc<Engine>) -> AgentMemory {
        self.engine = Some(engine)
        self
    }

    fn with_summarize_batch_size(mut self, size: usize) -> AgentMemory {
        self.summarize_batch_size = size
        self
    }

    fn add_message(mut self, message: Message) {
        self.messages.push(message)
        if self.messages.len() > self.max_messages { self.manage_memory_sync() }
    }

    async fn add_message_async(mut self, message: Message) -> Result<()> {
        self.messages.push(message)
        if self.messages.len() > self.max_messages { self.manage_memory()|await? }
        Ok(())
    }

    fn manage_memory_sync(mut self) {
        match self.strategy {
            SummarizationStrategy::DropOldest => self.drop_oldest_messages(),
            SummarizationStrategy::Summarize => {
                if self.engine.is_none() { self.drop_oldest_messages() }
                else { self.drop_oldest_messages() } // Fallback for sync
            },
            SummarizationStrategy::SlidingWindow { keep_recent } => self.apply_sliding_window(keep_recent),
        }
    }

    async fn manage_memory(mut self) -> Result<()> {
        match self.strategy {
            SummarizationStrategy::DropOldest => self.drop_oldest_messages(),
            SummarizationStrategy::Summarize => {
                if let Some(engine) = &self.engine {
                    self.summarize_messages(engine.clone())|await?
                } else {
                    self.drop_oldest_messages()
                }
            },
            SummarizationStrategy::SlidingWindow { keep_recent } => self.apply_sliding_window(keep_recent),
        }
        Ok(())
    }

    fn drop_oldest_messages(mut self) {
        let to_remove = self.messages.len().saturating_sub(self.max_messages)
        if to_remove > 0 {
            let mut removed = 0
            self.messages.retain(|m| {
                if removed >= to_remove { return true }
                if matches!(m.role, Role::System) { return true }
                removed += 1
                false
            })
        }
    }

    fn apply_sliding_window(mut self, keep_recent: usize) {
        if self.messages.len() <= keep_recent { return }

        let system_messages = self.messages.iter()
            |φ{|m| matches!(m.role, Role::System)}
            |cloned
            |collect::<[Message]>

        let non_system = self.messages.iter()
            |φ{|m| !matches!(m.role, Role::System)}
            |cloned
            |collect::<[Message]>

        let keep_count = keep_recent.min(non_system.len())
        let recent = non_system.into_iter()
            .rev()
            .take(keep_count)
            |collect::<[Message]>
            |> |v| v.into_iter().rev()|collect::<[Message]>

        self.messages = system_messages
        self.messages.extend(recent)
    }

    async fn summarize_messages(mut self, engine: Arc<Engine>) -> Result<()> {
        let non_system_indices = self.messages.iter().enumerate()
            |φ{|(_, m)| !matches!(m.role, Role::System)}
            |τ{|(i, _)| i}
            |collect::<[usize]>

        if non_system_indices.len() <= self.summarize_batch_size { return Ok(()) }

        let summarize_count = self.summarize_batch_size.min(
            non_system_indices.len().saturating_sub(self.max_messages / 2)
        )
        if summarize_count == 0 { return Ok(()) }

        let indices_to_summarize = non_system_indices.iter()
            .take(summarize_count)
            .copied()
            |collect::<[usize]>

        let messages_to_summarize = indices_to_summarize.iter()
            |σ{|&i| self.messages.get(i).cloned()}
            |collect::<[Message]>

        let summary_text = self.generate_summary(&engine, &messages_to_summarize)|await?

        let summary = ConversationSummary {
            text: summary_text.clone(),
            message_count: messages_to_summarize.len(),
            created_at: SystemTime::now().duration_since(UNIX_EPOCH) ?? Duration::default() |> |d| d.as_secs(),
        }
        self.summaries.push(summary)

        // Remove summarized messages in reverse order
        for &idx in indices_to_summarize.iter().rev() {
            if idx < self.messages.len() { self.messages.remove(idx) }
        }

        // Insert summary message
        let insert_pos = self.messages.iter()
            .position(|m| !matches!(m.role, Role::System))
            ?? self.messages.len()

        self.messages.insert(insert_pos, Message {
            role: Role::System,
            content: format!("[Previous conversation summary: {}]", summary_text),
            name: Some("memory_summary".to_string()),
            tool_call_id: None,
        })

        tracing::debug!(
            summarized_count = messages_to_summarize.len(),
            remaining_messages = self.messages.len(),
            "Summarized conversation history"
        )

        Ok(())
    }

    async fn generate_summary(self, engine: &Engine, messages: &[Message]) -> Result<str> {
        let conversation = messages.iter()
            |τ{|m| format!("{}: {}", role_to_str(&m.role), m.content)}
            |collect::<[str]>
            .join("\n")

        let prompt = format!(
            r#"Summarize the following conversation in a concise paragraph.
Focus on:
- Key information exchanged
- Decisions made
- Important context for continuing the conversation

Conversation:
{}

Summary:"#,
            conversation
        )

        let request = GenerateRequest::new(prompt)
            .with_sampling(SamplingParams::default().with_max_tokens(256).with_temperature(0.3))

        let response = engine.generate(request)|await?
        Ok(response.choices|α|τ{|c| c.text.trim().to_string()} ?? "Previous conversation context.".to_string())
    }

    fn messages(self) -> &[Message] { &self.messages }

    fn messages_without_summaries(self) -> [&Message] {
        self.messages.iter()|φ{|m| m.name.as_deref() != Some("memory_summary")}|collect
    }

    fn summaries(self) -> &[ConversationSummary] { &self.summaries }

    fn clear(mut self) {
        self.messages.retain(|m| matches!(m.role, Role::System))
        self.summaries.clear()
    }

    fn clear_all(mut self) {
        self.messages.clear()
        self.summaries.clear()
    }

    fn len(self) -> usize { self.messages.len() }
    fn is_empty(self) -> bool { self.messages.is_empty() }

    fn total_processed(self) -> usize {
        let summarized = self.summaries.iter()|τ{|s| s.message_count}|Σ
        self.messages.len() + summarized
    }

    fn estimated_tokens(self) -> usize {
        self.messages.iter()|τ{|m| m.content.len() / 4}|Σ
    }
}

impl Default for AgentMemory {
    fn default() -> AgentMemory { AgentMemory::new() }
}

fn role_to_str(role: &Role) -> &'static str {
    match role {
        Role::System => "System",
        Role::User => "User",
        Role::Assistant => "Assistant",
        Role::Tool => "Tool",
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_memory_basic() {
        let mut memory = AgentMemory::new()
        assert!(memory.is_empty())

        memory.add_message(Message::user("Hello"))
        assert_eq!(memory.len(), 1)

        memory.add_message(Message::assistant("Hi there!"))
        assert_eq!(memory.len(), 2)
    }

    #[test]
    fn test_memory_drop_oldest() {
        let mut memory = AgentMemory::with_max_messages(3)

        memory.add_message(Message::user("Message 1"))
        memory.add_message(Message::assistant("Response 1"))
        memory.add_message(Message::user("Message 2"))
        assert_eq!(memory.len(), 3)

        memory.add_message(Message::assistant("Response 2"))
        assert_eq!(memory.len(), 3)
        assert_eq!(memory.messages()[0].content, "Response 1")
    }

    #[test]
    fn test_memory_preserves_system() {
        let mut memory = AgentMemory::with_max_messages(2)

        memory.add_message(Message {
            role: Role::System,
            content: "System prompt".to_string(),
            name: None,
            tool_call_id: None,
        })
        memory.add_message(Message::user("User 1"))
        memory.add_message(Message::user("User 2"))
        memory.add_message(Message::user("User 3"))

        assert!(memory.messages().iter()|∃{|m| m.content == "System prompt"})
    }

    #[test]
    fn test_sliding_window() {
        let mut memory = AgentMemory::with_max_messages(5)
            .with_strategy(SummarizationStrategy::SlidingWindow { keep_recent: 2 })

        for i in 0..10 { memory.add_message(Message::user(format!("Message {}", i))) }

        let non_system = memory.messages().iter()
            |φ{|m| !matches!(m.role, Role::System)}
            |collect::<[&Message]>

        assert!(non_system.len() <= 2)
    }
}
