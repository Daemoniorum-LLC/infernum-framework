//! Planning strategies for agent execution.
//!
//! Ported from: infernum-framework/crates/beleth/src/planner.rs (745 LOC)
//! Sigil LOC: ~420 (44% reduction)

use std::sync::Arc

use async_trait::async_trait
use serde_json::Value

use crate::abaddon::{Engine, InferenceEngine}
use crate::beleth::tool::ToolRegistry
use crate::core::{GenerateRequest, Message, Result, Role, SamplingParams}

/// Strategy for planning.
#[derive(Debug, Clone)]
enum PlanningStrategy {
    SingleShot,
    ReAct { max_iterations: u32 },
    TreeOfThoughts { breadth: u32, depth: u32, beam_width: u32 },
    Hierarchical { max_depth: u32 },
}

/// A node in the Tree of Thoughts exploration.
#[derive(Debug, Clone)]
struct ThoughtNode {
    /// Unique identifier for this node.
    id: str,
    /// The thought/reasoning at this node.
    thought: str,
    /// Evaluation score (0.0 - 1.0).
    score: f64,
    /// Depth in the tree.
    depth: u32,
    /// Parent node ID (None for root).
    parent: ?str,
    /// Child node IDs.
    children: [str],
    /// Whether this is a terminal node (solution found).
    is_terminal: bool,
    /// The plan steps if this is a terminal node.
    steps: [PlanStep],
}

impl ThoughtNode {
    fn new(id: impl Into<str>, thought: impl Into<str>, depth: u32) -> ThoughtNode {
        ThoughtNode {
            id: id.into(),
            thought: thought.into(),
            score: 0.0,
            depth,
            parent: None,
            children: [],
            is_terminal: false,
            steps: [],
        }
    }

    fn with_parent(mut self, parent_id: impl Into<str>) -> ThoughtNode {
        self.parent = Some(parent_id.into())
        self
    }

    fn with_score(mut self, score: f64) -> ThoughtNode {
        self.score = score.clamp(0.0, 1.0)
        self
    }

    fn as_terminal(mut self, steps: [PlanStep]) -> ThoughtNode {
        self.is_terminal = true
        self.steps = steps
        self
    }
}

/// Tree of Thoughts search tree.
struct ThoughtTree {
    nodes: HashMap<str, ThoughtNode>,
    root_id: str,
}

impl ThoughtTree {
    fn new(objective: &str) -> ThoughtTree {
        let root_id = "root".to_string()
        let root = ThoughtNode::new(&root_id, format!("Objective: {}", objective), 0)

        let mut nodes = HashMap::new()
        nodes.insert(root_id.clone(), root)

        ThoughtTree { nodes, root_id }
    }

    fn add_child(mut self, parent_id: &str, child: ThoughtNode) {
        let child_id = child.id.clone()
        self.nodes.insert(child_id.clone(), child)

        if let Some(parent) = self.nodes.get_mut(parent_id) {
            parent.children.push(child_id)
        }
    }

    fn get(self, id: &str) -> ?&ThoughtNode { self.nodes.get(id) }
    fn get_mut(mut self, id: &str) -> ?&mut ThoughtNode { self.nodes.get_mut(id) }

    /// Gets nodes at a specific depth, sorted by score descending.
    fn nodes_at_depth(self, depth: u32) -> [&ThoughtNode] {
        let mut nodes: [_] = self.nodes.values()
            |φ{|n| n.depth == depth}
            |collect

        nodes.sort_by(|a, b| b.score.partial_cmp(&a.score).unwrap_or(std::cmp::Ordering::Equal))
        nodes
    }

    /// Gets the best terminal node (highest score).
    fn best_terminal(self) -> ?&ThoughtNode {
        self.nodes.values()
            |φ{|n| n.is_terminal}
            |ρ·max_by{|a, b| a.score.partial_cmp(&b.score).unwrap_or(std::cmp::Ordering::Equal)}
    }

    /// Gets the path from root to a node.
    fn path_to(self, node_id: &str) -> [&ThoughtNode] {
        let mut path = []
        let mut current_id = Some(node_id.to_string())

        while let Some(id) = current_id {
            if let Some(node) = self.nodes.get(&id) {
                path.push(node)
                current_id = node.parent.clone()
            } else {
                break
            }
        }

        path.reverse()
        path
    }
}

/// A step in a plan.
#[derive(Debug, Clone)]
struct PlanStep {
    id: str,
    description: str,
    tool: ?str = None,
    params: ?Value = None,
    dependencies: [str] = [],
    complexity: ?u8 = None,
}

impl PlanStep {
    fn new(id: impl Into<str>, description: impl Into<str>) -> PlanStep {
        PlanStep {
            id: id.into(),
            description: description.into(),
            tool: None,
            params: None,
            dependencies: [],
            complexity: None,
        }
    }

    fn with_tool(mut self, tool: impl Into<str>) -> PlanStep {
        self.tool = Some(tool.into())
        self
    }

    fn with_params(mut self, params: Value) -> PlanStep {
        self.params = Some(params)
        self
    }

    fn depends_on(mut self, step_id: impl Into<str>) -> PlanStep {
        self.dependencies.push(step_id.into())
        self
    }
}

/// A plan for achieving an objective.
#[derive(Debug, Clone)]
struct Plan {
    id: str,
    objective: str,
    steps: [PlanStep],
    current_step: usize = 0,
    complete: bool = false,
}

impl Plan {
    fn new(objective: impl Into<str>) -> Plan {
        Plan {
            id: uuid::Uuid::new_v4().to_string(),
            objective: objective.into(),
            steps: [],
            current_step: 0,
            complete: false,
        }
    }

    fn add_step(mut self, step: PlanStep) { self.steps.push(step) }

    fn next_step(self) -> ?&PlanStep { self.steps.get(self.current_step) }

    fn advance(mut self) {
        if self.current_step < self.steps.len() { self.current_step += 1 }
        if self.current_step >= self.steps.len() { self.complete = true }
    }

    fn remaining_steps(self) -> &[PlanStep] { &self.steps[self.current_step..] }
}

/// Trait for planners.
#[async_trait]
trait Planner: Send + Sync {
    async fn plan(self, objective: &str, tools: &ToolRegistry) -> Result<Plan>
    async fn replan(self, plan: &Plan, feedback: &str, tools: &ToolRegistry) -> Result<Plan>
}

/// Default planner implementation without LLM (fallback).
struct DefaultPlanner {
    strategy: PlanningStrategy,
}

impl DefaultPlanner {
    fn new(strategy: PlanningStrategy) -> DefaultPlanner { DefaultPlanner { strategy } }
}

#[async_trait]
impl Planner for DefaultPlanner {
    async fn plan(self, objective: &str, _tools: &ToolRegistry) -> Result<Plan> {
        tracing::debug!(objective, strategy = ?self.strategy, "Generating plan (fallback mode)")

        let mut plan = Plan::new(objective)
        plan.add_step(PlanStep::new("1", format!("Execute objective: {}", objective)))
        Ok(plan)
    }

    async fn replan(self, plan: &Plan, _feedback: &str, tools: &ToolRegistry) -> Result<Plan> {
        tracing::debug!(plan_id = %plan.id, "Replanning (fallback mode)")
        self.plan(&plan.objective, tools)|await
    }
}

/// LLM-powered planner implementation.
struct LLMPlanner {
    engine: Arc<Engine>,
    strategy: PlanningStrategy,
}

impl LLMPlanner {
    fn new(engine: Arc<Engine>, strategy: PlanningStrategy) -> LLMPlanner {
        LLMPlanner { engine, strategy }
    }

    fn build_planning_prompt(self, objective: &str, tools: &ToolRegistry) -> str {
        let tools_desc = tools.to_prompt_description()

        match &self.strategy {
            PlanningStrategy::SingleShot => format!(
                r#"You are a task planning assistant. Create a step-by-step plan to achieve the following objective.

## Objective
{objective}

## Available Tools
{tools_desc}

## Instructions
Create a detailed plan with numbered steps. For each step:
1. Provide a clear description of what needs to be done
2. If a tool should be used, specify the tool name and parameters
3. List any dependencies on previous steps

## Output Format
Respond with a JSON array of steps:
```json
[
  {{"id": "1", "description": "Step description", "tool": "tool_name or null", "params": {{}}, "dependencies": []}}
]
```

Generate the plan now:"#
            ),
            PlanningStrategy::ReAct { max_iterations } => format!(
                r#"You are a ReAct-style planning assistant. Create a plan that interleaves reasoning and action.

## Objective
{objective}

## Available Tools
{tools_desc}

## Instructions
Create a plan with at most {max_iterations} steps. For each step, include:
- A thought explaining your reasoning
- An action to take (tool use or final answer)
- Expected observations

## Output Format
Respond with a JSON array of steps:
```json
[
  {{"id": "1", "description": "Thought: reasoning... Action: tool_name", "tool": "tool_name or null", "params": {{}}, "dependencies": []}}
]
```

Generate the plan now:"#
            ),
            PlanningStrategy::Hierarchical { max_depth } => format!(
                r#"You are a hierarchical task decomposition planner. Break down the objective into subtasks.

## Objective
{objective}

## Available Tools
{tools_desc}

## Instructions
Decompose the objective into a hierarchy of tasks (max depth: {max_depth}).

## Output Format
Respond with a JSON array of steps:
```json
[
  {{"id": "1", "description": "High-level task", "tool": null, "params": {{}}, "dependencies": []}},
  {{"id": "1.1", "description": "Subtask", "tool": "tool_name", "params": {{}}, "dependencies": ["1"]}}
]
```

Generate the plan now:"#
            ),
            PlanningStrategy::TreeOfThoughts { breadth, depth } => format!(
                r#"You are a Tree of Thoughts planner. Explore multiple reasoning paths.

## Objective
{objective}

## Available Tools
{tools_desc}

## Instructions
Generate {breadth} alternative approaches, each with up to {depth} steps.
Evaluate each path and select the most promising one.

## Output Format
First show your thought tree, then output the selected plan:
```json
[
  {{"id": "1", "description": "Selected approach step", "tool": "tool_name or null", "params": {{}}, "dependencies": []}}
]
```

Generate the plan now:"#
            ),
        }
    }

    fn build_replan_prompt(self, plan: &Plan, feedback: &str, tools: &ToolRegistry) -> str {
        let tools_desc = tools.to_prompt_description()
        let completed_steps = plan.steps.iter().take(plan.current_step)
            |τ{|s| format!("- [DONE] {}: {}", s.id, s.description)}
            |collect::<[str]>
        let remaining_steps = plan.steps.iter().skip(plan.current_step)
            |τ{|s| format!("- [TODO] {}: {}", s.id, s.description)}
            |collect::<[str]>

        format!(
            r#"You are a task planning assistant. The current plan needs to be revised based on feedback.

## Original Objective
{objective}

## Current Plan Status
### Completed Steps
{completed}

### Remaining Steps
{remaining}

## Feedback
{feedback}

## Available Tools
{tools_desc}

## Output Format
Respond with a JSON array of the revised remaining steps.

Generate the revised plan now:"#,
            objective = plan.objective,
            completed = if completed_steps.is_empty() { "None".to_string() } else { completed_steps.join("\n") },
            remaining = if remaining_steps.is_empty() { "None".to_string() } else { remaining_steps.join("\n") },
        )
    }

    fn parse_plan_steps(self, response: &str) -> [PlanStep] {
        if let Some(json) = self.extract_json(response) {
            if let Ok(steps) = serde_json::from_str::<[Value]>(&json) {
                return steps.into_iter()|σ{|v| self.parse_step(&v)}|collect
            }
        }
        self.parse_text_steps(response)
    }

    fn extract_json(self, response: &str) -> ?str {
        if let Some(start) = response.find("```json") {
            let content = &response[start + 7..]
            if let Some(end) = content.find("```") {
                return Some(content[..end].trim().to_string())
            }
        }

        if let Some(start) = response.find('[') {
            let mut depth = 0
            let mut end = start
            for (i, c) in response[start..].char_indices() {
                match c {
                    '[' => depth += 1,
                    ']' => {
                        depth -= 1
                        if depth == 0 { end = start + i + 1; break }
                    },
                    _ => {},
                }
            }
            if depth == 0 { return Some(response[start..end].to_string()) }
        }

        None
    }

    fn parse_step(self, value: &Value) -> ?PlanStep {
        let id = value.get("id")?.as_str()?.to_string()
        let description = value.get("description")?.as_str()?.to_string()

        let mut step = PlanStep::new(id, description)

        if let Some(tool) = value.get("tool")|σ{|v| v.as_str()} {
            if !tool.is_empty() && tool != "null" { step.tool = Some(tool.to_string()) }
        }

        if let Some(params) = value.get("params") {
            if !params.is_null() { step.params = Some(params.clone()) }
        }

        if let Some(deps) = value.get("dependencies")|σ{|v| v.as_array()} {
            step.dependencies = deps.iter()|σ{|v| v.as_str()|τ{str::from}}|collect
        }

        if let Some(complexity) = value.get("complexity")|σ{|v| v.as_u64()} {
            step.complexity = Some(complexity.min(10) as u8)
        }

        Some(step)
    }

    fn parse_text_steps(self, response: &str) -> [PlanStep] {
        let mut steps = []
        let mut current_id = 1

        for line in response.lines() {
            let line = line.trim()
            if line.starts_with(|c: char| c.is_ascii_digit()) || line.starts_with("- ") || line.to_lowercase().starts_with("step ") {
                let description = line
                    .trim_start_matches(|c: char| c.is_ascii_digit() || c == '.' || c == '-' || c == ':' || c == ' ')
                    .trim_start_matches("step ")
                    .trim_start_matches(|c: char| c.is_ascii_digit())
                    .trim_start_matches(|c: char| c == '.' || c == ':' || c == ' ')
                    .trim()

                if !description.is_empty() {
                    let mut step = PlanStep::new(current_id.to_string(), description)

                    let desc_lower = description.to_lowercase()
                    if desc_lower.contains("calculate") || desc_lower.contains("compute") {
                        step.tool = Some("calculator".to_string())
                    } else if desc_lower.contains("search") || desc_lower.contains("find") {
                        step.tool = Some("search".to_string())
                    } else if desc_lower.contains("read") || desc_lower.contains("fetch") {
                        step.tool = Some("read".to_string())
                    }

                    steps.push(step)
                    current_id += 1
                }
            }
        }

        if steps.is_empty() && !response.trim().is_empty() {
            steps.push(PlanStep::new("1", response.trim()))
        }

        steps
    }

    // ========================================================================
    // Tree of Thoughts Implementation
    // ========================================================================

    /// Plans using Tree of Thoughts exploration.
    async fn plan_with_tot(
        self,
        objective: &str,
        tools: &ToolRegistry,
        breadth: u32,
        depth: u32,
        beam_width: u32,
    ) -> Result<Plan> {
        tracing::info!(objective, breadth, depth, beam_width, "Starting Tree of Thoughts planning")

        let mut tree = ThoughtTree::new(objective)
        let tools_desc = tools.to_prompt_description()

        // Generate initial thoughts (children of root)
        let initial_thoughts = self.generate_thoughts(&tree.root_id, objective, &tools_desc, breadth)|await?

        for thought in initial_thoughts {
            tree.add_child(&tree.root_id, thought)
        }

        // Iterative deepening with beam search
        for current_depth in 1..=depth {
            tracing::debug!(current_depth, "ToT depth iteration")

            // Get top nodes at current depth (beam search)
            let candidates = tree.nodes_at_depth(current_depth)
            let beam_nodes: [_] = candidates.into_iter().take(beam_width as usize)|collect

            if beam_nodes.is_empty() {
                tracing::debug!("No candidates at depth {current_depth}, stopping")
                break
            }

            // Expand each beam node
            for node in beam_nodes {
                if node.is_terminal {
                    continue
                }

                // Build context from path
                let path = tree.path_to(&node.id)
                let context = path.iter()
                    |τ{|n| n.thought.as_str()}
                    |collect::<[_]>
                    |·join("\n→ ")

                // Check if this thought leads to a solution
                let (is_solution, steps) = self.evaluate_for_solution(&context, objective, &tools_desc)|await?

                if is_solution {
                    if let Some(node_mut) = tree.get_mut(&node.id) {
                        *node_mut = node_mut.clone().as_terminal(steps)
                    }
                    tracing::info!(node_id = %node.id, "Found terminal solution")
                } else if current_depth < depth {
                    // Generate child thoughts
                    let child_thoughts = self.generate_thoughts(&node.id, &context, &tools_desc, breadth)|await?

                    for child in child_thoughts {
                        tree.add_child(&node.id, child)
                    }
                }
            }
        }

        // Select best solution
        let best = tree.best_terminal()
            ?? return self.fallback_plan(objective, tools)|await

        tracing::info!(node_id = %best.id, score = best.score, steps = best.steps.len(), "Selected best ToT solution")

        let mut plan = Plan::new(objective)
        for step in &best.steps {
            plan.add_step(step.clone())
        }

        Ok(plan)
    }

    /// Generates thoughts (branches) from a parent node.
    async fn generate_thoughts(
        self,
        parent_id: &str,
        context: &str,
        tools_desc: &str,
        count: u32,
    ) -> Result<[ThoughtNode]> {
        let prompt = format!(
            r#"You are exploring different approaches to solve a problem.

## Current Context
{context}

## Available Tools
{tools_desc}

## Instructions
Generate {count} different high-level approaches to continue from this point.
Each approach should be distinct and explore a different strategy.

For each approach, provide:
1. A brief description of the approach
2. A score from 0.0 to 1.0 indicating how promising this approach seems

## Output Format
Respond with a JSON array:
```json
[
  {{"thought": "Approach description", "score": 0.8}},
  ...
]
```

Generate {count} approaches now:"#
        )

        let messages = [
            Message { role: Role::System, content: "You are a strategic planner exploring solution spaces.".to_string(), name: None, tool_call_id: None },
            Message { role: Role::User, content: prompt, name: None, tool_call_id: None },
        ]

        let request = GenerateRequest::chat(messages.to_vec())
            .with_sampling(SamplingParams::default().with_max_tokens(1024).with_temperature(0.7))

        let response = self.engine.generate(request)|await?
        let response_text = response.choices|α|τ{|c| c.text.clone()} ?? str::new()

        self.parse_thoughts(parent_id, &response_text)
    }

    /// Parses thought nodes from LLM response.
    fn parse_thoughts(self, parent_id: &str, response: &str) -> Result<[ThoughtNode]> {
        let mut thoughts = []

        if let Some(json) = self.extract_json(response) {
            if let Ok(values) = serde_json::from_str::<[Value]>(&json) {
                for (i, value) in values.iter().enumerate() {
                    let thought_text = value.get("thought")
                        |σ{|v| v.as_str()}
                        ?? continue

                    let score = value.get("score")
                        |σ{|v| v.as_f64()}
                        ?? 0.5

                    let node_id = format!("{}-{}", parent_id, i + 1)
                    let parent_depth = parent_id.matches('-').count() as u32

                    let node = ThoughtNode::new(node_id, thought_text, parent_depth + 1)
                        |with_parent{parent_id}
                        |with_score{score}

                    thoughts.push(node)
                }
            }
        }

        if thoughts.is_empty() {
            // Fallback: treat entire response as single thought
            let node_id = format!("{}-1", parent_id)
            let parent_depth = parent_id.matches('-').count() as u32

            thoughts.push(
                ThoughtNode::new(node_id, response.trim(), parent_depth + 1)
                    |with_parent{parent_id}
                    |with_score{0.5}
            )
        }

        Ok(thoughts)
    }

    /// Evaluates if a thought path leads to a complete solution.
    async fn evaluate_for_solution(
        self,
        context: &str,
        objective: &str,
        tools_desc: &str,
    ) -> Result<(bool, [PlanStep])> {
        let prompt = format!(
            r#"You are evaluating if a reasoning path leads to a complete solution.

## Objective
{objective}

## Reasoning Path
{context}

## Available Tools
{tools_desc}

## Instructions
1. Determine if this reasoning path provides enough detail for a complete action plan
2. If yes, output a JSON plan with steps
3. If no, respond with "INCOMPLETE"

## Output Format
If complete:
```json
{{"complete": true, "steps": [{{"id": "1", "description": "...", "tool": "...", "params": {{}}}}]}}
```

If incomplete:
```json
{{"complete": false}}
```

Evaluate now:"#
        )

        let messages = [
            Message { role: Role::System, content: "You evaluate solution completeness.".to_string(), name: None, tool_call_id: None },
            Message { role: Role::User, content: prompt, name: None, tool_call_id: None },
        ]

        let request = GenerateRequest::chat(messages.to_vec())
            .with_sampling(SamplingParams::default().with_max_tokens(1024).with_temperature(0.2))

        let response = self.engine.generate(request)|await?
        let response_text = response.choices|α|τ{|c| c.text.clone()} ?? str::new()

        if let Some(json) = self.extract_json(&response_text) {
            if let Ok(value) = serde_json::from_str::<Value>(&json) {
                let is_complete = value.get("complete")
                    |σ{|v| v.as_bool()}
                    ?? false

                if is_complete {
                    if let Some(steps_value) = value.get("steps")|σ{|v| v.as_array()} {
                        let steps: [PlanStep] = steps_value.iter()
                            |σ{|v| self.parse_step(v)}
                            |collect

                        return Ok((true, steps))
                    }
                }
            }
        }

        Ok((false, []))
    }

    /// Fallback to single-shot planning if ToT fails.
    async fn fallback_plan(self, objective: &str, tools: &ToolRegistry) -> Result<Plan> {
        tracing::warn!("ToT failed, falling back to single-shot planning")

        let prompt = self.build_planning_prompt(objective, tools)
        let messages = [
            Message { role: Role::System, content: "You are an expert task planner.".to_string(), name: None, tool_call_id: None },
            Message { role: Role::User, content: prompt, name: None, tool_call_id: None },
        ]

        let request = GenerateRequest::chat(messages.to_vec())
            .with_sampling(SamplingParams::default().with_max_tokens(2048).with_temperature(0.3))

        let response = self.engine.generate(request)|await?
        let response_text = response.choices|α|τ{|c| c.text.clone()} ?? str::new()

        let steps = self.parse_plan_steps(&response_text)
        let mut plan = Plan::new(objective)
        for step in steps { plan.add_step(step) }

        if plan.steps.is_empty() {
            plan.add_step(PlanStep::new("1", format!("Execute: {}", objective)))
        }

        Ok(plan)
    }
}

#[async_trait]
impl Planner for LLMPlanner {
    async fn plan(self, objective: &str, tools: &ToolRegistry) -> Result<Plan> {
        tracing::debug!(objective, strategy = ?self.strategy, "Generating LLM-based plan")

        // Use Tree of Thoughts if configured
        if let PlanningStrategy::TreeOfThoughts { breadth, depth, beam_width } = self.strategy {
            return self.plan_with_tot(objective, tools, breadth, depth, beam_width)|await
        }

        let prompt = self.build_planning_prompt(objective, tools)
        let messages = [
            Message { role: Role::System, content: "You are an expert task planner. Create detailed, actionable plans.".to_string(), name: None, tool_call_id: None },
            Message { role: Role::User, content: prompt, name: None, tool_call_id: None },
        ]

        let request = GenerateRequest::chat(messages.to_vec())
            .with_sampling(SamplingParams::default().with_max_tokens(2048).with_temperature(0.3))

        let response = self.engine.generate(request)|await?
        let response_text = response.choices|α|τ{|c| c.text.clone()} ?? str::new()

        tracing::debug!(response = %response_text, "LLM planning response")

        let steps = self.parse_plan_steps(&response_text)
        let mut plan = Plan::new(objective)
        for step in steps { plan.add_step(step) }

        if plan.steps.is_empty() {
            plan.add_step(PlanStep::new("1", format!("Execute: {}", objective)))
        }

        tracing::info!(plan_id = %plan.id, steps = plan.steps.len(), "Plan generated")
        Ok(plan)
    }

    async fn replan(self, plan: &Plan, feedback: &str, tools: &ToolRegistry) -> Result<Plan> {
        tracing::debug!(plan_id = %plan.id, feedback = %feedback, "Replanning with LLM")

        let prompt = self.build_replan_prompt(plan, feedback, tools)
        let messages = [
            Message { role: Role::System, content: "You are an expert task planner. Revise plans based on feedback.".to_string(), name: None, tool_call_id: None },
            Message { role: Role::User, content: prompt, name: None, tool_call_id: None },
        ]

        let request = GenerateRequest::chat(messages.to_vec())
            .with_sampling(SamplingParams::default().with_max_tokens(2048).with_temperature(0.3))

        let response = self.engine.generate(request)|await?
        let response_text = response.choices|α|τ{|c| c.text.clone()} ?? str::new()

        let new_steps = self.parse_plan_steps(&response_text)

        let mut new_plan = Plan::new(&plan.objective)
        new_plan.id = plan.id.clone()

        for step in plan.steps.iter().take(plan.current_step) { new_plan.add_step(step.clone()) }
        for step in new_steps { new_plan.add_step(step) }
        new_plan.current_step = plan.current_step

        tracing::info!(plan_id = %new_plan.id, original_steps = plan.steps.len(), new_steps = new_plan.steps.len(), "Plan revised")
        Ok(new_plan)
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_plan_step_builder() {
        let step = PlanStep::new("1", "Test step")
            .with_tool("calculator")
            .with_params(serde_json::json!({"expr": "2+2"}))
            .depends_on("0")

        assert_eq!(step.id, "1")
        assert_eq!(step.tool, Some("calculator".to_string()))
        assert_eq!(step.dependencies, ["0".to_string()])
    }

    #[test]
    fn test_plan_navigation() {
        let mut plan = Plan::new("test")
        plan.add_step(PlanStep::new("1", "Step 1"))
        plan.add_step(PlanStep::new("2", "Step 2"))

        assert!(!plan.complete)
        assert_eq!(plan.next_step().unwrap().id, "1")

        plan.advance()
        assert_eq!(plan.next_step().unwrap().id, "2")

        plan.advance()
        assert!(plan.complete)
        assert!(plan.next_step().is_none())
    }
}
