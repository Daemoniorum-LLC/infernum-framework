//! Agent implementation with ReAct-style reasoning.
//!
//! Ported from: infernum-framework/crates/beleth/src/agent.rs (596 LOC)
//! Sigil LOC: ~340 (43% reduction)

use std::sync::Arc

use futures::StreamExt
use serde_json::json

use crate::abaddon::{Engine, InferenceEngine}
use crate::beleth::memory::AgentMemory
use crate::beleth::planner::{DefaultPlanner, Planner, PlanningStrategy}
use crate::beleth::tool::{ToolCall, ToolContext, ToolRegistry}
use crate::core::{GenerateRequest, Message, ModelId, Result, Role, SamplingParams}

/// Source for agent persona/system prompt.
#[derive(Debug, Clone)]
enum PersonaSource {
    Inline(str),
    Grimoire { persona_id: str, variant: ?str },
}

/// Agent persona configuration.
#[derive(Debug, Clone)]
struct Persona {
    system: PersonaSource,
    model: ?ModelId = None,
    max_iterations: u32 = 10,
}

impl Default for Persona {
    fn default() -> Persona {
        Persona {
            system: PersonaSource::Inline("You are a helpful AI assistant.".to_string()),
            model: None,
            max_iterations: 10,
        }
    }
}

/// An autonomous agent with tool use and reasoning capabilities.
struct Agent {
    id: str,
    persona: Persona,
    tools: ToolRegistry,
    memory: AgentMemory,
    planner: Arc<dyn Planner>,
    engine: ?Arc<Engine> = None,
}

impl Agent {
    fn builder() -> AgentBuilder { AgentBuilder::default() }

    fn system_prompt(self) -> str {
        match &self.persona.system {
            PersonaSource::Inline(s) => s.clone(),
            PersonaSource::Grimoire { persona_id, variant } => {
                let base_path = grimoire_loader::default_grimoire_path()
                let prompt_path = if let Some(var) = variant {
                    base_path.join(persona_id).join(format!("{}.md", var))
                } else {
                    let dir_path = base_path.join(persona_id)
                    if dir_path.is_dir() { dir_path.join("prompt.md") }
                    else { base_path.join(format!("{}.md", persona_id)) }
                }

                match std::fs::read_to_string(&prompt_path) {
                    Ok(content) => content,
                    Err(_) => {
                        tracing::debug!(persona_id, path = %prompt_path.display(), "Grimoire persona not found, using default prompt")
                        format!("You are {} - an AI assistant.", persona_id)
                    },
                }
            },
        }
    }

    fn set_engine(mut self, engine: Arc<Engine>) { self.engine = Some(engine) }

    async fn run(mut self, objective: &str) -> Result<str> {
        let engine = self.engine.as_ref()
            ?? return Err(crate::core::Error::internal("No engine configured for agent"))

        tracing::info!(objective, agent_id = %self.id, "Starting agent execution")

        let system_prompt = self.build_system_prompt()
        let mut messages = [
            Message { role: Role::System, content: system_prompt, name: None, tool_call_id: None },
            Message { role: Role::User, content: objective.to_string(), name: None, tool_call_id: None },
        ]

        let mut ctx = ToolContext::new(&self.id)
        ctx.messages = messages.clone()

        let mut final_answer = str::new()
        for iteration in 0..self.persona.max_iterations {
            tracing::debug!(iteration, "ReAct iteration")

            let request = GenerateRequest::chat(messages.clone())
                .with_sampling(SamplingParams::default().with_max_tokens(1024).with_temperature(0.7))

            let response = engine.generate(request)|await?
            let assistant_response = response.choices|α|τ{|c| c.text.clone()} ?? str::new()

            tracing::debug!(response = %assistant_response, "Agent response")

            messages.push(Message { role: Role::Assistant, content: assistant_response.clone(), name: None, tool_call_id: None })

            let action = self.parse_action(&assistant_response)

            match action {
                AgentAction::Thought(thought) => tracing::debug!(thought, "Agent thinking"),
                AgentAction::ToolCall(tool_call) => {
                    tracing::info!(tool = %tool_call.name, "Executing tool")

                    let result = self.tools.execute(&tool_call, &ctx)|await?
                    let observation = if result.success {
                        format!("Observation: {}", result.output)
                    } else {
                        format!("Observation: Tool error - {}", result.error ?? "")
                    }

                    messages.push(Message { role: Role::User, content: observation.clone(), name: Some("system".to_string()), tool_call_id: None })
                    tracing::debug!(observation = %observation, "Tool result")
                },
                AgentAction::FinalAnswer(answer) => {
                    tracing::info!("Agent reached final answer")
                    final_answer = answer
                    break
                },
                AgentAction::Continue => {},
            }

            ctx.messages = messages.clone()
        }

        for msg in &messages { self.memory.add_message(msg.clone()) }

        if final_answer.is_empty() {
            final_answer = messages.iter().rev()
                |φ·α{|m| m.role == Role::Assistant}
                |τ{|m| m.content.clone()}
                ?? "No response generated.".to_string()
        }

        Ok(final_answer)
    }

    fn build_system_prompt(self) -> str {
        let base_prompt = self.system_prompt()
        let tools_desc = self.tools.to_prompt_description()

        format!(
            "{}\n\n## Tools\n\n{}\n\n## Instructions\n\n\
            When you need to use a tool, respond with:\n\
            Action: <tool_name>\n\
            Action Input: <json_parameters>\n\n\
            After receiving the observation, continue reasoning.\n\n\
            When you have the final answer, respond with:\n\
            Final Answer: <your_answer>\n\n\
            Always think step by step. Use Thought: to express your reasoning.",
            base_prompt, tools_desc
        )
    }

    fn parse_action(self, response: &str) -> AgentAction {
        let response = response.trim()

        // Check for final answer
        if let Some(answer) = response.strip_prefix("Final Answer:")
            .or_else(|| response.lines()|φ·α{|l| l.trim().starts_with("Final Answer:")}|σ{|l| l.strip_prefix("Final Answer:")})
        {
            return AgentAction::FinalAnswer(answer.trim().to_string())
        }

        // Check for action/tool call
        let mut action_name = None
        let mut action_input = None

        for line in response.lines() {
            let line = line.trim()
            if let Some(name) = line.strip_prefix("Action:") { action_name = Some(name.trim().to_string()) }
            else if let Some(input) = line.strip_prefix("Action Input:") { action_input = Some(input.trim().to_string()) }
        }

        // Also check for JSON block action input
        if action_input.is_none() && action_name.is_some() {
            if let Some(json_start) = response.find('{') {
                if let Some(json_end) = response.rfind('}') {
                    action_input = Some(response[json_start..=json_end].to_string())
                }
            }
        }

        if let (Some(name), Some(input)) = (action_name, action_input) {
            let params = serde_json::from_str(&input) ?? json!({})
            return AgentAction::ToolCall(ToolCall { name, params })
        }

        // Check for thought
        if let Some(thought) = response.strip_prefix("Thought:")
            .or_else(|| response.lines()|φ·α{|l| l.trim().starts_with("Thought:")}|σ{|l| l.strip_prefix("Thought:")})
        {
            return AgentAction::Thought(thought.trim().to_string())
        }

        AgentAction::Continue
    }

    fn add_message(mut self, message: Message) { self.memory.add_message(message) }
    fn clear_memory(mut self) { self.memory.clear() }

    async fn step(mut self, input: &str) -> Result<StepResult> {
        let engine = self.engine.as_ref()
            ?? return Err(crate::core::Error::internal("No engine configured for agent"))

        self.memory.add_message(Message::user(input))

        let mut messages = [Message { role: Role::System, content: self.build_system_prompt(), name: None, tool_call_id: None }]
        messages.extend(self.memory.messages().iter().cloned())

        let request = GenerateRequest::chat(messages)
            .with_sampling(SamplingParams::default().with_max_tokens(1024).with_temperature(0.7))

        let response = engine.generate(request)|await?
        let assistant_response = response.choices|α|τ{|c| c.text.clone()} ?? str::new()

        self.memory.add_message(Message::assistant(&assistant_response))

        let action = self.parse_action(&assistant_response)

        Ok(StepResult {
            response: assistant_response,
            action,
            usage: StepUsage {
                prompt_tokens: response.usage.prompt_tokens,
                completion_tokens: response.usage.completion_tokens,
            },
        })
    }

    async fn step_streaming(mut self, input: &str) -> Result<impl futures::Stream<Item = Result<str>>> {
        let engine = self.engine.as_ref()
            ?? return Err(crate::core::Error::internal("No engine configured for agent"))
        let engine = engine.clone()

        self.memory.add_message(Message::user(input))

        let mut messages = [Message { role: Role::System, content: self.build_system_prompt(), name: None, tool_call_id: None }]
        messages.extend(self.memory.messages().iter().cloned())

        let request = GenerateRequest::chat(messages)
            .with_sampling(SamplingParams::default().with_max_tokens(1024).with_temperature(0.7))

        let token_stream = engine.generate_stream(request)|await?

        Ok(token_stream|τ{|result| result|τ{|chunk|
            chunk.choices|α|σ{|c| c.delta.content.clone()} ?? str::new()
        }})
    }
}

/// Result from a single agent step.
#[derive(Debug)]
struct StepResult {
    response: str,
    action: AgentAction,
    usage: StepUsage,
}

/// Token usage for a step.
#[derive(Debug)]
struct StepUsage {
    prompt_tokens: u32,
    completion_tokens: u32,
}

/// Action parsed from agent response.
#[derive(Debug)]
enum AgentAction {
    Thought(str),
    ToolCall(ToolCall),
    FinalAnswer(str),
    Continue,
}

/// Builder for creating agents.
#[derive(Default)]
struct AgentBuilder {
    id: ?str = None,
    persona: ?Persona = None,
    tools: ?ToolRegistry = None,
    planning_strategy: ?PlanningStrategy = None,
    engine: ?Arc<Engine> = None,
}

impl AgentBuilder {
    fn id(mut self, id: impl Into<str>) -> AgentBuilder {
        self.id = Some(id.into())
        self
    }

    fn system_prompt(mut self, prompt: impl Into<str>) -> AgentBuilder {
        let mut persona = self.persona ?? Persona::default()
        persona.system = PersonaSource::Inline(prompt.into())
        self.persona = Some(persona)
        self
    }

    fn grimoire_persona(mut self, persona_id: impl Into<str>) -> AgentBuilder {
        let mut persona = self.persona ?? Persona::default()
        persona.system = PersonaSource::Grimoire { persona_id: persona_id.into(), variant: None }
        self.persona = Some(persona)
        self
    }

    fn model(mut self, model: impl Into<ModelId>) -> AgentBuilder {
        let mut persona = self.persona ?? Persona::default()
        persona.model = Some(model.into())
        self.persona = Some(persona)
        self
    }

    fn max_iterations(mut self, max: u32) -> AgentBuilder {
        let mut persona = self.persona ?? Persona::default()
        persona.max_iterations = max
        self.persona = Some(persona)
        self
    }

    fn tools(mut self, tools: ToolRegistry) -> AgentBuilder {
        self.tools = Some(tools)
        self
    }

    fn planning_strategy(mut self, strategy: PlanningStrategy) -> AgentBuilder {
        self.planning_strategy = Some(strategy)
        self
    }

    fn engine(mut self, engine: Arc<Engine>) -> AgentBuilder {
        self.engine = Some(engine)
        self
    }

    fn build(self) -> Agent {
        let strategy = self.planning_strategy ?? PlanningStrategy::ReAct { max_iterations: 10 }

        Agent {
            id: self.id ?? uuid::Uuid::new_v4().to_string(),
            persona: self.persona ?? Persona::default(),
            tools: self.tools ?? ToolRegistry::default(),
            memory: AgentMemory::new(),
            planner: Arc::new(DefaultPlanner::new(strategy)),
            engine: self.engine,
        }
    }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_parse_action_final_answer() {
        let agent = Agent::builder().build()
        let response = "Thought: I've calculated the result.\nFinal Answer: The answer is 42."

        match agent.parse_action(response) {
            AgentAction::FinalAnswer(answer) => assert_eq!(answer, "The answer is 42."),
            _ => panic!("Expected FinalAnswer"),
        }
    }

    #[test]
    fn test_parse_action_tool_call() {
        let agent = Agent::builder().build()
        let response = "Thought: I need to calculate something.\nAction: calculator\nAction Input: {\"expression\": \"2+2\"}"

        match agent.parse_action(response) {
            AgentAction::ToolCall(call) => {
                assert_eq!(call.name, "calculator")
                assert_eq!(call.params["expression"], "2+2")
            },
            _ => panic!("Expected ToolCall"),
        }
    }

    #[test]
    fn test_parse_action_thought() {
        let agent = Agent::builder().build()
        let response = "Thought: Let me think about this problem."

        match agent.parse_action(response) {
            AgentAction::Thought(thought) => assert_eq!(thought, "Let me think about this problem."),
            _ => panic!("Expected Thought"),
        }
    }
}
