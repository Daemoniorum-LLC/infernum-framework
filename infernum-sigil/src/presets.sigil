/// Quality Presets Module
///
/// Pre-configured quality/performance profiles for maximum fidelity generation.
/// Use these presets for optimal results without manual configuration.
///
/// ## Preset Levels
///
/// - **Draft**: Fast preview, low memory (~1-2GB VRAM)
/// - **Standard**: Good quality, balanced performance (~4-6GB VRAM)
/// - **High**: High quality, slower generation (~8-12GB VRAM)
/// - **Ultra**: Maximum quality, production-grade (~16-24GB VRAM)
/// - **Cinematic**: Film-quality output with all enhancements (~24GB+ VRAM)

use crate::diffusion::{
    DiffusionConfig, SchedulerType, GenerationParams,
    EnhanceConfig, SuperResModel, FaceRestoreModel,
    ColorGradeConfig, FilmGrainConfig,
}
use crate::video::{
    VideoConfig, VideoEnhanceConfig, VideoSRModel, InterpolationModel,
}
use crate::native::{
    EngineConfig, PrecisionMode, ExecutionBackend,
    MultiGPUConfig, ParallelismStrategy,
}

// =============================================================================
// Quality Level Enum
// =============================================================================

/// Quality preset levels
pub enum QualityPreset {
    /// Fast preview mode - minimal processing
    Draft,
    /// Good quality with balanced performance
    Standard,
    /// High quality for detailed output
    High,
    /// Maximum quality without cinematic effects
    Ultra,
    /// Full cinematic quality with all enhancements
    Cinematic,
    /// Custom configuration
    Custom,
}

// =============================================================================
// Image Generation Presets
// =============================================================================

/// Complete image generation configuration
pub struct ImagePreset {
    /// Base diffusion settings
    pub diffusion: DiffusionConfig,
    /// Generation parameters
    pub generation: GenerationParams,
    /// Post-processing enhancement
    pub enhancement: Option<EnhanceConfig>,
    /// Engine optimization settings
    pub engine: EngineConfig,
}

impl ImagePreset {
    /// Draft quality - fast previews
    pub fn draft() -> Self {
        Self {
            diffusion: DiffusionConfig {
                scheduler: SchedulerType::EulerAncestral,
                num_steps: 15,
                guidance_scale: 7.0,
                precision: "fp16",
            },
            generation: GenerationParams {
                width: 512,
                height: 512,
                batch_size: 1,
                seed: None,
            },
            enhancement: None,
            engine: EngineConfig {
                precision: PrecisionMode::FP16,
                backend: ExecutionBackend::CUDA,
                use_cuda_graphs: true,
                enable_memory_efficient_attention: true,
            },
        }
    }

    /// Standard quality - good balance
    pub fn standard() -> Self {
        Self {
            diffusion: DiffusionConfig {
                scheduler: SchedulerType::DPMSolverPlusPlus,
                num_steps: 25,
                guidance_scale: 7.5,
                precision: "fp16",
            },
            generation: GenerationParams {
                width: 768,
                height: 768,
                batch_size: 1,
                seed: None,
            },
            enhancement: Some(EnhanceConfig {
                super_res: Some(SuperResConfig {
                    model: SuperResModel::RealESRGAN_x2,
                    tile_size: 512,
                    tile_overlap: 32,
                }),
                face_restore: None,
                detail_enhance: None,
                color_grade: None,
                film_grain: None,
            }),
            engine: EngineConfig {
                precision: PrecisionMode::FP16,
                backend: ExecutionBackend::CUDA,
                use_cuda_graphs: true,
                enable_memory_efficient_attention: true,
            },
        }
    }

    /// High quality - detailed output
    pub fn high() -> Self {
        Self {
            diffusion: DiffusionConfig {
                scheduler: SchedulerType::DPMSolverPlusPlus,
                num_steps: 35,
                guidance_scale: 7.5,
                precision: "fp16",
            },
            generation: GenerationParams {
                width: 1024,
                height: 1024,
                batch_size: 1,
                seed: None,
            },
            enhancement: Some(EnhanceConfig {
                super_res: Some(SuperResConfig {
                    model: SuperResModel::RealESRGAN_x4plus,
                    tile_size: 512,
                    tile_overlap: 64,
                }),
                face_restore: Some(FaceRestoreConfig {
                    model: FaceRestoreModel::CodeFormer,
                    fidelity: 0.7,
                    detection_threshold: 0.5,
                }),
                detail_enhance: Some(DetailEnhanceConfig {
                    strength: 0.3,
                    radius: 2.0,
                }),
                color_grade: None,
                film_grain: None,
            }),
            engine: EngineConfig {
                precision: PrecisionMode::FP16,
                backend: ExecutionBackend::TensorRT,
                use_cuda_graphs: true,
                enable_memory_efficient_attention: true,
            },
        }
    }

    /// Ultra quality - maximum detail
    pub fn ultra() -> Self {
        Self {
            diffusion: DiffusionConfig {
                scheduler: SchedulerType::DPMSolverPlusPlus,
                num_steps: 50,
                guidance_scale: 8.0,
                precision: "fp16",
            },
            generation: GenerationParams {
                width: 1024,
                height: 1024,
                batch_size: 1,
                seed: None,
            },
            enhancement: Some(EnhanceConfig {
                super_res: Some(SuperResConfig {
                    model: SuperResModel::SwinIRLarge,
                    tile_size: 384,
                    tile_overlap: 64,
                }),
                face_restore: Some(FaceRestoreConfig {
                    model: FaceRestoreModel::CodeFormer,
                    fidelity: 0.8,
                    detection_threshold: 0.4,
                }),
                detail_enhance: Some(DetailEnhanceConfig {
                    strength: 0.4,
                    radius: 2.5,
                }),
                color_grade: Some(ColorGradeConfig {
                    contrast: 1.05,
                    saturation: 1.02,
                    vibrance: 0.1,
                    shadows: -0.02,
                    highlights: 0.02,
                }),
                film_grain: None,
            }),
            engine: EngineConfig {
                precision: PrecisionMode::FP16,
                backend: ExecutionBackend::TensorRT,
                use_cuda_graphs: true,
                enable_memory_efficient_attention: true,
            },
        }
    }

    /// Cinematic quality - full film-grade output
    pub fn cinematic() -> Self {
        Self {
            diffusion: DiffusionConfig {
                scheduler: SchedulerType::DPMSolverPlusPlus,
                num_steps: 60,
                guidance_scale: 8.5,
                precision: "fp32",  // Full precision for maximum quality
            },
            generation: GenerationParams {
                width: 1536,
                height: 1536,
                batch_size: 1,
                seed: None,
            },
            enhancement: Some(EnhanceConfig {
                super_res: Some(SuperResConfig {
                    model: SuperResModel::SwinIRLarge,
                    tile_size: 384,
                    tile_overlap: 96,
                }),
                face_restore: Some(FaceRestoreConfig {
                    model: FaceRestoreModel::CodeFormer,
                    fidelity: 0.85,
                    detection_threshold: 0.35,
                }),
                detail_enhance: Some(DetailEnhanceConfig {
                    strength: 0.35,
                    radius: 2.0,
                }),
                color_grade: Some(ColorGradeConfig {
                    contrast: 1.08,
                    saturation: 0.98,
                    vibrance: 0.15,
                    shadows: -0.03,
                    highlights: 0.03,
                    lift: [0.0, 0.0, 0.02],     // Slight blue lift
                    gamma: [1.0, 1.0, 1.0],
                    gain: [1.0, 0.98, 0.96],    // Warm highlights
                }),
                film_grain: Some(FilmGrainConfig {
                    intensity: 0.08,
                    size: 1.5,
                    color_amount: 0.3,
                    highlight_protection: 0.7,
                    shadow_boost: 0.2,
                }),
            }),
            engine: EngineConfig {
                precision: PrecisionMode::FP32,
                backend: ExecutionBackend::TensorRT,
                use_cuda_graphs: true,
                enable_memory_efficient_attention: true,
            },
        }
    }

    /// Create preset from quality level
    pub fn from_level(level: QualityPreset) -> Self {
        match level {
            QualityPreset::Draft => Self::draft(),
            QualityPreset::Standard => Self::standard(),
            QualityPreset::High => Self::high(),
            QualityPreset::Ultra => Self::ultra(),
            QualityPreset::Cinematic => Self::cinematic(),
            QualityPreset::Custom => Self::standard(),  // Default to standard for custom
        }
    }

    /// Adjust for portrait photography
    pub fn portrait_mode(mut self) -> Self {
        // Ensure face restoration is enabled with optimal settings
        if let Some(ref mut enh) = self.enhancement {
            enh.face_restore = Some(FaceRestoreConfig {
                model: FaceRestoreModel::CodeFormer,
                fidelity: 0.9,  // High fidelity for portraits
                detection_threshold: 0.3,
                upscale_face: true,
                only_center_face: false,
            });
            // Softer detail enhancement for skin
            enh.detail_enhance = Some(DetailEnhanceConfig {
                strength: 0.15,
                radius: 1.5,
            });
        }
        self
    }

    /// Adjust for landscape photography
    pub fn landscape_mode(mut self) -> Self {
        // Disable face restore, enhance detail
        if let Some(ref mut enh) = self.enhancement {
            enh.face_restore = None;
            enh.detail_enhance = Some(DetailEnhanceConfig {
                strength: 0.5,
                radius: 3.0,
            });
            // Enhance landscape colors
            enh.color_grade = Some(ColorGradeConfig {
                contrast: 1.1,
                saturation: 1.1,
                vibrance: 0.2,
                shadows: -0.05,
                highlights: 0.05,
            });
        }
        self
    }

    /// Adjust for 4K output (3840x2160)
    pub fn output_4k(mut self) -> Self {
        // Use progressive upscaling to reach 4K
        if let Some(ref mut enh) = self.enhancement {
            enh.super_res = Some(SuperResConfig {
                model: SuperResModel::RealESRGAN_x4plus,
                tile_size: 512,
                tile_overlap: 64,
                scale_factor: 4.0,
            });
        }
        self
    }

    /// Adjust for 8K output (7680x4320)
    pub fn output_8k(mut self) -> Self {
        // Multi-pass upscaling for 8K
        if let Some(ref mut enh) = self.enhancement {
            enh.super_res = Some(SuperResConfig {
                model: SuperResModel::SwinIRLarge,
                tile_size: 384,
                tile_overlap: 96,
                scale_factor: 4.0,
                multi_pass: true,
                passes: 2,  // 4x -> 4x = 16x total
            });
        }
        self
    }
}

// =============================================================================
// Video Generation Presets
// =============================================================================

/// Complete video generation configuration
pub struct VideoPreset {
    /// Base video diffusion settings
    pub video: VideoConfig,
    /// Post-processing enhancement
    pub enhancement: Option<VideoEnhanceConfig>,
    /// Engine optimization settings
    pub engine: EngineConfig,
    /// Multi-GPU configuration for large models
    pub multi_gpu: Option<MultiGPUConfig>,
}

impl VideoPreset {
    /// Draft quality - fast video previews
    pub fn draft() -> Self {
        Self {
            video: VideoConfig {
                width: 512,
                height: 512,
                num_frames: 16,
                fps: 8,
                motion_bucket_id: 127,
                noise_aug_strength: 0.0,
            },
            enhancement: None,
            engine: EngineConfig {
                precision: PrecisionMode::FP16,
                backend: ExecutionBackend::CUDA,
                use_cuda_graphs: true,
                enable_memory_efficient_attention: true,
            },
            multi_gpu: None,
        }
    }

    /// Standard quality video
    pub fn standard() -> Self {
        Self {
            video: VideoConfig {
                width: 768,
                height: 768,
                num_frames: 25,
                fps: 24,
                motion_bucket_id: 127,
                noise_aug_strength: 0.02,
            },
            enhancement: Some(VideoEnhanceConfig {
                temporal: Some(TemporalConfig {
                    consistency_weight: 0.3,
                    flow_method: FlowMethod::RAFT,
                    deflicker: true,
                }),
                interpolation: Some(InterpolationConfig {
                    model: InterpolationModel::RIFE,
                    target_fps: 30,
                    scene_detection: true,
                }),
                super_res: None,
                color_grade: None,
                film_grain: None,
            }),
            engine: EngineConfig {
                precision: PrecisionMode::FP16,
                backend: ExecutionBackend::CUDA,
                use_cuda_graphs: true,
                enable_memory_efficient_attention: true,
            },
            multi_gpu: None,
        }
    }

    /// High quality video
    pub fn high() -> Self {
        Self {
            video: VideoConfig {
                width: 1024,
                height: 576,  // 16:9 aspect
                num_frames: 49,
                fps: 24,
                motion_bucket_id: 127,
                noise_aug_strength: 0.02,
            },
            enhancement: Some(VideoEnhanceConfig {
                temporal: Some(TemporalConfig {
                    consistency_weight: 0.5,
                    flow_method: FlowMethod::RAFT,
                    deflicker: true,
                    smoothing_factor: 0.2,
                }),
                interpolation: Some(InterpolationConfig {
                    model: InterpolationModel::RIFE,
                    target_fps: 60,
                    scene_detection: true,
                    scene_threshold: 0.3,
                }),
                super_res: Some(VideoSRConfig {
                    model: VideoSRModel::BasicVSRPlusPlus,
                    scale: 2,
                    temporal_window: 7,
                }),
                color_grade: Some(ColorGradeConfig {
                    contrast: 1.05,
                    saturation: 1.02,
                }),
                film_grain: None,
            }),
            engine: EngineConfig {
                precision: PrecisionMode::FP16,
                backend: ExecutionBackend::TensorRT,
                use_cuda_graphs: true,
                enable_memory_efficient_attention: true,
            },
            multi_gpu: None,
        }
    }

    /// Ultra quality video
    pub fn ultra() -> Self {
        Self {
            video: VideoConfig {
                width: 1280,
                height: 720,
                num_frames: 81,
                fps: 24,
                motion_bucket_id: 127,
                noise_aug_strength: 0.02,
            },
            enhancement: Some(VideoEnhanceConfig {
                temporal: Some(TemporalConfig {
                    consistency_weight: 0.6,
                    flow_method: FlowMethod::RAFT,
                    deflicker: true,
                    smoothing_factor: 0.15,
                }),
                interpolation: Some(InterpolationConfig {
                    model: InterpolationModel::FILM,
                    target_fps: 60,
                    scene_detection: true,
                    scene_threshold: 0.25,
                }),
                super_res: Some(VideoSRConfig {
                    model: VideoSRModel::RealBasicVSR,
                    scale: 4,
                    temporal_window: 15,
                }),
                color_grade: Some(ColorGradeConfig {
                    contrast: 1.08,
                    saturation: 1.0,
                    shadows: -0.02,
                    highlights: 0.02,
                }),
                film_grain: None,
            }),
            engine: EngineConfig {
                precision: PrecisionMode::FP16,
                backend: ExecutionBackend::TensorRT,
                use_cuda_graphs: true,
                enable_memory_efficient_attention: true,
            },
            multi_gpu: Some(MultiGPUConfig {
                strategy: ParallelismStrategy::Pipeline,
                device_ids: vec![0, 1],
            }),
        }
    }

    /// Cinematic film-quality video
    pub fn cinematic() -> Self {
        Self {
            video: VideoConfig {
                width: 1920,
                height: 1080,
                num_frames: 121,  // ~5 seconds at 24fps
                fps: 24,
                motion_bucket_id: 100,  // Slightly less motion for cinematic feel
                noise_aug_strength: 0.015,
            },
            enhancement: Some(VideoEnhanceConfig {
                temporal: Some(TemporalConfig {
                    consistency_weight: 0.7,
                    flow_method: FlowMethod::RAFT,
                    deflicker: true,
                    smoothing_factor: 0.1,
                }),
                interpolation: Some(InterpolationConfig {
                    model: InterpolationModel::FILM,
                    target_fps: 24,  // Keep 24fps for cinematic look
                    scene_detection: true,
                    scene_threshold: 0.2,
                }),
                super_res: Some(VideoSRConfig {
                    model: VideoSRModel::RealBasicVSR,
                    scale: 2,  // 1080p -> 4K
                    temporal_window: 21,
                }),
                color_grade: Some(ColorGradeConfig {
                    contrast: 1.1,
                    saturation: 0.95,  // Slightly desaturated for film look
                    vibrance: 0.1,
                    shadows: -0.04,
                    highlights: 0.04,
                    lift: [0.01, 0.0, 0.02],    // Cool shadows
                    gamma: [1.0, 1.0, 1.0],
                    gain: [1.02, 1.0, 0.98],    // Warm highlights
                    lut_path: Some("cinematic_teal_orange.cube"),
                }),
                film_grain: Some(FilmGrainConfig {
                    intensity: 0.06,
                    size: 1.2,
                    color_amount: 0.25,
                    highlight_protection: 0.8,
                    shadow_boost: 0.15,
                    temporal_variation: true,
                }),
            }),
            engine: EngineConfig {
                precision: PrecisionMode::FP16,
                backend: ExecutionBackend::TensorRT,
                use_cuda_graphs: true,
                enable_memory_efficient_attention: true,
            },
            multi_gpu: Some(MultiGPUConfig {
                strategy: ParallelismStrategy::Hybrid,
                device_ids: vec![0, 1, 2, 3],
                tensor_parallel_size: 2,
                pipeline_parallel_size: 2,
            }),
        }
    }

    /// Create preset from quality level
    pub fn from_level(level: QualityPreset) -> Self {
        match level {
            QualityPreset::Draft => Self::draft(),
            QualityPreset::Standard => Self::standard(),
            QualityPreset::High => Self::high(),
            QualityPreset::Ultra => Self::ultra(),
            QualityPreset::Cinematic => Self::cinematic(),
            QualityPreset::Custom => Self::standard(),
        }
    }

    /// Adjust for 4K output
    pub fn output_4k(mut self) -> Self {
        if let Some(ref mut enh) = self.enhancement {
            enh.super_res = Some(VideoSRConfig {
                model: VideoSRModel::RealBasicVSR,
                scale: 4,
                temporal_window: 15,
            });
        }
        self
    }

    /// Adjust for slow-motion output
    pub fn slow_motion(mut self, factor: f32) -> Self {
        if let Some(ref mut enh) = self.enhancement {
            enh.interpolation = Some(InterpolationConfig {
                model: InterpolationModel::FILM,
                target_fps: (self.video.fps as f32 * factor) as u32,
                scene_detection: false,  // No scene cuts in slow-mo
                recursive_interpolation: true,
            });
        }
        self
    }

    /// Adjust for long-form video
    pub fn long_form(mut self, duration_seconds: u32) -> Self {
        let total_frames = duration_seconds * self.video.fps;
        self.video.num_frames = total_frames;

        // Enable chunked processing for long videos
        if self.multi_gpu.is_none() {
            self.multi_gpu = Some(MultiGPUConfig {
                strategy: ParallelismStrategy::Data,
                device_ids: vec![0],
                chunk_size: 49,  // Process in chunks
            });
        }
        self
    }
}

// =============================================================================
// Progressive Generation
// =============================================================================

/// Progressive generation for responsive previews
pub struct ProgressiveConfig {
    /// Preview stages with increasing quality
    pub stages: Vec<ProgressiveStage>,
    /// Whether to show intermediate results
    pub show_intermediates: bool,
    /// Callback frequency (every N steps)
    pub callback_frequency: u32,
}

/// Single stage in progressive generation
pub struct ProgressiveStage {
    /// Resolution at this stage
    pub width: u32,
    pub height: u32,
    /// Number of diffusion steps
    pub num_steps: u32,
    /// Whether to upscale from previous stage
    pub upscale_from_previous: bool,
    /// Enhancement to apply at this stage
    pub enhancement: Option<EnhanceConfig>,
}

impl ProgressiveConfig {
    /// Standard progressive generation (3 stages)
    pub fn standard() -> Self {
        Self {
            stages: vec![
                ProgressiveStage {
                    width: 256,
                    height: 256,
                    num_steps: 10,
                    upscale_from_previous: false,
                    enhancement: None,
                },
                ProgressiveStage {
                    width: 512,
                    height: 512,
                    num_steps: 15,
                    upscale_from_previous: true,
                    enhancement: None,
                },
                ProgressiveStage {
                    width: 1024,
                    height: 1024,
                    num_steps: 25,
                    upscale_from_previous: true,
                    enhancement: Some(EnhanceConfig {
                        super_res: Some(SuperResConfig {
                            model: SuperResModel::RealESRGAN_x2,
                            tile_size: 512,
                        }),
                        ..Default::default()
                    }),
                },
            ],
            show_intermediates: true,
            callback_frequency: 5,
        }
    }

    /// Fast progressive (2 stages)
    pub fn fast() -> Self {
        Self {
            stages: vec![
                ProgressiveStage {
                    width: 384,
                    height: 384,
                    num_steps: 12,
                    upscale_from_previous: false,
                    enhancement: None,
                },
                ProgressiveStage {
                    width: 768,
                    height: 768,
                    num_steps: 20,
                    upscale_from_previous: true,
                    enhancement: Some(EnhanceConfig {
                        super_res: Some(SuperResConfig {
                            model: SuperResModel::RealESRGAN_x2,
                            tile_size: 512,
                        }),
                        ..Default::default()
                    }),
                },
            ],
            show_intermediates: true,
            callback_frequency: 4,
        }
    }

    /// High quality progressive (4 stages to 4K)
    pub fn to_4k() -> Self {
        Self {
            stages: vec![
                ProgressiveStage {
                    width: 256,
                    height: 256,
                    num_steps: 8,
                    upscale_from_previous: false,
                    enhancement: None,
                },
                ProgressiveStage {
                    width: 512,
                    height: 512,
                    num_steps: 12,
                    upscale_from_previous: true,
                    enhancement: None,
                },
                ProgressiveStage {
                    width: 1024,
                    height: 1024,
                    num_steps: 20,
                    upscale_from_previous: true,
                    enhancement: None,
                },
                ProgressiveStage {
                    width: 2048,
                    height: 2048,
                    num_steps: 30,
                    upscale_from_previous: true,
                    enhancement: Some(EnhanceConfig {
                        super_res: Some(SuperResConfig {
                            model: SuperResModel::SwinIRLarge,
                            tile_size: 384,
                            scale_factor: 2.0,  // 2048 -> 4096
                        }),
                        detail_enhance: Some(DetailEnhanceConfig {
                            strength: 0.3,
                            radius: 2.0,
                        }),
                        ..Default::default()
                    }),
                },
            ],
            show_intermediates: true,
            callback_frequency: 5,
        }
    }
}

// =============================================================================
// Model Presets (Which models to use)
// =============================================================================

/// Recommended model configurations
pub enum ModelPreset {
    /// SD 1.5 - Fast, low VRAM, good quality
    SD15,
    /// SDXL - High quality, moderate VRAM
    SDXL,
    /// SDXL + Refiner - Maximum SD quality
    SDXLRefined,
    /// SD3 Medium - Fast DiT-based
    SD3Medium,
    /// SD3.5 Large - High quality DiT
    SD3Large,
    /// Flux Dev - Best quality, high VRAM
    FluxDev,
    /// Flux Schnell - Fast Flux variant
    FluxSchnell,
}

impl ModelPreset {
    /// Get recommended settings for this model
    pub fn config(&self) -> ModelConfig {
        match self {
            Self::SD15 => ModelConfig {
                checkpoint: "stable-diffusion-v1-5",
                vae: Some("stabilityai/sd-vae-ft-mse"),
                scheduler: SchedulerType::DPMSolverPlusPlus,
                recommended_steps: 25,
                default_resolution: (512, 512),
                max_resolution: (768, 768),
                vram_required_gb: 4.0,
            },
            Self::SDXL => ModelConfig {
                checkpoint: "stabilityai/stable-diffusion-xl-base-1.0",
                vae: Some("madebyollin/sdxl-vae-fp16-fix"),
                scheduler: SchedulerType::EulerAncestral,
                recommended_steps: 30,
                default_resolution: (1024, 1024),
                max_resolution: (1536, 1536),
                vram_required_gb: 8.0,
            },
            Self::SDXLRefined => ModelConfig {
                checkpoint: "stabilityai/stable-diffusion-xl-base-1.0",
                refiner: Some("stabilityai/stable-diffusion-xl-refiner-1.0"),
                vae: Some("madebyollin/sdxl-vae-fp16-fix"),
                scheduler: SchedulerType::DPMSolverPlusPlus,
                recommended_steps: 40,
                refiner_steps: 15,
                default_resolution: (1024, 1024),
                max_resolution: (1536, 1536),
                vram_required_gb: 12.0,
            },
            Self::SD3Medium => ModelConfig {
                checkpoint: "stabilityai/stable-diffusion-3-medium",
                vae: None,  // Integrated
                scheduler: SchedulerType::FlowMatch,
                recommended_steps: 28,
                default_resolution: (1024, 1024),
                max_resolution: (1536, 1536),
                vram_required_gb: 10.0,
            },
            Self::SD3Large => ModelConfig {
                checkpoint: "stabilityai/stable-diffusion-3.5-large",
                vae: None,
                scheduler: SchedulerType::FlowMatch,
                recommended_steps: 35,
                default_resolution: (1024, 1024),
                max_resolution: (2048, 2048),
                vram_required_gb: 16.0,
            },
            Self::FluxDev => ModelConfig {
                checkpoint: "black-forest-labs/FLUX.1-dev",
                vae: None,
                scheduler: SchedulerType::FlowMatch,
                recommended_steps: 50,
                default_resolution: (1024, 1024),
                max_resolution: (2048, 2048),
                vram_required_gb: 24.0,
                guidance_scale: 3.5,  // Flux uses lower guidance
            },
            Self::FluxSchnell => ModelConfig {
                checkpoint: "black-forest-labs/FLUX.1-schnell",
                vae: None,
                scheduler: SchedulerType::FlowMatch,
                recommended_steps: 4,
                default_resolution: (1024, 1024),
                max_resolution: (2048, 2048),
                vram_required_gb: 24.0,
                guidance_scale: 0.0,  // Schnell is guidance-free
            },
        }
    }
}

/// Model configuration details
pub struct ModelConfig {
    pub checkpoint: &'static str,
    pub refiner: Option<&'static str>,
    pub vae: Option<&'static str>,
    pub scheduler: SchedulerType,
    pub recommended_steps: u32,
    pub refiner_steps: u32,
    pub default_resolution: (u32, u32),
    pub max_resolution: (u32, u32),
    pub vram_required_gb: f32,
    pub guidance_scale: f32,
}

impl Default for ModelConfig {
    fn default() -> Self {
        Self {
            checkpoint: "",
            refiner: None,
            vae: None,
            scheduler: SchedulerType::DPMSolverPlusPlus,
            recommended_steps: 25,
            refiner_steps: 0,
            default_resolution: (1024, 1024),
            max_resolution: (1024, 1024),
            vram_required_gb: 8.0,
            guidance_scale: 7.5,
        }
    }
}

// =============================================================================
// Video Model Presets
// =============================================================================

/// Recommended video model configurations
pub enum VideoModelPreset {
    /// SVD - Stable Video Diffusion (image-to-video)
    SVD,
    /// SVD-XT - Extended frames
    SVDXT,
    /// AnimateDiff - Motion modules with SD
    AnimateDiff,
    /// CogVideoX-2B - Fast DiT video
    CogVideoX2B,
    /// CogVideoX-5B - High quality DiT video
    CogVideoX5B,
    /// Mochi - Top quality video
    Mochi,
    /// LTX-Video - Fast inference
    LTXVideo,
}

impl VideoModelPreset {
    /// Get recommended settings for this video model
    pub fn config(&self) -> VideoModelConfig {
        match self {
            Self::SVD => VideoModelConfig {
                checkpoint: "stabilityai/stable-video-diffusion-img2vid",
                default_frames: 14,
                max_frames: 25,
                default_resolution: (1024, 576),
                fps: 6,
                vram_required_gb: 12.0,
                supports_text: false,
            },
            Self::SVDXT => VideoModelConfig {
                checkpoint: "stabilityai/stable-video-diffusion-img2vid-xt",
                default_frames: 25,
                max_frames: 49,
                default_resolution: (1024, 576),
                fps: 6,
                vram_required_gb: 16.0,
                supports_text: false,
            },
            Self::AnimateDiff => VideoModelConfig {
                checkpoint: "guoyww/animatediff-motion-adapter-v1-5-3",
                base_model: Some("runwayml/stable-diffusion-v1-5"),
                default_frames: 16,
                max_frames: 32,
                default_resolution: (512, 512),
                fps: 8,
                vram_required_gb: 8.0,
                supports_text: true,
            },
            Self::CogVideoX2B => VideoModelConfig {
                checkpoint: "THUDM/CogVideoX-2b",
                default_frames: 49,
                max_frames: 49,
                default_resolution: (720, 480),
                fps: 8,
                vram_required_gb: 12.0,
                supports_text: true,
            },
            Self::CogVideoX5B => VideoModelConfig {
                checkpoint: "THUDM/CogVideoX-5b",
                default_frames: 49,
                max_frames: 81,
                default_resolution: (1360, 768),
                fps: 8,
                vram_required_gb: 24.0,
                supports_text: true,
            },
            Self::Mochi => VideoModelConfig {
                checkpoint: "genmo/mochi-1-preview",
                default_frames: 84,
                max_frames: 200,
                default_resolution: (848, 480),
                fps: 24,
                vram_required_gb: 40.0,
                supports_text: true,
            },
            Self::LTXVideo => VideoModelConfig {
                checkpoint: "Lightricks/LTX-Video",
                default_frames: 121,
                max_frames: 257,
                default_resolution: (768, 512),
                fps: 24,
                vram_required_gb: 16.0,
                supports_text: true,
            },
        }
    }
}

/// Video model configuration details
pub struct VideoModelConfig {
    pub checkpoint: &'static str,
    pub base_model: Option<&'static str>,
    pub default_frames: u32,
    pub max_frames: u32,
    pub default_resolution: (u32, u32),
    pub fps: u32,
    pub vram_required_gb: f32,
    pub supports_text: bool,
}

impl Default for VideoModelConfig {
    fn default() -> Self {
        Self {
            checkpoint: "",
            base_model: None,
            default_frames: 25,
            max_frames: 49,
            default_resolution: (1024, 576),
            fps: 24,
            vram_required_gb: 16.0,
            supports_text: false,
        }
    }
}
