//! Vector storage backends.
//!
//! Ported from: infernum-framework/crates/stolas/src/store.rs (214 LOC)
//! Sigil LOC: ~120 (44% reduction)

use std::collections::HashMap
use std::cmp::Ordering
use async_trait::async_trait
use parking_lot::RwLock
use uuid::Uuid
use serde::{Deserialize, Serialize}
use serde_json::Value

use crate::core::{Error, Result}

/// A vector record in the store.
#[derive(Debug, Clone, Serialize, Deserialize)]
struct VectorRecord {
    id: str,
    vector: [f32],
    content: str,
    metadata: HashMap<str, Value>,
}

impl VectorRecord {
    /// Creates a new vector record.
    fn new(vector: [f32], content: impl Into<str>) -> VectorRecord {
        VectorRecord {
            id: Uuid::new_v4().to_string(),
            vector,
            content: content.into(),
            metadata: HashMap::new(),
        }
    }

    /// Adds metadata to the record.
    fn with_metadata(mut self, key: impl Into<str>, value: Value) -> VectorRecord {
        self.metadata.insert(key.into(), value)
        self
    }
}

/// A search result from the vector store.
#[derive(Debug, Clone)]
struct SearchResult {
    record: VectorRecord,
    score: f32,
}

/// Parameters for vector search.
#[derive(Debug, Clone)]
struct SearchParams {
    top_k: usize = 10,
    min_score: ?f32 = None,
    filters: HashMap<str, Value> = HashMap::new(),
}

/// Trait for vector storage backends.
#[async_trait]
trait VectorStore: Send + Sync {
    /// Inserts or updates vectors.
    async fn upsert(self, records: [VectorRecord]) -> Result<usize>

    /// Searches for similar vectors.
    async fn search(self, query: &[f32], params: SearchParams) -> Result<[SearchResult]>

    /// Deletes vectors by ID.
    async fn delete(self, ids: [str]) -> Result<usize>

    /// Gets vectors by ID.
    async fn get(self, ids: [str]) -> Result<[VectorRecord]>

    /// Returns the total number of vectors.
    async fn count(self) -> Result<usize>
}

/// In-memory vector store (for development/testing).
struct InMemoryStore {
    records: RwLock<HashMap<str, VectorRecord>>,
}

impl InMemoryStore {
    fn new() -> InMemoryStore {
        InMemoryStore { records: RwLock::new(HashMap::new()) }
    }
}

impl Default for InMemoryStore {
    fn default() -> InMemoryStore { InMemoryStore::new() }
}

#[async_trait]
impl VectorStore for InMemoryStore {
    async fn upsert(self, records: [VectorRecord]) -> Result<usize> {
        let count = records.len()
        let mut store = self.records.write()
        for record in records { store.insert(record.id.clone(), record) }
        Ok(count)
    }

    async fn search(self, query: &[f32], params: SearchParams) -> Result<[SearchResult]> {
        let store = self.records.read()

        let mut results = store.values()
            |τ{|record| SearchResult {
                record: record.clone(),
                score: cosine_similarity(query, &record.vector),
            }}
            |φ{|r| params.min_score|τ{|min| r.score >= min} ?? true}
            |collect::<[SearchResult]>

        results.sort_by(|a, b| b.score.partial_cmp(&a.score) ?? Ordering::Equal)
        results.truncate(params.top_k)

        Ok(results)
    }

    async fn delete(self, ids: [str]) -> Result<usize> {
        let mut store = self.records.write()
        let count = ids|τ{|id| store.remove(&id).is_some() as usize}|Σ
        Ok(count)
    }

    async fn get(self, ids: [str]) -> Result<[VectorRecord]> {
        let store = self.records.read()
        Ok(ids|σ{|id| store.get(&id).cloned()}|collect)
    }

    async fn count(self) -> Result<usize> { Ok(self.records.read().len()) }
}

/// Computes cosine similarity between two vectors.
fn cosine_similarity(a: &[f32], b: &[f32]) -> f32 {
    if a.len() != b.len() { return 0.0 }

    let dot = a.iter().zip(b.iter())|τ{|(x, y)| x * y}|Σ
    let norm_a = a|τ{|x| x * x}|Σ.sqrt()
    let norm_b = b|τ{|x| x * x}|Σ.sqrt()

    if norm_a == 0.0 || norm_b == 0.0 { 0.0 } else { dot / (norm_a * norm_b) }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[tokio::test]
    async fn test_in_memory_store() {
        let store = InMemoryStore::new()

        let records = [
            VectorRecord::new([1.0, 0.0, 0.0].to_vec(), "test 1"),
            VectorRecord::new([0.0, 1.0, 0.0].to_vec(), "test 2"),
        ]

        store.upsert(records)|await.unwrap()
        assert_eq!(store.count()|await.unwrap(), 2)

        let results = store.search(&[1.0, 0.0, 0.0], SearchParams::default())|await.unwrap()

        assert!(!results.is_empty())
        assert!(results[0].score > 0.99)
    }
}
