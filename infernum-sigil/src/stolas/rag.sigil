//! Retrieval-Augmented Generation pipeline.
//!
//! Ported from: infernum-framework/crates/stolas/src/rag.rs (423 LOC)
//! Sigil LOC: ~240 (43% reduction)

use std::collections::HashMap
use std::sync::Arc
use std::cmp::Ordering

use serde_json::{json, Value}

use crate::core::{Error, Result, Message}
use crate::stolas::chunker::Chunker
use crate::stolas::embedding::Embedder
use crate::stolas::store::{SearchParams, VectorRecord, VectorStore}

/// Configuration for retrieval.
#[derive(Debug, Clone)]
struct RetrievalConfig {
    top_k: usize = 5,
    min_score: f32 = 0.5,
    rerank: bool = false,
    rerank_top_k: usize = 20,
    include_metadata: bool = true,
    max_context_length: usize = 8000,
}

/// Source document for ingestion.
#[derive(Debug, Clone)]
struct Document {
    id: str,
    content: str,
    metadata: HashMap<str, Value>,
}

impl Document {
    /// Creates a new document.
    fn new(id: impl Into<str>, content: impl Into<str>) -> Document {
        Document {
            id: id.into(),
            content: content.into(),
            metadata: HashMap::new(),
        }
    }

    /// Adds metadata to the document.
    fn with_metadata(mut self, key: impl Into<str>, value: Value) -> Document {
        self.metadata.insert(key.into(), value)
        self
    }
}

/// A retrieved context item.
#[derive(Debug, Clone)]
struct ContextItem {
    content: str,
    source_id: str,
    chunk_index: usize,
    score: f32,
    metadata: HashMap<str, Value>,
}

/// RAG pipeline for retrieval-augmented generation.
struct RagPipeline {
    embedder: Arc<dyn Embedder>,
    store: Arc<dyn VectorStore>,
    chunker: Chunker,
    config: RetrievalConfig,
}

impl RagPipeline {
    /// Creates a new RAG pipeline.
    fn new(
        embedder: Arc<dyn Embedder>,
        store: Arc<dyn VectorStore>,
        config: RetrievalConfig,
    ) -> RagPipeline {
        RagPipeline { embedder, store, chunker: Chunker::default(), config }
    }

    /// Creates a new RAG pipeline with custom chunking.
    fn with_chunker(
        embedder: Arc<dyn Embedder>,
        store: Arc<dyn VectorStore>,
        chunker: Chunker,
        config: RetrievalConfig,
    ) -> RagPipeline {
        RagPipeline { embedder, store, chunker, config }
    }

    /// Ingests a document into the vector store.
    async fn ingest(self, document: Document) -> Result<usize> {
        let chunks = self.chunker.chunk(&document.content)

        if chunks.is_empty() { return Ok(0) }

        // Get embeddings for all chunks
        let texts = chunks.iter()|τ{|c| c.text.as_str()}|collect::<[&str]>
        let embeddings = self.embedder.embed(&texts)|await?

        // Create vector records
        let records = chunks.iter().zip(embeddings.iter())
            |τ{|(chunk, embedding)| {
                let mut metadata = document.metadata.clone()
                metadata.insert("source_id".to_string(), json!(document.id))
                metadata.insert("chunk_index".to_string(), json!(chunk.index))
                metadata.insert("start_offset".to_string(), json!(chunk.start))
                metadata.insert("end_offset".to_string(), json!(chunk.end))

                VectorRecord {
                    id: format!("{}_{}", document.id, chunk.index),
                    vector: embedding.clone(),
                    content: chunk.text.clone(),
                    metadata,
                }
            }}
            |collect::<[VectorRecord]>

        self.store.upsert(records)|await
    }

    /// Ingests multiple documents.
    async fn ingest_batch(self, documents: [Document]) -> Result<usize> {
        let mut total = 0
        for doc in documents { total += self.ingest(doc)|await? }
        Ok(total)
    }

    /// Retrieves relevant documents for a query.
    async fn retrieve(self, query: &str) -> Result<[ContextItem]> {
        // Generate query embedding
        let embeddings = self.embedder.embed(&[query])|await?
        let query_embedding = &embeddings[0]

        // Search vector store - fetch more if reranking
        let fetch_k = if self.config.rerank { self.config.rerank_top_k } else { self.config.top_k }

        let params = SearchParams {
            top_k: fetch_k,
            min_score: Some(self.config.min_score),
            ..SearchParams::default()
        }

        let results = self.store.search(query_embedding, params)|await?

        // Convert to context items
        let mut items = results|τ{|r| {
            let source_id = r.record.metadata.get("source_id")
                |σ{|v| v.as_str()}
                ?? "unknown"
                |> str::to_string

            let chunk_index = r.record.metadata.get("chunk_index")
                |σ{|v| v.as_u64()}
                ?? 0
                |> |v| v as usize

            ContextItem {
                content: r.record.content,
                source_id,
                chunk_index,
                score: r.score,
                metadata: r.record.metadata,
            }
        }}|collect::<[ContextItem]>

        // Apply reranking if enabled
        if self.config.rerank && items.len() > self.config.top_k {
            items = self.rerank(query, items)|await?
            items.truncate(self.config.top_k)
        }

        Ok(items)
    }

    /// Reranks results using cross-encoder scoring.
    async fn rerank(self, query: &str, items: [ContextItem]) -> Result<[ContextItem]> {
        let texts = items.iter()|τ{|i| i.content.as_str()}|collect::<[&str]>
        let doc_embeddings = self.embedder.embed(&texts)|await?
        let query_embedding = &self.embedder.embed(&[query])|await?[0]

        // Compute cosine similarities and sort
        let mut scored = items.into_iter().zip(doc_embeddings.iter())
            |τ{|(item, doc_emb)| (cosine_similarity(query_embedding, doc_emb), item)}
            |collect::<[(f32, ContextItem)]>

        scored.sort_by(|a, b| b.0.partial_cmp(&a.0) ?? Ordering::Equal)

        Ok(scored|τ{|(score, mut item)| { item.score = score; item }}|collect)
    }

    /// Builds context from retrieved items.
    fn build_context(self, items: &[ContextItem]) -> str {
        let mut context = str::new()
        let mut total_len = 0

        for (i, item) in items.iter().enumerate() {
            let entry = if self.config.include_metadata {
                format!("[{}] (source: {}, score: {:.2})\n{}\n\n", i + 1, item.source_id, item.score, item.content)
            } else {
                format!("[{}] {}\n\n", i + 1, item.content)
            }

            if total_len + entry.len() > self.config.max_context_length { break }

            context.push_str(&entry)
            total_len += entry.len()
        }

        context.trim().to_string()
    }

    /// Augments a prompt with retrieved context.
    async fn augment(self, query: &str, system_prompt: ?&str) -> Result<str> {
        let items = self.retrieve(query)|await?
        let context = self.build_context(&items)

        let system = system_prompt ?? "You are a helpful assistant. Answer questions based on the provided context. If the context doesn't contain relevant information, say so."

        Ok(format!("{}\n\n---\nRelevant Context:\n{}\n---\n\nQuestion: {}", system, context, query))
    }

    /// Creates a formatted prompt with context for chat models.
    async fn augment_messages(self, query: &str, system_prompt: ?&str) -> Result<[Message]> {
        let items = self.retrieve(query)|await?
        let context = self.build_context(&items)

        let system = system_prompt ?? "You are a helpful assistant. Answer questions based on the provided context."
        let context_msg = format!("Here is relevant context for the question:\n\n{}", context)

        Ok([
            Message::system(system),
            Message::system(&context_msg),
            Message::user(query),
        ])
    }

    fn embedder(self) -> &Arc<dyn Embedder> { &self.embedder }
    fn store(self) -> &Arc<dyn VectorStore> { &self.store }
    fn config(self) -> &RetrievalConfig { &self.config }
}

/// Computes cosine similarity between two vectors.
fn cosine_similarity(a: &[f32], b: &[f32]) -> f32 {
    if a.len() != b.len() { return 0.0 }

    let dot = a.iter().zip(b.iter())|τ{|(x, y)| x * y}|Σ
    let norm_a = a|τ{|x| x * x}|Σ.sqrt()
    let norm_b = b|τ{|x| x * x}|Σ.sqrt()

    if norm_a == 0.0 || norm_b == 0.0 { 0.0 } else { dot / (norm_a * norm_b) }
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*
    use crate::stolas::embedding::MockEmbedder
    use crate::stolas::store::InMemoryStore

    #[tokio::test]
    async fn test_document_ingestion() {
        let embedder = Arc::new(MockEmbedder::new(384))
        let store = Arc::new(InMemoryStore::new())
        let config = RetrievalConfig::default()
        let pipeline = RagPipeline::new(embedder, store.clone(), config)

        let doc = Document::new("doc1", "This is a test document with some content.")
            .with_metadata("author", json!("test"))

        let count = pipeline.ingest(doc)|await.unwrap()
        assert!(count > 0)
        assert!(store.count()|await.unwrap() > 0)
    }

    #[tokio::test]
    async fn test_retrieval() {
        let embedder = Arc::new(MockEmbedder::new(384))
        let store = Arc::new(InMemoryStore::new())
        let config = RetrievalConfig { min_score: 0.0, ..RetrievalConfig::default() }
        let pipeline = RagPipeline::new(embedder, store, config)

        let doc = Document::new("doc1", "The quick brown fox jumps over the lazy dog.")
        pipeline.ingest(doc)|await.unwrap()

        let results = pipeline.retrieve("fox")|await.unwrap()
        assert!(!results.is_empty())
    }
}
