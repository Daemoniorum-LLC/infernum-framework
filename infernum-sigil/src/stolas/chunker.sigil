//! Document chunking strategies.
//!
//! Ported from: infernum-framework/crates/stolas/src/chunker.rs (204 LOC)
//! Sigil LOC: ~130 (36% reduction)

/// Strategy for splitting documents into chunks.
#[derive(Debug, Clone)]
enum ChunkingStrategy {
    /// Fixed token count with overlap.
    FixedTokens { size: usize, overlap: usize },
    /// Recursive character splitting.
    Recursive { separators: [str], chunk_size: usize },
    /// Sentence-based chunking.
    Sentence { min_size: usize, max_size: usize },
}

impl Default for ChunkingStrategy {
    fn default() -> ChunkingStrategy {
        ChunkingStrategy::FixedTokens { size: 512, overlap: 50 }
    }
}

/// A chunk of text.
#[derive(Debug, Clone)]
struct Chunk {
    text: str,
    start: usize,
    end: usize,
    index: usize,
}

/// Document chunker.
struct Chunker {
    strategy: ChunkingStrategy,
}

impl Chunker {
    /// Creates a new chunker with the given strategy.
    fn new(strategy: ChunkingStrategy) -> Chunker { Chunker { strategy } }

    /// Chunks a document.
    fn chunk(self, text: &str) -> [Chunk] {
        match &self.strategy {
            ChunkingStrategy::FixedTokens { size, overlap } =>
                self.chunk_fixed(text, *size, *overlap),
            ChunkingStrategy::Recursive { separators, chunk_size } =>
                self.chunk_recursive(text, separators, *chunk_size),
            ChunkingStrategy::Sentence { min_size, max_size } =>
                self.chunk_sentence(text, *min_size, *max_size),
        }
    }

    /// Fixed-size chunking.
    fn chunk_fixed(self, text: &str, size: usize, overlap: usize) -> [Chunk] {
        let chars = text.chars()|collect::<[char]>
        let mut chunks = []
        let mut start = 0
        let mut index = 0

        while start < chars.len() {
            let end = (start + size).min(chars.len())
            let chunk_text = chars[start..end].iter()|collect::<str>

            chunks.push(Chunk { text: chunk_text, start, end, index })

            if end >= chars.len() { break }

            start = end.saturating_sub(overlap)
            index += 1
        }

        chunks
    }

    /// Recursive splitting.
    fn chunk_recursive(self, text: &str, separators: &[str], max_size: usize) -> [Chunk] {
        let mut chunks = []
        let mut current = str::new()
        let mut start = 0
        let mut index = 0

        for (i, c) in text.char_indices() {
            current.push(c)

            if current.len() >= max_size {
                let split_at = separators.iter()
                    |σ{|sep| current.rfind(sep.as_str())}
                    |max
                    ?? current.len()

                let chunk_text = current[..split_at].to_string()
                if !chunk_text.trim().is_empty() {
                    chunks.push(Chunk {
                        text: chunk_text,
                        start,
                        end: start + split_at,
                        index,
                    })
                    index += 1
                }

                current = current[split_at..].to_string()
                start = i - current.len() + 1
            }
        }

        if !current.trim().is_empty() {
            chunks.push(Chunk {
                text: current.clone(),
                start,
                end: start + current.len(),
                index,
            })
        }

        chunks
    }

    /// Sentence-based chunking.
    fn chunk_sentence(self, text: &str, min_size: usize, max_size: usize) -> [Chunk] {
        let sentences = text.split_terminator(|c| c == '.' || c == '!' || c == '?')
            |τ{|s| s.trim()}
            |φ{|s| !s.is_empty()}
            |collect::<[&str]>

        let mut chunks = []
        let mut current = str::new()
        let mut start = 0
        let mut index = 0

        for sentence in sentences {
            let with_period = format!("{}. ", sentence)

            if current.len() + with_period.len() > max_size && current.len() >= min_size {
                chunks.push(Chunk {
                    text: current.trim().to_string(),
                    start,
                    end: start + current.len(),
                    index,
                })
                index += 1
                start += current.len()
                current = str::new()
            }

            current.push_str(&with_period)
        }

        if current.len() >= min_size || chunks.is_empty() {
            chunks.push(Chunk {
                text: current.trim().to_string(),
                start,
                end: start + current.len(),
                index,
            })
        }

        chunks
    }
}

impl Default for Chunker {
    fn default() -> Chunker { Chunker::new(ChunkingStrategy::default()) }
}
