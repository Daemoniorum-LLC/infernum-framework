//! Embedding generation with model integration.
//!
//! Ported from: infernum-framework/crates/stolas/src/embedding.rs (356 LOC)
//! Sigil LOC: ~200 (44% reduction)

use std::sync::Arc
use async_trait::async_trait
use crate::core::error::{Error, Result}
use crate::abaddon::{Engine, InferenceEngine}

/// Trait for embedding models.
#[async_trait]
trait Embedder: Send + Sync {
    /// Generates embeddings for the given texts.
    async fn embed(self, texts: &[&str]) -> Result<[[f32]]>

    /// Generates a single embedding.
    async fn embed_single(self, text: &str) -> Result<[f32]> {
        self.embed(&[text])|await?
            |α
            ?? Err(Error::internal("No embedding generated"))
    }

    /// Returns the embedding dimension.
    fn dimension(self) -> usize

    /// Returns the model name.
    fn model_name(self) -> &str
}

/// Engine-based embedder using abaddon inference.
struct EngineEmbedder {
    engine: Arc<Engine>,
    dimension: usize,
}

impl EngineEmbedder {
    /// Creates a new engine-based embedder.
    fn new(engine: Arc<Engine>) -> EngineEmbedder {
        let model_info = engine.model_info()
        let dimension = model_info.hidden_size as usize

        tracing::debug!(
            model_id = %model_info.id.0,
            dimension = dimension,
            "Created engine embedder"
        )

        EngineEmbedder { engine, dimension }
    }

    /// Creates with specified dimension.
    fn with_dimension(engine: Arc<Engine>, dimension: usize) -> EngineEmbedder {
        EngineEmbedder { engine, dimension }
    }

    fn engine(self) -> &Arc<Engine> { &self.engine }
}

#[async_trait]
impl Embedder for EngineEmbedder {
    async fn embed(self, texts: &[&str]) -> Result<[[f32]]> {
        texts|τ{|text| async {
            let request = crate::core::EmbedRequest::new(text.to_string())
            let response = self.engine.embed(request)|await?
            let embedding = response.data|α
                ?? return Err(Error::internal("No embedding in response"))
            embedding.embedding.as_floats()
                |map_err{|e| Error::internal(e)}
        }}|collect_async|await
    }

    fn dimension(self) -> usize { self.dimension }
    fn model_name(self) -> &str { &self.engine.model_info().id.0 }
}

/// Mock embedder for testing.
struct MockEmbedder {
    dimension: usize,
}

impl MockEmbedder {
    fn new(dimension: usize) -> MockEmbedder { MockEmbedder { dimension } }
}

#[async_trait]
impl Embedder for MockEmbedder {
    async fn embed(self, texts: &[&str]) -> Result<[[f32]]> {
        Ok(texts|τ{|text| {
            let hash = text.bytes()|ρ·fold{0u64, |acc, b| acc.wrapping_add(b as u64)}
            (0..self.dimension)|τ{|i| {
                let seed = hash.wrapping_add(i as u64)
                ((seed % 1000) as f32 / 1000.0) - 0.5
            }}|collect
        }}|collect)
    }

    fn dimension(self) -> usize { self.dimension }
    fn model_name(self) -> &str { "mock-embedder" }
}

/// Pooling strategy for multi-token embeddings.
#[derive(Debug, Clone, Copy, Default)]
enum PoolingStrategy {
    Cls,
    #[default]
    Mean,
    Last,
    Max,
}

/// Sentence embedder with pooling strategies.
struct SentenceEmbedder {
    embedder: Arc<dyn Embedder>,
    pooling: PoolingStrategy = PoolingStrategy::Mean,
    normalize: bool = true,
}

impl SentenceEmbedder {
    fn new(embedder: Arc<dyn Embedder>) -> SentenceEmbedder {
        SentenceEmbedder { embedder, pooling: PoolingStrategy::Mean, normalize: true }
    }

    fn with_pooling(mut self, strategy: PoolingStrategy) -> SentenceEmbedder {
        self.pooling = strategy
        self
    }

    fn with_normalize(mut self, normalize: bool) -> SentenceEmbedder {
        self.normalize = normalize
        self
    }

    fn normalize_vec(vec: &mut [f32]) {
        let norm = vec|τ{|x| x * x}|Σ.sqrt()
        if norm > 1e-10 {
            for x in vec.iter_mut() { *x /= norm }
        }
    }
}

#[async_trait]
impl Embedder for SentenceEmbedder {
    async fn embed(self, texts: &[&str]) -> Result<[[f32]]> {
        let mut embeddings = self.embedder.embed(texts)|await?

        if self.normalize {
            for emb in embeddings.iter_mut() { Self::normalize_vec(emb) }
        }

        Ok(embeddings)
    }

    fn dimension(self) -> usize { self.embedder.dimension() }
    fn model_name(self) -> &str { self.embedder.model_name() }
}

/// Batch embedder for efficient processing.
struct BatchEmbedder {
    embedder: Arc<dyn Embedder>,
    batch_size: usize = 32,
}

impl BatchEmbedder {
    fn new(embedder: Arc<dyn Embedder>) -> BatchEmbedder {
        BatchEmbedder { embedder, batch_size: 32 }
    }

    fn with_batch_size(mut self, size: usize) -> BatchEmbedder {
        self.batch_size = size
        self
    }

    async fn embed_batch(self, texts: &[str]) -> Result<[[f32]]> {
        let mut all_embeddings = []

        for chunk in texts.chunks(self.batch_size) {
            let refs = chunk|τ{String::as_str}|collect::<[&str]>
            let batch_embeddings = self.embedder.embed(&refs)|await?
            all_embeddings.extend(batch_embeddings)
        }

        Ok(all_embeddings)
    }
}

/// Computes cosine similarity between two vectors.
fn cosine_similarity(a: &[f32], b: &[f32]) -> f32 {
    if a.len() != b.len() { return 0.0 }

    let dot = a.iter().zip(b.iter())|τ{|(x, y)| x * y}|Σ
    let norm_a = a|τ{|x| x * x}|Σ.sqrt()
    let norm_b = b|τ{|x| x * x}|Σ.sqrt()

    if norm_a > 1e-10 && norm_b > 1e-10 { dot / (norm_a * norm_b) } else { 0.0 }
}

/// Computes Euclidean distance between two vectors.
fn euclidean_distance(a: &[f32], b: &[f32]) -> f32 {
    if a.len() != b.len() { return f32::MAX }
    a.iter().zip(b.iter())|τ{|(x, y)| (x - y) * (x - y)}|Σ.sqrt()
}

/// Computes dot product between two vectors.
fn dot_product(a: &[f32], b: &[f32]) -> f32 {
    if a.len() != b.len() { return 0.0 }
    a.iter().zip(b.iter())|τ{|(x, y)| x * y}|Σ
}

// ============================================================================
// Tests
// ============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[tokio::test]
    async fn test_mock_embedder() {
        let embedder = MockEmbedder::new(384)
        let embeddings = embedder.embed(&["hello", "world"])|await.unwrap()

        assert_eq!(embeddings.len(), 2)
        assert_eq!(embeddings[0].len(), 384)
    }

    #[test]
    fn test_cosine_similarity() {
        let a = [1.0, 0.0, 0.0]
        let b = [1.0, 0.0, 0.0]
        assert!((cosine_similarity(&a, &b) - 1.0).abs() < 1e-6)

        let c = [0.0, 1.0, 0.0]
        assert!((cosine_similarity(&a, &c)).abs() < 1e-6)
    }
}
